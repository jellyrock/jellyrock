import "pkg:/source/api/ApiClient.bs"

' #550 sgRouter: LoginFlow() + every Create*Group scene factory have been removed — the whole
' app is routed now (pre-login SetServerScreen / UserSelect / LoginScene via loginRouter; Home /
' ItemDetails / SearchResults self-wire under the router). SaveServerList / DeleteFromServerList
' moved to source/utils/config.bs. What remains here are two router-agnostic helpers that don't
' belong to any one view: a performance beacon and the resume/start-over playback dialog.

' Roku Performance monitoring
sub SendPerformanceBeacon(signalName as string)
  if m.global.appLoaded = false
    m.scene.signalBeacon(signalName)
  end if
end sub

'Opens dialog asking user if they want to resume video or start playback over only on the home screen
sub playbackOptionDialog(time as longinteger)

  resumeData = [
    translate(translationKeys.MessageResumePlayingAt, [ticksToHuman(time)]),
    translate(translationKeys.LabelStartOverFromTheBeginning)
  ]

  stopLoadingSpinner()
  m.global.sceneManager.callFunc("showConfirmationDialog", translate(translationKeys.LabelPlaybackOptions), [], resumeData)
end sub
