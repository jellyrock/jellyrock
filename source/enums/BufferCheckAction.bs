' What VideoPlayerView does on one stall-check tick: bufferCheck while the player is buffering,
' playingProgressCheck while it plays (classifyBufferCheck and classifyPlayingProgress in
' source/utils/bufferStall.bs).
enum BufferCheckAction
  ' Buffering or the position moved since the last tick: keep waiting.
  PROGRESS = "progress"
  ' A Live TV channel's buffering or position stalled: PlayerHostView's Live TV restart rule decides.
  LIVE_STALLED = "liveStalled"
  ' Any other stall: show the playback error.
  STALLED = "stalled"
end enum
