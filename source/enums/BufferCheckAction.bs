' What VideoPlayerView.bufferCheck does on one tick while the player is buffering
' (classifyBufferCheck in source/utils/bufferStall.bs).
enum BufferCheckAction
  ' Buffering moved since the last tick: keep waiting.
  PROGRESS = "progress"
  ' A Live TV channel's buffering stalled: PlayerHostView's Live TV restart rule decides.
  LIVE_STALLED = "liveStalled"
  ' Any other stalled buffering: show the playback error.
  STALLED = "stalled"
end enum
