' Which retry VideoPlayerView takes for a Video node error (chooseErrorRetry in
' source/utils/playbackRetry.bs).
enum PlaybackErrorRetry
  ' A buffer overflow in a transcode that Dolby Vision preservation forced: ask for direct play.
  DOVI_DIRECT_PLAY = "doviDirectPlay"
  ' A buffer overflow in a stream whose video the server copied: ask for the video re-encoded.
  REENCODE_VIDEO = "reencodeVideo"
  ' A direct play that failed before its first frame: ask for a transcode.
  TRANSCODE = "transcode"
  ' The server stopped answering for a stream that was playing: ask for it again from the current
  ' position, so the server starts a new transcode there.
  RESTART_STREAM = "restartStream"
  ' No retry applies: show the error dialog.
  NONE = "none"
end enum
