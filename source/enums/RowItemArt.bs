' What a row cell shows for an item (getRowItemArt in source/utils/rowItemImage.bs). Blur and
' fit both follow from it, so the image and how it is drawn can't disagree.
enum RowItemArt
  ' The usual image for the item's type and slot.
  STANDARD = "standard"
  ' An episode in a Home portrait slot, showing its season or series poster.
  PARENT_POSTER = "parentPoster"
  ' An episode in a Home portrait slot with no parent poster, showing its own wide image.
  FITTED_OWN_IMAGE = "fittedOwnImage"
end enum
