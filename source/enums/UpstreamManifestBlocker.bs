' What keeps a source off its own HLS or DASH manifest URL (getUpstreamManifestBlocker in
' source/utils/upstreamManifest.bs). NONE means nothing does: check the URL from this device, then
' play it directly.
enum UpstreamManifestBlocker
  NONE = "none"
  ' The retry after a failed direct play, which must reach the server.
  FORCED_TRANSCODE = "forcedTranscode"
  NO_SOURCE = "noSource"
  ' The server did not say whether it would direct play: nothing to decide on.
  NO_DIRECT_PLAY_ANSWER = "noDirectPlayAnswer"
  NOT_HTTP_PROTOCOL = "notHttpProtocol"
  ' Path is not an absolute http(s) URL.
  NOT_HTTP_URL = "notHttpUrl"
  ' Neither an HLS nor a DASH manifest (upstreamManifestFormat).
  NOT_MANIFEST = "notManifest"
  ' Jellyfin's /LiveTv/LiveStreamFiles/ relay.
  SERVER_RELAY = "serverRelay"
  LOOPBACK = "loopback"
  NO_SERVER_URL = "noServerUrl"
  ' The server's own host and port.
  SERVER_HOST = "serverHost"
  ' The tuner's "Auto-loop live streams": the server does the looping.
  AUTO_LOOP = "autoLoop"
  ' The user's "Force transcoding of remote media sources such as Live TV", on a remote source.
  REMOTE_SOURCE_POLICY = "remoteSourcePolicy"
  ' The server's internet streaming bitrate limit (transcode reason ContainerBitrateExceedsLimit).
  BITRATE_LIMIT = "bitrateLimit"
end enum
