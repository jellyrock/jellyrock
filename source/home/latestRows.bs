import "pkg:/source/utils/misc.bs"

' Decision layer for Home's latest-media rows — which of the orchestrator's delivered
' results the UI may act on, and where the drain cursor lands.
'
' It lives in source/ rather than in HomeRows.bs because a component codebehind's functions
' are scoped to that component: a Rooibos suite (which runs in the source scope) cannot call
' them without a callFunc seam on the XML. Extracting the judgment instead keeps the seam off
' the component and the rules under test. Same move as source/remotecontrol/remoteCommand.bs.
namespace latestRows

  ' Walks LoadLatestRowsTask's result children from `startIndex`, splits them by whether the
  ' request answered, and returns the new cursor. One wake can cover several results — wake
  ' events coalesce, appended children don't — so the caller always drains to the end.
  '
  ' Only status "ok" is authoritative about what a library holds, so only `ready` may feed
  ' populateRowFromData (an empty ok list still removes the row — that is how a genuinely
  ' empty library clears). Everything else lands in `failed`: a timeout, a transport failure
  ' or an HTTP error says nothing about the library, so the caller must not act on it as data.
  '
  ' `failed` is returned rather than dropped because the caller still has one decision left on
  ' it — a row that has never been populated is a skeleton, and leaving it there costs the user
  ' a titled, blank row until the next successful refresh. See HomeRows.discardEmptyLatestRow.
  '
  ' @param task - the LoadLatestRowsTask node holding { libId, items, status } children
  ' @param startIndex - first unprocessed child index
  ' @return an AA { ready, failed, nextIndex } - the authoritative children, the unanswered
  '         children, and the new cursor
  function drain(task as object, startIndex as integer) as object
    ready = []
    failed = []
    index = startIndex
    childCount = task.getChildCount()

    while index < childCount
      child = task.getChild(index)
      index++
      if isValid(child)
        if child.status = "ok"
          ready.push(child)
        else
          failed.push(child)
        end if
      end if
    end while

    return { ready: ready, failed: failed, nextIndex: index }
  end function

end namespace
