import "pkg:/source/api/baseRequest.bs"

' Jellyfin SDK — thin wrappers around API endpoints.
' Only used by ApiClient (via GetApi()). Do NOT call these functions directly.
'
' Most endpoints have been migrated to Build*Request() methods on ApiClient,
' which return request AAs routed through the API pool (fetchRes/fetchJson/SubmitSideEffect).
' The remaining functions here are auth/login/config flows that execute synchronously
' during startup before the pool is available.
namespace sdk

  namespace displayPreferences
    ' Get Display Preferences.
    function Get(id as string, params = {} as object)
      req = APIRequest(Substitute("/displaypreferences/{0}", id), params)
      return getJson(req)
    end function
  end namespace

  namespace items
    ' Gets the item's image URL (no HTTP call — just builds URL string).
    function GetImageURL(id as string, imagetype = "primary" as string, imageindex = 0 as integer, params = {} as object)
      return buildURL(Substitute("/items/{0}/images/{1}/{2}", id, imagetype, imageindex.toStr()), params)
    end function
  end namespace

  namespace quickConnect
    ' Attempts to retrieve authentication information.
    function Connect(secret as string)
      req = APIRequest("/quickconnect/connect", { secret: secret })
      return getJson(req)
    end function

    ' Initiate a new quick connect request.
    function Initiate()
      req = APIRequest("/quickconnect/initiate")
      return getJson(req)
    end function
  end namespace

  namespace system
    ' Gets a named configuration.
    function GetConfigurationByName(name as string)
      req = APIRequest(Substitute("/system/configuration/{0}", name))
      return getJson(req)
    end function
  end namespace

  namespace users
    ' Gets a user by Id, or all users if id is empty.
    function Get(id = "")
      url = "/users"
      if id <> ""
        url = url + "/" + id
      end if
      req = APIRequest(url)
      return getJson(req)
    end function

    ' Gets a list of publicly visible users for display on a login screen.
    function GetPublic()
      resp = APIRequest("/users/public")
      return getJson(resp)
    end function

    ' Authenticates a user by name.
    function AuthenticateByName(username as string, password as string)
      req = APIRequest("users/authenticatebyname")
      return postJson(req, FormatJson({ "Username": username, "Pw": password }))
    end function

    ' Authenticates a user with quick connect.
    function AuthenticateWithQuickConnect(secret as string)
      req = APIRequest("/users/authenticatewithquickconnect")
      return postJson(req, FormatJson({ "secret": secret }))
    end function
  end namespace

end namespace
