  ' ═══════════════════════════════════════════════════════════════════════════
  ' PRIVATE HELPERS
  ' ═══════════════════════════════════════════════════════════════════════════

  ' Inject default image parameters and version-specific fields into params
  ' @param params - Original parameters object
  ' @returns New params object with defaults merged in
  private function injectDefaults(params as object) as object
    merged = {}

    ' First apply image defaults
    merged.append(m.imageDefaults)

    ' Then apply user params (will override defaults if specified)
    merged.append(params)

    ' Add image-related fields if fields parameter exists
    ' PrimaryImageAspectRatio is a valid ItemField that triggers ImageTags to be returned
    if merged.DoesExist("fields")
      fields = merged.fields
      ' Add PrimaryImageAspectRatio if not present - this causes ImageTags to be returned
      if fields.Instr("PrimaryImageAspectRatio") = -1
        fields = fields + ",PrimaryImageAspectRatio"
      end if
      merged.fields = m.addVersionFields(fields)
    end if

    return merged
  end function

  ' Add version-specific fields (like Trickplay) based on server version
  ' @param baseFields - Comma-separated field list
  ' @returns Updated field list with version-specific additions
  private function addVersionFields(baseFields as string) as string
    if baseFields = "" then return baseFields

    apiVersion = m.getApiVersion()

    ' Only add Trickplay for 10.9+ servers (API v2+)
    if apiVersion >= 2 and baseFields.Instr("Trickplay") = -1
      ' Check if we're already requesting Chapters (Trickplay is often paired with it)
      if baseFields.Instr("Chapters") > -1
        return baseFields + ",Trickplay"
      end if
    end if

    return baseFields
  end function

end class

' ═══════════════════════════════════════════════════════════════════════════
' SINGLETON FACTORY
' ═══════════════════════════════════════════════════════════════════════════

' Get the singleton ApiClient instance
' Creates the instance on first call, returns cached instance thereafter
' Usage: api = GetApi() or data = GetApi().GetItem(id)
' @returns ApiClient singleton instance
function GetApi() as ApiClient
  globalAA = GetGlobalAA()

  if not isValid(globalAA.apiClient)
    globalAA.apiClient = new ApiClient()
  end if

  return globalAA.apiClient
end function
