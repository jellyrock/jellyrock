' @fileoverview Canonical item type display orderings, following the Jellyfin web client section sort order.
' Source: https://github.com/jellyfin/jellyfin-web/blob/1874929aff871d38fd689ad3f5af8204533c2e6b/src/apps/stable/features/search/constants/sectionSortOrder.ts
'
' When adding support for a new type, uncomment it here and add the corresponding label/slot
' handling in the consumer (FavoritesRows.bs, SearchRow.bs).

namespace itemTypeOrder

  ' Types displayed in search result rows, in web-client display order.
  const SEARCH = [
    "Movie", ' Movies
    "Series", ' Shows
    "Episode", ' Episodes
    "Person", ' People
    "Playlist", ' Playlists
    "MusicArtist", ' Artists
    "MusicAlbum", ' Albums
    "Audio", ' Songs
    "Video", ' Videos
    "MusicVideo", ' Music Videos
    "Program", ' Programs
    "TvChannel", ' Channels
    "Recording", ' Recordings
    "PhotoAlbum", ' Photo Albums
    "Photo", ' Photos
    ' "Book"        ' Audiobooks / Books: not yet supported
    "BoxSet" ' Collections
  ]

  ' Types displayed in the Favorites home tab, in web-client display order.
  ' Excluded: "Book", not yet supported.
  const FAVORITES = [
    "Movie", ' Movies
    "Series", ' Shows
    "Episode", ' Episodes
    "Person", ' People
    "Playlist", ' Playlists
    "MusicArtist", ' Artists
    "MusicAlbum", ' Albums
    "Audio", ' Songs
    "Video", ' Videos
    "MusicVideo", ' Music Videos
    "Program", ' Programs
    "TvChannel", ' Channels
    "Recording", ' Recordings
    "PhotoAlbum", ' Photo Albums
    "Photo", ' Photos
    ' "Book"        ' Audiobooks / Books: not yet supported
    "BoxSet" ' Collections
  ]

  ' ── ItemDetails exclusion lists ──
  ' Used with inArray() to gate features by item type. When adding a new type,
  ' check each list to decide whether the type belongs.

  ' Types that have no playable media streams (no video/audio codec tracks).
  ' Controls: setTracksInLayout, media source selection in itemContentChanged.
  const NO_MEDIA_TRACKS = [
    "Series",
    "Season",
    "Person",
    "BoxSet",
    "MusicArtist",
    "MusicAlbum",
    "Playlist",
    "Photo",
    "PhotoAlbum",
    "TvChannel",
    "Program"
  ]

  ' Types with no resume button: they don't track playback position, or the app can't resume
  ' them yet. Controls: manageResumeButton in itemContentChanged.
  const NO_RESUME = [
    "Series",
    "Season",
    "MusicArtist",
    "MusicAlbum",
    "Audio",
    ' The server saves its position, but AudioPlayerView doesn't start there, so Resume would
    ' restart the book. Remove when it does (followup audiobook-resume-in-audio-player).
    "AudioBook",
    "Playlist",
    "Photo",
    "PhotoAlbum",
    "TvChannel",
    "Program"
  ]

  ' Types where the watched/unwatched toggle does not apply.
  ' Controls: watchedButton in setupButtons.
  const NO_WATCHED = [
    "Person",
    "MusicArtist",
    "MusicAlbum",
    "Audio",
    "Playlist",
    "Photo",
    "PhotoAlbum",
    "TvChannel",
    "Program"
  ]

end namespace
