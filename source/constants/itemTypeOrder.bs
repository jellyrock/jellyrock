' @fileoverview Canonical item type display orderings, following the Jellyfin web client section sort order.
' Source: https://github.com/jellyfin/jellyfin-web/blob/1874929aff871d38fd689ad3f5af8204533c2e6b/src/apps/stable/features/search/constants/sectionSortOrder.ts
'
' When adding support for a new type, uncomment it here and add the corresponding label/slot
' handling in the consumer (FavoritesRows.bs, SearchRow.bs).

namespace itemTypeOrder

  ' Types displayed in search result rows, in web-client display order.
  const SEARCH = [
    "Movie", ' Movies
    "Series", ' Shows
    "Episode", ' Episodes
    "Person", ' People
    "Playlist", ' Playlists
    "MusicArtist", ' Artists
    "MusicAlbum", ' Albums
    "Audio", ' Songs
    "Video", ' Videos
    "MusicVideo", ' Music Videos
    "Program", ' Programs
    "TvChannel", ' Channels
    "Recording", ' Recordings
    "PhotoAlbum", ' Photo Albums
    "Photo", ' Photos
    ' "Book"        ' Audiobooks / Books — not yet supported
    "BoxSet" ' Collections
  ]

  ' Types displayed in the Favorites home tab, in web-client display order.
  ' Excluded: "Program" (Live TV programs) — programs cannot be favorited, only the channel can.
  ' Excluded: "Book" — not yet supported.
  const FAVORITES = [
    "Movie", ' Movies
    "Series", ' Shows
    "Episode", ' Episodes
    "Person", ' People
    "Playlist", ' Playlists
    "MusicArtist", ' Artists
    "MusicAlbum", ' Albums
    "Audio", ' Songs
    "Video", ' Videos
    "MusicVideo", ' Music Videos
    "TvChannel", ' Channels
    "Recording", ' Recordings
    "PhotoAlbum", ' Photo Albums
    "Photo", ' Photos
    ' "Book"        ' Audiobooks / Books — not yet supported
    "BoxSet" ' Collections
  ]

end namespace
