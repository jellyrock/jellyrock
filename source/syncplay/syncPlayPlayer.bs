' The SyncPlay player model, pure: what the Video node is doing and where it is, kept from what
' the node was told and what it has reported. The node's own fields cannot answer either question:
' its state lags a write by tens of milliseconds, its position moves only on a notification every
' half second, reads stale while paused, and reads a seek's target before the node has moved.
'
' The model is fed five kinds of fact, each with the device clock at that moment:
'   - told: a verb written to the node, and who asked for it (the group, a hold, the viewer).
'   - nodeState: the node's `state` changed.
'   - reading: a position notification.
'   - mounted, reloaded, unmounted, finished: the player's own lifecycle.
'   - advance: time passed, which ends an activity that outlasted its limit.
'
' Nothing here decides what to do. syncPlayConverge compares this model with the group's and asks
' for at most one action. Every time is a LongInteger: epoch milliseconds or Jellyfin ticks
' (decision syncplay-time-longinteger).
namespace syncPlayPlayer

  ' How long after `playing` the first position notification may take before the arrival is
  ' counted as unread. It came 7 to 42 ms after `playing` on 22 seeks (Stick 4K, 2026-11-10).
  const ARRIVAL_READING_MS = 250

  ' Activities:
  '   "none"      no player.
  '   "loading"   a load was told or a player mounted; no first frame yet.
  '   "seeking"   a seek was written and the node has not reported `playing` since. It stays in
  '               flight however long it takes: once it outlasts its budget while buffering it
  '               is also `seekSlow`, a stall the group should hear of, and still not a node
  '               to write to.
  '   "arrived"   the first frame of a load, or a seek's `playing`: the next notification says
  '               where the node landed. A seek lands up to seconds off its target, so the target
  '               is never taken for the landing.
  '   "pausing"   a pause was written and `paused` has not come.
  '   "resuming"  a resume was written and `playing` has not come.
  '   "playing"   the node plays.
  '   "paused"    the node is paused.
  '   "stalling"  the node buffers after playing, for less than the stall bar.
  '   "stalled"   it has buffered past the bar.
  '   "finished"  the item ended.
  '
  ' Clock kinds:
  '   "running"   at `ticks` at `atMs` and playing since (`measured` true from a notification,
  '               false when reckoned from a resume).
  '   "stopped"   paused at `ticks`.
  '   "seeking"   between a seek's write and its landing.
  '   "unknown"   nothing says where the node is.
  function newPlayer() as object
    return {
      activity: "none",
      sinceMs: 0&,
      nodeState: "",
      clock: { kind: "unknown", ticks: 0&, atMs: 0&, measured: false },
      pauseOwner: "",
      ' The viewer has the trick-play bar up. The Video node pauses itself for a scrub with no
      ' write of the player's, so a pause nobody wrote while this holds is the scrub's.
      scrubbing: false,
      pauseWrites: 0,
      pauseWrittenAtMs: 0&,
      pauseTicks: invalid,
      arrivedFrom: "",
      loadStartTicks: 0&,
      ' Counts the loads: one per stream this player started on. The server is told of each
      ' once (syncPlayConverge's Buffering for a load).
      loadCount: 0,
      ' A load was told and its player has not mounted yet: that mount is the same load.
      loadTold: false,
      toldUnmount: false,
      seekTargetTicks: 0&,
      seekWrittenAtMs: 0&,
      seekOwner: "",
      seekSlow: false,
      lastSeekMs: 0&,
      lastSeekGaveUp: false,
      lastLandingTicks: invalid
    }
  end function

  ' --- facts in ---

  ' A verb was written to the node at nowMs.
  ' @param verb - "load", "stop", "pause", "resume" or "seek"
  ' @param owner - who asked: "group", "hold" (a correction's wait for the group) or "viewer"
  ' @param targetTicks - a seek's target, or a load's start; ignored otherwise
  sub told(player as object, verb as string, owner as string, targetTicks as dynamic, nowMs as longinteger)
    if verb = "load"
      ' The player now mounted, if any, unmounts for the new one: that unmount is the load's.
      player.toldUnmount = player.activity <> "none"
      ' Every load told is a load of its own, one that replaces a load still in flight included.
      player.loadCount++
      player.loadTold = true
      enter(player, "loading", nowMs)
      player.loadStartTicks = 0&
      if syncPlayTime.isWholeNumber(targetTicks) then player.loadStartTicks = syncPlayTime.asLong(targetTicks)
      setClock(player, "unknown", 0&, nowMs, false)
    else if verb = "stop"
      player.toldUnmount = player.activity <> "none"
    else if verb = "pause"
      toldPause(player, owner, nowMs)
    else if verb = "resume"
      if player.activity = "paused" then enter(player, "resuming", nowMs)
    else if verb = "seek"
      if player.activity = "none" or player.activity = "loading" or player.activity = "finished" then return
      player.seekTargetTicks = syncPlayTime.asLong(targetTicks)
      player.seekWrittenAtMs = nowMs
      player.seekOwner = owner
      player.seekSlow = false
      ' A seek starts the node afresh, so pause writes are counted from its landing.
      player.pauseWrites = 0
      player.pauseOwner = ""
      player.pauseTicks = invalid
      enter(player, "seeking", nowMs)
      setClock(player, "seeking", 0&, nowMs, false)
    end if
  end sub

  ' A pause is written once. A second write while the first is landing, or on a node already
  ' paused, moves nothing: it only says who the pause now belongs to (the group's Pause coming
  ' back for the viewer's own, or the group pausing a node a hold had stopped).
  sub toldPause(player as object, owner as string, nowMs as longinteger)
    activity = player.activity
    if activity = "paused" or activity = "pausing"
      player.pauseOwner = owner
      return
    end if
    if activity <> "playing" and activity <> "arrived" and activity <> "stalling" and activity <> "stalled" then return
    player.pauseOwner = owner
    player.pauseWrites++
    player.pauseWrittenAtMs = nowMs
    ' Where the write stopped the node: the running clock read at the write.
    player.pauseTicks = positionAt(player, nowMs)
    enter(player, "pausing", nowMs)
  end sub

  ' The viewer opened or closed the trick-play bar.
  sub scrub(player as object, isScrubbing as boolean)
    player.scrubbing = isScrubbing
    if isScrubbing and player.activity = "paused" and player.pauseOwner = "" then player.pauseOwner = "scrub"
    if not isScrubbing and player.pauseOwner = "scrub" then player.pauseOwner = ""
  end sub

  ' A player mounted for a load.
  ' @param startTicks - where the load was asked to start, or invalid for the item's start
  sub mounted(player as object, startTicks as dynamic, nowMs as longinteger)
    player.toldUnmount = false
    player.nodeState = ""
    player.pauseOwner = ""
    player.scrubbing = false
    player.pauseWrites = 0
    player.pauseTicks = invalid
    player.seekSlow = false
    player.lastSeekMs = 0&
    player.lastSeekGaveUp = false
    player.lastLandingTicks = invalid
    player.loadStartTicks = 0&
    if syncPlayTime.isWholeNumber(startTicks) then player.loadStartTicks = syncPlayTime.asLong(startTicks)
    ' The mount of a load already told is that load; any other mount is a load of its own.
    if not player.loadTold then player.loadCount++
    player.loadTold = false
    enter(player, "loading", nowMs)
    setClock(player, "unknown", 0&, nowMs, false)
  end sub

  ' The player loads its stream again in place (a track, quality or version change, a retry). What
  ' was learned about the old stream's seeks does not carry over.
  sub reloaded(player as object, startTicks as dynamic, nowMs as longinteger)
    if player.activity = "none" then return
    ' A retry before the first frame is the same load: the server has its Buffering already.
    player.loadTold = player.activity = "loading"
    mounted(player, startTicks, nowMs)
  end sub

  ' The player left.
  ' @returns true when the model had told it to (a stop, or a load that replaces it), false when
  '   the viewer or a fault took it away
  function unmounted(player as object, nowMs as longinteger) as boolean
    wasTold = player.toldUnmount
    player.toldUnmount = false
    player.nodeState = ""
    ' A load in flight keeps waiting for its own player.
    if wasTold and player.activity = "loading" then return true
    enter(player, "none", nowMs)
    setClock(player, "unknown", 0&, nowMs, false)
    player.pauseOwner = ""
    player.scrubbing = false
    return wasTold
  end function

  sub finished(player as object, nowMs as longinteger)
    if player.activity = "none" then return
    enter(player, "finished", nowMs)
    setClock(player, "unknown", 0&, nowMs, false)
  end sub

  ' The node's `state` changed.
  sub nodeState(player as object, state as string, nowMs as longinteger)
    player.nodeState = state
    activity = player.activity
    if activity = "none" or activity = "finished" then return
    if state <> "playing" and state <> "paused" and state <> "buffering" then return

    if activity = "loading"
      if state = "playing" then arrive(player, "load", nowMs)
      if state = "paused" then pausedUnknown(player, nowMs)
    else if activity = "seeking"
      if state = "playing" then arrive(player, "seek", nowMs)
      if state = "paused"
        endSeek(player, nowMs, false, invalid)
        pausedUnknown(player, nowMs)
      end if
    else if activity = "arrived"
      if state = "buffering" then stall(player, nowMs)
      if state = "paused" then pausedUnknown(player, nowMs)
    else if activity = "pausing"
      ' `buffering` is the node passing through on its way to `paused`.
      if state = "paused" then pauseLanded(player, nowMs)
    else if activity = "resuming"
      if state = "playing"
        enter(player, "playing", nowMs)
        ' A resume from a known stop starts the run there: it predicted the next notification
        ' to within 26 ms in 9 resumes (Stick 4K, 2026-11-10).
        if player.clock.kind = "stopped"
          setClock(player, "running", player.clock.ticks, nowMs, false)
        else
          setClock(player, "unknown", 0&, nowMs, false)
        end if
        player.pauseOwner = ""
      end if
    else if activity = "playing"
      ' Any state change ends the run the clock described, so a stall is never counted as played.
      if state = "buffering" then stall(player, nowMs)
      if state = "paused" then pausedUnknown(player, nowMs)
    else if activity = "paused"
      if state = "playing"
        enter(player, "playing", nowMs)
        setClock(player, "unknown", 0&, nowMs, false)
        player.pauseOwner = ""
      end if
    else if activity = "stalling" or activity = "stalled"
      if state = "playing"
        enter(player, "playing", nowMs)
        setClock(player, "unknown", 0&, nowMs, false)
      end if
      if state = "paused" then pausedUnknown(player, nowMs)
    end if
  end sub

  ' A position notification.
  sub reading(player as object, positionTicks as longinteger, nowMs as longinteger)
    if player.activity = "arrived"
      ' A seek's first reading says where the node was when it began playing, and can reach the
      ' model well after that: the node played on meanwhile, so the run starts at the `playing`
      ' state, not at the reading's arrival. Past one notification interval it is a later
      ' reading, taken as it comes.
      runsFromMs& = nowMs
      if player.arrivedFrom = "seek"
        endSeek(player, nowMs, false, positionTicks)
        arrivedAtMs& = syncPlayTime.asLong(player.sinceMs)
        if nowMs - arrivedAtMs& <= syncPlayPlayback.LANDING_READING_MAX_MS then runsFromMs& = arrivedAtMs&
      end if
      enter(player, "playing", nowMs)
      setClock(player, "running", positionTicks, runsFromMs&, true)
    else if player.activity = "playing"
      setClock(player, "running", positionTicks, nowMs, true)
    end if
    ' Any other activity: the field reads a seek's target, or the position from before a pause.
  end sub

  ' Time passed: end an activity that outlasted its limit.
  sub advance(player as object, nowMs as longinteger)
    due = nextDeadlineMs(player)
    if not isValid(due) or nowMs < syncPlayTime.asLong(due) then return
    activity = player.activity
    if activity = "seeking"
      ' The seek's budget ran out with no `playing`. A node still buffering is still seeking: a
      ' write now could leave it buffering for good, so it stays in flight, marked slow so the
      ' group hears of the stall. A node that never answered the seek is left where its state
      ' says, with nothing known of its position.
      if player.nodeState = "buffering"
        player.seekSlow = true
        player.lastSeekGaveUp = true
        return
      end if
      endSeek(player, nowMs, true, invalid)
      if player.nodeState = "paused"
        pausedUnknown(player, nowMs)
      else
        enter(player, "playing", nowMs)
        setClock(player, "unknown", 0&, nowMs, false)
      end if
    else if activity = "arrived"
      ' No notification came: the node plays, and where it landed is not known.
      if player.arrivedFrom = "seek" then endSeek(player, nowMs, false, invalid)
      enter(player, "playing", nowMs)
      setClock(player, "unknown", 0&, nowMs, false)
    else if activity = "pausing"
      ' The write did not take: the node is where its state says.
      player.pauseTicks = invalid
      player.pauseOwner = ""
      if player.nodeState = "buffering"
        stall(player, nowMs)
      else
        enter(player, "playing", nowMs)
        setClock(player, "unknown", 0&, nowMs, false)
      end if
    else if activity = "resuming"
      ' A node that left `paused` and buffers is resuming slowly: a stall, and a second resume
      ' written to it could leave it buffering for good. One still paused did not take the
      ' write, and is where it was.
      if player.nodeState = "buffering"
        stall(player, nowMs)
      else
        enter(player, "paused", nowMs)
      end if
    else if activity = "stalling"
      enter(player, "stalled", nowMs)
    end if
  end sub

  ' The device-clock time at which advance has something to do, or invalid.
  function nextDeadlineMs(player as object) as dynamic
    activity = player.activity
    since& = syncPlayTime.asLong(player.sinceMs)
    if activity = "seeking" and not player.seekSlow then return since& + syncPlayPlayback.SEEK_SETTLE_MS
    if activity = "arrived" then return since& + ARRIVAL_READING_MS
    if activity = "pausing" or activity = "resuming" then return since& + syncPlayPlayback.PAUSE_CONFIRM_MS
    if activity = "stalling" then return since& + syncPlayPlayback.STALL_MS
    return invalid
  end function

  ' --- facts out ---

  ' Where the node is at nowMs, in ticks, or invalid when not known: a running clock run forward
  ' (no further than one late notification allows), or a stopped clock as it stands.
  function positionAt(player as object, nowMs as longinteger) as dynamic
    clock = player.clock
    if clock.kind = "stopped" then return syncPlayTime.asLong(clock.ticks)
    if clock.kind <> "running" then return invalid
    ageMs& = nowMs - syncPlayTime.asLong(clock.atMs)
    if ageMs& < 0 or ageMs& > syncPlayPlayback.PAUSE_ESTIMATE_MAX_AGE_MS then return invalid
    return syncPlayTime.asLong(clock.ticks) + syncPlayTime.msToTicks(ageMs&)
  end function

  ' Whether a write is in flight on the node, so nothing but a stop may be written to it.
  function isInFlight(player as object) as boolean
    activity = player.activity
    return activity = "loading" or activity = "seeking" or activity = "arrived" or activity = "pausing" or activity = "resuming"
  end function

  ' --- internals ---

  sub enter(player as object, activity as string, nowMs as longinteger)
    player.activity = activity
    player.sinceMs = nowMs
  end sub

  sub setClock(player as object, kind as string, ticks as longinteger, nowMs as longinteger, measured as boolean)
    player.clock = { kind: kind, ticks: ticks, atMs: nowMs, measured: measured }
  end sub

  sub arrive(player as object, origin as string, nowMs as longinteger)
    player.arrivedFrom = origin
    enter(player, "arrived", nowMs)
  end sub

  sub stall(player as object, nowMs as longinteger)
    enter(player, "stalling", nowMs)
    setClock(player, "unknown", 0&, nowMs, false)
  end sub

  ' The node is paused and nothing says where: a pause no write of the model's explains, or one
  ' that landed with no clock to stop.
  sub pausedUnknown(player as object, nowMs as longinteger)
    enter(player, "paused", nowMs)
    setClock(player, "unknown", 0&, nowMs, false)
    player.pauseTicks = invalid
    player.pauseWrites = 0
    if player.scrubbing and player.pauseOwner = "" then player.pauseOwner = "scrub"
  end sub

  ' The pause's `paused` state came. The stop is known when the clock ran at the write and the
  ' state came within the landing limit of it (26 to 40 ms measured, Stick 4K, 2026-11-10).
  sub pauseLanded(player as object, nowMs as longinteger)
    ticks = player.pauseTicks
    landedInTime = nowMs - syncPlayTime.asLong(player.pauseWrittenAtMs) <= syncPlayPlayback.PAUSE_LANDED_MS
    enter(player, "paused", nowMs)
    player.pauseWrites = 0
    player.pauseTicks = invalid
    if syncPlayTime.isWholeNumber(ticks) and landedInTime
      setClock(player, "stopped", syncPlayTime.asLong(ticks), nowMs, false)
    else
      setClock(player, "unknown", 0&, nowMs, false)
    end if
  end sub

  ' The seek in flight is over: how long it took, whether it was given up, and where it landed
  ' (invalid when no notification said).
  sub endSeek(player as object, nowMs as longinteger, gaveUp as boolean, landingTicks as dynamic)
    player.lastSeekMs = nowMs - syncPlayTime.asLong(player.seekWrittenAtMs)
    ' A seek that outlasted its budget counts as given up even when it lands in the end: the
    ' next one would be as slow.
    player.lastSeekGaveUp = gaveUp or player.seekSlow
    player.seekSlow = false
    player.lastLandingTicks = landingTicks
  end sub

end namespace
