import "pkg:/source/syncplay/syncPlayQueue.bs"
import "pkg:/source/utils/queueRepeat.bs"

' The player's side of SyncPlay: what PlayerHostView, VideoPlayerView and the OSD call. All run on the
' render thread, where an m.global read took 2.0 µs on a Stick 4K (2026-08-23, threading.md),
' so `following()` is cheap enough for a position tick. The manager is created in
' setGlobalNodes(); a test scene may have none, so every call tolerates its absence.
namespace syncPlayHooks

  ' True while this device is in a group and following its playback: the local auto-behaviors
  ' (still watching, the next-item advance, Next Episode, segment skip, Cinema Mode) stand down.
  function following() as boolean
    manager = m.global.syncPlayManager
    if not isValid(manager) then return false
    return manager.following = true
  end function

  ' Hand a player event to the manager while following. The evt shapes are SyncPlayManager.playerEvent's.
  sub notify(evt as object)
    manager = m.global.syncPlayManager
    if not isValid(manager) or manager.following <> true then return
    manager.callFunc("playerEvent", evt)
  end sub

  ' The group's playlist as the player's previous and next read it while following: its playing
  ' index, its length, its repeat mode and the two steps it allows (syncPlayQueue.stepBounds).
  ' invalid while not following, so the caller keeps the local queue's behavior.
  function groupQueue() as dynamic
    manager = m.global.syncPlayManager
    if not isValid(manager) or manager.following <> true then return invalid
    sync = manager.sync
    if not isValid(sync) or not isValid(sync.playingItemIndex) or not isValid(sync.playlistCount) then return invalid
    repeatMode = queueRepeat.normalize(sync.repeatMode)
    bounds = syncPlayQueue.stepBounds(sync.playingItemIndex, sync.playlistCount, repeatMode)
    return { index: sync.playingItemIndex, count: sync.playlistCount, repeatMode: repeatMode, hasPrevious: bounds.hasPrevious, hasNext: bounds.hasNext, previousIndex: bounds.previousIndex, nextIndex: bounds.nextIndex }
  end function

  ' What the OSD gear's SyncPlay rows show while following (playbackSettingsMenu.rows): the
  ' group's shuffle word and the viewer's SyncPlay Time Offset setting. invalid while not
  ' following, and the gear shows no SyncPlay rows.
  function groupModes() as dynamic
    manager = m.global.syncPlayManager
    if not isValid(manager) or manager.following <> true then return invalid
    sync = manager.sync
    if not isValid(sync) then return invalid
    offsetMs = 0
    user = m.global.user
    if isValid(user) and isValid(user.settings) and isValid(user.settings.playbackSyncPlayTimeOffsetMs) then offsetMs = user.settings.playbackSyncPlayTimeOffsetMs
    return { shuffleMode: syncPlayQueue.normalizeShuffle(sync.shuffleMode), offsetMs: offsetMs }
  end function

  ' The viewer picked Leave Group in the player: POST /SyncPlay/Leave, and the GroupLeft that
  ' answers ends the membership (SyncPlayManager.leave). What plays goes on as the viewer's own.
  ' False outside a group.
  function leaveGroup() as boolean
    manager = m.global.syncPlayManager
    if not isValid(manager) or manager.inGroup <> true then return false
    return manager.callFunc("leave") = true
  end function

  ' The viewer pressed pause: true when the player should pause the node itself, always so while not
  ' following. False means a seek's landing will (SyncPlayManager.viewerPause).
  function viewerPause() as boolean
    manager = m.global.syncPlayManager
    if not isValid(manager) or manager.following <> true then return true
    return manager.callFunc("viewerPause") = true
  end function

  ' Whether the viewer should take the player as paused. While following, a drift correction's hold
  ' is not their pause, and a pause waiting on a seek's landing is (SyncPlayManager.pausedForViewer).
  ' @param nodeState - the Video node's `state`
  function pausedForViewer(nodeState as string) as boolean
    manager = m.global.syncPlayManager
    if not isValid(manager) or manager.following <> true then return nodeState = "paused"
    return manager.callFunc("pausedForViewer", nodeState) = true
  end function

  ' Where a reload in place starts: the group's position while following and known, so the node
  ' loads where the group is (decision syncplay-reload-starts-where-group-is); else the player's own
  ' start, unchanged (its position, or invalid for a stream that has not played).
  function reloadStart(playerStartTicks as dynamic) as dynamic
    manager = m.global.syncPlayManager
    if not isValid(manager) or manager.following <> true then return playerStartTicks
    return manager.callFunc("reloadStart", playerStartTicks)
  end function

  ' Whether a seek for the group is in flight, so a pause pressed now can wait for its landing.
  function seekInFlight() as boolean
    manager = m.global.syncPlayManager
    if not isValid(manager) or manager.following <> true then return false
    return manager.callFunc("seekInFlight") = true
  end function

  ' Ask the group for a control the viewer pressed (SyncPlayManager.control has the shapes; a
  ' repeat or shuffle pick carries its `mode`, and a time offset pick, which asks the group for
  ' nothing, only that the manager take the saved setting now): true
  ' when the request was posted, so the server's command will move every member, false when the
  ' player should act on its own. The server's answer comes later, as a command or not at all. A pause is the one control the player also applies at once.
  function control(request as object) as boolean
    manager = m.global.syncPlayManager
    if not isValid(manager) or manager.following <> true then return false
    return manager.callFunc("control", request) = true
  end function

end namespace
