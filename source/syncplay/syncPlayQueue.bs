import "pkg:/source/syncplay/syncPlayTime.bs"
import "pkg:/source/utils/nodeHelpers.bs"
import "pkg:/source/utils/playKind.bs"
import "pkg:/source/utils/queueRepeat.bs"

' Turning a SyncPlay play queue into QueueManager items, pure. The server's PlayQueue update
' names items by id only; SyncPlayManager fetches the one it plays (GET /Items?ids=…) and hands
' the raw item here with that playlist entry. The local queue holds the group's playing item
' alone: while following, the next item is the server's answer to NextItem, never a local
' advance, so the other items' metadata has no reader, and the group's playlist (ids and the
' playing index, in syncPlayState) is what the OSD's previous and next read.
namespace syncPlayQueue

  ' The server's GroupShuffleMode words. The repeat words are queueRepeat.bs's: the group's
  ' PlayQueue update and the viewer's pick in the gear carry the same RepeatMode values.
  const SHUFFLE_OFF = "Sorted"
  const SHUFFLE_ON = "Shuffle"

  ' The shuffle mode as one of the two values: anything else (an empty field, a 10.7 line that
  ' sends none) is off.
  function normalizeShuffle(mode as dynamic) as string
    if syncPlayTime.isText(mode) and mode = SHUFFLE_ON then return SHUFFLE_ON
    return SHUFFLE_OFF
  end function

  ' The playlist entry the group is playing, or invalid while it plays nothing.
  ' @param state - syncPlayState
  function playingEntry(state as object) as dynamic
    if not isValid(state) or type(state.playlist) <> "roArray" or state.playingItemId = "" then return invalid
    for each entry in state.playlist
      if entry.playlistItemId = state.playingItemId then return entry
    end for
    return invalid
  end function

  ' The items of every page of a fetched queue, in page order, or invalid when any page is not
  ' usable: a resolved but unusable answer is a missing item, which the caller treats as a failure.
  ' @param responses - the pool responses, one per page: [{ ok, json }]
  function pagedItems(responses as object) as dynamic
    if type(responses) <> "roArray" then return invalid
    items = []
    for each res in responses
      if not isValid(res) or res.ok <> true or not isValid(res.json) then return invalid
      if type(res.json.Items) <> "roArray" then return invalid
      items.append(res.json.Items)
    end for
    return items
  end function

  ' The QueueManager item AAs for a playlist, in playlist order, each carrying its
  ' syncPlayPlaylistItemId (what commands and the Ready report name the item by). An entry whose
  ' item the server did not return is dropped: the member cannot play what it cannot see.
  ' @param playlist - syncPlayMessage's [{ itemId, playlistItemId }]
  ' @param items - the raw Jellyfin items (PascalCase AAs) the fetch returned, any order
  function queueItemsFor(playlist as object, items as object) as object
    byId = {}
    if type(items) = "roArray"
      for each item in items
        if isValid(item) and isValidAndNotEmpty(item.Id) then byId[item.Id] = item
      end for
    end if
    queueItems = []
    if type(playlist) <> "roArray" then return queueItems
    for each entry in playlist
      raw = byId[entry.itemId]
      if isValid(raw)
        queueItem = nodeHelpers.createQueueItem(raw)
        if isValid(queueItem)
          queueItem.syncPlayPlaylistItemId = entry.playlistItemId
          queueItems.push(queueItem)
        end if
      end if
    end for
    return queueItems
  end function

  ' The index of the playlist item in the built queue, or -1. Dropped entries shift the server's
  ' PlayingItemIndex, so the position is found by id, never copied.
  function positionOf(queueItems as object, playlistItemId as string) as integer
    for i = 0 to queueItems.count() - 1
      if queueItems[i].syncPlayPlaylistItemId = playlistItemId then return i
    end for
    return -1
  end function

  ' A PlayQueue update no newer than the one applied is stale (web's updatePlayQueue guard): the
  ' two transports can deliver out of order after a reconnect.
  function isStaleQueueUpdate(state as object, update as object) as boolean
    if not isValid(update) or update.kind <> "syncplayupdate" or update.updateType <> "PlayQueue" then return false
    if not syncPlayTime.isWholeNumber(update.lastUpdateMs) then return true
    if state.lastUpdateMs = 0& then return false
    return syncPlayTime.asLong(update.lastUpdateMs) <= state.lastUpdateMs
  end function

  ' Whether the group's playing item is the last of its playlist, so a finished item has nothing to
  ' move on to. The group's playlist, not the local queue: the local one drops items this member
  ' cannot see. Under RepeatAll the server's Next() wraps to the first item, and under RepeatOne
  ' it stays on this one, so no item is last then (PlayQueueManager.Next, read 2026-11-03).
  function isLastItem(state as object) as boolean
    if state.playingItemIndex < 0 or state.playingItemIndex >= state.playlist.count() then return true
    if queueRepeat.normalize(state.repeatMode) <> queueRepeat.OFF then return false
    return state.playingItemIndex >= state.playlist.count() - 1
  end function

  ' Whether this player can follow a queue item. Only the video player has group hooks, so an item
  ' it does not play (music, Live TV) cannot be followed: phase C is video only.
  function followsItem(queueItem as dynamic) as boolean
    if not isValid(queueItem) then return false
    return playKind.of(queueItem.type) = playKind.VIDEO
  end function

  ' Whether a QueueManager item is the one the group is playing: queueItemsFor stamps the
  ' playlist id, and nothing else in the app sets it.
  function isGroupItem(queueItem as dynamic, playingItemId as string) as boolean
    if not isValid(queueItem) or playingItemId = "" then return false
    playlistItemId = queueItem.syncPlayPlaylistItemId
    return syncPlayTime.isText(playlistItemId) and playlistItemId = playingItemId
  end function

  ' Whether a QueueManager item came from a group's playlist, whatever the group plays now: the
  ' load of such an item queues nothing after it (the following episodes), since the group's
  ' playlist is the queue and the server names what follows.
  function isGroupQueueItem(queueItem as dynamic) as boolean
    if not isValid(queueItem) then return false
    playlistItemId = queueItem.syncPlayPlaylistItemId
    return syncPlayTime.isText(playlistItemId) and playlistItemId <> ""
  end function

  ' What the OSD's previous and next may ask of the group, from the group's playlist and its
  ' repeat mode: the same rule as the local queue's (queueRepeat.nextIndex, previousIndex), since
  ' the server's Next() and Previous() wrap under RepeatAll and replay under RepeatOne. Off, a
  ' step past either end has no item to go to.
  ' @param index - the group's playing index
  ' @param count - the group's playlist length
  ' @param repeatMode - the group's RepeatMode
  function stepBounds(index as integer, count as integer, repeatMode = "" as dynamic) as object
    return { hasPrevious: queueRepeat.previousIndex(repeatMode, index, count) >= 0, hasNext: queueRepeat.nextIndex(repeatMode, index, count) >= 0 }
  end function

  ' What a play pressed while in a group asks of the group in place of a local start (decision
  ' B). A current item already in the group's playlist is a jump to it (SetPlaylistItem);
  ' anything else replaces the group's queue with this one (SetNewQueue), from the queue's
  ' position and the current item's starting point. invalid for an empty queue, or one holding
  ' an item this player could not follow (music, Live TV): that queue plays locally, and its
  ' mount halts the member.
  ' @param queueItems - QueueManager's queue
  ' @param position - the queue's current index
  ' @param state - syncPlayState
  function handoff(queueItems as object, position as integer, state as object) as dynamic
    if type(queueItems) <> "roArray" or position < 0 or position >= queueItems.count() then return invalid
    for each queueItem in queueItems
      if not followsItem(queueItem) or not syncPlayTime.isText(queueItem.id) then return invalid
    end for
    current = queueItems[position]
    if type(state.playlist) = "roArray"
      for each entry in state.playlist
        if entry.itemId = current.id then return { action: "setPlaylistItem", playlistItemId: entry.playlistItemId }
      end for
    end if
    itemIds = []
    for each queueItem in queueItems
      itemIds.push(queueItem.id)
    end for
    startTicks& = 0&
    if syncPlayTime.isWholeNumber(current.startingPoint) then startTicks& = syncPlayTime.asLong(current.startingPoint)
    return { action: "setNewQueue", itemIds: itemIds, position: position, startPositionTicks: startTicks& }
  end function

  ' Whether a queue update starts this member on an item: a new playlist, a step to the next or
  ' previous item, a jump to another item, or a removal that took the playing item with it. A
  ' NextItem or PreviousItem counts even when the id is unchanged: under RepeatOne the server
  ' keeps the index, sends the update and waits on every member's Ready, so the item starts over
  ' (WaitingGroupState.HandleRequest(NextItemGroupRequest), read 2026-11-03; jellyfin-web's
  ' QueueCore sets the current item again without comparing ids).
  function changesPlayingItem(reason as string, previousPlaylistItemId as string, playlistItemId as string) as boolean
    if reason = "NewPlaylist" or reason = "NextItem" or reason = "PreviousItem" then return true
    if reason = "SetCurrentItem" or reason = "RemoveItems"
      return previousPlaylistItemId <> playlistItemId
    end if
    return false
  end function

  ' Whether a NextItem or PreviousItem frame for the item already playing is a restart this member
  ' is already part of, so it reloads nothing. Under RepeatOne the server keeps the index on a
  ' step and drops a duplicate only by playlist id, which is unchanged, so two members' steps
  ' restart the group twice; each restart resets the server's waiting set and waits on every
  ' member's Ready again, and a reload for the second would make the group wait a third time
  ' (WaitingGroupState and PlayQueueManager, read 2026-11-03).
  '   - "loading": the restart's load is owed, or running, or its player has not mounted yet. The
  '     Ready at its end names the same playlist id and answers both.
  '   - "ready": the player holds the start, paused, and no command came since the item last changed
  '     (the group's Unpause would have). The Ready it sent was for the wait the server reset, so
  '     it goes out again.
  '   - "": a different item, another reason, or a restart that has begun to play: a load.
  ' @param loadInFlight - a load is owed, or a reload was asked for and the player has not mounted
  ' @param trackerPhase - the ready tracker's phase
  ' @param playerState - the Video node's state
  ' @param lastCommand - the last group command applied or scheduled, or invalid
  ' @param queueChangedAtMs - the LastUpdate of the update that last changed the playing item
  function restartAbsorbed(reason as string, previousPlaylistItemId as string, playlistItemId as string, loadInFlight as boolean, trackerPhase as string, playerState as string, lastCommand as dynamic, queueChangedAtMs as longinteger) as string
    if reason <> "NextItem" and reason <> "PreviousItem" then return ""
    if playlistItemId = "" or playlistItemId <> previousPlaylistItemId then return ""
    if loadInFlight or trackerPhase = "loading" then return "loading"
    if trackerPhase <> "ready" or playerState <> "paused" then return ""
    if isValid(lastCommand) and syncPlayTime.isWholeNumber(lastCommand.emittedAtMs) and syncPlayTime.asLong(lastCommand.emittedAtMs) >= queueChangedAtMs then return ""
    return "ready"
  end function

  ' What a PlayQueue frame leaves owed to the player, decided as the frame arrives, when the
  ' playing item before and after it is still known. A frame that lands while the items are in
  ' flight (a state update, a join, a leave) moves the playing item's baseline, so deciding at
  ' apply time would find nothing to load. The record is invalid when no load is owed, or
  ' { newPlaylist } when one is: newPlaylist says the load is a new queue (clear first, start at
  ' the group's position). A frame that leaves the group playing nothing owes no load and drops
  ' any owed before it. A later frame that keeps the item leaves the record as it was, and a
  ' later move keeps newPlaylist true once any frame in the run set it. The owner clears it when
  ' the load is performed, or on a halt, a leave or a join.
  ' @param owedLoad - the record from before this frame: invalid or { newPlaylist }
  ' @param previousPlaylistItemId - the group's playing playlist id before this frame
  ' @param playlistItemId - the group's playing playlist id after this frame
  ' @param absorbed - the frame is a restart this member is part of already (restartAbsorbed)
  function owedLoadAfter(owedLoad as dynamic, reason as string, previousPlaylistItemId as string, playlistItemId as string, absorbed = false as boolean) as dynamic
    if playlistItemId = "" then return invalid
    if absorbed or not changesPlayingItem(reason, previousPlaylistItemId, playlistItemId) then return owedLoad
    newPlaylist = reason = "NewPlaylist" or (isValid(owedLoad) and owedLoad.newPlaylist = true)
    return { newPlaylist: newPlaylist }
  end function

  ' The load owed once the frame answers a play this member handed to the group (claimPlay): a
  ' load whether or not the playing item changed, since the viewer asked for this item even
  ' when it is the one the group was already on (a halted member casting it back; a member
  ' whose player a Stop closed). Nothing more when a load is owed already, or when the group
  ' plays nothing.
  ' @param owedLoad - owedLoadAfter's record for this frame
  ' @param playlistItemId - the group's playing playlist id after this frame
  function owedLoadForClaimedPlay(owedLoad as dynamic, reason as string, playlistItemId as string) as dynamic
    if isValid(owedLoad) or playlistItemId = "" then return owedLoad
    return { newPlaylist: reason = "NewPlaylist" }
  end function

  ' What the viewer is told when the load a queue frame owes runs, decided as the frame arrives,
  ' so one thing that happened is one toast. "followingAgain" when the frame brought a halted
  ' member back, or one brought back earlier is still untold; "" for the queue that answers the
  ' viewer's own join (a server answers a join to a playing or paused group with its queue before
  ' any command, and Joined said it); "groupStarted" otherwise.
  ' @param pending - the notice an earlier frame decided for a load not yet run, or invalid
  ' @param refollowed - whether this frame brought a halted member back
  ' @param answersJoin - whether no command arrived since the join
  function noticeForQueueFrame(pending as dynamic, refollowed as boolean, answersJoin as boolean) as string
    if refollowed or (syncPlayTime.isText(pending) and pending = "followingAgain") then return "followingAgain"
    if answersJoin then return ""
    return "groupStarted"
  end function

  ' The notice the load runs with: none for a play this viewer handed over (told at the claim),
  ' and none for a reload in place unless the member follows again, since the viewer is already
  ' watching with the group. A load no frame decided is the group starting something.
  ' @param frameNotice - noticeForQueueFrame's answer, or invalid
  ' @param action - loadAction's answer
  ' @param claimed - whether a play this viewer handed to the group is still waiting
  function noticeAtLoad(frameNotice as dynamic, action as string, claimed as boolean) as string
    if claimed then return ""
    notice = "groupStarted"
    if syncPlayTime.isText(frameNotice) then notice = frameNotice
    if notice = "followingAgain" or action = "launch" then return notice
    return ""
  end function

  ' What applying the owed load does to the player: "" when nothing is owed, "remount" to reload the
  ' mounted player in place, or "launch" to open the play route. Never the route over a mounted
  ' PlayerHostView: sgRouter reuses it for the same item and covers it, still playing, for another.
  ' @param owedLoad - owedLoadAfter's record
  ' @param hasPlayer - whether a player host is mounted
  function loadAction(owedLoad as dynamic, hasPlayer as boolean) as string
    if not isValid(owedLoad) then return ""
    if hasPlayer then return "remount"
    return "launch"
  end function

  ' Whether a fetched play queue still applies: the member is in the group and still following, and
  ' no newer update arrived while the items were in flight (that one applies its own).
  ' @param state - the membership state
  ' @param lastUpdateMs - the update's LastUpdate when the fetch started, as a LongInteger
  function appliesFetchedQueue(state as object, lastUpdateMs as longinteger) as boolean
    return state.inGroup and state.following and state.lastUpdateMs = lastUpdateMs
  end function

  ' What a failed queue load does next: "retry" or "halt". A request can fail on a blip, so the first
  ' request failure retries once. A missing item will be missing again, so it halts, as does a
  ' request failure on the retry.
  ' @param isRetry - whether this load was already a retry
  ' @param failure - "request" (the fetch was rejected) or "missing" (no Items, or no playing item)
  function loadFailureAction(isRetry as boolean, failure as string) as string
    if failure = "request" and not isRetry then return "retry"
    return "halt"
  end function

end namespace
