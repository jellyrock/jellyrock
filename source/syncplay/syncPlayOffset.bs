' The device-to-server clock offset estimate for SyncPlay. Pure: no HTTP, no node. Phase C's
' TimeSyncTask feeds it one round per GET /GetUtcTime (raw roUrlTransfer, so it can stamp the
' send and receive times itself) and reads the estimate back.
'
' The formula is jellyfin-web's (TimeSync.js): for one round with device send time t0, server
' reception r, server transmission t and device receive time t1,
'   offset = ((r - t0) + (t - t1)) / 2      server clock minus device clock
'   delay  = (t1 - t0) - (t - r)            the round trip less the server's own time
' All times are whole milliseconds (LongInteger, see syncPlayTime.bs), so the half is truncated
' toward zero: a sub-millisecond offset is below anything the estimate resolves.
' The last 8 rounds are kept and the estimate is the one with the shortest delay. The first
' HTTPS round carries the TLS handshake (690 ms and 411 ms on the two test devices, 2026-10-23)
' and loses on delay by itself, so nothing drops it by hand. Measured on the Stick 4K on
' 2026-10-23, the estimate's spread was 5 ms over HTTP and about 60 ms over HTTPS.
namespace syncPlayOffset

  const RING_SIZE = 8
  const BURST_INTERVAL_SECONDS = 60

  ' A fresh estimator: no rounds, no estimate, no extra offset.
  function newEstimator() as object
    return { measurements: [], offsetMs: 0&, delayMs: 0&, hasEstimate: false, extraOffsetMs: 0& }
  end function

  ' The viewer's own correction, in ms, added to the measured offset in every conversion (web's
  ' extraTimeOffset). It stands for the constant a device's audio and video output adds, which
  ' no clock round trip can see: a positive value has this member play that much earlier.
  sub setExtraOffsetMs(estimator as object, extraMs as dynamic)
    estimator.extraOffsetMs = syncPlayTime.asLong(extraMs)
  end sub

  ' One round's offset and delay, all times in ms since the epoch.
  function measure(txDeviceMs as longinteger, rxServerMs as longinteger, txServerMs as longinteger, rxDeviceMs as longinteger) as object
    offset& = ((rxServerMs - txDeviceMs) + (txServerMs - rxDeviceMs)) \ 2
    delay& = (rxDeviceMs - txDeviceMs) - (txServerMs - rxServerMs)
    return { offsetMs: offset&, delayMs: delay& }
  end function

  ' Add one round and recompute the estimate. Returns the estimator (mutated in place).
  function addRound(estimator as object, txDeviceMs as longinteger, rxServerMs as longinteger, txServerMs as longinteger, rxDeviceMs as longinteger) as object
    estimator.measurements.push(measure(txDeviceMs, rxServerMs, txServerMs, rxDeviceMs))
    if estimator.measurements.count() > RING_SIZE then estimator.measurements.shift()
    best = invalid
    for each candidate in estimator.measurements
      if best = invalid or candidate.delayMs < best.delayMs then best = candidate
    end for
    estimator.offsetMs = best.offsetMs
    estimator.delayMs = best.delayMs
    estimator.hasEstimate = true
    return estimator
  end function

  ' Add a round from a GetUtcTime response body ({ RequestReceptionTime, ResponseTransmissionTime })
  ' and the device's send and receive stamps. Returns false, and adds nothing, when either server
  ' time fails to parse.
  function addUtcTimeResponse(estimator as object, txDeviceMs as longinteger, rxDeviceMs as longinteger, body as object) as boolean
    if not isValid(body) then return false
    rxServerMs = syncPlayTime.parseServerTimeMs(body.RequestReceptionTime)
    txServerMs = syncPlayTime.parseServerTimeMs(body.ResponseTransmissionTime)
    if rxServerMs = invalid or txServerMs = invalid then return false
    addRound(estimator, txDeviceMs, rxServerMs, txServerMs, rxDeviceMs)
    return true
  end function

  ' Drop every round (a server switch, a rejoin).
  sub reset(estimator as object)
    estimator.measurements = []
    estimator.offsetMs = 0&
    estimator.delayMs = 0&
    estimator.hasEstimate = false
  end sub

  ' The server's clock now, given the device's clock now, the extra offset included.
  function serverNowMs(estimator as object, deviceNowMs as longinteger) as longinteger
    return deviceNowMs + estimator.offsetMs + estimator.extraOffsetMs
  end function

  ' The device clock reading at which the server's clock reads whenMs (a command's When).
  function deviceTimeForServerMs(estimator as object, whenMs as longinteger) as longinteger
    return whenMs - estimator.offsetMs - estimator.extraOffsetMs
  end function

  ' Seconds until the next burst. Once there is an estimate, jellyfin-web's low-profile interval.
  ' Until then the member holds every command it gets, so a burst that answered nothing is retried
  ' after 1 s, doubling to that interval: web pings 1 s apart until it has three answers.
  ' @param failedBursts - bursts in a row that ended with no estimate
  function nextBurstSeconds(hasEstimate as boolean, failedBursts as integer) as integer
    if hasEstimate then return BURST_INTERVAL_SECONDS
    seconds = 1
    for i = 2 to failedBursts
      seconds = seconds * 2
      if seconds >= BURST_INTERVAL_SECONDS then return BURST_INTERVAL_SECONDS
    end for
    return seconds
  end function

end namespace
