' SyncPlay playback thresholds and position arithmetic, pure: no node, no Timer, no HTTP. The
' thresholds are read by the comparison's policy (syncPlayConverge.defaultPolicy) and the player
' model (syncPlayPlayer); the functions say where a load starts, where the group is by its last
' command, and convert between the Video node's seconds and the wire's ticks.
'
' The rules follow jellyfin-web's PlaybackCore (read at v10.11.0, unchanged since 10.7.0) where
' the server's expectations make them the only correct ones, and depart from it where a device
' measurement says so: Ready after a seek waits for a position notification near the target,
' because at the `playing` edge the Video node can still read the pre-seek position (seen once
' in ten seeks across the two test devices, 2026-10-23), and the server corrects any Ready more
' than MaxPlaybackOffset (500 ms on every server line) off with a Seek command.
' Every time is a LongInteger: epoch milliseconds or Jellyfin ticks (decision
' syncplay-time-longinteger).
namespace syncPlayPlayback

  ' An Unpause seeks first only when the player is further off than this (web's minDelaySkipToSync).
  const SKIP_TO_SYNC_MIN_MS = 400
  ' The longest a position notification can be older than the pause write and still anchor
  ' the pause's position estimate: one notification interval (500 ms of media) plus headroom for a late one.
  const PAUSE_ESTIMATE_MAX_AGE_MS = 1000
  ' A seek counts as landed once a position notification is within this of the target: the
  ' server's own tolerance on a Ready report (Group.MaxPlaybackOffset).
  const READY_TOLERANCE_MS = 500
  ' How long to wait for that notification before reporting Ready with the position in hand. The
  ' Stick 4K took up to 2.6 s from the seek write to `playing` on direct play (2026-10-23).
  const SEEK_SETTLE_MS = 3000
  ' A `buffering` that outlasts this is a stall worth reporting. The node passes through
  ' `buffering` for a few milliseconds on a pause and a resume (4 to 16 ms measured 2026-10-23), and
  ' reporting those made the server pause the whole group twice over per command.
  const STALL_MS = 1000
  ' How long after a pause write the manager checks that it took. A pause landed in under 10 ms
  ' in the phase A spike (2026-10-23) and by the first 200 ms sample on 2026-10-24, so this leaves
  ' headroom.
  const PAUSE_CONFIRM_MS = 1000
  ' How long after a pause's write (the group's or the viewer's) the node's `paused` state may
  ' take to arrive before the position estimate for that pause is not trusted. It arrived 26 to
  ' 40 ms after the write on a Stick 4K (2026-11-10).
  const PAUSE_LANDED_MS = 250
  ' How long after a seek's `playing` state its first position reading may arrive and still be
  ' the landing's own: the notification interval, 500 ms of media.
  const LANDING_READING_MAX_MS = 500
  ' The most pause writes the manager makes for one group command.
  const PAUSE_ATTEMPTS = 3
  ' After an Unpause, once the node plays, a member further ahead of the group than this holds
  ' (the comparison's aheadBarMs). A hold costs a freeze as long as the drift, so it is worth doing small.
  ' A member behind has to seek, which froze the picture for 2.1 to 2.6 s (Stick 4K, 2026-10-31),
  ' so that side waits for SKIP_TO_SYNC_MIN_MS, the bar web sets for a skip.
  const SETTLE_CORRECTION_MS = 150
  ' The bar, either way, for a check a time offset pick armed: the viewer asked for a shift, so a
  ' small one is worth making. Half the gear's step (playbackSettingsMenu.TIME_OFFSET_STEP_MS, a unit
  ' test pins the two), so it sits halfway between the drift reading's own noise and one step: a step
  ' from a member in step crosses it, and noise alone never does. A member resting more than the bar on
  ' the far side can absorb one step, and then ends within the bar of the offset picked, with no
  ' correction. Normal drift keeps the bars above, so jitter never seeks.
  const PICK_CORRECTION_MS = 50
  ' What a lead keeps over the last seek's time, for a seek a little slower than the one before.
  const CORRECTION_LEAD_MARGIN_MS = 500
  ' The comparison's shortest lead for a catch-up. An exact seek decodes forward from the
  ' keyframe before its target, so it takes longer the further past that keyframe it aims, and a
  ' seek slower than the lead lands behind the group with no hold to bring it in step. This
  ' covers a target 10 s past its keyframe on direct play (Stick 4K, 2026-11-11).
  const CATCH_UP_LEAD_MS = 3000

  ' --- positions ---

  ' Whether a seek is in flight, by the phase the manager publishes (SyncPlayManager.trackerPhase).
  function pauseWaitsForSeek(trackerPhase as string) as boolean
    return trackerPhase = "seeking" or trackerPhase = "landing"
  end function

  ' Where a new playlist starts for this member: the last Unpause estimated forward when it is
  ' newer than the queue update (web's startPlayback), a newer Pause or Seek's own position (the
  ' group stands there; a halted member resuming into a paused group lands where it waits), else
  ' the update's own start. Web estimates forward from the update's LastUpdate even for a paused
  ' group and then takes the corrective Seek; the update's position as is reports the paused
  ' player where it is.
  function startPositionTicks(update as object, lastCommand as dynamic, estimator as object, nowMs as longinteger) as longinteger
    if isValid(lastCommand) and lastCommand.emittedAtMs >= update.lastUpdateMs
      if lastCommand.command = "Unpause"
        serverNow& = syncPlayOffset.serverNowMs(estimator, nowMs)
        return syncPlayTime.asLong(lastCommand.positionTicks) + syncPlayTime.msToTicks(serverNow& - lastCommand.whenMs)
      end if
      if lastCommand.command = "Pause" or lastCommand.command = "Seek" then return syncPlayTime.asLong(lastCommand.positionTicks)
    end if
    return syncPlayTime.asLong(update.startPositionTicks)
  end function

  ' Where the group is now, in ticks, for a member that has to say so without a position of its own
  ' it can trust (a reload in place, whose node reads 0 and whose last reading lags): a Pause or a
  ' Seek holds its position, and an Unpause runs its position forward on the measured server clock
  ' from its When. invalid with no command, or one that names no position.
  ' @param reference - the command that says where the group is, or invalid
  function groupPositionTicks(reference as dynamic, estimator as object, nowMs as longinteger) as dynamic
    if not isValid(reference) then return invalid
    lastCommand = reference
    positionTicks& = syncPlayTime.asLong(lastCommand.positionTicks)
    if lastCommand.command = "Pause" or lastCommand.command = "Seek" then return positionTicks&
    if lastCommand.command <> "Unpause" then return invalid
    estimated = unpauseRunForwardMs(lastCommand, estimator, nowMs)
    if not isValid(estimated) then return positionTicks&
    return syncPlayTime.msToTicks(estimated)
  end function

  ' An Unpause's position run forward on the measured server clock to now, in ms, or invalid before
  ' its When (web's playbackDiffMillis).
  function unpauseRunForwardMs(lastCommand as object, estimator as object, nowMs as longinteger) as dynamic
    serverNow& = syncPlayOffset.serverNowMs(estimator, nowMs)
    whenMs& = syncPlayTime.asLong(lastCommand.whenMs)
    if serverNow& < whenMs& then return invalid
    return syncPlayTime.ticksToMs(syncPlayTime.asLong(lastCommand.positionTicks)) + (serverNow& - whenMs&)
  end function

  ' Whether a load starts at the item's start, as a restart's does: within the Ready tolerance of
  ' 0 (Roku starts at the keyframe at or before the asked position). A reload in place or a late
  ' join's mount starts partway in.
  function loadStartsAtItemStart(loadStartTicks as longinteger) as boolean
    return Abs(loadStartTicks) <= syncPlayTime.msToTicks(READY_TOLERANCE_MS)
  end function

  ' Whether the load a same-item restart would be absorbed into starts at the item's start
  ' (syncPlayQueue.restartAbsorbed's loadFromStart). Three loads can be in flight: the player's,
  ' once it mounted (a reload in place moves its start partway in); a launch's, between
  ' playQueue and its player's mount, at the start the manager gave it; and one only owed, not yet
  ' performed, which starts where the group is, 0 after a restart.
  ' @param trackerPhase - what the player is doing (SyncPlayManager.trackerPhase)
  ' @param trackerLoadStartTicks - where the player's load started
  ' @param loadAwaitsReady - a load was performed and its player has not reported Ready
  ' @param loadStartTicks - the start the manager gave that load
  function restartLoadFromStart(trackerPhase as string, trackerLoadStartTicks as longinteger, loadAwaitsReady as boolean, loadStartTicks as longinteger) as boolean
    if trackerPhase = "loading" then return loadStartsAtItemStart(trackerLoadStartTicks)
    if loadAwaitsReady then return loadStartsAtItemStart(loadStartTicks)
    return true
  end function

  ' Whether a seek would run off the item. The player turns a target at or past the end into a seek
  ' 30 s short of it (voiceTransport.computeSeekStatus), so the correction skips it; the item is
  ' about to end anyway.
  ' @param durationSeconds - the player's effective duration; 0 or invalid while unknown
  function seekPastEnd(targetTicks as longinteger, durationSeconds as dynamic) as boolean
    if not isValid(durationSeconds) or durationSeconds <= 0 then return false
    return ticksToSeconds(targetTicks) >= durationSeconds
  end function

  ' --- units ---

  ' The Video node's `position` and `seek` are float seconds; the wire is ticks.
  function secondsToTicks(seconds as dynamic) as longinteger
    if not isValid(seconds) then return 0&
    ms& = Int(seconds * 1000)
    return syncPlayTime.msToTicks(ms&)
  end function

  function ticksToSeconds(ticks as longinteger) as float
    return syncPlayTime.ticksToMs(ticks) / 1000#
  end function

end namespace
