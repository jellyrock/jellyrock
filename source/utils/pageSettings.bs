import "pkg:/source/translationKeys.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/translate.bs"

' Page settings: settings whose value belongs to the screen on show, offered from the
' overhang's settings icon above All settings.
'
' A screen only declares them (JRScreen.pageSettingsEntries) and is told what was picked
' (JRScreen.onPageSettingChanged); JRScene.openPageMenu presents the menu and the picker.
' An entry is { id, title, options: [{ id, title }], selected, valueTitle, pickerTitle, icon }:
' titles are translated text, and `selected` is the id of the option in force. `valueTitle`
' is optional: the value the menu row shows when the selected option's own title does not
' read well there. `pickerTitle` is optional too: the heading of the entry's list when
' it has more to say than the entry's title, as an app-wide setting offered on a page
' does. `isSelectedProvisional` is optional and true when the selected option is what the
' screen draws but not what is saved (a library's count per row raised to a layout's
' floor), so picking it is a change. `icon` is optional: the glyph the entry's menu row wears in
' its gutter, as the player's gear rows do, a pkg: URI at the menu's density. This file is the
' part of that with no node in it.
namespace pageSettings

  ' The menu row that opens the Settings screen.
  const ALL_SETTINGS = "allSettings"
  ' Its glyph: the settings icon at the menu's density (settings_ itself is the overhang's)
  const ALL_SETTINGS_ICON = "pkg:/images/icons/settings_menu_$$RES$$.png"

  ' menuRows: the menu for a screen's entries, All settings last.
  '
  ' A row reads as the player's gear rows do: the entry's title with the selected option's
  ' title after it, or the entry's `valueTitle` when it has one. The Default tab entry
  ' uses it: its first option says where the tab comes from ("Default (Movies)"), which
  ' would read as brackets inside brackets on the row, so the row names the tab alone. Each
  ' row wears its entry's `icon`, and All settings the gear; an entry with none leaves its
  ' gutter empty. No usable entry means no menu, and the settings icon opens Settings in
  ' one press.
  '
  ' Past about three entries the menu gets long for something hanging off an icon: move
  ' them into one Page settings dialog behind a single row here.
  '
  ' @param entries - a screen's pageSettingsEntries()
  ' @return {object} { labels: [string], ids: [string], icons: [string] }
  function menuRows(entries as dynamic) as object
    menu = { labels: [], ids: [], icons: [] }
    if type(entries) <> "roArray" then return menu

    for each entry in entries
      if pageSettings.isEntry(entry)
        label = textOrEmpty(entry.title)
        value = textOrEmpty(entry.valueTitle)
        if value = "" then value = pageSettings.optionTitle(entry, entry.selected)
        if value <> "" then label = translate(translationKeys.LabelSettingWithValue, [label, value])
        menu.labels.push(label)
        menu.ids.push(entry.id)
        menu.icons.push(textOrEmpty(entry.icon))
      end if
    end for
    if menu.ids.count() = 0 then return menu

    menu.labels.push(translate(translationKeys.LabelAllSettings))
    menu.ids.push(pageSettings.ALL_SETTINGS)
    menu.icons.push(pageSettings.ALL_SETTINGS_ICON)
    return menu
  end function

  ' isEntry: whether `entry` has an id and at least one option to pick, every option an
  ' { id, title } with a text id. The other functions here take only entries this passes.
  function isEntry(entry as dynamic) as boolean
    if type(entry) <> "roAssociativeArray" then return false
    if textOrEmpty(entry.id) = "" or textOrEmpty(entry.id) = pageSettings.ALL_SETTINGS then return false
    if type(entry.options) <> "roArray" or entry.options.count() = 0 then return false
    for each option in entry.options
      if type(option) <> "roAssociativeArray" or not pageSettings.isText(option.id) then return false
    end for
    return true
  end function

  ' isText: whether `value` is a string, the empty one included.
  function isText(value as dynamic) as boolean
    return type(value) = "roString" or type(value) = "String"
  end function

  ' findEntry: the entry with `id`, or invalid.
  function findEntry(entries as dynamic, id as string) as dynamic
    if type(entries) <> "roArray" then return invalid
    for each entry in entries
      if pageSettings.isEntry(entry) and entry.id = id then return entry
    end for
    return invalid
  end function

  ' optionTitle: the title of an entry's option `optionId`, or "" when it has none.
  function optionTitle(entry as object, optionId as dynamic) as string
    index = pageSettings.optionIndex(entry, optionId)
    if index < 0 then return ""
    return textOrEmpty(entry.options[index].title)
  end function

  ' optionIndex: where the option `optionId` sits in an entry's options, or -1.
  ' An option's id may be "" (an option that clears the setting), so an id is compared as
  ' text and never tested for being empty.
  function optionIndex(entry as object, optionId as dynamic) as integer
    if not pageSettings.isText(optionId) then return -1
    for i = 0 to entry.options.count() - 1
      if entry.options[i].id = optionId then return i
    end for
    return -1
  end function

  ' picker: what the list dialog for one entry shows.
  '
  ' @return {object} { title: string, labels: [string], values: [string], selectedIndex:
  '   integer }, with selectedIndex -1 when `selected` names no option
  function picker(entry as object) as object
    title = textOrEmpty(entry.pickerTitle)
    if title = "" then title = textOrEmpty(entry.title)
    list = { title: title, labels: [], values: [], selectedIndex: pageSettings.optionIndex(entry, entry.selected) }
    for each option in entry.options
      list.labels.push(textOrEmpty(option.title))
      list.values.push(option.id)
    end for
    return list
  end function

  ' settingEntry: an entry for a user setting, offered on a page it visibly changes. Its title,
  ' its options and their order are the setting's own in settings.json, as the Settings screen
  ' shows them, so the setting reads one way in both places. The entry's id is the setting's
  ' name, and an option's id is the value user.settings.Save takes for it.
  '
  ' A bool setting offers Disabled then Enabled, the Settings screen's two words. A radio
  ' setting offers its options. An integer setting offers `steps.values` (ascending, inside the
  ' setting's range: the caller's to keep), with the value in force placed among them when it
  ' is not a step, so a value typed in Settings is never shown as another. A step's title is
  ' steps.labelFor(value) when the caller gives that function, else the number.
  '
  ' @param setting - the setting's settings.json entry (findConfigTreeKey)
  ' @param current - the setting's value in force, as its JellyfinUserSettings field holds it
  ' @param icon - the menu row's glyph
  ' @param steps - for an integer setting: { values: [integer], labelFor: function(integer) as string }
  ' @return {dynamic} the entry, or invalid for a setting it cannot offer
  function settingEntry(setting as dynamic, current as dynamic, icon = "" as string, steps = invalid as dynamic) as dynamic
    if type(setting) <> "roAssociativeArray" or not pageSettings.isText(setting.settingName) or setting.settingName = "" then return invalid
    entry = { id: setting.settingName, title: pageSettings.jsonText(setting), options: [], selected: "", icon: icon }

    kind = LCase(textOrEmpty(setting.type))
    if kind = "bool"
      entry.options = [
        { id: "false", title: translate(translationKeys.LabelDisabled) },
        { id: "true", title: translate(translationKeys.LabelEnabled) }
      ]
      entry.selected = "false"
      if current = true then entry.selected = "true"
    else if kind = "radio"
      if type(setting.options) = "roArray"
        for each option in setting.options
          if type(option) = "roAssociativeArray" and pageSettings.isText(option.id) and option.id <> ""
            entry.options.push({ id: option.id, title: pageSettings.jsonText(option) })
          end if
        end for
      end if
      entry.selected = textOrEmpty(current)
    else if kind = "integer"
      if type(steps) <> "roAssociativeArray" then return invalid
      inForce = pageSettings.integerInForce(current, setting.default)
      for each value in pageSettings.stepsWith(steps.values, inForce)
        title = value.toStr()
        ' Called through a local, not as steps.labelFor(): a call through the AA would run it
        ' with `m` as the AA, and a label that translates reads m.global.
        labelFor = steps.labelFor
        if isValid(labelFor) then title = labelFor(value)
        entry.options.push({ id: value.toStr(), title: title })
      end for
      if isValid(inForce) then entry.selected = inForce.toStr()
    else
      return invalid
    end if

    if entry.options.count() = 0 then return invalid
    return entry
  end function

  ' A settings.json title: its translation key's text, else its English title.
  function jsonText(item as object) as string
    if pageSettings.isText(item.titleKey) and item.titleKey <> "" then return translate(item.titleKey)
    return textOrEmpty(item.title)
  end function

  ' The integer in force: the field's value, else the setting's default (a string in
  ' settings.json), else invalid.
  function integerInForce(current as dynamic, default as dynamic) as dynamic
    kind = type(current)
    if kind = "roInt" or kind = "roInteger" or kind = "Integer" or kind = "roLongInteger" or kind = "LongInteger" then return Int(current)
    if pageSettings.isText(default) and default <> "" then return Int(Val(default))
    return invalid
  end function

  ' `values` (integers, ascending) with `inForce` placed in order when it is not one of them.
  function stepsWith(values as dynamic, inForce as dynamic) as object
    result = []
    if type(values) <> "roArray" then return result
    isPlaced = not isValid(inForce)
    for each value in values
      if not isPlaced and inForce <= value
        if inForce < value then result.push(inForce)
        isPlaced = true
      end if
      result.push(value)
    end for
    if not isPlaced then result.push(inForce)
    return result
  end function

  ' The picker's close did nothing the scene acts on.
  const PICK_NONE = "none"
  ' Back in the picker: the menu opens again on the entry's row.
  const PICK_REOPEN = "reopen"
  ' The viewer picked an option other than the one in force.
  const PICK_CHANGE = "change"

  ' pickOutcome: what a picker's result asks for.
  '
  ' Only the viewer's own answer acts: a close that code made does nothing, and neither does
  ' picking the option already in force, unless the entry marks it provisional.
  '
  ' @param result - the list dialog's `result`
  ' @param entry - the entry the picker was opened for
  ' @param values - picker(entry).values, parallel to the rows shown
  ' @return {object} { action: PICK_NONE | PICK_REOPEN | PICK_CHANGE, value: string }
  function pickOutcome(result as dynamic, entry as object, values as object) as object
    outcome = { action: pageSettings.PICK_NONE, value: "" }
    if type(result) <> "roAssociativeArray" or result.externallyCancelled = true then return outcome
    if result.cancelled = true
      outcome.action = pageSettings.PICK_REOPEN
      return outcome
    end if

    index = result.optionIndex
    if not isValid(index) or index < 0 or index >= values.count() then return outcome
    isProvisional = entry.isSelectedProvisional = true
    if not isProvisional and pageSettings.isText(entry.selected) and values[index] = entry.selected then return outcome
    outcome.action = pageSettings.PICK_CHANGE
    outcome.value = values[index]
    return outcome
  end function

end namespace
