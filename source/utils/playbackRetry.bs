import "pkg:/source/enums/PlaybackErrorRetry.bs"
import "pkg:/source/utils/misc.bs"

' chooseErrorRetry: Which retry a Video node error gets, or none.
'
' The Dolby Vision retry comes before the re-encode: when preservation forced the transcode,
' direct play is the better answer and the re-encode would only hide that. Each flag is cleared
' by the caller when it takes its retry, so a retry that fails the same way ends in the dialog.
'
' @param {boolean} isBufferLoopError - the error's source is "buffer:loop:"
' @param {boolean} doviFallbackAvailable - Dolby Vision preservation caused the transcode
' @param {boolean} reencodeFallbackAvailable - the stream is a transcode whose video the server may have copied
' @param {boolean} isPlayReported - the stream played at least one frame
' @param {boolean} transcodeAvailable - a direct play that can fall back to a transcode
' @param {boolean} streamRestartAvailable - the server stopped serving the stream (isServerSegmentFailure)
'   and the one restart is armed (streamRestartArmed)
' @return {PlaybackErrorRetry} the retry to take
function chooseErrorRetry(isBufferLoopError as boolean, doviFallbackAvailable as boolean, reencodeFallbackAvailable as boolean, isPlayReported as boolean, transcodeAvailable as boolean, streamRestartAvailable = false as boolean) as PlaybackErrorRetry
  if isBufferLoopError and doviFallbackAvailable then return PlaybackErrorRetry.DOVI_DIRECT_PLAY
  if isBufferLoopError and reencodeFallbackAvailable then return PlaybackErrorRetry.REENCODE_VIDEO
  ' Only a stream that played: before the first frame the transcode fallback, or the dialog,
  ' answers a failing server better than asking it for the same stream again.
  if isPlayReported and streamRestartAvailable then return PlaybackErrorRetry.RESTART_STREAM
  if not isPlayReported and transcodeAvailable then return PlaybackErrorRetry.TRANSCODE
  return PlaybackErrorRetry.NONE
end function

' Seconds a restarted stream must play before a later server failure gets a restart of its own.
' A server that fails again sooner is still failing, so that failure ends in the dialog.
const STREAM_RESTART_REARM_SECONDS = 60

' streamRestartArmed: Whether a server failure may restart the stream.
'
' One restart per failure: unused, it is armed; used, it is armed again only once the restarted
' stream has played for STREAM_RESTART_REARM_SECONDS, so separate failures far apart each get one
' and a server that keeps failing ends in the dialog after one try.
'
' @param {boolean} restartUsed - a restart was taken in this playback
' @param {float} playingSinceSeconds - when the restarted stream reached playing (UpTime), or -1
' @param {float} nowSeconds - now (UpTime)
' @return {boolean} the restart is armed
function streamRestartArmed(restartUsed as boolean, playingSinceSeconds as float, nowSeconds as float) as boolean
  if not restartUsed then return true
  if playingSinceSeconds < 0 then return false
  return nowSeconds - playingSinceSeconds >= STREAM_RESTART_REARM_SECONDS
end function

' noRetryFlags: The flags a load runs with before any retry: the server's own choice.
'
' The flags are VideoPlayerView's retry state. They last for the rest of the version's playback,
' because what a retry learned (direct play fails, the copied video overflows) is a property of
' the file, not of the audio, subtitle or quality picked: every reload carries them, and only a
' version switch starts over. A load with a flag on never offers that flag's fallback again, so a
' playback takes at most one retry of each kind.
'
' @return {object} { bypassDovi, forceTranscode, disallowVideoCopy }, all false
function noRetryFlags() as object
  return { bypassDovi: false, forceTranscode: false, disallowVideoCopy: false }
end function

' retryFlagsWith: The flags after a retry: the ones in place, plus the one the retry turns on.
'
' Flags only turn on. A retry that dropped one would let the server offer again what already
' failed: the re-encode once asked without forceTranscode, and the server, which still allows
' direct play when it may not copy the video, offered the direct play that had failed.
'
' @param {dynamic} flags - the flags in place (noRetryFlags shape), or invalid for none
' @param {PlaybackErrorRetry} retry - the retry being taken
' @return {object} a new flags AA
function retryFlagsWith(flags as dynamic, retry as PlaybackErrorRetry) as object
  result = noRetryFlags()
  if type(flags) = "roAssociativeArray"
    for each key in result
      if isBooleanTrue(flags[key]) then result[key] = true
    end for
  end if
  if retry = PlaybackErrorRetry.DOVI_DIRECT_PLAY then result.bypassDovi = true
  if retry = PlaybackErrorRetry.REENCODE_VIDEO then result.disallowVideoCopy = true
  if retry = PlaybackErrorRetry.TRANSCODE then result.forceTranscode = true
  return result
end function

' hevcFirstCodecList: A comma-separated video codec list with the HEVC entries (h265, hevc) first.
'
' A transcode of a source H.264 cannot carry (prefersHevcTranscode) on a server that encodes HEVC in
' hardware, and the re-encode retry, send it as each video transcoding profile's VideoCodec. The server
' takes the first codec it is allowed to encode: with HEVC encoding on it keeps a 4K source at 4K, and
' with it off it falls through to H.264. Other entries keep their order.
'
' @param {string} codecs - for example "h264,avc,h265,hevc"
' @return {string} for example "h265,hevc,h264,avc"
function hevcFirstCodecList(codecs as string) as string
  hevc = []
  others = []
  for each codec in codecs.split(",")
    name = LCase(codec.trim())
    if name = "hevc" or name = "h265"
      hevc.push(codec)
    else
      others.push(codec)
    end if
  end for
  hevc.append(others)
  return hevc.join(",")
end function
