import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/streamSelection.bs"

' Resuming an item that has alternate versions (several MediaSources).
'
' Servers before Jellyfin 12.0 keep ONE position per item, whichever file played, so any
' version resumes at it and JellyRock is free to pick the file that suits the device best.
' From 12.0 each version keeps its OWN position, saved against the MediaSourceId a playback
' report names (jellyfin#17044). That changes three things for a client:
'
'   * Resuming must continue the file that holds the position. Another version of the same
'     item can be offset from it, even another release of the same cut, and neither names
'     nor runtimes tell a re-encode from a different cut.
'   * The item's own position no longer answers "is this in progress?": a primary whose
'     alternate is in progress reports position 0. The server signals it instead by listing
'     that version FIRST in the primary's MediaSources (its own source is first otherwise).
'   * FINISHING any version marks every version played and clears every position. Carrying
'     a position onto a version it would already count as watched for erases the place the
'     user was resuming from.
'
' So: resume the file that holds the position, and carry a position onto a version the user
' explicitly picked only while the server would still store it there rather than count it
' finished — see wouldMarkPlayed(), which follows the server rule (stricter in one place).
'
' This module is PURE: every function takes plain values and returns plain values, with no
' node, thread or network access. That is what lets the whole decision — including the
' carry guard and everything resumeStateFor() answers — be unit-tested without a seam for
' HTTP, which the component specs have no way to provide. ItemDetails keeps only the
' imperative shell: build the context, ask here, fetch whatever the answer names, ask again.
namespace versionResume

  ' The first release that keeps playback progress per version.
  const PER_VERSION_MIN_SERVER = "12.0.0"

  ' A version position that could not be read (the fetch failed, or the server declined).
  ' Distinct from 0, which means "read, and this version has no position".
  ' LongInteger, like every other value that travels through this module as ticks, so it
  ' compares type-for-type against a position parsed out of a reply.
  const POSITION_UNREADABLE = -1&

  ' How far apart two in-progress versions may sit and still count as being at the SAME
  ' place, so quality decides between them instead of which was played last.
  '
  ' Because a version is only ever resumed at its OWN position, this margin IS the
  ' worst-case misplacement the viewer can feel: pick the 30-seconds-behind version for its
  ' better quality and they resume up to 30 s from where they left. It absorbs the three
  ' ways two positions drift apart for the same moment of content — a constant offset
  ' between two releases of one cut (measured at 4 s on the local mixed-release pair), the
  ' 10 s progress-report cadence when a session ends without a stop report, and the switch
  ' latency when switchTicksFor() carries a position across versions.
  const NEAR_LEVEL_MARGIN_TICKS = 300000000& ' 30 s

  ' isPerVersionServer: Whether the server keeps a separate position per alternate version.
  '
  ' @param {string} serverVersion - m.global.server.version
  ' @return {boolean}
  function isPerVersionServer(serverVersion as string) as boolean
    if not isValidAndNotEmpty(serverVersion) then return false
    return versionChecker(serverVersion, versionResume.PER_VERSION_MIN_SERVER)
  end function

  ' sourceIndexById: Index of the MediaSource with this id, ignoring case.
  '
  ' The lookup is mediaSourceIndexForId (streamSelection.bs), shared with playback start so
  ' both match an id the same way; that is where the case rule is explained.
  '
  ' @param {object} mediaSources - MediaSourceInfo array
  ' @param {string} sourceId
  ' @return {integer} the index, or -1 when absent
  function sourceIndexById(mediaSources as dynamic, sourceId as string) as integer
    return mediaSourceIndexForId(mediaSources, sourceId)
  end function

  ' inProgressSourceIndex: Which version of an item the server says is in progress.
  '
  ' For a screen that can then read that version's own position (ItemDetails): it trusts the
  ' server's source ORDER, which is only a signal on per-version servers — older servers sort
  ' sources by width, so an alternate can lead with no progress at all.
  '
  ' @param {string} itemId - the item whose MediaSources these are
  ' @param {longinteger} itemPositionTicks - the item's own UserData position
  ' @param {object} mediaSources - the item's MediaSources, in server order
  ' @param {boolean} isPerVersion - isPerVersionServer()
  ' @return {integer} index of the in-progress version, or -1 when there is none to honor
  function inProgressSourceIndex(itemId as string, itemPositionTicks as dynamic, mediaSources as dynamic, isPerVersion as boolean) as integer
    if not isPerVersion then return -1
    if type(mediaSources) <> "roArray" or mediaSources.count() < 2 then return -1

    if isValid(itemPositionTicks) and itemPositionTicks > 0
      return versionResume.sourceIndexById(mediaSources, itemId)
    end if

    first = mediaSources[0]
    if isValid(first) and isValidAndNotEmpty(first.Id) and not versionResume.idsMatch(first.Id, itemId) then return 0
    return -1
  end function

  ' idsMatch: Whether two source/item ids name the same thing, ignoring case as
  ' mediaSourceIndexForId does.
  '
  ' @param {dynamic} left
  ' @param {dynamic} right
  ' @return {boolean}
  function idsMatch(left as dynamic, right as dynamic) as boolean
    if not isValidAndNotEmpty(left) or not isValidAndNotEmpty(right) then return false
    return lcase(left) = lcase(right)
  end function

  ' anyVersionInProgress: Does SOME version of this item hold a playback position?
  '
  ' Answered without reading a single position, from two signals that arrive with the item: its
  ' own position, and the server's source ORDER. SetAlternateVersionResumeStates leads a
  ' primary's sources with the most recently played version that HAS a position, and otherwise
  ' leaves the item's own source first — so an alternate in front means progress exists
  ' somewhere, even when the item itself reads 0.
  '
  ' This is the question "are we resuming?" for callers that must answer it BEFORE the version
  ' is chosen: LoadVideoContentTask decides on the Cinema Mode preroll at the top of its run,
  ' long before any position has been read, and a preroll in front of a resume is wrong.
  '
  ' @param {string} itemId - the item these sources belong to
  ' @param {dynamic} itemPositionTicks - its own UserData position
  ' @param {dynamic} mediaSources - its MediaSources, in server order
  ' @param {boolean} isPerVersion - isPerVersionServer()
  ' @return {boolean} true when some version has a position
  function anyVersionInProgress(itemId as string, itemPositionTicks as dynamic, mediaSources as dynamic, isPerVersion as boolean) as boolean
    if isValid(itemPositionTicks) and itemPositionTicks > 0 then return true
    if not isPerVersion then return false
    if type(mediaSources) <> "roArray" or mediaSources.count() < 2 then return false

    first = mediaSources[0]
    if not isValid(first) or not isValidAndNotEmpty(first.Id) then return false
    return not versionResume.idsMatch(first.Id, itemId)
  end function

  ' chooseResumeSource: WHICH version of an item resumes, and from where.
  '
  ' One answer for every entry point — the details screen, quick play, a cast, a queued item
  ' — so the app cannot name one version and play another. Before this, the details screen
  ' honored the server's order while quick play and the progress bars used the item's own
  ' version, so with two versions in progress the screen marked one and played the other.
  '
  ' The rule: the most recently played version wins, UNLESS the in-progress versions sit at
  ' about the same position (NEAR_LEVEL_MARGIN_TICKS, either direction), where the best
  ' version for the device among them wins instead. A version is only ever resumed at its
  ' OWN position — never at another version's, which would move the viewer to a different
  ' place in the content.
  '
  ' "Most recently played" cannot be read from a timestamp: v12.0 copies the newest version's
  ' LastPlayedDate onto the PRIMARY's user data (VersionResumeData.ApplyTo), so once an
  ' alternate has been played more recently the primary's own play time is unreadable. The
  ' server answers it two other ways, and this uses whichever the caller can trust:
  '
  '   * The source ORDER — but only from a PRIMARY. SetAlternateVersionResumeStates moves the
  '     most recently played version that HAS a position to the front of a primary's sources,
  '     and leaves a directly queried alternate's own source first whatever was played last.
  '     So another version in front proves both that this item is a primary and that the
  '     version in front was played last. The item's OWN source in front proves nothing: that
  '     is also every alternate, and the DTO does not say which one this is.
  '   * The resume query, which returns the version that owns the resume point. Asked for only
  '     in that ambiguous case, and only once two versions are in progress, as needsMostRecent;
  '     the caller answers with ctx.mostRecentId (see mostRecentIdFrom).
  '
  ' Device knowledge is deliberately absent from this module (it must stay pure and
  ' unit-testable), so a near-level tie is handed back as tiedIds for the caller to settle
  ' with findBestVideoSource() and ask again with deviceBestId.
  '
  ' @param {object} ctx - {
  '     itemId            string  the item being resumed
  '     itemPositionTicks dynamic the item's OWN position (its own, not the copied date)
  '     mediaSources      dynamic its MediaSources, in server order
  '     positions         object  sourceId -> ticks already known (POSITION_UNREADABLE = failed)
  '     isPerVersion      boolean isPerVersionServer()
  '     mostRecentId      dynamic the answer to a previous needsMostRecent: the version the
  '                               server would resume, or "" when it could not say (optional;
  '                               invalid = not asked yet)
  '     deviceBestId      dynamic the caller's pick among a previous tiedIds (optional)
  '   }
  ' @return {object} {
  '     sourceId        string       the version to resume ("" = no per-version answer; the
  '                                  caller applies its own rule, e.g. device-best from 0)
  '     ticks           longinteger  that version's own position (0 = from the beginning)
  '     isLoading       boolean      the answer is not final yet
  '     needsSourceIds  object       fetch these versions' UserData (empty = nothing to fetch)
  '     needsMostRecent boolean      ask the server which version it would resume, and ask
  '                                  again with mostRecentId
  '     tiedIds         object       2+ ids at the same place: pick device-best among them and
  '                                  ask again with deviceBestId (empty = no tie)
  '   }
  function chooseResumeSource(ctx as object) as object
    answer = { sourceId: "", ticks: 0&, isLoading: false, needsSourceIds: [], needsMostRecent: false, tiedIds: [] }
    if not isValid(ctx) or ctx.isPerVersion <> true then return answer

    sources = ctx.mediaSources
    if type(sources) <> "roArray" or sources.count() < 2 then return answer

    itemTicks = ctx.itemPositionTicks
    if not isValid(itemTicks) or itemTicks < 0 then itemTicks = 0&

    ' Nothing in progress anywhere, and no request needed to know it — every item nobody has
    ' started, which is the common case, therefore costs nothing on the playback path.
    if not versionResume.anyVersionInProgress(ctx.itemId, itemTicks, sources, true) then return answer

    ' Something IS in progress, so every version's position is now load-bearing: one at about
    ' the same place as the most recent wins on quality, and only its own position can be
    ' resumed. The server's order names just the single most recent, so the rest must be read.
    need = []
    for each source in sources
      id = source.Id
      if not isValidAndNotEmpty(id) then continue for
      if versionResume.idsMatch(id, ctx.itemId) then continue for ' already in hand
      if not isValid(versionResume.knownPosition(ctx, id)) then need.push(id)
    end for
    if need.count() > 0
      answer.isLoading = true
      answer.needsSourceIds = need
      return answer
    end if

    ' In server order: from a primary, the first entry is the most recently played.
    inProgress = []
    for each source in sources
      id = source.Id
      if not isValidAndNotEmpty(id) then continue for
      if versionResume.idsMatch(id, ctx.itemId)
        ticks = itemTicks
      else
        ticks = versionResume.knownPosition(ctx, id)
      end if
      ' Unreadable is not "no position": resuming it would be a guess, so it cannot be
      ' chosen, but it also must not be read as 0 and silently restart the content.
      if not isValid(ticks) or ticks = versionResume.POSITION_UNREADABLE then continue for
      if ticks > 0 then inProgress.push({ id: id, ticks: ticks })
    end for

    if inProgress.count() = 0 then return answer
    if inProgress.count() = 1
      answer.sourceId = inProgress[0].id
      answer.ticks = inProgress[0].ticks
      return answer
    end if

    leader = inProgress[0]
    first = sources[0]
    ownSourceLeads = isValid(first) and versionResume.idsMatch(first.Id, ctx.itemId)
    if ownSourceLeads
      ' The order is no signal here (see the header), so the server has to say.
      if not isValid(ctx.mostRecentId)
        answer.isLoading = true
        answer.needsMostRecent = true
        return answer
      end if
      ' An answer naming no version in progress (the query failed, or said nothing about this
      ' item) leaves the order as the only signal left — what this did before it asked.
      for each entry in inProgress
        if versionResume.idsMatch(entry.id, ctx.mostRecentId)
          leader = entry
          exit for
        end if
      end for
    end if

    tied = [leader]
    for each entry in inProgress
      if entry.id = leader.id then continue for
      ' Negated by hand rather than through abs(), which returns a FLOAT: at tick magnitudes
      ' a 24-bit mantissa cannot hold 9 significant digits, so a delta of 300000001 rounds to
      ' the margin itself and ties a version that is past it. Caught by the boundary spec.
      delta& = entry.ticks - leader.ticks
      if delta& < 0& then delta& = -delta&
      if delta& <= versionResume.NEAR_LEVEL_MARGIN_TICKS then tied.push(entry)
    end for

    ' Clear of everything else: the most recently played version is the one being watched.
    if tied.count() = 1
      answer.sourceId = leader.id
      answer.ticks = leader.ticks
      return answer
    end if

    chosen = ctx.deviceBestId
    if not isValidAndNotEmpty(chosen)
      ids = []
      for each entry in tied
        ids.push(entry.id)
      end for
      answer.tiedIds = ids
      return answer
    end if

    for each entry in tied
      if versionResume.idsMatch(entry.id, chosen)
        answer.sourceId = entry.id
        answer.ticks = entry.ticks
        return answer
      end if
    end for

    ' A pick that names no tied version answers a question that was not asked — fall back to
    ' the most recent rather than honor it.
    answer.sourceId = leader.id
    answer.ticks = leader.ticks
    return answer
  end function

  ' mostRecentIdFrom: Which of an item's versions the server would resume, from a resume query
  ' (GET /UserItems/Resume scoped to the item's parent).
  '
  ' The query returns ONE entry per item — the version that owns the resume point — among every
  ' in-progress item under the parent, so the answer is whichever returned id names one of this
  ' item's sources.
  '
  ' @param {object} res - fetchAsync / apiPipeline result { ok, json }
  ' @param {dynamic} mediaSources - the item's MediaSources
  ' @return {string} that source's id, or "" when the reply does not say (failed, or no entry
  '                  for this item) — "" is still an answer: the caller must not ask again
  function mostRecentIdFrom(res as object, mediaSources as dynamic) as string
    if not isValid(res) or res.ok <> true or not isValid(res.json) then return ""
    items = res.json.Items
    if type(items) <> "roArray" or type(mediaSources) <> "roArray" then return ""
    for each item in items
      if not isValid(item) or not isValidAndNotEmpty(item.Id) then continue for
      index = versionResume.sourceIndexById(mediaSources, item.Id)
      if index >= 0 then return mediaSources[index].Id
    end for
    return ""
  end function

  ' wouldMarkPlayed: Would the server record this position as PLAYED instead of storing it
  ' as a resume point for this version?
  '
  ' Follows Jellyfin's UserDataManager.UpdatePlayState (read at v12.0), with one deliberate
  ' difference below. Every branch here is one the server uses to set `Played`, and `Played`
  ' is what makes this matter: SessionManager then calls Video.PropagatePlayedState(user,
  ' true), which marks EVERY alternate version played and clears EVERY version's position.
  ' So carrying a position onto a version the server would count as finished does not just
  ' fail to resume — it erases the position being carried from.
  '
  ' The difference is MinResumePct, which this never checks. The server checks it FIRST:
  ' below it a report is ignored (position zeroed, `Played` untouched) and the
  ' MinResumeDuration branch is never reached. So on a version shorter than
  ' MinResumeDurationSeconds this refuses even a carry the server would merely ignore. That
  ' is stricter, not wrong: playing such a version past MinResumePct marks it played either
  ' way, so allowing that carry would only have started playback a few seconds in.
  '
  ' @param {dynamic} positionTicks - the position that would be reported
  ' @param {dynamic} runtimeTicks - the runtime of the version it would be reported against
  ' @param {dynamic} policy - resumePolicyFrom(), or invalid when the thresholds are unknown
  ' @return {boolean} true when unknown, so an unreadable policy never authorizes a carry
  function wouldMarkPlayed(positionTicks as dynamic, runtimeTicks as dynamic, policy as dynamic) as boolean
    ' Fail CLOSED: without the thresholds there is no way to tell, and guessing wrong
    ' erases a real position.
    if not versionResume.isResumePolicy(policy) then return true
    if not isValid(runtimeTicks) or runtimeTicks <= 0 then return true ' server: no runtime => played
    if not isValid(positionTicks) or positionTicks <= 0 then return false ' nothing to report

    ' "mark as completed close to the end"
    if positionTicks >= runtimeTicks - 10000000& then return true
    percentIn = (positionTicks * 100#) / runtimeTicks
    if percentIn > policy.maxResumePct then return true

    ' "Enforce MinResumeDuration" — inside the resumable band, a version SHORTER than this
    ' is marked played rather than given a resume point, whatever the position.
    runtimeSeconds = runtimeTicks / 10000000#
    if runtimeSeconds < policy.minResumeDurationSeconds then return true

    return false
  end function

  ' isResumePolicy: Whether a value is a usable policy (both thresholds present).
  '
  ' @param {dynamic} policy
  ' @return {boolean}
  function isResumePolicy(policy as dynamic) as boolean
    if type(policy) <> "roAssociativeArray" then return false
    return isIntSafe(policy.maxResumePct) and isIntSafe(policy.minResumeDurationSeconds)
  end function

  ' resumeTicksFor: The position a version resumes from.
  '
  ' A version's own position always wins. Without one, the in-progress version's position is
  ' carried over only while the server would still store it as a resume point for THIS
  ' version — see wouldMarkPlayed().
  '
  ' @param {dynamic} ownTicks - this version's own position
  ' @param {dynamic} carriedTicks - the in-progress version's position (0 = none)
  ' @param {dynamic} runtimeTicks - this version's runtime
  ' @param {dynamic} policy - resumePolicyFrom(), or invalid when unknown
  ' @return {longinteger} ticks to resume from, 0 for no resume
  function resumeTicksFor(ownTicks as dynamic, carriedTicks as dynamic, runtimeTicks as dynamic, policy as dynamic) as longinteger
    if isValid(ownTicks) and ownTicks > 0 then return ownTicks
    if not isValid(carriedTicks) or carriedTicks <= 0 then return 0
    if versionResume.wouldMarkPlayed(carriedTicks, runtimeTicks, policy) then return 0
    return carriedTicks
  end function

  ' switchTicksFor: Where playback continues when the viewer switches version MID-PLAYBACK.
  '
  ' The exact time when the new version has one, otherwise the same percentage. Two releases
  ' of one cut are offset by a constant, not stretched: the local mixed-release pair runs
  ' 47 s apart yet matches at 1080p = 720p + 4 s at the start, middle and end (thumbnail
  ' cross-correlation), so the extra footage is at the edges. Mapping by time is therefore
  ' 4 s out everywhere, where mapping by percentage would be 19 s out at 15:00 and 35 s at
  ' 25:00. Percentage is only the better answer once the time does not exist in the new file
  ' at all, where it at least lands near the end instead of nowhere.
  '
  ' Deliberately NOT guarded by wouldMarkPlayed(): past the server's resume ceiling but
  ' still inside the new file, the viewer continues at the exact time and the item counts as
  ' watched, which is what finishing it would have done anyway. That is a decided rule, not
  ' an oversight — unlike a details-screen carry, where refusing costs nothing because the
  ' screen can simply offer Play instead of Resume.
  '
  ' @param {dynamic} positionTicks - where playback is in the version being left
  ' @param {dynamic} oldRuntimeTicks - runtime of the version being left
  ' @param {dynamic} newRuntimeTicks - runtime of the version being switched to
  ' @return {longinteger} ticks the new version starts from (0 = from the beginning)
  function switchTicksFor(positionTicks as dynamic, oldRuntimeTicks as dynamic, newRuntimeTicks as dynamic) as longinteger
    if not isValid(positionTicks) or positionTicks <= 0 then return 0&

    ' An unknown new runtime cannot rule the time out, and the exact time is the better
    ' answer whenever it holds — keep it rather than refuse the switch's position.
    if not isValid(newRuntimeTicks) or newRuntimeTicks <= 0 then return positionTicks
    if positionTicks < newRuntimeTicks then return positionTicks

    ' Past the new file's end. Without the old runtime there is no percentage to map, and a
    ' position known to be outside the new file must not be used as-is.
    if not isValid(oldRuntimeTicks) or oldRuntimeTicks <= 0 then return 0&

    ' Double, not integer: positionTicks * newRuntimeTicks overflows LongInteger (two ~1e10
    ' tick values multiply to ~1e20), while a double holds every value here exactly — the
    ' operands and the result all sit far inside its 53-bit integer range.
    fraction = (positionTicks * 1.0#) / oldRuntimeTicks
    if fraction >= 1.0# then return 0& ' at or past the end of the version being left
    return newRuntimeTicks * fraction
  end function

  ' resumeStateFor: Where Resume starts for the SELECTED version of a loaded item, and what
  ' the caller still has to fetch before that answer is final.
  '
  ' The whole per-version decision, as a pure function, so it can be tested without a seam
  ' for the two requests it may ask for. The caller owns the fetching and the caching; this
  ' owns every choice.
  '
  ' @param {object} ctx - {
  '     itemId            string  the loaded item
  '     itemPositionTicks dynamic its own UserData position
  '     itemRuntimeTicks  dynamic its runtime; the progress bar's fallback when the selected
  '                               source declares none
  '     mediaSources      dynamic its MediaSources, in server order
  '     selectedId        dynamic the version chosen in the Video dropdown ("" = none yet)
  '     positions         object  sourceId -> ticks already known (POSITION_UNREADABLE = failed)
  '     inProgressSourceId string the version the server says is in progress ("" = none)
  '     policy            dynamic resumePolicyFrom(), or invalid when not read yet
  '     isPolicyUnreadable boolean the read was tried and failed (optional, default false)
  '   }
  ' @return {object} {
  '     ticks          longinteger  where Resume starts (0 = no Resume button)
  '     runtimeTicks   longinteger  the selected version's runtime, for the progress bar
  '     isLoading      boolean      the answer is not final yet
  '     needsSourceId  string       fetch this version's UserData ("" = nothing to fetch)
  '     needsPolicy    boolean      read GET /System/Configuration
  '   }
  function resumeStateFor(ctx as object) as object
    state = { ticks: 0&, runtimeTicks: 0&, isLoading: false, needsSourceId: "", needsPolicy: false }
    if not isValid(ctx) then return state

    if isValid(ctx.itemRuntimeTicks) then state.runtimeTicks = ctx.itemRuntimeTicks

    ' The selected version, falling back to the item's own when the selection names no
    ' source the item still has — a refresh can return versions that were merged or split
    ' on the server while this screen was open, and a stale id would otherwise be fetched
    ' as if it were a version of this item.
    '
    ' Two runtimes: the progress bar falls back to the item's when a source declares none,
    ' but the carry guard takes the one the server applies to the reported version — the
    ' version's own RunTimeTicks, which the server reads as 0 ("no runtime", so played)
    ' when it is absent.
    selectedId = ctx.itemId
    guardRuntimeTicks = ctx.itemRuntimeTicks
    index = versionResume.sourceIndexById(ctx.mediaSources, ctx.selectedId)
    if index >= 0
      selectedId = ctx.mediaSources[index].Id
      sourceRuntime = ctx.mediaSources[index].RunTimeTicks
      if isValid(sourceRuntime) and sourceRuntime > 0 then state.runtimeTicks = sourceRuntime
      if not versionResume.idsMatch(selectedId, ctx.itemId) then guardRuntimeTicks = sourceRuntime
    end if

    ownTicks = versionResume.knownPosition(ctx, selectedId)
    if not isValid(ownTicks)
      state.isLoading = true
      state.needsSourceId = selectedId
      return state
    end if
    ' Unreadable: no Resume, rather than a carried position over a version that may have
    ' one of its own that we simply could not read.
    if ownTicks = versionResume.POSITION_UNREADABLE then return state
    if ownTicks > 0
      state.ticks = ownTicks
      return state
    end if

    inProgressId = ctx.inProgressSourceId
    if not isValidAndNotEmpty(inProgressId) or versionResume.idsMatch(inProgressId, selectedId) then return state

    carriedTicks = versionResume.knownPosition(ctx, inProgressId)
    if not isValid(carriedTicks)
      state.isLoading = true
      state.needsSourceId = inProgressId
      return state
    end if
    if carriedTicks <= 0 then return state

    if not versionResume.isResumePolicy(ctx.policy)
      ' A read that failed will not be answered: carry nothing (wouldMarkPlayed fails
      ' closed), rather than wait on the loading button forever.
      if isValid(ctx.isPolicyUnreadable) and ctx.isPolicyUnreadable then return state
      state.isLoading = true
      state.needsPolicy = true
      return state
    end if

    state.ticks = versionResume.resumeTicksFor(ownTicks, carriedTicks, guardRuntimeTicks, ctx.policy)
    return state
  end function

  ' knownPosition: A version's already-known position, or invalid when it must be fetched.
  '
  ' @param {object} ctx - resumeStateFor() context
  ' @param {string} sourceId
  ' @return {dynamic} ticks, or invalid when unknown
  function knownPosition(ctx as object, sourceId as string) as dynamic
    positions = ctx.positions
    if type(positions) <> "roAssociativeArray" or not isValidAndNotEmpty(sourceId) then return invalid
    ' Case-insensitive for the same reason sourceIndexById is — the ids come from two server
    ' fields (Item.Id and MediaSource.Id) — which an associative-array lookup already is.
    return positions[sourceId]
  end function

  ' resumePolicyFrom: The resume thresholds from a GET /System/Configuration reply.
  '
  ' Both thresholds or neither: a half-read policy would leave wouldMarkPlayed() unable to
  ' apply one of the server's branches while believing it knew the rule.
  '
  ' @param {object} res - fetchAsync result { ok, json }
  ' @return {dynamic} { maxResumePct, minResumeDurationSeconds }, or invalid when the reply
  '                   does not answer it
  function resumePolicyFrom(res as object) as dynamic
    if not isValid(res) or res.ok <> true or not isValid(res.json) then return invalid

    maxResumePct = res.json.MaxResumePct
    if not isIntSafe(maxResumePct) then return invalid
    if maxResumePct < 0 or maxResumePct > 100 then return invalid

    minResumeDurationSeconds = res.json.MinResumeDurationSeconds
    if not isIntSafe(minResumeDurationSeconds) then return invalid
    if minResumeDurationSeconds < 0 then return invalid

    return { maxResumePct: int(maxResumePct), minResumeDurationSeconds: int(minResumeDurationSeconds) }
  end function

  ' playbackPositionFrom: PlaybackPositionTicks from a GET /UserItems/{id}/UserData reply.
  '
  ' @param {object} res - fetchAsync result { ok, json }
  ' @return {longinteger} the position (0 = none), or POSITION_UNREADABLE
  function playbackPositionFrom(res as object) as longinteger
    if not isValid(res) or res.ok <> true or not isValid(res.json) then return versionResume.POSITION_UNREADABLE
    ticks = res.json.PlaybackPositionTicks
    if not isIntSafe(ticks) or ticks < 0 then return versionResume.POSITION_UNREADABLE
    return ticks
  end function

end namespace
