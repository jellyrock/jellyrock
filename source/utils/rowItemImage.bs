import "pkg:/source/api/image.bs"
import "pkg:/source/utils/itemImageUrl.bs"
import "pkg:/source/utils/misc.bs"

' Returns the image URL for a row item based on its type, slot dimensions, and user settings.
'
' Does not handle blur: the caller (JRRowItem) appends blur after the URL is resolved.
'
' @param item - JellyfinBaseItem content node
' @param slotWidth - width of the image area in pixels (from rowSlotSize constant)
' @param posterHeight - height of the image area in pixels; pass rowSlotSize[1] directly.
'                       Text is laid out below the slot by the caller, so do not subtract
'                       the text area before passing this value (that would double-subtract it)
' @param userSettings - m.global.user.settings node (may be invalid)
' @param useEpisodeImages - pre-computed from m.global.user.config.useEpisodeImagesInNextUpAndResume;
'                           only relevant when uiGeneralEpisodeImages = "webclient"
' @param shouldApplyEpisodeImageSetting - when false, skip the uiGeneralEpisodeImages user setting and the
'                                   portrait poster rule, and use the default episode image order (own
'                                   Primary, then wide art, then the portrait poster). Use false for
'                                   extras rows (season episode lists, person TV shows) where the
'                                   setting is only meaningful for home rows (Continue Watching, Next Up).
' @returns Image URL string, or "" if no image is available
function getRowItemImageUrl(item as object, slotWidth as integer, posterHeight as integer, userSettings as object, useEpisodeImages = false as boolean, shouldApplyEpisodeImageSetting = true as boolean) as string
  if not isValid(item) then return ""
  if not isValidAndNotEmpty(item.id) then return ""

  size = { width: slotWidth, height: posterHeight }

  ' Chapters: chapter-specific thumbnail when available, otherwise empty (triggers placeholder)
  if item.type = "Chapter"
    if isValidAndNotEmpty(item.primaryImageTag)
      imgParams = { maxWidth: slotWidth, maxHeight: posterHeight, tag: item.primaryImageTag }
      return ImageURL(item.id, "Chapter/" + stri(item.indexNumber).trim(), imgParams)
    end if
    return ""
  end if

  ' Library tiles: Primary image only (Thumb/Backdrop not available for these types)
  if item.type = "CollectionFolder" or item.type = "UserView" or item.type = "Channel"
    return getItemImageUrl(item, "Primary", size)
  end if

  ' Recordings: standalone items, not episodes of a series, so the episode image setting
  ' (show art vs episode art) does not apply. Use only the item's own images (no parent/series
  ' inheritance), falling back from Primary to Thumb, then Backdrop.
  if item.type = "Recording"
    url = getItemImageUrl(item, "Primary", size)
    if url <> "" then return url
    url = getItemImageUrl(item, "Thumb", size)
    if url <> "" then return url
    return getItemImageUrl(item, "Backdrop", size)
  end if

  ' Episodes: a portrait slot shows a parent poster, because a wide image would be cropped.
  ' In any other slot, only "show" (and "webclient" with episode images off) use series art.
  ' Everything else, including the bypass (shouldApplyEpisodeImageSetting = false, used by
  ' extras rows) and an empty or unknown setting, shares one image order below.
  if item.type = "Episode"
    isPosterSlot = shouldApplyEpisodeImageSetting and posterHeight > slotWidth
    if isPosterSlot
      parentPosterUrl = getItemParentPosterUrl(item, size)
      if parentPosterUrl <> "" then return parentPosterUrl
    else if shouldApplyEpisodeImageSetting and isValid(userSettings)
      episodeImageSetting = userSettings.uiGeneralEpisodeImages
      if episodeImageSetting = "show"
        return getItemParentWidePosterUrl(item, size)
      else if episodeImageSetting = "webclient" and not useEpisodeImages
        ' Respect the Jellyfin web client's "use episode images" config flag.
        return getItemParentWidePosterUrl(item, size)
      end if
    end if
    ' One order: the episode's own Primary (screenshot), then wide art (own Thumb/Backdrop,
    ' then the series'), and the portrait poster only as the last resort.
    url = getItemImageUrl(item, "Primary", size)
    if url <> "" then return url
    url = getItemWidePosterUrl(item, size)
    if url <> "" then return url
    return getItemPosterUrl(item, size)
  end if

  ' Program: portrait poster with inline channel art fallback
  ' (channelId and channelPrimaryImageTag are fields on the Program item itself)
  if item.type = "Program"
    url = getItemPosterUrl(item, size)
    if url = "" and isValidAndNotEmpty(item.channelId) and isValidAndNotEmpty(item.channelPrimaryImageTag)
      url = ImageURL(item.channelId, "Primary", { tag: item.channelPrimaryImageTag, maxWidth: slotWidth, maxHeight: posterHeight })
    end if
    return url
  end if

  ' TvChannel: Primary image (channel logo stored as Primary, not Thumb/Backdrop)
  ' PhotoAlbum: wide thumb
  if item.type = "TvChannel"
    return getItemPosterUrl(item, size)
  end if
  if item.type = "PhotoAlbum"
    return getItemWidePosterUrl(item, size)
  end if

  ' Photos are stored as Primary images in Jellyfin (no Thumb/Backdrop).
  ' Use Primary image; slot shape already set to WIDE by createLatestInRows for photo libraries.
  if item.type = "Photo"
    return getItemPosterUrl(item, size)
  end if

  ' Square-native types: Primary image (square crop via scaleToZoom on the poster)
  if item.type = "MusicAlbum" or item.type = "MusicArtist" or item.type = "Audio"
    return getItemPosterUrl(item, size)
  end if

  ' All remaining types (Movie, Series, Season, BoxSet, Person, Video, MusicVideo, etc.):
  ' Use slot shape to determine image strategy.
  ' Wide slot (slotWidth > posterHeight): try wide image first, fall back to portrait.
  ' Portrait/square slot: use portrait poster.
  if slotWidth > posterHeight
    url = getItemWidePosterUrl(item, size)
    if url = "" then url = getItemPosterUrl(item, size)
    return url
  end if

  return getItemPosterUrl(item, size)
end function

' Whether getRowItemImageUrl gives this item a season or series poster instead of its own image.
' The blur for unwatched episodes hides spoilers, and a poster shows none.
function episodeShowsPosterInSlot(item as object, slotWidth as integer, posterHeight as integer, shouldApplyEpisodeImageSetting = true as boolean) as boolean
  if item.type <> "Episode" or not shouldApplyEpisodeImageSetting or posterHeight <= slotWidth then return false
  return getItemParentPosterUrl(item, { width: slotWidth, height: posterHeight }) <> ""
end function

' Whether getRowItemImageUrl falls back to a 16:9 episode image in a portrait slot, which the
' caller fits rather than crops.
function episodeShowsOwnImageInPortraitSlot(item as object, slotWidth as integer, posterHeight as integer, shouldApplyEpisodeImageSetting = true as boolean) as boolean
  if item.type <> "Episode" or not shouldApplyEpisodeImageSetting or posterHeight <= slotWidth then return false
  return getItemParentPosterUrl(item, { width: slotWidth, height: posterHeight }) = ""
end function
