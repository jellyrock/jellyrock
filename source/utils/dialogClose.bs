import "pkg:/source/utils/overlayDialog.bs"

' The ONE definition of how an overlay dialog closes: JRDialog, JRListDialog,
' OverviewDialog and QuickConnectDialog all close through it.
'
' THE ORDER IS WHAT BITES. A dialog delivers `result` BEFORE it closes, and the
' owner's result handler runs inside that write. A handler may present another
' overlay dialog, which takes focus. Control then returns to the first dialog's
' close, and an unconditional `returnFocusTo.setFocus(true)` steals focus from
' the new dialog: it stays on screen and ignores every key.
'
' THE RULE. Restore focus to returnFocusTo only when this dialog still held it
' when the close began. If it did not, something else took focus on purpose, and
' a closing dialog leaves that alone.
'
' wasFocused is read BEFORE the detach, because removing a focused node is what
' destroys the answer (the same trap applyButtonOverflow documents in
' buttonOverflow.bs).
'
' THE REDIRECT. returnFocusTo can sit in a screen the viewer has left: the dialog opened over
' screen A, a navigation then made screen B the active routed view. Focus then goes to the active
' view's own handleFocus, so B restores its focus instead of A's hidden node. A returnFocusTo
' outside every screen (the overhang, AppWaitHost) keeps the plain setFocus, and so does an
' invalid active view.
'
' Callers keep their own bookkeeping (the once-only flag, the `closed` signal);
' this holds only the focus decision. The detach itself is detachOverlayDialog in
' overlayDialog.bs, which abandonDialog shares.

' Take the dialog off its parent and hand focus back to returnFocusTo, but only
' if the dialog still held focus.
sub closeOverlayDialog(dialog as object)
  if not isValid(dialog) then return

  returnFocusTo = dialog.returnFocusTo
  wasFocused = dialog.isInFocusChain()

  detachOverlayDialog(dialog)

  if not wasFocused or not isValid(returnFocusTo) then return

  activeView = m.global.activeRoutedView
  if closeRedirectsToActiveView(returnFocusTo, activeView)
    activeView.callFunc("handleFocus", {})
  else
    returnFocusTo.setFocus(true)
  end if
end sub

' Whether closing a dialog that would give the focus back to returnFocusTo gives it to
' activeView instead (THE REDIRECT). AppWaitHost asks it too: a start that hides activeView takes
' that focus itself.
function closeRedirectsToActiveView(returnFocusTo as dynamic, activeView as dynamic) as boolean
  return isValid(returnFocusTo) and isValid(activeView) and isInOtherScreen(returnFocusTo, activeView)
end function

' True when node sits inside a screen that is not activeView and never passes through activeView.
' A screen nested in the active view (the OSD in the player) is part of it, so it returns false.
function isInOtherScreen(node as object, activeView as object) as boolean
  inScreen = false
  walker = node
  while isValid(walker)
    if walker.isSameNode(activeView) then return false
    if walker.isSubtype("JRScreen") then inScreen = true
    walker = walker.getParent()
  end while
  return inScreen
end function
