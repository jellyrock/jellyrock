' Repeat for the queue being played: where next and previous go under each mode, for an item
' that finishes and for a press of the player's buttons alike.
'
' The modes are the server's own RepeatMode values, so a SyncPlay group's queue update and the
' viewer's pick in the OSD gear read the same words. The mode belongs to the queue
' (QueueManager.setRepeatMode), is never saved, and a new queue starts without one. The audio
' player keeps its own loop (AudioPlayer.loopMode): music does not play through this. What the
' gear shows for a mode is playbackSettingsMenu.bs's.
import "pkg:/source/utils/misc.bs"

namespace queueRepeat

  const OFF = "RepeatNone"
  const ALL = "RepeatAll"
  const ONE = "RepeatOne"

  ' The mode as one of the three values: anything else (invalid, an empty field, a word the
  ' server adds later) is off.
  function normalize(mode as dynamic) as string
    text = textOrEmpty(mode)
    if text = ALL or text = ONE then return text
    return OFF
  end function

  ' The index to play after the item at `index`, or -1 when there is none: the same item under
  ' RepeatOne, the next one, the first again under RepeatAll. One rule for a finish and a press
  ' of next, as jellyfin-web's next and the SyncPlay server's Next() have, so the player reads
  ' the same in and out of a group.
  function nextIndex(mode as dynamic, index as integer, count as integer) as integer
    if count <= 0 or index < 0 or index >= count then return -1
    repeat = normalize(mode)
    if repeat = ONE then return index
    if index + 1 < count then return index + 1
    if repeat = ALL then return 0
    return -1
  end function

  ' The index a press of previous goes to, or -1: this item again under RepeatOne, else the one
  ' before, or the last under RepeatAll.
  function previousIndex(mode as dynamic, index as integer, count as integer) as integer
    if count <= 0 or index < 0 or index >= count then return -1
    repeat = normalize(mode)
    if repeat = ONE then return index
    if index > 0 then return index - 1
    if repeat = ALL then return count - 1
    return -1
  end function

end namespace
