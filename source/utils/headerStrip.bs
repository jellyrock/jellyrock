import "pkg:/source/utils/pixelGrid.bs"

' The header strip under the overhang on a library screen (LibraryHeaderStrip): where it
' sits, and how its parts share the row. Pure. docs/architecture/design-system.md has the
' rule in words.
namespace headerStrip
  ' The row. BaseGridView.xml places it at y 111, midway between the selected tab's
  ' underline and the focus ring of the first row, and it spans the 5% zone's width.
  const HEIGHT = 54
  ' Where a library's grid starts. A cell draws its poster 22 pixels lower.
  const CONTENT_TOP = 168
  const LEFT = 96
  const WIDTH = 1728

  const CHIP_PADDING = 15 ' A chip's text padding: with the Medium font the box is the row's height
  const CHIP_GAP = 6 ' Between two chips, as between the overhang's right-hand elements
  const PART_GAP = 24 ' Between the chips, the count and the narrowed-by text, and before the left block
  const TITLE_GAP = 18 ' Between the focused item's title and its metadata line
  ' The metadata line is built as the details screen builds its info rows: its items 9
  ' pixels from a bullet on each side, and an item cut no narrower than this.
  const METADATA_SPACING = 9
  const METADATA_MIN_CUT = 90
  ' A label centers its line box and caps sit above that box's middle (textMetrics.bs), so
  ' the row's text is drawn this much lower to center its caps in the row.
  const TEXT_DROP = 3
  ' The least the left block keeps. Under it the count gives up its room first.
  const MIN_LEFT_WIDTH = 480

  ' Where each part of the row goes, for the widths its text measures.
  '
  ' The chips sit at the right edge, the count before them, the narrowed-by text before
  ' that, and the left block (the focused item's title, then its metadata) takes the rest.
  ' When room runs out the left block shortens first: the metadata keeps its width up to
  ' half the block and the title is cut. Under MIN_LEFT_WIDTH the count hides, then the
  ' narrowed-by text is cut to what is left.
  '
  ' @param widths - { title, metadata, narrowedBy, count, chips: [width, …] }, each the
  '   text's own width, 0 for a part with nothing to show; `chips` holds the shown chips
  '   from left to right
  ' @param slotWidth - the row's width
  ' @return {object} { titleWidth, metadataX, metadataWidth, narrowedByX, narrowedByWidth,
  '   isCountShown, countX, chipXs: [x, …] }, x from the row's left edge, on the 3 px grid
  function fit(widths as object, slotWidth as integer) as object
    chipXs = []
    x = slotWidth
    for i = widths.chips.count() - 1 to 0 step -1
      x -= snapToGrid(widths.chips[i])
      chipXs.unshift(x)
      x -= headerStrip.CHIP_GAP
    end for
    ' x is now the chips' left edge, less one gap
    rightEdge = slotWidth
    if chipXs.count() > 0 then rightEdge = chipXs[0] - headerStrip.PART_GAP

    hasLeft = widths.title > 0 or widths.metadata > 0
    leftNeeded = 0
    if hasLeft then leftNeeded = headerStrip.MIN_LEFT_WIDTH + headerStrip.PART_GAP

    countWidth = snapToGrid(widths.count)
    narrowedWidth = snapToGrid(widths.narrowedBy)

    isCountShown = countWidth > 0
    if isCountShown and rightEdge - countWidth - headerStrip.narrowedRoom(narrowedWidth) < leftNeeded
      isCountShown = false
    end if

    countX = rightEdge
    if isCountShown
      countX = rightEdge - countWidth
      rightEdge = countX - headerStrip.PART_GAP
    end if

    narrowedByX = rightEdge
    if narrowedWidth > 0
      room = floorToGrid(rightEdge - leftNeeded)
      if narrowedWidth > room then narrowedWidth = room
      narrowedByX = rightEdge - narrowedWidth
      rightEdge = narrowedByX - headerStrip.PART_GAP
    end if

    leftWidth = floorToGrid(rightEdge)
    metadataWidth = snapToGrid(widths.metadata)
    titleWidth = snapToGrid(widths.title)
    gap = 0
    if titleWidth > 0 and metadataWidth > 0 then gap = headerStrip.TITLE_GAP
    if titleWidth + gap + metadataWidth > leftWidth
      half = floorToGrid(leftWidth \ 2)
      if metadataWidth > half then metadataWidth = half
      titleWidth = floorToGrid(leftWidth - gap - metadataWidth)
      ' A short title leaves its unused room to the metadata
      if snapToGrid(widths.title) < titleWidth
        titleWidth = snapToGrid(widths.title)
        metadataWidth = floorToGrid(leftWidth - gap - titleWidth)
        if metadataWidth > snapToGrid(widths.metadata) then metadataWidth = snapToGrid(widths.metadata)
      end if
    end if

    return {
      titleWidth: titleWidth,
      metadataX: titleWidth + gap,
      metadataWidth: metadataWidth,
      narrowedByX: narrowedByX,
      narrowedByWidth: narrowedWidth,
      isCountShown: isCountShown,
      countX: countX,
      chipXs: chipXs
    }
  end function

  ' The room the narrowed-by text takes with its gap, 0 when there is none.
  function narrowedRoom(narrowedWidth as integer) as integer
    if narrowedWidth <= 0 then return 0
    return narrowedWidth + headerStrip.PART_GAP
  end function

  ' The chip Left or Right moves to, or "" at the row's end, where focus stays.
  '
  ' @param shown - the ids of the chips on show, from left to right
  ' @param from - the focused chip's id
  ' @param direction - "left" or "right"
  function nextFocus(shown as object, from as string, direction as string) as string
    for i = 0 to shown.count() - 1
      if shown[i] = from
        if direction = "left" and i > 0 then return shown[i - 1]
        if direction = "right" and i < shown.count() - 1 then return shown[i + 1]
        return ""
      end if
    end for
    return ""
  end function

  ' The chip that takes focus when focus enters the row: the one used last while it is
  ' still shown, else the first.
  function entryChip(shown as object, last as string) as string
    for each id in shown
      if id = last then return id
    end for
    if shown.count() > 0 then return shown[0]
    return ""
  end function

end namespace
