import "pkg:/source/utils/misc.bs"

' What the first variant of an HLS master playlist declares, or invalid when the text has no
' variant with both CODECS and RESOLUTION.
'
' The server's re-encode (a retry that asks it not to copy the video) can pick H.264 at the
' source's own size, and a Roku plays AVC only up to level 4.2, so the player needs to know before
' it plays: the master playlist says it without waiting for a segment.
'
' @param {string} text - the playlist body
' @return {dynamic} { codecs: string, width: integer, height: integer }, or invalid
function hlsMasterVariant(text as string) as dynamic
  marker = "#EXT-X-STREAM-INF:"
  start = inStr(1, text, marker)
  if start = 0 then return invalid

  lineStart = start + len(marker)
  lineEnd = inStr(lineStart, text, chr(10))
  if lineEnd = 0 then lineEnd = len(text) + 1
  attributes = mid(text, lineStart, lineEnd - lineStart)

  codecs = hlsAttributeValue(attributes, "CODECS=" + chr(34), chr(34))
  size = hlsAttributeValue(attributes, "RESOLUTION=", ",").trim().split("x")
  if codecs = "" or size.count() <> 2 then return invalid

  width = size[0].toInt()
  height = size[1].toInt()
  if width <= 0 or height <= 0 then return invalid
  return { codecs: codecs, width: width, height: height }
end function

' The text after `prefix` up to the next `terminator` (or the end), or "" when `prefix` is absent.
function hlsAttributeValue(attributes as string, prefix as string, terminator as string) as string
  start = inStr(1, attributes, prefix)
  if start = 0 then return ""
  valueStart = start + len(prefix)
  valueEnd = inStr(valueStart, attributes, terminator)
  if valueEnd = 0 then valueEnd = len(attributes) + 1
  return mid(attributes, valueStart, valueEnd - valueStart)
end function

' Whether a picture is larger than a Roku decodes as H.264 (AVC level 4.2, about 1080p).
'
' @return {boolean} true when wider than 1920 or taller than 1080
function isAboveH264Ceiling(width as integer, height as integer) as boolean
  return width > 1920 or height > 1080
end function

' Whether a variant is H.264 larger than a Roku decodes (AVC level 4.2, about 1080p).
'
' @param {dynamic} variant - hlsMasterVariant()'s answer
' @return {boolean} true for an H.264 stream wider than 1920 or taller than 1080
function needsH264ResolutionCap(variant as dynamic) as boolean
  if not isValid(variant) then return false
  codecs = LCase(variant.codecs)
  isH264 = inStr(1, codecs, "avc1.") > 0 or inStr(1, codecs, "avc3.") > 0
  return isH264 and isAboveH264Ceiling(variant.width, variant.height)
end function

' Whether a source's video stream is above 1080p, whatever its codec. False when the stream or
' its size is unknown.
'
' @param {dynamic} videoStream - a MediaStream (Width, Height), or invalid
' @return {boolean}
function videoStreamAboveH264Ceiling(videoStream as dynamic) as boolean
  if type(videoStream) <> "roAssociativeArray" then return false
  return isAboveH264Ceiling(mediaNumber(videoStream.Width), mediaNumber(videoStream.Height))
end function

' reencodeCapDecision: Whether the re-encode retry's answer must be asked for again at 1080p,
' and why.
'
' The server's master playlist declares the codec and size the re-encode will have, and H.264
' above 1080p needs the cap. A playlist that did not arrive or cannot be read says nothing, so
' the source decides: one above 1080p is capped. A 4K H.264 re-encode buffers forever with no
' error, while a 1080p one plays; the cap costs 4K only on a server that encodes HEVC, and only
' when its playlist could not be read.
'
' @param {dynamic} fetched - fetchManifestText()'s answer ({ code, body }), or invalid
' @param {boolean} sourceAboveCeiling - the source's video is above 1080p (videoStreamAboveH264Ceiling)
' @return {object} { cap: boolean, reason: string, variant: dynamic }. reason is
'   "h264AboveCeiling" or "playable" when the playlist was read (variant is hlsMasterVariant()'s
'   answer), "playlistUnread" (no answer, or not HTTP 200) or "playlistUnparsed" otherwise.
function reencodeCapDecision(fetched as dynamic, sourceAboveCeiling as boolean) as object
  if type(fetched) <> "roAssociativeArray" or mediaNumber(fetched.code) <> 200
    return { cap: sourceAboveCeiling, reason: "playlistUnread", variant: invalid }
  end if
  variant = hlsMasterVariant(textOrEmpty(fetched.body))
  if not isValid(variant) then return { cap: sourceAboveCeiling, reason: "playlistUnparsed", variant: invalid }
  if needsH264ResolutionCap(variant) then return { cap: true, reason: "h264AboveCeiling", variant: variant }
  return { cap: false, reason: "playable", variant: variant }
end function
