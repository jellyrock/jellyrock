import "pkg:/source/enums/UpstreamHlsBlocker.bs"
import "pkg:/source/translationKeys.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/translate.bs"
import "pkg:/source/utils/url.bs"

' Sentinel seek position used to jump to the live edge of an HLS stream.
' Roku clips this to the manifest's available range, landing at the live edge.
const LIVE_EDGE_SEEK = 999999

' Maximum behind-live offset (seconds) at which we still consider the user to be at
' the live edge. Absorbs 1-tick rounding flicker between the integer wall-clock
' (roDateTime.AsSeconds) and int(m.top.position) — both tick discretely but can be
' out of phase by up to 1 second depending on calibration alignment, which would
' otherwise flicker the UI between LIVE and -0:01 every second during normal play.
const LIVE_EDGE_THRESHOLD_SECONDS = 2

function parseProgramEndTimeEpoch(meta as object) as integer
  if not isValid(meta) or not isValid(meta.currentProgram) then return 0

  endDateStr = meta.currentProgram.endDate
  if not isValidAndNotEmpty(endDateStr) then return 0

  dt = CreateObject("roDateTime")
  dt.FromISO8601String(endDateStr)
  return dt.AsSeconds()
end function

function parseProgramStartTimeEpoch(meta as object) as integer
  if not isValid(meta) or not isValid(meta.currentProgram) then return 0

  startDateStr = meta.currentProgram.startDate
  if not isValidAndNotEmpty(startDateStr) then return 0

  dt = CreateObject("roDateTime")
  dt.FromISO8601String(startDateStr)
  return dt.AsSeconds()
end function

' Compute seconds the user is behind the live edge using a hybrid play/pause model.
'
' Roku's m.top.position for live HLS DVR streams keeps advancing during pause —
' it tracks the live edge, not the user's playhead. So position-vs-wallclock math
' cancels out to zero during pause and we have to switch strategies based on state:
'
'   During pause: behindLive = accumulated + (now - pausedAtEpoch)
'                  Wall-clock-only — independent of position so Roku's auto-advance
'                  during pause is invisible to us.
'
'   During play:  behindLive = (now - epochAtPosition0) - position
'                  Position-math — self-correcting on scrubs while playing, where
'                  position genuinely tracks the user's playhead.
'
' On the pause→play transition the caller re-anchors epochAtPosition0 so play-math
' continues from the same offset where wall-clock math left off.
'
' @param epochAtPosition0 epoch corresponding to video position=0 in the current stream
' @param calibrated       false until first play tick anchors the reference
' @param position         current video position (seconds), used only during play
' @param now              current wall-clock epoch
' @param pausedAtEpoch    epoch when the current pause started, or 0 if not paused
' @param accumulated      seconds-behind-live snapshotted at pause start (plus any
'                          scrub adjustments made during the current pause)
function computeLiveTvBehindLive(epochAtPosition0 as integer, calibrated as boolean, position as integer, now as integer, pausedAtEpoch as integer, accumulated as integer) as integer
  if pausedAtEpoch > 0 then return accumulated + (now - pausedAtEpoch)
  if not calibrated then return 0
  behind = (now - epochAtPosition0) - position
  if behind < 0 then return 0
  return behind
end function

' Apply a scrub-during-pause delta to the accumulated behind-live counter.
' Forward scrub (positive delta) reduces behind; backward scrub (negative) grows it.
' Clamped to >= 0 so a forward scrub past the live edge resolves to 0 (live edge).
function applyScrubToAccumulatedBehind(accumulated as integer, delta as integer) as integer
  result = accumulated - delta
  if result < 0 then return 0
  return result
end function

' Compute the new accumulated baseline after a scrub during pause. Folds the elapsed
' pause duration into accumulated first so the wall-clock pause counter can be reset
' from the scrub moment — otherwise a forward scrub to live edge would still leave
' the wall-clock counter adding to total behindLive.
'
' Caller is expected to also reset pausedAtEpoch = now after this returns.
function repartitionPauseStateOnScrub(accumulated as integer, pauseDurationSoFar as integer, scrubDelta as integer) as integer
  return applyScrubToAccumulatedBehind(accumulated + pauseDurationSoFar, scrubDelta)
end function

' Build a queue array from a Jellyfin /livetv/channels response and locate the
' currently-playing channel within it.
'
' @param channels         array of channel AAs as returned by /livetv/channels
' @param currentChannelId id of the currently-playing channel
' @return AA with shape: items=[queueItem...], currentIndex=integer (-1 if currentChannelId not found)
function buildChannelQueueList(channels as object, currentChannelId as string) as object
  result = { items: [], currentIndex: -1 }
  if not isValid(channels) then return result

  for i = 0 to channels.count() - 1
    channel = channels[i]
    if not isValid(channel) or not isValidAndNotEmpty(channel.Id) then continue for

    queueItem = {
      id: channel.Id,
      type: "TvChannel"
    }
    if isValidAndNotEmpty(channel.Name)
      queueItem.title = channel.Name
    end if
    if isValidAndNotEmpty(channel.Number)
      queueItem.channelNumber = channel.Number
    end if
    if isValidAndNotEmpty(channel.PrimaryImageTag)
      queueItem.primaryImageTag = channel.PrimaryImageTag
    end if

    result.items.push(queueItem)

    if channel.Id = currentChannelId
      result.currentIndex = result.items.count() - 1
    end if
  end for

  return result
end function

' Decide whether a video should be tagged as ContentNode contenttype="episode".
' Tagging "episode" enables the Next-Episode flow in VideoPlayerView.
'
' Episodes and series items are always episodes. Recordings are episodes only
' when their metadata identifies them as part of a series (seriesId set) — a
' standalone recording of a movie or sports event should NOT trigger the
' Next-Episode prompt.
'
' Recordings without a season/episode number but WITH a seriesId still count
' as series content (e.g. news bulletins or shows whose EPG omits S/E numbering).
'
' @param videotype lowercased meta.type
' @param meta      JellyfinBaseItem or AA with seriesId field
function shouldTreatAsEpisode(videotype as string, meta as object) as boolean
  if videotype = "episode" or videotype = "series" then return true
  if videotype = "recording" and isValid(meta) and isValidAndNotEmpty(meta.seriesId) then return true
  return false
end function

' What the playback request knows that the server's PlaybackInfo answer does not carry, for
' getUpstreamHlsBlocker.
interface UpstreamHlsRequest
  ' This load is a live channel (TvChannel or Program).
  isLive as boolean
  ' This load is the retry that asked the server for a transcode (EnableDirectPlay=false).
  forceTranscoding as boolean
  ' The configured Jellyfin server URL.
  serverUrl as string
  ' The user's policy "Force transcoding of remote media sources such as Live TV".
  forceRemoteSourceTranscoding as boolean
  ' The source's TranscodeReasons, from its TranscodingUrl (getTranscodeReasons), as the server sent
  ' them; getUpstreamHlsBlocker decides which of them count.
  transcodeReasons as object
end interface

' What keeps a Live TV channel off its own HLS URL when the server has declined to direct play it,
' or UpstreamHlsBlocker.NONE when nothing does and the channel should play from that URL.
'
' Jellyfin 12.0 (jellyfin/jellyfin#17768) stopped offering direct play for M3U channels whose URL
' is an HLS manifest: it had been relaying the upstream master playlist through its own
' /Videos/{id}/ URL, where the playlist's relative variant URIs 404. JellyRock never used that
' relay. It plays the absolute upstream Path (setupVideoContentWithAuth), where relative URIs
' resolve against the origin, which is how these channels played before 12.0. The server's remux
' instead drops audio that arrives as a separate HLS rendition. If the device cannot play the
' upstream stream, the live direct-play fallback (applyLiveDirectPlayFallback) still retries
' through the server.
'
' The server's "no" does not say whether 12.0 is its only reason, so this rebuilds the answer the
' server would have given before 12.0 from what the client can see. It overrides only an explicit
' "no" (SupportsDirectPlay = false) on an HTTP HLS source whose Path is an absolute http(s) URL
' that does not go through Jellyfin: not a loopback host, not the server's own host and port, not
' the LiveStreamFiles relay. And only when none of the server's older reasons applies: the tuner's
' "Auto-loop live streams", the user's remote-source transcoding policy, or the server's internet
' streaming bitrate limit. The tuner's "Simultaneous stream limit" is the one reason the client
' cannot see; the server still enforces it when the live stream opens. DASH is excluded.
'
' @param {dynamic} mediaSource - the channel's PlaybackInfo MediaSource
' @param {UpstreamHlsRequest} request - what this load asked for, and of whom
' @returns {string} an UpstreamHlsBlocker value
function getUpstreamHlsBlocker(mediaSource as dynamic, request as UpstreamHlsRequest) as string
  if not request.isLive then return UpstreamHlsBlocker.NOT_LIVE
  ' The retry that forces a transcode must reach the server, or a stream this device cannot play
  ' would be retried from its upstream URL forever.
  if request.forceTranscoding then return UpstreamHlsBlocker.FORCED_TRANSCODE
  if not isValid(mediaSource) or LCase(type(mediaSource)) <> "roassociativearray" then return UpstreamHlsBlocker.NO_SOURCE

  ' Override only the server's explicit "no"; an absent field is no decision to second-guess.
  declined = mediaSource.SupportsDirectPlay
  declinedType = LCase(type(declined))
  if not (declinedType = "boolean" or declinedType = "roboolean") or declined then return UpstreamHlsBlocker.NOT_DECLINED

  if LCase(textOrEmpty(mediaSource.Protocol)) <> "http" then return UpstreamHlsBlocker.NOT_HTTP_PROTOCOL

  upstream = parseUrlComponents(textOrEmpty(mediaSource.Path))
  if not isValid(upstream) then return UpstreamHlsBlocker.NOT_HTTP_URL
  scheme = LCase(upstream.scheme)
  if (scheme <> "http" and scheme <> "https") or upstream.host = "" then return UpstreamHlsBlocker.NOT_HTTP_URL

  path = LCase(upstream.path)
  container = LCase(textOrEmpty(mediaSource.Container))
  isHls = container = "hls" or container = "applehttp" or Right(path, 5) = ".m3u8" or Right(path, 4) = ".m3u"
  if not isHls then return UpstreamHlsBlocker.NOT_HLS

  ' Through Jellyfin's own relay, relative URIs really do break: the case jellyfin/jellyfin#17768 fixed.
  if Instr(1, path, "/livetv/livestreamfiles/") > 0 then return UpstreamHlsBlocker.SERVER_RELAY
  bareHost = upstream.host
  if Left(bareHost, 1) = "[" then bareHost = Mid(bareHost, 2, Len(bareHost) - 2)
  if isLocalhost(bareHost) then return UpstreamHlsBlocker.LOOPBACK

  jellyfin = parseUrlComponents(request.serverUrl)
  if not isValid(jellyfin) or jellyfin.host = "" then return UpstreamHlsBlocker.NO_SERVER_URL
  if upstream.host = jellyfin.host and upstream.port = jellyfin.port then return UpstreamHlsBlocker.SERVER_HOST

  ' The server's reasons that predate 12.0, which it applied then too.
  if isBooleanTrue(mediaSource.RequiresLooping) then return UpstreamHlsBlocker.AUTO_LOOP
  if isBooleanTrue(mediaSource.IsRemote) and request.forceRemoteSourceTranscoding then return UpstreamHlsBlocker.REMOTE_SOURCE_POLICY
  ' Of the transcode reasons, only the bitrate one is a verdict on direct play. For a manifest,
  ' 12.x no longer judges direct play at all; the codec reasons it reports say whether its own
  ' transcode can copy the stream, not whether this device can play it.
  if isValid(request.transcodeReasons) and arrayHasValue(request.transcodeReasons, "ContainerBitrateExceedsLimit") then return UpstreamHlsBlocker.BITRATE_LIMIT

  return UpstreamHlsBlocker.NONE
end function

' Whether a response to the preflight GET of a live channel's upstream playlist shows the device
' can play it: HTTP 200 with an HLS playlist body. The body check turns away a captive portal or an
' HTML error page served with 200; RFC 8216 requires #EXTM3U as the first line, so only leading
' whitespace is tolerated before it.
'
' @param {integer} responseCode - roUrlEvent.GetResponseCode() (negative for a transport failure)
' @param {dynamic} body - roUrlEvent.GetString()
' @returns {boolean}
function isHlsPlaylistResponse(responseCode as integer, body as dynamic) as boolean
  if responseCode <> 200 then return false
  return Left(textOrEmpty(body).Trim(), 7) = "#EXTM3U"
end function

' The toast for a RecordProgramTask result: scheduled or cancelled, and whether it worked. A
' failed result that is not a record reads as a failed cancel, as the task reports it.
'
' @param result - RecordProgramTask.result ({ ok, action }), or invalid
' @return an AA with `text` and `type` for displayToast
function recordResultToast(result as dynamic) as object
  ok = isValid(result) and result.ok = true
  isRecord = isValid(result) and result.action = "record"
  if ok and isRecord then return { text: translate(translationKeys.LabelRecordingScheduled), type: "success" }
  if ok then return { text: translate(translationKeys.LabelRecordingCancelled), type: "success" }
  if isRecord then return { text: translate(translationKeys.ErrorFailedToScheduleRecording), type: "error" }
  return { text: translate(translationKeys.ErrorFailedToCancelRecording), type: "error" }
end function
