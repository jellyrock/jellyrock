' Reads the track numbers and types stored in an MKV file's header.
'
' Roku's Video node identifies an MKV audio track by the number stored in the file (Matroska
' TrackEntry > TrackNumber), and Jellyfin never exposes it. This reads it from the start of the file,
' with each track's TrackType (1 video, 2 audio, 17 subtitle) so a caller can pick out the audio tracks.
'
' @param {object} bytes - an roByteArray holding the start of an MKV file, through the end of its Tracks element
' @returns {dynamic} an array of { number, type } in header (TrackEntry) order, every track type included, where
' type is invalid for a TrackEntry that stores none. Invalid when the bytes are not EBML, hold no Tracks element,
' or end partway through it, or a TrackEntry has no TrackNumber. Pure: no node access and no I/O. It never reads
' past the buffer.
function mkvTrackEntries(bytes as object) as dynamic
  if bytes = invalid then return invalid
  total = bytes.count()
  idEbml = &h1A45DFA3
  idSegment = &h18538067
  idTracks = &h1654AE6B
  idCluster = &h1F43B675

  ' The file must open with the EBML header.
  header = mkvReadElement_(bytes, 0, total)
  if header = invalid or header.id <> idEbml or header.unknownSize then return invalid
  at = header.dataStart + header.size
  if at > total then return invalid

  segment = mkvReadElement_(bytes, at, total)
  if segment = invalid or segment.id <> idSegment then return invalid
  at = segment.dataStart

  while at < total
    element = mkvReadElement_(bytes, at, total)
    if element = invalid or element.id = idCluster or element.unknownSize then return invalid
    if element.id = idTracks
      return mkvReadTrackEntries_(bytes, element.dataStart, element.dataStart + element.size, total)
    end if
    at = element.dataStart + element.size
  end while
  return invalid
end function

' Reads one element header at the given offset. Returns { id, size, dataStart, unknownSize }, or invalid when the
' header does not fit in the buffer or is malformed. An id keeps its length-marker bits; a size drops them.
function mkvReadElement_(bytes as object, at as integer, total as integer) as dynamic
  if at >= total then return invalid
  first = bytes[at]
  idLen = mkvMarkerLength_(first)
  if idLen = 0 or idLen > 4 then return invalid
  if at + idLen >= total then return invalid
  id# = 0
  for i = 0 to idLen - 1
    id# = id# * 256 + bytes[at + i]
  end for

  sizePos = at + idLen
  sizeLen = mkvMarkerLength_(bytes[sizePos])
  if sizeLen = 0 then return invalid
  if sizePos + sizeLen > total then return invalid
  size# = bytes[sizePos] and (255 >> sizeLen)
  allOnes = size# = (255 >> sizeLen)
  for i = 1 to sizeLen - 1
    size# = size# * 256 + bytes[sizePos + i]
    if bytes[sizePos + i] <> 255 then allOnes = false
  end for
  return { id: id#, size: size#, dataStart: sizePos + sizeLen, unknownSize: allOnes }
end function

' Walks the TrackEntry elements in [start, rangeEnd) and collects each TrackNumber and TrackType. Returns invalid
' when the range runs past the buffer or an element inside it is malformed.
function mkvReadTrackEntries_(bytes as object, start as integer, rangeEnd as dynamic, total as integer) as dynamic
  if rangeEnd > total then return invalid
  entries = []
  at = start
  while at < rangeEnd
    entry = mkvReadElement_(bytes, at, total)
    if entry = invalid or entry.unknownSize then return invalid
    entryEnd = entry.dataStart + entry.size
    if entryEnd > rangeEnd then return invalid
    if entry.id = &hAE
      foundNumber = false
      number = invalid
      trackType = invalid
      childPos = entry.dataStart
      while childPos < entryEnd
        child = mkvReadElement_(bytes, childPos, total)
        if child = invalid or child.unknownSize then return invalid
        childEnd = child.dataStart + child.size
        if childEnd > entryEnd then return invalid
        if not foundNumber and child.id = &hD7 and child.size >= 1 and child.size <= 8
          number# = mkvReadUnsigned_(bytes, child.dataStart, childEnd)
          ' Whole numbers: an integer unless the stored value is too big for one.
          if number# < 2147483647
            number = int(number#)
          else
            number = number#
          end if
          foundNumber = true
        else if trackType = invalid and child.id = &h83 and child.size >= 1 and child.size <= 4
          trackType = int(mkvReadUnsigned_(bytes, child.dataStart, childEnd))
        end if
        childPos = childEnd
      end while
      ' TrackNumber is mandatory, so a TrackEntry without one is a broken header. Skipping it would
      ' shift every later track against the server's stream list.
      if not foundNumber then return invalid
      entries.push({ number: number, type: trackType })
    end if
    at = entryEnd
  end while
  return entries
end function

' Reads the big-endian unsigned integer stored in [start, finish).
function mkvReadUnsigned_(bytes as object, start as integer, finish as integer) as double
  value# = 0
  for i = start to finish - 1
    value# = value# * 256 + bytes[i]
  end for
  return value#
end function

' The EBML length of a variable-length integer from its first byte: the position of the first set bit
' (1 to 8), or 0 when the byte is zero.
function mkvMarkerLength_(firstByte as integer) as integer
  mask = 128
  for length = 1 to 8
    if (firstByte and mask) <> 0 then return length
    mask = mask >> 1
  end for
  return 0
end function

' Decides whether to read the start of a source's file for its stored MKV track numbers.
'
' @param {dynamic} source - the played MediaSource AA, or invalid
' @param {boolean} isLive - true for a live item
' @returns {boolean} true for a "file" protocol source whose Container names mkv, and not for live
function shouldReadMkvTracks(source as dynamic, isLive as boolean) as boolean
  if isLive or not isValid(source) then return false
  if LCase(textOrEmpty(source.Protocol)) <> "file" then return false
  ' Jellyfin may list several names in Container ("mov,mp4,m4a"), so test each one.
  for each name in LCase(textOrEmpty(source.Container)).split(",")
    if name.trim() = "mkv" then return true
  end for
  return false
end function
