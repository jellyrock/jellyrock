import "pkg:/source/enums/BackdropMode.bs"

' resolveBackdropMode: where backdrop images show, from the user's Backdrop Images setting.
'
' The JellyRock setting wins when it names a mode. Otherwise (the legacy "webclient" value, an
' empty or unknown value) the server's ShowBackdrop decides between enabled and disabled, and
' enabled is the default when that is missing or not a boolean.
'
' @param {object} userSettings - JellyfinUserSettings node (JellyRock settings)
' @param {object} userConfig - JellyfinUserConfiguration node (web client settings)
' @returns {string} - a BackdropMode value
function resolveBackdropMode(userSettings as object, userConfig as object) as string
  if isValid(userSettings) and isValid(userSettings.uiShowBackdrop)
    setting = userSettings.uiShowBackdrop
    if setting = BackdropMode.ENABLED or setting = BackdropMode.DETAILS or setting = BackdropMode.DISABLED
      return setting
    end if
  end if

  if isValid(userConfig) and isValid(userConfig.showBackdrop)
    valueType = Type(userConfig.showBackdrop)
    if valueType = "roBoolean" or valueType = "Boolean"
      if userConfig.showBackdrop then return BackdropMode.ENABLED
      return BackdropMode.DISABLED
    end if
  end if

  return BackdropMode.ENABLED
end function

' isItemBackdropOwner: true for the screens that show an open item (its details screen and the
' players), the only screens that show a backdrop in BackdropMode.DETAILS. A backdrop writer
' passes its own subtype (m.top.subtype()) as the owner; browse screens pass none.
'
' @param {dynamic} owner - the writing screen's subtype, or "" / invalid for an unnamed writer
' @returns {boolean}
function isItemBackdropOwner(owner as dynamic) as boolean
  if not isValidAndNotEmpty(owner) then return false
  return owner = "ItemDetails" or owner = "PlayerHostView" or owner = "VideoPlayerView" or owner = "AudioPlayerView"
end function

' backdropUriFor: the image a backdrop write actually shows under a mode: the requested URI, or
' "" to clear. In details mode a write from anything but an item screen becomes a clear. That
' is also what clears an item's backdrop on Back: each browse screen writes its own backdrop
' as it is shown again (Home and search through their focused tile, the library grid and
' Settings directly), so a new browse screen must do the same.
'
' @param {string} mode - a BackdropMode value
' @param {dynamic} owner - the writing screen's subtype (isItemBackdropOwner)
' @param {string} uri - the requested image
' @returns {string}
function backdropUriFor(mode as string, owner as dynamic, uri as string) as string
  if mode = BackdropMode.ENABLED then return uri
  if mode = BackdropMode.DETAILS and isItemBackdropOwner(owner) then return uri
  return ""
end function

' backgroundWriteIsStale: true when a global-backdrop write should be SUPPRESSED because the writing
' screen is no longer the active routed view.
'
' The app has a SINGLE global backdrop node (JRScene.imageFader, last-writer-wins, no ownership guard).
' A view whose async data lands AFTER it has been backgrounded can otherwise clobber the foreground
' view's backdrop. The concrete case: on a cold deep-link launch the app routes Home -> ItemDetails,
' but Home's row Tasks finish loading LATE and its rowItemFocused observer fires a backdrop write after
' ItemDetails is already showing, blanking the item the user was deep-linked to. Warm navigation
' doesn't hit this because Home's rows are already loaded before it is backgrounded.
'
' Suppress only when a DIFFERENT valid view owns the screen. An unset/empty active subtype (early
' mount, before m.global.activeRoutedView is assigned) is allowed through, so a legitimate first paint
' is never dropped. Pure so the rule is unit-testable.
'
' NOTE (tech-debt: backdrop-ownership-guard): the durable fix is to move this check INTO
' JRScene.setBackgroundImage keyed to m.global.activeRoutedView, so every late writer (not only Home)
' is guarded. This helper is the isolated fix for the observed HomeRows cold-launch clobber.
'
' @param {dynamic} activeSubtype - m.global.activeRoutedView.subtype() (or invalid when none/unset)
' @param {string} owningSubtype - the subtype of the screen attempting the write (for example "Home")
' @returns {boolean} - true to SUPPRESS the write (a different view is active)
function backgroundWriteIsStale(activeSubtype as dynamic, owningSubtype as string) as boolean
  if not isValidAndNotEmpty(activeSubtype) then return false
  return activeSubtype <> owningSubtype
end function
