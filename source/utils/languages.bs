' languageBaseCode: One canonical form of a language code, for comparing codes written in
' different ISO 639 forms — "fra", "fre" and "fr" all give "fr", "sw" and "swa" give "sw".
' A region or script suffix is dropped first ("pt-BR" → "pt"), as resolveLanguageName() does.
' A code neither map knows is returned lowercased as-is.
'
' @param {dynamic} code - Language code in any common form
' @returns {string} - Canonical code, or "" when code is missing or empty
function languageBaseCode(code as dynamic) as string
  if not isValidAndNotEmpty(code) then return ""

  base = LCase(code)
  hyphenPos = inStr(1, base, "-")
  if hyphenPos > 0 then base = Left(base, hyphenPos - 1)
  underscorePos = inStr(1, base, "_")
  if underscorePos > 0 then base = Left(base, underscorePos - 1)

  base = mediaLanguageAliases()[base] ?? base
  ' Second lookup on the result, for the one display alias whose target is 3-letter ("ji" → "yid")
  return mediaLanguageMatchAliases()[base] ?? base
end function

' languagesMatch: True when two language codes name the same language, whatever ISO 639 form
' each is written in (see languageBaseCode()). Regional variants count as the same language.
'
' @param {dynamic} a - Language code
' @param {dynamic} b - Language code
' @returns {boolean} - False when either code is missing or empty
function languagesMatch(a as dynamic, b as dynamic) as boolean
  baseA = languageBaseCode(a)
  return baseA <> "" and baseA = languageBaseCode(b)
end function

' Maps a normalized 2-letter base code (or a 3-letter code for languages
' without a 639-1 equivalent) to the translation key used by translate()
' for the localized language name. Keys must exist in locale/custom/en_US.json.
'
' Region/script suffixes (e.g., "_BR", "_Hant") are stripped before lookup
' by resolveLanguageName(), so en_GB and en_US both land at "en" → LanguageEn.
'
' Cached on the caller's m scope after first build.
'
' @returns {object} - AssocArray of base code to translationKeys.* string
function languageTranslationKeys() as object
  if isValid(m.languageTranslationKeysCache) then return m.languageTranslationKeysCache

  m.languageTranslationKeysCache = {
