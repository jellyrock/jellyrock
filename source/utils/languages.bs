    "urd": "ur",
    "uzb": "uz",
    "vie": "vi",
    "zho": "zh", "chi": "zh",
    "zul": "zu"
  }

  return m.mediaLanguageAliasesCache
end function

' ISO 639-2 codes for the languages mediaLanguageAliases() leaves out (it covers only UI
' locales), mapped to their ISO 639-1 code. For language MATCHING only — see
' languageBaseCode(). Kept apart from mediaLanguageAliases() because display depends on that
' map's gaps: languageEnglishFallbacks() is keyed by the 3-letter code, so aliasing "swa" to
' "sw" there would show Swahili as the raw "swa".
'
' Source: the ISO 639-2 list (Library of Congress) as Jellyfin 12.0 ships it,
' Emby.Server.Implementations/Localization/iso6392.txt — every code with an ISO 639-1
' equivalent that mediaLanguageAliases() does not already map. lint:language-coverage fails if
' the two maps overlap.
'
' @returns {object} - AssocArray of 3-letter code to 2-letter code
function mediaLanguageMatchAliases() as object
  if isValid(m.mediaLanguageMatchAliasesCache) then return m.mediaLanguageMatchAliasesCache

