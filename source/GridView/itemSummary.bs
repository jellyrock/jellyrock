import "pkg:/source/translationKeys.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/skeleton.bs"
import "pkg:/source/utils/translate.bs"

' What a library's header strip says about the focused item: its title, and one line of
' what tells it apart. Keyed on the item's own type, never on the library's: a
' collection or a folder holds several types.
namespace itemSummary

  ' @param item - the focused item's node, or invalid
  ' @return {object} { title, metadata }: the title, and the metadata line's items in
  '   order. "" and [] for nothing or a skeleton placeholder.
  function line(item as dynamic) as object
    summary = { title: "", metadata: [] }
    if not isValid(item) or skeleton.isPlaceholder(item) then return summary

    summary.title = textOrEmpty(item.name).trim()
    if summary.title = "" then summary.title = textOrEmpty(item.title).trim()

    parts = []
    itemType = LCase(textOrEmpty(item.type))
    if itemType = "series"
      itemSummary.push(parts, itemSummary.seriesYears(item))
      itemSummary.push(parts, item.officialRating)
    else if itemType = "musicalbum"
      itemSummary.push(parts, item.albumArtist)
      itemSummary.push(parts, itemSummary.year(item))
    else if itemType = "tvchannel" or itemType = "livetvchannel"
      itemSummary.push(parts, item.channelNumber)
      if isValid(item.currentProgram) then itemSummary.push(parts, item.currentProgram.name)
    else if itemType = "musicartist" or itemType = "genre" or itemType = "musicgenre" or itemType = "studio"
      ' The name says it all
    else
      ' A movie, an episode, a video, a collection, a photo, a folder: what it has
      itemSummary.push(parts, itemSummary.year(item))
      itemSummary.push(parts, item.officialRating)
      itemSummary.push(parts, itemSummary.runtime(item))
    end if

    summary.metadata = parts
    return summary
  end function

  ' Add `text` to `parts` when it says something.
  sub push(parts as object, text as dynamic)
    value = textOrEmpty(text).trim()
    if value <> "" then parts.push(value)
  end sub

  ' The production year, "" when the item has none.
  function year(item as object) as string
    if not isValid(item.productionYear) or item.productionYear <= 0 then return ""
    return stri(item.productionYear).trim()
  end function

  ' A series' years as the details screen writes them: "2019 - 2023", "2019 - Present",
  ' or the first year alone for a series that ended with no end date.
  function seriesYears(item as object) as string
    first = itemSummary.year(item)
    if first = "" then return ""
    if isValidAndNotEmpty(item.endDate) then return first + " - " + item.endDate.left(4)
    if textOrEmpty(item.status) = "Ended" then return first
    return first + " - " + translate(translationKeys.LabelPresent)
  end function

  ' The runtime in whole minutes, as the presentation layout writes it; "" for none.
  function runtime(item as object) as string
    if not isValid(item.runTimeTicks) or item.runTimeTicks <= 0 then return ""
    minutes = int(item.runTimeTicks / 600000000.0 + 0.5)
    if minutes <= 0 then return ""
    return stri(minutes).trim() + " " + translate(translationKeys.LabelMins)
  end function

end namespace
