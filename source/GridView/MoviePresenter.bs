' MoviePresenter: Presenter for movie library views
'
' Handles movie-specific:
' - Tabs (Movies, Collections, Genres, Studios), and the Movies tab's two layouts
' - Sort/filter options with dynamic filters from API
' - Movie metadata display (title, year, rating, runtime, overview, logo)
' - Critic and community ratings
' - Logo loading

import "pkg:/source/GridView/collectionsView.bs"
import "pkg:/source/GridView/GridPresenterBase.bs"
import "pkg:/source/GridView/gridQuery.bs"
import "pkg:/source/GridView/libraryTab.bs"
import "pkg:/source/logging/Logger.bs"
import "pkg:/source/utils/languageFilters.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/tasks.bs"

' The presentation layout's grid starts here, and never moves: the panel above it fills
' the room it has. PANEL_ROOM is that room, from the panel's top (y 183) to the first
' row's focus ring. The panel is spaced as the details screen spaces the same text
' (ItemDetails.xml and FocusableOverview): its info rows touch, 12 pixels come before the
' description, and 15 between the tagline and the overview. A line of the Medium font
' takes TEXT_LINE.
const PRESENTATION_GRID_Y = 438
const PANEL_ROOM = 252
const TEXT_LINE = 40
const DESCRIPTION_GAP = 12
const TAGLINE_GAP = 15
const OVERVIEW_MIN_LINES = 2

class MoviePresenter extends GridPresenterBase

  ' Counter for generating unique divider IDs
  private dividerCount

  sub new()
    super()
    m.log = new log.Logger("MoviePresenter")
    m.dividerCount = 0
  end sub

  ' Uses the presentation backdrop only where the presentation panel is up
  override function getBackdropMode(viewMode as string, layout as string) as string
    if m.isPresentation(viewMode, layout) then return "presentation"
    return "fullscreen"
  end function

  override sub onInit(view as object)
    super.onInit(view)
    ' Create logo loading task on view (component scope) so observer callbacks work
    m.view.loadLogoTask = CreateObject("roSGNode", "LoadItemsTask2")
  end sub

  ' Show presentation info only where the presentation panel is up
  override function shouldShowPresentationInfo(viewMode as string, layout as string) as boolean
    return m.isPresentation(viewMode, layout)
  end function

  ' The presentation panel draws only on the Movies tab. The layout is saved per library
  ' and view (ADR 0058), and only the Movies view offers this one, so Studios, Genres and
  ' Collections keep their own grids.
  private function isPresentation(viewMode as string, layout as string) as boolean
    return LCase(viewMode) = libraryTab.MOVIES and layout = libraryLayout.PRESENTATION
  end function

  override function getOptions(parentItem as object) as object
    ' The web client's tab order (Movies, Suggestions, Favorites, Collections, Genres),
    ' with the tabs JellyRock has. Studios has no web tab, so it goes last. The tabs after
    ' Movies are added below, for a library only.
    options = {
      views: [
        { "Title": translate(translationKeys.LabelMovies), "Name": libraryTab.MOVIES }
      ],
      ' The Movies tab is the one that can be drawn two ways (the Layout page setting).
      layouts: {
        movies: [
          { "Name": libraryLayout.PRESENTATION },
          { "Name": libraryLayout.COMFORTABLE }
        ]
      },
      sort: [
        { "Title": translate(translationKeys.LabelTitle), "Name": "SortName" },
        { "Title": translate(translationKeys.LabelImdbRating), "Name": "CommunityRating" },
        { "Title": translate(translationKeys.LabelCriticRating), "Name": "CriticRating" },
        { "Title": translate(translationKeys.LabelDateAdded), "Name": "DateCreated" },
        { "Title": translate(translationKeys.LabelDatePlayed), "Name": "DatePlayed" },
        { "Title": translate(translationKeys.LabelOfficialRating), "Name": "OfficialRating" },
        { "Title": translate(translationKeys.LabelPlayCount), "Name": "PlayCount" },
        { "Title": translate(translationKeys.LabelReleaseDate), "Name": "PremiereDate" },
        { "Title": translate(translationKeys.LabelRuntime), "Name": "Runtime" },
        { "Title": translate(translationKeys.LabelRandom), "Name": "Random" }
      ],
      filter: [
        { "Title": translate(translationKeys.LabelAll), "Name": "All" },
        { "Title": translate(translationKeys.LabelFavorites), "Name": "Favorites" },
        { "Title": translate(translationKeys.LabelPlayed), "Name": "Played" },
        { "Title": translate(translationKeys.LabelUnplayed), "Name": "Unplayed" },
        { "Title": translate(translationKeys.LabelResumable), "Name": "Resumable" }
      ]
    }

    ' A studio or genre folder lists its movies and nothing else: its name is the title,
    ' and it has no tabs.
    isLibrary = not libraryTab.isFolder(parentItem)
    if isLibrary
      ' The Movies tab's favorites, as the web client's Favorites tab is its movies list
      ' with favorites fixed on (gridQuery.viewOfTab).
      options.views.push({ "Title": translate(translationKeys.LabelFavorites), "Name": libraryTab.FAVORITES, "View": libraryTab.MOVIES, "IsFavorite": true })
      ' The library itself on 12.0+ only. Below 12.0 the same request returns every
      ' collection on the server, other libraries' included, so the view is withheld
      ' rather than offered and wrong. See collectionsView for both rules.
      if collectionsView.offeredFor(parentItem, m.serverVersion())
        options.views.push({ "Title": translate(translationKeys.LabelCollections), "Name": libraryTab.COLLECTIONS })
      end if
      options.views.push({ "Title": translate(translationKeys.LabelGenres), "Name": libraryTab.GENRES })
      options.views.push({ "Title": translate(translationKeys.LabelStudios), "Name": libraryTab.STUDIOS })
    end if

    ' The Favorites tab covers the Movies view's favorites, so that view's filter list
    ' leaves the Favorites filter out (the Favorites tab draws the same view, so its list
    ' has none either). Every list the tab does not cover keeps it: a folder's, and the
    ' Collections view's below.
    if isLibrary and LCase(m.currentView()) = libraryTab.MOVIES
      options.filter = m.withoutFilter(options.filter, "Favorites")
    end if

    ' The Collections view lists BoxSets, not movies, so it takes its own sort and filter
    ' lists and stops here: every category below this point describes a movie.
    '
    ' The sort list is shorter on purpose, and matches what jellyfin-web offers on its own
    ' Collections tab (`collectionMovieOptions`): a collection carries no critic rating,
    ' no runtime and no play count of its own, so those four entries would be controls
    ' that appear to do nothing. The filters are the four verified against a local 12.0.0
    ' (2026-09-23) to answer for a BoxSet; Resumable is left out because a collection is
    ' not a thing you resume, even where the server will answer the query.
    if LCase(m.currentView()) = libraryTab.COLLECTIONS
      options.sort = [
        { "Title": translate(translationKeys.LabelTitle), "Name": "SortName" },
        { "Title": translate(translationKeys.LabelImdbRating), "Name": "CommunityRating" },
        { "Title": translate(translationKeys.LabelDateAdded), "Name": "DateCreated" },
        { "Title": translate(translationKeys.LabelOfficialRating), "Name": "OfficialRating" },
        { "Title": translate(translationKeys.LabelReleaseDate), "Name": "PremiereDate" },
        { "Title": translate(translationKeys.LabelRandom), "Name": "Random" }
      ]
      options.filter = [
        { "Title": translate(translationKeys.LabelAll), "Name": "All" },
        { "Title": translate(translationKeys.LabelFavorites), "Name": "Favorites" },
        { "Title": translate(translationKeys.LabelPlayed), "Name": "Played" },
        { "Title": translate(translationKeys.LabelUnplayed), "Name": "Unplayed" }
      ]
      return options
    end if

    ' Add dynamic filters from API if loaded. A category with nothing to tick is left out,
    ' since picking it would narrow nothing.
    if isValid(m.apiFilters)
      if isValidAndNotEmpty(m.apiFilters.Genres)
        options.filter.push({ "Title": translate(translationKeys.LabelGenres), "Name": "Genres", "Options": m.apiFilters.Genres })
      end if
      if isValidAndNotEmpty(m.apiFilters.OfficialRatings)
        options.filter.push({ "Title": translate(translationKeys.LabelParentalRatings), "Name": "OfficialRatings", "Options": m.apiFilters.OfficialRatings })
      end if
      if isValidAndNotEmpty(m.apiFilters.Years)
        options.filter.push({ "Title": translate(translationKeys.LabelYears), "Name": "Years", "Options": m.apiFilters.Years })
      end if

      ' 12.0+ only, and only when the library actually has the metadata: the lists come
      ' from /Items/Filters2, which omits them entirely below 12.0 (so they arrive empty
      ' and no category is offered).
      '
      ' Two categories rather than one combined "Language": the server ANDs the two
      ' parameters, so "English audio with Spanish subtitles" is a query it can answer,
      ' and the Filter menu keeps the two apart so a viewer can ask it. One list would
      ' double its length and mix two concepts.
      if isValidAndNotEmpty(m.apiFilters[languageFilters.AUDIO_KEY])
        options.filter.push({ "Title": translate(translationKeys.LabelAudioLanguage), "Name": languageFilters.AUDIO_KEY, "Options": m.apiFilters[languageFilters.AUDIO_KEY] })
      end if
      if isValidAndNotEmpty(m.apiFilters[languageFilters.SUBTITLE_KEY])
        options.filter.push({ "Title": translate(translationKeys.LabelSubtitleLanguage), "Name": languageFilters.SUBTITLE_KEY, "Options": m.apiFilters[languageFilters.SUBTITLE_KEY] })
      end if
    end if

    return options
  end function

  ' Studio logos are drawn whole; posters fill their cell
  override function getImageDisplayMode(viewMode as string) as string
    if LCase(viewMode) = libraryTab.STUDIOS then return "scaleToFit"
    return "scaleToZoom"
  end function

  ' The presentation layout's grid starts under the metadata panel
  override function getGridTop(viewMode as string, layout as string) as integer
    if m.isPresentation(viewMode, layout) then return PRESENTATION_GRID_Y
    return headerStrip.CONTENT_TOP
  end function

  override sub configureLoadTask(task as object, parentItem as object, viewMode as string)
    lowerView = LCase(viewMode)

    task.itemType = "Movie"
    task.itemId = parentItem.Id
    task.additionalFields = "Taglines,Genres"

    if lowerView = libraryTab.COLLECTIONS
      ' The library's collections. `isRecursive` stays true, which is what the 12.x
      ' servers scope correctly; Taglines and Genres are movie fields a BoxSet has no
      ' use for, so the page is not asked to carry them.
      task.itemType = "BoxSet"
      task.additionalFields = ""
      task.view = "Collections"
      task.studioIds = ""
      task.genreIds = ""
    else if lowerView = libraryTab.STUDIOS
      task.view = "Networks"
      task.studioIds = ""
    else if lowerView = libraryTab.GENRES
      task.view = "Genres"
      task.studioIds = parentItem.Id
    else
      task.view = "Movies"
      task.studioIds = ""
      task.genreIds = ""
    end if

    ' Handle genre/studio parent items
    if isValid(parentItem) and isValidAndNotEmpty(parentItem.type)
      if parentItem.type = "Studio"
        task.studioIds = parentItem.id
        task.itemId = parentItem.parentId
        task.genreIds = ""
      else if parentItem.type = "Genre" or (parentItem.type = "Folder" and parentItem.folderType = "Genre")
        ' Current Jellyfin returns genre items with IsFolder=false, so type="Genre" is the normal path.
        ' The Folder+folderType branch is a defensive fallback for server configurations that return IsFolder=true.
        task.genreIds = parentItem.id
        task.itemId = parentItem.parentId
        task.studioIds = ""
      end if
    end if

    ' Reached on every query build (every sort, filter, view, alpha letter and voice
    ' search), so loadFilters() itself is the thing that decides whether to fetch. It
    ' fetches once per library and is then a no-op until the Filter menu revalidates it.
    '
    ' Not in the Collections view: every category those lists fill describes a movie, and
    ' getOptions() offers none of them here. Skipping is free rather than merely cheaper,
    ' because leaving the view runs this again: a session that lands on Collections and
    ' stays there never pays for lists it was never shown.
    if lowerView <> libraryTab.COLLECTIONS
      m.loadFilters(parentItem, "Movie")
    end if
  end sub

  override sub onItemFocused(item as object, currentView as string, layout as string)
    if not isValid(m.view) or not isValid(item) then return
    if not isValidAndNotEmpty(item.id) then return

    ' Everything below writes into `presentationInfo`, which only the presentation layout
    ' of the Movies tab puts on screen: BaseGridView.configureBackdrop() sets its visibility to
    ' exactly this predicate. In every other view the labels are built and the logo is
    ' fetched for a hidden panel, which for the logo is a network request per focus
    ' change: the grid views moved a cursor across a library and asked the server for a
    ' logo it would never draw.
    if not m.shouldShowPresentationInfo(currentView, layout) then return

    ' Get info nodes from view
    infoGroup = m.view.top.findNode("presentationInfo")
    if not isValid(infoGroup) then return

    movieLogo = infoGroup.findNode("movieLogo")
    movieInfoGroup = infoGroup.findNode("movieInfoGroup")
    movieGenresGroup = infoGroup.findNode("movieGenres")
    movieDescriptionGroup = infoGroup.findNode("movieDescription")

    ' Hide logo initially
    if isValid(movieLogo) then movieLogo.visible = false

    ' The first row, as the details screen writes a movie's: year, rating, the star and
    ' critic ratings, runtime. The header strip above the panel gives the title alone here.
    if isValid(movieInfoGroup)
      ' Clear existing children
      movieInfoGroup.removeChildrenIndex(movieInfoGroup.getChildCount(), 0)
      m.dividerCount = 0

      if item.productionYear > 0
        yearNode = m.createInfoLabelNode("selectedMovieProductionYear")
        yearNode.text = str(item.productionYear).trim()
        m.displayInfoNode(movieInfoGroup, yearNode)
      end if

      if isValidAndNotEmpty(item.officialRating)
        ratingNode = m.createInfoLabelNode("selectedMovieOfficialRating")
        ratingNode.text = item.officialRating
        m.displayInfoNode(movieInfoGroup, ratingNode)
      end if

      ' Community Rating (if enabled)
      if m.view.global.user.settings.uiMoviesShowRatings
        if item.communityRating > 0
          communityRating = CreateObject("roSGNode", "CommunityRating")
          communityRating.id = "communityRatingDisplay"
          communityRating.rating = item.communityRating
          communityRating.iconSize = 28
          m.displayInfoNode(movieInfoGroup, communityRating)
        end if

        ' Critic Rating (if enabled)
        if item.criticRating > 0
          criticRating = CreateObject("roSGNode", "CriticRating")
          criticRating.id = "criticRatingDisplay"
          criticRating.rating = item.criticRating
          criticRating.iconSize = 28
          m.displayInfoNode(movieInfoGroup, criticRating)
        end if
      end if

      if item.runTimeTicks > 0
        runtime = int(item.runTimeTicks / 600000000.0 + 0.5) ' Round to nearest minute
        runtimeNode = m.createInfoLabelNode("runtime")
        runtimeNode.text = str(runtime).trim() + " " + translate(translationKeys.LabelMins)
        m.displayInfoNode(movieInfoGroup, runtimeNode)
      end if
    end if

    ' Dynamically populate movieGenres with genre labels
    if isValid(movieGenresGroup)
      ' Clear existing children
      movieGenresGroup.removeChildrenIndex(movieGenresGroup.getChildCount(), 0)

      ' Add genres concatenated with " / "
      if item.genres.count() > 0
        genreNode = CreateObject("roSGNode", "LabelPrimaryMedium")
        genreNode.id = "movieGenres"
        genreNode.horizAlign = "left"
        genreNode.vertAlign = "center"
        genreNode.width = 900
        genreNode.height = TEXT_LINE
        genreNode.text = item.genres.join(" / ")
        genreNode.isBold = true
        movieGenresGroup.appendChild(genreNode)
      end if
    end if

    ' Dynamically populate movieDescription with tagline and overview
    if isValid(movieDescriptionGroup)
      ' Clear existing children
      movieDescriptionGroup.removeChildrenIndex(movieDescriptionGroup.getChildCount(), 0)

      ' The overview takes the lines the rows above it leave, so a movie with no ratings
      ' or no tagline shows more of it and nothing floats over a gap
      used = 0
      if isValid(movieInfoGroup) and movieInfoGroup.getChildCount() > 0 then used += TEXT_LINE
      if isValid(movieGenresGroup) and movieGenresGroup.getChildCount() > 0 then used += TEXT_LINE
      if used > 0 then used += DESCRIPTION_GAP
      if item.taglines.count() > 0 and item.taglines[0] <> "" then used += TEXT_LINE + TAGLINE_GAP
      overviewLines = (PANEL_ROOM - used) \ TEXT_LINE
      if overviewLines < OVERVIEW_MIN_LINES then overviewLines = OVERVIEW_MIN_LINES

      ' Tagline (stored in taglines array)
      if item.taglines.count() > 0 and item.taglines[0] <> ""
        taglineNode = CreateObject("roSGNode", "LabelSecondaryMedium")
        taglineNode.id = "selectedMovieTagline"
        taglineNode.isBold = true
        taglineNode.width = 800
        taglineNode.text = item.taglines[0]
        movieDescriptionGroup.appendChild(taglineNode)
      end if

      ' Overview
      if isValidAndNotEmpty(item.overview)
        overviewNode = CreateObject("roSGNode", "LabelSecondaryMedium")
        overviewNode.id = "selectedMovieOverview"
        overviewNode.wrap = true
        overviewNode.lineSpacing = 0
        overviewNode.maxLines = overviewLines
        overviewNode.width = 800
        overviewNode.ellipsisText = "..."
        overviewNode.text = item.overview
        movieDescriptionGroup.appendChild(overviewNode)
      end if
    end if

    ' Load logo
    m.loadLogo(item.id)
  end sub

  ' Load movie logo image, on a NEW node per focus change: focus can move on while the
  ' previous lookup is still running, and a launch of a still-running node is ignored
  ' (docs/architecture/threading.md, "Measured findings").
  private sub loadLogo(itemId as string)
    ' loadLogoTask goes invalid only in onDestroy, so this also stops a late focus event
    ' from starting a lookup after teardown.
    if not isValid(m.view) or not isValid(m.view.loadLogoTask) then return

    m.view.loadLogoTask = replaceTask(m.view.loadLogoTask, "LoadItemsTask2", "content", { itemId: itemId, itemType: "LogoImage" })
    ' Use "onPresenterLogoLoaded" - bridge function in BaseGridView that forwards to presenter
    m.view.loadLogoTask.observeField("content", "onPresenterLogoLoaded")
    launchTask(m.view.loadLogoTask)
  end sub

  ' Called when logo is loaded (via onPresenterLogoLoaded bridge in BaseGridView)
  sub onLogoLoaded(event as object)
    if not isValid(m.view) or not isCurrentTaskEvent(event, m.view.loadLogoTask) then return
    data = event.getData()
    m.view.loadLogoTask.unobserveField("content")
    m.view.loadLogoTask.content = []

    infoGroup = m.view.top.findNode("presentationInfo")
    if not isValid(infoGroup) then return

    movieLogo = infoGroup.findNode("movieLogo")
    ' Show logo if available
    if isValid(data) and data.Count() > 0
      if isValid(movieLogo)
        movieLogo.uri = data[0]
        movieLogo.visible = true
      end if
    end if
  end sub

  ' Create a label node for movieInfoGroup
  private function createInfoLabelNode(labelId as string) as object
    labelNode = CreateObject("roSGNode", "LabelPrimaryMedium")
    labelNode.id = labelId
    labelNode.horizAlign = "left"
    labelNode.vertAlign = "center"
    labelNode.width = 0
    labelNode.height = 0
    labelNode.isBold = true
    return labelNode
  end function

  ' Create a bullet divider node for movieInfoGroup
  private function createInfoDividerNode() as object
    m.dividerCount++
    dividerNode = CreateObject("roSGNode", "LabelPrimarySmall")
    dividerNode.id = "divider" + m.dividerCount.toStr()
    dividerNode.horizAlign = "left"
    dividerNode.vertAlign = "center"
    dividerNode.width = 0
    dividerNode.height = 40
    dividerNode.text = "•"
    dividerNode.isBold = true
    return dividerNode
  end function

  ' Add a node to movieInfoGroup with divider if needed
  private sub displayInfoNode(infoGroup as object, node as object)
    if not isValid(node) or not isValid(infoGroup) then return

    ' Add divider if this isn't the first child
    if infoGroup.getChildCount() > 0
      dividerNode = m.createInfoDividerNode()
      infoGroup.appendChild(dividerNode)
    end if

    infoGroup.appendChild(node)
  end sub

  override sub onDestroy()
    if isValid(m.view) then m.view.loadLogoTask = releaseTask(m.view.loadLogoTask, "content")
    super.onDestroy()
  end sub

end class
