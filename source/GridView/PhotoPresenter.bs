' PhotoPresenter: Presenter for photo library views
'
' Handles Photo-specific:
' - One tab, Photos
' - Photo display configuration
'
' Whether a photo opens as a slideshow, in order or at random, is the photosSlideshow and
' photosRandom user settings (Settings, Libraries, Photos), which PhotoDetails reads.
' They used to be listed here as four views.

import "pkg:/source/GridView/GridPresenterBase.bs"
import "pkg:/source/GridView/libraryTab.bs"
import "pkg:/source/logging/Logger.bs"
import "pkg:/source/utils/misc.bs"

class PhotoPresenter extends GridPresenterBase

  sub new()
    super()
    m.log = new log.Logger("PhotoPresenter")
  end sub

  override sub onInit(view as object)
    super.onInit(view)
    m.log.info("PhotoPresenter initialized")
  end sub

  ' Photos use fullscreen backdrop
  override function getBackdropMode(_viewMode as string, _layout as string) as string
    return "fullscreen"
  end function

  ' No presentation info for photos
  override function shouldShowPresentationInfo(_viewMode as string, _layout as string) as boolean
    return false
  end function

  override function getOptions(_parentItem as object) as object
    return {
      views: [
        { "Title": translate(translationKeys.LabelPhotos), "Name": libraryTab.PHOTOS }
      ],
      layouts: {},
      sort: [
        { "Title": translate(translationKeys.LabelTitle), "Name": "SortName" },
        { "Title": translate(translationKeys.LabelDateAdded), "Name": "DateCreated" },
        { "Title": translate(translationKeys.LabelDatePlayed), "Name": "DatePlayed" },
        { "Title": translate(translationKeys.LabelRandom), "Name": "Random" }
      ],
      filter: [
        { "Title": translate(translationKeys.LabelAll), "Name": "All" },
        { "Title": translate(translationKeys.LabelFavorites), "Name": "Favorites" }
      ]
    }
  end function

  override function getGridConfig(_viewMode as string, _layout as string) as object
    return {
      translation: [96, 102],
      itemSize: [264, 396],
      rowHeights: [396],
      numRows: "3",
      numColumns: "6",
      imageDisplayMode: "scaleToZoom"
    }
  end function

  override sub configureLoadTask(task as object, parentItem as object, _viewMode as string)
    task.itemType = "Photo"
    task.itemId = parentItem.Id
    ' Photos in albums are non-recursive
    task.isRecursive = false
  end sub

  override sub onDestroy()
    m.log.info("PhotoPresenter destroyed")
    super.onDestroy()
  end sub

end class
