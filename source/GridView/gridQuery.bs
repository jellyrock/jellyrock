import "pkg:/source/utils/languageFilters.bs"
import "pkg:/source/utils/misc.bs"

' The library grid's LoadItemsTask2 query (what BaseGridView asks for), kept apart from the
' Task node that runs it.
'
' BaseGridView runs every load and every page on a NEW node (see replaceTask), so the node
' cannot be the memory of the query: the next page must ask for exactly what the first page
' asked for, and that has to survive the node being replaced. The query is a plain AA held
' on the component instead, and paging.forPage gives each page its copy.
'
' It lives in source/ rather than in BaseGridView.bs because a component codebehind's
' functions are scoped to that component and a Rooibos suite cannot call them without a
' callFunc seam on the XML. Same move as source/home/latestRows.bs.
namespace gridQuery

  ' The query for a fresh load: the defaults, then whatever the presenter sets for its view.
  ' Presenters receive a plain AA and assign fields on it exactly as they would on a
  ' LoadItemsTask2 node. Built from scratch every time, so nothing a presenter set for one
  ' view carries into the next.
  '
  ' @param state - { nameStartsWith, searchTerm, sortField, sortAscending, filter,
  '   filterOptions, isFavorite }; `isFavorite` is what a Favorites tab fixes on, apart
  '   from `filter`, so the two combine
  ' @param parentItem - the library (or folder) the grid shows
  ' @param view - the current view mode, passed to the presenter
  ' @param presenter - the grid's presenter, or invalid
  ' @return LoadItemsTask2 input fields, without startIndex (see paging.forPage)
  function build(state as object, parentItem as object, view as dynamic, presenter as dynamic) as object
    query = {
      nameStartsWith: state.nameStartsWith,
      searchTerm: state.searchTerm,
      sortField: state.sortField,
      sortAscending: state.sortAscending,
      filter: state.filter,
      ' The ONE place a saved filter becomes a request. The panel and the registry
      ' separate options with the category's own delimiter; the language categories then
      ' need flattening to the comma list the server takes. See languageFilters.toWire.
      filterOptions: languageFilters.toWire(state.filterOptions),
      isFavorite: isBooleanTrue(state.isFavorite),
      ' Presenters can override any of these
      itemId: parentItem.Id,
      isRecursive: true,
      itemType: "",
      view: "",
      studioIds: "",
      genreIds: ""
    }
    if isValid(presenter)
      presenter.configureLoadTask(query, parentItem, view)
    end if
    return query
  end function

  ' ── A saved choice, and what the presenter currently offers ───────────────────
  '
  ' Until 12.0 every view a presenter listed was available on every server, so a saved
  ' tab could always be honored. The Collections view breaks that: it is offered only on
  ' 12.0+, so a tab saved against one server can be missing when the SAME library is
  ' opened against an older one (a downgrade, a restored backup). Honoring it anyway does
  ' not fail loudly: the presenter falls through to its default query branch while the
  ' layout is still chosen for the named view, which on a movie library means the
  ' presentation grid's 650px offset with the info panel hidden: a grid pushed down the
  ' screen against dead space. A tab picked in the web client can name a tab this
  ' library lacks for the same reason, or one the app has but not here (Favorites on a
  ' music library).

  ' offers: whether `name` is one of the entries a presenter is listing.
  '
  ' Case-insensitive, matching how BaseGridView.SetUpOptions compares a name to the saved
  ' one. A presenter's `Name` and the saved string must agree under the same rule in both
  ' places or a choice could restore here and fail to tick there.
  '
  ' @param offered - a list of `{ Name }`: a presenter's views, or one of its filter lists
  ' @param name - the name to look for
  function offers(offered as dynamic, name as dynamic) as boolean
    if type(offered) <> "roArray" then return false

    wanted = LCase(textOrEmpty(name).trim())
    if wanted = "" then return false

    for each entry in offered
      if isValid(entry)
        if LCase(textOrEmpty(entry.Name).trim()) = wanted then return true
      end if
    end for
    return false
  end function

  ' resolveOffered: a saved choice, honored only while it is still offered.
  '
  ' The one rule for every saved name that a list can stop offering: the view, a plain
  ' filter, a sort. Nothing saved answers with the fallback, and so does a saved name the
  ' list no longer holds.
  '
  ' The caller does not write the fallback back to the registry: the saved choice is still
  ' what the user picked, and it is valid again the moment the list offers it.
  '
  ' @param saved - the stored name, or Invalid when none is stored
  ' @param offered - a list of `{ Name }`
  ' @param fallback - what to use instead
  function resolveOffered(saved as dynamic, offered as dynamic, fallback as dynamic) as string
    name = textOrEmpty(saved).trim()
    if name = "" then return textOrEmpty(fallback)
    if gridQuery.offers(offered, name) then return name
    return textOrEmpty(fallback)
  end function

  ' resolveView: which tab a library opens on, and where that choice came from.
  '
  ' The tab picked on this Roku (the `defaultTab` display setting) while the library
  ' offers it; else the tab picked in the web client while offered; else the library
  ' type's default. Each saved choice goes through resolveOffered, so one the library no
  ' longer offers falls through without being forgotten.
  '
  ' The empty default is not a missing view. getDefaultView() returns "" for a folder or
  ' collection (the Generic presenter), whose grid runs with no named view at all, and ""
  ' is in no presenter's list. Only a non-empty saved name is checked.
  '
  ' @param clientOverride - the stored `defaultTab` setting, or Invalid when none is stored
  ' @param serverTab - the web's pick for this library, already a libraryTab id
  '   (libraryTab.fromServerTab), or "" when there is none
  ' @param offeredViews - the presenter's `getOptions().views`
  ' @param defaultView - what getDefaultView() answered for this library
  ' @return {object} { tab, source }, `source` one of RESOLVED_ROKU, RESOLVED_WEB and
  '   RESOLVED_DEFAULT
  function resolveView(clientOverride as dynamic, serverTab as dynamic, offeredViews as dynamic, defaultView as dynamic) as object
    picked = gridQuery.resolveOffered(clientOverride, offeredViews, "")
    if picked <> "" then return { tab: picked, source: gridQuery.RESOLVED_ROKU }
    picked = gridQuery.resolveOffered(serverTab, offeredViews, "")
    if picked <> "" then return { tab: picked, source: gridQuery.RESOLVED_WEB }
    return { tab: textOrEmpty(defaultView), source: gridQuery.RESOLVED_DEFAULT }
  end function

  ' Where resolveView's tab came from.
  const RESOLVED_ROKU = "roku"
  const RESOLVED_WEB = "web"
  const RESOLVED_DEFAULT = "default"

  ' viewOfTab: the view a tab shows, and what is fixed on it.
  '
  ' A tab is a view plus what is fixed on it. Most tabs are their own view. A presenter
  ' lists a Favorites tab as `{ Name: libraryTab.FAVORITES, View: <its content tab>,
  ' IsFavorite: true }`: the content tab's view with favorites fixed on. So presenters are
  ' only ever handed a view id, and no presenter method learns a tab that is not a view.
  '
  ' An id the presenter does not list is its own view with nothing fixed, which is what a
  ' folder or collection needs: it lists no tabs and runs with the empty view.
  '
  ' @param offeredViews - the presenter's `getOptions().views`
  ' @param tabId - a libraryTab id
  ' @return {object} { view, isFavorite }
  function viewOfTab(offeredViews as dynamic, tabId as dynamic) as object
    id = textOrEmpty(tabId).trim()
    if type(offeredViews) = "roArray"
      for each entry in offeredViews
        if isValid(entry)
          if LCase(textOrEmpty(entry.Name).trim()) = LCase(id) and id <> ""
            view = textOrEmpty(entry.View).trim()
            if view = "" then view = textOrEmpty(entry.Name).trim()
            return { view: view, isFavorite: isBooleanTrue(entry.IsFavorite) }
          end if
        end if
      end for
    end if
    return { view: id, isFavorite: false }
  end function

  ' isPlainFavorites: whether `query` asks for favorites and narrows them no further.
  '
  ' An empty result of such a query means the library has no favorites, which the grid
  ' says in its own words. With a filter, a letter or a search in force, an empty result
  ' says only that nothing matched.
  '
  ' @param query - a query build() returned
  function isPlainFavorites(query as dynamic) as boolean
    if not isValid(query) or not isBooleanTrue(query.isFavorite) then return false
    if LCase(textOrEmpty(query.filter).trim()) <> "all" then return false
    if isValid(query.filterOptions)
      if query.filterOptions.count() > 0 then return false
    end if
    if textOrEmpty(query.nameStartsWith).trim() <> "" then return false
    return textOrEmpty(query.searchTerm).trim() = ""
  end function

  ' showsFavorites: whether `query` lists favorites, with or without more narrowing.
  '
  ' True for the Favorites tab (`isFavorite`) and for the Favorites filter. A grid that shows
  ' favorites is stale once a favorite toggles elsewhere.
  '
  ' @param query - a query build() returned
  function showsFavorites(query as dynamic) as boolean
    if not isValid(query) then return false
    if isBooleanTrue(query.isFavorite) then return true
    return LCase(textOrEmpty(query.filter).trim()) = "favorites"
  end function

  ' ── A category's options, its saved query, and the invariant between them ──────
  '
  ' A filter category's selectable options come in two shapes, and every site that reads
  ' them goes through optionTitle() / optionValue() so they cannot disagree about which
  ' is which.
  '
  ' A PLAIN STRING is its own query value: Genres sends the genre name, Years sends the
  ' year. What the panel shows and what the request carries are the same text.
  '
  ' An AA ({ title, value }) separates them, which the 12.0 language filters need in
  ' both directions. The label has to be the app's own localized language name, because
  ' the server's is an English library-science string ("Spanish; Castilian (spa)"); the
  ' value has to be the server's own case-sensitive codes, and for a language with two
  ' ISO 639-2 spellings it is BOTH of them, since the server matches the literal tag on
  ' the file. Sending the label would return nothing.
  '
  ' THE INVARIANT. A category's saved query is its checked options' values joined by the
  ' category's delimiter, and that same string is what the registry stores. Decoding it
  ' on restore is a plain split, which is correct only while this holds:
  '
  '     An option's value never contains its category's delimiter.
  '
  ' Every category is built to satisfy it, and the delimiters were chosen for that
  ' reason: Genres and OfficialRatings use "|" because their values are free text that
  ' may contain commas and spaces; Years uses "," because a year is digits; the language
  ' filters use "|" because ONE option's value is several ISO codes joined by ","
  ' (languageFilters.toWire converts that form to the comma-only one the server wants).
  '
  ' Break it and the failure is silent and specific: the query still applies, because
  ' joining is unaffected, but the restore pass splits a value apart and matches none of
  ' the pieces, so the filter is active with no box ticked, and one confirming keypress
  ' on that panel then clears it. queryValueFor() and checkedStateFor() are inverses, and
  ' are tested as a ROUND TRIP rather than individually, because each is self-consistently
  ' correct on its own while the pair silently disagrees.
  '
  ' Both accessors read through textOrEmpty() rather than toString(), which FAULTS on
  ' Invalid (it falls through to Str()), and a filter category's option list is exactly
  ' the kind of place a missing entry shows up. Both also trim, because Str() on a number
  ' returns a LEADING SPACE (`1999` -> `" 1999"`), which would never match the saved
  ' query. Both faults were found by the unit tests on device, not by review.

  ' optionTitle: what the user sees for one selectable option.
  function optionTitle(option as dynamic) as string
    if isFilterOptionPair(option) then return textOrEmpty(option.title).trim()
    return textOrEmpty(option).trim()
  end function

  ' optionValue: what the request carries for one selectable option.
  function optionValue(option as dynamic) as string
    if isFilterOptionPair(option) then return textOrEmpty(option.value).trim()
    return textOrEmpty(option).trim()
  end function

  ' Whether an option carries a separate label and value, rather than being its own.
  '
  ' A plain `and` would not do here: BrightScript does not short-circuit it, so a
  ' validity guard and a member access cannot share one condition.
  function isFilterOptionPair(option as dynamic) as boolean
    if not isValid(option) then return false
    return LCase(type(option)) = "roassociativearray"
  end function

  ' checkListValues: every option's query value, read off the filter panel's own nodes.
  '
  ' The VALUE of each option, never its title. They are the same text for Genres and
  ' Years; for a language filter the title is a localized name the server would match
  ' nothing against. Read off the CheckList's nodes, not the presenter's option list,
  ' because those nodes are what the CheckList's checkedState indexes into.
  '
  ' @param category - a filter category node whose children are FilterOptionNodes
  ' @return {object} array of strings, one per option, in panel order
  function checkListValues(category as dynamic) as object
    values = []
    if not isValid(category) then return values
    for i = 0 to category.getChildCount() - 1
      option = category.getChild(i)
      value = option.value
      ' A node whose value never got set falls back to its title, which is the correct
      ' answer for every category whose options are plain strings.
      if not isValidAndNotEmpty(value) then value = textOrEmpty(option.title)
      values.push(value)
    end for
    return values
  end function

  ' queryValueFor: the saved query for one category (its checked options' values, joined).
  '
  ' Takes VALUES rather than options because the caller (ItemGridOptions) reads them off
  ' the CheckList's own nodes via checkListValues(), not off the presenter's option list.
  '
  ' @param values - option query values in panel order
  ' @param checkedState - one boolean per option, panel order
  ' @param delimiter - the category's delimiter
  ' @return {string} "" when nothing is checked, which the caller reads as "no filter"
  function queryValueFor(values as dynamic, checkedState as dynamic, delimiter as string) as string
    if type(values) <> "roArray" or type(checkedState) <> "roArray" then return ""

    selected = []
    for i = 0 to values.count() - 1
      ' A checkedState shorter than the option list means the panel and the list have
      ' drifted; take only what both agree on rather than indexing off the end.
      if i >= checkedState.count() then exit for
      if isBooleanTrue(checkedState[i])
        value = textOrEmpty(values[i]).trim()
        if value <> "" then selected.push(value)
      end if
    end for

    return selected.join(delimiter)
  end function

  ' checkedStateFor: which of a category's options a saved query has selected.
  '
  ' The inverse of queryValueFor(), and the reason the pair has to be tested together:
  ' this is what re-ticks the boxes when the panel reopens, matching on the VALUE because
  ' that is what was saved: the registry holds the query the filter applied, not the
  ' labels it was picked by.
  '
  ' @param options - a category's `Options` list
  ' @param savedQuery - the stored query string for this category
  ' @param delimiter - the category's delimiter
  ' @return {object} one boolean per option, panel order
  function checkedStateFor(options as dynamic, savedQuery as dynamic, delimiter as string) as object
    checkedState = []
    if type(options) <> "roArray" then return checkedState

    ' An empty separator makes Split() return one entry PER CHARACTER, so a category that
    ' somehow declared none must fall back to "the whole string is one value".
    saved = textOrEmpty(savedQuery).trim()
    selected = []
    if saved <> ""
      if delimiter = ""
        selected = [saved]
      else
        selected = saved.split(delimiter)
      end if
    end if

    for each option in options
      value = LCase(gridQuery.optionValue(option))
      matched = false
      for each candidate in selected
        if value <> "" and value = LCase(textOrEmpty(candidate).trim()) then matched = true
      end for
      checkedState.push(matched)
    end for

    return checkedState
  end function

end namespace
