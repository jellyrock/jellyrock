<?xml version="1.0" encoding="utf-8"?>
<!--
  Mock SceneManager for testing
  
  This is a minimal mock that provides the same interface functions as SceneManager
  but doesn't require a real scene context. Used by integration tests that call
  user.Login() which invokes refreshThemeColors.
  
  Extends ContentNode so tests can add arbitrary fields if needed.
-->
<component name="MockSceneManager" extends="ContentNode">
  <interface>
    <function name="reloadHome" />
    <function name="refreshThemeColors" />
    <field id="reloadHomeRequested" type="boolean" alwaysNotify="true" />
    <function name="resetTime" />
    <function name="setBackgroundImage" />
    <function name="isDialogOpen" />
    <field id="currentUser" type="string" />
  </interface>
</component>
