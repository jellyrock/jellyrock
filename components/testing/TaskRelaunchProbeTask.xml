<?xml version="1.0" encoding="utf-8"?>
<!--
  TaskRelaunchProbeTask — the Task in tests/source/unit/platform/TaskRelaunch.spec.bs.

  Its function counts each time it starts and each time it returns, and holds the thread
  open until `release` is set (or a safety timeout), so the spec can act on a Task whose
  function is provably still executing.
-->
<component name="TaskRelaunchProbeTask" extends="Task">
  <interface>
    <field id="starts" type="integer" value="0" />
    <field id="ends" type="integer" value="0" />
    <field id="beats" type="integer" value="0" />
    <field id="release" type="bool" value="false" />
    <field id="blockMode" type="string" value="pollLoop" />
    <field id="blockMs" type="integer" value="5000" />
    <field id="seq" type="integer" value="0" />
    <field id="startSeq" type="integer" value="0" />
    <field id="endSeq" type="integer" value="0" />
    <!-- TaskStopProgress.spec.bs: `delivery` wakes a run parked in wakeOnDelivery, `parked` says it
         has reached its wait(), and `steps` counts the field writes it makes after that point. -->
    <field id="delivery" type="integer" value="0" />
    <field id="parked" type="bool" value="false" />
    <field id="steps" type="integer" value="0" />
  </interface>
</component>
