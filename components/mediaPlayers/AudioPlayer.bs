' bsc-disable-file auto-abandon-promises: one instance for the app's life on m.global, never destroyed, so no request outlives it
import "pkg:/source/api/ApiClient.bs"
import "pkg:/source/api/apiPool.bs"
import "pkg:/source/api/apiPromise.bs"
import "pkg:/source/enums/PauseReadBack.bs"
import "pkg:/source/roku_modules/log/LogMixin.brs"
import "pkg:/source/utils/audioSeek.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/playbackCheckIn.bs"

sub init()
  m.log = new log.Logger("AudioPlayer")
  m.isPlayReported = false
  ' The loaded stream's server session, until its end is reported:
  ' { id, itemId, position, isServerSeek }.
  m.openSession = invalid
  ' Position in the whole track at its last change, and when that was (for the end guard).
  m.lastPosition = invalid
  m.lastMoveMs = 0
  m.clock = CreateObject("roTimespan")

  ' End-of-track guard: Roku can leave a stream it started mid-file stuck in "playing" a moment
  ' before its end (audioSeek). This ends such a track, so the queue moves on as for a real end.
  m.endGuardTimer = CreateObject("roSGNode", "Timer")
  m.endGuardTimer.duration = audioSeek.STALL_SECONDS
  m.endGuardTimer.repeat = false
  m.endGuardTimer.observeField("fire", "onEndGuardFire")

  ' Reports go out on state changes only, so a long track or a pause would leave the server with
  ' none for minutes, and it ends such a session (playbackCheckIn.bs). This reports while a stream
  ' is open; each report restarts it.
  m.keepaliveTimer = CreateObject("roSGNode", "Timer")
  m.keepaliveTimer.duration = playbackCheckIn.KEEPALIVE_SECONDS
  m.keepaliveTimer.repeat = true
  m.keepaliveTimer.observeField("fire", "onKeepaliveDue")
  ' A moment after a pause report: read the session back, since the server can lose that report.
  m.pauseConfirmTimer = CreateObject("roSGNode", "Timer")
  m.pauseConfirmTimer.duration = playbackCheckIn.CONFIRM_DELAY_SECONDS
  m.pauseConfirmTimer.repeat = false
  m.pauseConfirmTimer.observeField("fire", "onPauseConfirmDue")
  m.pauseReportsSent = 0 ' pause reports for the current pause
  m.pauseReadBackSeq = 0 ' drops a read-back a newer pause replaced

  m.top.observeField("content", "onContentChanged")
  m.top.observeField("state", "audioStateChanged")
  m.top.observeField("position", "onPositionChanged")
end sub

' A new stream replaces the old one (audioSeek.streamHandover). For a new listen, the old
' stream's end is reported here when nothing reported it yet. A stream a seek loaded continues
' the listen instead: the old stream reports no stop and the new one no start, so the server
' counts one play, and a server stream it replaces has its server job ended directly, since
' that job otherwise runs until its session reports a stop.
sub onContentChanged()
  content = m.top.content
  isContinuingListen = false
  if isValid(m.openSession)
    handover = audioSeek.streamHandover(m.openSession.id, content)
    if handover = audioSeek.HANDOVER_END
      reportEnd()
    else if handover = audioSeek.HANDOVER_CONTINUE
      isContinuingListen = m.isPlayReported
      if m.openSession.isServerSeek then SubmitSideEffect(GetApi().BuildStopEncodingRequest(m.openSession.id))
    end if
  end if
  m.endGuardTimer.control = "stop"
  m.lastPosition = invalid
  m.lastMoveMs = m.clock.TotalMilliseconds()
  openSession()
  ' After openSession, which resets it: a continued listen already reported its start.
  m.isPlayReported = isContinuingListen
end sub

' State Change Event Handler
sub audioStateChanged()
  currentState = LCase(m.top.state)

  m.top.disableScreenSaver = (currentState = "playing")
  if currentState <> "playing"
    m.endGuardTimer.control = "stop"
  else
    ' Back to playing near the end (after a rebuffer, say): a stuck stream never moves its
    ' position again, so the countdown starts here rather than at the next position change.
    content = m.top.content
    if isValid(content) and audioSeek.isNearEnd(m.lastPosition, content.length)
      m.lastMoveMs = m.clock.TotalMilliseconds()
      m.endGuardTimer.control = "stop"
      m.endGuardTimer.control = "start"
    end if
  end if

  if currentState = "stopped" or currentState = "finished"
    m.keepaliveTimer.control = "stop"
    ' Only the stream that is loaded now: a replaced stream was reported when it was replaced.
    if isValid(m.openSession) and isValid(m.top.content) and m.openSession.id = m.top.content.id
      reportEnd()
    end if
    return
  end if

  ' A stream played again after its end (repeat one, play after the queue ended) is a new run.
  if currentState = "playing" and not isValid(m.openSession) then openSession()
  if not isValid(m.openSession) then return

  if currentState = "playing" and not m.isPlayReported
    m.isPlayReported = true
    sendReport("start", m.openSession)
  else
    sendReport("update", m.openSession)
  end if
  ' A full interval from this report.
  m.keepaliveTimer.control = "stop"
  m.keepaliveTimer.control = "start"
  if currentState = "paused"
    m.pauseReportsSent = 1
    m.pauseConfirmTimer.control = "stop"
    m.pauseConfirmTimer.control = "start"
  end if
end sub

' The keepalive: one more report for the open stream, playing or paused, once its start went out.
sub onKeepaliveDue()
  if not isValid(m.openSession) or not m.isPlayReported then return
  state = LCase(m.top.state)
  if state <> "playing" and state <> "paused" and state <> "buffering" then return
  sendReport("update", m.openSession)
end sub

' Reads this device's session back after a pause report, and reports the pause again if the server
' lost it (playbackCheckIn.bs).
sub onPauseConfirmDue()
  if LCase(m.top.state) <> "paused" or not isValid(m.openSession) then return
  req = playbackCheckIn.sessionRequest()
  if not isValid(req)
    m.log.warn("no request to read the session back; the keepalive reports the pause again")
    return
  end if
  m.pauseReadBackSeq += 1
  promises.chain(fetchAsync(req, "audioPauseReadBack-" + m.pauseReadBackSeq.toStr()), { seq: m.pauseReadBackSeq }).then(sub(res as object, ctx as object)
    onPauseReadBack(res, ctx.seq)
  end sub).catch(sub(err as object, _ctx as object)
    ' The keepalive reports the pause again within a minute. err whole: a timeout rejects with
    ' the pool's result, which has no `reason`.
    m.log.warn("pause read-back failed; the keepalive reports the pause again", err)
  end sub)
end sub

sub onPauseReadBack(res as object, seq as integer)
  ' A newer pause, a resume or the end of the stream since: this answer is about nothing current.
  if seq <> m.pauseReadBackSeq or LCase(m.top.state) <> "paused" or not isValid(m.openSession) then return
  action = playbackCheckIn.pauseReadBackAction(res, m.pauseReportsSent)
  if action = PauseReadBack.RESEND
    m.log.info("the server shows playing after a pause report; reporting the pause again", "reportsSent", m.pauseReportsSent)
    sendReport("update", m.openSession)
    m.pauseReportsSent += 1
    m.pauseConfirmTimer.control = "start"
  else if action = PauseReadBack.GIVE_UP
    m.log.warn("the server still shows playing; the keepalive will report the pause again", "reportsSent", m.pauseReportsSent)
  else if action = PauseReadBack.UNREADABLE
    m.log.warn("pause read-back could not judge the session; the keepalive reports the pause again", "cause", playbackCheckIn.unreadableCause(res))
  else
    m.log.debug("the server shows the pause", "reportsSent", m.pauseReportsSent)
  end if
end sub

sub onPositionChanged()
  content = m.top.content
  if not isValid(content) then return
  position = audioSeek.logicalPosition(content.startOffset, m.top.position)
  if not isValid(position) then return
  if isValid(m.openSession) then m.openSession.position = position

  ' Position can be set again with the same value; only a change counts as moving.
  if isValid(m.lastPosition) and position = m.lastPosition then return
  m.lastPosition = position
  m.lastMoveMs = m.clock.TotalMilliseconds()

  if LCase(m.top.state) = "playing" and audioSeek.isNearEnd(position, content.length)
    ' Restart the countdown: the guard fires only after a full stall with no movement.
    m.endGuardTimer.control = "stop"
    m.endGuardTimer.control = "start"
  end if
end sub

sub onEndGuardFire()
  content = m.top.content
  if not isValid(content) then return
  state = LCase(m.top.state)
  stalledSeconds = (m.clock.TotalMilliseconds() - m.lastMoveMs) / 1000.0
  if audioSeek.shouldForceEnd(state, m.lastPosition, content.length, stalledSeconds)
    forceEnd()
    return
  end if
  ' Fired early (a position change raced the countdown): keep watching while near the end.
  if state = "playing" and audioSeek.isNearEnd(m.lastPosition, content.length) then m.endGuardTimer.control = "start"
end sub

' Ends a stream Roku left stuck at its end, as a real end would: the stop is reported once,
' then "finished" goes to every state observer, so AudioPlayerView advances the queue.
sub forceEnd()
  m.log.warn("Track stuck at its end; ending it", m.lastPosition, m.top.content.length)
  reportEnd()
  m.top.control = "stop"
  m.top.state = "finished"
end sub

' Records the loaded stream as the session whose end is still to be reported.
sub openSession()
  m.isPlayReported = false
  content = m.top.content
  if not isValid(content) or not isValidAndNotEmpty(content.id)
    m.openSession = invalid
    return
  end if
  currentItem = m.global.queueManager.callFunc("getCurrentItem")
  itemId = ""
  if isValid(currentItem) and isValid(currentItem.id) then itemId = currentItem.id
  startOffset = 0.0
  if isValid(content.startOffset) then startOffset = content.startOffset
  m.openSession = { id: content.id, itemId: itemId, position: startOffset, isServerSeek: isBooleanTrue(content.isServerSeek) }
end sub

' Reports the open session's stop, once.
sub reportEnd()
  if not isValid(m.openSession) then return
  session = m.openSession
  m.openSession = invalid
  m.isPlayReported = false
  sendReport("stop", session)
end sub

' Report playback to server
sub sendReport(state as string, session as object)
  if session.itemId = "" then return

  params = {
    "ItemId": session.itemId,
    "PlaySessionId": session.id,
    "PositionTicks": int(session.position) * 10000000&, 'Ensure a LongInteger is used
    "IsPaused": (LCase(m.top.state) = "paused")
  }

  ' Report playstate via side-effect task
  req = GetApi().BuildPlaystateRequest(state, params)
  SubmitSideEffect(req)
end sub
