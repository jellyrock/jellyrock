<?xml version="1.0" encoding="utf-8"?>
<!-- JRListDialogRow: one option in a JRListDialog.

     It exists for one reason: to show which option is ALREADY the current one.
     Focus tells you where you are; it cannot tell you which track is playing
     once you have moved off it, and a picker whose whole job is changing a
     current value has to show that value.

     The check is a Poster tinted with blendColor, NOT Roku's RadioButtonList.
     RadioButtonList is the natural fit and was the first choice, but its
     checkedIconUri is a plain bitmap with no tint field, and this app's colours
     are user-set hex — so its mark would be the one thing on screen that could
     not follow the theme. Every other icon here is a white asset tinted from a
     theme constant (Toast, CommunityRating, FocusableOverview, JRTab); this
     follows that.

     The FOCUS indicator is still the list's own (focusBitmapUri), not drawn
     here — see source/utils/listTheme.bs. This component only adds content. -->
<component name="JRListDialogRow" extends="Group">
  <children>
    <!-- White source asset: blendColor MULTIPLIES, so a white glyph takes the
         tint exactly. check-black would stay black whatever colour we asked for. -->
    <Poster id="checkIcon" visible="false" />
    <LabelPrimaryMedium id="rowLabel" horizAlign="left" vertAlign="center" />
  </children>
  <interface>
    <!-- The MarkupList item-component contract (matches JRRowItem's). itemContent
         carries `title` plus the `isSelected` flag JRListDialog adds to it. -->
    <field id="itemContent" type="node" onChange="onItemContentChanged" />
    <field id="width" type="float" value="0" onChange="onSizeChanged" />
    <field id="height" type="float" value="0" onChange="onSizeChanged" />
  </interface>
</component>
