<?xml version="1.0" encoding="utf-8"?>
<!-- JRDialog: the standard JellyRock modal — dimmed backdrop, centred panel with
     title, accent rule, message, and a HORIZONTAL TextButton row INSIDE the panel
     (moved inside during the #757 review). Appended directly to the scene
     by the source/utils/dialogs.bs helpers; self-dismissing via removeChild +
     returnFocusTo. Result delivery is per-instance through the `result` field —
     observe it (observeFieldScoped from components, message port from main.bs).
     Covers alert (1 button), confirm (2 buttons), and choice (2-3 buttons) shapes;
     longer option sets belong in JRListDialog (the helpers route automatically).

     KEYS: left/right always step the row. up/down step it too, but ONLY when
     applyButtonLayout has stacked it vertically — a horizontal row swallows
     them under modal containment rather than moving focus along an axis the
     user cannot see. Either way a caller never has to know which layout the
     labels produced. -->
<component name="JRDialog" extends="JRGroup" focusable="true">
  <children>
    <!-- Dimmed backdrop, panel, edge, title and accent rule — shared with every
         other dialog. See JRDialogPanel.xml for the ordering contract. -->
    <JRDialogPanel id="chrome" />

    <!-- Optional bold lead line above the body, for a message that arrives in
         two parts (a sender-supplied heading + its text). Absent unless the
         `subheading` field is set, and then it takes no space at all. -->
    <LabelPrimaryMedium id="subheadingText" horizAlign="center" wrap="true" isBold="true" />

    <!-- Message body -->
    <LabelPrimaryMedium id="messageText" horizAlign="center" wrap="true" />

    <!-- Horizontal button row, flowed INSIDE the panel; stacks vertically when
         the labels are too wide to fit in a row (see applyButtonLayout). -->
    <LayoutGroup id="buttonRow" layoutDirection="horiz" itemSpacings="[24]" />

    <!-- Delays ONLY the opening announcement, so it lands after the platform's
         own focus announcement instead of being flushed by it. See
         OPENING_ANNOUNCEMENT_DELAY in JRDialog.bs. -->
    <Timer id="narrationTimer" repeat="false" />

  </children>
  <interface>
    <field id="title" type="string" onChange="onTitleChanged" />
    <field id="message" type="string" onChange="onMessageChanged" />
    <!-- Optional bold lead line rendered ABOVE the message. It is a lead-in to
         the body, not a second title: it sits inside the body's space, below the
         accent rule. Empty (the default) removes the slot entirely. -->
    <field id="subheading" type="string" onChange="onSubheadingChanged" />
    <!-- Array of button label strings, left to right. Design cap is 3 — the helpers
         route larger sets to JRListDialog; this component logs a warning beyond 3. -->
    <field id="buttons" type="array" onChange="onButtonsChanged" />
    <!-- Which button index counts as "confirmed" in the result (-1 = none; the
         confirm helper sets this so callers can read result.confirmed). -->
    <field id="confirmIndex" type="integer" value="-1" />
    <!-- Button focused when the dialog opens -->
    <field id="defaultButtonIndex" type="integer" value="0" />
    <!-- Set exactly once when the dialog resolves, then the dialog closes itself.
         Shape: { cancelled, confirmed, buttonIndex, buttonText, optionIndex, value } -->
    <field id="result" type="assocarray" alwaysNotify="true" />
    <!-- Node to restore remote focus to on close. Set by the dialogs.bs helper. -->
    <field id="returnFocusTo" type="node" />
    <!-- Cancel this dialog from OUTSIDE (source/utils/dialogs.bs cancelOpenDialog).
         A third party clearing the screen must look exactly like the user
         pressing Back, so this routes through the same resolve path. -->
    <function name="cancelDialog" />
    <!-- Called by presentOverlayDialog while the dialog is still hidden, to lay it
         out before it is shown. See source/utils/dialogReveal.bs. -->
    <function name="settleLayout" />
  </interface>
</component>
