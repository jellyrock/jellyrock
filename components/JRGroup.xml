<?xml version="1.0" encoding="utf-8"?>
<!--
  JRGroup is the common base for BOTH full-screen routed views (via JRScreen)
  and non-routed sub-panels / dialogs (for example ExtrasSlider, JRDialog,
  OverviewDialog, ProgramDetails).

  It extends sgrouter_View so JRScreen-derived screens are routable by
  sgRouter without per-screen changes and without duplicating the overhang
  field surface onto JRScreen (components/CLAUDE.md: "don't duplicate that
  field list anywhere else"). Non-routed sub-panels inherit the sgRouter view
  interface too, but it stays INERT for them: the router only drives the
  lifecycle of views it mounts in its outlet via navigateTo. It never drives
  dialogs (scene-appended overlays, or the modal m.scene.dialog) or child
  panels nested inside a screen.
-->
<component name="JRGroup" extends="sgrouter_View">
  <interface>
    <field id="lastFocus" type="node" />
    <field id="overhangTitle" type="string" />
    <!-- Dim text after the title, "" for none: a screen's state (the search screen's submitted
         query and count while its keyboard is closed). -->
    <field id="overhangStatus" type="string" />
    <field id="isOptionsAvailable" value="true" type="boolean" />
    <field id="isOverhangVisible" value="true" type="boolean" />
    <field id="overhangTabs" type="array" />
    <field id="selectedTabId" type="string" alwaysNotify="true" />
    <!-- Declarative overhang config: the JRScene overhang controller projects these onto the
         shared overhang atomically on view-change (see registerOverhangData), so the whole
         overhang updates in one frame. Screens DECLARE these (typically in init); they never
         poke the overhang node directly. Defaults give a bare overhang (detail/grid screens). -->
    <!-- Clock visibility. Defaults TRUE, unlike its neighbors: the clock is app-wide
         chrome a screen opts OUT of (SearchScreen's peek chip occupies the clock's corner),
         whereas the logo/icons/dropdown are opted IN. The user's Hide clock setting
         (uiDesignHideClock) is not declared here: JRScene's overhang controller applies it
         on top of this field for every screen. -->
    <field id="isClockVisible" type="boolean" value="true" />
    <field id="isLogoVisible" type="boolean" value="false" />
    <field id="shouldShowUserDropdown" type="boolean" value="false" />
    <!-- The named waits this screen has open (name -> { kind, startedMs }). Written only through
         screenWaits.begin / finish; JRScene shows them as the loading spinner while this is the
         active routed view, the same way it projects the overhang fields above. -->
    <field id="loadingWaits" type="assocarray" />
  </interface>
</component>