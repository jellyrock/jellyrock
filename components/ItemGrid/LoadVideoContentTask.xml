<?xml version="1.0" encoding="utf-8"?>

<component name="LoadVideoContentTask" extends="Task">
  <interface>
    <field id="itemId" type="string" />
    <field id="selectedAudioStreamIndex" type="integer" value="0" />
    <!-- MediaSource ID for video source selection. Empty string = auto-detect best source.
         Set when user explicitly selects a video source from OSD or ItemDetails. -->
    <field id="mediaSourceId" type="string" value="" />
    <field id="selectedSubtitleIndex" type="integer" value="-2" />
    <field id="isIntro" type="boolean" />
    <field id="startIndex" type="integer" value="0" />
    <field id="itemType" type="string" value="" />
    <field id="metadata" type="assocarray" />
    <field id="sortField" type="string" value="SortName" />
    <field id="sortAscending" type="boolean" value="true" />
    <field id="nameStartsWith" type="string" value="" />
    <field id="isRecursive" type="boolean" value="true" />
    <field id="filter" type="string" value="All" />
    <field id="searchTerm" type="string" value="" />
    <field id="studioIds" type="string" value="" />
    <field id="genreIds" type="string" value="" />
    <field id="view" type="string" value="" />
    <!-- Total records available from server-->
    <field id="totalRecordCount" type="int" value="-1" />
    <field id="content" type="array" />
    <!-- When true, skips the DoVi container profile injection in ItemPostPlaybackInfo,
         allowing the server to re-evaluate direct play without DoVi preservation constraints. -->
    <field id="shouldBypassDoviPreservation" type="boolean" value="false" />
    <!-- When true, forces the transcode path and disables direct play for this load.
         Set by VideoPlayerView when retrying after a direct-play failure (VideoLevelNotSupported
         or live-stream direct-play error) so the server returns a transcoding URL instead. -->
    <field id="shouldForceTranscoding" type="boolean" value="false" />
    <!-- User-facing error message set by the task on failure. Read by VideoPlayerView in
         onVideoContentLoaded() to show a specific error dialog instead of the generic fallback. -->
    <field id="errorMsg" type="string" value="" />
  </interface>
</component>