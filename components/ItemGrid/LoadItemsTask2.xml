<?xml version="1.0" encoding="utf-8"?>

<component name="LoadItemsTask2" extends="Task">
  <interface>
    <field id="itemId" type="string" />
    <field id="startIndex" type="integer" value="0" />
    <field id="itemType" type="string" value="" />
    <field id="limit" type="integer" value="100" />
    <field id="metadata" type="assocarray" />
    <field id="sortField" type="string" value="SortName" />
    <field id="sortAscending" type="boolean" value="true" />
    <field id="nameStartsWith" type="string" value="" />
    <field id="isRecursive" type="boolean" value="true" />
    <field id="filter" type="string" value="All" />
    <field id="filterOptions" type="assocarray" value="" />
    <field id="searchTerm" type="string" value="" />
    <field id="studioIds" type="string" value="" />
    <field id="genreIds" type="string" value="" />
    <field id="view" type="string" value="" />
    <field id="additionalFields" type="string" value="" />
    <!-- Total records available from server-->
    <field id="totalRecordCount" type="int" value="-1" />
    <field id="content" type="array" />
    <!--
      Early structure for the Genres view: `[{ id, title }, ...]` in server order, written
      as soon as the genre list is known and before any sample has been fetched. The view
      draws skeleton rows from it; `content` still delivers the real rows exactly as it
      does for every other view.

      STRINGS, not nodes, on purpose. A task-thread write to a render-thread-owned node is
      a rendezvous priced by payload size, so the row nodes are built on the render thread
      from these ids and titles rather than shipped across.
    -->
    <field id="genreSkeletons" type="array" />
  </interface>
</component>