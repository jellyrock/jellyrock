<?xml version="1.0" encoding="utf-8"?>
<!--
  LibraryHeaderStrip: the row under the overhang on a library screen.

  Left: the focused item's title and one metadata line. Right: what narrows the tab
  (voice text or a letter), the item count, and the Sort and Filter chips. It only
  draws: BaseGridView feeds it and acts on chipAction. Sizes and the layout rule are in
  source/utils/headerStrip.bs.
-->
<component name="LibraryHeaderStrip" extends="Group">
  <children>
    <LabelPrimaryMedium id="title" isBold="true" vertAlign="center" />
    <!-- The metadata line: items with a bullet between them, built as the details screen
         builds its info rows (9 pixels each side of a bullet) -->
    <LayoutGroup id="metadata" layoutDirection="horiz" vertAlignment="top" />
    <LabelSecondarySmall id="narrowedBy" vertAlign="center" />
    <LabelSecondarySmall id="count" vertAlign="center" />
    <TextButton id="sortChip" visible="false" />
    <TextButton id="filterChip" visible="false" />
  </children>
  <interface>
    <!-- { title, metadata: [items], narrowedBy, count }: one write, so one layout pass -->
    <field id="content" type="assocarray" onChange="onContentChanged" />
    <!-- { sortLabel, filterLabel, isSortShown, isFilterShown } -->
    <field id="chips" type="assocarray" onChange="onChipsChanged" />
    <!-- OK on a chip: "sort" or "filter" -->
    <field id="chipAction" type="string" alwaysNotify="true" />
    <!-- Focus the chip used last, else the first shown. False when no chip shows. -->
    <function name="focusEntry" />
  </interface>
</component>
