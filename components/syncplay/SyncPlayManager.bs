' bsc-disable-file auto-abandon-promises: one instance for the app's life on m.global, never destroyed, so no request outlives it
import "pkg:/source/api/ApiClient.bs"
import "pkg:/source/api/apiPool.bs"
import "pkg:/source/api/apiPromise.bs"
import "pkg:/source/api/baseRequest.bs"
import "pkg:/source/logging/Logger.bs"
import "pkg:/source/syncplay/syncPlayConverge.bs"
import "pkg:/source/syncplay/syncPlayGroup.bs"
import "pkg:/source/syncplay/syncPlayMessage.bs"
import "pkg:/source/syncplay/syncPlayOffset.bs"
import "pkg:/source/syncplay/syncPlayPlayback.bs"
import "pkg:/source/syncplay/syncPlayPlayer.bs"
import "pkg:/source/syncplay/syncPlayQueue.bs"
import "pkg:/source/syncplay/syncPlayRequests.bs"
import "pkg:/source/syncplay/syncPlayShadow.bs"
import "pkg:/source/syncplay/syncPlayState.bs"
import "pkg:/source/syncplay/syncPlayTime.bs"
import "pkg:/source/utils/appWaits.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/nodeHelpers.bs"
import "pkg:/source/utils/queueRepeat.bs"
import "pkg:/source/utils/tasks.bs"
import "pkg:/source/utils/voiceTransport.bs"

' Rounds in the burst a join starts (the spike's "best of eight") and in each later one; when the
' next burst runs is syncPlayOffset.nextBurstSeconds.
const FIRST_SYNC_ROUNDS = 8
const SYNC_ROUNDS = 3
' The user-scoped registry key that remembers a membership across a launch: "groupId|groupName".
' A Home exit ends the app without a Leave, and on HTTPS the session outlives it
' (decision `syncplay-stale-membership-at-launch`).
const STALE_GROUP_KEY = "syncPlayGroup"
' Which engine decides a member's playback while it follows: true, the comparison
' (syncPlayConverge), with this file carrying out the one action it asks for; false, this file's
' own command, tracker and correction code. The node's `engine` field picks for one run or one
' spec. The manager's own engine is kept only as the control for the comparison's soak, and is
' deleted before this reaches `main`.
const DECIDE_BY_COMPARISON = true
' The most actions one event may lead to before the comparison is taken as not settling.
const CONVERGE_ROUNDS = 12

sub init()
  m.log = new log.Logger("SyncPlayManager")
  m.commandTimer = m.top.findNode("commandTimer")
  m.commandTimer.observeField("fire", "onCommandTimer")
  m.syncTimer = m.top.findNode("syncTimer")
  m.syncTimer.observeField("fire", "onSyncTimer")
  m.readyTimer = m.top.findNode("readyTimer")
  m.readyTimer.observeField("fire", "onReadyTimer")
  m.pauseTimer = m.top.findNode("pauseTimer")
  m.pauseTimer.observeField("fire", "onPauseTimer")
  m.correctionTimer = m.top.findNode("correctionTimer")
  m.correctionTimer.observeField("fire", "onCorrectionTimer")
  m.convergeTimer = m.top.findNode("convergeTimer")
  m.convergeTimer.observeField("fire", "onConvergeTimer")
  ' The working state is built on first use, not here. setGlobalNodes() creates this node from the main
  ' thread, so init() runs there, and the AAs it leaves in `m` reach the render thread (where
  ' every handler below runs) without their LongInteger and `invalid` entries: measured on the
  ' Stick 4K 2026-10-23, a 12-key state read back with 8 keys at the first handler, the
  ' estimator with 2 of 4. The first handler builds it instead (ensureReady). The published
  ' fields get their defaults here: a field write marshals whole.
  m.state = invalid
  m.top.setFields({
    inGroup: false,
    following: false,
    groupId: "",
    groupName: "",
    groupState: "",
    sync: { offsetMs: 0&, delayMs: 0&, hasEstimate: false, lastCommand: invalid, trackerPhase: "idle", playingItemId: "" }
  })
end sub

' Build the working state on the thread that uses it, once.
sub ensureReady()
  if isValid(m.state) then return
  m.state = syncPlayState.newState()
  m.estimator = syncPlayOffset.newEstimator()
  m.tracker = syncPlayPlayback.newReadyTracker()
  ' A command that arrived before the first clock estimate; applied when it lands (web's queuedCommand).
  m.heldCommand = invalid
  ' The last command accepted, for the start position of a new playlist.
  m.lastCommand = invalid
  ' The plan commandTimer applies when it fires.
  m.pendingPlan = invalid
  ' A remount this manager asked for, or a Stop it applied: the unmount that follows is not a halt.
  m.expectingRemount = false
  m.timeSyncTask = invalid
  ' Bursts in a row that ended with no estimate (syncPlayOffset.nextBurstSeconds).
  m.failedBursts = 0
  ' What the player last told us.
  m.playerState = ""
  m.playerPositionTicks = 0&
  ' Where the node is known to be while it plays, and where its last pause stopped it
  ' (syncPlayPlayback.newPausePosition): the node's position moves only on a notification, so the
  ' next Unpause reads the pause's estimate in its seek check and its resume time.
  m.pausePosition = syncPlayPlayback.newPausePosition()
  ' Where the load now starting was asked to start (ticks), for the tracker's first Ready.
  m.loadStartTicks = 0&
  ' The group is paused: a Pause or Seek was applied and no Unpause or Stop since. While it holds
  ' and the node plays on, the manager pauses it again (syncPlayPlayback.owesPause).
  m.groupPaused = false
  ' Pause writes made for the current group command, and whether the give-up warning went out.
  m.pauseAttempts = 0
  m.pauseGaveUp = false
  ' The load a PlayQueue frame owes the player (syncPlayQueue.owedLoadAfter), kept until performed.
  m.owedLoad = invalid
  ' The playback start a press opened when its play was handed to the group (claimPlay). The
  ' claim lasts exactly as long as that start (hasOpenClaim): the group's answer takes it over,
  ' a refusal, a leave or a halt ends it, and Back, its time limit or a newer press end it with
  ' nothing to clear here.
  m.claimedStart = invalid
  ' A halted member's play, built and held until the viewer confirms it (confirmPlay) or not
  ' (cancelPlay): { request, action, start, title, moreCount, queueItems, position }, the title the
  ' dialog names, the videos that follow it in the queue and the pressed queue. It replaces what
  ' the whole group is watching, and a remote makes an accidental play easy. Not a claim until
  ' confirmed: the group's frames meanwhile are read as for any halted member. Any other end (its
  ' start ending, a newer press, the group's new playlist, a leave, a refusal) fails its start and
  ' clears playHeld, which closes the dialog.
  m.heldClaim = invalid
  ' The item ids a catch-up added right after the group's video (catchUp), until the group's
  ' QueueNext update shows it took them (syncPlayQueue.queuedNextCount) and the viewer is told.
  ' A new playlist, a halt or a leave drops them untold.
  m.queuedNext = invalid
  ' A halted member's claim followed the group again at the press, so the group would wait on
  ' it. That follow holds only until the group's load answers it (endUnansweredRefollow).
  m.claimRefollowed = false
  ' The name of the group a Leave at launch is ending (leaveStaleMembership), so the GroupLeft
  ' that answers it can say which, since the membership is not in memory.
  m.staleGroupName = ""
  ' Whether no command has arrived since the join: the queue frame that comes first answers the
  ' join, and its load says nothing past Joined (syncPlayQueue.noticeForQueueFrame).
  m.joinAwaitsQueue = false
  ' What the owed load tells the viewer when it runs, decided as its queue frame arrived
  ' (syncPlayQueue.noticeForQueueFrame); invalid when no frame decided one.
  m.loadNotice = invalid
  ' Whether the follow under way is a Resume with Group the viewer chose, so a load that fails
  ' before it runs says so (haltFollowing); false once the load runs.
  m.resumeAsked = false
  ' The correction each Unpause arms (syncPlayPlayback.settleCorrectionDue), and the drift last
  ' read from a position notification, for the RTA specs. A halt or a leave leaves the check as
  ' it is: it fires only with the tracker at `ready`, which only a load reaches (a mount or a
  ' reload), and each disarms it first (startStreamTracking); a group Pause or Seek holds it until
  ' the next Unpause arms it again.
  m.settle = syncPlayPlayback.newSettleCheck()
  m.playbackDiffMs = invalid
  ' Whether this member reported Buffering since the group's last command it scheduled
  ' (syncPlayPlayback.clockReference).
  m.reportedBuffering = false
  ' Where the server paused the group for that Buffering (syncPlayPlayback.groupPauseAnchorTicks),
  ' from its Waiting state update; invalid until it arrives, and after the next command.
  m.groupPausedTicks = invalid
  ' The device clock and the position when that Buffering went out, for the anchor's log line.
  m.bufferingSentAtMs = 0&
  m.bufferingReportedTicks = 0&
  ' The Ready this member last sent: { whenMs, positionTicks, isPlaying }, or invalid. A wait this
  ' member ends while playing gets no command back (syncPlayPlayback.reconstructedUnpause).
  m.lastReady = invalid
  ' When the last seek went out and how long the tracker took to end it, for the next
  ' correction's lead (syncPlayPlayback.correctionLeadMs). 0 until one has ended on this player.
  m.seekWrittenAtMs = 0&
  m.lastSeekMs = 0&
  ' Whether the tracker gave the last seek on this node up (trackPlayerEvent's seekGaveUp), which
  ' tells the next correction not to seek.
  m.lastSeekGaveUp = false
  ' The playing item's length in the Video node's seconds; 0 while unknown.
  m.playerDurationSeconds = 0
  ' The correction under way (syncPlayPlayback.correctionPlan): the node pauses ahead of the
  ' group, after a seek when it was behind, and correctionTimer resumes it as the group arrives.
  ' Any group command or a pause the viewer presses replaces it.
  m.correction = invalid
  ' Whether a correction wrote a pause that nothing has resumed or replaced yet, so one that ends
  ' before the node reports `paused` still gets its resume (syncPlayPlayback.owesCorrectionResume).
  m.correctionPauseOwed = false
  ' Whether this member already made the group wait on it (checkSettle's Seek to its own position)
  ' since the last group Pause: once per pause chain, or a member that keeps falling behind would
  ' rewind the group every few seconds.
  m.waitedOnMe = false
  ' Whether a load this member performed for a queue frame has not yet reported its Ready: a second
  ' step of the same item meets it still loading (syncPlayQueue.restartAbsorbed). Ended by that
  ' Ready, a halt, a leave, or the player leaving.
  m.loadAwaitsReady = false
  ' How many times this member performed the load a queue frame owed (applyQueue), published so
  ' a spec can tell one restart of the group's item from two.
  m.loadCount = 0
  ' How many drift corrections ran to their resume (onCorrectionTimer), published so a spec can
  ' wait for the one a time offset pick started, not for a drift reading that may predate it.
  m.correctionsDone = 0
  ' For the specs: the shift the last Unpause applied with, and how often a waiting one's changed.
  m.resumeShiftMs = invalid
  m.resumeShiftChanges = 0
  ' How many Seek commands the group sent while this member followed (scheduleCommand), published so a
  ' spec can tell a load the server accepted from one it had to correct with a Seek.
  m.groupSeeks = 0
  ' How many Ready reports this member sent (report), published so a spec can wait for the server to
  ' have a load's Ready rather than for a group command that can come before it.
  m.readiesSent = 0
  ' Times the viewer was told the group cannot be reached, for the specs: a soak step that tells
  ' them with no outage has found a request whose result was lost.
  m.unreachableNotices = 0
  ' How long the last pause took to stop the node, for the specs (shadowPlayerFact).
  m.pauseLandedMs = 0&
  ' The player and group models of the convergence rewrite. They decide when the comparison is
  ' the engine (usesComparison), and are fed beside this code in an RTA build, as a shadow whose
  ' disagreements are logged (shadowAfter). Any other build with the old engine has none.
  m.shadow = invalid
  #if ENABLE_RTA
    m.shadow = syncPlayShadow.newShadow()
  #end if
  if (DECIDE_BY_COMPARISON or m.top.engine = "comparison") and not isValid(m.shadow) then m.shadow = syncPlayShadow.newShadow()
  ' The comparison's loop is running (converge), and an event came in while it was.
  m.converging = false
  m.convergeAgain = false
  ' Numbers each request the comparison sends, for its promise's id.
  m.requestCount = 0
  ' How many corrections of this member's own the comparison saw through (a catch-up, with the
  ' hold after it when it needed one, or a hold alone), for the specs (as correctionsDone), and
  ' whether one was under way when the comparison last settled.
  m.correctionsEnded = 0
  m.wasCorrecting = false
  publish()
end sub

' --- the interface ---

function join(groupId as string) as boolean
  ensureReady()
  if not isValidAndNotEmpty(groupId) then return false
  m.log.info("joining group", "groupId", groupId)
  return post("Join", syncPlayRequests.join(groupId))
end function

' Create a group and join it: the server answers with GroupJoined. JRScene names it as
' jellyfin-web does, "{0}'s group" (a custom name is a phase F addition).
function newGroup(groupName as string) as boolean
  ensureReady()
  if not isValidAndNotEmpty(groupName) then return false
  m.log.info("creating group")
  return post("New", syncPlayRequests.newGroup(groupName))
end function

function leave() as boolean
  ensureReady()
  if not m.state.inGroup then return false
  m.log.info("leaving group", "groupId", m.state.groupId)
  return post("Leave", invalid)
end function

' Sign-out and server switch. The server ends a membership only with its session, and an HTTPS
' session outlives the app's long poll, so the group is left explicitly.
function reset() as boolean
  m.log.info("reset")
  ensureReady()
  if m.state.inGroup then post("Leave", invalid, true)
  unsetUserSetting(STALE_GROUP_KEY)
  leaveLocally()
  return true
end function

' Ends the membership a Home exit left behind (decision `syncplay-stale-membership-at-launch`, the
' app half): the registry remembers the group of the last session, and nothing in memory does.
' Called once per launch from Home's first run, after the receiver is up so the server's GroupLeft
' can reach the viewer as a toast naming the group. Answers true when a Leave was posted. On HTTP
' the socket drop ended the membership already and the server answers NotInGroup, which says
' nothing; the plugin's reaper does the same for a long-poll session that went stale.
function leaveStaleMembership() as boolean
  ensureReady()
  if m.state.inGroup then return false
  stale = getUserSetting(STALE_GROUP_KEY)
  if not isValidAndNotEmpty(stale) then return false
  unsetUserSetting(STALE_GROUP_KEY)
  ' Split at the first bar only: the id (a GUID) has none, and the name may.
  bar = stale.instr("|")
  if bar >= 0 then m.staleGroupName = stale.mid(bar + 1)
  m.log.info("leaving the group of the last session", "group", stale)
  return post("Leave", invalid)
end function

' @returns an AA with `following`: whether the caller should defer to the group (a `finished` the host
'   must not advance on)
function playerEvent(evt as object) as object
  ensureReady()
  if not isValid(evt) or not syncPlayTime.isText(evt.kind) then return { following: isFollowing() }
  if usesComparison() then return comparePlayerEvent(evt)
  ' First, and nothing else: the player sends this from inside the manager's own handlers (a
  ' verb the manager gave it wrote the pause), so it only records the write and never runs the
  ' checks below, which can halt following.
  if evt.kind = "pauseWritten"
    notePauseWritten()
    shadowPlayerFact(evt)
    return { following: isFollowing() }
  end if
  refreshExtraOffset()
  endUnansweredRefollow()
  shadowPlayerFact(evt)
  kind = evt.kind
  if isValid(evt.position) then m.playerPositionTicks = syncPlayPlayback.secondsToTicks(evt.position)
  if isValid(evt.duration) then m.playerDurationSeconds = evt.duration
  if kind = "state" and syncPlayTime.isText(evt.state) then m.playerState = evt.state

  if kind = "mounted"
    m.expectingRemount = false
    m.playerState = ""
    m.groupPaused = false
    m.waitedOnMe = false
    startStreamTracking()
    if isFollowing()
      ' Only the group's item answers to the group. Anything else the viewer started plays
      ' as their own, so this member halts rather than report a load the group never asked for.
      if syncPlayQueue.isGroupItem(m.global.queueManager.callFunc("getCurrentItem"), m.state.playingItemId)
        ' A new player has reported no position yet. The old player's last one would go out in
        ' this mount's Buffering and feed applyPlan's seek check, so start from the load's start.
        m.playerPositionTicks = m.loadStartTicks
        track({ kind: "mounted", startTicks: m.loadStartTicks })
      else
        haltFollowing("a player mounted for an item the group is not playing")
      end if
    end if
  else if kind = "reloaded"
    if isFollowing()
      ' The player loads its stream again in place (a track, quality or version change, a retry). Its
      ' node reads 0 until the reloaded stream's first frame, and its last reading lags the group's
      ' clock (by more than the server's half second after a stream that failed), so this member
      ' reports where the group paused for its Buffering: the group's own position, the reload's start
      ' when no group clock is in force. The tracker puts it in the Ready when the node reads more than
      ' half a second below it, as at a late join, which a node still reading 0 at its first frame
      ' always does; a node already that close reports its own. A gap left between the node and the
      ' group is the drift correction's, after the Unpause, as at a mount. Unlike a mount, the group's
      ' state stays: a group paused when the reload began is still paused.
      groupTicks = groupPositionNow()
      playerTicks& = syncPlayPlayback.secondsToTicks(evt.startSeconds)
      startTicks& = playerTicks&
      if isValid(groupTicks) then startTicks& = syncPlayTime.asLong(groupTicks)
      ' Ticks as text: roku-log renders a LongInteger as an empty string.
      groupText = "none"
      if isValid(groupTicks) then groupText = syncPlayTime.asLong(groupTicks).toStr()
      lastCommandKind = ""
      if isValid(m.lastCommand) then lastCommandKind = m.lastCommand.command
      m.log.info("reload in place reported to the group", "groupTicks", groupText, "playerTicks", playerTicks&.toStr(), "lastCommand", lastCommandKind, "reportedBuffering", m.reportedBuffering)
      m.playerPositionTicks = startTicks&
      startStreamTracking()
      track({ kind: "reloaded", startTicks: startTicks& })
    end if
  else if kind = "state"
    if isFollowing()
      syncPlayPlayback.notePauseState(m.pausePosition, m.playerState, syncPlayTime.nowMs())
      syncResumeShift()
      track({ kind: "state", state: m.playerState, positionTicks: m.playerPositionTicks })
      ' Never written from here: the node passes through `buffering` for milliseconds on its own
      ' pause, and the timer lets that settle.
      if syncPlayPlayback.owesPause(m.groupPaused, m.playerState, m.tracker.phase) then armPauseTimer()
      ' The correction's timer owns the pause from here.
      if isValid(m.correction) and m.playerState = "paused" then m.correctionPauseOwed = false
      if isValid(m.correction) and m.playerState = "paused" and m.tracker.phase = "ready" then scheduleCorrectionResume()
      ' A correction that ended before its pause landed (the watchdog, or an Unpause) left the
      ' node paused while the group plays.
      if syncPlayPlayback.owesCorrectionResume(m.correctionPauseOwed, isValid(m.correction), m.groupPaused, m.playerState)
        host = playerHost()
        if isValid(host) then tellPlayer(host, { command: "resume" }, "hold")
        m.log.info("drift correction's pause resumed after the correction ended", "positionTicks", m.playerPositionTicks.toStr())
        m.correctionPauseOwed = false
      end if
    end if
  else if kind = "localSeek"
    dropPausedEstimate()
    ' The fallback wrote a seek of its own (VideoPlayerView.onGroupSeekOverdue): the tracker must
    ' know it, or a group Seek that comes next would run beside it. Only a stall the server was
    ' told about is owed a Ready at the landing. A load or an idle tracker is left alone, since a seek
    ' event there would take a load out of its first-frame pause and Ready.
    if isFollowing() and m.tracker.phase <> "loading" and m.tracker.phase <> "idle"
      track({ kind: "seek", positionTicks: m.playerPositionTicks, report: m.tracker.phase = "rebuffering", thenPause: false })
      ' A scrub whose Seek was lost leaves this member behind the group, and a correction only catches it up if the check is armed.
      syncPlayPlayback.armSettleCheck(m.settle)
    end if
  else if kind = "position"
    if isFollowing()
      if m.playerState = "playing" and m.tracker.phase = "ready" then syncPlayPlayback.notePausePosition(m.pausePosition, m.playerPositionTicks, syncPlayTime.nowMs())
      track({ kind: "position", positionTicks: m.playerPositionTicks })
      checkSettle()
    end if
  else if kind = "finished"
    if isFollowing()
      ' The group moves on together: ask the server, which answers every member with a
      ' PlayQueue(NextItem) that remounts. On the playlist's last item it answers nothing, so
      ' this member leaves the route as for any finished queue.
      post("NextItem", syncPlayRequests.nextItem(m.state.playingItemId))
      shadowAsked("next", invalid, false)
      host = playerHost()
      if syncPlayQueue.isLastItem(m.state) and isValid(host)
        m.expectingRemount = true
        shadowWriteBegin({ command: "stop" }, "group")
        host.callFunc("exitPlayback")
        shadowWriteEnd()
      end if
    end if
  else if kind = "unmounted"
    m.playerState = ""
    resetPlaybackTracking()
    track({ kind: "unmounted" })
    if m.expectingRemount
      m.expectingRemount = false
    else if isFollowing()
      ' Back during group playback, or an error that left the player.
      haltFollowing("the player left while following")
    end if
  end if
  shadowAfter()
  return { following: isFollowing() }
end function

' This member stops following but stays in the group, and tells the server not to wait on it (a
' server before 12.1 has no group-wait timeout). Resuming is phase E.
' @param tell - whether the viewer is told; false when what they did already says it
sub haltFollowing(reason as string, tell = true as boolean)
  m.log.info("halting", "reason", reason, "groupId", m.state.groupId)
  ' A resume the viewer chose from the menu that never loaded says so. The quiet rule below is
  ' for a follow they were never told of.
  if tell and m.resumeAsked and isFollowing()
    notify("resumeFailed", m.state.groupName, "")
    tell = false
  end if
  m.resumeAsked = false
  ' A follow the viewer was never told of (its load had not run) ends as quietly as it began.
  if syncPlayTime.isText(m.loadNotice) and m.loadNotice = "followingAgain" then tell = false
  if tell and isFollowing() then notify("halted", m.state.groupName, "")
  syncPlayState.halt(m.state)
  m.loadAwaitsReady = false
  m.owedLoad = invalid
  m.loadNotice = invalid
  releaseCorrection()
  resetPlaybackTracking()
  m.tracker = syncPlayPlayback.newReadyTracker()
  dropClaimedPlay("stopped following")
  m.queuedNext = invalid
  post("SetIgnoreWait", syncPlayRequests.setIgnoreWait(true))
  releaseGroupRepeat()
  ' A node the comparison held for the group has no one left to resume it.
  if usesComparison() then converge()
  publish()
end sub

' A play QueueManager.playQueue is about to launch, while in a group: hand it to the group
' (syncPlayQueue.handoff) and answer true, so no local player starts; the group's PlayQueue
' frame then loads it for every member, this one included. False when outside a group, when
' the queue is the manager's own group load (its current item carries the group's playing
' playlist id: syncPlayQueue.isGroupItem), when the queue holds something the player could
' not follow, or when nothing could be posted: those play locally. A halted member's own play
' follows the group again first: locally, so the answer applies (syncPlayQueue.appliesFetchedQueue),
' and on the wire, so the group waits on it (a new queue marks every member buffering, but the
' server's wait skips a member still ignoring it). It halts again if the group never loads the
' play (endUnansweredRefollow). A play of the video the group is playing goes to no one: it
' catches this member up instead (catchUp).
' @param start - the playback start the press opened (QueueManager.beginPlaybackStart), which
'   the claim lives as long as; invalid when none is pending
function claimPlay(start = invalid as dynamic) as boolean
  ensureReady()
  if not m.state.inGroup then return false
  queueManager = m.global.queueManager
  queueItems = queueManager.callFunc("getQueue")
  position = queueManager.callFunc("getPosition")
  if type(queueItems) <> "roArray" or position < 0 or position >= queueItems.count() then return false
  if syncPlayQueue.isGroupItem(queueItems[position], m.state.playingItemId) then return false
  return claimItems(queueItems, position, start)
end function

' claimPlay's decision for a queue given directly, so castToGroup can hand the group a cast without
' replacing the local queue first. True when the group takes the play (posted, held for a
' confirm, or caught up to), false when it plays locally or nothing could be posted.
' @param start - the playback start the play opened, or invalid
function claimItems(queueItems as object, position as integer, start as dynamic) as boolean
  if not m.state.inGroup then return false
  handoff = syncPlayQueue.handoff(queueItems, position, m.state)
  if not isValid(handoff) then return false
  if handoff.action = "setPlaylistItem"
    req = syncPlayRequest("SetPlaylistItem", syncPlayRequests.setPlaylistItem(handoff.playlistItemId))
  else
    req = syncPlayRequest("SetNewQueue", syncPlayRequests.setNewQueue(handoff.itemIds, handoff.position, handoff.startPositionTicks))
  end if
  if not isValid(req) then return false
  ' Every launcher reaches here, so the rule is the same for a press, a quick play, a deep link
  ' and a cast. The server answers SetPlaylistItem for the playing entry by starting the video
  ' over for every member, and nobody asked for that. The rest of the queue is added after it.
  if syncPlayQueue.isGroupsPlayingItem(queueItems[position], m.state, m.lastCommand)
    catchUp(start, syncPlayQueue.queueNextIds(queueItems, position, m.state))
    return true
  end if
  ' Built before anything is sent, so a play that will run locally re-follows nothing. A halted
  ' member's play is held for the viewer's confirmation first: the start stays open under the
  ' dialog, and the hold ends with it.
  if not isFollowing()
    releaseHeldPlay("replaced by a newer play")
    title = voiceTransport.formatNowPlayingTitle(queueItems[position])
    moreCount = 0
    if handoff.action = "setNewQueue" then moreCount = handoff.itemIds.count() - 1 - handoff.position
    m.heldClaim = { request: req, action: handoff.action, start: start, title: title, moreCount: moreCount, queueItems: queueItems, position: position }
    ' A field observer, not promises.onFinally: that runs on a later timer, through state kept on
    ' this node. Never unobserved: the start is short-lived, and an unobserve can drop the
    ' observers QueueManager and AppWaitHost keep on it (#898).
    if isValid(start) then start.observeField("promiseState", "onHeldStartEnded")
    ' Nothing loads while the viewer reads the question: the screen shows behind the dialog and
    ' the spinner waits for the answer (confirmPlay resumes it). Back still cancels the start.
    appWaits.pause(start)
    publish()
    m.top.notice = { kind: "confirmPlay", groupName: m.state.groupName, userName: "", title: title, moreCount: moreCount }
    return true
  end if
  m.claimedStart = start
  sendClaim(req, handoff.action)
  return true
end function

' The held play reaches the group: the viewer confirmed it. From here it is a claim like a
' following member's, on the start the press opened. The member follows again first, so the
' group waits on it. If the group has moved to the held video meanwhile, the play catches up
' instead (catchUp), as at the press. True when a play was held.
function confirmPlay() as boolean
  held = m.heldClaim
  if not isValid(held) then return false
  m.heldClaim = invalid
  ' The start may have ended before onHeldStartEnded read it: a play with nothing to start goes
  ' nowhere.
  if isValid(held.start) and not appWaits.isOpen(held.start)
    publish()
    return false
  end if
  appWaits.resume(held.start)
  if syncPlayQueue.isGroupsPlayingItem(held.queueItems[held.position], m.state, m.lastCommand)
    catchUp(held.start, syncPlayQueue.queueNextIds(held.queueItems, held.position, m.state))
    return true
  end if
  m.claimedStart = held.start
  followAgain()
  m.claimRefollowed = true
  sendClaim(held.request, held.action)
  return true
end function

' The held play goes nowhere: the viewer kept the group's playback. The start the press opened
' ends, as for a refusal; the queue keeps the item and nothing plays. True when a play was held.
function cancelPlay() as boolean
  if not isValid(m.heldClaim) then return false
  releaseHeldPlay("the viewer kept the group's playback")
  return true
end function

' The held play ends unanswered: its start fails (nothing plays for it) and playHeld clears, so
' the scene closes the dialog asking about it.
sub releaseHeldPlay(reason as string)
  held = m.heldClaim
  if not isValid(held) then return
  ' Cleared first: failing the start runs onHeldStartEnded, which must find nothing held.
  m.heldClaim = invalid
  appWaits.fail(held.start, "the group did not play it (" + reason + ")")
  publish()
end sub

' The start under a held play ended on its own (its time limit, or a newer press replaced it):
' nothing is left to confirm. Only that hold: a newer one has a start of its own.
sub onHeldStartEnded(event as object)
  start = event.getRoSGNode()
  if appWaits.isOpen(start) then return
  held = m.heldClaim
  if not isValid(held) or not isValid(held.start) or not held.start.isSameNode(start) then return
  m.heldClaim = invalid
  publish()
end sub

sub sendClaim(req as object, action as string)
  SubmitSideEffect(req)
  m.log.info("play handed to the group", "action", action, "groupId", m.state.groupId)
  notify("playedToGroup", m.state.groupName, "")
end sub

' A halted member follows the group again: its own play, or another member's new playlist
' (as jellyfin-web does), brings it back. The server is told to wait on it again. The caller
' tells the viewer: the claim's notice, or the load's (syncPlayQueue.noticeForQueueFrame).
sub followAgain()
  m.log.info("following again", "groupId", m.state.groupId)
  syncPlayState.resume(m.state)
  m.tracker = syncPlayPlayback.newReadyTracker()
  if isValid(m.shadow) then syncPlayGroup.followedAgain(m.shadow.group)
  m.correctionPauseOwed = false
  post("SetIgnoreWait", syncPlayRequests.setIgnoreWait(false))
  publish()
end sub

' A halted member follows the group again from the SyncPlay menu (phase E): the follow first, so
' the fetched queue applies, then the group's item loaded as a new queue at the position the
' state kept while halted (every update and command is recorded then; syncPlayPlayback.
' startPositionTicks estimates it). A group playing nothing is only followed again. True when
' this member was halted in a group.
function resumeFollowing() as boolean
  ensureReady()
  if not m.state.inGroup or m.state.following then return false
  refreshExtraOffset()
  followAgain()
  if m.state.playingItemId = ""
    notify("followingAgain", m.state.groupName, "")
    return true
  end if
  m.loadNotice = "followingAgain"
  m.resumeAsked = true
  loadGroupItem("-resume")
  return true
end function

' A play of the video the group is playing (claimPlay), from any launcher: this member loads
' the group's item at the group's position, as Resume with Group does, and nothing reaches the
' group. A halted member follows again first and is told so here, as a claim is; Back before
' the load halts it again, quietly (endUnansweredRefollow). The press's start is the claim's:
' the load's own start replaces it, or a player reloading in place takes it. A player already on
' the video in step never gets here: the one launcher that runs over it asks keepsPlayingFor first.
' The videos the play queued after the group's (syncPlayQueue.queueNextIds) are added right after
' it with QueueNext, which restarts and replaces nothing. Posted with the load rather than after it:
' an update that only adds keeps the load owed (syncPlayQueue.owedLoadAfter), so whichever update
' lands last still loads the group's item.
' @param appendIds - item ids to add after the group's video, empty for none
sub catchUp(start as dynamic, appendIds = [] as object)
  releaseHeldPlay("replaced by a newer play")
  refreshExtraOffset()
  m.claimedStart = start
  if not isFollowing()
    followAgain()
    m.claimRefollowed = true
    m.resumeAsked = true
    notify("followingAgain", m.state.groupName, "")
  end if
  m.log.info("play of the group's own item loads it at the group position", "groupId", m.state.groupId)
  loadGroupItem("-catchup")
  m.queuedNext = invalid
  if appendIds.count() > 0 and post("Queue", syncPlayRequests.queue(appendIds, "QueueNext"))
    m.log.info("the rest of the play added after the group's item", "count", appendIds.count(), "groupId", m.state.groupId)
    m.queuedNext = appendIds
  end if
end sub

' A cast over this member's player while it follows the group (JRScene.onDeepLinkResolved, after
' syncPlayQueue.castGoesToGroup). The group takes it as this viewer's own press, through the same
' decision (claimItems), but the local queue is left alone: the group's answer builds the queue
' (applyQueue), so a refusal leaves the queue, its quality cap, version pick and repeat mode as
' they were. The video the player is already on in step only tells the viewer (keepsPlayingFor).
' @param item - the cast's item
' @return false when the group cannot take it: its start is ended, and the caller routes the cast
'   as any other
function castToGroup(item as dynamic) as boolean
  ensureReady()
  if keepsPlayingFor(item) then return true
  if not isValid(item) then return false
  ' The fields the group request reads: the id, the type and the resume start, set as
  ' quickplay.video sets them.
  queueItem = nodeHelpers.createQueueItem(item)
  if not isValid(queueItem) then return false
  nodeHelpers.setResumeStart(queueItem, item.playbackPositionTicks)
  start = m.global.queueManager.callFunc("beginPlaybackStart", "")
  if claimItems([queueItem], 0, start) then return true
  appWaits.fail(start, "the group could not take the cast")
  return false
end function

' A play of the group's own video while this member's player is already on it in step changes
' nothing but a toast: a reload would make this Roku rebuffer, and its Buffering report pauses
' every member until it is Ready. A cast (castToGroup) is the one launcher that runs over the
' player; any other that could must ask here first, since claimPlay runs after the launcher has
' replaced the queue.
' @param item - the item the play would launch
' @return whether the play is absorbed
function keepsPlayingFor(item as dynamic) as boolean
  if not isFollowing() then return false
  if not syncPlayQueue.isGroupsPlayingItem(item, m.state, m.lastCommand) then return false
  if not syncPlayQueue.playerIsOnGroupItem(true, isValid(playerHost()), m.expectingRemount, trackerPhase()) then return false
  notify("alreadyWatching", m.state.groupName, "")
  return true
end function

' Loads the item the group plays as a new queue at the position the state keeps for it
' (applyQueue; syncPlayPlayback.startPositionTicks estimates it).
' @param tag - tells this fetch's request id from the update's own (fetchQueue)
sub loadGroupItem(tag as string)
  m.owedLoad = { newPlaylist: true }
  fetchQueue("Resume", m.state.lastUpdateMs, false, tag)
end sub

' Whether a play this viewer handed to the group still waits on the group's answer: the start
' its press opened is still open. Back, the start's time limit or a newer press ended it.
function hasOpenClaim() as boolean
  return appWaits.isOpen(m.claimedStart)
end function

' The group will not answer a handed play with a load (a refusal, the membership ended, a
' halt): the start the press opened ends, or the spinner would run to its limit. Only that
' start: a newer press's start is not this claim's to end.
sub dropClaimedPlay(reason as string)
  appWaits.fail(m.claimedStart, "the group did not play it (" + reason + ")")
  m.claimedStart = invalid
  releaseHeldPlay(reason)
end sub

' A claim that re-followed and ended with no load from the group (a refusal, Back, the start's
' time limit, a lost post) leaves this member following with no player. It never posts Ready,
' so the group's next wait would stall on it: it halts again, quietly, since the refusal or the
' viewer's own action already says what happened. Called at each frame and player event: every
' wait the group starts begins with a frame to every member.
sub endUnansweredRefollow()
  if not m.claimRefollowed or hasOpenClaim() then return
  m.claimRefollowed = false
  if isFollowing() then haltFollowing("the group did not load the play that followed it again", false)
end sub

' --- frames ---

' The viewer's own time offset, read from their settings at each entry point, so the clock takes a
' change at once. The node itself follows when the pick arms the settle check (control, "timeOffset").
sub refreshExtraOffset()
  extraMs = 0
  user = m.global.user
  if isValid(user) and isValid(user.settings) and isValid(user.settings.playbackSyncPlayTimeOffsetMs) then extraMs = user.settings.playbackSyncPlayTimeOffsetMs
  syncPlayOffset.setExtraOffsetMs(m.estimator, extraMs)
end sub

' A position notification while following: read the drift (published in RTA builds, for the specs), and correct a drift past
' the threshold (syncPlayPlayback.settleCorrectionDue, correctionPlan), against the command that
' still says where the group is (syncPlayPlayback.clockReference).
sub checkSettle()
  inForce = syncPlayPlayback.clockReference(m.lastCommand, m.state.playingItemId, m.reportedBuffering, m.state.playbackQueueAtMs)
  drift = syncPlayPlayback.driftMs(inForce, m.estimator, syncPlayTime.nowMs(), m.playerPositionTicks)
  m.playbackDiffMs = drift
  if syncPlayPlayback.settleCorrectionDue(m.settle, drift, m.playerState, m.tracker.phase, m.groupPaused)
    toldToViewer = syncPlayPlayback.takePickNotice(m.settle)
    host = playerHost()
    if isValid(host)
      plan = syncPlayPlayback.correctionPlan(syncPlayTime.asLong(drift), m.playerPositionTicks, inForce, m.estimator, syncPlayPlayback.correctionLeadMs(m.lastSeekMs))
      if plan.seek and m.lastSeekGaveUp
        ' The tracker gave up the last seek on this node, so another cannot land in time. The group
        ' comes to this member instead: a Seek to its own position makes the server pause the others
        ' and bring them here, and the Seek that comes back finds the node where it asked
        ' (seekIsWhereWeAre), so it writes none.
        if not m.waitedOnMe and post("Seek", syncPlayRequests.seek(m.playerPositionTicks))
          m.waitedOnMe = true
          shadowAsked("seek", m.playerPositionTicks, false)
          m.log.info("drift correction asks the group to wait: the tracker gave up the last seek on this node", "driftMs", syncPlayTime.asLong(drift).toStr(), "lastSeekMs", m.lastSeekMs.toStr(), "positionTicks", m.playerPositionTicks.toStr())
        else
          m.log.info("drift correction skipped: the tracker gave up the last seek on this node, and the group waited once already", "driftMs", syncPlayTime.asLong(drift).toStr(), "lastSeekMs", m.lastSeekMs.toStr())
        end if
      else if plan.seek and syncPlayPlayback.seekPastEnd(plan.targetTicks, m.playerDurationSeconds)
        m.log.info("drift correction skipped: its seek would run off the item", "driftMs", syncPlayTime.asLong(drift).toStr())
      else
        m.correction = plan
        dropPausedEstimate()
        m.log.info("drift correction started", "driftMs", syncPlayTime.asLong(drift).toStr(), "targetTicks", plan.targetTicks.toStr(), "resumeInMs", syncPlayPlayback.correctionResumeDelayMs(plan, syncPlayTime.nowMs()).toStr())
        if plan.seek
          ' A jump the viewer's own time offset pick caused reads as intended with a word; a hold shows nothing.
          if toldToViewer then notify("syncing", "", "")
          tellPlayer(host, { command: "seekto", position: syncPlayPlayback.ticksToSeconds(plan.targetTicks), report: false, thenPause: true }, "hold")
          track({ kind: "seek", positionTicks: plan.targetTicks, report: false, thenPause: true })
        else
          tellPlayer(host, { command: "pause" }, "hold")
          armCorrectionWatchdog()
        end if
      end if
    end if
  end if
  ' The RTA specs wait on the drift, so an RTA build publishes it at each reading: one field write
  ' on this render-owned node per position notification, which a release build does not pay.
  #if ENABLE_RTA
    publish()
  #end if
end sub

' The correction's seek settled. The tracker's pause is written, and the node's `paused` state
' schedules the resume (playerEvent). A seek that left the node paused schedules it now. A landing
' that left the node anywhere else (a settle timeout with no `playing`) ends the correction: a
' resume written to a buffering node wedges it.
sub onCorrectionLanded(pauseWritten as boolean)
  if pauseWritten
    armCorrectionWatchdog()
  else if m.playerState = "paused"
    scheduleCorrectionResume()
  else
    endCorrection("the node did not land paused")
  end if
end sub

' A pause was written for the correction: its `paused` state replaces this with the resume, so a
' node that never gets there ends the correction when this fires (onCorrectionTimer).
sub armCorrectionWatchdog()
  m.correctionPauseOwed = true
  m.correctionTimer.control = "stop"
  m.correctionTimer.duration = syncPlayPlayback.PAUSE_CONFIRM_MS / 1000#
  m.correctionTimer.control = "start"
end sub

' The node is paused for the correction: resume at the moment the group reaches where it stopped.
' Called from the `paused` state alone, never as the pause is written, or the check below would
' find the node still playing and leave it paused for good.
sub scheduleCorrectionResume()
  plan = m.correction
  if not isValid(plan) then return
  syncPlayPlayback.landCorrection(plan, m.playerPositionTicks)
  delay& = syncPlayPlayback.correctionResumeDelayMs(plan, syncPlayTime.nowMs())
  m.log.info("drift correction holding", "resumeInMs", delay&.toStr())
  m.correctionTimer.control = "stop"
  if delay& = 0
    onCorrectionTimer()
  else
    m.correctionTimer.duration = delay& / 1000#
    m.correctionTimer.control = "start"
  end if
end sub

sub onCorrectionTimer()
  ensureReady()
  if not isValid(m.correction) or not isFollowing() or m.groupPaused then return
  host = playerHost()
  if not isValid(host) then return
  if m.playerState <> "paused"
    endCorrection("the node did not pause")
    return
  end if
  tellPlayer(host, { command: "resume" }, "hold")
  m.correctionPauseOwed = false
  m.log.info("drift correction resumed", "positionTicks", m.playerPositionTicks.toStr())
  m.correction = invalid
  ' Published with the next drift reading (checkSettle), which an RTA build publishes at once.
  m.correctionsDone++
  syncPlayPlayback.retrySettleCheck(m.settle)
end sub

' The correction failed where the node stands: nothing is holding it, and the drift is read again.
sub endCorrection(reason as string)
  m.log.warn("drift correction dropped", "reason", reason, "state", m.playerState)
  dropCorrection()
  syncPlayPlayback.retrySettleCheck(m.settle)
end sub

' A new stream on the player: a mount, or a reload in place. What was learned about the old one does
' not carry over: how its seeks went (a direct-play seek lands seconds early, an HLS one on a segment
' start, and a reload can switch one for the other), its drift, its length, and a correction or a
' settle check on it.
sub startStreamTracking()
  m.playerDurationSeconds = 0
  m.lastSeekMs = 0&
  m.lastSeekGaveUp = false
  m.playbackDiffMs = invalid
  m.correctionPauseOwed = false
  dropPausedEstimate()
  dropCorrection()
  syncPlayPlayback.disarmSettleCheck(m.settle)
end sub

' Where the node is, and where its last pause stopped it, are no longer known: a seek, a mount, a
' reload, a correction or a pause written again. The next pause needs a notification of its own.
sub dropPausedEstimate()
  syncPlayPlayback.dropPausePosition(m.pausePosition)
  syncResumeShift()
end sub

' The player wrote the node's pause this instant, for the group or for the viewer. A node playing
' in a settled tracker with no correction under way has a position to estimate.
sub notePauseWritten()
  if not isFollowing() then return
  canEstimate = m.playerState = "playing" and m.tracker.phase = "ready" and not isValid(m.correction)
  syncPlayPlayback.notePauseWritten(m.pausePosition, canEstimate, syncPlayTime.nowMs())
  syncResumeShift()
end sub

' An Unpause still waiting keeps the shift the pause's estimate gives now: it takes one when the
' estimate lands after the command came, and loses it when the estimate is dropped. So its resume
' time and its seek check always rest on the same position.
sub syncResumeShift()
  plan = m.pendingPlan
  if not isValid(plan) or plan.action <> "Unpause" or not isValid(plan.askedShiftMs) then return
  shiftMs& = syncPlayPlayback.resumeShiftMs(syncPlayPlayback.landedPauseTicks(m.pausePosition), plan.positionTicks)
  if shiftMs& = plan.askedShiftMs then return
  syncPlayPlayback.reshiftPlan(plan, shiftMs&, syncPlayTime.nowMs())
  m.resumeShiftChanges++
  m.log.info("resume shift changed for a waiting Unpause", "shiftMs", plan.shiftMs.toStr(), "inMs", plan.delayMs.toStr())
  m.commandTimer.control = "stop"
  ' Never applied from here: this runs inside other handlers, and the timer keeps one way in.
  if plan.delayMs > 0 then m.commandTimer.duration = plan.delayMs / 1000# else m.commandTimer.duration = 0.001
  m.commandTimer.control = "start"
  publish()
end sub

' A group command or an unmount took over: what it does replaces the correction.
sub dropCorrection()
  if isValid(m.correction) and m.correction.seek then syncPlayPlayback.abandonSeekPause(m.tracker)
  m.correction = invalid
  m.correctionTimer.control = "stop"
end sub

' This member stops answering to the group: a node held for the correction has no one left to
' resume it, and the viewer never paused it. The correction itself goes with resetPlaybackTracking.
sub releaseCorrection()
  m.correctionPauseOwed = false
  if isValid(m.correction) and m.playerState = "paused"
    host = playerHost()
    if isValid(host) then tellPlayer(host, { command: "resume" }, "release")
  end if
end sub

' The playback the manager was tracking is over: a halt, the player's unmount or a leave. Drops
' the plan a command timer would apply, the waits on the player, the group's pause and the
' correction under way, and the drift the specs read. A fresh follow (followAgain, GroupJoined)
' replaces the tracker instead, since no playback of the group's is under way yet.
sub resetPlaybackTracking()
  m.pendingPlan = invalid
  m.reportedBuffering = false
  m.groupPausedTicks = invalid
  m.lastReady = invalid
  m.groupPaused = false
  m.playbackDiffMs = invalid
  m.commandTimer.control = "stop"
  m.readyTimer.control = "stop"
  m.pauseTimer.control = "stop"
  m.waitedOnMe = false
  dropPausedEstimate()
  dropCorrection()
end sub

' The event's own payload, never m.top.frame: the main thread writes frames back to back
' (GroupJoined, a command and a queue update arrive within milliseconds), and the field holds
' only the latest when a handler runs.
sub onFrame(event as object)
  ensureReady()
  refreshExtraOffset()
  frame = event.getData()
  if not isValid(frame) or not syncPlayTime.isText(frame.kind) then return
  endUnansweredRefollow()
  if frame.kind = "syncplayupdate"
    onGroupUpdate(frame)
  else if frame.kind = "syncplaycommand"
    ' An idle group answers a join with a Stop and no queue: a queue after it is not the join's.
    m.joinAwaitsQueue = false
    onCommand(frame)
  end if
  if usesComparison() then converge() else shadowAfter()
end sub

sub onGroupUpdate(update as object)
  updateType = update.updateType
  if updateType = "PlayQueue" and syncPlayQueue.isStaleQueueUpdate(m.state, update)
    m.log.debug("stale PlayQueue update ignored", "lastUpdateMs", update.lastUpdateMs.toStr())
    return
  end if
  previousPlayingItemId = m.state.playingItemId
  previousQueueChangedAtMs = m.state.playbackQueueAtMs
  previousGroupState = m.state.groupState
  wasInGroup = m.state.inGroup
  previousGroupName = m.state.groupName
  m.state = syncPlayState.applyGroupUpdate(m.state, update)
  startsItem = updateType = "PlayQueue" and syncPlayQueue.changesPlayingItem(update.reason, previousPlayingItemId, m.state.playingItemId)
  shadowGroupUpdate(updateType, startsItem)
  if updateType = "PlayQueue"
    ' A same-item step this member is already part of reloads nothing (syncPlayQueue.restartAbsorbed).
    absorbed = ""
    if isFollowing() and not hasOpenClaim()
      loadInFlight = isValid(m.owedLoad) or m.loadAwaitsReady
      loadFromStart = syncPlayPlayback.restartLoadFromStart(trackerPhase(), trackerLoadStartTicks(), m.loadAwaitsReady, m.loadStartTicks)
      absorbed = syncPlayQueue.restartAbsorbed(update.reason, previousPlayingItemId, m.state.playingItemId, loadInFlight, trackerPhase(), loadFromStart, m.playerState, m.lastCommand, previousQueueChangedAtMs)
      if (update.reason = "NextItem" or update.reason = "PreviousItem") and previousPlayingItemId = m.state.playingItemId
        m.log.info("same-item step", "answer", absorbed, "loadFromStart", loadFromStart, "trackerPhase", trackerPhase(), "loadAwaitsReady", m.loadAwaitsReady)
      end if
    end if
    m.owedLoad = syncPlayQueue.owedLoadAfter(m.owedLoad, update.reason, previousPlayingItemId, m.state.playingItemId, absorbed <> "")
    if absorbed <> "" then m.log.info("restart of the item already loaded or loading absorbed", "reason", update.reason, "answer", absorbed)
    ' The Ready this member sent was for the wait the server has reset: the item is held at its start.
    ' Under the comparison the new wait the update started is owed its Ready by the group model.
    if absorbed = "ready" and not usesComparison() then report("ready", false, m.playerPositionTicks)
    if hasOpenClaim() then m.owedLoad = syncPlayQueue.owedLoadForClaimedPlay(m.owedLoad, update.reason, m.state.playingItemId)
    ' A load this update owes is playback starting, whatever the update's reason: a play of the
    ' item a stopped group was on comes back as a queue that keeps that item.
    if isValid(m.owedLoad) and isValid(m.shadow) then syncPlayGroup.playbackStarted(m.shadow.group)
  end if
  m.log.info("group update", "type", updateType, "groupId", m.state.groupId, "state", m.state.groupState)
  if usesComparison()
    ' The group model anchors and ends this member's wait itself (shadowGroupUpdate).
  else if updateType = "StateUpdate" and previousGroupState = "Playing" and m.state.groupState = "Waiting" and m.reportedBuffering and not isValid(m.groupPausedTicks)
    anchorGroupPause()
  else if updateType = "StateUpdate" and previousGroupState = "Waiting" and m.state.groupState <> "Waiting"
    endGroupWait()
  end if

  if updateType = "GroupJoined"
    notify("joined", m.state.groupName, "")
    setUserSetting(STALE_GROUP_KEY, m.state.groupId + "|" + m.state.groupName)
    m.staleGroupName = ""
    m.joinAwaitsQueue = true
    m.owedLoad = invalid
    m.loadNotice = invalid
    syncPlayOffset.reset(m.estimator)
    m.heldCommand = invalid
    m.lastCommand = invalid
    m.playbackDiffMs = invalid
    m.groupPaused = false
    m.reportedBuffering = false
    m.groupPausedTicks = invalid
    m.lastReady = invalid
    m.tracker = syncPlayPlayback.newReadyTracker()
    m.correctionPauseOwed = false
    m.failedBursts = 0
    startTimeSync(FIRST_SYNC_ROUNDS)
  else if updateType = "GroupLeft" or updateType = "NotInGroup"
    ' NotInGroup also answers a request made outside any group: nothing to tell then. A
    ' GroupLeft for a membership a Home exit left behind names the group from the registry.
    if wasInGroup
      notify("left", previousGroupName, "")
    else if updateType = "GroupLeft" and m.staleGroupName <> ""
      notify("leftStale", m.staleGroupName, "")
    end if
    m.staleGroupName = ""
    unsetUserSetting(STALE_GROUP_KEY)
    dropClaimedPlay("left the group")
    leaveLocally()
    return
  else if updateType = "UserJoined"
    notify("userJoined", m.state.groupName, update.userName)
  else if updateType = "UserLeft"
    notify("userLeft", m.state.groupName, update.userName)
  else if updateType = "GroupDoesNotExist" or updateType = "LibraryAccessDenied" or updateType = "CreateGroupDenied" or updateType = "JoinGroupDenied"
    notify(updateType, "", "")
    dropClaimedPlay(updateType)
    endUnansweredRefollow()
  else if updateType = "PlayQueue"
    onQueueUpdate(update)
    syncGroupModes()
  end if
  publish()
end sub

' The group's repeat mode is the queue's (decision `video-repeat-belongs-to-queue`): while this
' member follows and the local queue holds the group's item, the mode from the last queue update
' is written onto it, so the OSD, the gear's tint and the step buttons read one holder in and out
' of a group. The player is then told the queue changed, so an open OSD reads it again. A pick
' this viewer made in the gear comes back the same way (control). Nothing is written while
' halted or before the group's item is in the queue: applyQueue mirrors as it sets the queue.
sub syncGroupModes()
  if not isFollowing() then return
  queueManager = m.global.queueManager
  if not isValid(queueManager) then return
  if not syncPlayQueue.isGroupItem(queueManager.callFunc("getCurrentItem"), m.state.playingItemId) then return
  queueManager.callFunc("setRepeatMode", m.state.repeatMode, queueRepeat.BY_GROUP)
  ' Published first: the OSD reads the group's modes and playlist off `sync` as it refreshes
  ' (syncPlayHooks.groupQueue), and told after, it read the modes from before this update (RTA,
  ' Stick 4K, 2026-11-03: Previous stayed disabled after the group's RepeatAll).
  publish()
  host = playerHost()
  if isValid(host) then tellPlayer(host, { command: "queuechanged" })
end sub

' Tell the viewer something (the `notice` field; JRScene shows the toast).
sub notify(kind as string, groupName as string, userName as string)
  m.top.notice = { kind: kind, groupName: groupName, userName: userName }
end sub

sub onCommand(command as object)
  if not syncPlayState.acceptsCommand(m.state, command)
    m.log.debug("command not for this member", "command", command.command, "playlistItemId", command.playlistItemId)
    return
  end if
  if not isFollowing()
    ' Recorded, never applied: whatever plays now is this viewer's own. A resume (phase E)
    ' starts from the last command.
    m.log.debug("command recorded while halted", "command", command.command)
    m.lastCommand = command
    if usesComparison() then shadowCommand(command)
    publish()
    return
  end if
  if usesComparison()
    ' The group model takes the command as it arrives: it knows a command's own time, and that
    ' nothing can be placed on the device clock before the first estimate.
    m.lastCommand = command
    if command.command = "Seek" then m.groupSeeks++
    shadowCommand(command)
    m.log.info("command taken", "command", command.command, "positionTicks", syncPlayTime.asLong(command.positionTicks).toStr())
    if command.command = "Unpause" then logUnpauseReach()
    publish()
    return
  end if
  if not m.estimator.hasEstimate
    m.log.info("command held until the clock offset is known", "command", command.command)
    m.heldCommand = command
    return
  end if
  scheduleCommand(command)
end sub

sub scheduleCommand(command as object)
  m.lastCommand = command
  shadowCommand(command)
  if command.command = "Seek" then m.groupSeeks++
  ' The Unpause after this member's Ready carries where the group really paused: how far the
  ' anchor was off is the measure of the anchor itself.
  if command.command = "Unpause" and isValid(m.groupPausedTicks) and syncPlayTime.isWholeNumber(command.positionTicks)
    m.log.info("group pause anchor checked", "anchorErrorMs", syncPlayTime.ticksToMs(syncPlayTime.asLong(command.positionTicks) - syncPlayTime.asLong(m.groupPausedTicks)).toStr())
  end if
  m.groupPausedTicks = invalid
  m.reportedBuffering = false
  ' An Unpause resumes later or earlier by the lead the group Pause left (a seek would resume the node, so nothing else takes it back).
  shiftMs& = 0&
  if command.command = "Unpause" then shiftMs& = syncPlayPlayback.resumeShiftMs(syncPlayPlayback.landedPauseTicks(m.pausePosition), command.positionTicks)
  plan = syncPlayPlayback.scheduleCommand(m.estimator, command, syncPlayTime.nowMs(), shiftMs&)
  m.pendingPlan = plan
  m.commandTimer.control = "stop"
  m.log.info("command scheduled", "command", plan.action, "inMs", plan.delayMs.toStr(), "positionTicks", plan.positionTicks.toStr())
  if plan.shiftMs <> 0 then m.log.info("resume shifted for the pause's lead", "shiftMs", plan.shiftMs.toStr())
  if plan.delayMs = 0
    applyPendingPlan()
  else
    m.commandTimer.duration = plan.delayMs / 1000#
    m.commandTimer.control = "start"
  end if
  publish()
end sub

sub onCommandTimer()
  ensureReady()
  applyPendingPlan()
  shadowAfter()
end sub

sub applyPendingPlan()
  plan = m.pendingPlan
  m.pendingPlan = invalid
  ' A halt can land between scheduling and firing.
  if not isValid(plan) or not isFollowing() then return
  host = playerHost()
  if not isValid(host)
    m.log.warn("command arrived with no player mounted", "command", plan.action)
    return
  end if
  ' A Seek leaves the player paused for the Unpause that follows.
  m.groupPaused = plan.action = "Pause" or plan.action = "Seek"
  ' A paused node is resumed by the plan itself (a resume or a seek), so nothing stays owed.
  if m.groupPaused or m.playerState = "paused" then m.correctionPauseOwed = false
  heldForCorrection = isValid(m.correction) and m.playerState = "paused"
  ' A group Pause that finds the node already paused (the viewer's own pause wrote it) keeps that
  ' pause's estimate. One that writes its own pause makes a new one (the player's pauseWritten).
  if plan.action = "Pause" then syncPlayPlayback.carryPause(m.pausePosition, m.playerState, heldForCorrection)
  pausedEstimateTicks = invalid
  if plan.action = "Unpause" then pausedEstimateTicks = syncPlayPlayback.landedPauseTicks(m.pausePosition)
  dropCorrection()
  ' A Pause that finds a seek in flight is left to the seek's landing. An Unpause that follows
  ' it must take that pause back, or the node would land paused with nothing to resume it.
  if plan.action = "Pause" and syncPlayPlayback.pauseWaitsForSeek(m.tracker.phase)
    syncPlayPlayback.pauseAfterSeek(m.tracker)
  else if plan.action = "Unpause"
    syncPlayPlayback.abandonSeekPause(m.tracker)
    ' An Unpause says where the group is now, so a Seek held behind the one in flight is stale.
    syncPlayPlayback.dropHeldSeek(m.tracker)
  end if
  m.playbackDiffMs = invalid
  if plan.action = "Unpause" then syncPlayPlayback.armSettleCheck(m.settle)
  ' The one reset the pause counters need: the pause check reads them only while groupPaused
  ' holds, and this is the one place that sets it.
  if m.groupPaused
    m.pauseAttempts = 0
    m.pauseGaveUp = false
  end if
  ' A Pause starts a new chain: this member may ask the group to wait on it once more.
  if plan.action = "Pause" then m.waitedOnMe = false
  if plan.action = "Seek" and syncPlayPlayback.seekIsWhereWeAre(plan.positionTicks, m.playerPositionTicks, m.playerState, m.tracker.phase)
    ' The group is coming to where this node is (its own wait-on-me Seek, or another member's
    ' to the same place): no seek, a pause, and Ready from here.
    tellPlayer(host, { command: "pause", showOsd: true }, "wait")
    m.pauseAttempts++
    armPauseTimer()
    report("ready", false, m.playerPositionTicks)
    publish()
    return
  end if
  steps = syncPlayPlayback.applyPlan(plan, m.playerState, m.playerPositionTicks, m.tracker.phase, heldForCorrection, pausedEstimateTicks)
  if plan.action = "Unpause"
    m.resumeShiftMs = plan.shiftMs
    ' A plain resume starts the node from the estimate, which anchors a pause that comes before the
    ' next notification. Any other outcome (a seek, a node not paused) leaves nothing known.
    if steps.count() = 1 and steps[0].command = "resume"
      syncPlayPlayback.noteResumed(m.pausePosition)
    else
      dropPausedEstimate()
    end if
  end if
  for each verb in steps
    if verb.command = "stop"
      m.loadAwaitsReady = false
      m.expectingRemount = true
      shadowWriteBegin({ command: "stop" }, "group")
      host.callFunc("exitPlayback")
      shadowWriteEnd()
    else if verb.command = "seekto" and syncPlayPlayback.pauseWaitsForSeek(m.tracker.phase)
      ' The node never runs two seeks at once: this one waits for the one in flight, the newest
      ' wins, and the tracker hands it back at the landing (track).
      track({ kind: "holdSeek", targetTicks: plan.positionTicks, report: verb.report, thenPause: verb.thenPause })
    else
      ' A seek the server waits on is the group's; a silent one is this member's own.
      verbOwner = "group"
      if verb.command = "seekto" and verb.report <> true then verbOwner = "hold"
      tellPlayer(host, verb, verbOwner)
      if verb.command = "pause"
        m.pauseAttempts++
        armPauseTimer()
      end if
      if verb.command = "seekto" then track({ kind: "seek", positionTicks: plan.positionTicks, report: verb.report, thenPause: verb.thenPause })
    end if
  end for
  publish()
end sub

' --- the queue ---

sub onQueueUpdate(update as object)
  ' A halted member is brought back by a new playlist, and by nothing less: an append, a move
  ' or a jump within the playlist it stopped following stays recorded (onCommand).
  refollowed = false
  if not m.state.following
    if update.reason <> "NewPlaylist" then return
    ' Another member's pick stands: a play this viewer had not confirmed yet would replace it.
    releaseHeldPlay("the group started something new")
    followAgain()
    refollowed = true
  end if
  ' The group took the videos a catch-up added: told once, with how many. Another playlist ends
  ' the wait for that answer.
  queuedCount = syncPlayQueue.queuedNextCount(m.queuedNext, update.reason, m.state.playlist)
  if queuedCount > 0
    m.queuedNext = invalid
    m.top.notice = { kind: "queuedNext", groupName: m.state.groupName, userName: "", count: queuedCount }
  else if update.reason = "NewPlaylist"
    m.queuedNext = invalid
  end if
  answersJoin = m.joinAwaitsQueue
  m.joinAwaitsQueue = false
  ' A group that plays nothing waits on no Ready and has no item to load. The update that
  ' picks an item owes the load (syncPlayQueue.owedLoadAfter). With no load to say it, a follow
  ' made again is told now.
  if m.state.playingItemId = ""
    if refollowed then notify("followingAgain", m.state.groupName, "")
    return
  end if
  m.loadNotice = syncPlayQueue.noticeForQueueFrame(m.loadNotice, refollowed, answersJoin)
  fetchQueue(update.reason, m.state.lastUpdateMs, false)
end sub

' Fetches the item the group plays and applies it as the queue: one item, one request, whatever
' the playlist's length (syncPlayQueue's header says why). A failed load goes to
' onQueueLoadFailed: the server waits on this member's Ready, so a silent exit would hold the
' whole group.
' @param tag - what tells this fetch's request id from the update's own (a resume fetches an
'   update already fetched once; fetchAsync keys its pending requests by id)
sub fetchQueue(reason as string, lastUpdateMs as longinteger, isRetry as boolean, tag = "" as string)
  entry = syncPlayQueue.playingEntry(m.state)
  if not isValid(entry) then return
  req = GetApi().BuildGetItemsByQueryRequest({ ids: entry.itemId })
  if not isValid(req) then return
  requestId = "syncplay-queue-" + lastUpdateMs.toStr() + tag
  if isRetry then requestId = requestId + "-retry"
  promises.chain(fetchAsync(req, requestId), { reason: reason, lastUpdateMs: lastUpdateMs, isRetry: isRetry, tag: tag, entry: entry }).then(sub(res as object, ctx as object)
    ' A catch-up the viewer backed out of while its item was in flight halts here, and loads
    ' nothing: no frame need arrive first.
    endUnansweredRefollow()
    ' A newer update arrived while this one's item was in flight: it will apply its own.
    ' A member that stopped following while the item was in flight applies nothing, as onCommand
    ' does for a halted member.
    if not syncPlayQueue.appliesFetchedQueue(m.state, ctx.lastUpdateMs) then return
    items = syncPlayQueue.pagedItems([res])
    if not isValid(items)
      m.log.warn("the group's item could not be read", "reason", ctx.reason)
      onQueueLoadFailed(ctx.reason, ctx.lastUpdateMs, ctx.isRetry, ctx.tag, "missing")
      return
    end if
    applyQueue(ctx.reason, syncPlayQueue.queueItemsFor([ctx.entry], items), ctx.lastUpdateMs, ctx.isRetry, ctx.tag)
  end sub).catch(sub(err as object, ctx as object)
    ' As on an answer: a catch-up the viewer backed out of halts quietly here, and is not retried.
    endUnansweredRefollow()
    ' err whole: a timeout rejects with the pool's result, which has no `reason`.
    m.log.warn("the group's items could not be fetched", err)
    onQueueLoadFailed(ctx.reason, ctx.lastUpdateMs, ctx.isRetry, ctx.tag, "request")
  end sub)
end sub

' A queue that cannot be loaded: retry a request failure once, otherwise stop following so the
' server stops waiting on this member. Nothing happens when a newer update or a halt took over.
' @param tag - the failed fetch's tag, which its retry keeps (fetchQueue)
sub onQueueLoadFailed(reason as string, lastUpdateMs as longinteger, isRetry as boolean, tag as string, failure as string)
  if not syncPlayQueue.appliesFetchedQueue(m.state, lastUpdateMs) then return
  if syncPlayQueue.loadFailureAction(isRetry, failure) = "retry"
    fetchQueue(reason, lastUpdateMs, true, tag)
    return
  end if
  haltFollowing("the group's queue could not be loaded (" + failure + ")")
end sub

sub applyQueue(reason as string, queueItems as object, lastUpdateMs as longinteger, isRetry as boolean, tag as string)
  index = syncPlayQueue.positionOf(queueItems, m.state.playingItemId)
  ' Checked before the queue changes: a member that stops following keeps its own queue.
  if index < 0
    m.log.warn("the group's playing item is not in the fetched queue", "playlistItemId", m.state.playingItemId)
    onQueueLoadFailed(reason, lastUpdateMs, isRetry, tag, "missing")
    return
  end if
  ' Also before the queue changes. Not a load failure, so no retry: the audio player and Live TV
  ' have no group hooks, and a member that cannot report Ready would hold the group.
  if not syncPlayQueue.followsItem(queueItems[index])
    haltFollowing("the group is playing an item this player cannot follow")
    return
  end if
  queueManager = m.global.queueManager
  newPlaylist = isValid(m.owedLoad) and m.owedLoad.newPlaylist = true
  ' A new playlist is a new queue: the viewer's version pick and gear caps from the queue before
  ' do not carry into it (set() alone keeps them, for a reorder). Within the group's playlist
  ' they carry, as in any queue.
  if newPlaylist then queueManager.callFunc("clear")
  queueManager.callFunc("set", queueItems)
  queueManager.callFunc("setPosition", index)
  ' The group's repeat mode rides on its queue (syncGroupModes): a clear() above forgot it.
  queueManager.callFunc("setRepeatMode", m.state.repeatMode, queueRepeat.BY_GROUP)
  ' Cinema Mode: no intro in front of the group's item. set() went through clear(), which
  ' re-reads the setting, so this comes after it.
  queueManager.callFunc("setPrerollStatus", false)
  host = playerHost()
  action = syncPlayQueue.loadAction(m.owedLoad, isValid(host))
  if action = "" then return
  ' The load is performed from here. The early return above kept the record for its retry.
  m.owedLoad = invalid
  m.loadAwaitsReady = true
  m.loadCount++
  ' One toast for what this load is: the claim said it already, a reload in place says only a
  ' follow made again, and a launch says what its frame decided (syncPlayQueue.noticeAtLoad).
  notice = syncPlayQueue.noticeAtLoad(m.loadNotice, action, hasOpenClaim())
  m.loadNotice = invalid
  m.resumeAsked = false
  if notice <> "" then notify(notice, m.state.groupName, "")
  ' The group answered: a follow made at a claim is real from here, whichever branch loads it.
  m.claimRefollowed = false
  if newPlaylist
    startTicks& = syncPlayPlayback.startPositionTicks({ lastUpdateMs: m.state.lastUpdateMs, startPositionTicks: m.state.startPositionTicks }, m.lastCommand, m.estimator, syncPlayTime.nowMs())
    queueManager.callFunc("setCurrentStartingPoint", startTicks&, true)
    m.loadStartTicks = startTicks&
  else
    m.loadStartTicks = 0&
  end if
  shadowWriteBegin({ command: "load", startTicks: m.loadStartTicks }, "group")
  if action = "remount"
    ' The play route over a mounted player reloads nothing for the same item and stacks a second
    ' player for another, so the player reloads in place. No playback-start wait opens here.
    m.expectingRemount = true
    if not newPlaylist then queueManager.callFunc("advanceTo", index)
    host.callFunc("skipToCurrentQueueItem")
    ' A play this viewer handed over is answered here. The reloaded player took the start the
    ' press opened (takePlaybackStart) and ends it once its stream holds, so the claim only ends.
    m.claimedStart = invalid
  else
    if not newPlaylist then queueManager.callFunc("startCurrentFresh")
    ' The start opened below replaces the claim's, as for any newer press.
    m.claimedStart = invalid
    queueManager.callFunc("beginPlaybackStart", "")
    queueManager.callFunc("playQueue")
  end if
  shadowWriteEnd()
end sub

' --- reports ---

sub track(evt as object)
  phaseBefore = m.tracker.phase
  if evt.kind = "seek" then m.seekWrittenAtMs = syncPlayTime.nowMs()
  if evt.kind = "seek" or evt.kind = "holdSeek" then dropPausedEstimate()
  result = syncPlayPlayback.trackPlayerEvent(m.tracker, evt)
  if result.waitMs > 0
    m.readyTimer.control = "stop"
    m.readyTimer.duration = result.waitMs / 1000#
    m.readyTimer.control = "start"
  end if
  isPlaying = m.playerState = "playing"
  if result.pauseFirst
    ' A load's first frame: hold here and tell the server where we are. Its Unpause starts
    ' everyone together (web pauses at playbackstart the same way). A correction's landing
    ' pauses the same way, and then waits for the group (onCorrectionLanded).
    host = playerHost()
    pauseOwner = "wait"
    if isValid(m.correction) then pauseOwner = "hold"
    if result.showOsd then pauseOwner = "group"
    if isValid(host) then tellPlayer(host, { command: "pause", showOsd: result.showOsd }, pauseOwner)
    ' A pause the node swallowed is caught by no other check: count the write like a group Pause's.
    if m.groupPaused
      m.pauseAttempts++
      armPauseTimer()
    end if
    isPlaying = false
  end if
  seekEnded = syncPlayPlayback.seekEnded(phaseBefore, m.tracker.phase)
  ' How long the tracker took to end the seek sets the next correction's lead. That is not how long
  ' the seek took: a position that lands at once leaves only the landing budget to run. Whether the
  ' tracker gave the seek up is what tells the next correction not to seek.
  if seekEnded
    m.lastSeekMs = syncPlayTime.nowMs() - m.seekWrittenAtMs
    m.lastSeekGaveUp = result.seekGaveUp
  end if
  ' A pause left to a landing that wrote none: the node is already paused, so the viewer only
  ' needs telling, or it is somewhere only the pause check can catch it.
  if seekEnded and not result.pauseFirst
    if result.showOsd and m.playerState = "paused"
      host = playerHost()
      if isValid(host) then tellPlayer(host, { command: "pause", showOsd: true })
    end if
    if m.groupPaused then armPauseTimer()
  end if
  if isValid(m.correction) and seekEnded then onCorrectionLanded(result.pauseFirst)
  if result.report = "ready" then m.loadAwaitsReady = false
  if result.report <> ""
    if result.positionTicks >= 0 then report(result.report, isPlaying, result.positionTicks) else report(result.report, isPlaying)
  else if m.tracker.phase <> phaseBefore
    ' A phase change that sends no report still reaches the published field.
    publish()
  end if
  ' The seek in flight ended and a newer one was held: write it now. The phase stayed "seeking",
  ' so no pause timer or correction landing fired above.
  queued = result.nextSeek
  if isValid(queued)
    host = playerHost()
    if isValid(host)
      queuedOwner = "hold"
      if queued.report = true then queuedOwner = "group"
      tellPlayer(host, { command: "seekto", position: syncPlayPlayback.ticksToSeconds(queued.targetTicks), report: queued.report, thenPause: queued.thenPause }, queuedOwner)
      track({ kind: "seek", positionTicks: queued.targetTicks, report: queued.report, thenPause: queued.thenPause })
    else
      m.log.warn("held seek dropped: no player mounted", "targetTicks", queued.targetTicks.toStr())
    end if
  end if
end sub

sub onReadyTimer()
  ensureReady()
  if isFollowing() then track({ kind: "timeout" })
  shadowAfter()
end sub

' Check, a moment after a pause write or a state change, that the player is still held.
sub armPauseTimer()
  m.pauseTimer.control = "stop"
  m.pauseTimer.duration = syncPlayPlayback.PAUSE_CONFIRM_MS / 1000#
  m.pauseTimer.control = "start"
end sub

' While the group is paused the player stays paused: a pause write that did not take, or a
' resume from the viewer, is written again, up to PAUSE_ATTEMPTS times per group command.
sub onPauseTimer()
  ensureReady()
  if not isFollowing() then return
  if not syncPlayPlayback.owesPause(m.groupPaused, m.playerState, m.tracker.phase) then return
  if m.pauseAttempts >= syncPlayPlayback.PAUSE_ATTEMPTS
    ' The viewer's own Play goes to the group (control), so a node that plays on through three
    ' pauses is a device fault: the member halts rather than drift out of sync unannounced.
    if not m.pauseGaveUp
      m.pauseGaveUp = true
      m.log.warn("the player would not stay paused", "state", m.playerState, "attempts", m.pauseAttempts)
      haltFollowing("the player would not stay paused")
    end if
    return
  end if
  host = playerHost()
  if not isValid(host) then return
  dropPausedEstimate()
  tellPlayer(host, { command: "pause" })
  m.pauseAttempts++
  armPauseTimer()
end sub

' @param positionTicks - the position to report; omitted, the player's own
sub report(kind as string, isPlaying as boolean, positionTicks = invalid as dynamic)
  whenMs& = syncPlayOffset.serverNowMs(m.estimator, syncPlayTime.nowMs())
  reported& = m.playerPositionTicks
  if isValid(positionTicks) then reported& = syncPlayTime.asLong(positionTicks)
  shadowReported(kind)
  if kind = "ready"
    m.readiesSent++
    m.lastReady = { whenMs: whenMs&, positionTicks: reported&, isPlaying: isPlaying }
    post("Ready", syncPlayRequests.ready(whenMs&, reported&, isPlaying, m.state.playingItemId))
  else
    m.reportedBuffering = true
    ' A Buffering into a wait that is already this member's moves nothing on the server, so the
    ' anchor it set still holds.
    if m.state.groupState <> "Waiting" then m.groupPausedTicks = invalid
    m.bufferingSentAtMs = syncPlayTime.nowMs()
    m.bufferingReportedTicks = reported&
    post("Buffering", syncPlayRequests.buffering(whenMs&, reported&, isPlaying, m.state.playingItemId))
  end if
  m.log.info("reported", "kind", kind, "positionTicks", reported&.toStr(), "isPlaying", isPlaying)
  publish()
end sub

' --- time sync ---

sub startTimeSync(rounds as integer)
  serverUrl = m.global.server.serverUrl
  if not isValidAndNotEmpty(serverUrl) then return
  m.timeSyncTask = replaceTask(m.timeSyncTask, "TimeSyncTask", "results", { url: serverUrl + "/GetUtcTime", authHeader: buildAuthHeader(), rounds: rounds })
  m.timeSyncTask.observeField("results", "onTimeSyncResults")
  launchTask(m.timeSyncTask)
end sub

sub onTimeSyncResults(event as object)
  if not isCurrentTaskEvent(event, m.timeSyncTask) then return
  rows = event.getData()
  m.timeSyncTask = releaseTask(m.timeSyncTask, "results")
  added = 0
  if type(rows) = "roArray"
    for each row in rows
      if syncPlayOffset.addUtcTimeResponse(m.estimator, row.txDeviceMs, row.rxDeviceMs, row.body) then added++
    end for
  end if
  m.log.info("time sync", "rounds", added, "offsetMs", m.estimator.offsetMs.toStr(), "delayMs", m.estimator.delayMs.toStr())
  if not m.state.inGroup then return
  if m.estimator.hasEstimate
    m.failedBursts = 0
    post("Ping", syncPlayRequests.ping(m.estimator.delayMs \ 2))
    if isValid(m.heldCommand)
      held = m.heldCommand
      m.heldCommand = invalid
      ' Checked again: a queue update since it was held can have made it stale (acceptsCommand).
      if syncPlayState.acceptsCommand(m.state, held) and isFollowing() then scheduleCommand(held)
    end if
  else
    m.failedBursts++
  end if
  m.syncTimer.duration = syncPlayOffset.nextBurstSeconds(m.estimator.hasEstimate, m.failedBursts)
  m.syncTimer.control = "start"
  ' A new estimate moves every time the comparison placed on the device clock.
  if usesComparison() then converge()
  publish()
end sub

sub onSyncTimer()
  ensureReady()
  if m.state.inGroup then startTimeSync(SYNC_ROUNDS)
end sub

' --- helpers ---

function isFollowing() as boolean
  return m.state.inGroup and m.state.following
end function

' Hands the group's own verb to the player, marked fromGroup: the player applies it as it is
' instead of asking the group for it again (VideoPlayerView.handleTransport). Without the mark a
' group Seek came back as a new Seek request and went round for good, and the load's first-frame
' pause paused the whole group (Stick 4K, 2026-10-28).
' @param owner - who the write is for, for shadow mode: "group", "wait" (the group getting ready),
'   "hold" (a correction of this member's own) or "release" (a halt letting a held node go)
sub tellPlayer(host as object, verb as object, owner = "group" as string)
  verb.fromGroup = true
  shadowWriteBegin(verb, owner)
  host.callFunc("handleTransport", verb)
  shadowWriteEnd()
end sub

' --- shadow mode ---
'
' The player and group models of the convergence rewrite are fed here beside this code, and each
' place the comparison would have decided differently is logged (syncPlayShadow). Nothing they say
' is acted on while the old engine decides. Only an RTA build holds the models then: any other
' build has none, and these subs do nothing.

' What the comparison is told beside the two models. When it decides, the queue layer still
' performs each load itself, as its item arrives, so no load is ever asked of the comparison.
function shadowCtx() as object
  return { following: isFollowing(), estimator: m.estimator, loadOwed: isValid(m.owedLoad) and not usesComparison(), isLastItem: syncPlayQueue.isLastItem(m.state), durationSeconds: m.playerDurationSeconds }
end function

sub shadowPlayerFact(evt as object)
  if not isValid(m.shadow) then return
  nowMs& = syncPlayTime.nowMs()
  player = m.shadow.player
  ' How long the node took to stop after a pause was written to it. The player model takes the
  ' stop as where the node was at the write, so this is what that estimate leaves out, and what
  ' syncPlayPlayback.PAUSE_LANDED_MS is judged against.
  if evt.kind = "state" and player.activity = "pausing" and syncPlayTime.isText(evt.state) and evt.state = "paused"
    m.pauseLandedMs = nowMs& - syncPlayTime.asLong(player.pauseWrittenAtMs)
    m.log.info("pause landed", "afterMs", m.pauseLandedMs.toStr(), "owner", player.pauseOwner)
  end if
  syncPlayShadow.playerFact(m.shadow, evt, m.loadStartTicks, nowMs&)
end sub

' The pause the player reports from inside a write of this manager's is that write, not the
' viewer's own, so the write is bracketed.
' The pause the player reports from inside a write of this manager's is that write, not the
' viewer's own, so the write is bracketed. When the comparison decides, the write is its own
' and the models were told by it already (carryOut).
sub shadowWriteBegin(verb as object, owner as string)
  if not isValid(m.shadow) then return
  if not usesComparison()
    syncPlayShadow.managerWrote(m.shadow, shadowCtx(), verb, owner, syncPlayTime.nowMs())
  else if verb.command = "load"
    ' The queue layer performs a load under either engine; the player model is told of it here.
    syncPlayPlayer.told(m.shadow.player, "load", owner, verb.startTicks, syncPlayTime.nowMs())
  end if
  m.shadow.ownWrite = true
end sub

sub shadowWriteEnd()
  if isValid(m.shadow) then m.shadow.ownWrite = false
end sub

sub shadowReported(what as string)
  if isValid(m.shadow) and not usesComparison() then syncPlayShadow.managerReported(m.shadow, shadowCtx(), what, syncPlayTime.nowMs())
end sub

sub shadowAsked(what as string, positionTicks as dynamic, fromViewer as boolean)
  if isValid(m.shadow) and not usesComparison() then syncPlayShadow.managerAsked(m.shadow, what, positionTicks, fromViewer, syncPlayTime.nowMs())
end sub

sub shadowCommand(command as object)
  if isValid(m.shadow) then syncPlayShadow.commandArrived(m.shadow, command)
end sub

' @param startsItem - a queue update that starts this member on an item
sub shadowGroupUpdate(updateType as string, startsItem as boolean)
  if not isValid(m.shadow) then return
  if updateType = "GroupJoined" or updateType = "GroupLeft" or updateType = "NotInGroup"
    syncPlayShadow.membershipChanged(m.shadow, m.state.groupState)
  else if updateType = "StateUpdate"
    syncPlayShadow.groupStateChanged(m.shadow, m.state.groupState, m.estimator, syncPlayTime.nowMs())
  else if updateType = "PlayQueue"
    syncPlayShadow.itemChanged(m.shadow, m.state.playingItemId, m.state.playbackQueueAtMs, startsItem)
  end if
end sub

sub shadowOffsetPicked()
  if isValid(m.shadow) then syncPlayShadow.offsetPicked(m.shadow)
end sub

' The end of an event under the old engine: ask the comparison what it still wants, and log each
' disagreement recorded since the last one.
sub shadowAfter()
  if not isValid(m.shadow) or usesComparison() then return
  syncPlayShadow.afterEvent(m.shadow, shadowCtx(), syncPlayTime.nowMs())
  for each entry in syncPlayShadow.takeEntries(m.shadow)
    m.log.info("shadow disagreement", entry.kind, "old", entry.old, "wanted", entry.wanted, "at", entry.at, entry.forMs.toStr())
  end for
end sub

function shadowCount() as integer
  if isValid(m.shadow) then return m.shadow.count
  return 0
end function

' The routed play host, when the viewer is on the play route.
function playerHost() as dynamic
  view = m.global.activeRoutedView
  if isValid(view) and view.subtype() = "PlayerHostView" then return view
  return invalid
end function

' A SyncPlay POST nobody reads the answer to: the server's reply is a frame on the receiver.
' False when no request could be built (syncPlayRequest).
function post(action as string, body as dynamic, isLastForSession = false as boolean) as boolean
  req = syncPlayRequest(action, body, isLastForSession)
  if not isValid(req) then return false
  SubmitSideEffect(req)
  return true
end function

' The request for a SyncPlay action, or invalid when none can be built (no server).
' @param isLastForSession - true for a post made as the session ends: the side-effect thread
'   builds Authorization when it sends, after SignOut has cleared the user, so the header is
'   taken now (a request's own headers win over the one it builds)
function syncPlayRequest(action as string, body as dynamic, isLastForSession = false as boolean) as dynamic
  req = GetApi().BuildSyncPlayRequest(action, body)
  if not isValid(req)
    m.log.warn("no request for SyncPlay action", "action", action)
    return invalid
  end if
  if isLastForSession
    if not isValid(req.headers) then req.headers = {}
    req.headers.Authorization = buildAuthHeader()
  end if
  return req
end function

sub leaveLocally()
  m.syncTimer.control = "stop"
  m.convergeTimer.control = "stop"
  releaseCorrection()
  resetPlaybackTracking()
  m.timeSyncTask = releaseTask(m.timeSyncTask, "results")
  m.state = syncPlayState.newState()
  syncPlayOffset.reset(m.estimator)
  m.tracker = syncPlayPlayback.newReadyTracker()
  m.heldCommand = invalid
  m.lastCommand = invalid
  m.owedLoad = invalid
  m.expectingRemount = false
  m.loadAwaitsReady = false
  m.claimedStart = invalid
  releaseHeldPlay("left the group")
  m.queuedNext = invalid
  m.claimRefollowed = false
  m.joinAwaitsQueue = false
  m.loadNotice = invalid
  m.resumeAsked = false
  m.loadStartTicks = 0&
  m.failedBursts = 0
  releaseGroupRepeat()
  publish()
end sub

' Following ended (a halt or a leave), so what plays is the viewer's own: the repeat the group
' wrote onto the queue goes off, while a mode the viewer picked since, or a new queue, keeps its
' own (QueueManager.releaseRepeatMode). jellyfin-web restores its own queue on leave, so a group's
' mode never carries into local playback. A follow again writes the group's mode back
' (applyQueue). When the mode changed, an open OSD is told after the publish, as syncGroupModes
' does: it reads `sync` as it refreshes.
sub releaseGroupRepeat()
  queueManager = m.global.queueManager
  if not isValid(queueManager) then return
  if queueManager.callFunc("releaseRepeatMode", queueRepeat.BY_GROUP) <> true then return
  publish()
  host = playerHost()
  if isValid(host) then tellPlayer(host, { command: "queuechanged" })
end sub

sub publish()
  m.publishedPhase = trackerPhase()
  m.top.setFields({
    inGroup: m.state.inGroup,
    following: isFollowing(),
    playHeld: isValid(m.heldClaim),
    groupId: m.state.groupId,
    groupName: m.state.groupName,
    groupState: m.state.groupState,
    sync: {
      offsetMs: m.estimator.offsetMs,
      delayMs: m.estimator.delayMs,
      hasEstimate: m.estimator.hasEstimate,
      lastCommand: m.lastCommand,
      trackerPhase: m.publishedPhase,
      playingItemId: m.state.playingItemId,
      playingItemIndex: m.state.playingItemIndex,
      playlistCount: m.state.playlist.count(),
      loadNotice: m.loadNotice,
      playbackDiffMs: publishedDriftMs(),
      extraOffsetMs: m.estimator.extraOffsetMs,
      loadCount: m.loadCount,
      correctionsDone: m.correctionsDone + m.correctionsEnded,
      resumeShiftMs: m.resumeShiftMs,
      resumeShiftChanges: m.resumeShiftChanges,
      correctionInFlight: correctionInFlight(),
      groupSeeks: m.groupSeeks,
      readiesSent: m.readiesSent,
      unreachableNotices: m.unreachableNotices,
      pauseLandedMs: m.pauseLandedMs,
      shadowDisagreements: shadowCount(),
      engine: engineName(),
      repeatMode: m.state.repeatMode,
      shuffleMode: m.state.shuffleMode
    }
  })
end sub

' --- the viewer's controls ---

' The viewer pressed pause while following: the group is asked, and whatever this member was doing
' for the group gives way to it. A correction under way ends, or its timer would resume them. A seek
' in flight keeps the pause for its landing: a pause written to it can leave the node buffering for
' good (syncPlayPlayback.applyPlan).
' @returns whether the player should pause the node itself; true when not following
function viewerPause() as boolean
  ensureReady()
  if not isFollowing() then return true
  if usesComparison()
    ' The group is asked, and the comparison pauses the node as the viewer's own at once, or as
    ' the seek in flight lands: the player writes nothing itself. When the ask cannot be sent at
    ' all, the player pauses its own node, as outside a group.
    return not control({ kind: "pause" })
  end if
  control({ kind: "pause" })
  dropCorrection()
  m.correctionPauseOwed = false
  if not syncPlayPlayback.pauseWaitsForSeek(m.tracker.phase) then return true
  syncPlayPlayback.pauseAfterSeek(m.tracker)
  return false
end function

' Whether the viewer should take this member as paused (syncPlayPlayback.pausedForViewer).
' @param nodeState - the Video node's `state`
function pausedForViewer(nodeState as string) as boolean
  ensureReady()
  if usesComparison() then return comparePausedForViewer(nodeState)
  return syncPlayPlayback.pausedForViewer(nodeState, isValid(m.correction), m.tracker.showOsd)
end function

' Where the group is now, in ticks, from the last command in force run forward on the measured
' clock (syncPlayPlayback.groupPositionTicks); invalid while not following, while this member's
' own Buffering holds the group, or before any command names the playing item.
function groupPositionNow() as dynamic
  if not isFollowing() then return invalid
  if usesComparison()
    want = syncPlayGroup.wants(m.shadow.group, m.estimator, syncPlayTime.nowMs())
    if want.mode = "playing" then return want.positionTicks
    return want.pointTicks
  end if
  ' While this member's Buffering holds the group, it is paused where the server's Waiting
  ' update anchored it (anchorGroupPause), or nowhere known yet.
  if m.reportedBuffering then return m.groupPausedTicks
  reference = syncPlayPlayback.clockReference(m.lastCommand, m.state.playingItemId, false, m.state.playbackQueueAtMs)
  return syncPlayPlayback.groupPositionTicks(reference, m.estimator, syncPlayTime.nowMs())
end function

' The server's Waiting state update answered this member's Buffering: the group is paused where
' its clock stood when the server handled the report (syncPlayPlayback.groupPauseAnchorTicks).
' A load still in flight reports its Ready there. The log line is the anchor's own measurement:
' how far the group ran on past the estimate the report carried, and how long the report took.
' The group left its wait. The anchor was where it paused, so it ends here whatever comes next. A
' wait this member ended with a Ready while already playing gets no command back: the server sends
' its Unpause to the others alone (WaitingGroupState's recovering branch), so the one the others
' got is rebuilt here and becomes the clock reference, which turns the drift correction back on.
' A Ready sent paused is answered with an Unpause to every member, which arrives before this update
' and has cleared the Buffering already; any other case keeps waiting for the next command.
sub endGroupWait()
  anchor = m.groupPausedTicks
  m.groupPausedTicks = invalid
  if not m.reportedBuffering or m.state.groupState <> "Playing" then return
  if not isValid(anchor) or not isValid(m.lastReady) or m.lastReady.isPlaying <> true then return
  command = syncPlayPlayback.reconstructedUnpause(syncPlayTime.asLong(anchor), m.lastReady, m.state.playingItemId, m.state.groupId)
  m.lastCommand = command
  m.reportedBuffering = false
  syncPlayPlayback.armSettleCheck(m.settle)
  m.log.info("wait ended with no command: the group's Unpause rebuilt", "positionTicks", command.positionTicks.toStr(), "inMs", (command.whenMs - syncPlayOffset.serverNowMs(m.estimator, syncPlayTime.nowMs())).toStr())
  publish()
end sub

sub anchorGroupPause()
  nowMs& = syncPlayTime.nowMs()
  anchor = syncPlayPlayback.groupPauseAnchorTicks(m.lastCommand, m.state.playingItemId, m.state.playbackQueueAtMs, m.estimator, nowMs&)
  if not isValid(anchor) then return
  anchor& = syncPlayTime.asLong(anchor)
  m.groupPausedTicks = anchor&
  track({ kind: "groupPaused", positionTicks: anchor& })
  m.log.info("group paused for this member's buffering", "anchorTicks", anchor&.toStr(), "aheadOfReportMs", syncPlayTime.ticksToMs(anchor& - m.bufferingReportedTicks).toStr(), "reportLatencyMs", (nowMs& - m.bufferingSentAtMs).toStr())
end sub

' Where a reload in place starts while following: the group's position, so the node loads where
' the group is and the Ready it sends names the same place, with only the keyframe gap left for
' the drift correction, as at a late join. A member that fell behind (a stall, a stream the server
' stopped sending) would otherwise resume behind the group and be seek-corrected a few seconds
' later. The player's own start when the group's position is not known.
' @param playerStartTicks - where the player would start on its own: its position, or invalid
'   for a stream that has not played
function reloadStart(playerStartTicks as dynamic) as dynamic
  ensureReady()
  groupTicks = groupPositionNow()
  if isValid(groupTicks) then return syncPlayTime.asLong(groupTicks)
  return playerStartTicks
end function

' Whether a seek is in flight, so a pause the viewer presses now can wait for its landing.
function seekInFlight() as boolean
  ensureReady()
  return isFollowing() and syncPlayPlayback.pauseWaitsForSeek(trackerPhase())
end function

' A control the viewer pressed while following, asked of the group in place of the player:
' { kind: "pause" | "unpause" | "seek" | "next" | "previous" | "repeat" | "shuffle" | "timeOffset", position, mode },
' the seek's position in the Video node's float seconds, a repeat or shuffle pick's mode in the
' server's words (queueRepeat.bs, syncPlayQueue.SHUFFLE_ON). True when it was posted; the server's
' command then moves every member, this one included (a pause is also written locally by the
' player, as web does, so the viewer sees it land at once), and a mode comes back as a PlayQueue
' update that every member reads (syncGroupModes). Nothing is posted while halted, or while the
' group plays nothing: the player then keeps its own behavior.
function control(request as object) as boolean
  if not isValid(request) or not isFollowing() or m.state.playingItemId = "" then return false
  if request.kind = "repeat"
    if not syncPlayTime.isText(request.mode) then return false
    return post("SetRepeatMode", syncPlayRequests.setRepeatMode(queueRepeat.normalize(request.mode)))
  end if
  if request.kind = "shuffle"
    if not syncPlayTime.isText(request.mode) then return false
    return post("SetShuffleMode", syncPlayRequests.setShuffleMode(syncPlayQueue.normalizeShuffle(request.mode)))
  end if
  if request.kind = "timeOffset"
    ' Not posted: the offset is this viewer's own. The clock takes the saved setting now, and the settle
    ' check is armed so the next position notifications correct the drift the new offset made. While
    ' the group is paused nothing counts toward it, and the next Unpause arms it again.
    refreshExtraOffset()
    syncPlayPlayback.armSettleCheck(m.settle, true)
    shadowOffsetPicked()
    if usesComparison() then converge()
    publish()
    return true
  end if
  if usesComparison() and (request.kind = "pause" or request.kind = "unpause" or request.kind = "seek")
    return compareViewerAsk(request)
  end if
  if request.kind = "pause" or request.kind = "unpause" then shadowAsked(request.kind, invalid, true)
  if request.kind = "pause" then return post("Pause", invalid)
  if request.kind = "unpause" then return post("Unpause", invalid)
  if request.kind = "seek"
    if not isValid(request.position) then return false
    shadowAsked("seek", syncPlayPlayback.secondsToTicks(request.position), true)
    return post("Seek", syncPlayRequests.seek(syncPlayPlayback.secondsToTicks(request.position)))
  end if
  if request.kind = "next" then return post("NextItem", syncPlayRequests.nextItem(m.state.playingItemId))
  if request.kind = "previous" then return post("PreviousItem", syncPlayRequests.previousItem(m.state.playingItemId))
  return false
end function

' --- the comparison as the engine ---
'
' When the comparison decides (usesComparison), this file is a loop around it: each fact (a player
' event, a frame, a request's result, the timer) updates a model, converge() asks the comparison
' and carries out the one action it gives, and asks again until it gives none. No handler decides
' anything, so two events in either order end in the same place. Membership, the queue and its
' loads, the time sync and the menu are the same code under both engines.

function usesComparison() as boolean
  ' The `engine` field picks for one node: an RTA run sets it after each cold start, and a unit
  ' spec on the node it made. Nothing in the app writes it, so the constant decides there.
  if m.top.engine = "comparison" then return isValid(m.shadow)
  if m.top.engine = "manager" then return false
  return DECIDE_BY_COMPARISON
end function

function engineName() as string
  if usesComparison() then return "comparison"
  return "manager"
end function

' The ready tracker's phase, for the queue layer, the viewer's controls and the specs. Under the
' comparison it is the player model's activity in the tracker's words.
function trackerPhase() as string
  if not usesComparison() then return m.tracker.phase
  activity = m.shadow.player.activity
  if activity = "none" or activity = "finished" then return "idle"
  if activity = "loading" then return "loading"
  if activity = "seeking" then return "seeking"
  if activity = "arrived" then return "landing"
  if activity = "stalling" then return "stalling"
  if activity = "stalled" then return "rebuffering"
  return "ready"
end function

function trackerLoadStartTicks() as longinteger
  if not usesComparison() then return m.tracker.loadStartTicks
  return syncPlayTime.asLong(m.shadow.player.loadStartTicks)
end function

' How far this member sits from the group, in ms, positive when behind, or invalid when not
' known: under the comparison, the group's line against the player model's clock.
function publishedDriftMs() as dynamic
  if not usesComparison() then return m.playbackDiffMs
  player = m.shadow.player
  if player.activity <> "playing" or player.clock.measured <> true then return invalid
  nowMs& = syncPlayTime.nowMs()
  position = syncPlayPlayer.positionAt(player, nowMs&)
  want = syncPlayGroup.wants(m.shadow.group, m.estimator, nowMs&)
  if not isValid(position) or want.mode <> "playing" then return invalid
  return syncPlayTime.ticksToMs(syncPlayTime.asLong(want.positionTicks) - syncPlayTime.asLong(position))
end function

' Whether a correction of this member's own is under way: a catch-up's seek, or a hold.
function correctionInFlight() as boolean
  if not usesComparison() then return isValid(m.correction)
  player = m.shadow.player
  activity = player.activity
  if player.seekOwner = "hold" and (activity = "seeking" or activity = "arrived") then return true
  return player.pauseOwner = "hold" and (activity = "paused" or activity = "pausing" or activity = "resuming")
end function

' Whether the viewer should take this member as paused: the group is paused for them, or the node
' is paused for anything but a hold or a wait, neither of which is a pause anyone pressed.
function comparePausedForViewer(nodeState as string) as boolean
  player = m.shadow.player
  if player.pauseOwner = "hold" or player.pauseOwner = "wait" then return false
  want = syncPlayGroup.wants(m.shadow.group, m.estimator, syncPlayTime.nowMs())
  if want.mode = "paused" and not isValid(want.startsAtMs) then return true
  return nodeState = "paused"
end function

' A player event under the comparison: the models take the fact, and the comparison is asked.
function comparePlayerEvent(evt as object) as object
  kind = evt.kind
  if kind = "pauseWritten"
    ' The player wrote a pause of its own, outside any write of this manager's: the viewer's.
    ' It comes from inside the player's key handling, so the model only records it here.
    shadowPlayerFact(evt)
    return { following: isFollowing() }
  end if
  refreshExtraOffset()
  endUnansweredRefollow()
  if isValid(evt.position) then m.playerPositionTicks = syncPlayPlayback.secondsToTicks(evt.position)
  if isValid(evt.duration) then m.playerDurationSeconds = evt.duration
  if kind = "state" and syncPlayTime.isText(evt.state) then m.playerState = evt.state
  if kind = "mounted"
    m.expectingRemount = false
    m.playerState = ""
    m.playerPositionTicks = m.loadStartTicks
    shadowPlayerFact(evt)
    ' Only the group's item answers to the group: anything else the viewer started is their own.
    if isFollowing() and not syncPlayQueue.isGroupItem(m.global.queueManager.callFunc("getCurrentItem"), m.state.playingItemId)
      haltFollowing("a player mounted for an item the group is not playing")
    end if
  else if kind = "unmounted"
    m.playerState = ""
    syncPlayPlayer.unmounted(m.shadow.player, syncPlayTime.nowMs())
    wasExpected = m.expectingRemount
    m.expectingRemount = false
    m.log.info("player left", "expected", wasExpected, "following", isFollowing())
    ' Back during group playback, or an error that left the player.
    if not wasExpected and isFollowing() then haltFollowing("the player left while following")
  else
    shadowPlayerFact(evt)
  end if
  converge()
  return { following: isFollowing() }
end function

' The viewer's pause, play or seek under the comparison: the group is asked, the group model
' holds the ask until a command answers it, and the comparison acts on it at once (a pause
' lands on the node as the viewer's own).
' @returns whether the ask went out; false leaves the player to act by itself, as with no group
function compareViewerAsk(request as object) as boolean
  what = request.kind
  positionTicks = invalid
  if what = "seek"
    if not isValid(request.position) then return false
    positionTicks = syncPlayPlayback.secondsToTicks(request.position)
  end if
  action = { kind: "ask", what: what, positionTicks: positionTicks }
  ' Sent before the model is told, so that a send that cannot go leaves the model untouched: the
  ' request's number is the one applied() gives it below.
  if not sendRequest("ask", action, syncPlayGroup.nextRequestId(m.shadow.group)) then return false
  nowMs& = syncPlayTime.nowMs()
  syncPlayGroup.viewerAsked(m.shadow.group, what, positionTicks, nowMs&)
  syncPlayConverge.applied(m.shadow.player, m.shadow.group, action, nowMs&)
  converge()
  return true
end function

' Logs how long the group's Unpause leaves this member waiting where it stands: positive for a
' member ahead of the group's line, negative for one behind. It is the wait the comparison holds
' to aheadWaitMaxMs and behindBarMs for a paused node, so a log of it shows what those bars cost.
sub logUnpauseReach()
  nowMs& = syncPlayTime.nowMs()
  player = m.shadow.player
  position = syncPlayPlayer.positionAt(player, nowMs&)
  if not isValid(position) then return
  reachAt = syncPlayGroup.reachesAtMs(m.shadow.group, m.estimator, syncPlayTime.asLong(position))
  if not isValid(reachAt) then return
  waitMs& = syncPlayTime.asLong(reachAt) - nowMs&
  m.log.info("unpause reaches this member", "waitMs", waitMs&.toStr(), "activity", player.activity)
end sub

' Ask the comparison, carry out its one action, and ask again until it gives none. An event that
' arrives while this runs (the player answers a write from inside the write) only marks that
' another round is owed, so the loop is never entered twice.
sub converge()
  if not isValid(m.shadow) then return
  if m.converging
    m.convergeAgain = true
    return
  end if
  m.converging = true
  m.convergeTimer.control = "stop"
  player = m.shadow.player
  group = m.shadow.group
  policy = m.shadow.policy
  wakeAtMs = invalid
  hasSettled = false
  hasActed = false
  for attempt = 1 to CONVERGE_ROUNDS
    m.convergeAgain = false
    nowMs& = syncPlayTime.nowMs()
    syncPlayPlayer.advance(player, nowMs&)
    syncPlayGroup.advance(group, syncPlayTime.asLong(policy.requestLimitMs), nowMs&)
    result = syncPlayConverge.decide(player, group, shadowCtx(), policy, nowMs&)
    if isValid(result.action)
      hasActed = true
      carryOut(result.action)
    else if not m.convergeAgain
      wakeAtMs = result.wakeAtMs
      hasSettled = true
      exit for
    end if
  end for
  m.converging = false
  ' A correction is counted once, as the comparison settles with none under way: a catch-up whose
  ' landing still needs a hold is the same correction.
  isCorrecting = correctionInFlight()
  if m.wasCorrecting and not isCorrecting and hasSettled then m.correctionsEnded++
  if hasSettled then m.wasCorrecting = isCorrecting
  delayMs& = 1000&
  if hasSettled
    delayMs& = 0&
    if isValid(wakeAtMs) then delayMs& = syncPlayTime.asLong(wakeAtMs) - syncPlayTime.nowMs()
    if isValid(wakeAtMs) and delayMs& < 1 then delayMs& = 1&
  else
    m.log.warn("the comparison did not settle", "activity", player.activity, "rounds", CONVERGE_ROUNDS)
  end if
  if delayMs& > 0
    m.convergeTimer.duration = delayMs& / 1000#
    m.convergeTimer.control = "start"
  end if
  ' The RTA specs wait on the drift, so an RTA build publishes after every event: one field write
  ' on this render-owned node per position notification, which a release build does not pay.
  #if ENABLE_RTA
    hasActed = true
  #end if
  ' A phase change with no action still reaches the published field.
  if hasActed or trackerPhase() <> m.publishedPhase then publish()
end sub

sub onConvergeTimer()
  ensureReady()
  converge()
end sub

' Carry out one action of the comparison's, and tell the models it was done.
sub carryOut(action as object)
  kind = action.kind
  nowMs& = syncPlayTime.nowMs()
  player = m.shadow.player
  group = m.shadow.group
  host = playerHost()
  if kind = "pause" or kind = "resume" or kind = "seek"
    ' The drift the comparison acted on, for the log: read before the write changes the models.
    driftText = "unknown"
    drift = publishedDriftMs()
    if isValid(drift) then driftText = syncPlayTime.asLong(drift).toStr()
    byPick = group.pickPending
    syncPlayConverge.applied(player, group, action, nowMs&)
    if not isValid(host)
      m.log.warn("the comparison's write found no player", "kind", kind)
      return
    end if
    m.log.info("comparison wrote", kind, "owner", action.owner, "driftMs", driftText, "byPick", byPick)
    if kind = "pause"
      tellPlayer(host, { command: "pause", showOsd: action.showOsd = true }, action.owner)
    else if kind = "resume"
      tellPlayer(host, { command: "resume" }, action.owner)
    else
      ' A jump the viewer's own time offset pick caused reads as intended with a word.
      if action.byPick = true then notify("syncing", "", "")
      tellPlayer(host, { command: "seekto", position: syncPlayPlayback.ticksToSeconds(syncPlayTime.asLong(action.targetTicks)), report: false, thenPause: false }, action.owner)
    end if
  else if kind = "stop" or kind = "leave"
    syncPlayConverge.applied(player, group, action, nowMs&)
    m.loadAwaitsReady = false
    m.log.info("comparison closes the player", kind, "hasPlayer", isValid(host))
    ' Only a player that is there leaves for this: with none, the next unmount is the viewer's.
    if isValid(host)
      m.expectingRemount = true
      host.callFunc("exitPlayback")
    end if
  else if kind = "report" or kind = "ask"
    syncPlayConverge.applied(player, group, action, nowMs&)
    if not sendRequest(kind, action, group[kind].id) then syncPlayGroup.requestFailed(group, kind, action.what, group[kind].id)
  else if kind = "halt"
    haltFollowing(action.reason)
  else
    ' "settled" changes only the models. A notice also tells the viewer, once per outage: the
    ' requests keep going, and playback is left as it is.
    if kind = "settled"
      settledDrift = publishedDriftMs()
      if isValid(settledDrift) then m.log.info("time offset pick found the member in step", "driftMs", syncPlayTime.asLong(settledDrift).toStr())
    end if
    syncPlayConverge.applied(player, group, action, nowMs&)
    if kind = "notice"
      m.log.warn("the group cannot be reached", "report", group.report.what, "ask", group.ask.what)
      m.unreachableNotices++
      notify("unreachable", m.state.groupName, "")
    end if
  end if
end sub

' Send a Buffering, a Ready or an ask, and feed its result to the group model. The server answers
' with a frame, never in the reply, so the reply says only whether the request arrived.
' @param slot - "report" or "ask"
' @param requestId - the request's number in the group model, which its result is matched by:
'   `group[slot].id` once applied() has run, or syncPlayGroup.nextRequestId() before it
' @returns false when no request could be built
function sendRequest(slot as string, action as object, requestId as integer) as boolean
  what = action.what
  nowMs& = syncPlayTime.nowMs()
  whenMs& = syncPlayOffset.serverNowMs(m.estimator, nowMs&)
  positionTicks& = 0&
  if isValid(action.positionTicks) then positionTicks& = syncPlayTime.asLong(action.positionTicks)
  apiAction = ""
  body = invalid
  if what = "ready"
    apiAction = "Ready"
    body = syncPlayRequests.ready(whenMs&, positionTicks&, action.isPlaying = true, m.state.playingItemId)
    m.readiesSent++
    m.loadAwaitsReady = false
  else if what = "buffering"
    apiAction = "Buffering"
    body = syncPlayRequests.buffering(whenMs&, positionTicks&, action.isPlaying = true, m.state.playingItemId)
  else if what = "pause"
    apiAction = "Pause"
  else if what = "unpause"
    apiAction = "Unpause"
  else if what = "seek"
    apiAction = "Seek"
    body = syncPlayRequests.seek(positionTicks&)
  else if what = "next"
    apiAction = "NextItem"
    body = syncPlayRequests.nextItem(m.state.playingItemId)
  end if
  if apiAction = "" then return false
  req = syncPlayRequest(apiAction, body)
  if not isValid(req) then return false
  req.timeoutMs = m.shadow.policy.requestLimitMs
  m.requestCount++
  sentAtMs& = syncPlayTime.nowMs()
  m.log.info("sent", what, "positionTicks", positionTicks&.toStr(), "isPlaying", action.isPlaying = true)
  ' The id opens with the request's own name ("syncPlaySeek"), which is what a spec's
  ' request-failure rule matches.
  promiseId = "syncPlay" + apiAction + "-" + m.requestCount.toStr()
  promises.chain(fetchAsync(req, promiseId), { slot: slot, what: what, id: requestId, sentAtMs: sentAtMs& }).then(sub(res as object, ctx as object)
    statusCode = 0
    if isValid(res) and isValid(res.statusCode) then statusCode = res.statusCode
    onRequestResult(ctx.slot, ctx.what, ctx.id, statusCode, syncPlayTime.nowMs() - syncPlayTime.asLong(ctx.sentAtMs))
  end sub).catch(sub(_err as object, ctx as object)
    onRequestResult(ctx.slot, ctx.what, ctx.id, 0, syncPlayTime.nowMs() - syncPlayTime.asLong(ctx.sentAtMs))
  end sub)
  return true
end function

' A request's result. A 2xx arrived. A 4xx to an ask is the server's refusal: it heard the ask
' and said no, so sending it again is noise, and it counts as answered. Anything else (no reply
' in time, a transport error, a 5xx, a 4xx to a report the group waits for) failed, and goes
' again while it is still wanted.
' @param id - the request's number in the group model; a result for an earlier try is ignored there
' @param statusCode - the HTTP status, 0 with none
' @param tookMs - how long the result took, for the log: what the request limit is judged against
sub onRequestResult(slot as string, what as string, id as integer, statusCode as integer, tookMs as longinteger)
  if not isValid(m.shadow) then return
  hasArrived = statusCode >= 200 and statusCode < 300
  wasRefused = slot = "ask" and statusCode >= 400 and statusCode < 500
  if hasArrived or wasRefused
    if wasRefused then m.log.warn("ask refused by the server", "what", what, "status", statusCode)
    if hasArrived then m.log.info("request answered", "what", what, "tookMs", tookMs.toStr())
    syncPlayGroup.requestArrived(m.shadow.group, slot, what, id)
  else
    m.log.warn("request failed", "what", what, "status", statusCode, "tookMs", tookMs.toStr())
    syncPlayGroup.requestFailed(m.shadow.group, slot, what, id)
  end if
  converge()
end sub
