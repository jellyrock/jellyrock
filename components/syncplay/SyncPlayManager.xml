<?xml version="1.0" encoding="utf-8"?>
<!--
  SyncPlayManager: the SyncPlay coordinator, one instance on m.global.syncPlayManager, created
  by setGlobalNodes(). Render-thread owned, so the player, the host and the queue are cheap to
  reach and a Timer fires where the command is applied. It holds the membership state
  (syncPlayState), the clock-offset estimate (syncPlayOffset) and the ready tracker
  (syncPlayPlayback); frames arrive on `frame` from remoteDispatch.dispatchSyncPlay on the main
  thread, and player events arrive through playerEvent() from PlayerHostView and VideoPlayerView.
-->
<component name="SyncPlayManager" extends="Node">
  <interface>
    <!-- A normalized SyncPlay frame (syncPlayMessage's "syncplaycommand" or "syncplayupdate").
         alwaysNotify: two identical frames are two frames. -->
    <field id="frame" type="assocarray" alwaysNotify="true" onChange="onFrame" />

    <!-- Published state, written together once per change. The player and the host read
         `following`; the group menu (phase D) and an ODC spec read the rest. -->
    <field id="inGroup" type="boolean" value="false" />
    <!-- In a group and following its playback: the local auto-behaviors stand down and the
         player answers to the group. False when halted (Back during group playback). -->
    <field id="following" type="boolean" value="false" />
    <!-- A halted member's play waits on the viewer's answer (claimPlay's confirmPlay notice).
         JRScene closes the dialog asking it when this clears without an answer. -->
    <field id="playHeld" type="boolean" value="false" />
    <field id="groupId" type="string" value="" />
    <field id="groupName" type="string" value="" />
    <field id="groupState" type="string" value="" />
    <!-- { offsetMs, delayMs, hasEstimate, lastCommand, trackerPhase, playingItemId, playingItemIndex,
         playlistCount, loadNotice, playbackDiffMs (how far behind the group this member sits, ms, invalid
         until an Unpause is in force; refreshed at each position notification in RTA builds only, otherwise whenever something else publishes), extraOffsetMs (the
         viewer's time offset setting), loadCount (the loads performed for queue frames, a monotonic count), correctionsDone (the drift corrections that ran to their resume, a monotonic count), groupSeeks (the Seek commands the group sent while this member followed, a monotonic count), readiesSent (the Ready reports this member sent, a monotonic count), repeatMode and shuffleMode (the group's, in the server's words,
         from the last queue update) } -->
    <field id="sync" type="assocarray" />
    <!-- Something the viewer is told: { kind, groupName, userName }; a confirmPlay notice also
         carries title (the formatted title of the video to play, "" for none) and moreCount (the
         videos after it in a new queue). kind is joined, left, leftStale,
         userJoined, userLeft, groupStarted, confirmPlay, playedToGroup, followingAgain, alreadyWatching (a play of the video the member's player is already on: it keeps playing), queuedNext (the group took the videos a catch-up added; it also carries count), syncing, halted, or a refusal's update type
         (GroupDoesNotExist, LibraryAccessDenied, CreateGroupDenied, JoinGroupDenied). JRScene
         turns it into a toast; the manager holds no translation. alwaysNotify: two notices of
         one kind in a row are two. -->
    <field id="notice" type="assocarray" alwaysNotify="true" />

    <!-- POST /SyncPlay/Join { GroupId }: the GroupJoined frame confirms it. -->
    <function name="join" />
    <!-- newGroup(groupName): create a group named so and join it. -->
    <function name="newGroup" />
    <!-- POST /SyncPlay/Leave: the GroupLeft frame confirms it. -->
    <function name="leave" />
    <!-- claimPlay(start): QueueManager.playQueue asks, while in a group, whether the group takes
         the play, passing the playback start the press opened. True when it was posted
         (SetNewQueue or SetPlaylistItem) and no local player should start; false when it plays
         locally. The claim lasts as long as that start. A play of the video the group is playing
         posts nothing and loads it at the group's position, and adds the videos queued after it
         right after the group's (QueueNext). A halted member's other plays are
         held with a confirmPlay notice until one of the two below, or until playHeld clears. -->
    <function name="claimPlay" />
    <!-- castToGroup(item): a cast over this member's player while it follows the group
         (JRScene.onDeepLinkResolved). The group takes it as this viewer's own play, without the
         local queue being replaced first, so a refusal leaves the queue and its picks as they
         were. A cast of the video the player is already on in step only tells the viewer (an
         alreadyWatching notice). False when the group cannot take it: its start is ended, and
         the cast goes the usual way. -->
    <function name="castToGroup" />
    <!-- confirmPlay(): the viewer confirmed the held play; it follows the group again and posts.
         cancelPlay(): the viewer kept the group's playback; the start the press opened ends.
         Both answer false when nothing is held any more. -->
    <function name="confirmPlay" />
    <function name="cancelPlay" />
    <!-- Sign-out and server switch: POST /SyncPlay/Leave while in a group, then forget it and
         stop every timer and task. -->
    <function name="reset" />
    <!-- leaveStaleMembership(): at launch, POST /SyncPlay/Leave for the group the registry says
         the last session was in; true when one was posted. -->
    <function name="leaveStaleMembership" />
    <!-- resumeFollowing(): a halted member follows the group again from the menu and loads the
         group's item at its estimated position; true when it was halted in a group. -->
    <function name="resumeFollowing" />
    <!-- { kind: "mounted" | "reloaded" | "state" | "position" | "finished" | "unmounted", state,
         position, startSeconds } from the host and the player, position in the Video node's float
         seconds; "reloaded" (the player loading its stream again in place) carries the
         startSeconds it reloads from. -->
    <function name="playerEvent" />
    <!-- control({ kind: "pause" | "unpause" | "seek" | "next" | "previous" | "repeat" | "shuffle" |
         "timeOffset", position, mode }): a control the viewer pressed while following, posted to the
         group in place of the player; a seek's position in the Video node's float seconds, a mode
         pick's mode in the server's words. A timeOffset posts nothing: the manager takes the saved
         setting and corrects the drift it makes. True when posted or taken. -->
    <function name="control" />
    <!-- viewerPause(): the viewer pressed pause while following. Posts it and answers whether the
         player should pause the node itself; false while a seek's landing will. -->
    <function name="viewerPause" />
    <!-- pausedForViewer(nodeState): whether the viewer should take this member as paused, which a
         drift correction's hold is not. -->
    <function name="pausedForViewer" />
    <!-- seekInFlight(): whether a pause pressed now can wait for a seek's landing. -->
    <function name="seekInFlight" />
  </interface>
  <children>
    <!-- The one scheduled command: a new command replaces a pending one. -->
    <Timer id="commandTimer" repeat="false" />
    <!-- The next time-sync burst while in a group. -->
    <Timer id="syncTimer" repeat="false" />
    <!-- The seek-settle budget: Ready goes out with the position in hand when it fires. -->
    <Timer id="readyTimer" repeat="false" />
    <!-- Confirms a pause took while the group is paused: re-pauses a player that plays on. -->
    <Timer id="pauseTimer" repeat="false" />
    <!-- A drift correction's resume: fires when the group reaches where the member paused, after
         a seek ahead when it was behind (syncPlayPlayback.correctionPlan). Until the node reports
         `paused`, it ends a correction whose pause never lands. -->
    <Timer id="correctionTimer" repeat="false" />
  </children>
</component>
