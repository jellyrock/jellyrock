<?xml version="1.0" encoding="utf-8"?>
<!--
  SyncPlayManager: the SyncPlay coordinator, one instance on m.global.syncPlayManager, created
  by setGlobalNodes(). Render-thread owned, so the player, the host and the queue are cheap to
  reach and a Timer fires where the command is applied. It holds the membership state
  (syncPlayState), the clock-offset estimate (syncPlayOffset) and the ready tracker
  (syncPlayPlayback); frames arrive on `frame` from remoteDispatch.dispatchSyncPlay on the main
  thread, and player events arrive through playerEvent() from PlayerHostView and VideoPlayerView.
-->
<component name="SyncPlayManager" extends="Node">
  <interface>
    <!-- A normalized SyncPlay frame (syncPlayMessage's "syncplaycommand" or "syncplayupdate").
         alwaysNotify: two identical frames are two frames. -->
    <field id="frame" type="assocarray" alwaysNotify="true" onChange="onFrame" />

    <!-- Published state, written together once per change. The player and the host read
         `following`; the group menu (phase D) and an ODC spec read the rest. -->
    <field id="inGroup" type="boolean" value="false" />
    <!-- In a group and following its playback: the local auto-behaviors stand down and the
         player answers to the group. False when halted (Back during group playback). -->
    <field id="following" type="boolean" value="false" />
    <field id="groupId" type="string" value="" />
    <field id="groupName" type="string" value="" />
    <field id="groupState" type="string" value="" />
    <!-- { offsetMs, delayMs, hasEstimate, lastCommand, trackerPhase, playingItemId, loadNotice } -->
    <field id="sync" type="assocarray" />
    <!-- Something the viewer is told: { kind, groupName, userName }. kind is joined, left, leftStale,
         userJoined, userLeft, groupStarted, playedToGroup, followingAgain, halted, or a refusal's update type
         (GroupDoesNotExist, LibraryAccessDenied, CreateGroupDenied, JoinGroupDenied). JRScene
         turns it into a toast; the manager holds no translation. alwaysNotify: two notices of
         one kind in a row are two. -->
    <field id="notice" type="assocarray" alwaysNotify="true" />

    <!-- POST /SyncPlay/Join { GroupId }: the GroupJoined frame confirms it. -->
    <function name="join" />
    <!-- newGroup(groupName): create a group named so and join it. -->
    <function name="newGroup" />
    <!-- POST /SyncPlay/Leave: the GroupLeft frame confirms it. -->
    <function name="leave" />
    <!-- claimPlay(start): QueueManager.playQueue asks, while in a group, whether the group takes
         the play, passing the playback start the press opened. True when it was posted
         (SetNewQueue or SetPlaylistItem) and no local player should start; false when it plays
         locally. The claim lasts as long as that start. -->
    <function name="claimPlay" />
    <!-- Sign-out and server switch: POST /SyncPlay/Leave while in a group, then forget it and
         stop every timer and task. -->
    <function name="reset" />
    <!-- leaveStaleMembership(): at launch, POST /SyncPlay/Leave for the group the registry says
         the last session was in; true when one was posted. -->
    <function name="leaveStaleMembership" />
    <!-- { kind: "mounted" | "state" | "position" | "finished" | "unmounted", state, position }
         from the host and the player, position in the Video node's float seconds. -->
    <function name="playerEvent" />
  </interface>
  <children>
    <!-- The one scheduled command: a new command replaces a pending one. -->
    <Timer id="commandTimer" repeat="false" />
    <!-- The next time-sync burst while in a group. -->
    <Timer id="syncTimer" repeat="false" />
    <!-- The seek-settle budget: Ready goes out with the position in hand when it fires. -->
    <Timer id="readyTimer" repeat="false" />
    <!-- Confirms a pause took while the group is paused: re-pauses a player that plays on. -->
    <Timer id="pauseTimer" repeat="false" />
  </children>
</component>
