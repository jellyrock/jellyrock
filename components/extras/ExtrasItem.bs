import "pkg:/source/utils/itemImageUrl.bs"
import "pkg:/source/utils/misc.bs"

sub init()
  initPosterImg()
  initName()
  initRole()
end sub

sub initPosterImg()
  m.posterImg = m.top.findNode("posterImg")
end sub

sub initName()
  m.name = m.top.findNode("pLabel")
end sub

sub initRole()
  m.role = m.top.findNode("subTitle")
end sub

sub showContent()
  ' validate nodes to prevent crash
  if not isValid(m.posterImg) then initPosterImg()
  if not isValid(m.name) then initName()
  if not isValid(m.role) then initRole()

  ' Clear previous item's watched badge and progress bar
  if isValid(m.posterImg) then m.posterImg.callFunc("resetBadge")

  if isValid(m.top.itemContent)
    cont = m.top.itemContent
    ' width is declared in ExtrasItem.xml (default 234) and set by RowList per rowItemSize.
    ' Using a declared field guarantees it is never Invalid (unlike m.top.width on Group nodes).
    slotWidth = m.top.width
    ' Episodes: show series name as primary title (matches HomeItem behavior).
    ' The pre-computed subtitle already contains "S{x}E{y} - {episodeName}".
    m.name.text = (cont.type = "Episode") ? cont.seriesName : cont.name
    m.name.maxWidth = slotWidth
    m.role.maxWidth = slotWidth
    posterWidth = int(slotWidth)
    posterHeight = int(m.posterImg.height)
    posterSize = { width: posterWidth, height: posterHeight }
    ' Set display and decode dimensions BEFORE uri — Roku uses loadWidth/loadHeight at fetch time.
    ' Override JRPoster's default scaleToZoom so mismatched aspect ratios show black bars.
    m.posterImg.width = posterWidth
    m.posterImg.loadWidth = posterWidth
    m.posterImg.loadHeight = posterHeight
    ' m.posterImg.loadDisplayMode = "scaleToFit"
    m.posterImg.uri = getItemPosterUrl(cont, posterSize)
    ' Watched badge and progress bar (mirrors HomeItem behavior)
    if cont.isWatched
      m.posterImg.isWatched = true
    else if cont.type = "Series" and cont.unplayedItemCount > 0
      m.posterImg.unplayedCount = cont.unplayedItemCount
    end if
    m.posterImg.playedPercentage = cont.playedPercentage
    m.role.text = cont.subtitle
  else
    m.role.text = tr("Unknown")
    m.posterImg.uri = "pkg:/images/icons/baseline_person_white_48dp.png"
  end if
end sub

sub focusChanged()
  if m.top.itemHasFocus = true
    m.name.repeatCount = -1
    m.role.repeatCount = -1
  else
    m.name.repeatCount = 0
    m.role.repeatCount = 0
  end if

  if m.global.device.isAudioGuideEnabled = true
    txt2Speech = CreateObject("roTextToSpeech")
    txt2Speech.Flush()
    txt2Speech.Say(m.name.text)
    txt2Speech.Say(m.role.text)
  end if
end sub
