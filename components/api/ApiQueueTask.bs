import "pkg:/source/api/apiFaults.bs"
import "pkg:/source/api/apiPool.bs"
import "pkg:/source/constants/apiPool.bs"
import "pkg:/source/roku_modules/log/LogMixin.brs"
import "pkg:/source/utils/misc.bs"

sub init()
  m.log = new log.Logger("ApiQueueTask")
  m.top.functionName = "runQueueLoop"
end sub

' FIFO request queue coordinator (Architecture C — continuous-server).
'
' Receives ApiResultNode children appended by fetchRes() callers. Each node carries
' the request AA on its 'request' field. The coordinator reads ALL unprocessed
' children when woken up, dispatches each to the first free ApiTask pool slot, then
' routes the completed response back to the ApiResultNode so the orchestrator unblocks.
'
' A queued READ whose caller has stopped waiting is completed as abandoned instead of
' being sent, so the slot goes to the next request. The decision — including which
' entries are worth the cross-thread check at all — is apiPoolNextDispatch in
' apiPool.bs ("Skipping a request nobody is waiting for"); this file is its shell.
'
' Why children instead of a shared field:
'   SceneGraph can coalesce port events when multiple Task threads write to the same
'   field in rapid succession — the coordinator would see fewer events than writes,
'   silently losing requests. Children are immune: even if wakeup events coalesce,
'   the coordinator reads ALL pending children from the node tree, so no request is
'   ever lost regardless of timing.
'
' Startup ordering guarantee:
'   1. Each ApiTask pool slot sets isReady=true after registering its request observer.
'   2. This coordinator waits for ALL pool slots to be ready before registering its
'      own observers and setting isReady=true.
'   3. fetchRes() waits for this coordinator's isReady=true before appending children.
'   Result: pool observers → coordinator ready → fetchRes appends.  No startup race.
'
' Thread safety:
'   Only this task thread reads/writes m.queue, m.inFlight, and m.processedIndex —
'   no TOCTOU race. Child appends from other threads go through SceneGraph rendezvous.
sub runQueueLoop()
  m.queue = []
  #if perfTiming
    ' Per-window dispatch cost (see emitDispatchWindow).
    m.dispatchClock = CreateObject("roTimespan")
    m.dispatchEntries = 0
    m.dispatchSkipped = 0
    m.dispatchWaited = 0
    m.dispatchCheckUs = 0
    m.dispatchSendUs = 0
    m.deliverUs = 0
    m.deliverCount = 0
  #end if
  ' Index of the next unprocessed child node (children accumulate, never re-processed)
  m.processedIndex = 0

  pool = resolvePoolSlots()
  ' One entry per pool slot: invalid = free, AA entry = in-flight
  m.inFlight = []
  for each slot in pool
    m.inFlight.push(invalid)
  end for

  ' ── Wait for all pool tasks to register their request observers ──
  ' Without this, dispatching a request to a slot that hasn't called
  ' observeField("request", port) yet would silently drop the write —
  ' the slot would never wake up, m.inFlight would never clear, and
  ' the slot would be permanently dead for the rest of the session.
  '
  ' Strategy: observe ready on all not-yet-ready slots, then check ACTUAL
  ' field state in each iteration (never count events — event counting is
  ' vulnerable to double-counting when a slot becomes ready between
  ' observeField() and a subsequent field read).
  waitPort = CreateObject("roMessagePort")
  for each slot in pool
    if not slot.isReady
      slot.observeField("isReady", waitPort)
    end if
  end for
  ' Check actual state until every slot is ready. Events just wake us up.
  for attempts = 0 to 50
    allReady = true
    for each slot in pool
      if not slot.isReady
        allReady = false
        exit for
      end if
    end for
    if allReady then exit for
    ' At least one slot isn't ready — wait for any ready event to recheck.
    ' 5s timeout per attempt; pool tasks start before us so this is fast.
    wait(5000, waitPort)
  end for
  for each slot in pool
    slot.unobserveField("isReady")
  end for

  ' ── Now safe to accept requests ──
  port = CreateObject("roMessagePort")
  m.top.observeField("enqueue", port)
  #if ENABLE_RTA
    ' Requests an RTA spec makes fail or slow (see answeredOnPurpose). Read here and on each
    ' change, never per request: this loop is serial for every request the app makes.
    m.failRequests = apiFaults.fromRules(m.global.rtaFailRequests)
    m.global.observeField("rtaFailRequests", port)
    ' Answers to slowed requests that arrived before they are due (see heldOnPurpose).
    m.rtaClock = CreateObject("roTimespan")
    m.rtaHeld = []
  #end if
  ' Signal readiness AFTER pool slots are confirmed ready and our enqueue
  ' observer is registered. fetchRes() callers waiting on this flag can
  ' now safely append children — the full pipeline is operational.
  m.top.isReady = true

  ' Store node IDs so we can match response events back to slot indices.
  ' msg.getNode() returns the ID string of the node whose field changed.
  m.slotNodeIds = []
  for each slot in pool
    m.slotNodeIds.push(slot.id)
  end for

  ' Observe each pool slot's response field so we know when a slot completes.
  for each slot in pool
    slot.observeField("response", port)
  end for

  ' Process any children that were appended BEFORE the enqueue observer was
  ' registered. If fetchRes() callers bypassed the ready guard (e.g. ready
  ' became true between their check and the appendChild), their wakeup events
  ' were lost because our observer wasn't registered yet. Reading children
  ' here catches those stragglers — the node tree is the source of truth.
  processNewChildren(pool)

  while true
    ' 0 waits for the next event however long it takes. An RTA build holding a slowed answer
    ' wakes when it is due instead (a timeout returns invalid, and the loop carries on).
    waitMs = 0
    #if ENABLE_RTA
      waitMs = apiFaults.nextWaitMs(m.rtaHeld, m.rtaClock.totalMilliseconds())
    #end if
    msg = wait(waitMs, port)
    if type(msg) = "roSGNodeEvent"
      field = msg.getField()
      #if ENABLE_RTA
        if field = "rtaFailRequests"
          m.failRequests = apiFaults.fromRules(msg.getData())
          m.log.info("request failure rules set", "rules", m.failRequests.count())
        end if
      #end if

      if field = "enqueue"
        ' Wake-up signal from fetchRes — actual data is in children, not here.
        ' processNewChildren below handles it.

      else if field = "response"
        ' A pool slot finished. Find which slot by matching node ID.
        nodeId = msg.getNode()
        slotIdx = -1
        for i = 0 to m.slotNodeIds.count() - 1
          if m.slotNodeIds[i] = nodeId
            slotIdx = i
            exit for
          end if
        end for

        if slotIdx >= 0
          entry = m.inFlight[slotIdx]
          if isValid(entry)
            isHeld = false
            #if ENABLE_RTA
              isHeld = heldOnPurpose(slotIdx, entry, msg.getData())
            #end if
            if not isHeld then deliverResponse(slotIdx, entry, msg.getData())
          end if
        end if
      end if
    end if

    #if ENABLE_RTA
      ' Before the children below, so a slot a due answer frees is dispatched to at once.
      for each answer in apiFaults.takeDue(m.rtaHeld, m.rtaClock.totalMilliseconds())
        deliverResponse(answer.slotIdx, answer.entry, answer.response)
      end for
    #end if

    ' Always process new children when woken up (by ANY event type).
    ' This is the key coalescing defense: even if multiple enqueue wakeup
    ' events merged into one, we read ALL unprocessed children here.
    processNewChildren(pool)
  end while
end sub

' Hands a slot's answer to the orchestrator's result node and frees the slot.
' Result is written before done, so it is readable when the observer fires.
sub deliverResponse(slotIdx as integer, entry as object, response as dynamic)
  #if perfTiming
    m.dispatchClock.mark()
  #end if
  entry.resultNode.result = response
  entry.resultNode.isDone = true
  #if perfTiming
    m.deliverUs += m.dispatchClock.totalMicroseconds()
    m.deliverCount++
    emitDispatchWindow(0)
  #end if
  m.inFlight[slotIdx] = invalid
end sub

' The pool's width is chosen per device class (apiPool.widthFor, stored as
' m.global.apiPoolWidth), but its slots are separately named globals (apiPool0,
' apiPool1, ...) that setGlobalNodes() in source/utils/globals.bs creates one guarded
' block at a time — `no-task-fanout` rejects launching fresh Task nodes in a loop.
' Nothing else ties those blocks to the width, so they are checked against it here, in
' both directions. A slot the width expects but globals.bs never created (a width raised
' past the blocks that exist) would dispatch to invalid; one created beyond the width is a
' thread that runs for the whole session and is never used.
function resolvePoolSlots() as object
  width = apiPool.currentWidth()
  pool = []
  for i = 0 to width - 1
    slot = m.global.getField("apiPool" + i.toStr())
    if not isValid(slot)
      m.log.error("API pool slot missing: globals.bs creates fewer slots than the pool width", { missingSlot: i, width: width })
      exit for
    end if
    pool.push(slot)
  end for
  if m.global.hasField("apiPool" + width.toStr())
    m.log.error("API pool slot unused: globals.bs creates more slots than the pool width", { width: width })
  end if
  return pool
end function

' Read all unprocessed children (ApiResultNodes appended by fetchRes callers),
' extract their request AAs, add to the internal FIFO queue, and dispatch.
' Periodically prunes processed children to prevent unbounded accumulation.
sub processNewChildren(pool as object)
  childCount = m.top.getChildCount()
  while m.processedIndex < childCount
    child = m.top.getChild(m.processedIndex)
    m.processedIndex++
    if isValid(child) and isValid(child.request)
      entry = { req: child.request, resultNode: child, waited: false }
      #if ENABLE_RTA
        if answeredOnPurpose(entry) then continue while
      #end if
      m.queue.Push(entry)
    end if
  end while
  tryDispatch(pool)

  ' Prune processed children to prevent unbounded node accumulation in long sessions.
  ' Safe: entry objects (in m.queue/m.inFlight) and fetchRes() callers hold direct node
  ' references — removing from the child tree only detaches the parent link; node fields
  ' and observers remain valid until all references are dropped.
  if m.processedIndex >= 50
    m.top.removeChildrenIndex(m.processedIndex, 0)
    m.processedIndex = 0
  end if
end sub

' Dispatch queued requests to free pool slots (FIFO).
' Only ever called from this coordinator's task thread — no concurrent access.
sub tryDispatch(pool as object)
  while true
    #if perfTiming
      m.dispatchClock.mark()
    #end if
    pick = apiPoolNextDispatch(m.queue, m.inFlight)
    #if perfTiming
      m.dispatchCheckUs += m.dispatchClock.totalMicroseconds()
    #end if
    if not isValid(pick) then return

    if pick.slot < 0
      ' Completed as abandoned instead of sent; the slot it would have taken stays free
      ' (apiPool.bs, "Skipping a request nobody is waiting for").
      m.log.info("skipped a queued request whose caller is gone", pick.entry.req.requestId)
      #if perfTiming
        m.dispatchSkipped++
        emitDispatchWindow(1)
      #end if
      continue while
    end if

    #if perfTiming
      if pick.entry.waited then m.dispatchWaited++
      m.dispatchClock.mark()
    #end if
    ' Writing request triggers ApiTask's port observer, starting execution.
    pool[pick.slot].request = pick.entry.req
    #if ENABLE_RTA
      ' A slowed request is due its hold time after it is SENT, as a slow server's would be.
      if isValid(pick.entry.rtaHoldMs) then pick.entry.rtaDueAt = m.rtaClock.totalMilliseconds() + pick.entry.rtaHoldMs
    #end if
    #if perfTiming
      m.dispatchSendUs += m.dispatchClock.totalMicroseconds()
      emitDispatchWindow(1)
    #end if
  end while
end sub

#if ENABLE_RTA
  ' Applies the rule an RTA spec set for a queued request (m.global.rtaFailRequests), so a spec
  ' can drive a screen's failure and slow-server paths against a healthy, fast server. Decides
  ' from the request AA already in `entry`: no node read is added to this loop.
  '
  ' A failure is answered here, exactly as a slot's answer would be, and never takes a slot:
  ' true, the request is done. A slow request is marked with how long to hold its answer and
  ' queued like any other (false); tryDispatch stamps when it is due, heldOnPurpose holds it.
  function answeredOnPurpose(entry as object) as boolean
    if m.failRequests.count() = 0 then return false
    fault = apiFaults.take(m.failRequests, entry.req.requestId)
    if not isValid(fault) then return false

    if apiFaults.isSlow(fault)
      m.log.info("slowing a request on purpose", entry.req.requestId, "ms", fault.ms)
      entry.rtaHoldMs = fault.ms
      return false
    end if

    m.log.info("failed a request on purpose", entry.req.requestId, "kind", fault.kind)
    entry.resultNode.result = apiFaults.responseFor(fault, entry.req.requestId)
    entry.resultNode.isDone = true
    return true
  end function

  ' Holds a slowed request's answer when it arrives before it is due. Its slot stays in flight
  ' until the loop delivers it, so the pool is as busy as a slow server would keep it.
  function heldOnPurpose(slotIdx as integer, entry as object, response as dynamic) as boolean
    if not isValid(entry.rtaDueAt) then return false
    if m.rtaClock.totalMilliseconds() >= entry.rtaDueAt then return false
    m.rtaHeld.push({ slotIdx: slotIdx, entry: entry, response: response, dueAt: entry.rtaDueAt })
    return true
  end function
#end if

#if perfTiming
  ' One line per DISPATCH_WINDOW entries taken off the queue: what the coordinator
  ' spent per entry deciding whether to skip it (`check`), handing it to a slot
  ' (`send`), and delivering answers back (`deliver`, counted per response, so its
  ' window is the same entries seen from the other end). Read by the `api-dispatch`
  ' measurement family in scripts/measurements.js.
  sub emitDispatchWindow(dispatched as integer)
    DISPATCH_WINDOW = 5
    m.dispatchEntries += dispatched
    if m.dispatchEntries < DISPATCH_WINDOW and m.deliverCount < DISPATCH_WINDOW then return

    #if debug
      buildFlags = " [debug=true perfTiming=true]"
    #else
      buildFlags = " [debug=false perfTiming=true]"
    #end if
    m.log.info("api-dispatch window entries " + m.dispatchEntries.toStr() + " waited " + m.dispatchWaited.toStr() + " skipped " + m.dispatchSkipped.toStr() + " delivered " + m.deliverCount.toStr() + buildFlags, "check", m.dispatchCheckUs, "send", m.dispatchSendUs, "deliver", m.deliverUs)

    m.dispatchEntries = 0
    m.dispatchSkipped = 0
    m.dispatchWaited = 0
    m.dispatchCheckUs = 0
    m.dispatchSendUs = 0
    m.deliverUs = 0
    m.deliverCount = 0
  end sub
#end if
