<?xml version="1.0" encoding="utf-8"?>

<component name="ApiTask" extends="Task">
  <interface>
    <field id="request" type="assocarray" />
    <field id="response" type="assocarray" />
    <!--
      Set to true by runApiLoop() immediately after registering the request
      observer. The ApiQueueTask coordinator waits for all pool slots to be
      ready before it starts dispatching — this prevents the startup race
      where a request field write arrives before the observer is registered.
    -->
    <field id="isReady" type="boolean" value="false" />
    <!--
      Set to true by the coordinator to stop the request in flight: its caller has gone
      (apiPool.bs, "Stopping a request nobody is waiting for"). roku-requests reads
      `m.top.quit` on every pass of its wait and cancels the transfer when it is true, so the
      slot answers "no answer" at once. The coordinator sets it back to false before it sends
      this slot another request.
    -->
    <field id="quit" type="boolean" value="false" />
  </interface>
</component>
