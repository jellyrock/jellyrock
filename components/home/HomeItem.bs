import "pkg:/source/api/baserequest.bs"
import "pkg:/source/api/Image.bs"
import "pkg:/source/constants/imageSize.bs"
import "pkg:/source/roku_modules/log/LogMixin.brs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/itemImageUrl.bs"
import "pkg:/source/utils/misc.bs"

sub init()
  m.log = log.Logger("HomeItem")

  initItemText()
  initItemPoster()
  initItemIcon()
  initItemTextExtra()
  m.itemPoster.observeField("loadStatus", "onPosterLoadStatusChanged")
  m.itemIcon.observeField("loadStatus", "onIconLoadStatusChanged")
  initBackdrop()
end sub

sub initItemText()
  m.itemText = m.top.findNode("itemText")
end sub

sub initItemPoster()
  m.itemPoster = m.top.findNode("itemPoster")
end sub

sub initItemTextExtra()
  m.itemTextExtra = m.top.findNode("itemTextExtra")
end sub

sub initBackdrop()
  m.backdrop = m.top.findNode("backdrop")
end sub

sub initBackdropText()
  m.top.appendChild(createBackdropText())
end sub

function createBackdropText() as object
  backdropText = m.top.findNode("backdropText")
  if isValid(backdropText) then return backdropText

  backdropText = CreateObject("roSGNode", "LabelPrimaryLarger")
  backdropText.id = "backdropText"
  backdropText.bold = true
  backdropText.width = 446
  backdropText.height = 231
  backdropText.translation = [9, 9]
  backdropText.horizAlign = "center"
  backdropText.vertAlign = "center"
  backdropText.ellipsizeOnBoundary = true
  backdropText.wrap = true

  return backdropText
end function

sub initItemIcon()
  m.itemIcon = m.top.findNode("itemIcon")
end sub

sub itemContentChanged()
  if isValid(m.itemPoster) then m.itemPoster.callFunc("resetBadge")
  itemData = m.top.itemContent
  if not isValid(itemData) then return

  globalUser = m.global.user
  userSettings = globalUser.settings

  ' Cache POSTER_SM locally — BrighterScript cannot chain .field access directly on
  ' namespace constants (e.g. imageSize.POSTER_SM.width), so we assign first.
  posterSmSize = imageSize.POSTER_SM

  ' validate to prevent crash
  if not isValid(m.itemPoster) then initItemPoster()
  if not isValid(m.itemText) then initItemText()
  if not isValid(m.itemTextExtra) then initItemTextExtra()
  if not isValid(m.backdrop) then initBackdrop()
  if not isValid(m.itemIcon) then initItemIcon()

  ' Read slot width from the HomeRow content node (parent of itemContent).
  ' m.top.width (set by RowList) is not guaranteed to be current when itemContentChanged
  ' fires — Roku may set itemContent before updating width on the item component.
  ' HomeRow.imageWidth is set before items are appended and is always reliable.
  rowNode = itemData.getParent()
  slotWidth = (isValid(rowNode) and rowNode.imageWidth > 0) ? rowNode.imageWidth : m.top.width
  m.itemPoster.width = slotWidth
  m.itemText.maxWidth = slotWidth
  m.itemTextExtra.maxWidth = slotWidth
  m.itemTextExtra.visible = true
  m.itemTextExtra.text = ""
  m.backdrop.width = slotWidth

  if isValidAndNotEmpty(itemData.iconUrl)
    m.itemIcon.uri = itemData.iconUrl
  end if

  if itemData.isWatched
    m.itemPoster.isWatched = true
  else
    if LCase(itemData.type) = "series"
      if isValid(userSettings)
        unwatchedEpisodeCountSetting = userSettings.uiTvShowsDisableUnwatchedCount
        if isValid(unwatchedEpisodeCountSetting) and not unwatchedEpisodeCountSetting
          if itemData.unplayedItemCount > 0
            m.itemPoster.unplayedCount = itemData.unplayedItemCount
          end if
        end if
      end if
    end if
  end if

  ' Format the data based on item type
  if itemData.type = "CollectionFolder" or itemData.type = "UserView" or itemData.type = "Channel"
    initBackdropText()
    backdropText = m.top.findNode("backdropText")
    backdropText.width = m.backdrop.width - 18
    backdropText.text = itemData.name
    ' Libraries only have Primary images — not Thumb or Backdrop.
    ' getItemWidePosterUrl (thumb/backdrop chain) always returns "" for these items.
    m.itemPoster.uri = getItemImageUrl(itemData, "Primary", imageSize.WIDE_MD)
    return
  end if

  m.itemTextExtra.visible = true

  ' "Program" is from the "On Now" row on the Home Screen.
  ' On Now always renders at MOVIE_POSTER (portrait) slot size.
  ' Try the program's own primary image; fall back to the channel's primary image.
  if itemData.type = "Program"
    m.itemText.text = itemData.name
    m.itemTextExtra.text = itemData.subtitle  ' pre-computed: episodeTitle or channelName

    posterUri = getItemPosterUrl(itemData, imageSize.POSTER_SM)
    if posterUri = "" and isValidAndNotEmpty(itemData.channelId) and isValidAndNotEmpty(itemData.channelPrimaryImageTag)
      posterUri = ImageURL(itemData.channelId, "Primary", { tag: itemData.channelPrimaryImageTag, maxWidth: posterSmSize.width, maxHeight: posterSmSize.height })
    end if
    m.itemPoster.uri = posterUri
    m.itemPoster.loadDisplayMode = "scaleToFill"
    return
  end if

  if itemData.type = "Episode" or LCase(itemData.type) = "recording"
    m.itemText.text = itemData.seriesName
    m.itemPoster.playedPercentage = itemData.playedPercentage

    if isValid(userSettings)
      if userSettings.uiGeneralEpisodeImages = "webclient"
        tmpSetting = globalUser.config.useEpisodeImagesInNextUpAndResume
        if isValid(tmpSetting) and tmpSetting
          m.itemPoster.uri = getItemThumbnailUrl(itemData, imageSize.WIDE_MD)
        else
          m.itemPoster.uri = getItemWidePosterUrl(itemData, imageSize.WIDE_MD)
        end if
      else if userSettings.uiGeneralEpisodeImages = "show"
        m.itemPoster.uri = getItemWidePosterUrl(itemData, imageSize.WIDE_MD)
      else if userSettings.uiGeneralEpisodeImages = "episode"
        m.itemPoster.uri = getItemThumbnailUrl(itemData, imageSize.WIDE_MD)
      end if
    else
      ' use show image if user settings are invalid for some reason
      m.itemPoster.uri = getItemWidePosterUrl(itemData, imageSize.WIDE_MD)
    end if

    ' subtitle is pre-computed: "S1E2 - Episode Title"
    m.itemTextExtra.text = itemData.subtitle
    return
  end if

  if itemData.type = "Movie" or itemData.type = "MusicVideo"
    m.itemText.text = itemData.name
    m.itemPoster.playedPercentage = itemData.playedPercentage

    ' Use poster for portrait-sized slots, wide image for landscape slots
    if slotWidth = posterSmSize.width
      m.itemPoster.uri = getItemPosterUrl(itemData, imageSize.POSTER_SM)
    else
      posterUri = getItemWidePosterUrl(itemData, imageSize.WIDE_MD)
      if posterUri = ""
        posterUri = getItemPosterUrl(itemData, imageSize.POSTER_SM)
      end if
      m.itemPoster.uri = posterUri
    end if

    ' subtitle is pre-computed: "2024 • PG-13"
    m.itemTextExtra.text = itemData.subtitle
    return
  end if

  if itemData.type = "Video"
    m.itemText.text = itemData.name
    m.itemPoster.playedPercentage = itemData.playedPercentage

    if slotWidth = posterSmSize.width
      m.itemPoster.uri = getItemPosterUrl(itemData, imageSize.POSTER_SM)
    else
      m.itemPoster.uri = getItemWidePosterUrl(itemData, imageSize.WIDE_MD)
    end if
    return
  end if

  if itemData.type = "BoxSet"
    m.itemText.text = itemData.name
    m.itemPoster.uri = getItemPosterUrl(itemData, imageSize.POSTER_MD)
    ' subtitle is pre-computed: "N items"
    m.itemTextExtra.text = itemData.subtitle
    return
  end if

  if itemData.type = "Series"
    m.itemText.text = itemData.name

    ' Use poster for portrait-sized slots, wide image for landscape slots
    if slotWidth = posterSmSize.width
      m.itemPoster.uri = getItemPosterUrl(itemData, imageSize.POSTER_SM)
    else
      posterUri = getItemWidePosterUrl(itemData, imageSize.WIDE_MD)
      if posterUri = ""
        posterUri = getItemPosterUrl(itemData, imageSize.POSTER_SM)
      end if
      m.itemPoster.uri = posterUri
    end if

    ' subtitle is pre-computed: "2020 - Present" or "2020 - 2024"
    m.itemTextExtra.text = itemData.subtitle
    return
  end if

  if itemData.type = "MusicAlbum"
    m.itemText.text = itemData.name
    ' subtitle is pre-computed: albumArtist
    m.itemTextExtra.text = itemData.subtitle
    m.itemPoster.uri = getItemPosterUrl(itemData, imageSize.SQUARE_MD)
    return
  end if

  if itemData.type = "MusicArtist"
    m.itemText.text = itemData.name
    m.itemTextExtra.text = itemData.subtitle
    m.itemPoster.uri = getItemPosterUrl(itemData, imageSize.SQUARE_MD)
    return
  end if

  if itemData.type = "Audio"
    m.itemText.text = itemData.name
    ' subtitle is pre-computed: albumArtist
    m.itemTextExtra.text = itemData.subtitle
    m.itemPoster.uri = getItemPosterUrl(itemData, imageSize.SQUARE_MD)
    return
  end if

  ' TvChannel: secondary text intentionally blank (no meaningful subtitle for a channel card).
  ' Note: previously read itemData.json.AlbumArtist here — a copy-paste bug from MusicArtist.
  ' AlbumArtist is never populated for TvChannels; the visual result was always empty.
  if itemData.type = "TvChannel"
    m.itemText.text = itemData.name
    m.itemPoster.uri = getItemPosterUrl(itemData, imageSize.WIDE_MD)
    return
  end if

  if itemData.type = "Season"
    ' subtitle is pre-computed: seriesName
    m.itemText.text = itemData.subtitle
    m.itemTextExtra.text = itemData.name
    m.itemPoster.uri = getItemPosterUrl(itemData, imageSize.POSTER_MD)
    return
  end if

  if itemData.type = "Photo"
    m.itemText.text = itemData.name
    m.itemPoster.uri = getItemPosterUrl(itemData, imageSize.WIDE_MD)
    ' subtitle is pre-computed: "2024" or "2024 - My Album"
    m.itemTextExtra.text = itemData.subtitle
    return
  end if

  if itemData.type = "PhotoAlbum"
    m.itemText.text = itemData.name
    m.itemPoster.uri = getItemPosterUrl(itemData, imageSize.WIDE_MD)
    ' subtitle is pre-computed: "N items"
    m.itemTextExtra.text = itemData.subtitle
    return
  end if

  m.log.warn("Unhandled Home Item Type", itemData.type)
end sub

' Enable title scrolling based on item Focus
sub focusChanged()
  if m.top.itemHasFocus = true
    m.itemText.repeatCount = -1
    m.itemTextExtra.repeatCount = -1
  else
    m.itemText.repeatCount = 0
    m.itemTextExtra.repeatCount = 0
  end if
end sub

'Hide backdrop and icon when poster loaded
sub onPosterLoadStatusChanged()
  if m.itemPoster.loadStatus = "ready" and m.itemPoster.uri <> ""
    m.backdrop.visible = false
    backdropText = m.top.findNode("backdropText")
    if isValid(backdropText)
      backdropText.visible = false
    end if
  else
    m.backdrop.visible = true
    backdropText = m.top.findNode("backdropText")
    if isValid(backdropText)
      backdropText.visible = true
    end if
  end if
end sub

'Handle icon image load status changes
sub onIconLoadStatusChanged()
  if m.itemIcon.loadStatus = "ready" and m.itemIcon.uri <> ""
    ' Icon loaded successfully
    m.itemIcon.visible = true
    arrangeIconAndBackdropText()
  end if
end sub

'Arrange icon and backdrop text when both are visible
sub arrangeIconAndBackdropText()
  backdropText = m.top.findNode("backdropText")
  if isValid(backdropText)
    ' reposition backdroptext and itemIcon so they don't overlap
    m.itemIcon.translation = [(m.backdrop.width - m.itemIcon.width) / 2, ((m.backdrop.height - m.itemIcon.height) / 2) / 2]

    backdropText.height = 0
    backdropText.translation = [backdropText.translation[0], ((m.backdrop.height - m.itemIcon.height) / 2) + m.itemIcon.height]

    ' Set font size based on text length
    constants = m.global.constants
    if backdropText.text.len() > 12
      backdropText.font.size = constants.fontSizeLarge
    else if backdropText.text.len() > 35
      backdropText.font.size = constants.fontSizeMedium
    end if
  end if
end sub
