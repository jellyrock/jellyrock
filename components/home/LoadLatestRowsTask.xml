<?xml version="1.0" encoding="utf-8"?>

<component name="LoadLatestRowsTask" extends="Task">
  <interface>
    <!-- Libraries to load, in on-screen row order: [{ id: string }] -->
    <field id="libraries" type="array" />
    <!-- Wake signal only — the value is ignored. Results ride as appended children
         ({ libId, items } ContentNodes); the observer drains all unprocessed children,
         so coalesced wake events can't drop a row. -->
    <field id="rowReady" type="string" alwaysNotify="true" />
  </interface>
</component>
