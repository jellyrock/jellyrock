<?xml version="1.0" encoding="utf-8"?>
<!-- Auth guard for post-login routes. Created on m.global in setGlobalNodes BEFORE the
     router's addRoutes, and registered by NODE REFERENCE as the canActivate guard on every
     post-login route (/, details, library, search, settings, play, photo, audio). A signed-out
     request for one of them is redirected to sign-in and not kept (see canActivate). The node
     lives on m.global because it also holds the one intent that does survive sign-in: a deep
     link that arrived while signed out (stashedDeepLink), which the main-thread replay helper
     (source/replayRoute.bs) opens after the user signs in. -->
<component name="AuthManager" extends="Node">
  <interface>
    <!-- A deferred deep link's resolved intent, set by the main-thread deep-link handler
         ({ itemId, mediaType, serverGuid, itemName, action }) and read + cleared by
         replayAfterLogin. A deep link routes through ItemDetails (validate + auto-launch), so
         it needs the structured intent, not only a path. invalid when there is no pending
         deep link. -->
    <field id="stashedDeepLink" type="assocarray" />
    <function name="canActivate" />
  </interface>
</component>
