import "pkg:/source/roku_modules/log/LogMixin.brs"
import "pkg:/source/utils/misc.bs"

sub init()
  m.log = new log.Logger("AuthManager")
end sub

' canActivate guard: see AuthManager.xml header. Invoked by the router on the render thread
' during navigateTo, once per guarded route. A cheap SYNCHRONOUS token check only, no network
' (launch-time AboutMe re-validation stays in the login flow).
'
' Returns:
'   true               : token present: allow the navigation.
'   { path: "/login" } : no token: redirect to sign-in. The router treats any AA with a
'                        non-empty `path` as a redirect command (Router.brs
'                        sgrouter_runGuardChecks), the same shape
'                        sgrouter.createRedirectCommand("/login") produces, without pulling the
'                        whole router namespace into this guard node.
'
' The requested path is NOT kept for after sign-in. Nothing a person can do while signed out
' requests a guarded route: every screen that navigates to one is torn down at sign-out. So a
' request that reaches here is a stray (a late remote-control command, for one), and opening
' it after the next sign-in sent the user somewhere they never asked to go. A deep link that
' arrives while signed out is the intent that does survive sign-in, and it has its own stash
' (stashedDeepLink). Logged as a warning because it should not happen.
function canActivate(currentRequest as object) as dynamic
  if isValidAndNotEmpty(m.global.user.authToken) then return true

  path = ""
  if isValid(currentRequest) and isValid(currentRequest.path) then path = currentRequest.path
  m.log.warn("guarded route requested while signed out; redirecting to sign-in", path)
  return { path: "/login" }
end function
