' CurrentSubtitleRow: one subtitle already attached to the item.
'
' See CurrentSubtitleRow.xml for why this is separate from SubtitleResultRow.
import "pkg:/source/constants/subtitleLayout.bs"
import "pkg:/source/translationKeys.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/translate.bs"

const BADGE_ICON_SIZE = 22

' Badge slots pre-allocated per row, sized to the most badges a single
' row of this type can carry so the pool never grows mid-scroll.
const BADGE_POOL_SIZE = 2

sub init()
  m.rowBackground = m.top.findNode("rowBackground")
  m.rowBorder = m.top.findNode("rowBorder")
  m.titleLabel = m.top.findNode("titleLabel")
  m.fileTailLabel = m.top.findNode("fileTailLabel")
  m.badgeClip = m.top.findNode("badgeClip")
  m.badgeRow = m.top.findNode("badgeRow")

  m.titleLabel.color = m.global.constants.colorTextPrimary
  m.titleLabel.repeatCount = 0

  buildBadgePool()
  onSizeChanged()
end sub

' buildBadgePool: Create the badge nodes ONCE.
'
' MarkupList recycles a small set of row components as the list scrolls, writing
' a new itemContent into each. The first draft tore down and rebuilt every badge
' child on each of those writes, so a single scroll step cost a burst of node
' create/destroy per visible row -- which is what made scrolling feel heavy.
' Nodes are now created once; only their text, colour and visibility change.
sub buildBadgePool()
  m.badges = []
  m.badgeCount = 0
  for i = 0 to BADGE_POOL_SIZE - 1
    badge = m.badgeRow.createChild("LayoutGroup")
    badge.layoutDirection = "horiz"
    badge.itemSpacings = [6]
    badge.vertAlignment = "center"
    badge.visible = false

    icon = badge.createChild("Poster")
    icon.width = BADGE_ICON_SIZE
    icon.height = BADGE_ICON_SIZE
    icon.visible = false

    label = badge.createChild("LabelSecondarySmallest")

    m.badges.push({ group: badge, icon: icon, label: label })
  end for
end sub

sub onItemContentChanged()
  content = m.top.itemContent
  if not isValid(content) then return

  if isValid(content.rowWidth) and content.rowWidth > 0 then m.top.rowWidth = content.rowWidth

  m.titleLabel.text = titleLineFor(content)
  ' Computed by the panel, which is the only scope that holds BOTH the subtitle
  ' path and the media path the redundant part is stripped against.
  m.fileTailLabel.text = textOrEmpty(content.fileTail)
  rebuildBadges(content)
  hideUnusedBadges()
end sub

' titleLineFor: "English  ·  SRT".
'
' Language first because that is what this column is scanned for. The codec
' follows because it is the one remaining property that changes how the track
' behaves (an image-based format forces transcoding where a text one does not).
function titleLineFor(content as object) as string
  parts = []

  if isValidAndNotEmpty(content.language)
    parts.push(content.language)
  else
    parts.push(translate(translationKeys.LabelUnknown))
  end if

  if isValidAndNotEmpty(content.codec) then parts.push(UCase(content.codec))

  line = ""
  for each part in parts
    if line <> "" then line = line + "  ·  "
    line = line + part
  end for
  return line
end function

' rebuildBadges: Only the flags that change what the track IS.
'
' Appended in significance order — the badge zone is clipped to the row's right
' edge, so anything that overflows is dropped from the end.
'
' No "perfect match" here — that is a property of a provider search result, not
' of a file already on disk — and no download count, which an installed subtitle
' does not have. Rendering those was what made the first draft's right-hand
' column read as broken.
sub rebuildBadges(content as object)
  m.badgeCount = 0
  constants = m.global.constants

  if content.hearingImpaired = true
    appendBadge(translate(translationKeys.LabelHearingImpaired), constants.colorTextSecondary, "pkg:/images/icons/closedCaptions_$$RES$$.png")
  end if
  if content.forced = true
    appendBadge(translate(translationKeys.LabelForcedSubtitle), constants.colorTextSecondary, "")
  end if
end sub

sub appendBadge(text as string, color as string, iconUri as string)
  if m.badgeCount >= m.badges.count() then return

  slot = m.badges[m.badgeCount]
  slot.label.text = text
  slot.label.color = color

  slot.icon.visible = iconUri <> ""
  if iconUri <> ""
    if slot.icon.uri <> iconUri then slot.icon.uri = iconUri
    slot.icon.blendColor = color
  end if

  slot.group.visible = true
  m.badgeCount++
end sub

' hideUnusedBadges: Blank the tail of the pool this row did not need.
sub hideUnusedBadges()
  for i = m.badgeCount to m.badges.count() - 1
    m.badges[i].group.visible = false
  end for
end sub

sub onSizeChanged()
  rowWidth = m.top.rowWidth
  constants = m.global.constants

  ' Same total height as a search-result row so the two columns stay in step
  ' line-for-line. They now also share the same two-line SHAPE, so that holds by
  ' construction rather than by two components agreeing to fake it.
  rowHeight = subtitleLayout.rowHeight(constants.fontSizeSmaller, constants.fontSizeSmallest)

  m.rowBackground.width = rowWidth
  m.rowBackground.height = rowHeight
  m.rowBorder.width = rowWidth
  m.rowBorder.height = rowHeight

  ' Line 1: language and codec, across the row's full text width.
  ' ScrollingLabel viewports are driven by maxWidth, not width.
  m.titleLabel.maxWidth = rowWidth - (subtitleLayout.ROW_H_PADDING * 2)
  m.titleLabel.translation = [subtitleLayout.ROW_H_PADDING, subtitleLayout.ROW_V_PADDING]

  ' Line 2: filename tail on the left, badges anchored right.
  secondLineY = subtitleLayout.ROW_V_PADDING + constants.fontSizeSmaller + subtitleLayout.ROW_LINE_GAP
  zones = subtitleLayout.secondLineZones(rowWidth, subtitleLayout.EXISTING_BADGE_WIDTH)

  ' A Label with wrap off and a width ellipsizes what does not fit, which matters
  ' more here than in the results column: the tail falls back to a whole filename
  ' whenever the subtitle does not sit beside the media file.
  m.fileTailLabel.width = zones.detailWidth
  m.fileTailLabel.translation = [subtitleLayout.ROW_H_PADDING, secondLineY]

  m.badgeClip.clippingRect = [0, 0, zones.badgeWidth, rowHeight]
  m.badgeClip.translation = [zones.badgeX, 0]
  m.badgeRow.translation = [0, secondLineY]
end sub

sub onFocusChanged()
  constants = m.global.constants
  hasFocus = m.top.itemHasFocus

  m.rowBorder.visible = hasFocus
  m.rowBackground.visible = hasFocus

  if hasFocus
    m.rowBorder.blendColor = constants.colorPrimary
    m.rowBackground.blendColor = constants.colorBackgroundSecondary
    m.titleLabel.repeatCount = -1
  else
    m.titleLabel.repeatCount = 0
  end if
end sub
