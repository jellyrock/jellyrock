import "pkg:/source/api/baserequest.bs"
import "pkg:/source/roku_modules/rr/Requests.brs"
import "pkg:/source/utils/misc.bs"

sub init()
  m.top.functionName = "postItems"
end sub

' Main function for PostTask.
' Posts either an array of data or a string of data to an API endpoint.
' Saves the response information.
sub postItems()
  if m.top.apiUrl = ""
    print "ERROR in PostTask. Invalid API URL provided"
    return
  end if

  if m.global.server.serverUrl = ""
    print "ERROR in PostTask. No server URL set in session"
    m.top.responseCode = -1
    m.top.failureReason = "No server URL set in session"
    return
  end if

  url = buildURL(m.top.apiUrl)
  if not isValid(url)
    print "ERROR in PostTask. Failed to build URL for " + m.top.apiUrl
    m.top.responseCode = -1
    m.top.failureReason = "Failed to build URL"
    return
  end if

  if m.top.arrayData.count() > 0 and m.top.stringData = ""
    print "PostTask Started - Posting array to " + m.top.apiUrl
    body = FormatJson(m.top.arrayData)
  else if m.top.arrayData.count() = 0 and m.top.stringData <> ""
    print "PostTask Started - Posting string to " + m.top.apiUrl
    body = m.top.stringData
  else
    print "ERROR processing data for PostTask"
    return
  end if

  r = rr_Requests().post(url, {
    data: body,
    headers: { Authorization: buildAuthHeader(), "Content-Type": "application/json" },
    timeout: m.top.timeoutSeconds * 1000,
    useCache: false
  })

  m.top.responseCode = r.statusCode
  print "PostTask Finished. " + m.top.apiUrl + " Response = " + r.statusCode.toStr()

  if r.ok
    if isValid(r.json) then m.top.responseBody = r.json
    if isValid(r.headers) then m.top.responseHeaders = r.headers
  else
    m.top.failureReason = "HTTP error: " + r.statusCode.toStr()
    print "ERROR in PostTask: HTTP error " + r.statusCode.toStr()
  end if
end sub

' Revert PostTask to default state
sub empty()
  ' These should match the defaults set in PostTask.xml
  m.top.apiUrl = ""
  m.top.timeoutSeconds = 30

  m.top.arrayData = {}
  m.top.stringData = ""

  m.top.responseCode = invalid
  m.top.responseBody = {}
  m.top.responseHeaders = {}
  m.top.failureReason = ""
end sub
