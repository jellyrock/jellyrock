<?xml version="1.0" encoding="utf-8"?>
<component name="TVEpisodes" extends="JRScreen">
  <children>
    <JRPoster id="seasonPoster" width="300" height="450" translation="[95,175]" />
    <LayoutGroup id="buttonGroup" itemSpacings="18" layoutDirection="vert" translation="[96, 640]">
      <TextButton id="shuffle" minWidth="300" text="Shuffle" visible="false"></TextButton>
      <TextButton id="extras" minWidth="300" text="Extras" visible="false"></TextButton>
    </LayoutGroup>
    <TVEpisodeRowWithOptions id="picker" visible="true" />
  </children>
  <interface>
    <field id="episodeSelected" alias="picker.itemSelected" />
    <field id="refreshSeasonDetailsData" type="bool" alwaysNotify="true" />
    <field id="selectedItem" type="node" alwaysNotify="true" />
    <field id="quickPlayNode" type="node" />
    <!-- Phase 4: per-episode stream selections set before selectedItem fires -->
    <!-- -1 = no user selection (auto-select); ≥ 0 = server-side stream.index -->
    <field id="selectedAudioStreamIndex" type="integer" value="-1" />
    <field id="selectedVideoStreamId" type="string" value="" />
    <field id="seasonData" type="node" />
    <field id="objects" alias="picker.objects" />
    <field id="episodeObjects" type="assocarray" />
    <field id="extrasObjects" type="assocarray" onChange="setExtraButtonVisibility" />
    <function name="updateSeason" />
  </interface>
</component>