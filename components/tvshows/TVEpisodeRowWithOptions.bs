import "pkg:/source/utils/mediaDisplayTitle.bs"
import "pkg:/source/utils/misc.bs"

sub init()
  m.rows = m.top.findNode("tvEpisodeRow")
  m.tvListOptions = m.top.findNode("tvListOptions")

  m.rows.observeField("doneLoading", "rowsDoneLoading")

  ' Per-episode stream selection state keyed by item.id.
  ' JellyfinBaseItem is immutable, so we cannot store selection on the node itself.
  m.streamSelections = {}
end sub

sub setupRows()
  objects = m.top.objects
  m.rows.objects = objects
end sub

sub rowsDoneLoading()
  m.top.doneLoading = true
end sub

' List of video versions to choose from
sub SetUpVideoOptions(streams as object)
  videos = []
  hasMultipleSources = streams.Count() > 1
  itemId = m.rows.objects.items[m.currentSelected].id
  sel = m.streamSelections[itemId]
  selectedVideoStreamId = isValid(sel) and isValidAndNotEmpty(sel.selectedVideoStreamId) ? sel.selectedVideoStreamId : ""

  for i = 0 to streams.Count() - 1
    if LCase(streams[i].VideoType) = "videofile"
      codec = formatVideoSourceTitle(streams[i], hasMultipleSources)

      ' Create options for user to switch between video tracks
      videos.push({
        "Title": codec,
        "Description": tr("Video"),
        "Selected": selectedVideoStreamId = streams[i].id,
        "StreamID": streams[i].id,
        "video_codec": codec
      })
    end if
  end for

  if videos.count() >= 1
    options = {}
    options.videos = videos
    m.tvListOptions.options = options
  end if
end sub

' List of audio tracks to choose from
sub SetUpAudioOptions(streams as object)
  tracks = []
  itemId = m.rows.objects.items[m.currentSelected].id
  sel = m.streamSelections[itemId]
  selectedAudioStreamIndex = isValid(sel) and isValid(sel.selectedAudioStreamIndex) ? sel.selectedAudioStreamIndex : 0

  for i = 0 to streams.Count() - 1
    if streams[i].Type = "Audio"
      tracks.push({
        "Title": formatAudioDisplayTitle(streams[i]),
        "Description": streams[i].Title,
        "Selected": selectedAudioStreamIndex = i,
        "StreamIndex": i
      })
    end if
  end for

  if tracks.count() >= 1
    options = {}
    if isValid(m.tvListOptions.options) and isValid(m.tvListOptions.options.videos)
      options.videos = m.tvListOptions.options.videos
    end if
    options.audios = tracks
    m.tvListOptions.options = options
  end if
end sub

sub audioOptionsClosed()
  if isValid(m.currentSelected)
    ' If the user opened the audio options, we report back even if they left the selection alone.
    ' Otherwise, the users' lang peference from the server will take over.
    ' To do this, we interpret anything other than "0" as the user opened the audio options.
    newIndex = m.tvListOptions.audioStreamIndex = 0 ? 1 : m.tvListOptions.audioStreamIndex
    itemId = m.rows.objects.items[m.currentSelected].id
    sel = m.streamSelections[itemId]
    if not isValid(sel) then sel = {}
    sel.selectedAudioStreamIndex = newIndex
    m.streamSelections[itemId] = sel
  end if
end sub

sub videoOptionsClosed()
  itemId = m.rows.objects.items[m.currentSelected].id
  currentVideoStreamId = ""
  sel = m.streamSelections[itemId]
  if isValid(sel) and isValidAndNotEmpty(sel.selectedVideoStreamId)
    currentVideoStreamId = sel.selectedVideoStreamId
  end if
  if m.tvListOptions.videoStreamId <> currentVideoStreamId
    if not isValid(sel) then sel = {}
    sel.selectedVideoStreamId = m.tvListOptions.videoStreamId
    m.streamSelections[itemId] = sel
  end if
end sub

function onKeyEvent(key as string, press as boolean) as boolean
  if not press then return false

  if key = "options" and isValid(m.rows.focusedChild) and isValid(m.rows.focusedChild.rowItemFocused)
    m.currentSelected = m.rows.focusedChild.rowItemFocused[0]
    currentItem = m.rows.objects.items[m.currentSelected]
    itemId = currentItem.id

    ' Read stream data from typed fields
    mediaSources = invalid
    if isValid(currentItem.mediaSourcesData) and isValidAndNotEmpty(currentItem.mediaSourcesData.mediaSources)
      mediaSources = currentItem.mediaSourcesData.mediaSources
    end if

    ' Default to first source streams, switch to selected source streams if user has chosen one
    mediaStreams = invalid
    if isValid(mediaSources) and isValid(mediaSources[0].MediaStreams)
      mediaStreams = mediaSources[0].MediaStreams
    end if

    sel = m.streamSelections[itemId]
    selectedVideoStreamId = isValid(sel) and isValidAndNotEmpty(sel.selectedVideoStreamId) ? sel.selectedVideoStreamId : ""
    if isValidAndNotEmpty(selectedVideoStreamId) and isValid(mediaSources)
      for each source in mediaSources
        if source.id = selectedVideoStreamId
          if isValid(source.MediaStreams)
            mediaStreams = source.MediaStreams
          end if
          exit for
        end if
      end for
    end if
    if isValid(mediaSources)
      SetUpVideoOptions(mediaSources)
    end if
    if isValid(mediaStreams)
      SetUpAudioOptions(mediaStreams)
    end if
    if isValid(m.tvListOptions.options)
      m.tvListOptions.visible = true
      m.tvListOptions.setFocus(true)
    end if
    return true
  else if m.tvListOptions.visible = true and key = "back" or key = "options"
    m.tvListOptions.setFocus(false)
    m.tvListOptions.visible = false
    m.rows.setFocus(true)
    videoOptionsClosed()
    audioOptionsClosed()
    return true
  else if key = "up" and m.rows.hasFocus() = false
    m.rows.setFocus(true)
  else if key = "down" and m.rows.hasFocus() = false
    m.rows.setFocus(true)
  end if

  return false
end function
