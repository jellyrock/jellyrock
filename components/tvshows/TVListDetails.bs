import "pkg:/source/constants/imageSize.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/itemImageUrl.bs"
import "pkg:/source/utils/mediaDisplayTitle.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/streamSelection.bs"

sub init()
  m.title = m.top.findNode("title")
  m.title.text = tr("Loading...")
  m.overview = m.top.findNode("overview")
  m.poster = m.top.findNode("poster")
  m.infoBar = m.top.findnode("infoBar")
  m.videoCodec = m.top.findNode("video_codec")
end sub

sub itemContentChanged()
  item = m.top.itemContent
  userSettings = m.global.user.settings

  ' Derive stream selection state onto component fields (not the immutable item node).
  ' Re-derive on every item change since this renderer is recycled across episodes.
  mediaSources = invalid
  if isValid(item.mediaSourcesData) and isValidAndNotEmpty(item.mediaSourcesData.mediaSources)
    mediaSources = item.mediaSourcesData.mediaSources
  end if

  ' Default video source: use pre-computed mediaSourceId from transformer
  if not isValidAndNotEmpty(m.top.selectedVideoStreamId) and isValid(mediaSources)
    m.top.selectedVideoStreamId = mediaSources[0].id
  end if

  ' Observe the row ContentNode so the audio label updates when the user picks a track.
  ' Clean up the previous observer when this renderer is recycled onto a new item.
  if isValid(m.rowContentNode)
    m.rowContentNode.unobserveField("audioSelectionIndex")
    m.rowContentNode = invalid
  end if
  rowNode = isValid(item) ? item.getParent() : invalid
  if isValid(rowNode) and rowNode.doesExist("audioSelectionIndex")
    m.rowContentNode = rowNode
    m.rowContentNode.observeField("audioSelectionIndex", "onRowAudioSelectionChanged")
  end if

  ' Use stored user selection if present, otherwise auto-detect.
  if isValid(m.rowContentNode) and m.rowContentNode.audioSelectionIndex >= 0
    m.top.selectedAudioStreamIndex = m.rowContentNode.audioSelectionIndex
  else if m.top.selectedAudioStreamIndex = 0
    SetDefaultAudioTrack(mediaSources)
  end if

  if item.parentIndexNumber = 0
    indexNumber = `${tr("Special")} - `
  else if item.indexNumber > 0
    indexNumber = `${item.indexNumber}. `
    if item.indexNumberEnd > 0
      indexNumber = `${item.indexNumber}-${item.indexNumberEnd}. `
    end if
  else
    indexNumber = ""
  end if
  m.title.text = indexNumber + item.title
  m.overview.text = item.overview

  if isValidAndNotEmpty(item.premiereDate)
    airDate = CreateObject("roDateTime")
    airDate.FromISO8601String(item.premiereDate)
    m.top.findNode("aired").text = airDate.AsDateString("short-month-no-weekday")
  end if

  posterUri = getItemImageUrl(item, "Primary", imageSize.WIDE_SM)

  if userSettings.uiTvShowsBlurUnwatched = true
    if item.type = "Episode"
      if not item.isWatched
        posterUri = posterUri + "&blur=15"
      end if
    end if
  end if

  m.poster.uri = posterUri

  if item.runTimeTicks > 0
    runTime = getRuntime(item.runTimeTicks)
    if runTime < 2
      m.top.findNode("runtime").text = "1 " + tr("min")
    else
      m.top.findNode("runtime").text = stri(runTime).trim() + " " + tr("mins")
    end if

    if userSettings.uiDesignHideClock <> true
      m.top.findNode("endtime").text = tr("Ends at %1").Replace("%1", getEndTime(item.runTimeTicks))
    end if
  end if

  if userSettings.uiTvShowsDisableCommunityRating = false
    if item.communityRating > 0
      if not isValid(m.communityRating)
        m.communityRating = CreateObject("roSGNode", "CommunityRating")
        m.communityRating.id = "communityRating"

        ' Customize rating display for TV list details
        m.communityRating.iconSize = 24

        ' Access the label child directly (second child, index 1)
        ratingLabel = m.communityRating.getChild(1)
        if isValid(ratingLabel)
          globalConstants = m.global.constants
          ratingLabel.font.size = globalConstants.fontSizeSmall
          ratingLabel.color = globalConstants.colorTextSecondary
        end if
      end if

      m.communityRating.rating = item.communityRating
      m.infoBar.insertChild(m.communityRating, 1)
    else
      if isValid(m.communityRating)
        m.infoBar.removeChild(m.communityRating)
      end if
    end if
  else
    if isValid(m.communityRating)
      m.infoBar.removeChild(m.communityRating)
    end if
  end if

  ' Mark as watched
  m.poster.isWatched = item.isWatched

  ' Update progress bar
  if item.playedPercentage > 0
    m.poster.playedPercentage = item.playedPercentage
  end if

  ' Display current video_codec and check if there is more than one video to choose from...
  m.videoCodec.visible = false
  if isValid(mediaSources)
    hasMultipleSources = mediaSources.Count() > 1
    for i = 0 to mediaSources.Count() - 1
      if m.top.selectedVideoStreamId = mediaSources[i].id and isValid(mediaSources[i].MediaStreams)
        m.videoCodec.text = tr("Video") + ": " + formatVideoSourceTitle(mediaSources[i], hasMultipleSources)

        SetupAudioDisplay(mediaSources[i].MediaStreams, m.top.selectedAudioStreamIndex)
        exit for
      end if
    end for
    m.videoCodec.visible = true
    DisplayVideoAvailable(mediaSources)
  end if
end sub

' onRowAudioSelectionChanged: Fires when the user picks a track from the options dialog.
' Fires when TVEpisodeRowWithOptions writes a new audio selection to the row ContentNode.
sub onRowAudioSelectionChanged()
  if not isValid(m.rowContentNode) then return
  newIndex = m.rowContentNode.audioSelectionIndex
  if newIndex < 0 then return ' -1 = no user selection, ignore
  m.top.selectedAudioStreamIndex = newIndex
end sub

' Re-renders the audio label when selectedAudioStreamIndex changes.
sub onSelectedAudioStreamIndexChanged()
  item = m.top.itemContent
  if not isValid(item) then return

  mediaSources = invalid
  if isValid(item.mediaSourcesData) and isValidAndNotEmpty(item.mediaSourcesData.mediaSources)
    mediaSources = item.mediaSourcesData.mediaSources
  end if
  if not isValid(mediaSources) then return

  for i = 0 to mediaSources.Count() - 1
    if m.top.selectedVideoStreamId = mediaSources[i].id and isValid(mediaSources[i].MediaStreams)
      SetupAudioDisplay(mediaSources[i].MediaStreams, m.top.selectedAudioStreamIndex)
      exit for
    end if
  end for
end sub

' Display current audio_codec and check if there is more than one audio track to choose from.
' @param {object} mediaStreams - Array of all media streams from Jellyfin (mixed types)
' @param {integer} selectedAudioStreamIndex - Jellyfin server-side stream.index value (NOT an array position)
sub SetupAudioDisplay(mediaStreams as object, selectedAudioStreamIndex as integer)
  selectedStream = invalid
  firstAudioStream = invalid

  if isValid(mediaStreams)
    for i = 0 to mediaStreams.Count() - 1
      stream = mediaStreams[i]
      if LCase(stream.Type) = "audio"
        ' Track the first audio stream as fallback for when selectedAudioStreamIndex = 0
        ' or does not match any stream (defensive guard for malformed metadata)
        if not isValid(firstAudioStream)
          firstAudioStream = stream
        end if

        ' Match on Jellyfin server-side stream.index — NOT array position.
        ' MediaStream.index values include all stream types and are non-contiguous
        ' relative to the audio-only subset, so array indexing would be wrong.
        if isValid(stream.index) and stream.index = selectedAudioStreamIndex
          selectedStream = stream
        end if
      end if
    end for
  end if

  ' Fall back to first audio stream when no index match found
  if not isValid(selectedStream)
    selectedStream = firstAudioStream
  end if

  if isValid(selectedStream)
    m.top.findNode("audio_codec").text = tr("Audio") + ": " + formatAudioDisplayTitle(selectedStream)
    m.top.findNode("audio_codec").visible = true
    DisplayAudioAvailable(mediaStreams)
  else
    m.top.findNode("audio_codec").visible = false
  end if
end sub

' Adds "+N" (e.g. +1) if there is more than one video version to choose from
sub DisplayVideoAvailable(streams as object)
  count = 0
  for i = 0 to streams.Count() - 1
    if isValid(streams[i].VideoType) and LCase(streams[i].VideoType) = "videofile"
      count++
    end if
  end for

  if count > 1
    m.top.findnode("video_codec_count").text = "+" + stri(count - 1).trim()
  end if
end sub

' Adds "+N" (e.g. +1) if there is more than one audio track to choose from
sub DisplayAudioAvailable(streams as object)
  count = 0
  for i = 0 to streams.Count() - 1
    if streams[i].Type = "Audio"
      count++
    end if
  end for

  if count > 1
    m.top.findnode("audio_codec_count").text = "+" + stri(count - 1).trim()
  end if
end sub

' @param {longinteger} runTimeTicks - item.runTimeTicks
' @return {integer} runtime in minutes
function getRuntime(runTimeTicks as longinteger) as integer
  ' A tick is .1ms, so 1/10,000,000 for ticks to seconds,
  ' then 1/60 for seconds to minutess... 1/600,000,000
  return int(runTimeTicks / 600000000.0)
end function

' @param {longinteger} runTimeTicks - item.runTimeTicks
' @return {string} formatted end time
function getEndTime(runTimeTicks as longinteger) as string
  date = CreateObject("roDateTime")
  duration_s = int(runTimeTicks / 10000000.0)
  date.fromSeconds(date.asSeconds() + duration_s)
  date.toLocalTime()

  return formatTime(date)
end function

' SetDefaultAudioTrack: Selects and stores the best audio track for display.
' Reads full MediaStreams from the first media source to match server stream indices.
' Stores result in m.top.selectedAudioStreamIndex (component field, not the item node).
'
' @param {object} mediaSources - item.mediaSourcesData.mediaSources array, or invalid
sub SetDefaultAudioTrack(mediaSources as dynamic)
  mediaStreams = invalid
  if isValid(mediaSources) and isValid(mediaSources[0]) and isValid(mediaSources[0].MediaStreams)
    mediaStreams = mediaSources[0].MediaStreams
  end if

  if not isValid(mediaStreams) then return

  ' Get user settings for audio selection
  localUser = m.global.user

  ' Resolve playDefaultAudioTrack setting (JellyRock override or web client)
  playDefault = resolvePlayDefaultAudioTrack(localUser.settings, localUser.config)

  ' Use new comprehensive audio selection logic
  selectedIndex = findBestAudioStreamIndex(mediaStreams, playDefault, localUser.config.audioLanguagePreference)

  ' Store on component field, not the immutable item node
  m.top.selectedAudioStreamIndex = selectedIndex
end sub

sub focusChanged()
  if m.top.itemHasFocus = true
    ' text to speech for accessibility
    if m.global.device.isAudioGuideEnabled = true
      txt2Speech = CreateObject("roTextToSpeech")
      txt2Speech.Flush()
      txt2Speech.Say(m.title.text)
      txt2Speech.Say(m.overview.text)
    end if
  end if
end sub
