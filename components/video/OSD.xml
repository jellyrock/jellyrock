<?xml version="1.0" encoding="utf-8"?>
<component name="OSD" extends="JRScreen">
  <children>
    <!-- Background overlay so we can see UI -->
    <Gradient width="1920" height="300" translation="[0, 0]" />
    <Gradient width="1920" height="350" rotateDegrees="180" translation="[0, 640]" />
    <Rectangle color="0x000000FF" width="1920" height="90" translation="[0,990]" />

    <!-- HEADER LEFT -->
    <LayoutGroup id="videoLogoGroup" itemSpacings="[15]" layoutDirection="vert" translation="[96,54]">
      <!-- loadWidth/loadHeight set from imageSize.LOGO_OSD in OSD.bs init() -->
      <Poster id="videoLogo" loadDisplayMode="noScale" />
    </LayoutGroup>

    <!-- HEADER RIGHT -->
    <Clock />

    <!-- MAIN -->
    <!-- Video information - title, season/episode number etc. -->
    <LayoutGroup id="videoInfoGroup" itemSpacings="[9]" layoutDirection="vert" translation="[96,740]">
      <LabelSecondaryLargest id="videoTitle" isBold="true" width="1400" />
      <LayoutGroup id="videoSubtitleGroup" itemSpacings="[9]" layoutDirection="horiz" />
    </LayoutGroup>

    <!-- Ends at time -->
    <LayoutGroup id="endsAtGroup" itemSpacings="[12]" layoutDirection="horiz" horizAlignment="right" translation="[1824,759]">
      <LabelSecondaryMedium id="endsAtText" isBold="true" text="" />
      <LabelSecondaryMedium id="endsAtTime" isBold="true" />
    </LayoutGroup>


    <!-- Progress bar -->
    <LabelSecondaryMedium id="videoPositionTime" isBold="true" translation="[96,868]" />
    <RectangleBackgroundSecondary id="progressBarBackground" width="1425" height="9" translation="[240,880]">
      <RectangleSecondary id="progressBar" width="0" height="9" />
    </RectangleBackgroundSecondary>
    <LabelSecondaryMedium id="videoRemainingTime" isBold="true" horizAlign="right" width="200" translation="[1624,868]" />

    <!-- FOOTER -->
    <OSDButtonGroup id="buttonMenuLeft" translation="[90,932]">
      <IconButton id="itemBack" icon="pkg:/images/icons/itemPrevious.png" />
      <IconButton id="videoPlayPause" icon="pkg:/images/icons/play.png" />
      <IconButton id="itemNext" icon="pkg:/images/icons/itemNext.png" />
      <!-- Go to Live: detached from the layout by setButtonStates() and reattached by
           attachGoToLiveButton() only when the user is behind the live edge. visible="false"
           is defense-in-depth for the frame between XML load and setButtonStates running. -->
      <IconButton id="goToLive" icon="pkg:/images/icons/liveTV.png" visible="false" />
      <IconButton id="showVideoSourceMenu" icon="pkg:/images/icons/videoFile.png" />
      <IconButton id="showAudioMenu" icon="pkg:/images/icons/musicNote.png" />
      <IconButton id="showSubtitleMenu" icon="pkg:/images/icons/closedCaptions.png" />
      <IconButton id="chapterList" icon="pkg:/images/icons/chapters.png" />
    </OSDButtonGroup>
    <!-- Video info popup is right aligned-->
    <OSDButtonGroup id="buttonMenuRight" horizAlignment="right" translation="[1830,932]">
      <IconButton id="showVideoInfoPopup" icon="pkg:/images/icons/fileInfo.png" />
    </OSDButtonGroup>

    <Timer id="inactivityTimer" duration="1" repeat="true" />
  </children>
  <interface>
    <!-- Item data node (JellyfinBaseItem) - read-only source for all media metadata.
         OSD reads typed fields directly: type, name, seriesName, officialRating, etc.
         Set by VideoPlayerView when video content loads. -->
    <field id="itemData" type="node" onChange="onItemDataChanged" />

    <!-- Presentation state computed from itemData in onItemDataChanged() -->
    <field id="isMovie" type="boolean" value="false" />
    <field id="isSeries" type="boolean" value="false" />
    <field id="hasChapters" type="boolean" value="false" />
    <field id="numAudioStreams" type="integer" />
    <field id="numVideoSources" type="integer" />
    <!-- Active video source tag (e.g., "[B&W]", "[Colorized]") appended to OSD title
         when multiple video sources exist. Set by VideoPlayerView. -->
    <field id="videoSourceTag" type="string" value="" />
    <field id="runTimeMinutes" type="integer" />

    <!-- Playback state (set by VideoPlayerView) -->
    <field id="videoLogo" type="string" value="" onChange="setVideoLogoGroup" />
    <field id="inactiveTimeout" type="integer" />
    <field id="progressPercentage" type="float" />
    <field id="positionTime" type="float" />
    <field id="remainingPositionTime" type="float" />
    <field id="playbackState" type="string" value="" alwaysNotify="true" />

    <!-- Actions/UI state -->
    <field id="action" type="string" alwaysNotify="true" />
    <field id="shouldShowChapterList" type="boolean" alwaysNotify="true" />
    <field id="hasFocus" type="boolean" alwaysNotify="true" />
  </interface>
</component>