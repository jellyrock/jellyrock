<?xml version="1.0" encoding="utf-8"?>
<component name="OSD" extends="JRScreen">
  <children>
    <!-- Background overlay so we can see UI -->
    <Gradient width="1920" height="300" translation="[0, 0]" />
    <Gradient width="1920" height="350" rotateDegrees="180" translation="[0, 640]" />
    <Rectangle color="0x000000FF" width="1920" height="90" translation="[0,990]" />

    <!-- HEADER LEFT -->
    <LayoutGroup id="videoLogoGroup" itemSpacings="[15]" layoutDirection="vert" translation="[96,54]">
      <!-- loadWidth/loadHeight set from imageSize.LOGO_OSD in OSD.bs init() -->
      <Poster id="videoLogo" loadDisplayMode="noScale" />
    </LayoutGroup>

    <!-- HEADER RIGHT -->
    <Clock />

    <!-- MAIN -->
    <!-- Video information - title, season/episode number etc. -->
    <LayoutGroup id="videoInfoGroup" itemSpacings="[9]" layoutDirection="vert" translation="[96,740]">
      <LabelSecondaryLargest id="videoTitle" isBold="true" width="1400" />
      <LayoutGroup id="videoSubtitleGroup" itemSpacings="[9]" layoutDirection="horiz" />
    </LayoutGroup>

    <!-- Ends at time -->
    <LayoutGroup id="endsAtGroup" itemSpacings="[12]" layoutDirection="horiz" horizAlignment="right" translation="[1824,759]">
      <LabelSecondaryMedium id="endsAtText" isBold="true" text="" />
      <LabelSecondaryMedium id="endsAtTime" isBold="true" />
    </LayoutGroup>


    <!-- Progress bar -->
    <LabelSecondaryMedium id="videoPositionTime" isBold="true" translation="[96,868]" />
    <RectangleBackgroundSecondary id="progressBarBackground" width="1425" height="9" translation="[240,880]">
      <RectangleSecondary id="progressBar" width="0" height="9" />
    </RectangleBackgroundSecondary>
    <LabelSecondaryMedium id="videoRemainingTime" isBold="true" horizAlign="right" width="200" translation="[1624,868]" />

    <!-- FOOTER -->
    <OSDButtonGroup id="buttonMenuLeft" translation="[90,932]">
      <IconButton id="itemBack" icon="pkg:/images/icons/itemPrevious_$$RES$$.png" />
      <IconButton id="videoPlayPause" icon="pkg:/images/icons/play_$$RES$$.png" />
      <IconButton id="itemNext" icon="pkg:/images/icons/itemNext_$$RES$$.png" />
      <!-- Go to Live: removed from the row by setButtonStates() for anything that is not
           a TvChannel, and kept for the whole item when it IS one: greyed at the live
           edge rather than detached, so the row never reshuffles mid-playback. See the
           setButtonStates() comment in OSD.bs. visible="false" is defense-in-depth for
           the frame between XML load and setButtonStates running. -->
      <IconButton id="goToLive" icon="pkg:/images/icons/liveTV_$$RES$$.png" visible="false" />
      <IconButton id="showVideoSourceMenu" icon="pkg:/images/icons/videoFile_$$RES$$.png" />
      <IconButton id="showAudioMenu" icon="pkg:/images/icons/musicNote_$$RES$$.png" />
      <IconButton id="showSubtitleMenu" icon="pkg:/images/icons/closedCaptions_$$RES$$.png" />
      <IconButton id="chapterList" icon="pkg:/images/icons/chapters_$$RES$$.png" />
    </OSDButtonGroup>
    <!-- Right aligned: the playback-settings gear, then the video info popup. The gear opens
         its own menu (see openSettingsMenu in OSD.bs) and is removed by setButtonStates()
         when that menu would have no rows. -->
    <OSDButtonGroup id="buttonMenuRight" horizAlignment="right" translation="[1830,932]">
      <IconButton id="showPlaybackSettings" icon="pkg:/images/icons/settings_$$RES$$.png" />
      <IconButton id="showVideoInfoPopup" icon="pkg:/images/icons/fileInfo_$$RES$$.png" />
    </OSDButtonGroup>

    <!-- Overflow stash. Holds the left-row buttons that did not fit, in order, while
         "More" stands in for them (see applyOverflow in OSD.bs). A child of the SCREEN
         and, on purpose, not of buttonMenuLeft: a hidden child of a LayoutGroup still
         reserves its slot, so an overflowed button has to leave the group entirely. -->
    <Group id="buttonOverflow" visible="false" />

    <Timer id="inactivityTimer" duration="1" repeat="true" />
  </children>
  <interface>
    <!-- Item data node (JellyfinBaseItem) - read-only source for all media metadata.
         OSD reads typed fields directly: type, name, seriesName, officialRating, etc.
         Set by VideoPlayerView when video content loads.

         No onChange, on purpose: the observer is registered in init() instead, so
         onDestroy can detach it. VideoPlayerView owns this field and can deliver one
         last change while teardown is running, which is the case components/CLAUDE.md
         requires an unobserveField for, and an XML onChange does not appear to be
         removable by unobserveField, so it could not be undone here.
         Declaring both registers TWO observers and runs the handler twice. -->
    <field id="itemData" type="node" />

    <!-- Presentation state computed from itemData in onItemDataChanged() -->
    <field id="isMovie" type="boolean" value="false" />
    <field id="isSeries" type="boolean" value="false" />
    <field id="hasChapters" type="boolean" value="false" />
    <field id="numAudioStreams" type="integer" />
    <field id="numVideoSources" type="integer" />
    <!-- Active video source tag (for example, "[B&W]", "[Colorized]") appended to OSD title
         when multiple video sources exist. Set by VideoPlayerView. -->
    <field id="videoSourceTag" type="string" value="" />
    <field id="runTimeMinutes" type="integer" />
    <!-- The playing video stream's bitrate in bit/s, 0 when unknown. Trims the Maximum
         Bitrate choices to the ones that can change anything. Set by VideoPlayerView. -->
    <field id="sourceVideoBitrate" type="integer" value="0" />

    <!-- Playback state (set by VideoPlayerView) -->
    <field id="videoLogo" type="string" value="" />
    <field id="inactiveTimeout" type="integer" />
    <field id="progressPercentage" type="float" />
    <field id="positionTime" type="float" />
    <field id="remainingPositionTime" type="float" />
    <field id="playbackState" type="string" value="" alwaysNotify="true" />

    <!-- Actions/UI state -->
    <field id="action" type="string" alwaysNotify="true" />
    <field id="shouldShowChapterList" type="boolean" alwaysNotify="true" />
    <field id="hasFocus" type="boolean" alwaysNotify="true" />
    <!-- A pick in the gear menu: { field, value }, field a playbackCaps field
         ("maxBitrateMbps", "maxResolution"). Written only when it differs from the value
         that applies; VideoPlayerView applies it to this queue and reloads the stream. -->
    <field id="playbackCapsPick" type="assocarray" alwaysNotify="true" />
  </interface>
</component>