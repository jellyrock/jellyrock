<?xml version="1.0" encoding="utf-8"?>
<component name="JROverhang" extends="Group">
  <children>
    <!-- Logo -->
    <Poster id="logo" translation="[96, 54]" uri="pkg:/images/branding/logo.png" height="39" width="180" />
    <!-- Title -->
    <ScrollingLabelPrimaryLarge translation="[360, 51]" id="title" vertAlign="center" maxWidth="300" repeatCount="0" />
    <!-- User dropdown (created programmatically in init) -->
    <!-- Clock -->
    <Clock />

  </children>
  <interface>
    <field id="currentUser" type="string" onChange="onCurrentUserChanged" />
    <field id="title" type="string" onChange="onTitleChanged" />
    <field id="isVisible" value="true" type="boolean" onChange="onIsVisibleChanged" />
    <field id="isMoveAnimationDisabled" value="false" type="boolean" />
    <field id="isLogoVisible" value="true" type="boolean" onChange="onIsLogoVisibleChanged" />
    <field id="tabs" type="array" onChange="onTabsChanged" />
    <field id="selectedTabId" type="string" alwaysNotify="true" />
    <field id="shouldShowIcons" type="boolean" value="false" onChange="onShouldShowIconsChanged" />
    <field id="iconAction" type="string" alwaysNotify="true" />
    <!-- Clock visibility — default true. Set to false from any screen that wants
         the clock hidden (e.g. Home, when the user has uiDesignHideClock enabled).
         Replaces the old imperative hideClock() function so all overhang element
         visibility follows one field-assignment pattern. -->
    <field id="isClockVisible" value="true" type="boolean" onChange="isClockVisibleChanged" />
    <!-- User-dropdown visibility override. Dropdown still requires a logged-in
         user (currentUser <> ""); this field is an additional AND gate so a
         screen can hide the dropdown even when a user is signed in
         (e.g. SearchScreen's clock-only chrome). Default true. -->
    <field id="isUserDropdownVisible" value="true" type="boolean" onChange="isUserDropdownVisibleChanged" />
    <function name="getTabBar" />
    <function name="getUserDropdown" />
    <function name="getSearchIcon" />
    <function name="getSettingsIcon" />
  </interface>
</component>
