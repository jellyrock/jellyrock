<?xml version="1.0" encoding="utf-8"?>
<!--
  The top bar, one row: logo (Home only), the tab bar (the screen's views as text buttons
  with a glyph, one selected) or the title in its place, then the user dropdown (Home only),
  the fixed cluster (Search, Settings) and the clock. The cluster is the same on every
  screen that shows it; a screen's own controls live on the screen. Left and Right walk tab
  bar, dropdown and cluster as one row that wraps at both ends; Down returns to the screen.
-->
<component name="JROverhang" extends="Group">
  <children>
    <!-- Logo -->
    <!-- Logo, title: placed by JROverhang.bs (LOGO_Y, layout()) -->
    <Poster id="logo" uri="pkg:/images/branding/logo.png" height="39" width="180" />
    <!-- Title: shown when the screen has no tabs, at the tab bar's place, with an optional
         glyph before it (titleIcon), the row's glyph size, placed by layout() -->
    <Poster id="titleGlyph" visible="false" />
    <ScrollingLabelPrimaryLarge id="title" vertAlign="center" maxWidth="300" repeatCount="0" />
    <!-- Tab bar, user dropdown and cluster are created programmatically -->
    <!-- Clock -->
    <Clock />

  </children>
  <interface>
    <field id="currentUser" type="string" onChange="onCurrentUserChanged" />
    <field id="title" type="string" onChange="onTitleChanged" />
    <!-- A glyph before the title (an image uri, "" for none), drawn in the title's color -->
    <field id="titleIcon" type="string" onChange="onTitleIconChanged" />
    <field id="isVisible" value="true" type="boolean" onChange="onIsVisibleChanged" />
    <field id="isMoveAnimationDisabled" value="false" type="boolean" />
    <field id="isLogoVisible" value="true" type="boolean" onChange="onIsLogoVisibleChanged" />
    <!-- The tab bar's entries: { id, title, icon, selectedIcon }, projected from the active view's
         overhangTabs. Empty hides the tab bar and shows the title in its place. -->
    <field id="tabs" type="array" onChange="onTabsChanged" />
    <field id="selectedTabId" type="string" alwaysNotify="true" />
    <!-- Whether the fixed cluster shows: JRScene sets it from the signed-in state, so the
         cluster is on every screen that shows the overhang once a user is signed in. -->
    <field id="isClusterVisible" type="boolean" value="false" onChange="onIsClusterVisibleChanged" />
    <!-- A cluster icon was pressed: its entry id ("search", "settings"). JRScene routes it. -->
    <field id="iconAction" type="string" alwaysNotify="true" />
    <!-- A user dropdown item was chosen: its HomeAction. JRScene relays it to main.bs. -->
    <field id="userMenuAction" type="string" alwaysNotify="true" />
    <!-- Down left the row: the element it was pressed on ("tabs", "dropdown" or "cluster").
         JRScene hands focus back to the active screen; the overhang remembers the element,
         so the next Up on this screen visit lands there (focusRow). -->
    <field id="requestFocusReturn" type="string" alwaysNotify="true" />
    <!-- Clock visibility: default true. Projected here from the active routed view's
         own isClockVisible field by JRScene's overhang controller, which also applies the
         user's Hide clock setting; screens declare, they do not write this node. Replaces
         the old imperative hideClock() function so all overhang element visibility follows
         one field-assignment pattern. -->
    <field id="isClockVisible" value="true" type="boolean" onChange="isClockVisibleChanged" />
    <!-- The cluster icon for an entry id ("search", "settings"), for a screen's focus bookkeeping. -->
    <function name="getIcon" />
    <!-- Up from a screen: focus the element Down last left the row from, else the first shown
         (tabs, dropdown, cluster). Returns false when the row has nothing to focus. -->
    <function name="focusRow" />
    <!-- Forget where the row was left from: the controller calls it on every screen change. -->
    <function name="resetRowMemory" />
    <function name="resetTime" />
  </interface>
</component>
