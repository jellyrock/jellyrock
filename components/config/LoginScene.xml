<?xml version="1.0" encoding="utf-8"?>
<component name="LoginScene" extends="JRScreen">
  <children>
    <LabelPrimaryLarge text="" id="prompt" translation="[150, 150]" isBold="true" />
    <ConfigList id="configOptions" translation="[150, 240]" />
    <CheckList id="onOff" translation="[200, 450]" />
    <JRButtonGroup id="buttons" itemSpacings="[72]" translation="[150,550]">
      <TextButton id="submit" minWidth="330" text="" />
    </JRButtonGroup>
    <LabelErrorMedium text="" id="alert" wrap="true" width="1620" translation="[150, 680]" />
  </children>
  <interface>
    <!-- Submit payload read by the loginRouter coordinator (via getActiveView) when this view
         emits the "credentialsSubmitted" intent. -->
    <field id="enteredUsername" type="string" />
    <field id="enteredPassword" type="string" />
    <field id="saveCredentials" type="boolean" value="false" />
    <!-- Auth-failure message set by the coordinator after a rejected getToken. -->
    <field id="alert" type="string" alias="alert.text" />
  </interface>
</component>