<?xml version="1.0" encoding="utf-8"?>
<component name="JRScreen" extends="JRGroup">
  <interface>
    <!-- A screen that plays (the video host, the audio player): reaching it is where a playback
         start is meant to go, so it does not count as leaving the start (appWaits.leftBehind). -->
    <field id="isPlaybackScreen" type="boolean" value="false" />
    <!-- The overhang cluster icon this screen was left by ("search", "settings"), "" for none:
         JRScene writes it on the press, and the screen focuses that icon again when the viewer
         comes back (restoreOverhangIconFocus). -->
    <field id="overhangReturnIcon" type="string" value="" />
    <!-- Remembers the focused descendant in lastFocus, as the router's suspend does. Also
         AppWaitHost's, before it holds the focus of a screen a playback start hides. -->
    <function name="saveLastFocus" />
    <function name="onScreenShown" />
    <function name="onScreenHidden" />
    <function name="onDestroy" />
    <!-- JRScene's screen swap: hide this view in the step the view covering it opens. -->
    <function name="hideCovered" />
    <!-- main.bs: the screensaver ended over this screen. Refresh it, keeping the focus. -->
    <function name="onScreensaverExited" />
    <!-- Down left the overhang row: take focus back (restoreScreenFocus). -->
    <function name="returnFocusFromOverhang" />
    <!-- A cluster icon was pressed while this screen is active: return true to handle it here
         (the search screen reopens its keyboard on the search icon); false lets JRScene route
         it (search and settings open their screens). -->
    <function name="onOverhangAction" />
    <!-- The router closed this view for good and its onDestroy has run (beforeViewClose). It
         can stay the active view for a moment after that, so JRScene checks this before it
         calls a hook that reads the screen's own state. -->
    <field id="isClosed" type="boolean" value="false" />
    <!-- Star reached JRScene instead of this screen (focus was in the overhang row): do what
         Star does here. True when something happened. -->
    <function name="onOptionsKey" />
    <!-- Back from the overhang row: leave this screen. True when it went back (leaveScreen). -->
    <function name="leaveScreen" />
  </interface>
</component>