import "pkg:/source/api/ApiClient.bs"
import "pkg:/source/api/imageHelpers.bs"
import "pkg:/source/enums/HomeAction.bs"
import "pkg:/source/translationKeys.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/overhangRow.bs"
import "pkg:/source/utils/pixelGrid.bs"
import "pkg:/source/utils/translate.bs"

const OVERHANG_LEFT = 96 ' The 5% action-safe left edge: the logo, or the tabs without one
const TABS_X_WITH_LOGO = 360 ' The tabs' text (or the title) starts here when the logo shows
const OVERHANG_RIGHT = 1824 ' The 5% action-safe right edge: the clock's right edge
' The clock's slot. Limit with headroom: "8:48" measured 99 px wide at 1080p on a Stick 4K
' (2026-10-25); four digits and the separator stay under this.
const CLOCK_SLOT = 150
const LOGO_Y = 51 ' The wordmark's caps and baseline sit on the tab text's (baseline at design y 81)
const TITLE_MIN_WIDTH = 120 ' The title keeps at least this, whatever the dropdown's width
const DROPDOWN_PROVISIONAL_WIDTH = 198 ' Until the trigger reports its width

sub init()
  m.top.id = "overhang"
  ' save node references
  m.logo = m.top.findNode("logo")
  m.logoPoster = createLogoPoster() ' save node to memory for faster load time
  m.title = m.top.findNode("title")
  m.status = m.top.findNode("status")
  m.status.height = overhangRow.ROW_HEIGHT
  m.titleMeasure = m.top.findNode("titleMeasure")
  ' The title's text width is read off titleMeasure once it has rendered (layout)
  m.top.observeField("renderTracking", "onRenderComplete")
  m.clock = m.top.findNode("clock")
  m.clock.boxY = overhangRow.TEXT_TOP
  m.clock.boxHeight = overhangRow.ROW_HEIGHT
  ' The title centers in the same box as a tab's text, so its caps sit where the tabs' do
  m.title.height = overhangRow.ROW_HEIGHT
  if isValid(m.logo) then m.logo.translation = [OVERHANG_LEFT, LOGO_Y]
  m.isClockHidden = false

  ' Create user dropdown
  m.userDropdown = CreateObject("roSGNode", "JRDropdown")
  m.userDropdown.id = "userDropdown"
  m.userDropdown.menuWidth = 300
  m.userDropdown.padding = overhangRow.BOX_PADDING ' the same inside every overhang box
  m.userDropdown.visible = false ' hidden until user logs in
  m.top.appendChild(m.userDropdown)
  m.userDropdown.minHeight = overhangRow.ROW_HEIGHT

  ' Reposition everything when the trigger button width changes (a username change, say)
  m.userDropdown.observeField("triggerWidth", "onLayoutInputChanged")
  m.userDropdown.observeField("requestFocusExit", "onUserDropdownFocusExit")
  m.userDropdown.observeField("requestFocusReturn", "onUserDropdownFocusReturn")
  m.userDropdown.observeField("selectedAction", "onUserMenuAction")

  ' The tab bar (the active screen's views, one selected; Home: Home, Favorites) is created
  ' on the first non-empty tabs and kept for reuse (onTabsChanged).
  m.tabBar = invalid

  ' The fixed cluster: the same icons on every screen that shows it
  m.cluster = CreateObject("roSGNode", "JROverhangIconBar")
  m.cluster.id = "cluster"
  m.cluster.entries = [
    { id: "search", icon: "pkg:/images/icons/search_$$RES$$.png" },
    { id: "settings", icon: "pkg:/images/icons/settings_$$RES$$.png" }
  ]
  m.cluster.visible = false
  m.cluster.observeField("selectedAction", "onIconAction")
  m.cluster.observeField("requestFocusExit", "onClusterFocusExit")
  m.cluster.observeField("requestFocusReturn", "onClusterFocusReturn")
  m.top.appendChild(m.cluster)

  ' Where Down last left the row on this screen visit (focusRow, resetRowMemory)
  m.lastRowElement = ""
  m.lastRowIconId = ""

  layout()

  ' Create animations programmatically to avoid interpolator field reference issues
  createSlideAnimations()
end sub

' Create slide animations programmatically
sub createSlideAnimations()
  ' Create slide up animation
  m.slideUpAnimation = createObject("roSGNode", "Animation")
  m.slideUpAnimation.id = "slideUp"
  m.slideUpAnimation.duration = 0.5
  m.slideUpAnimation.repeat = false

  slideUpInterpolator = createObject("roSGNode", "Vector2DFieldInterpolator")
  slideUpInterpolator.key = [0.0, 0.5]
  slideUpInterpolator.keyValue = [[0, 0], [0, -200]]
  slideUpInterpolator.fieldToInterp = m.top.id + ".translation"

  m.slideUpAnimation.appendChild(slideUpInterpolator)
  m.top.appendChild(m.slideUpAnimation)

  ' Create slide down animation
  m.slideDownAnimation = createObject("roSGNode", "Animation")
  m.slideDownAnimation.id = "slideDown"
  m.slideDownAnimation.duration = 0.5
  m.slideDownAnimation.delay = 0.2
  m.slideDownAnimation.repeat = false

  slideDownInterpolator = createObject("roSGNode", "Vector2DFieldInterpolator")
  slideDownInterpolator.key = [0.0, 0.5]
  slideDownInterpolator.keyValue = [[0, -200], [0, 0]]
  slideDownInterpolator.fieldToInterp = m.top.id + ".translation"

  m.slideDownAnimation.appendChild(slideDownInterpolator)
  m.top.appendChild(m.slideDownAnimation)
end sub

sub onIsVisibleChanged()
  if m.top.isMoveAnimationDisabled
    m.top.translation = [0, 0]
    return
  end if
  if m.top.isVisible
    m.slideDownAnimation.control = "start"
    return
  end if

  m.slideUpAnimation.control = "start"
end sub

sub onTitleChanged()
  m.title.text = m.top.title
  m.titleMeasure.text = m.top.title
  layout()
end sub

sub onStatusChanged()
  m.status.text = m.top.status
  layout()
end sub

' The status waits for the title's measured width, which a label reports only once rendered
sub onRenderComplete()
  if m.top.renderTracking <> "full" then return
  if m.status.text <> "" then layout()
end sub


' ============================================
' USER DROPDOWN
' ============================================

sub onCurrentUserChanged()
  username = m.top.currentUser

  if username = ""
    ' No user logged in: hide the dropdown
    m.userDropdown.visible = false
    m.userDropdown.triggerText = ""
    m.userDropdown.triggerIconUri = ""
  else
    ' User logged in: configure and show the dropdown. A screen that wants no
    ' dropdown leaves shouldShowUserDropdown false, and the controller clears
    ' currentUser instead, which lands in the branch above.
    m.userDropdown.triggerText = username
    m.userDropdown.visible = true

    ' Set user avatar image
    localUser = m.global.user
    if isValidAndNotEmpty(localUser.primaryImageTag)
      m.userDropdown.triggerIconBlendColor = "0xFFFFFFFF"
      if m.global.server.serverUrl <> ""
        m.userDropdown.triggerIconUri = GetUserAvatarURL(localUser, overhangRow.GLYPH_SIZE, overhangRow.GLYPH_SIZE)
      end if
    else
      m.userDropdown.triggerIconBlendColor = m.global.constants.colorTextSecondary
      m.userDropdown.triggerIconUri = "pkg:/images/icons/person_$$RES$$.png"
    end if

    ' Set menu items: user-related actions only
    m.userDropdown.items = [
      { title: translate(translationKeys.LabelChangeUser), id: HomeAction.CHANGE_USER },
      { title: translate(translationKeys.LabelChangeServer), id: HomeAction.CHANGE_SERVER },
      { title: translate(translationKeys.ButtonSignOut), id: HomeAction.SIGN_OUT }
    ]
  end if

  layout()
end sub

' The cluster is the same on every screen: JRScene shows it while a user is signed in.
sub onIsClusterVisibleChanged()
  m.cluster.visible = m.top.isClusterVisible
  layout()
end sub

' The cluster icon for an entry id, for a screen's focus-return observers
function getIcon(id as string) as object
  return m.cluster.callFunc("getIcon", id)
end function

' Proxies a cluster press (the entry id) to the overhang-level iconAction field
sub onIconAction()
  m.top.iconAction = m.cluster.selectedAction
end sub

sub onUserMenuAction()
  m.top.userMenuAction = m.userDropdown.selectedAction
end sub

' ============================================
' UP INTO THE ROW, DOWN OUT OF IT
' ============================================
' A screen's Up enters the row through focusRow; Down on any element leaves it through
' requestFocusReturn, which also records the element so the next Up lands there. The
' controller forgets it on a screen change.

function focusRow() as boolean
  shown = { tabs: tabBarShowing(), dropdown: m.userDropdown.visible, cluster: m.cluster.visible }
  element = overhangRow.entryElement(shown, m.lastRowElement)
  if element = "tabs"
    m.tabBar.setFocus(true)
  else if element = "dropdown"
    m.userDropdown.setFocus(true)
  else if element = "cluster"
    icon = invalid
    if m.lastRowIconId <> "" then icon = m.cluster.callFunc("getIcon", m.lastRowIconId)
    if isValid(icon)
      icon.setFocus(true)
    else
      m.cluster.callFunc("focusEdge", "left")
    end if
  else
    return false
  end if
  return true
end function

sub resetRowMemory()
  m.lastRowElement = ""
  m.lastRowIconId = ""
end sub

sub onTabBarFocusReturn()
  m.lastRowElement = "tabs"
  m.top.requestFocusReturn = "tabs"
end sub

sub onUserDropdownFocusReturn()
  m.lastRowElement = "dropdown"
  m.top.requestFocusReturn = "dropdown"
end sub

sub onClusterFocusReturn()
  m.lastRowElement = "cluster"
  m.lastRowIconId = m.cluster.requestFocusReturn
  m.top.requestFocusReturn = "cluster"
end sub

' ============================================
' FOCUS BRIDGING: TAB BAR <-> DROPDOWN <-> CLUSTER
' ============================================
' One row, left to right: tab bar, dropdown, cluster. Each hands focus to its visible
' neighbor, and the row wraps: Left from its first element lands on its last, Right from
' its last on its first.

function tabBarShowing() as boolean
  return isValid(m.tabBar) and m.tabBar.visible
end function

sub focusLastTab()
  tabCount = m.tabBar.findNode("tabContainer").getChildCount()
  m.tabBar.focusedTabIndex = tabCount - 1
  m.tabBar.setFocus(true)
end sub

sub focusFirstTab()
  m.tabBar.focusedTabIndex = 0
  m.tabBar.setFocus(true)
end sub

' Moves focus along the row from `from` by a Left or Right press; overhangRow.nextFocus
' decides where, so a Rooibos spec covers every combination of elements shown.
sub moveRowFocus(from as string, direction as string)
  shown = { tabs: tabBarShowing(), dropdown: m.userDropdown.visible, cluster: m.cluster.visible }
  target = overhangRow.nextFocus(shown, from, direction)
  if target.element = "tabs"
    if target.edge = "first" then focusFirstTab() else focusLastTab()
  else if target.element = "dropdown"
    m.userDropdown.setFocus(true)
  else if target.element = "cluster"
    if target.edge = "first" then m.cluster.callFunc("focusEdge", "left") else m.cluster.callFunc("focusEdge", "right")
  end if
end sub

' The tab bar signals when a press walks off one of its ends
sub onTabBarRequestsUserMenu()
  moveRowFocus("tabs", m.tabBar.requestFocusToUserMenu)
end sub

sub onUserDropdownFocusExit()
  moveRowFocus("dropdown", m.userDropdown.requestFocusExit)
end sub

sub onClusterFocusExit()
  moveRowFocus("cluster", m.cluster.requestFocusExit)
end sub

' ============================================
' POSITIONING
' ============================================

' Observer for the isClockVisible interface field. Toggles the clock's visibility
' and lays the row out again so the right-edge chrome still lines up.
sub isClockVisibleChanged()
  visible = m.top.isClockVisible
  if isValid(m.clock) then m.clock.visible = visible
  m.isClockHidden = not visible
  layout()
end sub

sub onLayoutInputChanged()
  layout()
end sub

' Places the row from both edges in. From the left: the tab bar, or the title in its
' place, at the logo's right. From the right: the cluster against the clock's slot (or the
' safe edge with the clock hidden), the dropdown before the cluster. The title takes what
' is left between, and scrolls when the text is longer.
sub layout()
  if not isValid(m.cluster) or not isValid(m.userDropdown) then return

  tabsX = OVERHANG_LEFT
  if isValid(m.logo) then tabsX = TABS_X_WITH_LOGO
  if isValid(m.tabBar)
    ' A tab's box is the row's text box, so its caps, not the box, center on the row. The
    ' text starts at tabsX because the box pads BOX_PADDING.
    m.tabBar.translation = [tabsX - overhangRow.BOX_PADDING, overhangRow.TEXT_TOP]
  end if

  titleX = tabsX

  rightEdge = OVERHANG_RIGHT - CLOCK_SLOT
  if m.isClockHidden then rightEdge = OVERHANG_RIGHT

  leftOfCluster = rightEdge
  if m.cluster.visible
    clusterX = rightEdge - m.cluster.barWidth
    m.cluster.translation = [clusterX, overhangRow.ROW_TOP]
    leftOfCluster = clusterX - overhangRow.ELEMENT_GAP
  end if

  leftOfDropdown = leftOfCluster
  if m.userDropdown.visible
    triggerWidth = m.userDropdown.triggerWidth
    if triggerWidth <= 0 then triggerWidth = DROPDOWN_PROVISIONAL_WIDTH
    dropdownX = leftOfCluster - triggerWidth
    m.userDropdown.translation = [dropdownX, overhangRow.ROW_TOP]
    leftOfDropdown = dropdownX - overhangRow.ELEMENT_GAP
  end if

  m.title.translation = [titleX, overhangRow.TEXT_TOP]
  titleWidth = leftOfDropdown - titleX
  if titleWidth < TITLE_MIN_WIDTH then titleWidth = TITLE_MIN_WIDTH
  m.title.maxWidth = titleWidth

  ' The status follows the title's text (its measured width, on the grid), a tab gap after, and
  ' takes what is left; it hides until the title has rendered, or when the title alone fills
  ' the slot. Its maxWidth is the same shared box, so it sits on the title's line.
  m.status.visible = false
  if m.status.text <> "" and m.title.visible
    textWidth = snapToGrid(-int(-m.titleMeasure.localBoundingRect().width))
    statusX = titleX + textWidth + overhangRow.TAB_GAP
    statusWidth = leftOfDropdown - statusX
    if textWidth > 0 and statusWidth >= TITLE_MIN_WIDTH
      m.status.translation = [statusX, overhangRow.TEXT_TOP]
      m.status.maxWidth = statusWidth
      m.status.visible = true
    end if
  end if
end sub

' component boolean field isVisible has changed value
sub onIsLogoVisibleChanged()
  if m.top.isLogoVisible
    if not isValid(m.logo)
      m.logo = m.logoPoster
      m.top.appendChild(m.logoPoster)
    end if
  else
    ' remove the logo
    if isValid(m.logo)
      m.top.removeChild(m.logo)
      m.logo = invalid
    end if
  end if

  layout()
end sub

' Create and return a logo poster node
function createLogoPoster()
  logoPoster = createObject("roSGNode", "Poster")
  logoPoster.id = "logo"
  logoPoster.uri = "pkg:/images/branding/logo.png"
  logoPoster.translation = [OVERHANG_LEFT, LOGO_Y]
  logoPoster.width = "180"
  logoPoster.height = "39"

  return logoPoster
end function

' ============================================
' TAB BAR
' ============================================

' onTabsChanged: Swaps between title label and tab bar.
' Empty/invalid tabs restores the title label; non-empty creates a JRTabBar.
sub onTabsChanged()
  tabs = m.top.tabs

  if not isValidAndNotEmpty(tabs)
    ' No tabs: hide the tab bar (preserve it for instant reuse on return)
    ' and restore the title label
    if isValid(m.tabBar)
      m.tabBar.unobserveField("isReady") ' cancel any pending ready observer before restoring title
      m.tabBar.visible = false
    end if
    m.title.visible = true
    layout()
    return
  end if

  if not isValid(m.tabBar)
    m.tabBar = CreateObject("roSGNode", "JRTabBar")
    m.tabBar.id = "tabBar"
    m.tabBar.observeField("selectedTabId", "onTabBarSelectionChanged")
    m.tabBar.observeField("requestFocusToUserMenu", "onTabBarRequestsUserMenu")
    m.tabBar.observeField("requestFocusReturn", "onTabBarFocusReturn")
    m.top.appendChild(m.tabBar)
  end if

  m.tabBar.visible = true
  layout()

  ' Sync current selection before setting tabs (so the correct tab starts selected)
  if isValidAndNotEmpty(m.top.selectedTabId)
    m.tabBar.selectedTabId = m.top.selectedTabId
  end if

  m.tabBar.tabs = tabs

  ' After setting tabs, check if they were preserved (return path) or rebuilt (init).
  ' Preserved tabs are already sized, so hide title instantly.
  ' Rebuilt tabs need render tracking, so keep title visible until ready.
  if m.tabBar.isReady
    m.title.visible = false
  else
    m.tabBar.unobserveField("isReady") ' prevent stacking duplicate observers on rapid tab changes
    m.tabBar.observeField("isReady", "onTabBarReady")
  end if
end sub

' Called when newly created tabs finish sizing. Swaps the title for the
' fully-formed tab bar in a single frame: no blank gap or sizing dance.
sub onTabBarReady()
  if isValid(m.tabBar)
    m.tabBar.unobserveField("isReady")
  end if
  m.title.visible = false
end sub

' Proxy tab bar selection changes to the overhang's selectedTabId field
sub onTabBarSelectionChanged()
  if isValid(m.tabBar)
    m.top.selectedTabId = m.tabBar.selectedTabId
  end if
end sub

sub resetTime()
  if isValid(m.clock)
    m.clock.callFunc("resetTime")
  end if
end sub
