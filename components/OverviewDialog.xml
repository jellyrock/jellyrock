<?xml version="1.0" encoding="utf-8"?>
<!-- OverviewDialog: the read-only long-form overlay (item descriptions, the
     playback-info report). Appended to the scene by FocusableOverview or by
     showInfoDialog; dismisses itself via removeChild + returnFocusTo. Supports
     vertical scrolling.

     Its OK button flows INSIDE the panel, like every other dialog in the family
     (computeDialogLayout's footerInside). It used to sit below the panel on the
     reasoning that a panel this large still reads as owning a button beneath it;
     a before/after capture on device did not support that — the outside button
     read as floating on the dimmed backdrop while the panel above it carried
     several hundred pixels of dead space. One footer placement, family-wide.

     Its KEY MODEL is still its own, and that part is not drift: a scrolling body
     needs up/down for the scroll, so focus moves between the text area and OK
     rather than along a button row. See onKeyEvent below. -->
<component name="OverviewDialog" extends="JRGroup">
  <children>
    <!-- Dimmed backdrop, panel, edge, title and accent rule — shared with the rest
         of the dialog family. See JRDialogPanel.xml for the ordering contract. -->
    <JRDialogPanel id="chrome" />

    <!-- Scrollable text area (clippingRect constrains visible area) -->
    <Group id="textClip" focusable="true">
      <!-- Tagline label is created dynamically only when tagline text is provided -->
      <LayoutGroup id="scrollContent" layoutDirection="vert" itemSpacings="[20]">
        <LabelPrimaryMedium id="overviewText" wrap="true" />
      </LayoutGroup>
    </Group>

    <!-- Scroll position indicator -->
    <Rectangle id="scrollTrack" width="3" />
    <Rectangle id="scrollThumb" width="12" />

    <!-- OK button -->
    <TextButton id="okButton" text="" />

    <!-- Delays ONLY the opening announcement; see OPENING_ANNOUNCEMENT_DELAY in
         components/dialogs/JRDialog.bs. -->
    <Timer id="narrationTimer" repeat="false" />
  </children>
  <interface>
    <field id="title" type="string" onChange="onTitleChanged" />
    <field id="tagline" type="string" onChange="onTaglineChanged" />
    <field id="overview" type="string" onChange="onOverviewChanged" />
    <!-- Node to restore remote focus to when this overlay closes (the FocusableOverview that
         opened it). Set by the opener before appendChild. -->
    <field id="returnFocusTo" type="node" />
    <!-- Cancel this dialog from OUTSIDE (source/utils/dialogs.bs cancelOpenDialog).
         This dialog has no result to deliver, so cancelling is just closing. -->
    <function name="cancelDialog" />
  </interface>
</component>