<?xml version="1.0" encoding="utf-8"?>
<!--
  LOADING STATE PATTERN: STATIC INITIALIZATION

  Constants are static and loaded once at startup.
  No network operations, no loading states needed.

  COLORS: All colors are 6 hex digits (no alpha), no "0x" prefix
  ALPHAS: All alpha values are 2 hex digits
  Usage: node.color = constants.colorPrimary (direct use)
         node.color = constants.colorBlack + constants.alpha60 (with alpha)

  THEME COLORS: Default values are loaded from settings.json via loadThemeColorDefaults()
  in globals.bs. This ensures settings.json is the single source of truth for theme colors.
-->
<component name="Constants" extends="ContentNode">
  <interface>
    <!-- Theme Colors (defaults loaded from settings.json) -->
    <field id="colorPrimary" type="string" />
    <field id="colorSecondary" type="string" />
    <field id="colorYellow" type="string" value="0xEAB308" />

    <!-- Text Colors (defaults loaded from settings.json) -->
    <field id="colorTextPrimary" type="string" />
    <field id="colorTextSecondary" type="string" />
    <field id="colorTextDisabled" type="string" />
    <field id="colorTextError" type="string" value="0xff0000" />

    <!-- Semantic Colors (used app-wide for status indication) -->
    <field id="colorSuccess" type="string" value="0x16A34A" />
    <field id="colorError" type="string" value="0xDC2626" />
    <field id="colorWarning" type="string" value="0xEAB308" />
    <field id="colorInfo" type="string" value="0x2563EB" />

    <!-- Background Colors (defaults loaded from settings.json) -->
    <field id="colorBackgroundPrimary" type="string" />
    <field id="colorBackgroundSecondary" type="string" />

    <!-- Black for Alpha Assembly (6 hex digits) -->
    <field id="colorBlack" type="string" value="0x000000" />

    <!-- Alpha Values (2 hex digits) -->
    <field id="alpha0" type="string" value="00" />
    <field id="alpha10" type="string" value="1A" />
    <field id="alpha20" type="string" value="33" />
    <field id="alpha30" type="string" value="4D" />
    <field id="alpha40" type="string" value="66" />
    <field id="alpha50" type="string" value="80" />
    <field id="alpha60" type="string" value="99" />
    <field id="alpha70" type="string" value="B3" />
    <field id="alpha80" type="string" value="CC" />
    <field id="alpha90" type="string" value="E6" />
    <field id="alpha100" type="string" value="FF" />

    <!-- Font Sizes -->
    <field id="fontSizeSmallest" type="integer" value="21" />
    <field id="fontSizeSmaller" type="integer" value="25" />
    <field id="fontSizeSmall" type="integer" value="27" />
    <field id="fontSizeMedium" type="integer" value="32" />
    <field id="fontSizeLarge" type="integer" value="42" />
    <field id="fontSizeLarger" type="integer" value="50" />
    <field id="fontSizeLargest" type="integer" value="60" />

    <!-- Icon Paths -->
    <field id="iconArrowUpBlack" type="string" value="pkg:/images/icons/arrow-up-black_$$RES$$.png" />
    <field id="iconArrowUpWhite" type="string" value="pkg:/images/icons/arrow-up-white_$$RES$$.png" />
    <field id="iconArrowDownBlack" type="string" value="pkg:/images/icons/arrow-down-black_$$RES$$.png" />
    <field id="iconArrowDownWhite" type="string" value="pkg:/images/icons/arrow-down-white_$$RES$$.png" />
    <field id="iconCheckBlack" type="string" value="pkg:/images/icons/check-black_$$RES$$.png" />
    <field id="iconCheckWhite" type="string" value="pkg:/images/icons/check-white_$$RES$$.png" />
    <field id="iconTomatoFresh" type="string" value="pkg:/images/icons/tomato-fresh_$$RES$$.png" />
    <field id="iconTomatoRotten" type="string" value="pkg:/images/icons/tomato-rotten_$$RES$$.png" />
    <field id="iconSuccess" type="string" value="pkg:/images/icons/check_$$RES$$.png" />
    <field id="iconError" type="string" value="pkg:/images/icons/error_$$RES$$.png" />
    <field id="iconWarning" type="string" value="pkg:/images/icons/warning_$$RES$$.png" />
    <field id="iconInfo" type="string" value="pkg:/images/icons/info_$$RES$$.png" />

    <!-- Other Constants -->
    <field id="jellyfinServerResponse" type="string" value="jellyfin server" />
  </interface>
</component>