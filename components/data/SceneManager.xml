<?xml version="1.0" encoding="utf-8"?>
<component name="SceneManager" extends="ContentNode">
  <interface>
    <function name="reloadHome" />
    <function name="refreshThemeColors" />
    <field id="reloadHomeRequested" type="boolean" alwaysNotify="true" />
    <function name="resetTime" />
    <function name="setBackgroundImage" />
    <function name="userMessage" />
    <function name="standardDialog" />
    <function name="radioDialog" />
    <function name="dismissDialog" />
    <function name="isDialogOpen" />
    <function name="showConfirmationDialog" />
    <field id="currentUser" type="string" onChange="updateUser" />
    <field id="returnData" type="assocarray" />
    <field id="isDataReturned" type="boolean" />
    <field id="isPendingExitConfirmation" type="boolean" value="false" />
    <field id="isPendingServerSwitch" type="boolean" value="false" />
    <field id="isPendingPlaybackOptions" type="boolean" value="false" />
  </interface>
</component>