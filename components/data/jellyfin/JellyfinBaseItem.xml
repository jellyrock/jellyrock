<?xml version="1.0" encoding="utf-8"?>
<!--
  FIELD DEFAULT PATTERN: TYPE DEFAULTS

  All fields have explicit type-appropriate defaults (value="", value="0", value="false").
  Roku ContentNode fields cannot be invalid - they always have a type default when declared.

  RULE: If field = default ("", 0, false) → No data (not applicable for type, or API returned empty/null)
  RULE: If field = non-empty/non-zero → Field has real data

  Sentinel: item.id = "" means the node itself is unloaded.
  UI pattern: Check item.type for layout decisions, check field values for display decisions.
  Transformers guarantee atomic population (all relevant fields set together).
  Parent components handle loading UI states (spinners, errors).

  THIS NODE IS IMMUTABLE AFTER TRANSFORMATION.
  No UI component should modify fields after the transformer sets them.
-->
<component name="JellyfinBaseItem" extends="ContentNode">
  <interface>

    <!-- ==================== -->
    <!-- CORE IDENTITY        -->
    <!-- (id inherited from ContentNode) -->
    <!-- ==================== -->
    <field id="type" type="string" value="" />
    <field id="name" type="string" value="" />
    <field id="originalTitle" type="string" value="" />
    <field id="sortName" type="string" value="" />
    <field id="etag" type="string" value="" />
    <field id="mediaType" type="string" value="" />              <!-- "Video", "Audio", "Photo", "Book" -->
    <field id="extraType" type="string" value="" />              <!-- "Trailer", "BehindTheScenes", etc. -->
    <field id="locationType" type="string" value="" />           <!-- "FileSystem", "Remote", "Virtual" -->
    <field id="sourceType" type="string" value="" />
    <field id="playlistItemId" type="string" value="" />
    <field id="displayOrder" type="string" value="" />
    <field id="isFolder" type="boolean" value="false" />
    <field id="folderType" type="string" value="" />             <!-- "Genre", "MusicGenre", "Studio", "" for plain folders or non-folder items. Check isFolder first. -->
    <field id="isPlaceHolder" type="boolean" value="false" />
    <field id="path" type="string" value="" />

    <!-- Pre-computed secondary display text (e.g., "2024 • PG-13", "S2E5 - Title") -->
    <field id="subtitle" type="string" value="" />

    <!-- ==================== -->
    <!-- PARENT/CONTAINER     -->
    <!-- ==================== -->
    <field id="serverId" type="string" value="" />
    <field id="parentId" type="string" value="" />
    <field id="channelId" type="string" value="" />
    <field id="collectionType" type="string" value="" />

    <!-- ==================== -->
    <!-- DATES & TIMING       -->
    <!-- ==================== -->
    <field id="premiereDate" type="string" value="" />
    <field id="endDate" type="string" value="" />
    <field id="dateCreated" type="string" value="" />
    <field id="dateLastMediaAdded" type="string" value="" />
    <field id="airTime" type="string" value="" />
    <field id="airDays" type="stringarray" />

    <!-- ==================== -->
    <!-- MEDIA METADATA       -->
    <!-- ==================== -->
    <field id="overview" type="string" value="" />
    <field id="taglines" type="stringarray" />
    <field id="runTimeTicks" type="longinteger" value="0" />
    <field id="cumulativeRunTimeTicks" type="longinteger" value="0" />
    <field id="productionYear" type="integer" value="0" />
    <field id="productionLocations" type="stringarray" />
    <field id="container" type="string" value="" />              <!-- Normalized: mp4, mkv, etc. -->
    <field id="videoType" type="string" value="" />              <!-- "VideoFile", "Iso", "Dvd", "BluRay" -->
    <field id="aspectRatio" type="string" value="" />
    <field id="isHD" type="boolean" value="false" />
    <field id="hasSubtitles" type="boolean" value="false" />
    <field id="status" type="string" value="" />                 <!-- Series: "Continuing", "Ended" -->

    <!-- ==================== -->
    <!-- RATINGS              -->
    <!-- ==================== -->
    <field id="officialRating" type="string" value="" />
    <field id="customRating" type="string" value="" />
    <field id="communityRating" type="float" value="0.0" />
    <field id="criticRating" type="float" value="0.0" />

    <!-- ==================== -->
    <!-- GENRES, STUDIOS, TAGS -->
    <!-- ==================== -->
    <field id="genres" type="stringarray" />
    <field id="genreItems" type="array" />              <!-- NameGuidPair[] - {Name, Id} -->
    <field id="studios" type="stringarray" />
    <field id="studioItems" type="array" />             <!-- NameGuidPair[] - {Name, Id} -->
    <field id="tags" type="stringarray" />

    <!-- ==================== -->
    <!-- PEOPLE               -->
    <!-- ==================== -->
    <field id="people" type="array" />                  <!-- BaseItemPerson[] - {Name, Id, Role, Type, PrimaryImageTag} -->

    <!-- ==================== -->
    <!-- EXTERNAL IDS & LINKS -->
    <!-- ==================== -->
    <field id="providerIds" type="assocarray" />        <!-- {Imdb: "tt123", Tmdb: "456", ...} -->
    <field id="externalUrls" type="array" />            <!-- ExternalUrl[] - {Name, Url} -->
    <field id="remoteTrailers" type="array" />          <!-- MediaUrl[] - {Name, Url} -->

    <!-- ==================== -->
    <!-- USER DATA (flattened) -->
    <!-- ==================== -->
    <field id="playbackPositionTicks" type="longinteger" value="0" />
    <field id="playedPercentage" type="float" value="0.0" />
    <field id="isWatched" type="boolean" value="false" />
    <field id="isFavorite" type="boolean" value="false" />
    <field id="isResumable" type="boolean" value="false" />      <!-- Derived: positionTicks > 0 AND not watched -->
    <field id="playCount" type="integer" value="0" />
    <field id="lastPlayedDate" type="string" value="" />
    <field id="unplayedItemCount" type="integer" value="0" />
    <field id="userRating" type="float" value="0.0" />           <!-- Star rating -->
    <field id="userLikes" type="boolean" value="false" />        <!-- Like/dislike -->
    <field id="playAccess" type="string" value="" />             <!-- "Full", "None" -->

    <!-- ==================== -->
    <!-- SERIES/EPISODE       -->
    <!-- ==================== -->
    <field id="seriesId" type="string" value="" />
    <field id="seriesName" type="string" value="" />
    <field id="seasonId" type="string" value="" />
    <field id="seasonName" type="string" value="" />
    <field id="episodeTitle" type="string" value="" />
    <field id="indexNumber" type="integer" value="0" />
    <field id="parentIndexNumber" type="integer" value="0" />
    <field id="indexNumberEnd" type="integer" value="0" />
    <field id="airsBeforeSeasonNumber" type="integer" value="0" />
    <field id="airsAfterSeasonNumber" type="integer" value="0" />
    <field id="airsBeforeEpisodeNumber" type="integer" value="0" />
    <field id="seriesStudio" type="string" value="" />

    <!-- ==================== -->
    <!-- MUSIC                -->
    <!-- ==================== -->
    <field id="albumArtist" type="string" value="" />
    <field id="albumName" type="string" value="" />
    <field id="albumId" type="string" value="" />
    <field id="artists" type="stringarray" />
    <field id="artistItems" type="array" />             <!-- NameGuidPair[] -->
    <field id="albumArtists" type="array" />            <!-- NameGuidPair[] -->
    <field id="normalizationGain" type="float" value="0.0" />
    <field id="hasLyrics" type="boolean" value="false" />

    <!-- ==================== -->
    <!-- CHILD/ITEM COUNTS    -->
    <!-- ==================== -->
    <field id="childCount" type="integer" value="0" />
    <field id="recursiveItemCount" type="integer" value="0" />
    <field id="specialFeatureCount" type="integer" value="0" />
    <field id="localTrailerCount" type="integer" value="0" />
    <field id="trailerCount" type="integer" value="0" />
    <field id="movieCount" type="integer" value="0" />
    <field id="seriesCount" type="integer" value="0" />
    <field id="episodeCount" type="integer" value="0" />
    <field id="songCount" type="integer" value="0" />
    <field id="albumCount" type="integer" value="0" />
    <field id="musicVideoCount" type="integer" value="0" />
    <field id="programCount" type="integer" value="0" />
    <field id="partCount" type="integer" value="0" />
    <field id="mediaSourceCount" type="integer" value="0" />

    <!-- ==================== -->
    <!-- LIVE TV              -->
    <!-- ==================== -->
    <field id="channelName" type="string" value="" />
    <field id="channelNumber" type="string" value="" />
    <field id="channelType" type="string" value="" />            <!-- "TV", "Radio" -->
    <field id="isLive" type="boolean" value="false" />
    <field id="isNews" type="boolean" value="false" />
    <field id="isSports" type="boolean" value="false" />
    <field id="isKids" type="boolean" value="false" />
    <field id="isPremiere" type="boolean" value="false" />
    <field id="isRepeat" type="boolean" value="false" />
    <field id="isMovie" type="boolean" value="false" />
    <field id="isSeries" type="boolean" value="false" />
    <field id="audio" type="string" value="" />                  <!-- "Mono", "Stereo", "Dolby", "Atmos" -->
    <field id="programId" type="string" value="" />
    <field id="seriesTimerId" type="string" value="" />
    <field id="timerId" type="string" value="" />
    <field id="completionPercentage" type="float" value="0.0" />

    <!-- ==================== -->
    <!-- PERMISSIONS          -->
    <!-- ==================== -->
    <field id="canDelete" type="boolean" value="false" />
    <field id="canDownload" type="boolean" value="false" />

    <!-- ==================== -->
    <!-- IMAGE TAGS           -->
    <!-- (for on-demand URL generation via utility) -->
    <!-- ==================== -->
    <field id="primaryImageTag" type="string" value="" />
    <field id="primaryImageAspectRatio" type="float" value="0.0" />
    <field id="backdropImageTags" type="stringarray" />
    <field id="screenshotImageTags" type="stringarray" />
    <field id="thumbImageTag" type="string" value="" />
    <field id="logoImageTag" type="string" value="" />
    <field id="imageBlurHashes" type="assocarray" />    <!-- {Primary: {tag: hash}, Backdrop: {...}, ...} -->

    <!-- Parent/Fallback Image Tags -->
    <field id="parentPrimaryImageTag" type="string" value="" />
    <field id="parentPrimaryImageItemId" type="string" value="" />
    <field id="parentThumbImageTag" type="string" value="" />
    <field id="parentThumbItemId" type="string" value="" />
    <field id="parentBackdropImageTags" type="stringarray" />
    <field id="parentBackdropItemId" type="string" value="" />
    <field id="parentLogoImageTag" type="string" value="" />
    <field id="parentLogoItemId" type="string" value="" />
    <field id="parentArtImageTag" type="string" value="" />
    <field id="parentArtItemId" type="string" value="" />
    <field id="seriesPrimaryImageTag" type="string" value="" />
    <field id="seriesThumbImageTag" type="string" value="" />
    <field id="channelPrimaryImageTag" type="string" value="" />
    <field id="albumPrimaryImageTag" type="string" value="" />

    <!-- ==================== -->
    <!-- PRE-PROCESSED MEDIA STREAMS -->
    <!-- Filtered/sorted ONCE in transformer, consumed by UI -->
    <!-- ==================== -->
    <field id="videoStreams" type="array" />             <!-- Video MediaStream AAs -->
    <field id="audioStreams" type="array" />             <!-- Audio MediaStream AAs -->
    <field id="subtitleStreams" type="array" />          <!-- Subtitle AAs (pre-sorted: forced > default > normal, preferred lang first) -->
    <field id="videoStreamCount" type="integer" value="0" />
    <field id="audioStreamCount" type="integer" value="0" />
    <field id="subtitleStreamCount" type="integer" value="0" />
    <field id="hasMultipleVideoSources" type="boolean" value="false" />

    <!-- Primary media source metadata -->
    <field id="mediaSourceId" type="string" value="" />
    <field id="mediaSourceProtocol" type="string" value="" />
    <field id="supportsDirectPlay" type="boolean" value="false" />

    <!-- Full media sources AA (for playback info, source switching) -->
    <field id="mediaSourcesData" type="assocarray" />

    <!-- ==================== -->
    <!-- CHAPTERS             -->
    <!-- From BaseItemDto.Chapters (fields=Chapters) -->
    <!-- ==================== -->
    <field id="chapters" type="array" />                <!-- ChapterInfo[] - {StartPositionTicks, Name, ImageTag} -->
    <field id="chapterCount" type="integer" value="0" />

    <!-- ==================== -->
    <!-- TRICKPLAY            -->
    <!-- From BaseItemDto.Trickplay -->
    <!-- Nested: {mediaSourceId: {width: TrickplayInfoDto}} -->
    <!-- ==================== -->
    <field id="trickplayData" type="assocarray" />

    <!-- ==================== -->
    <!-- MEDIA SEGMENTS       -->
    <!-- From GET /MediaSegments/{itemId} (separate API call) -->
    <!-- ==================== -->
    <field id="mediaSegments" type="array" />           <!-- MediaSegmentDto[] - {Id, Type, StartTicks, EndTicks} -->
    <field id="hasIntro" type="boolean" value="false" />         <!-- Derived: segment with Type="Intro" -->
    <field id="hasOutro" type="boolean" value="false" />         <!-- Derived: segment with Type="Outro" -->

    <!-- ==================== -->
    <!-- MEDIA ATTACHMENTS    -->
    <!-- Embedded fonts, cover art, etc. -->
    <!-- ==================== -->
    <field id="mediaAttachments" type="array" />        <!-- MediaAttachment[] - {Index, Codec, FileName, MimeType, DeliveryUrl} -->

    <!-- ==================== -->
    <!-- THEME SONGS/VIDEOS   -->
    <!-- From GET /Items/{id}/ThemeSongs|ThemeVideos -->
    <!-- ==================== -->
    <field id="themeSongs" type="array" />
    <field id="themeVideos" type="array" />

    <!-- ==================== -->
    <!-- LYRICS (Music)       -->
    <!-- From separate API call -->
    <!-- ==================== -->
    <field id="lyricsData" type="assocarray" />         <!-- LyricDto - {Metadata, Lyrics[]} -->

    <!-- ==================== -->
    <!-- VERSION & DEBUG      -->
    <!-- ==================== -->
    <field id="serverVersion" type="string" value="" />
    <!-- DEBUG ONLY: Raw API data for debugging - only populated when bs_const=debug=true -->
    <field id="rawApiData" type="assocarray" />
    <field id="transformedAt" type="longinteger" value="0" />

  </interface>
</component>
