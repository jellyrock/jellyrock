<?xml version="1.0" encoding="utf-8"?>
<component name="JRScene" extends="Scene">
  <children>
    <BackdropFader id="imageFader" translation="[0, 0]" />
    <!-- #550 sgRouter outlet: hosts post-login content views (Home/details/library/
         search/settings). Declared BELOW `content` so SceneManager-pushed screens
         (pre-login flow, playback) render ABOVE the routed views during the migration.
         `content` is retired in Phases 5/6 once those paths move off SceneManager. -->
    <sgrouter_Outlet id="routerOutlet" />
    <Group id="content" />
    <JROverhang id="overhang" />
    <!-- Container for OptionsSlider when open, rendered above overhang for correct z-order -->
    <Group id="optionsPanelOverlay" />
    <LabelPrimaryLarge id="loadingText" height="225" width="1266" horizAlign="center" vertAlign="bottom" wrap="true" translation="[327, 210]" visible="false" />
    <Spinner id="spinner" translation="[897, 477]" />
    <Toast id="toast" visible="false" />
    <!-- Used to calculate m.global.user.fontScaleFactor -->
    <Label id="defaultFont" text="" visible="false" />
    <Label id="fallbackFont" text="" visible="false" />
  </children>
  <interface>
    <field id="isRemoteDisabled" type="boolean" value="true" />
    <field id="shouldShowBackdrop" type="boolean" />
    <field id="loadingText" type="string" value="" alwaysNotify="true" onchange="onLoadingTextChanged" />
    <field id="isLoading" type="boolean" alwaysNotify="true" value="true" onchange="onIsLoadingChanged" />
    <field id="exit" type="boolean" alwaysNotify="true" />
    <!-- #550 sgRouter (Phase 4): session-reset bridge. Routed views (Home) set this to a
         HomeAction id; main.bs observes it on the main thread (m.global field + port does
         NOT deliver — the relay defect — but a scene field + port does, like `exit`) and
         re-enters LoginFlow via `goto appStart`. Replaces the deleted activeRoutedView relay. -->
    <field id="userMenuAction" type="string" value="" alwaysNotify="true" />
    <!-- #550 sgRouter (Phase 4): content-freshness token. Bumped when a view mutates
         server content that browse grids display (currently: an item delete in
         ItemDetails). keepAlive grids (BaseGridView) record the value they last loaded
         at and re-fetch on resume when it differs — so a deleted item can't linger in a
         suspended-but-cached library. Plain field: grids read it synchronously on resume,
         no observer needed. (reloadHomeRequested is the sibling Home-reload signal still on
         SceneManager; consolidating both here is a Phase-6 followup.) -->
    <field id="contentVersion" type="integer" value="0" />
    <field id="backgroundImageUri" type="string" value="" alwaysNotify="true" onchange="onBackgroundImageUriChanged" />
    <function name="setBackgroundImage" />
    <function name="refreshBackdropSetting" />
    <function name="showToast" />
    <!-- #550 sgRouter host hooks (called from main.bs on the main thread) -->
    <function name="startRouter" />
    <function name="reloadRoutedHome" />
    <function name="resetRouter" />
    <function name="restoreRoutedOverhang" />
    <function name="routerGoBack" />
    <!-- DEBUG: Set from BrightScript console to test toasts. Format: "type|message"
         Example: m.top.getScene().testToast = "error|Something went wrong" -->
    <field id="testToast" type="string" value="" alwaysNotify="true" />
  </interface>
</component>