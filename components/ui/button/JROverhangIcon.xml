<?xml version="1.0" encoding="utf-8"?>
<component name="JROverhangIcon" extends="Group">
  <children>
    <Poster id="buttonBackground" uri="pkg:/images/9patch/filled-rounded.9.png" visible="false" />
    <Poster id="buttonBorder" uri="pkg:/images/9patch/border-6px.9.png" visible="false" />
    <Poster id="buttonIcon" width="42" height="42" loadWidth="42" loadHeight="42" loadDisplayMode="limitSize" />
  </children>
  <interface>
    <!-- Input -->
    <field id="icon" type="string" onChange="onIconChanged" />
    <field id="actionId" type="string" />
    <!-- A disabled icon keeps focus and still fires selectedAction (the press explains
         why it is disabled); it only draws its glyph in colorTextDisabled. -->
    <field id="isDisabled" type="boolean" value="false" onChange="onIsDisabledChanged" />
    <!-- A toggle's on-state (the SyncPlay icon in a group): the glyph is drawn in colorSecondary,
         focused or not. isDisabled wins over it. -->
    <field id="isActive" type="boolean" value="false" onChange="onIsActiveChanged" />

    <!-- Output -->
    <field id="selectedAction" type="string" alwaysNotify="true" />
    <field id="requestFocusExit" type="string" alwaysNotify="true" />
    <field id="requestFocusReturn" type="boolean" value="false" alwaysNotify="true" />
  </interface>
</component>
