<?xml version="1.0" encoding="utf-8"?>
<component name="JRDropdown" extends="Group">
  <children>
    <!-- Trigger button area -->
    <Poster id="buttonBackground" uri="pkg:/images/9patch/filled-rounded.9.png" visible="false" />
    <Poster id="buttonBorder" uri="pkg:/images/9patch/border-6px.9.png" visible="false" />
    <!-- The avatar, the name and the chevron, placed by sizeTriggerButton -->
    <Group id="triggerContent">
      <Poster id="triggerIcon" visible="false" width="42" height="42" loadWidth="42" loadHeight="42" loadDisplayMode="limitSize" />
      <!-- The trigger hugs its text: width 0 sizes the label to the text, and
           sizeTriggerButton rounds it up onto the 3 px grid and caps it at
           TRIGGER_LABEL_MAX_WIDTH, where it ellipsizes by
           character (no ellipsizeOnBoundary: whole-word ellipsizing drops a too-long
           single word entirely and renders a bare "...", #798). The height matches the
           avatar, so both center on the box's middle. -->
      <LabelSecondaryMedium id="triggerLabel" width="0" height="42" horizAlign="left" vertAlign="center" />
      <!-- Dropdown affordance, as TrackDropdown draws it; tinted with the label across focus. -->
      <Poster id="triggerChevron" uri="pkg:/images/icons/expand_$$RES$$.png" width="24" height="24" loadWidth="24" loadHeight="24" loadDisplayMode="limitSize" />
    </Group>

    <!-- Dropdown menu (positioned below trigger, initially hidden) -->
    <Group id="menuContainer" visible="false">
      <Poster id="menuBackground" uri="pkg:/images/9patch/filled-rounded.9.png" />
      <LayoutGroup id="menuItems" layoutDirection="vert" itemSpacings="[0]" />
    </Group>
  </children>
  <interface>
    <!-- Input -->
    <field id="triggerText" type="string" />
    <field id="triggerIconUri" type="string" />
    <field id="triggerIconBlendColor" type="color" value="0xFFFFFFFF" />
    <field id="items" type="array" />
    <field id="selectedItemId" type="string" />
    <field id="menuWidth" type="integer" value="300" />
    <field id="padding" type="integer" value="15" />
    <!-- The trigger box is at least this tall, its content centered (the overhang row's height). -->
    <field id="minHeight" type="integer" value="0" />

    <!-- Output -->
    <field id="triggerWidth" type="integer" value="0" />
    <field id="selectedAction" type="string" alwaysNotify="true" />
    <field id="requestFocusReturn" type="boolean" value="false" alwaysNotify="true" />
    <field id="requestFocusExit" type="string" alwaysNotify="true" />

    <!-- Functions -->
    <function name="onDestroy" />
  </interface>
</component>
