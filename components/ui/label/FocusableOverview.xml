<?xml version="1.0" encoding="utf-8"?>
<!-- FocusableOverview: Reusable focusable text box with 9patch focus border.
     Shows overview/description text with ellipsis. Supports an optional tagline
     displayed above the description. When focused, displays a themed border.
     Pressing OK opens an OverviewDialog to read the full text. -->
<component name="FocusableOverview" extends="Group" focusable="true">
  <children>
    <RectangleBackgroundSecondary id="background" />
    <Poster id="focusBorder" uri="pkg:/images/9patch/border-6px.9.png" visible="false" />
    <LayoutGroup id="contentGroup" layoutDirection="vert" itemSpacings="[15]">
      <!-- Tagline label is created dynamically only when tagline text is provided -->
      <LabelSecondaryMedium id="label" wrap="true" lineSpacing="0" ellipsisText="..." />
    </LayoutGroup>
  </children>
  <interface>
    <field id="text" type="string" onChange="onTextChanged" />
    <field id="tagline" type="string" onChange="onTaglineChanged" />
    <field id="dialogTitle" type="string" value="" />
    <field id="width" type="integer" onChange="onSizeChanged" />
    <field id="height" type="integer" onChange="onSizeChanged" />
    <field id="maxLines" type="integer" onChange="onMaxLinesChanged" value="0" />
    <field id="taglineMaxLines" type="integer" onChange="onTaglineMaxLinesChanged" value="0" />
    <field id="showBackground" type="bool" onChange="onShowBackgroundChanged" value="false" />
    <field id="horizAlign" type="string" onChange="onHorizAlignChanged" />
    <field id="vertAlign" type="string" onChange="onVertAlignChanged" />
  </interface>
</component>