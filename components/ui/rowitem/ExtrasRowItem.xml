<?xml version="1.0" encoding="utf-8"?>
<!--
  ExtrasRowItem: JRRowItem variant for extras rows (season episode lists, person TV shows, etc.).
  Sets applyEpisodeImageSetting=false so episode screenshots are always shown,
  bypassing the uiGeneralEpisodeImages home-row setting.
  Roku calls init() for each component in the chain (parent first), so this init()
  runs after JRRowItem's and safely overrides the field's default value.
-->
<component name="ExtrasRowItem" extends="JRRowItem">
</component>
