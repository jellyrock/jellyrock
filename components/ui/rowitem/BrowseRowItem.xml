<?xml version="1.0" encoding="utf-8"?>
<!--
  BrowseRowItem: JRRowItem variant for browse contexts (extras rows, search results, etc.).
  Sets applyEpisodeImageSetting=false so episode screenshots are always shown,
  bypassing the uiGeneralEpisodeImages home-row setting (which only applies to
  Continue Watching / Next Up where show art may be preferred over episode art).
  Roku calls init() for each component in the chain (parent first), so this init()
  runs after JRRowItem's and safely overrides the field's default value.
-->
<component name="BrowseRowItem" extends="JRRowItem">
</component>
