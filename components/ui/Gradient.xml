<?xml version="1.0" encoding="utf-8"?>
<component name="Gradient" extends="Group">
  <interface>
    <field id="width" type="integer" value="1920" />
    <field id="height" type="integer" value="300" />
    <field id="startColor" type="integer" value="0x000000FF" />
    <field id="endColor" type="integer" value="0x00000000" />
    <field id="direction" type="string" value="vertical" />
    <field id="rotateDegrees" type="integer" value="0" />
  </interface>
</component>

<!-- PARAMETERS:
- width: Width in pixels (default 1920)
- height: Height in pixels (default 300)
- startColor: Fade start color + alpha in hex (default 0x000000FF)
- endColor: Fade end color + alpha in hex (default 0x00000000). One end must
  have alpha 0 — the gradient is a single tinted alpha-ramp bitmap, so it fades
  one color out to nothing (the transparent end may be either one; its RGB is
  ignored). Two visible ends can't be expressed and trigger a debug warning.
- direction: "vertical" or "horizontal" (default "vertical")
- rotateDegrees: 0, 90, 180, or 270 degrees (default 0)

<Gradient translation="[0, 100]" />
<Gradient rotateDegrees="180" translation="[0, 640]" /> (Flipped gradient)
-->