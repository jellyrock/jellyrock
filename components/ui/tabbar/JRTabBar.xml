<?xml version="1.0" encoding="utf-8"?>
<component name="JRTabBar" extends="Group">
  <children>
    <LayoutGroup id="tabContainer" layoutDirection="horz" itemSpacings="[48]" />
  </children>
  <interface>
    <!-- Input: array of { title: string, id: string } -->
    <field id="tabs" type="array" onChange="onTabsChanged" />
    <!-- Output: id of the currently selected (active) tab -->
    <field id="selectedTabId" type="string" alwaysNotify="true" />
    <!-- Output: signals the parent screen to take focus back (e.g., on DOWN press) -->
    <field id="requestFocusReturn" type="boolean" value="false" alwaysNotify="true" />
    <!-- Output: signals LEFT/RIGHT at tab boundary to transfer focus to user dropdown.
         Value is the direction pressed ("left" or "right") for correct fallback wrapping. -->
    <field id="requestFocusToUserMenu" type="string" alwaysNotify="true" />
    <!-- Input/Output: externally settable focused tab index (e.g., when returning from user dropdown) -->
    <field id="focusedTabIndex" type="integer" value="0" onChange="onFocusedTabIndexChanged" alwaysNotify="true" />
    <!-- Output: signals when the first tab has finished rendering/sizing -->
    <field id="isReady" type="boolean" value="false" alwaysNotify="true" />
    <function name="destroy" />
  </interface>
</component>
