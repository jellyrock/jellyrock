import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/overhangRow.bs"
import "pkg:/source/utils/tabStrip.bs"

' The clip of a bar that has left its slot (clearWindow): the design resolution, so it cuts nothing
const UNCLIPPED_WIDTH = 1920
const UNCLIPPED_HEIGHT = 1080

sub init()
  m.tabContainer = m.top.findNode("tabContainer")
  m.tabContainer.itemSpacings = [overhangRow.TAB_SPACING]
  m.tabClip = m.top.findNode("tabClip")
  m.scrollAnimation = m.top.findNode("scrollAnimation")
  m.scrollAnimation.duration = tabStrip.SCROLL_SECONDS
  m.scrollInterpolator = m.top.findNode("scrollInterpolator")
  m.focusedTabIndex = 0
  ' The strip's scroll offset (scrolling mode), and whether the slot's clip is set
  m.windowOffset = 0
  m.isWindowed = false

  ' When the tab bar gains focus, highlight the focused tab
  m.top.observeField("focusedChild", "onFocusChanged")

  ' Interface observers are registered HERE rather than declared as XML onChange
  ' attributes: this component releases node references in onDestroy and these
  ' handlers dereference them, so the registrations have to be detachable. An XML
  ' onChange does not appear to be removable by unobserveField; see the wiring
  ' rule in components/CLAUDE.md.
  m.top.observeField("tabs", "onTabsChanged")
  m.top.observeField("focusedTabIndex", "onFocusedTabIndexChanged")
  m.top.observeField("mode", "onSlotChanged")
  m.top.observeField("slotWidth", "onSlotChanged")
end sub

' Rebuilds tab children when the tabs array changes.
' Skips recreation when the tab configuration is unchanged (for example, returning
' to the same screen) so already-sized JRTab nodes appear instantly.
sub onTabsChanged()
  tabs = m.top.tabs
  if not isValidAndNotEmpty(tabs)
    m.tabContainer.removeChildren(m.tabContainer.getChildren(-1, 0))
    m.focusedTabIndex = 0
    m.top.isReady = false
    clearWindow()
    return
  end if

  ' Preserve existing tabs if the configuration matches. This avoids the visible
  ' TextButton render/sizing dance when returning to the same screen
  if tabsMatchExisting(tabs)
    syncSelectedTab()
    applyWindow(false)
    return
  end if

  ' Configuration changed: full rebuild. The clip comes off until the new tabs are sized:
  ' a tab sizes itself only once it is fully rendered, which a clipped one is not.
  m.top.isReady = false
  clearWindow()
  m.tabContainer.removeChildren(m.tabContainer.getChildren(-1, 0))

  matched = false
  selectedIndex = 0
  for i = 0 to tabs.count() - 1
    tabData = tabs[i]
    tabNode = CreateObject("roSGNode", "JRTab")
    tabNode.tabTitle = tabData.title
    tabNode.tabId = tabData.id
    if isValidAndNotEmpty(tabData.icon) then tabNode.tabIcon = tabData.icon
    if isValidAndNotEmpty(tabData.selectedIcon) then tabNode.tabSelectedIcon = tabData.selectedIcon

    ' Mark the first tab as selected by default if no selection exists
    if m.top.selectedTabId = "" and tabData.id = tabs[0].id
      tabNode.isButtonSelected = true
      m.top.selectedTabId = tabData.id
      selectedIndex = i
      matched = true
    else if tabData.id = m.top.selectedTabId
      tabNode.isButtonSelected = true
      selectedIndex = i
      matched = true
    end if

    tabNode.observeField("isReady", "onTabReady")
    m.tabContainer.appendChild(tabNode)
  end for

  ' Fallback: selectedTabId was stale (not found in new tabs); select and announce the first tab
  if not matched
    firstTab = m.tabContainer.getChild(0)
    if isValid(firstTab)
      firstTab.isButtonSelected = true
      m.top.selectedTabId = firstTab.tabId
    end if
    selectedIndex = 0
  end if

  ' Align the focus cursor to the selected tab
  m.focusedTabIndex = selectedIndex

  updateFocusedTabVisuals()

  ' A tab sizes as its title is set, before it is observed above, so ask once here
  onTabReady()
end sub

' A tab has finished rendering/sizing. Once every tab has, the bar is ready and the strip
' can be placed in its slot; a tab that sizes again later places it again.
sub onTabReady()
  for i = 0 to m.tabContainer.getChildCount() - 1
    if not m.tabContainer.getChild(i).isReady then return
  end for
  if not m.top.isReady then m.top.isReady = true
  applyWindow(false)
end sub

' ============================================
' SCROLLING MODE
' ============================================

sub onSlotChanged()
  applyWindow(false)
end sub

' The tab the strip keeps in view: the focused one while the bar has focus, else the selected
function activeTabIndex() as integer
  if m.top.isInFocusChain() then return m.focusedTabIndex
  for i = 0 to m.tabContainer.getChildCount() - 1
    if m.tabContainer.getChild(i).tabId = m.top.selectedTabId then return i
  end for
  return 0
end function

' Scrolling mode: clips the strip to its slot, moves it to where tabStrip.window puts the
' active tab, and dims a tab the slot's edge cuts. A focus move slides (`animate`); anything
' else jumps. Fixed mode, or a strip not yet sized, has no clip and never moves.
sub applyWindow(animate as boolean)
  slotWidth = m.top.slotWidth
  if m.top.mode <> "scrolling" or slotWidth <= 0 or not m.top.isReady
    clearWindow()
    return
  end if

  tabCount = m.tabContainer.getChildCount()
  widths = []
  for i = 0 to tabCount - 1
    widths.push(int(m.tabContainer.getChild(i).boundingRect().width))
  end for
  win = tabStrip.window(widths, overhangRow.TAB_SPACING, slotWidth, activeTabIndex(), tabStrip.PEEK_WIDTH)

  m.tabClip.clippingRect = [0, 0, slotWidth, overhangRow.ROW_HEIGHT]
  m.isWindowed = true

  for i = 0 to tabCount - 1
    opacity = 1.0
    if i = win.cutLeft or i = win.cutRight then opacity = tabStrip.CUT_OPACITY
    tabNode = m.tabContainer.getChild(i)
    if tabNode.opacity <> opacity then tabNode.opacity = opacity
  end for

  if win.offset = m.windowOffset
    ' A jump to where a slide is already heading ends the slide there
    if not animate and m.scrollAnimation.state = "running" then moveStrip(win.offset)
    return
  end if
  m.windowOffset = win.offset
  if animate
    ' From wherever the strip is now, so a press during a slide carries on from there
    m.scrollAnimation.control = "stop"
    m.scrollInterpolator.keyValue = [m.tabContainer.translation, [-win.offset, 0]]
    m.scrollAnimation.control = "start"
  else
    moveStrip(win.offset)
  end if
end sub

sub moveStrip(offset as integer)
  m.scrollAnimation.control = "stop"
  m.tabContainer.translation = [-offset, 0]
end sub

' Takes the strip out of its slot: at its start, every tab at full opacity, and a clip as large
' as the screen. A clippingRect cannot be taken off again by setting it empty: on a device the
' tabs then stop drawing. A bar that was never in a slot is left untouched.
sub clearWindow()
  if not m.isWindowed then return
  m.isWindowed = false
  m.windowOffset = 0
  moveStrip(0)
  m.tabClip.clippingRect = [0, -overhangRow.TEXT_TOP, UNCLIPPED_WIDTH, UNCLIPPED_HEIGHT]
  for i = 0 to m.tabContainer.getChildCount() - 1
    m.tabContainer.getChild(i).opacity = 1.0
  end for
end sub

' Returns true if the existing tab children match the new tabs configuration
function tabsMatchExisting(tabs as object) as boolean
  if m.tabContainer.getChildCount() <> tabs.count() then return false

  for i = 0 to tabs.count() - 1
    existing = m.tabContainer.getChild(i)
    icon = ""
    if isValidAndNotEmpty(tabs[i].icon) then icon = tabs[i].icon
    selectedIcon = ""
    if isValidAndNotEmpty(tabs[i].selectedIcon) then selectedIcon = tabs[i].selectedIcon
    if existing.tabId <> tabs[i].id or existing.tabTitle <> tabs[i].title or existing.tabIcon <> icon or existing.tabSelectedIcon <> selectedIcon
      return false
    end if
  end for

  return true
end function

' Updates isSelected on existing tabs to match the current selectedTabId
' without recreating any nodes. Also aligns the focus cursor so it tracks
' the active tab after an external re-sync (re-login, return from details).
sub syncSelectedTab()
  for i = 0 to m.tabContainer.getChildCount() - 1
    tabNode = m.tabContainer.getChild(i)
    isSelected = (tabNode.tabId = m.top.selectedTabId)
    tabNode.isButtonSelected = isSelected
    if isSelected
      m.focusedTabIndex = i
    end if
  end for
end sub

' When the tab bar gains or loses focus, update tab visuals
sub onFocusChanged()
  hasFocus = m.top.isInFocusChain()

  ' Internal m.focusedTabIndex is already kept in sync by:
  '   - onTabsChanged / syncSelectedTab (resets to selected tab on rebuild/return)
  '   - onFocusedTabIndexChanged (external sets, such as a dropdown return)
  '   - onKeyEvent left/right (user navigation within the tab bar)
  ' No sync needed here: reading the interface field would clobber the
  ' remembered position with a stale value.

  updateFocusedTabVisuals()

  ' Clear focus indicator on all tabs when losing focus
  if not hasFocus
    for i = 0 to m.tabContainer.getChildCount() - 1
      m.tabContainer.getChild(i).isFocused = false
    end for
  end if

  ' The active tab is the focused one with focus, the selected one without
  applyWindow(true)
end sub

' Updates the isFocused visual state on tab children
sub updateFocusedTabVisuals()
  if not m.top.isInFocusChain() then return

  for i = 0 to m.tabContainer.getChildCount() - 1
    tabNode = m.tabContainer.getChild(i)
    tabNode.isFocused = (i = m.focusedTabIndex)
  end for
end sub

' Selects a tab by index: updates isSelected on all children and fires selectedTabId
sub selectTab(index as integer)
  for i = 0 to m.tabContainer.getChildCount() - 1
    tabNode = m.tabContainer.getChild(i)
    tabNode.isButtonSelected = (i = index)
  end for

  selectedTab = m.tabContainer.getChild(index)
  if isValid(selectedTab)
    m.top.selectedTabId = selectedTab.tabId
  end if
  applyWindow(true)
end sub

function onKeyEvent(key as string, press as boolean) as boolean
  if not press then return false

  tabCount = m.tabContainer.getChildCount()
  if tabCount = 0 then return false

  if key = "right"
    if m.focusedTabIndex = tabCount - 1
      ' At last tab: signal focus transfer to user dropdown (wraps right)
      m.top.requestFocusToUserMenu = "right"
    else
      ' Move focus right within tabs
      m.focusedTabIndex = m.focusedTabIndex + 1
      updateFocusedTabVisuals()
      applyWindow(true)
    end if
    return true
  else if key = "left"
    if m.focusedTabIndex = 0
      ' At first tab: signal focus transfer to user dropdown (wraps left)
      m.top.requestFocusToUserMenu = "left"
    else
      ' Move focus left within tabs
      m.focusedTabIndex = m.focusedTabIndex - 1
      updateFocusedTabVisuals()
      applyWindow(true)
    end if
    return true
  else if key = "OK"
    selectTab(m.focusedTabIndex)
    return true
  else if key = "down"
    ' Signal the parent screen to take focus back
    m.top.requestFocusReturn = true
    return true
  end if

  ' UP: don't consume; let it bubble (nothing above the tab bar)
  return false
end function

' Called when focusedTabIndex is set externally (for example, returning from user dropdown).
' Syncs internal state and updates visuals.
sub onFocusedTabIndexChanged()
  newIndex = m.top.focusedTabIndex
  tabCount = m.tabContainer.getChildCount()
  if tabCount = 0 then return

  ' Clamp to valid range
  if newIndex < 0
    newIndex = 0
  else if newIndex >= tabCount
    newIndex = tabCount - 1
  end if

  m.focusedTabIndex = newIndex
  updateFocusedTabVisuals()
  applyWindow(true)
end sub

sub onDestroy()
  ' Detach the interface observers registered in init(). Must precede every
  ' reference release below: these handlers dereference them.
  m.top.unobserveField("tabs")
  m.top.unobserveField("focusedTabIndex")
  m.top.unobserveField("focusedChild")
  m.top.unobserveField("mode")
  m.top.unobserveField("slotWidth")
  for i = 0 to m.tabContainer.getChildCount() - 1
    m.tabContainer.getChild(i).unobserveField("isReady")
  end for

  m.scrollAnimation.control = "stop"
  m.tabContainer.removeChildren(m.tabContainer.getChildren(-1, 0))
  m.tabContainer = invalid
  m.tabClip = invalid
  m.scrollAnimation = invalid
  m.scrollInterpolator = invalid
end sub
