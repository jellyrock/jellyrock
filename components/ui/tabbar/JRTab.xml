<?xml version="1.0" encoding="utf-8"?>
<component name="JRTab" extends="TextButton">
  <interface>
    <field id="tabTitle" type="string" onChange="onTitleChanged" />
    <field id="tabId" type="string" />
    <!-- The glyphs drawn left of the title, tinted with it: tabIcon (outlined) while the
         tab is not selected, tabSelectedIcon (filled) while it is. Fill follows selection,
         never focus. -->
    <field id="tabIcon" type="string" onChange="onTabIconChanged" />
    <field id="tabSelectedIcon" type="string" onChange="onTabIconChanged" />
  </interface>
</component>
