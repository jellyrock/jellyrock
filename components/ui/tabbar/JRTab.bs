sub init()
  m.label = m.top.findNode("label")
  m.indicator = m.top.findNode("indicator")
  m.focusBorder = m.top.findNode("focusBorder")
  m.background = m.top.findNode("background")

  constants = m.global.constants
  m.colorPrimary = constants.colorPrimary
  m.colorSecondary = constants.colorSecondary
  m.colorTextPrimary = constants.colorTextPrimary
  m.colorTextSecondary = constants.colorTextSecondary
  m.colorBackgroundSecondary = constants.colorBackgroundSecondary

  m.indicator.color = m.colorSecondary
  m.focusBorder.blendColor = m.colorPrimary
  m.background.blendColor = m.colorBackgroundSecondary

  ' Padding around the label text inside the focus border
  m.padding = 16

  ' Enable render tracking to size the border after the label renders
  m.top.enableRenderTracking = true
  m.top.observeField("renderTracking", "onRenderComplete")
end sub

sub onTitleChanged()
  m.label.text = m.top.tabTitle

  ' If already rendered, resize immediately
  if m.top.renderTracking = "full"
    updateLayout()
  end if
end sub

sub onRenderComplete()
  if m.top.renderTracking <> "full" then return
  updateLayout()
end sub

' Sizes the focus border and indicator to match the label dimensions
sub updateLayout()
  if m.label.text.Len() = 0 then return

  labelRect = m.label.localBoundingRect()
  if labelRect.width = 0 then return

  ' Size focus border and background to wrap the label with padding
  borderWidth = labelRect.width + (m.padding * 2)
  fontSize = m.label.font.size
  borderHeight = (fontSize * 0.7) + (m.padding * 2)

  m.focusBorder.width = borderWidth
  m.focusBorder.height = borderHeight
  m.background.width = borderWidth
  m.background.height = borderHeight

  ' Center the label inside the border
  m.label.translation = [m.padding, (borderHeight - labelRect.height) / 2]

  ' Position indicator below the border
  m.indicator.width = borderWidth
  m.indicator.translation = [0, borderHeight + 4]

  ' Show the tab now that layout is complete (starts visible="false" in XML)
  m.top.visible = true
end sub

' Update visuals based on focused + selected state.
' Focused = this tab has remote focus (show border). Selected = this tab's content is active (show underline).
sub onStateChanged()
  isFocused = m.top.isFocused
  isSelected = m.top.isSelected

  ' Focus border: visible only when focused
  m.focusBorder.visible = isFocused
  m.background.visible = isFocused

  ' Label color: primary when focused or selected, secondary otherwise
  if isFocused or isSelected
    m.label.color = m.colorTextPrimary
  else
    m.label.color = m.colorTextSecondary
  end if

  ' Underline: visible when this tab is the active/selected one
  m.indicator.visible = isSelected
end sub
