<?xml version="1.0" encoding="utf-8"?>
<component name="SearchPeekChip" extends="Group">
  <children>
    <!-- Pill background. Width is fixed at PEEK_CHIP_WIDTH (1000) in bs so it
         matches the keyboard's width — search bar + keyboard form a single
         visual column. -->
    <Rectangle id="chipBg" height="60" />

    <!-- Magnifying-glass icon — always visible on the left of the pill. -->
    <Poster id="searchIcon"
      translation="[24, 18]"
      width="24"
      height="24"
      uri="pkg:/images/icons/search.png" />

    <!-- Query text label. Pinned width so the pill doesn't grow with text;
         long queries marquee-scroll within the fixed pill bounds. -->
    <Label id="queryLabel" height="60" translation="[64, 0]"
      horizAlign="left" vertAlign="center" />
  </children>
  <interface>
    <!-- Current query text to display. Empty string -> empty pill (no
         placeholder; the search icon alone signals purpose). -->
    <field id="queryText" type="string" onChange="renderLabel" />

    <!-- Mirrors the parent's expanded state. Currently a no-op cosmetically;
         kept as a hook in case we add focus-ring / tint state later. -->
    <field id="isExpanded" type="boolean" onChange="onExpandedChanged" />
  </interface>
</component>
