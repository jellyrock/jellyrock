<?xml version="1.0" encoding="utf-8"?>
<component name="SearchOverlay" extends="Group">
  <children>
    <!-- Wrapper group — this is the node that slides. Animating a CHILD's
         translation (rather than m.top's) is the pattern used by
         ExtrasSlider and OptionsSlider.
         clippingRect confines rendering to the overlay's rectangle in the
         group's own coord space — a tight seal so nothing leaks into the
         viewport when the group is parked off-screen. -->
    <Group id="slideGroup" clippingRect="[0, 0, 1920, 400]">
      <!-- Solid backdrop — dimensions + color set in bs from searchLayout constants. -->
      <Rectangle id="overlayBg" />

      <!-- Two-column body:
           SUGGESTIONS on the LEFT (left edge at x=96 = 5% left safe edge,
           matching result row items), KEYBOARD on the RIGHT (right edge
           at x=1824 = 5% right safe edge). 44px gap between columns.
           The peek chip (outside this overlay, at SearchScreen level) is
           pinned directly above the keyboard at the same width — search
           bar + keyboard form a single visual column on the right.
           Default focus lands on Q (top-left of the keyboard); pressing
           LEFT from any left-edge key (Q, A, Z, 3) escapes into the
           suggestion list in a single press. -->
      <SearchSuggestionList id="suggestions" translation="[96, 0]" />
      <SearchQwertyKeyboard id="kbd" translation="[824, 0]" />
    </Group>

    <!-- Slide-in/out animation. keyValue overridden in bs from searchLayout
         so a single source of truth drives both initial position and the
         animation range. -->
    <Animation id="slideAnim" duration="0.3" repeat="false" easeFunction="outCubic">
      <Vector2DFieldInterpolator id="slideInterp" key="[0.0, 1.0]"
        keyValue="[[0, -400],[0, 130]]"
        fieldToInterp="slideGroup.translation" />
    </Animation>
  </children>
  <interface>
    <!-- Writing true slides the overlay into view; false slides it out. -->
    <field id="isExpanded" type="boolean" onChange="onExpansionChanged" />

    <!-- Suggestion list contents (proxied to child). alwaysNotify ensures
         same-length array writes (e.g. swapping one hint set for another of
         the same length) still trigger re-render. -->
    <field id="suggestionItems" type="array" alias="suggestions.items" alwaysNotify="true" />
    <field id="suggestionMode" type="string" alias="suggestions.mode" alwaysNotify="true" />
  </interface>
</component>
