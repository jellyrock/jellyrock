import "pkg:/source/constants/searchLayout.bs"
import "pkg:/source/translationKeys.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/translate.bs"

' SearchQueryBox: the typed query, in the overlay's band above the keyboard at the
' keyboard's width (QUERY_BOX_WIDTH), so the box and the keys form one column. Long
' queries marquee-scroll within the fixed bounds; the last search's count sits dim at the
' right end. Collapsed, the overlay takes it away and the overhang's status after the title
' carries the submitted query and count instead.
'
' Not independently focusable: expansion is initiated from the results list
' (UP on row 0), via OK in the empty state, or from the overhang's search icon.

' Layout geometry: kept local (not in searchLayout.bs) because every value
' here is internal to the box's own coordinate system.
' LABEL_X is the icon's x (24) plus its width (36) plus a 16px gap; the icon's translation
' and size are set in SearchQueryBox.xml (36px, centered in the 44px box).
const LABEL_X = 76
const RIGHT_PADDING = 24 ' breathing room on the right edge
const COUNT_WIDTH = 300 ' the count's slot at the right end ("132 results" in any language)

sub init()
  constants = m.global.constants
  m.bg = m.top.findNode("boxBg")
  m.queryLabel = m.top.findNode("queryLabel")
  m.searchIcon = m.top.findNode("searchIcon")
  m.resultCount = m.top.findNode("resultCount")
  m.resultCount.width = COUNT_WIDTH
  m.resultCount.translation = [searchLayout.QUERY_BOX_WIDTH - RIGHT_PADDING - COUNT_WIDTH, 0]

  ' Background: secondary panel tint so the box stands out against the
  ' overlay's primary background, but with enough alpha to feel integrated.
  m.bg.color = constants.colorBackgroundSecondary + constants.alpha80

  ' Fixed width: matches the keyboard's width below.
  m.bg.width = searchLayout.QUERY_BOX_WIDTH

  ' Text width = box width minus the icon area on the left, the count's slot and the right
  ' padding. Past it the ScrollingLabel scrolls on its own.
  m.queryLabel.maxWidth = searchLayout.QUERY_BOX_WIDTH - LABEL_X - COUNT_WIDTH - RIGHT_PADDING

  ' No placeholder text when empty: the magnifying-glass icon on the left is
  ' enough to communicate "this is the search input." A "Search" word in a
  ' wide box above an empty keyboard reads as redundant chrome.
  m.queryLabel.color = m.global.constants.colorTextPrimary

  renderLabel()
end sub

' Update label text. Empty when no query (icon alone signals purpose). A long query
' scrolls (the ScrollingLabel does it), so the overflow stays readable.
sub renderLabel()
  if not isValid(m.queryLabel) then return

  queryText = m.top.queryText
  if not isValid(queryText) then queryText = ""
  m.queryLabel.text = queryText
end sub
