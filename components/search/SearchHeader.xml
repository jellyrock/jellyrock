<?xml version="1.0" encoding="utf-8"?>
<component name="SearchHeader" extends="Group">
  <children>
    <!-- Underline bar beneath the query text — subtle visual grounding so the
         header reads as a "text field" even though it's actually a plain label.
         Color set in init() from m.global.constants. Width matches the label so
         the whole element sits centered in its parent position. -->
    <Rectangle id="underline" translation="[0, 68]" width="720" height="2" />

    <!-- Query text. Center-aligned within a 720px box so the text sits over
         the peek chip's horizontal footprint (peek chip is 720 wide at the
         same screen x). LabelPrimaryLarge picks up the project's canonical
         large-font styling; color is overridden in renderText() for
         placeholder state (dim) versus real input (primary). -->
    <LabelPrimaryLarge id="queryLabel" width="720" height="60" horizAlign="center" vertAlign="center" />
  </children>
  <interface>
    <!-- Live query text. Empty -> show placeholder in a dim color. -->
    <field id="queryText" type="string" onChange="renderText" />

    <!-- Placeholder shown when queryText is empty (typically "Search"). -->
    <field id="placeholder" type="string" onChange="renderText" />
  </interface>
</component>
