import "pkg:/source/api/ApiClient.bs"
import "pkg:/source/api/apiPool.bs"
import "pkg:/source/constants/searchLayout.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/searchHints.bs"

' SearchHintsTask — background Task that calls /Search/Hints for typeahead.
'
' Lightweight: a single HTTP GET returning at most HINTS_LIMIT rows. Runs on the
' Task thread so fetchJson's blocking wait never touches render. The render-thread
' observer on `results` should compare the `query` field of the output AA against
' the input field to drop stale responses (Roku tasks are not truly cancellable
' mid-fetch, so a stopped-and-restarted task may still deliver its old payload).

sub init()
  m.top.functionName = "runHints"
end sub

sub runHints()
  query = m.top.query
  if not isValid(query) or query = "" then return

  params = {
    searchTerm: query,
    limit: searchLayout.HINTS_LIMIT,
    includeItemTypes: "Movie,Series,Episode,Person,MusicArtist,MusicAlbum",
    includePeople: true,
    includeMedia: true,
    includeArtists: true,
    includeGenres: false,
    includeStudios: false
  }

  req = GetApi().BuildGetSearchHintsRequest(params)
  if not isValid(req)
    m.top.results = { query: query, hints: [] }
    return
  end if

  raw = fetchJson(req, "searchHints")
  hints = searchHints.transform(raw)
  m.top.results = { query: query, hints: hints }
end sub
