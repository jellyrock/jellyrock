<?xml version="1.0" encoding="utf-8"?>
<component name="SearchSuggestionList" extends="Group">
  <children>
    <!-- Section header ("Recent Searches" or "Suggestions"). Uses
         LabelSecondarySmall for its pre-configured font + dim color default;
         text is set in bs by the mode-change handler. -->
    <LabelSecondarySmall id="sectionLabel" width="480" height="36" translation="[0, 0]" />

    <!-- EscapingLabelList — the app's standard JRLabelList, plus an "escape"
         signal when the user presses DOWN on the last row (Clear History, or
         the results, are below it). Rows are sized in bs: three 60px rows with
         JRLabelList's 24px spacing (the list dialog's measure), y 56–284. -->
    <EscapingLabelList id="list" translation="[0, 56]" />

    <!-- Pinned Clear History button — visible only in recent mode with a
         non-empty history. Sits below the list so it never scrolls off when
         the history grows past numRows, and ends at y=400 with the keyboard
         beside it. Standard TextButton colors (a colorPrimary focus border).
         padding=12: TextButton sizes its background to
         max(minHeight, textHeight + 2*padding). With the default padding of
         30 the button rendered ~90px tall and clipped past the overlay's
         bottom edge. 12px keeps the button at minHeight=56. -->
    <TextButton id="clearButton"
      translation="[0, 344]"
      text=""
      minWidth="480"
      minHeight="56"
      padding="12"
      visible="false" />
  </children>
  <interface>
    <!-- "recent" | "hints" | "empty" — governs section label + Clear button
         visibility. Changing mode re-renders the list header.
         alwaysNotify so repeated writes of the same mode (e.g. still "hints"
         but with new items) reliably fire even when the string is unchanged. -->
    <field id="mode" type="string" onChange="renderSectionLabel" alwaysNotify="true" />

    <!-- Array of { text, value } AAs. For recent mode, value == the term string;
         for hints mode, value == the name string (we drive full search from the
         name). Writing this field fully replaces the list contents.
         alwaysNotify is critical: once the list is "full" (e.g. 8 entries) and
         the next hint set is also 8 entries, the Scenegraph can elide the
         change-notification — leaving the old items on screen. alwaysNotify
         forces the re-render every time. -->
    <field id="items" type="array" onChange="renderItems" alwaysNotify="true" />

    <!-- Emitted when the user activates a row. value of the activated row.
         Observers pick this up to trigger a full search. -->
    <field id="selectedSuggestion" type="string" alwaysNotify="true" />

    <!-- Emitted when the user activates the pinned Clear History button. -->
    <field id="clearHistoryRequested" type="boolean" alwaysNotify="true" />

    <!-- Emitted when the user presses OPTIONS on a focused recent-search row.
         Value is the term string that should be removed from registry. -->
    <field id="removeRequested" type="string" alwaysNotify="true" />

    <!-- Set to "right" or "left" when the user leaves for the keyboard (onto
         its left or right edge), or "down" when DOWN leaves the column past
         its last row or Clear History, or "empty" when focus lands on the
         list while it has no rows. -->
    <field id="escape" type="string" alwaysNotify="true" />
    <!-- focusItem(value) as boolean: focus the row with that activation value,
         else the first; false when the list is empty. -->
    <function name="focusItem" />
  </interface>
</component>
