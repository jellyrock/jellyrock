import "pkg:/source/api/ApiClient.bs"
import "pkg:/source/api/apiPipeline.bs"
import "pkg:/source/api/apiPool.bs"
import "pkg:/source/api/apiRead.bs"
import "pkg:/source/data/JellyfinDataTransformer.bs"
import "pkg:/source/roku_modules/log/LogMixin.brs"
import "pkg:/source/translationKeys.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/searchOutcome.bs"

sub init()
  m.log = new log.Logger("SearchTask")
  m.top.functionName = "search"
end sub

sub search()
  if isValid(m.top.query) and m.top.query <> ""
    m.top.results = searchMedia(m.top.query)
  end if
end sub

' Searches multiple Jellyfin endpoints for media matching the query.
' Runs on SearchTask thread: the reads run side by side through apiPipeline, and this thread
' blocks until each one answers or the pipeline's budget runs out.
' Every result echoes the query it ANSWERS. The caller gives each run a new node and
' drops a delivery from any node it has since replaced (`SearchScreen.onFullSearchResults`); the
' echo is what that drop logs, so a superseded delivery names the query it answered. Taken
' from the local the search actually ran with, so the echo and the items cannot disagree.
'
' ⚠️ `m.top.results` is assigned ONCE, by `search()` with this function's return value, as the
' Task's last act, and that is essential, not incidental. It is what lets the caller's `control = "stop"` prevent a
' superseded query from delivering at all (measured 2026-08-14: 12 keystrokes, 6 deliveries, every one
' current). Publishing partial results as each fetch lands would widen the window of
' superseded deliveries that `SearchScreen.onFullSearchResults` has to drop.
'
' Every result also carries a `status` (searchOutcome.statusOf): a read that did not answer
' says nothing about what the server holds, so the screen never shows a search whose reads
' failed as one that found nothing.
function searchMedia(query as string)
  if query = "" then return { Items: [], TotalRecordCount: 0, query: query, status: searchOutcome.STATUS_OK }

  transformer = JellyfinDataTransformer()
  ' Read once and handed to every transformBaseItem call: without it the transformer reads
  ' m.global.server.version itself, two crossings to the render thread per item.
  serverVersion = m.global.server.version
  allItems = []
  ' One per search, so one search's failed reads never count against the next.
  reader = new apiRead.Reader(m.log, "search")

  ' One read per library type (searchOutcome.LIBRARY_TYPES), each with its own limit, so no
  ' type can crowd another's row out. The request ids keep their `searchItems` prefix: the
  ' device specs fail and slow reads by it.
  entries = []
  for each itemType in searchOutcome.LIBRARY_TYPES
    entries.push({
      requestId: "searchItems" + itemType, library: true, req: GetApi().BuildGetItemsByQueryRequest({
        "searchTerm": query,
        "IncludeItemTypes": itemType,
        ' ChildCount gives a collection or photo album tile its "N items" line, as in the
        ' details Collections row; a list query returns it for those only when asked.
        "Fields": "ChildCount",
        "EnableTotalRecordCount": false,
        "Recursive": true,
        "limit": SEARCH_READ_LIMIT
      })
    })
  end for
  ' People and artists: /Items returns neither type, so each has its own endpoint.
  entries.push({
    requestId: "searchPersons", library: false, req: GetApi().BuildGetPersonsRequest({
      "searchTerm": query,
      "Limit": SEARCH_READ_LIMIT,
      "EnableTotalRecordCount": false
    })
  })
  entries.push({
    requestId: "searchArtists", library: false, req: GetApi().BuildGetArtistsRequest({
      "searchTerm": query,
      "Limit": SEARCH_READ_LIMIT,
      "EnableTotalRecordCount": false
    })
  })
  ' Live TV guide programs, through /Items with LiveTvProgram, as Jellyfin's web client searches
  ' them. /LiveTv/Programs takes no search term (none in the API from 10.7 to 10.11, and every
  ' server to 12.1 ignores one), so it answered every search with the first guide programs.
  ' Not asked for a user without Live TV access (searchOutcome.canSearchLiveTv). The policy is
  ' read once, as this runs on a Task thread, where each m.global read crosses to the render
  ' thread.
  if searchOutcome.canSearchLiveTv(m.global.user.policy)
    entries.push({
      requestId: "searchPrograms", library: false, req: GetApi().BuildGetItemsByQueryRequest({
        "searchTerm": query,
        "IncludeItemTypes": "LiveTvProgram",
        "Recursive": true,
        "EnableTotalRecordCount": false,
        "limit": SEARCH_READ_LIMIT
      })
    })
  end if

  ' A read whose request could not be built is counted as not sent, not pipelined.
  sendable = []
  for each entry in entries
    if isValid(entry.req)
      sendable.push(entry)
    else
      reader.json(invalid, entry.requestId)
    end if
  end for

  pipe = apiPipelineBegin(sendable)
  delivery = apiPipelineNext(pipe)
  while isValid(delivery)
    data = reader.answered(delivery.res, delivery.entry.requestId)
    if isValid(data) and isValid(data.Items)
      for each item in data.Items
        ' Live TV recordings come back from /Items as the content type (Movie/Episode).
        ' The only reliable discriminator is the container format: recordings are always
        ' stored as MPEG transport streams ("ts"), while library items never are.
        if delivery.entry.library and LCase(item.Container ?? "") = "ts"
          item.Type = "Recording"
        end if
        allItems.push(transformer.transformBaseItem(item, serverVersion))
      end for
    end if
    delivery = apiPipelineNext(pipe)
  end while

  result = {}
  result.Items = allItems
  result.TotalRecordCount = allItems.count()
  result.query = query
  result.status = searchOutcome.statusOf(reader.sentCount, reader.failedCount)
  return result
end function

' The most items one search read asks for, so the most one row can show. The cost is per
' item, not per read: each one is parsed, handed to this thread and built into a
' JellyfinBaseItem, and that is most of a broad search's time (followups lean-tile-node-cost
' and search-row-paging). Measure on a device before changing it (npm run measure).
const SEARCH_READ_LIMIT = 50
