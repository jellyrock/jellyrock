import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/searchKeyboardRows.bs"

' SearchKeyboard: custom DynamicCustomKeyboard subclass used inside the
' SearchOverlay pull-down. Extends the stock keyboard with:
'
' 1. Special-key handling: Clear strOut token bubbles up as a boolean field
'    (clearRequested) the parent observes. Submit/Enter key was removed:
'    submission happens via DOWN from the bottom row or suggestion tap.
' 2. Edge-escape signalling: arrow presses at grid edges set m.top.escape so
'    the parent can hand focus to adjacent UI (the suggestion column on either
'    side, the results below) instead of wrapping inside the grid.
' 3. Voice conflict avoidance: disables the keyboard's internal voiceEnabled
'    textEditBox so the screen-level VoiceTextEditBox owns Roku's single
'    voice slot exclusively.

sub init()
  m.top.keyGrid.keyDefinitionUri = "pkg:/components/keyboards/SearchKeyboardKDF.json"
  m.top.keyGrid.mode = "alphanumeric"
  ' Open on A, not on Space, the grid's first key (searchKeyboardRows.rows).
  m.top.keyGrid.jumpToKey = [0, 0, 1]

  ' Theme the keys from the app palette. DynamicKeyGrid takes its colors only from an
  ' RSGPalette on its `palette` field (Roku's DynamicKeyGrid reference); without one it
  ' falls back to Roku's default gray/white. Same approach as JRKeyboardDialog. Keys use
  ' colorBackgroundSecondary, like the Clear History button beside them; the focused key is
  ' Roku's filled highlight (the grid offers no border form) in colorPrimary.
  constants = m.global.constants
  keyPalette = CreateObject("roSGNode", "RSGPalette")
  keyPalette.colors = {
    KeyboardColor: constants.colorBackgroundSecondary,
    PrimaryTextColor: constants.colorTextPrimary,
    SecondaryItemColor: constants.colorTextDisabled,
    FocusColor: constants.colorPrimary,
    FocusItemColor: constants.colorTextPrimary
  }
  m.top.keyGrid.palette = keyPalette

  ' The peek chip shows the query, so the built-in text box is not drawn: hideTextBox
  ' renders the key grid at the top of this node, which the overlay's layout depends on
  ' (searchLayout.OVERLAY_HEIGHT).
  m.top.hideTextBox = true

  ' No wrap inside a row: the edge keys hand off to the suggestion column instead
  ' (onKeyEvent). Roku documents false as the default; set so it is not relied on.
  m.top.keyGrid.horizWrap = false

  ' Voice: keep Roku's single voice slot for the screen-level VoiceTextEditBox
  ' (SearchScreen.initVoiceBox), so the hidden built-in box never claims it.
  if isValid(m.top.textEditBox)
    m.top.textEditBox.voiceEnabled = false
    m.top.textEditBox.active = false
  end if
end sub

' keySelected: called by DynamicCustomKeyboard for every key press.
' Returns true if the key was handled internally (preventing its strOut from
' being appended to the text field), false to let the default behavior run.
function keySelected(key as string) as boolean
  if key = "clear"
    m.top.clearRequested = true
    return true
  end if

  return false
end function

' onKeyEvent: at a grid edge, set m.top.escape (and, for left / right, m.top.escapeRow)
' so the screen moves focus off the keyboard: up and down off the top and bottom rows,
' and left and right off either side edge. Left and right are the two ends of the
' overlay's horizontal loop (suggestions, keyboard, suggestions): the screen sends both
' to the suggestion column, and back into the keyboard through focusEdge. horizWrap is
' off (init), so the grid itself never wraps a row and the edge keys reach this handler.
function onKeyEvent(key as string, press as boolean) as boolean
  if not press then return false

  focusedChild = m.top.focusedChild
  if not isValid(focusedChild) then return false
  focused = focusedChild.keyFocused
  if not isValid(focused) then return false

  rows = searchKeyboardRows.rows()
  if key = "up" and inArray(rows[0], focused)
    m.top.escape = key
    return true
  else if key = "down" and inArray(rows[3], focused)
    m.top.escape = key
    return true
  else if key = "left" or key = "right"
    for row = 0 to rows.count() - 1
      edge = rows[row][0]
      if key = "right" then edge = rows[row][rows[row].count() - 1]
      if focused = edge
        m.top.escapeRow = row
        m.top.escape = key
        return true
      end if
    end for
  end if

  return false
end function

' focusEdge(row, side): take focus on the left ("left") or right ("right") edge key of
' `row`, the way into the keyboard from the suggestion column. An out-of-range row means
' the top row.
sub focusEdge(row as integer, side as string)
  rows = searchKeyboardRows.rows()
  if row < 0 or row >= rows.count() then row = 0
  index = 0
  if side = "right" then index = rows[row].count() - 1
  m.top.setFocus(true)
  m.top.keyGrid.jumpToKey = [0, row, index]
end sub
