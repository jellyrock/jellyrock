<?xml version="1.0" encoding="utf-8"?>

<component name="SearchHintsTask" extends="Task">
  <interface>
    <!-- Input: the current search term to fetch hints for. -->
    <field id="query" type="string" />

    <!-- Output: assocarray of { query, hints: [{ text, name, id, type }] }.
         The query field on the output lets the render-thread observer
         discard stale results by comparing against the current query. -->
    <field id="results" type="assocarray" alwaysNotify="true" />
  </interface>
</component>
