import "pkg:/source/translationKeys.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/translate.bs"

' SearchHeader — query display for the SearchOverlay.
'
' A plain Label rather than a visible Roku textEditBox, for two reasons:
'   1. Roku's textEditBox renders its own caret + "press * for voice" prompt
'      that interferes with overlay animation and needed ugly translation hacks
'      in the prior design (SearchResults.bs line 85).
'   2. All text comes from the custom QWERTY keyboard's keyGrid.text field via
'      an observer in SearchScreen.bs — there's no direct typing target here.

sub init()
  m.queryLabel = m.top.findNode("queryLabel")
  m.underline = m.top.findNode("underline")

  constants = m.global.constants
  ' Secondary (accent) color, not Primary — Primary is reserved for FOCUS
  ' indication across the app, and the underline is static decoration.
  m.underline.color = constants.colorSecondary + constants.alpha70

  m.top.placeholder = translate(translationKeys.ButtonSearch)

  renderText()
end sub

' Drive label text + color based on whether we have real input.
sub renderText()
  if not isValid(m.queryLabel) then return
  constants = m.global.constants

  queryText = m.top.queryText
  if isValid(queryText) and queryText <> ""
    m.queryLabel.text = queryText
    m.queryLabel.color = constants.colorTextPrimary
  else
    m.queryLabel.text = m.top.placeholder
    m.queryLabel.color = constants.colorTextSecondary
  end if
end sub
