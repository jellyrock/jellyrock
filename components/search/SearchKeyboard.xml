<?xml version="1.0" encoding="utf-8"?>
<component name="SearchKeyboard" extends="DynamicCustomKeyboard">
  <interface>
    <!-- DynamicCustomKeyboard calls this for every key press, so special keys that
         emit strOut tokens (clear) are handled here: it returns true to consume a
         token it handled. -->
    <function name="keySelected" />

    <!-- Raised true when the user activates the Clear key. Observer should
         wipe the current query text in response. -->
    <field id="clearRequested" type="bool" alwaysNotify="true" />

    <!-- Set to "up" | "down" | "left" | "right" when focus reaches a grid edge
         and the parent should take over (submit on "down"; the suggestion
         column on "left" or "right"). -->
    <field id="escape" type="string" alwaysNotify="true" />

    <!-- The row (0-3) a "left" or "right" escape left from, set before escape. -->
    <field id="escapeRow" type="integer" value="0" />

    <!-- focusEdge(row, side): focus the left or right edge key of a row. -->
    <function name="focusEdge" />
  </interface>
</component>
