import "pkg:/source/api/baserequest.bs"
import "pkg:/source/api/Image.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/itemImageUrl.bs"
import "pkg:/source/utils/misc.bs"

sub init()
  m.description = m.top.findNode("description")
  m.videosList = m.top.findNode("extrasGrid")
  m.buttonGroup = m.top.findNode("buttons")
  m.buttonGroup.observeField("escape", "onButtonGroupEscaped")
  m.favoriteButton = m.top.findNode("favoriteButton")
  m.extrasGrp = m.top.findNode("extrasGrp")
  m.extrasGrp.opacity = 1.0
  m.top.optionsAvailable = false

  ' Set initial focus for scene navigation
  m.top.lastFocus = m.description
end sub

sub OnScreenShown()
  ' Always set transparent backdrop for person screens
  ' Prevents stale movie/TV backdrops from persisting
  m.global.sceneManager.callFunc("setBackgroundImage", "")

  ' Restore focus for scene navigation
  if isValid(m.top.lastFocus)
    m.top.lastFocus.setFocus(true)
  else
    m.top.setFocus(true)
  end if
end sub

sub loadPerson()
  item = m.top.itemContent
  m.top.Id = item.id

  ' Always set transparent backdrop for person screens
  ' Prevents stale movie/TV backdrops from persisting
  m.global.sceneManager.callFunc("setBackgroundImage", "")
  nameLabel = m.top.findNode("name")
  nameLabel.Text = item.name

  if isValidAndNotEmpty(item.premiereDate)
    lifeStringLabel = createObject("rosgnode", "LabelPrimarySmallest")
    lifeStringLabel.id = "premierDate"
    lifeStringLabel.bold = true
    lifeStringLabel.height = "100"
    lifeStringLabel.vertAlign = "bottom"
    nameLabel.vertAlign = "top"
    m.top.findNode("title_rectangle").appendChild(lifeStringLabel)
    birthDate = CreateObject("roDateTime")
    birthDate.FromISO8601String(item.premiereDate)
    deathDate = CreateObject("roDatetime")
    lifeString = tr("Born") + ": " + birthDate.AsDateString("short-month-no-weekday")

    if isValidAndNotEmpty(item.endDate)
      deathDate.FromISO8601String(item.endDate)
      lifeString = lifeString + " * " + tr("Died") + ": " + deathDate.AsDateString("short-month-no-weekday")

    end if
    ' Calculate age
    age = deathDate.getYear() - birthDate.getYear()
    if deathDate.getMonth() < birthDate.getMonth()
      age--
    else if deathDate.getMonth() = birthDate.getMonth()
      if deathDate.getDayOfMonth() < birthDate.getDayOfMonth()
        age--
      end if
    end if
    lifeString = lifeString + " * " + tr("Age") + ": " + stri(age)
    lifeStringLabel.Text = lifeString
  end if

  ' Set description text and dialog title for the FocusableOverview component
  m.description.dialogTitle = item.name
  if isValidAndNotEmpty(item.overview)
    m.description.text = item.overview
  else
    m.description.text = tr("Biographical information for this person is not currently available.")
    m.description.horizAlign = "center"
    m.description.vertAlign = "center"
  end if

  posterSize = imageSize.POSTER_LG
  m.top.findnode("personImage").uri = getItemPosterUrl(item, posterSize)
  m.videosList.callFunc("loadPersonVideos", m.top.Id)

  setFavoriteColor()
  if not m.favoriteButton.hasFocus() then m.description.setFocus(true)
end sub

sub onButtonGroupEscaped()
  key = m.buttonGroup.escape
  if key = "down"
    m.description.setFocus(true)
  end if
end sub

function onKeyEvent(key as string, press as boolean) as boolean
  if not press then return false

  if key = "back"
    m.global.sceneManager.callfunc("popScene")
    return true
  end if

  if key = "down"
    if m.description.isInFocusChain()
      m.videosList.setFocus(true)
      m.top.findNode("VertSlider").reverse = false
      m.top.findNode("colorSlider").reverse = false
      m.top.findNode("pplAnime").control = "start"
      return true
    else if m.favoriteButton.hasFocus()
      m.favoriteButton.setFocus(false)
      m.description.setFocus(true)
      return true
    end if
  else if key = "up"
    if m.description.isInFocusChain()
      m.favoriteButton.setFocus(true)
      return true
    else if m.videosList.isInFocusChain() and m.videosList.itemFocused = 0
      m.top.findNode("VertSlider").reverse = true
      m.top.findNode("colorSlider").reverse = true
      m.top.findNode("pplAnime").control = "start"
      m.description.setFocus(true)
      return true
    end if
  end if
  return false
end function

sub setFavoriteColor()
  favoriteBtn = m.top.findNode("favoriteButton")
  if m.top.itemContent.isFavorite
    favoriteBtn.textColor = "#269926ff"
    favoriteBtn.text = tr("Favorite")
  else
    favoriteBtn.text = tr("Set Favorite")
  end if
end sub
