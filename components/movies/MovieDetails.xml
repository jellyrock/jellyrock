<?xml version="1.0" encoding="utf-8"?>
<component name="MovieDetails" extends="JRScreen">
  <children>
    <Gradient id="itemTextGradient" width="1920" height="0" rotateDegrees="180" translation="[0, 0]" />

    <LayoutGroup id="itemDetails" layoutDirection="vert" vertAlignment="bottom" itemSpacings="[24]" translation="[96, 775]" enableRenderTracking="true">
      <LayoutGroup layoutDirection="vert">
        <LabelPrimaryLargest id="videoTitle" bold="true" />
        <LayoutGroup layoutDirection="horiz" itemSpacings="[9]" id="infoGroup" />
        <LayoutGroup layoutDirection="horiz" itemSpacings="[9]" id="directorGenreGroup" />
      </LayoutGroup>

      <LayoutGroup id="itemDescription" layoutDirection="vert" itemSpacings="[15]" />

      <LayoutGroup id="itemTracks" layoutDirection="horiz" itemSpacings="[15]">
        <LayoutGroup id="videoTrack" layoutDirection="horiz" itemSpacings="[6]">
          <LabelSecondarySmaller id="video_codec" vertAlign="bottom" />
          <LabelSecondarySmallest id="video_codec_count" vertAlign="top" />
        </LayoutGroup>
        <LayoutGroup id="audioTrack" layoutDirection="horiz" itemSpacings="[6]">
          <LabelSecondarySmaller id="audio_codec" vertAlign="bottom" />
          <LabelSecondarySmallest id="audio_codec_count" vertAlign="top" />
        </LayoutGroup>
        <LayoutGroup id="subtitleTrack" layoutDirection="horiz"></LayoutGroup>
      </LayoutGroup>
    </LayoutGroup>

    <MovieOptions id="movieOptions" visible="false" />

    <JRButtonGroup id="buttons" translation="[90, 800]">
      <IconButton id="playButton" icon="pkg:/images/icons/play.png" text="Play" />
      <IconButton id="watchedButton" icon="pkg:/images/icons/check.png" text="Watched" />
      <IconButton id="favoriteButton" icon="pkg:/images/icons/heart.png" text="Favorite" />
    </JRButtonGroup>
    <!-- Movie logo - positioned 5% from right edge, bottom-aligned with button group -->
    <Poster id="movieLogo" />

    <!-- "Cast and Crew" row -->
    <extrasSlider id="movieExtras" />
  </children>
  <interface>
    <field id="itemContent" type="node" />
    <field id="trailerAvailable" type="bool" onChange="trailerAvailableChanged" value="false" />
    <field id="selectedAudioStreamIndex" type="integer" />
    <field id="selectedVideoStreamId" type="string" />
    <field id="quickPlayNode" type="node" alwaysNotify="true" />
    <field id="refreshMovieDetailsData" type="bool" alwaysNotify="true" />
  </interface>
</component>