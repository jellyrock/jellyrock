<?xml version="1.0" encoding="utf-8"?>
<component name="ProgramDetails" extends="JRGroup">
  <children>

    <!-- Selected Item Details -->
    <maskGroup id="backgroundMask" maskUri="pkg:/images/backgroundmask.png" translation="[1467, 183]" maskSize="[357,267]">
      <Poster id="image" height="267" width="357" loadDisplayMode="scaleToFit" />
    </maskGroup>

    <Poster id="favorite" translation="[1482, 198]" uri="pkg:/images/icons/favorite_selected_$$RES$$.png" visible="false" />

    <Group id="detailsView" visible="false">

      <!-- The library screen's header strip, above this pane, names the program and gives
           its length, its time and its channel (the `summary` field). What follows it starts here. -->
      <Group translation="[ 96, 183 ]">
        <LayoutGroup itemSpacings="[12, 36]">

          <LayoutGroup id="episodeDetailsGroup" layoutDirection="horiz" itemSpacings="[10]">
            <Group id="isLive">
              <Poster id="isLiveBackground" uri="pkg:/images/9patch/filled-rounded.9.png" blendColor="#FF0000" />
              <LabelPrimarySmallest id="isLiveText" text="" translation="[8,4]" isBold="true" />
            </Group>
            <Group id="isRepeat">
              <Poster id="isRepeatBackground" uri="pkg:/images/9patch/filled-rounded.9.png" blendColor="#009688" />
              <LabelPrimarySmallest id="isRepeatText" text="" translation="[8,4]" isBold="true" />
            </Group>
            <LabelPrimarySmall id="episodeNumber" />
            <LabelPrimarySmall id="episodeTitle" />
          </LayoutGroup>

          <LabelSecondarySmall id="overview" wrap="true" width="1305" />

          <JRButtonGroup id="buttons" opacity="0">
            <TextButton id="viewChannelButton" text="" />
            <TextButton id="recordButton" text="" />
            <TextButton id="recordSeriesButton" text="" />
          </JRButtonGroup>

        </LayoutGroup>

      </Group>
    </Group>
    <!-- When no schedule information to display  -->
    <LayoutGroup id="noInformation" translation="[96, 183]">
      <LabelPrimarySmall id="noScheduleInfoLabel" text="" />
    </LayoutGroup>
    <Animation id="focusAnimation" duration="0.2" repeat="false" easeFunction="linear">
      <FloatFieldInterpolator id="buttonsFocusAnimationOpacity" key="[0.0, 1]" fieldToInterp="buttons.opacity" />
    </Animation>
  </children>
  <interface>
    <field id="shouldWatchSelectedChannel" type="boolean" value="false" />
    <field id="shouldRecordSelectedChannel" type="boolean" value="false" />
    <field id="shouldRecordSeriesSelectedChannel" type="boolean" value="false" />
    <field id="channel" type="node" onchange="onChannelUpdated" />
    <field id="favorite" type="node" onchange="onChannelUpdated" />
    <field id="programDetails" type="node" onchange="onProgramUpdated" />
    <field id="height" type="integer" />
    <!-- What the header strip says about the focused program: { title, metadata: [items] }.
         A channel with no program gives its name alone. -->
    <field id="summary" type="assocarray" />
    <field id="hasFocus" type="boolean" onChange="onFocusChanged" />
  </interface>
</component>