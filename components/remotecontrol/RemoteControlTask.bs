import "pkg:/components/websocket/web_socket_client/ByteUtil.brs"
import "pkg:/components/websocket/web_socket_client/Logger.brs"
import "pkg:/components/websocket/web_socket_client/WebSocketClient.brs"
import "pkg:/source/api/baseRequest.bs"
import "pkg:/source/logging/Logger.bs"
import "pkg:/source/remotecontrol/remoteCommand.bs"
import "pkg:/source/remotecontrol/remoteProtocol.bs"
import "pkg:/source/syncplay/syncPlayInbox.bs"
import "pkg:/source/utils/backoff.bs"
import "pkg:/source/utils/deviceCapabilities.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/serverCapabilities.bs"

' Remote-control receiver (#666): the ws:// "Cast to JellyRock" listener. See RemoteControlTask.xml
' for the lifecycle/threading overview. This task runs the vendored WebSocketClient object on its own
' thread, so a frame goes from the socket to handleFrame with no hand-off between threads: open ->
' parse frames -> answer keepalive -> marshal commands -> reconnect with backoff. It never dispatches (that's remoteDispatch on
' the main thread) and never logs the socket url (it carries the auth token).
sub init()
  m.log = new log.Logger("RemoteControl")
  m.top.functionName = "runReceiver"
end sub

' Post-login entry point (launchTask from the first-run branch of Home.onScreenShown, once the session
' token exists). Selects the transport by server scheme: an http:// server uses the ws:// session
' socket (#666); an https:// server can't ws:// (Roku has no socket TLS) so it probes for the companion
' plugin and, if present, runs the long-poll command channel (#667). SignOut sets control="STOP",
' terminating this thread, and the socket it holds with it.
sub runReceiver()
  serverUrl = m.global.server.serverUrl
  ' A new run numbers its SyncPlay frames from 1 under a new name (sendSyncPlayFrame).
  m.syncPlayOutbox = invalid

  ' The channel's state starts unknown for each run; the transport below settles it.
  setChannelStatus(serverCapabilities.STATUS_UNKNOWN)

  ' NOTE: the cold-launch cast pairing report (#668) is not sent here. It fires as a fire-and-forget
  ' SubmitSideEffect from Home.onScreenShown's first run (alongside the capabilities POST), so it can
  ' never delay this command channel. See remoteProtocol.buildPairRequest + docs/architecture/remote-control.md.
  if remoteProtocol.isHttpServer(serverUrl)
    runWsReceiver(serverUrl)
  else
    runLongPollReceiver(serverUrl)
  end if
end sub

' Publish whether this server has a push channel to the Roku (server.remoteChannelStatus, which
' SyncPlay reads). Written only on a change: this is a Task thread writing m.global, a rendezvous
' with the render thread, and the status changes only when the channel comes or goes.
sub setChannelStatus(status as string)
  if m.global.server.remoteChannelStatus = status then return
  m.global.server.remoteChannelStatus = status
end sub

' ws:// transport (#666): build the session-socket url and run the connect/reconnect loop until the
' session ends (token rotated, or control="STOP" kills the thread).
sub runWsReceiver(serverUrl as string)
  url = remoteProtocol.buildSocketUrl(serverUrl, m.global.user.authToken, m.global.device.serverDeviceName, m.global.server.version)
  if url = ""
    ' Missing credential (scheme already gated by runReceiver) -> stay dark.
    m.log.info("ws receiver disabled: missing session")
    return
  end if

  ' Snapshot the token so a reconnect can detect a server-side rotation and stop cleanly.
  m.openedWithToken = m.global.user.authToken
  m.port = CreateObject("roMessagePort")
  ' Set at the first on_open: until then a close says nothing about a channel this run has had.
  m.socketHasOpened = false
  m.reopenAwaitsAttach = false
  ' The session check (remoteProtocol.checksSocketSession): whether this server needs it, the
  ' request it makes, and how many reopens in a row it has caused.
  m.checksSession = remoteProtocol.checksSocketSession(m.global.server.version)
  m.sessionCheckUrl = remoteProtocol.buildSessionCheckUrl(serverUrl, m.global.device.serverDeviceName)
  m.sessionCheckReopens = 0

  attempt = 0
  while true
    ' Before 10.11 the server ends its session when the last socket closes, and the connect below
    ' would create the next one alongside whatever else arrives then. Announcing first means the
    ' session exists when the socket asks for it, with this device's capabilities on it.
    if m.checksSession then announceSession(serverUrl)
    wasStable = connectAndPump(url)

    ' The socket closed. Reconnect unless the session is gone. SignOut(false) (logout AND server
    ' switch) sets control="STOP", killing this thread; this guard only catches a token rotation.
    currentToken = m.global.user.authToken
    if not isValidAndNotEmpty(currentToken) or currentToken <> m.openedWithToken
      m.log.info("session ended; receiver stopping")
      return
    end if

    ' Backoff progression. A connection that was ESTABLISHED and STABLE (connectAndPump returned true:
    ' it opened and stayed up past the stable threshold) then dropped resets the counter so we
    ' reconnect promptly: a real session that blips shouldn't wait out a stale 30s backoff. A
    ' never-opened or quickly-flapping connection leaves the counter climbing, so the exponential
    ' backoff (1s, 2s, 4s, ... capped 30s) is unchanged for a persistently-down/flapping server.
    ' That path never resets, so it can't hot-loop. increment AFTER the sleep so the 0th tier (1s) is
    ' actually used rather than skipped straight to 2s.
    if wasStable then attempt = 0
    ' Nothing the server pushes reaches this Roku until the socket is back: SyncPlay reads the
    ' status, and its icon disables rather than offer a group no command would reach. A blip
    ' after a stable session reconnects first (remoteProtocol.socketDownMarksUnavailable), and
    ' on_open publishes available again.
    if remoteProtocol.socketDownMarksUnavailable(m.socketHasOpened, wasStable) then setChannelStatus(serverCapabilities.STATUS_UNAVAILABLE)
    backoffMs = backoff.nextDelayMs(attempt)
    m.log.info("socket closed; reconnecting", "inMs", backoffMs)
    sleep(backoffMs)
    attempt++
  end while
end sub

' Open the socket and pump it until it closes or errors. The client is a plain object on this
' thread: each pass runs it (it waits a moment for the socket, reads what the socket holds and
' decodes every complete frame), then handles every event that pass produced, in order. The wait
' inside run() paces this loop: a few passes a second while the socket is quiet. Nothing
' crosses a thread between the socket and handleFrame. A frame handed from a socket task to this
' one through a node field reached it seconds late, when the next frame arrived (decision
' `syncplay-socket-runs-in-receiver`). Sends a KeepAlive at the interval Jellyfin's ForceKeepAlive
' requested. Returns on close.
' Returns TRUE when the connection was ESTABLISHED and STABLE (it opened and stayed up at least
' STABLE_SESSION_MS), so runWsReceiver can reset its reconnect backoff. A never-opened socket, or one
' that opened but dropped sooner than that (a flap), returns FALSE so the backoff keeps climbing.
' Threshold = the backoff cap (30s): a session that outlived the max backoff interval was clearly real.
function connectAndPump(url as string) as boolean
  STABLE_SESSION_MS = 30000

  m.ws = WebSocketClient()
  m.wsEvents = CreateObject("roMessagePort")
  m.ws.set_message_port(m.wsEvents)

  ' Bind this socket to the SAME Jellyfin DeviceId the REST API advertises. 10.7.x binds from the
  ' query string. 10.8 to 10.10 authenticate with this header, but the `deviceId` query param
  ' buildSocketUrl puts on the url overrides the header's DeviceId (the two carry the same id).
  ' 10.11 and later read DeviceId from the Authorization header only and ignore the query param, so
  ' there a header-less upgrade falls back to the DeviceId the auth TOKEN was minted under (see
  ' buildSocketUrl's header). On an install upgraded from a pre-#721 build that is the old suffixed
  ' id, which puts the command channel on a DIFFERENT session than the REST API, the capabilities
  ' POST and the /pair report all use: the cast target resolves but commands are delivered to a
  ' session this socket isn't on (#743).
  ' Verified against Jellyfin 10.11.11: header absent -> session keyed on the token binding; header
  ' present -> session keyed on the header, and a command addressed to it arrives here.
  ' The token query param (ApiKey on 10.8.0+, api_key on 10.7.x) stays on the url as the auth carrier:
  ' if a reverse proxy strips Authorization on the upgrade we still connect, degrading to the old
  ' behavior instead of failing. It must not be api_key on 10.8.0+: that is legacy authorization,
  ' disabled by default from Jellyfin 12.0, so the fallback would silently stop authenticating.
  ' Must be set BEFORE `open`: the client reads its headers when it builds the handshake.
  m.ws.set_headers(["Authorization", buildAuthHeader(false)])

  m.log.info("opening session socket") ' never log url: it carries the auth token
  m.ws.open(url)

  sessionTimer = invalid ' marks when the socket opened; invalid => never opened (an unstable attempt)
  m.keepAliveIntervalMs = 0 ' set when a ForceKeepAlive arrives; 0 => no KeepAlive is due
  m.keepAliveTimer = CreateObject("roTimespan")
  heldBytes = 0
  while true
    m.ws.run()
    ' Bytes the pass read and did not decode: part of a frame still arriving, or data the client
    ' cannot read as a frame. Logged when the count changes, so a frame stuck here shows.
    if m.ws._data_size <> heldBytes
      heldBytes = m.ws._data_size
      if heldBytes > 0 then m.log.info("socket holds bytes not yet decoded", "bytes", heldBytes)
    end if
    while true
      event = m.wsEvents.GetMessage()
      if not isValid(event) then exit while
      if event.id = "on_message"
        handleFrame(event.data)
      else if event.id = "on_open"
        m.log.info("socket open")
        ' An open after the first is a reconnect. The server accepts the socket before it attaches it
        ' to the session and drops what it would push in between, so SyncPlay is told at the server's
        ' first keep-alive request, which follows the attach (see handleFrame).
        m.reopenAwaitsAttach = m.socketHasOpened
        m.socketHasOpened = true
        ' Armed here, started at the server's keep-alive request, which follows the attach.
        m.sessionCheckArmed = m.checksSession and m.sessionCheckUrl <> "" and m.sessionCheckReopens < remoteProtocol.SESSION_CHECK_LIMIT
        m.sessionCheckTimer = invalid
        setChannelStatus(serverCapabilities.STATUS_AVAILABLE)
        sessionTimer = CreateObject("roTimespan")
      else if isTerminalSocketEvent(event, isValid(sessionTimer))
        m.log.info("socket", event.id)
        closeSocket()
        return isValid(sessionTimer) and sessionTimer.TotalMilliseconds() >= STABLE_SESSION_MS
      end if
    end while
    if m.keepAliveIntervalMs > 0 and m.keepAliveTimer.TotalMilliseconds() >= m.keepAliveIntervalMs then sendKeepAlive()
    if isValid(m.sessionCheckTimer) and m.sessionCheckTimer.TotalMilliseconds() >= remoteProtocol.SESSION_CHECK_DELAY_MS
      m.sessionCheckTimer = invalid
      if socketIsOffItsSession()
        ' Reopened at once, as a stable session that blipped: the next connect lands on the
        ' session the server uses, which exists by now.
        closeSocket()
        return true
      end if
    end if
  end while
  return false ' unreachable (the loop only exits via the terminal-event return); satisfies the analyzer
end function

' Posts this device's capabilities and waits for the answer, which makes the server create the
' device's session if it holds none. Blocks this thread for the request. A failure is logged and
' the connect goes on: the session check after the attach is the net under it.
sub announceSession(serverUrl as string)
  req = CreateObject("roUrlTransfer")
  port = CreateObject("roMessagePort")
  req.SetMessagePort(port)
  req.SetUrl(serverUrl + "/Sessions/Capabilities/Full")
  req.AddHeader("Authorization", buildAuthHeader())
  req.AddHeader("Content-Type", "application/json")
  code = 0
  if req.AsyncPostFromString(FormatJson(getDeviceCapabilities()))
    event = wait(5000, port)
    if type(event) = "roUrlEvent"
      code = event.GetResponseCode()
    else
      req.AsyncCancel()
    end if
  end if
  if code < 200 or code >= 300 then m.log.warn("could not announce the session before the socket connect", "httpCode", code)
end sub

' Asks the server whether this device's session has the socket (remoteProtocol.socketSessionState).
' True only when the server lists the device with no socket: the socket is then on a session
' the server stopped using, and nothing it pushes arrives. Blocks this thread for the request.
function socketIsOffItsSession() as boolean
  answer = httpGet(m.sessionCheckUrl, 5000)
  state = remoteProtocol.socketSessionState(answer.code, answer.body, m.global.device.serverDeviceName)
  if state = remoteProtocol.SESSION_DETACHED
    m.sessionCheckReopens++
    m.log.warn("the server's session has no socket; reopening the socket", "reopensInARow", m.sessionCheckReopens)
    return true
  end if
  if state = remoteProtocol.SESSION_ATTACHED then m.sessionCheckReopens = 0
  m.log.info("session check", "state", state, "httpCode", answer.code)
  return false
end function

sub sendKeepAlive()
  m.ws.send([remoteProtocol.keepAliveFrame()])
  m.keepAliveTimer.Mark()
end sub

' True when this event of the client's means the connection is over, so the pump loop should tear
' down and let runWsReceiver reconnect. Two signals:
'
' - on_close / on_error: the usual ones, and the only ones for an error raised while the socket is
'   still OPEN or CLOSING (a failed read, a rejected handshake), about 30 s before the client's
'   _CLOSING_DELAY would force it to CLOSED.
' - ready_state = CLOSED: the backstop. Every _close() path in WebSocketClient.brs posts one of the
'   two above today, yet nothing enforces it, and without this arm an upstream re-sync that broke
'   it would leave the pump running a dead socket forever: no crash, no failing test, cast silently
'   dead.
'
' The second arm depends on `opened`: the client is CLOSED before open() and after a refused
' connect, where on_error already ends the attempt.
function isTerminalSocketEvent(event as object, opened as boolean) as boolean
  if event.id = "on_close" or event.id = "on_error" then return true
  return event.id = "ready_state" and opened and event.data = m.ws.STATE.CLOSED
end function

' Parse one inbound frame and either answer a keepalive or marshal a dispatchable command.
sub handleFrame(data as object)
  if not isValid(data) or not isValidAndNotEmpty(data.message) then return
  envelope = parseJson(data.message)
  if not isValid(envelope)
    m.log.warn("socket frame is not JSON, ignored", "chars", data.message.len())
    return
  end if
  ' Every frame that reaches the receiver, by type and size: a frame the server sent that has no
  ' line here never got this far.
  m.log.info("socket frame", "messageType", envelope.MessageType, "chars", data.message.len())

  command = remoteCommand.parseMessage(envelope)
  kind = command.kind

  if remoteProtocol.reopenIsToldNow(m.reopenAwaitsAttach, kind)
    m.reopenAwaitsAttach = false
    tellSyncPlaySocketReopened()
  end if

  if kind = "keepalive" and m.sessionCheckArmed = true
    m.sessionCheckArmed = false
    m.sessionCheckTimer = CreateObject("roTimespan")
  end if

  if kind = "keepalive"
    ' Jellyfin asks us to keep the session alive; send one now and poll on HALF the requested
    ' interval (a safety margin against the server's reap window), floored at 1s.
    intervalMs = command.intervalSeconds * 1000 / 2
    if intervalMs < 1000 then intervalMs = 1000
    m.keepAliveIntervalMs = intervalMs
    sendKeepAlive()
    return
  end if

  ' Marshal every dispatchable command to the main thread. keepalive already returned above; only
  ' "ignore" is dropped here, so a new dispatchable kind (route/goback/message/…) is forwarded
  ' without needing this gate updated again.
  if kind <> "ignore"
    marshalCommand(command)
  else
    logDroppedSyncPlayFrame(command)
  end if
  ' kind = "ignore" -> dropped (KeepAlive echo, Sessions, volume, unknown types).
end sub

' A SyncPlay frame the parser dropped (malformed, or a kind this app does not know) would
' otherwise vanish. Routine ignores (KeepAlive echoes, Sessions, volume) are not logged. Only the
' message type and the frame's kind are named, never its data.
sub logDroppedSyncPlayFrame(command as object)
  messageType = remoteCommand.droppedSyncPlayType(command)
  if messageType = "" then return
  m.log.warn("SyncPlay frame not understood, ignored", "messageType", messageType, "subtype", remoteCommand.syncPlaySubtype(command))
end sub

' Marshal a normalized command to the thread that acts on it. Drops the bulky original 'raw' Data first (a whole
' ItemIds list for a series/album can be large): the normalized fields carry everything the main
' thread needs. Shared by both transports; callers gate out keepalive/ignore before calling.
' A SyncPlay frame goes straight to the SyncPlay manager; everything else to the main thread.
sub marshalCommand(command as object)
  command.delete("raw")
  if command.kind = "syncplaycommand" or command.kind = "syncplayupdate"
    sendSyncPlayFrame(command)
    return
  end if
  m.top.dispatchCommand = command
end sub

' Write a SyncPlay frame to the manager's `frames` field, numbered and with the frames before
' it (syncPlayInbox), so the manager needs no notification per frame: the server sends a command
' and a group update back to back, and a frame handed over one write at a time has reached the
' manager seconds late. One crossing to the render thread per frame. The outbox is built here,
' on the thread that uses it, once per run of the receiver.
sub sendSyncPlayFrame(command as object)
  now = CreateObject("roDateTime")
  if not isValid(m.syncPlayOutbox)
    m.syncPlayManager = m.global.syncPlayManager
    m.syncPlayOutbox = syncPlayInbox.newOutbox(now.AsSeconds().toStr() + "." + now.GetMilliseconds().toStr())
  end if
  if not isValid(m.syncPlayManager)
    m.log.warn("SyncPlay frame dropped: no manager", "kind", command.kind)
    return
  end if
  m.syncPlayManager.frames = syncPlayInbox.push(m.syncPlayOutbox, command, now.AsSeconds(), now.GetMilliseconds())
end sub

' Tell the SyncPlay manager a reconnected session socket can receive pushes (its `socketReopened`
' field). Called at the server's first keep-alive request after the open, not at the open itself.
sub tellSyncPlaySocketReopened()
  manager = m.global.syncPlayManager
  if isValid(manager) then manager.socketReopened = true
end sub

' Drop the client and its socket. This only runs after the connection is already terminal, so no
' close frame is owed; teardown is abrupt by design (see `remotecontrol-socket-abrupt-teardown` in
' tech-debt.md for the graceful-close direction and why it is not worth the sequencing today).
sub closeSocket()
  if not isValid(m.ws) then return
  m.ws.release()
  m.ws = invalid
  m.wsEvents = invalid
end sub

' HTTPS long-poll transport (#667). Roku can't ws:// a secure server, so on https we consume the
' companion plugin's authenticated long-poll command channel over TLS (roUrlTransfer). The poll
' request ITSELF is the keepalive (it refreshes server-side session activity), so, unlike the ws
' path, there's no client KeepAlive to send. See docs/architecture/remote-control-longpoll-contract.md.
sub runLongPollReceiver(serverUrl as string)
  PROBE_TIMEOUT_MS = 8000 ' presence probe (matches ServerReachableTask's pre-flight budget)
  POLL_WAIT_MS = 25000 ' server holds each poll up to this before returning 204
  POLL_TIMEOUT_MS = 35000 ' client transfer timeout, longer than POLL_WAIT_MS so a 204 always lands first

  probeUrl = remoteProtocol.buildProbeUrl(serverUrl)
  if probeUrl = ""
    m.log.info("long-poll receiver disabled: no server url")
    return
  end if

  ' Snapshot the token before probing, so every probe and poll can detect a server-side rotation or
  ' a sign-out and stop cleanly (mirrors the ws path).
  m.openedWithToken = m.global.user.authToken

  ' At-least-once delivery state (contract v1). m.lastAckId is our cumulative ack (the newest MessageId
  ' we've received), sent on every poll so the plugin can drop confirmed commands and redeliver the rest.
  ' m.dispatchedIds/order is a small dedupe ring so a REDELIVERED command (a poll whose response we lost,
  ' resent by the plugin) can't double-apply a relative verb like NextTrack. Both reset per receiver start;
  ' a fresh receiver pairs with a fresh server-side session, so there's nothing to carry over.
  m.lastAckId = ""
  m.dispatchedIds = {}
  m.dispatchedOrder = []

  if remoteProtocol.buildLongPollUrl(serverUrl, POLL_WAIT_MS) = "" then return

  while true
    ' Probe until the plugin answers as usable. A transport failure or 5xx retries with backoff and
    ' leaves the channel status as it is; a "no plugin" answer marks it unavailable and checks again
    ' after a long wait, so a plugin installed later is found without reopening the app.
    if not waitForPlugin(probeUrl, PROBE_TIMEOUT_MS) then return
    setChannelStatus(serverCapabilities.STATUS_AVAILABLE)
    m.log.info("long-poll plugin present; starting poll loop")
    if not pollUntilPluginGone(serverUrl, POLL_WAIT_MS, POLL_TIMEOUT_MS) then return
  end while
end sub

' True while the session that started the receiver is still the signed-in one. False once the token is
' gone or rotated, which ends the receiver.
function isReceiverSessionCurrent() as boolean
  currentToken = m.global.user.authToken
  return isValidAndNotEmpty(currentToken) and currentToken = m.openedWithToken
end function

' Probe the plugin until it answers as usable. Returns true once it does, false when the session ended.
' Contract-version gate: the probe body carries the plugin's wire-contract version, and we run the loop
' only for a version we implement, else stay dark rather than risk acting on a command shape we might
' misread. See remote-control-longpoll-contract.md (Versioning).
function waitForPlugin(probeUrl as string, probeTimeoutMs as integer) as boolean
  attempt = 0
  while true
    if not isReceiverSessionCurrent()
      m.log.info("session ended; long-poll receiver stopping")
      return false
    end if

    probe = httpGet(probeUrl, probeTimeoutMs)
    version = remoteProtocol.parseContractVersion(probe.body)
    outcome = remoteProtocol.probeOutcome(probe.code, version)
    if outcome = remoteProtocol.PROBE_AVAILABLE
      return true
    else if outcome = remoteProtocol.PROBE_UNAVAILABLE
      m.log.info("long-poll plugin unavailable; probe returned", probe.code, "contractVersion", version, "recheckInMs", remoteProtocol.PLUGIN_RECHECK_MS)
      setChannelStatus(serverCapabilities.STATUS_UNAVAILABLE)
      attempt = 0
      sleep(remoteProtocol.PLUGIN_RECHECK_MS)
    else
      ' No answer about the plugin (transport failure, timeout or 5xx): keep the status, back off.
      backoffMs = backoff.nextDelayMs(attempt)
      m.log.info("long-poll plugin probe failed; retrying", "code", probe.code, "inMs", backoffMs)
      sleep(backoffMs)
      attempt++
    end if
  end while
  return false ' not reached: the loop only exits through its returns
end function

' Run the long-poll loop. Returns true when the plugin is gone (a 404), so the caller probes again, and
' false when the receiver should stop (a 401, or the session ended).
function pollUntilPluginGone(serverUrl as string, pollWaitMs as integer, pollTimeoutMs as integer) as boolean
  attempt = 0
  while true
    ' Token rotation / logout guard. control="STOP" (SignOut / server switch) terminates this thread
    ' outright; this catches a server-side token rotation between polls.
    if not isReceiverSessionCurrent()
      m.log.info("session ended; long-poll receiver stopping")
      return false
    end if

    ' Rebuilt each poll: the URL carries our current cumulative ackId, which advances as we receive.
    pollUrl = remoteProtocol.buildLongPollUrl(serverUrl, pollWaitMs, m.lastAckId)

    ' Time the poll so an abnormally fast EMPTY response (a plugin that doesn't honor the hold) can be
    ' floored below: a compliant plugin holds ~pollWaitMs, so the floor never fires on it.
    pollTimer = CreateObject("roTimespan")
    resp = httpGet(pollUrl, pollTimeoutMs)
    if resp.code = 200
      ' Queued command(s). Dispatch in order, then re-poll immediately (no backoff on success). A 200
      ' that dispatched nothing (empty array / garbled body) is abnormal: floor it like a fast 204 so
      ' a misbehaving plugin can't spin this loop with no backoff. A real command 200 returns fast and
      ' is not floored, so command latency is untouched.
      attempt = 0
      if dispatchBatch(resp.body) = 0 then throttleEmptyPoll(pollTimer)
    else if resp.code = 204
      ' Healthy empty hold: re-poll immediately (floored only if the server returned it near-instantly
      ' instead of holding, which a compliant plugin never does).
      attempt = 0
      throttleEmptyPoll(pollTimer)
    else if resp.code = 401
      ' The token is no longer valid: stop.
      m.log.info("long-poll receiver stopping; response", resp.code)
      return false
    else if resp.code = 404
      ' The plugin was uninstalled mid-session: mark it unavailable and let the caller probe again.
      m.log.info("long-poll plugin gone; probing again", resp.code)
      setChannelStatus(serverCapabilities.STATUS_UNAVAILABLE)
      return true
    else
      ' Transient error / timeout (code 0) -> exponential backoff (1s..30s), then retry. A persistently
      ' unreachable server keeps the counter climbing so it can't hot-loop.
      backoffMs = backoff.nextDelayMs(attempt)
      m.log.info("long-poll error; retrying", "code", resp.code, "inMs", backoffMs)
      sleep(backoffMs)
      attempt++
    end if
  end while
  return false ' not reached: the loop only exits through its returns
end function

' Authenticated async GET on this Task thread. Blocks up to timeoutMs for the response. Returns
' { code, body }; code = 0 on a failed initiation or a timeout. A fresh roUrlTransfer + roMessagePort
' per call avoids cross-call event bleed. Never logs the url: the Authorization header carries the
' token. Mirrors the raw-transfer pattern in LoadCaptionTask.bs / ServerReachableTask.bs.
function httpGet(url as string, timeoutMs as integer) as object
  req = CreateObject("roUrlTransfer")
  port = CreateObject("roMessagePort")
  req.SetMessagePort(port)
  req.SetUrl(url)
  if LCase(url).Left(8) = "https://" then req.SetCertificatesFile("common:/certs/ca-bundle.crt")
  req.AddHeader("Authorization", buildAuthHeader())
  if not req.AsyncGetToString() then return { code: 0, body: "" }

  event = wait(timeoutMs, port)
  if type(event) = "roUrlEvent"
    return { code: event.GetResponseCode(), body: event.GetString() }
  end if
  req.AsyncCancel() ' timed out -> abandon this transfer
  return { code: 0, body: "" }
end function

' Parse a long-poll 200 body (a JSON array of { MessageType, Data, MessageId } envelopes) and marshal
' each dispatchable command to the main thread, in array order. Returns how many commands were actually
' dispatched (0 for an empty array, a garbled body, or an all-ignore batch) so the caller can floor a
' pointless fast 200 against a hot-loop.
function dispatchBatch(body as string) as integer
  if not isValidAndNotEmpty(body) then return 0
  envelopes = parseJson(body)
  if not isValid(envelopes) or type(envelopes) <> "roArray" then return 0
  dispatched = 0
  for each envelope in envelopes
    if dispatchEnvelope(envelope) then dispatched++
  end for
  return dispatched
end function

' Normalize one long-poll envelope and marshal it if dispatchable; returns true iff it was dispatched.
' The long-poll contract never carries KeepAlive/ForceKeepAlive (the poll request is the keepalive), so
' keepalive is treated like ignore here: there's no socket to answer on. Reuses the same pure
' parseMessage as the ws path.
function dispatchEnvelope(envelope as object) as boolean
  if not isValid(envelope) then return false
  command = remoteCommand.parseMessage(envelope)

  ' Advance the cumulative ack to the newest id we've received (of ANY kind, including ignore/keepalive)
  ' so the plugin can drop it too. The body arrived atomically (roUrlTransfer is all-or-nothing), so the
  ' last id in the array acks the whole batch on our next poll.
  if isValidAndNotEmpty(command.messageId) then m.lastAckId = command.messageId

  kind = command.kind
  if kind = "ignore" then logDroppedSyncPlayFrame(command)
  if kind = "ignore" or kind = "keepalive" then return false

  ' Dedupe: at-least-once redelivers a batch whose response we lost, so a command we've ALREADY enacted
  ' can arrive again: drop it, or a relative verb (NextTrack/Rewind/FastForward) would double-apply.
  if hasDispatched(command.messageId) then return false

  marshalCommand(command)
  recordDispatched(command.messageId)
  return true
end function

' Dedupe ring for at-least-once redelivery. Records ids we've actually dispatched and evicts the oldest
' past a bounded window: a duplicate only ever arrives back-to-back (a redelivery on the very next poll),
' so a small window is ample. An empty id (the ws path, or a malformed envelope) is never tracked, so it's
' never deduped: those transports/paths don't redeliver.
function hasDispatched(messageId as dynamic) as boolean
  if not isValidAndNotEmpty(messageId) then return false
  return m.dispatchedIds.doesExist(messageId)
end function

sub recordDispatched(messageId as dynamic)
  DEDUPE_WINDOW = 64
  if not isValidAndNotEmpty(messageId) or m.dispatchedIds.doesExist(messageId) then return
  m.dispatchedIds[messageId] = true
  m.dispatchedOrder.push(messageId)
  if m.dispatchedOrder.count() > DEDUPE_WINDOW
    oldest = m.dispatchedOrder.shift()
    m.dispatchedIds.delete(oldest)
  end if
end sub

' Hot-loop floor for an abnormally fast EMPTY poll. A compliant plugin holds an empty poll for
' ~POLL_WAIT_MS, so this never fires against it; a misbehaving plugin that returns an empty 200/204
' near-instantly would otherwise spin the poll loop with no backoff. Sleep out the remainder of a
' minimum interval. Only ever called on the empty path, so it never delays a real command.
sub throttleEmptyPoll(pollTimer as object)
  POLL_MIN_EMPTY_MS = 1000
  elapsed = pollTimer.TotalMilliseconds()
  if elapsed < POLL_MIN_EMPTY_MS then sleep(POLL_MIN_EMPTY_MS - elapsed)
end sub
