{
  "extends": "./bsconfig-base.json",
  "files": [
    "manifest",
    {
      "src": "source/**/*",
      "dest": "source"
    },
    "!source/Main.bs",
    {
      "src": "components/**/*",
      "dest": "components"
    },
    {
      "src": "locale/**/*",
      "dest": "locale"
    },
    {
      "src": "settings/**/*",
      "dest": "settings"
    },
    {
      "src": "tests/source/**/*",
      "dest": "source/tests"
    },
    "!tests/source/e2e/**/*",
    "!tests/source/**/*.md",
    "!**/*.map"
  ],
  "plugins": [
    "rooibos-roku",
    "@rokucommunity/bslint",
    "./scripts/bsc-plugins/translation-keys.cjs"
  ],
  "rooibos": {
    "isRecordingCodeCoverage": false,
    "testsFilePattern": null,
    "tags": ["!migration", "!registry", "!measurement"],
    "showOnlyFailures": true,
    "catchCrashes": true,
    "lineWidth": 70,
    "failFast": false,
    "sendHomeOnFinish": false,
    "printTestTimes": true
  }
}
