#!/usr/bin/env sh
# Pre-push hook: auto-fix and conditionally lint per file type changed in the
# push range. Mirrors the CI lint suite so issues are caught before they fail
# the build.
#
# Auto-fix steps (mutate files; combined into one commit):
#   1. bsfmt --write on *.bs / *.brs in range
#   2. npm run update-translations  if BS source / locale / settings/settings.json changed
#
# Check steps (read-only; non-zero exit aborts the push):
#   3. npm run validate           — *.bs / *.brs / *.xml / bsconfig*.json
#   4. npm run lint:markdown      — *.md
#   5. npm run lint:spelling      — *.md
#   6. npm run lint:json          — *.json (jshint applies its own excludes)
#   7. npm run lint:docs          — docs/architecture/*.md, docs/decisions.md
#                                   (validates related-files: paths and links)
#
# Auto-fix is skipped (with a warning) when the working tree is dirty so WIP
# can't be swept into the auto-fix commit. Check steps still run.
#
# Bypass with `git push --no-verify` if you absolutely need to skip.

set -e

# Determine the push range. Fall back to origin/main when there's no upstream
# (first push of a new branch).
if git rev-parse --abbrev-ref --symbolic-full-name @{upstream} >/dev/null 2>&1; then
  UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name @{upstream})
  RANGE="${UPSTREAM}..HEAD"
else
  RANGE="origin/main..HEAD"
fi

CHANGED=$(git diff --name-only "$RANGE" 2>/dev/null || true)

# Nothing to push or empty diff — let git handle it.
if [ -z "$CHANGED" ]; then
  exit 0
fi

# ──────────────────────────────────────────────────────────────────────────
# File-type detection
# ──────────────────────────────────────────────────────────────────────────
BS_FILES=$(echo "$CHANGED" | grep -E '\.(bs|brs)$' || true)
TRANSLATION_TRIGGERS=$(echo "$CHANGED" | grep -E '^(source|components)/.*\.bs$|^locale/|^settings/settings\.json$' || true)
HAS_VALIDATE_TRIGGERS=$(echo "$CHANGED" | grep -qE '\.(bs|brs|xml)$|^bsconfig.*\.json$' && echo 1 || true)
HAS_MD=$(echo "$CHANGED" | grep -qE '\.md$' && echo 1 || true)
HAS_JSON=$(echo "$CHANGED" | grep -qE '\.json$' && echo 1 || true)
HAS_ARCH_DOCS=$(echo "$CHANGED" | grep -qE '^docs/(architecture/.*\.md$|decisions\.md$)' && echo 1 || true)

# ──────────────────────────────────────────────────────────────────────────
# Auto-fix steps (mutate files; combined into one commit at the end)
# ──────────────────────────────────────────────────────────────────────────
if [ -n "$BS_FILES" ] || [ -n "$TRANSLATION_TRIGGERS" ]; then
  if ! git diff-index --quiet HEAD --; then
    echo "⚠️  Working tree has uncommitted changes; skipping auto-fix steps."
    echo "   Commit or stash them, then re-push to enable auto-fix."
  else
    if [ -n "$BS_FILES" ]; then
      FILE_COUNT=$(echo "$BS_FILES" | wc -l)
      echo "🎨 Formatting $FILE_COUNT BS/BRS file(s) in push range..."
      echo "$BS_FILES" | xargs npx bsfmt --write
    fi

    if [ -n "$TRANSLATION_TRIGGERS" ]; then
      echo "🌐 Updating translations..."
      npm run update-translations
    fi

    if ! git diff --quiet; then
      echo "📝 Auto-fix made changes — creating combined commit..."
      git add -A
      git commit -m "chore: auto-fix via pre-push hook"
      echo "✅ Auto-fix commit added; push will include it."
    fi
  fi
fi

# ──────────────────────────────────────────────────────────────────────────
# Check steps (read-only; abort push on failure)
# ──────────────────────────────────────────────────────────────────────────
if [ -n "$HAS_VALIDATE_TRIGGERS" ]; then
  echo "🔍 Validating BrighterScript project..."
  npm run validate
fi

if [ -n "$HAS_MD" ]; then
  echo "📖 Linting markdown..."
  npm run lint:markdown
  echo "🔤 Spell-checking markdown..."
  npm run lint:spelling
fi

if [ -n "$HAS_JSON" ]; then
  echo "📋 Linting JSON..."
  npm run lint:json
fi

if [ -n "$HAS_ARCH_DOCS" ]; then
  echo "📚 Validating architecture doc references..."
  npm run lint:docs
fi
