#!/usr/bin/env sh
# Pre-push hook: project-wide / cross-cutting checks that don't fit at
# pre-commit time. File-scoped lint + format runs in pre-commit (lint-staged,
# see .lintstagedrc.cjs).
#
# Auto-fix steps (mutate files; combined into one auto-fix commit at the end):
#   1. npm run update-translations  if BS source / locale / settings/settings.json changed
#                                    (regens translation key constants from en_US.json)
#   2. npm run docs:dev-index       if docs/dev/*.md changed
#                                    (regens dev-guides index in docs/architecture/README.md)
#
# Check steps (read-only; non-zero exit aborts the push):
#   3. npm run validate           — *.bs / *.brs / *.xml / bsconfig*.json
#                                    (full BSC project compile — can't be file-scoped)
#   4. npm run lint:bs            — *.bs / *.brs (bslint; needs full project context)
#   5. npm run lint:language-coverage — when language-coverage triggers changed
#   5b. npm run lint:issue-templates — when .github/ISSUE_TEMPLATE/* changed
#                                    (validates against GitHub issue-forms schema;
#                                    GitHub silently hides invalid templates)
#   6. npm run lint:js            — *.js / *.cjs / *.mjs (eslint, project-wide)
#   7. npm run check-formatting:js — *.js / *.cjs / *.mjs / *.json
#                                     (Prettier check; auto-fix already ran in pre-commit)
#   8. npm run test:scripts       — *.js / *.cjs / *.mjs (vitest unit tests)
#   9. npm run lint:docs          — ALWAYS. Validates related-files: paths and
#                                    markdown links across every doc + CLAUDE.md.
#                                    Cross-doc check; not file-scopable.
#  10. npm run docs:dev-index:check — ALWAYS. Drift check on the auto-generated
#                                     dev-guides table.
#  11. node scripts/lint/decision-shape-nudge.cjs — ALWAYS. Advisory only
#                                    (always exit 0). Pattern-matches commit
#                                    messages for decision-shape language and
#                                    nudges toward /log decision when the
#                                    range doesn't touch docs/decisions.md.
#  12. node scripts/lint/progress-cursor-nudge.cjs — ALWAYS. Advisory only
#                                    (always exit 0). Flags stale progress.md
#                                    and Currently-running cursors that look
#                                    shipped (token overlap with recent commit
#                                    subjects). Mid-session safety net for the
#                                    post-merge journal-sync workflow.
#
# Auto-fix is skipped (with a warning) when the working tree is dirty so WIP
# can't be swept into the auto-fix commit. Check steps still run.
#
# What's NOT here (handled in pre-commit / lint-staged):
#   - bsfmt --write / --check on .bs/.brs (file-scoped)
#   - markdownlint --fix on .md (file-scoped)
#   - spellchecker on .md (file-scoped)
#   - jshint on .json (file-scoped)
#   - eslint --fix on *.js / *.cjs / *.mjs (file-scoped, auto-fix)
#   - prettier --write on *.js / *.cjs / *.mjs / *.json (file-scoped, auto-fix)
#
# Bypass with `git push --no-verify` if you absolutely need to skip — CI
# still runs everything.

set -e

# Determine the push range. Fall back to origin/main when there's no upstream
# (first push of a new branch).
if git rev-parse --abbrev-ref --symbolic-full-name @{upstream} >/dev/null 2>&1; then
  UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name @{upstream})
  RANGE="${UPSTREAM}..HEAD"
else
  RANGE="origin/main..HEAD"
fi

CHANGED=$(git diff --name-only "$RANGE" 2>/dev/null || true)

# Nothing to push or empty diff — let git handle it.
if [ -z "$CHANGED" ]; then
  exit 0
fi

# ──────────────────────────────────────────────────────────────────────────
# File-type detection
# ──────────────────────────────────────────────────────────────────────────
HAS_VALIDATE_TRIGGERS=$(echo "$CHANGED" | grep -qE '\.(bs|brs|xml)$|^bsconfig.*\.json$' && echo 1 || true)
HAS_BS=$(echo "$CHANGED" | grep -qE '\.(bs|brs)$' && echo 1 || true)
HAS_DEV_DOCS=$(echo "$CHANGED" | grep -qE '^docs/dev/.*\.md$' && echo 1 || true)
TRANSLATION_TRIGGERS=$(echo "$CHANGED" | grep -E '^(source|components)/.*\.bs$|^locale/|^settings/settings\.json$' || true)
HAS_LANGUAGE_TRIGGERS=$(echo "$CHANGED" | grep -qE '^source/utils/(languages|mediaDisplayTitle)\.bs$|^locale/custom/en_US\.json$|^scripts/lint/language-coverage\.cjs$' && echo 1 || true)
HAS_ISSUE_TEMPLATES=$(echo "$CHANGED" | grep -qE '^\.github/ISSUE_TEMPLATE/|^scripts/lint/issue-templates-check\.cjs$|^scripts/lint/issue-forms\.schema\.json$' && echo 1 || true)
HAS_JS=$(echo "$CHANGED" | grep -qE '\.(js|cjs|mjs)$' && echo 1 || true)
HAS_JSON_OR_JS=$(echo "$CHANGED" | grep -qE '\.(js|cjs|mjs|json)$' && echo 1 || true)
HAS_ICON_SOURCES=$(echo "$CHANGED" | grep -qE '^resources/icons/.*\.svg$|^resources/(icons/icons|placeholders/placeholders)\.json$|^scripts/generate/icons-build\.js$' && echo 1 || true)

# ──────────────────────────────────────────────────────────────────────────
# Auto-fix steps (project-wide regens; combined into one commit at the end)
# ──────────────────────────────────────────────────────────────────────────
if [ -n "$TRANSLATION_TRIGGERS" ] || [ -n "$HAS_DEV_DOCS" ] || [ -n "$HAS_ICON_SOURCES" ]; then
  if ! git diff-index --quiet HEAD --; then
    echo "⚠️  Working tree has uncommitted changes; skipping auto-fix steps."
    echo "   Commit or stash them, then re-push to enable auto-fix."
  else
    if [ -n "$TRANSLATION_TRIGGERS" ]; then
      echo "🌐 Updating translations..."
      npm run update-translations
    fi

    if [ -n "$HAS_DEV_DOCS" ]; then
      echo "📑 Regenerating docs/dev/ index in architecture README..."
      npm run docs:dev-index
    fi

    if [ -n "$HAS_ICON_SOURCES" ]; then
      echo "🎨 Regenerating icon PNGs from SVG sources..."
      npm run icons:build
    fi

    if ! git diff --quiet; then
      echo "📝 Auto-fix made changes — creating combined commit..."
      git add -A
      git commit -m "chore: auto-fix via pre-push hook"
      echo "✅ Auto-fix commit added; push will include it."
    fi
  fi
fi

# ──────────────────────────────────────────────────────────────────────────
# Check steps (read-only; abort push on failure)
# ──────────────────────────────────────────────────────────────────────────
if [ -n "$HAS_VALIDATE_TRIGGERS" ]; then
  echo "🔍 Validating BrighterScript project..."
  npm run validate
fi

if [ -n "$HAS_BS" ]; then
  echo "🧹 Linting BrightScript (project-wide)..."
  npm run lint:bs
fi

if [ -n "$HAS_LANGUAGE_TRIGGERS" ]; then
  echo "🌍 Checking language coverage..."
  npm run lint:language-coverage
fi

if [ -n "$HAS_ISSUE_TEMPLATES" ]; then
  echo "📋 Validating GitHub issue-form templates..."
  npm run lint:issue-templates
fi

if [ -n "$HAS_JS" ]; then
  echo "🧹 Linting JS (eslint, project-wide)..."
  npm run lint:js
fi

if [ -n "$HAS_JSON_OR_JS" ]; then
  echo "💅 Checking Prettier formatting (JS + JSON)..."
  npm run check-formatting:js
fi

if [ -n "$HAS_JS" ]; then
  echo "🧪 Running JS unit tests (vitest)..."
  npm run test:scripts
fi

echo "📚 Validating doc references..."
npm run lint:docs

echo "📑 Checking dev-index drift..."
npm run docs:dev-index:check

if [ -n "$HAS_ICON_SOURCES" ]; then
  echo "🎨 Checking icon-asset drift..."
  npm run icons:check
fi

# Decision-shape commit nudge — advisory only, never blocks the push.
# Detects commits whose messages look like decisions (decided/switched-from/
# instead-of/etc.) but didn't touch docs/decisions.md; reminds the user to
# invoke /log decision in the same change set if the commit warrants it.
node scripts/lint/decision-shape-nudge.cjs || true

# Progress-cursor nudge — advisory only, never blocks the push.
# Surfaces when docs/progress.md is stale OR the Currently-running cursor
# overlaps with recent commit subjects (i.e. the work it tracks shipped but
# /done running was never invoked). Mechanical close-loop on PR merge ships
# via .github/workflows/journal-sync.yml; this nudge catches the gap when
# the user pushes from a feature branch before the merge fires.
node scripts/lint/progress-cursor-nudge.cjs --quiet || true
