{
  "files.associations": {
    "*.brs": "brightscript",
    "*.bs": "brighterscript",
    "*.ts": "xml",
    "manifest": "plaintext",
    ".claude/agents/*.md": "instructions",
    "CLAUDE.md": "instructions",
    ".github/copilot-instructions.md": "instructions",
    // Stop the markdownlint extension from flagging dotfiles whose first line
    // starts with '#'. None of these are markdown.
    ".prettierignore": "ignore",
    ".env": "properties",
    ".env.example": "properties",
  },
  "[xml]": {
    "editor.defaultFormatter": "redhat.vscode-xml",
  },
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
  },
  "markdownlint.lintWorkspaceGlobs": ["!tasks/**/*.md"],
  // Prettier (esbenp.prettier-vscode) formats JS and JSON on save, so the editor
  // matches the pre-commit hook and CI. It uses the repo's node_modules/prettier and
  // skips everything in .prettierignore (generated JSON, locale/, .bs/.xml/.md).
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "xml.format.maxLineWidth": 0,
  "editor.detectIndentation": false,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.formatOnSave": true,
  "brightscript.output.hyperlinkFormat": "FilenameAndFunction",
  "brightscript.bsdk": "node_modules/brighterscript",
  // Each project is a full copy of the app that the language server re-checks on
  // every save, so load only projects that surface diagnostics no other one does:
  // dev (every lint plugin) and all tests (the only one covering tests/). The
  // unit / integration configs are subsets of all tests. Prod's plugins are a
  // subset of dev's and CI builds it on every PR; flip `disabled` to check it live.
  "brightscript.projects": [
    {
      "path": "bsconfig.json",
      "name": "JellyRock dev",
    },
    {
      "path": "bsconfig-tests.json",
      "name": "All Unit Tests",
    },
    {
      "path": "bsconfig-prod.json",
      "name": "JellyRock prod",
      "disabled": true,
    },
  ],
  "search.exclude": {
    "**/.git": true,
    "**/node_modules/**": true,
    "locale/**": true,
    "locale/custom/en_US.json": false,
    "scripts/**": true,
    "build/**": true,
    "out/**": true,
    ".vscode/settings.json": true,
    "package-lock.json": true,
    "renovate.json": true,
  },
  "brightscriptcomment.addExtraAtStartAndEnd": false,
  "debug.onTaskErrors": "showErrors",
}
