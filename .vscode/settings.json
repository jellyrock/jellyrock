{
  "files.associations": {
    "*.brs": "brightscript",
    "*.bs": "brighterscript",
    "*.ts": "xml",
    "manifest": "plaintext",
    ".claude/agents/*.md": "instructions",
    "CLAUDE.md": "instructions",
    ".github/copilot-instructions.md": "instructions"
  },
  "[xml]": {
    "editor.defaultFormatter": "redhat.vscode-xml"
  },
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
  },
  "markdownlint.lintWorkspaceGlobs": [
    "!tasks/**/*.md"
  ],
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "xml.format.maxLineWidth": 0,
  "editor.detectIndentation": false,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.formatOnSave": true,
  "brightscript.output.hyperlinkFormat": "FilenameAndFunction",
  "brightscript.bsdk": "1.0.0-alpha.50",
  "brightscript.projects": [
    {
      "path": "bsconfig.json",
      "name": "JellyRock dev"
    },
    {
      "path": "bsconfig-prod.json",
      "name": "JellyRock prod"
    },
    {
      "path": "bsconfig-tests.json",
      "name": "All Unit Tests"
    },
    {
      "path": "bsconfig-tests-unit.json",
      "name": "Unit tests (no integration)"
    },
    {
      "path": "bsconfig-tests-integration.json",
      "name": "Integration Unit tests"
    }
  ],
  "search.exclude": {
    "**/.git": true,
    "**/node_modules/**": true,
    "locale/**": true,
    "locale/custom/en_US.json": false,
    "scripts/**": true,
    "build/**": true,
    "out/**": true,
    ".vscode/settings.json": true,
    "package-lock.json": true,
    "renovate.json": true
  },
  "brightscriptcomment.addExtraAtStartAndEnd": false,
  "debug.onTaskErrors": "showErrors"
}