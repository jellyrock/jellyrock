namespace tests

  ' LIBRARY_TAB_MIGRATION_VERSION: each library's saved view (`display.<id>.landing`)
  ' becomes its default tab (`display.<id>.defaultTab`) unless it is a library type's own
  ' default, the two movie views also imply that view's layout (`display.<id>.layout_movies`),
  ' and `landing` is deleted. Run against real `test-` registry sections.
  @suite("Library Tab Migration - v3.3.2 Migration")
  @tags("migration")
  class LibraryTabMigrationTests extends tests.BaseTestSuite

    protected override sub setup()
      m.needsRegistrySetup = true
      super.setup()
    end sub

    ' A user section the runner will migrate: it needs serverId, and a LastRunVersion
    ' below the migration's.
    private function userSection(testUserId as string, lastRunVersion = "3.3.1" as string) as object
      reg = CreateObject("roRegistrySection", testUserId)
      reg.write("serverId", m.global.server.id)
      reg.write("LastRunVersion", lastRunVersion)
      return reg
    end function

    private function readAll(testUserId as string) as object
      reg = CreateObject("roRegistrySection", testUserId)
      values = {}
      for each key in reg.GetKeyList()
        values[key] = reg.read(key)
      end for
      return values
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("rewriting the saved view")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("migrates every view name the presenters saved, one library each")
    function _()
      testUserId = "test-library-tab-001"
      legacy = {
        "lib-movies-presentation": ["Movies", "movies", "presentation"],
        "lib-movies-grid": ["MoviesGrid", "movies", "comfortable"],
        "lib-studios": ["Studios", "studios", ""],
        "lib-genres": ["Genres", "genres", ""],
        "lib-collections": ["Collections", "collections", ""],
        "lib-shows": ["Shows", "shows", ""],
        "lib-networks": ["Networks", "networks", ""],
        "lib-album-artists": ["AlbumArtistsGrid", "albumartists", ""],
        "lib-albums": ["Albums", "albums", ""],
        "lib-artists": ["ArtistsGrid", "artists", ""],
        "lib-channels": ["livetv", "channels", ""],
        "lib-guide": ["tvGuide", "guide", ""],
        "lib-single-photo": ["singlephoto", "photos", ""],
        "lib-slideshow-photo": ["slideshowphoto", "photos", ""],
        "lib-random-photo": ["randomphoto", "photos", ""]
      }

      reg = m.userSection(testUserId)
      for each libraryId in legacy
        reg.write(`display.${libraryId}.landing`, legacy[libraryId][0])
      end for
      reg.flush()

      migrateLibraryTabs(CreateObject("roRegistrySection", testUserId), testUserId)

      reg = CreateObject("roRegistrySection", testUserId)
      typeDefaults = { movies: true, shows: true, albumartists: true, channels: true, photos: true }
      for each libraryId in legacy
        expected = legacy[libraryId]
        m.assertFalse(reg.exists(`display.${libraryId}.landing`), `${expected[0]}: landing is deleted`)
        if typeDefaults.DoesExist(expected[1])
          m.assertFalse(reg.exists(`display.${libraryId}.defaultTab`), `${expected[0]} is a type default: no default tab`)
        else
          m.assertEqual(reg.read(`display.${libraryId}.defaultTab`), expected[1], `${expected[0]} becomes the default tab`)
        end if
        if expected[2] = ""
          m.assertFalse(reg.exists(`display.${libraryId}.layout_${expected[1]}`), `${expected[0]} implies no layout`)
        else
          m.assertEqual(reg.read(`display.${libraryId}.layout_${expected[1]}`), expected[2], `${expected[0]} implies its layout`)
        end if
      end for
    end function

    @it("removes a folder's default view, which names no tab")
    function _()
      testUserId = "test-library-tab-002"
      reg = m.userSection(testUserId)
      reg.write("display.lib-folder.landing", "default")
      reg.write("display.lib-folder.sortField", "SortName")
      reg.flush()

      migrateLibraryTabs(CreateObject("roRegistrySection", testUserId), testUserId)

      reg = CreateObject("roRegistrySection", testUserId)
      m.assertFalse(reg.exists("display.lib-folder.landing"))
      m.assertFalse(reg.exists("display.lib-folder.defaultTab"))
      m.assertEqual(reg.read("display.lib-folder.sortField"), "SortName", "the folder's other settings stay")
    end function

    @it("keeps a value it does not recognize as the default tab")
    ' The grid's resolveView falls back from it at load, without overwriting it.
    function _()
      testUserId = "test-library-tab-003"
      reg = m.userSection(testUserId)
      reg.write("display.lib-1.landing", "SomethingNewer")
      reg.flush()

      migrateLibraryTabs(CreateObject("roRegistrySection", testUserId), testUserId)

      reg = CreateObject("roRegistrySection", testUserId)
      m.assertFalse(reg.exists("display.lib-1.landing"))
      m.assertEqual(reg.read("display.lib-1.defaultTab"), "SomethingNewer")
      m.assertFalse(reg.exists("display.lib-1.layout_movies"))
    end function

    @it("touches no other display setting")
    function _()
      testUserId = "test-library-tab-004"
      reg = m.userSection(testUserId)
      reg.write("display.lib-1.landing", "MoviesGrid")
      reg.write("display.lib-1.sortField", "DateCreated")
      reg.write("display.lib-1.sortAscending", "false")
      reg.write("display.lib-1.filter", "Favorites")
      reg.write("display.lib-1.filterOptions", "{}")
      reg.flush()

      migrateLibraryTabs(CreateObject("roRegistrySection", testUserId), testUserId)

      values = m.readAll(testUserId)
      m.assertEqual(values["display.lib-1.sortField"], "DateCreated")
      m.assertEqual(values["display.lib-1.sortAscending"], "false")
      m.assertEqual(values["display.lib-1.filter"], "Favorites")
      m.assertEqual(values["display.lib-1.filterOptions"], "{}")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("running more than once")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("changes nothing on a second run")
    ' A sideloaded build runs the user migrations at every launch.
    function _()
      testUserId = "test-library-tab-005"
      reg = m.userSection(testUserId)
      reg.write("display.lib-a.landing", "Movies")
      reg.write("display.lib-b.landing", "Shows")
      reg.write("display.lib-c.landing", "default")
      reg.write("display.lib-d.landing", "Genres")
      reg.write("displayLiveTvLanding", "guide")
      reg.flush()

      migrateLibraryTabs(CreateObject("roRegistrySection", testUserId), testUserId)
      afterFirst = m.readAll(testUserId)
      migrateLibraryTabs(CreateObject("roRegistrySection", testUserId), testUserId)

      m.assertEqual(m.readAll(testUserId), afterFirst)
    end function

    @it("keeps a grid layout chosen after the migration")
    ' The trap: `movies` folded to lowercase reads the same as the old presentation view
    ' `Movies`, so a run that matched case-insensitively would put this library back into
    ' presentation on every launch of a sideloaded build.
    function _()
      testUserId = "test-library-tab-006"
      reg = m.userSection(testUserId)
      reg.write("display.lib-1.landing", "movies")
      reg.write("display.lib-1.layout_movies", "comfortable")
      reg.flush()

      migrateLibraryTabs(CreateObject("roRegistrySection", testUserId), testUserId)

      reg = CreateObject("roRegistrySection", testUserId)
      m.assertFalse(reg.exists("display.lib-1.landing"))
      m.assertFalse(reg.exists("display.lib-1.defaultTab"))
      m.assertEqual(reg.read("display.lib-1.layout_movies"), "comfortable")
    end function

    @it("writes the layout an old name implies over one already stored")
    ' A user who went back to an older build and picked Movies (Presentation) there:
    ' the old name is the latest choice.
    function _()
      testUserId = "test-library-tab-007"
      reg = m.userSection(testUserId)
      reg.write("display.lib-1.landing", "Movies")
      reg.write("display.lib-1.layout_movies", "comfortable")
      reg.flush()

      migrateLibraryTabs(CreateObject("roRegistrySection", testUserId), testUserId)

      reg = CreateObject("roRegistrySection", testUserId)
      m.assertFalse(reg.exists("display.lib-1.landing"))
      m.assertEqual(reg.read("display.lib-1.layout_movies"), "presentation")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("the default tab")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("lets a saved view win over a stored default tab")
    ' A downgrade, a view picked in the old Star dialog, then an upgrade: `landing` is
    ' the newer choice.
    function _()
      testUserId = "test-library-tab-013"
      reg = m.userSection(testUserId)
      reg.write("display.lib-1.landing", "Studios")
      reg.write("display.lib-1.defaultTab", "genres")
      reg.write("display.lib-2.landing", "MoviesGrid")
      reg.write("display.lib-2.defaultTab", "genres")
      reg.flush()

      migrateLibraryTabs(CreateObject("roRegistrySection", testUserId), testUserId)

      reg = CreateObject("roRegistrySection", testUserId)
      m.assertEqual(reg.read("display.lib-1.defaultTab"), "studios")
      m.assertFalse(reg.exists("display.lib-2.defaultTab"), "a type default picked last clears the choice")
    end function

    @it("keeps a stored default tab when no view is saved")
    function _()
      testUserId = "test-library-tab-014"
      reg = m.userSection(testUserId)
      reg.write("display.lib-1.defaultTab", "genres")
      reg.flush()

      migrateLibraryTabs(CreateObject("roRegistrySection", testUserId), testUserId)

      reg = CreateObject("roRegistrySection", testUserId)
      m.assertEqual(reg.read("display.lib-1.defaultTab"), "genres")
    end function

    @it("deletes the unused copy of the web's Live TV default tab")
    function _()
      testUserId = "test-library-tab-015"
      reg = m.userSection(testUserId)
      reg.write("displayLiveTvLanding", "guide")
      reg.flush()

      migrateLibraryTabs(CreateObject("roRegistrySection", testUserId), testUserId)

      reg = CreateObject("roRegistrySection", testUserId)
      m.assertFalse(reg.exists("displayLiveTvLanding"))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("the version gate")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("does not run for a section already on the migration's version")
    @params("3.3.2")
    @params("3.4.0")
    function _(lastRunVersion)
      testUserId = "test-library-tab-008"
      reg = m.userSection(testUserId, lastRunVersion)
      reg.write("display.lib-1.landing", "MoviesGrid")
      reg.flush()

      runRegistryUserMigrations([testUserId])

      reg = CreateObject("roRegistrySection", testUserId)
      m.assertEqual(reg.read("display.lib-1.landing"), "MoviesGrid")
      m.assertFalse(reg.exists("display.lib-1.layout_movies"))
    end function

    @it("runs for a section below the migration's version")
    @params("3.3.1")
    @params("2.13.0")
    function _(lastRunVersion)
      testUserId = "test-library-tab-009"
      reg = m.userSection(testUserId, lastRunVersion)
      reg.write("display.lib-1.landing", "MoviesGrid")
      reg.flush()

      runRegistryUserMigrations([testUserId])

      reg = CreateObject("roRegistrySection", testUserId)
      m.assertFalse(reg.exists("display.lib-1.landing"))
      m.assertEqual(reg.read("display.lib-1.layout_movies"), "comfortable")
    end function

    @it("follows the music view migration for a user from before it")
    ' MUSIC_VIEW_MIGRATION_VERSION turns ArtistsPresentation into ArtistsGrid first; this
    ' one then turns that into its libraryTab id. File order is version order.
    function _()
      testUserId = "test-library-tab-010"
      reg = m.userSection(testUserId, "1.9.0")
      reg.write("display.lib-1.landing", "ArtistsPresentation")
      reg.write("display.lib-2.landing", "AlbumArtistsPresentation")
      reg.flush()

      runRegistryUserMigrations([testUserId])

      reg = CreateObject("roRegistrySection", testUserId)
      m.assertEqual(reg.read("display.lib-1.defaultTab"), "artists")
      m.assertFalse(reg.exists("display.lib-2.defaultTab"), "Album Artists is music's own default")
      m.assertFalse(reg.exists("display.lib-1.landing"))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("more than one user")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("migrates each user's own views")
    function _()
      firstUser = "test-library-tab-011"
      secondUser = "test-library-tab-012"
      reg1 = m.userSection(firstUser)
      reg1.write("display.lib-shared.landing", "Movies")
      reg1.flush()
      reg2 = m.userSection(secondUser)
      reg2.write("display.lib-shared.landing", "MoviesGrid")
      reg2.flush()

      migrateLibraryTabs(CreateObject("roRegistrySection", firstUser), firstUser)
      migrateLibraryTabs(CreateObject("roRegistrySection", secondUser), secondUser)

      reg1 = CreateObject("roRegistrySection", firstUser)
      reg2 = CreateObject("roRegistrySection", secondUser)
      m.assertEqual(reg1.read("display.lib-shared.layout_movies"), "presentation")
      m.assertEqual(reg2.read("display.lib-shared.layout_movies"), "comfortable")
      m.assertFalse(reg1.exists("display.lib-shared.landing"))
      m.assertFalse(reg2.exists("display.lib-shared.landing"))
    end function

  end class

end namespace
