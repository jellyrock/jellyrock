
namespace tests

  @suite("SaveServerList() - Registry Integration")
  @tags("registry")
  class SavedServersRegistryTests extends tests.BaseTestSuite

    protected override sub setup()
      m.needsRegistrySetup = true
      super.setup()
    end sub

    protected override function beforeEach()
      super.beforeEach()
      ' Start each test with a clean saved_servers slate
      unsetSetting("saved_servers")
      unsetSetting("server")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("SaveServerList() - new entry")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("creates a new saved_servers list when none exists")
    function _()
      ' GIVEN: no existing saved_servers, server connected as user typed it
      setSetting("server", "test.jellyfin.local")

      ' WHEN
      SaveServerList()

      ' THEN: entry written with all expected fields
      saved = getSetting("saved_servers")
      m.assertNotInvalid(saved)
      parsed = ParseJson(saved)
      m.assertArrayCount(parsed.serverList, 1)

      entry = parsed.serverList[0]
      m.assertEqual(entry.id, "test-server-123")
      m.assertEqual(entry.name, "Test Jellyfin Server")
      m.assertEqual(entry.baseUrl, "https://test.jellyfin.local") ' canonical, lowercase
      m.assertEqual(entry.originalUrl, "test.jellyfin.local") ' user-entered from registry
    end function

    @it("appends a new entry when saved_servers has a different server")
    function _()
      ' GIVEN: an existing saved server with a different ID and URL
      existingList = FormatJson({
        serverList: [{
          id: "other-server-999",
          name: "Other Server",
          baseUrl: "http://192.168.1.50:8096",
          originalUrl: "192.168.1.50:8096",
          iconUrl: "pkg:/images/branding/logo-icon120.jpg",
          iconWidth: 120,
          iconHeight: 120
        }]
      })
      setSetting("saved_servers", existingList)
      setSetting("server", "test.jellyfin.local")

      ' WHEN
      SaveServerList()

      ' THEN: both entries present, original untouched
      saved = getSetting("saved_servers")
      parsed = ParseJson(saved)
      m.assertArrayCount(parsed.serverList, 2)

      ' existing entry unchanged
      first = parsed.serverList[0]
      m.assertEqual(first.id, "other-server-999")
      m.assertEqual(first.originalUrl, "192.168.1.50:8096")

      ' new entry appended correctly
      second = parsed.serverList[1]
      m.assertEqual(second.id, "test-server-123")
      m.assertEqual(second.name, "Test Jellyfin Server")
      m.assertEqual(second.originalUrl, "test.jellyfin.local")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("SaveServerList() - update existing entry")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("updates name and originalUrl in-place when ID matches")
    function _()
      ' GIVEN: stale saved entry for the same server (old name, old originalUrl)
      staleList = FormatJson({
        serverList: [{
          id: "test-server-123",
          name: "Old Server Name",
          baseUrl: "https://test.jellyfin.local",
          originalUrl: "old.url",
          iconUrl: "pkg:/images/branding/logo-icon120.jpg",
          iconWidth: 120,
          iconHeight: 120
        }]
      })
      setSetting("saved_servers", staleList)
      setSetting("server", "test.jellyfin.local")

      ' WHEN
      SaveServerList()

      ' THEN: name and originalUrl refreshed, no duplicate entry added
      saved = getSetting("saved_servers")
      parsed = ParseJson(saved)
      m.assertArrayCount(parsed.serverList, 1)

      entry = parsed.serverList[0]
      m.assertEqual(entry.name, "Test Jellyfin Server") ' updated
      m.assertEqual(entry.originalUrl, "test.jellyfin.local") ' updated
      m.assertEqual(entry.baseUrl, "https://test.jellyfin.local") ' unchanged
    end function

    @it("updates entry by URL when old entry has no id (backward compat)")
    function _()
      ' GIVEN: old-style saved entry without an id field
      oldStyleList = FormatJson({
        serverList: [{
          name: "Old Name",
          baseUrl: "https://test.jellyfin.local",
          iconUrl: "pkg:/images/branding/logo-icon120.jpg",
          iconWidth: 120,
          iconHeight: 120
        }]
      })
      setSetting("saved_servers", oldStyleList)
      setSetting("server", "test.jellyfin.local")

      ' WHEN
      SaveServerList()

      ' THEN: entry updated in-place (not duplicated), id and originalUrl now populated
      saved = getSetting("saved_servers")
      parsed = ParseJson(saved)
      m.assertArrayCount(parsed.serverList, 1)

      entry = parsed.serverList[0]
      m.assertEqual(entry.id, "test-server-123")
      m.assertEqual(entry.name, "Test Jellyfin Server")
      m.assertEqual(entry.originalUrl, "test.jellyfin.local")
    end function

    @it("matches existing entry by ID even when baseUrl differs (e.g. HTTP->HTTPS upgrade)")
    function _()
      ' GIVEN: server previously saved under HTTP, now connected via HTTPS (same server ID)
      oldHttpList = FormatJson({
        serverList: [{
          id: "test-server-123",
          name: "Test Jellyfin Server",
          baseUrl: "http://test.jellyfin.local",
          originalUrl: "test.jellyfin.local",
          iconUrl: "pkg:/images/branding/logo-icon120.jpg",
          iconWidth: 120,
          iconHeight: 120
        }]
      })
      setSetting("saved_servers", oldHttpList)
      ' User is now connecting via HTTPS (canonical URL updated on global server node)
      m.global.server.serverUrl = "https://test.jellyfin.local"
      setSetting("server", "test.jellyfin.local")

      ' WHEN
      SaveServerList()

      ' THEN: no duplicate — same entry updated in-place with the new canonical baseUrl
      saved = getSetting("saved_servers")
      parsed = ParseJson(saved)
      m.assertArrayCount(parsed.serverList, 1)

      entry = parsed.serverList[0]
      m.assertEqual(entry.id, "test-server-123")
      m.assertEqual(entry.originalUrl, "test.jellyfin.local")
      m.assertEqual(entry.baseUrl, "https://test.jellyfin.local") ' canonical URL must be updated
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("SaveServerList() - originalUrl sourcing")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("stores user-entered originalUrl distinct from canonical baseUrl")
    function _()
      ' GIVEN: user typed bare address; server.UpdateURL normalised it to https://
      setSetting("server", "myserver:8096") ' what the user typed
      m.global.server.serverUrl = "http://myserver:8096" ' what got canonicalised

      ' WHEN
      SaveServerList()

      ' THEN: baseUrl is canonical (lowercase, with scheme); originalUrl is what user typed
      saved = getSetting("saved_servers")
      parsed = ParseJson(saved)
      entry = parsed.serverList[0]
      m.assertEqual(entry.baseUrl, "http://myserver:8096")
      m.assertEqual(entry.originalUrl, "myserver:8096")
      m.assertNotEqual(entry.baseUrl, entry.originalUrl)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("DeleteFromServerList()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("deletes entry by server ID")
    function _()
      ' GIVEN: two saved servers
      list = FormatJson({
        serverList: [
          { id: "test-server-123", name: "Test Server", baseUrl: "https://test.jellyfin.local", iconUrl: "pkg:/images/branding/logo-icon120.jpg", iconWidth: 120, iconHeight: 120 },
          { id: "other-server-999", name: "Other Server", baseUrl: "http://192.168.1.50:8096", iconUrl: "pkg:/images/branding/logo-icon120.jpg", iconWidth: 120, iconHeight: 120 }
        ]
      })
      setSetting("saved_servers", list)

      ' WHEN: delete by id
      DeleteFromServerList("test-server-123")

      ' THEN: only the other server remains
      saved = getSetting("saved_servers")
      parsed = ParseJson(saved)
      m.assertArrayCount(parsed.serverList, 1)
      m.assertEqual(parsed.serverList[0].id, "other-server-999")
    end function

    @it("deletes by ID even when caller passes the SSDP baseUrl that differs from saved baseUrl")
    function _()
      ' GIVEN: server saved under HTTPS but SSDP discovered it under HTTP (same server ID).
      ' The picker item's baseUrl is the SSDP HTTP URL; deletion must still remove the entry.
      list = FormatJson({
        serverList: [{
          id: "test-server-123",
          name: "Test Server",
          baseUrl: "https://test.jellyfin.local", ' saved canonical URL
          iconUrl: "pkg:/images/branding/logo-icon120.jpg",
          iconWidth: 120,
          iconHeight: 120
        }]
      })
      setSetting("saved_servers", list)

      ' WHEN: delete using the ID (as the delete trigger now does)
      DeleteFromServerList("test-server-123")

      ' THEN: entry is removed despite URL mismatch
      saved = getSetting("saved_servers")
      parsed = ParseJson(saved)
      m.assertArrayCount(parsed.serverList, 0)
    end function

    @it("deletes entry by baseUrl when no id present (legacy backward compat)")
    function _()
      ' GIVEN: old-style entry without an id field
      list = FormatJson({
        serverList: [{
          name: "Old Server",
          baseUrl: "http://192.168.1.100:8096",
          iconUrl: "pkg:/images/branding/logo-icon120.jpg",
          iconWidth: 120,
          iconHeight: 120
        }]
      })
      setSetting("saved_servers", list)

      ' WHEN: delete by canonical baseUrl (legacy path)
      DeleteFromServerList("http://192.168.1.100:8096")

      ' THEN: entry removed
      saved = getSetting("saved_servers")
      parsed = ParseJson(saved)
      m.assertArrayCount(parsed.serverList, 0)
    end function

    @it("falls back to canonical baseUrl for originalUrl when registry server key is missing")
    function _()
      ' GIVEN: no "server" key in registry (edge case — e.g. first-ever run after upgrade)
      ' Do not call setSetting("server", ...) here

      ' WHEN
      SaveServerList()

      ' THEN: originalUrl falls back to canonical serverUrl (no crash, graceful)
      saved = getSetting("saved_servers")
      parsed = ParseJson(saved)
      entry = parsed.serverList[0]
      m.assertNotInvalid(entry.originalUrl)
      m.assertNotEqual(entry.originalUrl, "")
    end function

  end class

end namespace
