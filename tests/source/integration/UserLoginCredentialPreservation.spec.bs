namespace tests

  @suite("user.Login - Credential preservation across registry-load")
  class UserLoginCredentialPreservationTests extends tests.BaseTestSuite

    protected override sub setup()
      ' Registry setup is required: this suite seeds stale credentials into
      ' a per-user registry section to reproduce the Quick Connect re-auth
      ' scenario where a freshly-issued AccessToken must NOT be clobbered by
      ' a previously-saved value in the registry.
      m.needsRegistrySetup = true
      super.setup()
    end sub

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Registry-load loop must not clobber auth-flow values")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("preserves freshly-issued authToken when registry holds a stale one")
    ' Reproduces the Quick Connect re-auth bug: the user has saved credentials
    ' from a previous session, picks Quick Connect again, and the server issues
    ' a new AccessToken. AuthenticateViaQuickConnect sets userNode.authToken to
    ' the new token; user.Login() must not overwrite it with the old registry
    ' value, or every subsequent API call returns 401.
    function _()
      testUserId = "test-credential-preservation-authtoken"
      staleToken = "OLD_REGISTRY_TOKEN"
      freshToken = "FRESH_AUTH_FLOW_TOKEN"

      ' Pre-populate registry with the stale token under this user's section.
      registryWrite("authToken", staleToken, testUserId)

      ' Simulate the post-AuthenticateViaQuickConnect state: id set, fresh
      ' token in memory, ready to call user.Login() with AboutMe-shape data.
      userNode = m.getTestUser()
      userNode.id = testUserId
      userNode.authToken = freshToken

      aboutMeData = {
        id: testUserId,
        Name: "Test User"
      }

      user.Login(aboutMeData, false)

      m.assertEqual(userNode.authToken, freshToken, "Fresh auth-flow token must survive registry-load")
      m.assertNotEqual(userNode.authToken, staleToken, "Stale registry token must not have been re-applied")
    end function

    @it("preserves freshly-issued primaryImageTag when registry holds a stale one")
    ' Same shape of bug for primaryImageTag — server is authoritative for the
    ' user's profile image; a stale registry value must not override the
    ' fresh value supplied by the auth-flow caller.
    function _()
      testUserId = "test-credential-preservation-imagetag"
      staleTag = "OLD_REGISTRY_IMAGE_TAG"
      freshTag = "FRESH_AUTH_FLOW_IMAGE_TAG"

      registryWrite("primaryImageTag", staleTag, testUserId)

      userNode = m.getTestUser()
      userNode.id = testUserId
      userNode.authToken = "any-token"
      userNode.primaryImageTag = freshTag

      aboutMeData = {
        id: testUserId,
        Name: "Test User",
        PrimaryImageTag: freshTag
      }

      user.Login(aboutMeData, false)

      m.assertEqual(userNode.primaryImageTag, freshTag, "Fresh primaryImageTag must survive registry-load")
    end function

  end class

end namespace
