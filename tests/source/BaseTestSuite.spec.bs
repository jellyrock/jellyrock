import "pkg:/source/utils/translate.bs"

namespace tests

  class BaseTestSuite extends rooibos.BaseTestSuite
    private appController

    ' Test suites that need registry access (integration tests) should set this to true
    ' This prevents unnecessary file I/O in unit tests for better performance
    protected needsRegistrySetup = false as boolean

    protected override sub setup()
      ' Initialize m.global if not already initialized
      if not isValid(m.global)
        ' In test environment, m.global needs to be created from a scene
        ' Try to get it from the test scene if available
        m.global = m.top?.getGlobalNode()
        if not isValid(m.global)
          ' Cannot continue without m.global
          throw "Failed to initialize m.global"
        end if
      end if

      ' Populate GetGlobalAA().global so classes can access m.global
      GetGlobalAA().global = m.global

      ' ===================================================================
      ' Use ACTUAL main app initialization functions
      ' This ensures tests use identical global state as production
      ' ===================================================================

      try
        ' Initialize global constants, app info, and device info
        ' This creates: m.global.appLoaded, m.global.constants, m.global.app, m.global.device
        '
        ' Once per test session, not once per group. Rooibos runs setup() for every
        ' @describe group, and setGlobals() writes only through m.global.addFields, which
        ' leaves an existing field's value untouched — so every call after the first built
        ' nodes and read device/app info only to throw them away. `device` is its last
        ' write, so a call that threw partway still retries in the next group.
        if not m.global.doesExist("device")
          setGlobals()
          ' Save the device node's fields once per run, so resetDevice() can restore
          ' them. This lives on m.global because every suite is a new BaseTestSuite
          ' instance. The catch fallback makes device a plain AA, which needs no reset.
          localDevice = m.global.device
          if type(localDevice) = "roSGNode" and not m.global.doesExist("testDeviceSnapshot")
            m.global.addFields({ testDeviceSnapshot: localDevice.getFields() })
          end if
        end if
        ' Load en_US translations so component tests get resolved strings. This one DOES
        ' reset per group (setFields overwrites): translate.spec.bs installs its own
        ' translations, and reloading here is what stops them leaking into the next suite.
        ' (mirrors Main.bs which calls loadTranslations() right after setGlobals())
        loadTranslations("en_US")
      catch e
        ' If setGlobals() fails (e.g., roAppInfo/roDeviceInfo not available in test env),
        ' create minimal mock data to allow tests to run
        if not m.global.doesExist("constants")
          m.global.addFields({
            appLoaded: false,
            constants: {
              colors: {
                primary: "0x8b5cf6FF",
                secondary: "0x3b82f6FF",
                text_primary: "0xf0f0f0FF"
              },
              font_sizes: {
                medium: 32
              }
            },
            app: {
              id: "test-app",
              isDev: true,
              version: "0.0.0",
              lastRunVersion: ""
            },
            device: {
              id: "test-device",
              name: "Test Device",
              videoHeight: "1080",
              videoWidth: "1920"
            }
          })
        end if
      end try

      ' Initialize flat global structure with content nodes
      ' Note: We don't call user.settings.SaveDefaults() directly because it
      ' reads from settings.json and registry, which may fail in test environment
      ' IMPORTANT: Use addField (singular) then assign, not addFields with value
      ' This ensures the node is referenced, not copied
      if not m.global.doesExist("server")
        m.global.addField("server", "node", false)
        m.global.server = CreateObject("roSGNode", "JellyfinServer")
      end if

      if not m.global.doesExist("user")
        m.global.addField("user", "node", false)
        userNode = CreateObject("roSGNode", "JellyfinUser")
        settingsNode = CreateObject("roSGNode", "JellyfinUserSettings")
        userNode.settings = settingsNode
        m.global.user = userNode
      end if

      ' Create MockSceneManager for tests that call scene navigation functions
      ' This prevents crashes when code calls m.global.sceneManager.callFunc(...)
      ' Using MockSceneManager which has all interface functions but no-ops
      if not m.global.doesExist("sceneManager")
        m.global.addField("sceneManager", "node", false)
        m.global.sceneManager = CreateObject("roSGNode", "MockSceneManager")
      end if

      ' ===================================================================
      ' Override with test-specific mock data
      ' Reset the shared global nodes to their XML defaults every setup, so one
      ' test's writes never leak into the next, then apply the mock JSON the way
      ' a signed-in session would leave it. Configuration and Policy go through
      ' the same SessionDataTransformer methods user.Login() uses.
      ' ===================================================================

      ' Load mock server data
      mockServerData = MockDataLoader.LoadServer("default")
      if isValid(mockServerData)
        ' Get local reference to minimize rendezvous
        localServer = m.global.server
        nodeUtils.resetNodeToDefaults(localServer, "JellyfinServer", [])
        localServer.setFields({
          id: mockServerData.id ?? "",
          name: mockServerData.name ?? "",
          version: mockServerData.version ?? "",
          productName: mockServerData.productName ?? "",
          serverUrl: mockServerData.serverUrl ?? "",
          localURL: mockServerData.localURL ?? "",
          isHTTPS: mockServerData.isHTTPS ?? false,
          isLocalHTTPS: mockServerData.isLocalHTTPS ?? false,
          isStartupWizardCompleted: mockServerData.startupWizardCompleted ?? false,
          isLoaded: true,
          isConnected: true,
          lastConnected: CreateObject("roDateTime").AsSeconds()
        })
      end if

      ' Load mock user data
      mockUserData = MockDataLoader.LoadUser("default")
      if isValid(mockUserData)
        ' Get local reference to minimize rendezvous
        localUser = m.global.user
        ' Keep the settings node created above
        nodeUtils.resetNodeToDefaults(localUser, "JellyfinUser", ["settings"])
        transformer = new SessionDataTransformer()
        localUser.setFields({
          id: mockUserData.id ?? "",
          name: mockUserData.name ?? "",
          config: transformer.transformUserConfiguration(mockUserData.Configuration),
          policy: transformer.transformUserPolicy(mockUserData.Policy),
          isLoaded: true,
          loadedAt: CreateObject("roDateTime").AsSeconds()
        })
      end if

      ' Put the device node back to its startup fields, so a test that wrote locale or
      ' called loadTestDevice() never leaks into the next group or suite.
      m.resetDevice()

      ' Initialize roku-log if not already initialized
      ' The roku-log-bsc-plugin should auto-initialize, but we ensure it exists
      if isValid(m.global) and not isValid(m.global.rLog)
        ' Create a proper log_Log component for roku-log
        rLog = CreateObject("roSGNode", "log_Log")
        if isValid(rLog)
          ' Set up minimal transport (PrintTransport for console output)
          rLog.transportTypes = ["log_PrintTransport"]
          rLog.logLevel = 3 ' VERBOSE level (0=ERROR, 1=WARN, 2=INFO, 3=VERBOSE, 4=DEBUG)
          rLog.enabled = true
          rLog.isFiltering = false
          rLog.includeDate = false
          rLog.includeFilters = {}
          rLog.excludeFilters = {}
          rLog.logMode = 1
          rLog.transports = []

          ' Add to global
          m.global.addFields({ rLog: rLog })

          ' Add logIndent fields that roku-log expects
          if not m.global.doesExist("logIndent")
            m.global.addFields({ logIndent: 0 })
          end if
          if not m.global.doesExist("logIndentText")
            m.global.addFields({ logIndentText: "" })
          end if
        end if
      end if
    end sub

    protected override function beforeEach()
      ' Undo what the previous test did to m.global.device. setup() resets it per
      ' group, and this covers every test inside a group.
      m.resetDevice()

      ' Reset or verify server state before each test if needed
      ' This ensures tests don't interfere with each other
      if isValid(m.global) and isValid(m.global.server)
        ' Ensure server URL is always valid for image URL generation
        ' Reload from JSON if somehow lost during test (e.g., if test-global was cleaned)
        if not isValidAndNotEmpty(m.global.server.serverUrl)
          mockServer = MockDataLoader.LoadServer("default")
          if isValid(mockServer) and isValid(mockServer.serverUrl)
            m.global.server.serverUrl = mockServer.serverUrl
          end if
        end if
      end if

      ' Only run registry I/O for integration tests that explicitly need it
      if m.needsRegistrySetup
        ' Restore baseline test-global state needed for API requests
        ' This ensures each test starts with a clean but functional test-global section
        testGlobalReg = CreateObject("roRegistrySection", "test-global")
        if not testGlobalReg.exists("server") and isValid(m.global.server.serverUrl)
          ' Store server URL for API calls (mimics what production code does)
          testGlobalReg.write("server", m.global.server.serverUrl)
          testGlobalReg.flush()
        end if
      end if
    end function

    protected override function afterEach()
      ' Clean up any test-specific modifications
      ' Leave the base mock intact for other tests

      ' Only clean up registry data for integration tests that explicitly need it
      ' Unit tests should never write to registry, so no cleanup needed
      if m.needsRegistrySetup
        RegistryTestUtils.CleanupTestRegistrySections("test-")
      end if
    end function

    protected override sub teardown()
      ' Final cleanup after all tests in this suite complete
      ' Only clean up registry data for integration tests that explicitly need it
      if m.needsRegistrySetup
        RegistryTestUtils.CleanupTestRegistrySections("test-")
      end if
    end sub

    ' ===================================================================
    ' TYPE CHECK HELPERS
    ' Each BrightScript scalar has two equivalent runtime type names
    ' (boxed "ro*" vs unboxed). Numeric types also span Float/Double for
    ' the same semantic value. These helpers treat the whole equivalence
    ' class as a single logical type so assertions don't flake on
    ' legitimate numeric promotion or auto-boxing.
    ' ===================================================================

    protected function isStringType(value as dynamic) as boolean
      typeStr = type(value)
      return typeStr = "String" or typeStr = "roString"
    end function

    protected function isBooleanType(value as dynamic) as boolean
      typeStr = type(value)
      return typeStr = "Boolean" or typeStr = "roBoolean"
    end function

    protected function isIntegerType(value as dynamic) as boolean
      typeStr = type(value)
      return typeStr = "Integer" or typeStr = "roInteger" or typeStr = "roInt"
    end function

    protected function isFloatType(value as dynamic) as boolean
      typeStr = type(value)
      return typeStr = "Float" or typeStr = "roFloat" or typeStr = "Double" or typeStr = "roDouble"
    end function

    ' ===================================================================
    ' TEST HELPER METHODS
    ' Use these in individual tests to reset or access m.global safely
    ' ===================================================================

    ' Reset server to XML defaults
    protected function resetServer()
      localServer = m.global.server
      nodeUtils.resetNodeToDefaults(localServer, "JellyfinServer", [])
    end function

    ' Reset user to XML defaults (INCLUDING settings reset)
    protected function resetUser()
      localUser = m.global.user
      nodeUtils.resetNodeToDefaults(localUser, "JellyfinUser", [])

      ' Create fresh settings node
      freshSettings = CreateObject("roSGNode", "JellyfinUserSettings")
      localUser.settings = freshSettings
    end function

    ' Restore m.global.device to the fields saved in setup(): remove fields a test
    ' added, then set every saved field back in one call. Runs in setup() and
    ' beforeEach(), so a subclass that overrides beforeEach() without super still
    ' starts each group clean.
    protected function resetDevice() as void
      snapshot = m.global.testDeviceSnapshot
      if not isValid(snapshot) then return

      ' Get local reference to minimize rendezvous
      localDevice = m.global.device
      if type(localDevice) <> "roSGNode" then return

      extraFields = []
      for each fieldName in localDevice.getFields()
        if not snapshot.doesExist(fieldName) then extraFields.push(fieldName)
      end for
      if extraFields.count() > 0 then localDevice.removeFields(extraFields)

      localDevice.setFields(snapshot)
    end function

    ' Get local reference to server (minimizes rendezvous)
    protected function getTestServer() as object
      return m.global.server
    end function

    ' Get local reference to user (minimizes rendezvous)
    protected function getTestUser() as object
      return m.global.user
    end function

    ' Get local reference to user settings (minimizes rendezvous)
    protected function getTestUserSettings() as object
      return m.global.user.settings
    end function

    ' Load and apply a specific mock device configuration. The changes last until
    ' the next test: beforeEach() restores the device node.
    ' @param deviceName - Name of device mock file (e.g., "roku-en-us", "roku-es-mx")
    protected function loadTestDevice(deviceName as string) as void
      ' Load mock device data
      mockDeviceData = MockDataLoader.LoadDevice(deviceName)
      if not isValid(mockDeviceData)
        throw "Failed to load mock device: " + deviceName
      end if

      ' Get local reference to minimize rendezvous
      localDevice = m.global.device

      ' Separate existing fields from new fields for batch operations
      fieldsToUpdate = {}
      fieldsToAdd = {}

      for each key in mockDeviceData
        if localDevice.hasField(key)
          fieldsToUpdate[key] = mockDeviceData[key]
        else
          fieldsToAdd[key] = mockDeviceData[key]
        end if
      end for

      ' Batch update existing fields (single rendezvous)
      if fieldsToUpdate.Count() > 0
        localDevice.setFields(fieldsToUpdate)
      end if

      ' Batch add new fields (single rendezvous)
      if fieldsToAdd.Count() > 0
        localDevice.addFields(fieldsToAdd)
      end if
    end function

    ' ===================================================================
    ' REGISTRY LOAD HELPER
    ' ===================================================================

    ' Load a user's registry section into the settings node the way user.Login() does:
    ' a fresh JellyfinUserSettings node (auto-sync off, so loading writes nothing back),
    ' then each stored string that names a settings field through user.settings.Save(),
    ' which converts it to the field's type. Login's routing of other keys (globals,
    ' display.*, homeSection*, credentials) is not reproduced here.
    ' @param userId - Registry section to read
    ' @returns The loaded settings node (m.global.user.settings)
    protected function loadSettingsFromRegistry(userId as string) as object
      localUser = m.global.user
      localUser.settings = CreateObject("roSGNode", "JellyfinUserSettings")
      settingsNode = localUser.settings
      registryData = RegistryReadAll(userId)
      for each key in registryData
        if settingsNode.hasField(key) then user.settings.Save(key, registryData[key])
      end for
      return settingsNode
    end function

    ' ===================================================================
    ' DISPLAY SETTINGS TEST HELPERS
    ' ===================================================================

    ' Set a single display setting for testing
    ' This is the ONLY acceptable way to set individual settings in tests
    ' Uses proper ContentNode field access, not direct assignment
    protected function setTestDisplaySetting(libraryId as string, key as string, value as dynamic) as void
      localUser = m.global.user
      if not isValid(localUser) or not isValid(localUser.settings)
        throw "User not initialized in test"
      end if

      ' Get current displaySettings
      displaySettings = localUser.settings.displaySettings as roAssociativeArray
      if not isValid(displaySettings)
        displaySettings = {}
      end if

      ' Create library object if doesn't exist
      if not displaySettings.DoesExist(libraryId)
        displaySettings[libraryId] = {}
      end if

      ' Set value
      displaySettings[libraryId][key] = value

      ' Reassign to trigger observer
      localUser.settings.displaySettings = displaySettings
    end function

  end class
end namespace
