import "pkg:/source/remotecontrol/remoteProtocol.bs"

namespace tests

  ' Remote-control receiver: the transport-agnostic protocol helpers — the http-gate,
  ' the session-socket URL builder (must bind the same session as the REST API), reconnect
  ' backoff, and the client KeepAlive frame.
  @suite("remoteProtocol — protocol helpers")
  class RemoteProtocolTests extends tests.BaseTestSuite

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("isHttpServer() — the http-gate")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("accepts http:// (any case) and rejects everything else")
    @params("http://192.0.2.10:8098", true)
    @params("HTTP://192.0.2.10:8098", true)
    @params("https://jellyfin.example.com", false)
    @params("wss://x", false)
    @params("", false)
    @params(invalid, false)
    function _(serverUrl, expected)
      m.assertEqual(remoteProtocol.isHttpServer(serverUrl), expected)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("buildSocketUrl()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("builds the ws:// session-socket URL for an http server")
    function _()
      url = remoteProtocol.buildSocketUrl("http://192.0.2.10:8098", "tok123", "dev-abc")
      m.assertEqual(url, "ws://192.0.2.10:8098/socket?api_key=tok123&deviceId=dev-abc")
    end function

    @it("returns empty for an https server (never downgrades the token onto ws://)")
    function _()
      m.assertEqual(remoteProtocol.buildSocketUrl("https://jellyfin.example.com", "tok", "dev"), "")
    end function

    @it("returns empty when a credential is missing")
    function _()
      m.assertEqual(remoteProtocol.buildSocketUrl("http://x:8098", "", "dev"), "")
      m.assertEqual(remoteProtocol.buildSocketUrl("http://x:8098", "tok", ""), "")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("buildLongPollUrl() — HTTPS long-poll channel (no token in URL)")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("builds the poll URL with waitMs + the ack=1 opt-in flag, and carries no token")
    function _()
      url = remoteProtocol.buildLongPollUrl("https://jellyfin.example.com", 25000)
      m.assertEqual(url, "https://jellyfin.example.com/JellyRock/RemoteControl/poll?waitMs=25000&ack=1")
    end function

    @it("trims a single trailing slash so it never emits //")
    function _()
      url = remoteProtocol.buildLongPollUrl("https://jellyfin.example.com/", 25000)
      m.assertEqual(url, "https://jellyfin.example.com/JellyRock/RemoteControl/poll?waitMs=25000&ack=1")
    end function

    @it("appends the cumulative ackId when we have one to acknowledge")
    function _()
      url = remoteProtocol.buildLongPollUrl("https://jellyfin.example.com", 25000, "abc-123-guid")
      m.assertEqual(url, "https://jellyfin.example.com/JellyRock/RemoteControl/poll?waitMs=25000&ack=1&ackId=abc-123-guid")
    end function

    @it("omits ackId when it is blank/invalid (e.g. the first poll, nothing received yet)")
    @params("")
    @params(invalid)
    function _(ackId)
      url = remoteProtocol.buildLongPollUrl("https://jellyfin.example.com", 25000, ackId)
      m.assertEqual(url, "https://jellyfin.example.com/JellyRock/RemoteControl/poll?waitMs=25000&ack=1")
    end function

    @it("returns empty for a missing/blank server URL")
    @params("", 25000)
    @params(invalid, 25000)
    function _(serverUrl, waitMs)
      m.assertEqual(remoteProtocol.buildLongPollUrl(serverUrl, waitMs), "")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("buildProbeUrl() — plugin presence / version probe")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("builds the info URL under the plugin route prefix")
    @params("https://jellyfin.example.com", "https://jellyfin.example.com/JellyRock/RemoteControl/info")
    @params("https://jellyfin.example.com/", "https://jellyfin.example.com/JellyRock/RemoteControl/info")
    function _(serverUrl, expected)
      m.assertEqual(remoteProtocol.buildProbeUrl(serverUrl), expected)
    end function

    @it("returns empty for a missing/blank server URL")
    @params("", "")
    @params(invalid, "")
    function _(serverUrl, expected)
      m.assertEqual(remoteProtocol.buildProbeUrl(serverUrl), expected)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("parseContractVersion() — /info probe body gate")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("reads the integer contractVersion from a well-formed probe body")
    function _()
      body = FormatJson({ contractVersion: 1, pluginVersion: "0.1.0" })
      m.assertEqual(remoteProtocol.parseContractVersion(body), 1)
    end function

    @it("reads a higher version so the caller can refuse a mismatch")
    function _()
      body = FormatJson({ contractVersion: 2 })
      m.assertEqual(remoteProtocol.parseContractVersion(body), 2)
    end function

    @it("returns 0 for a body missing contractVersion")
    function _()
      m.assertEqual(remoteProtocol.parseContractVersion(FormatJson({ pluginVersion: "0.1.0" })), 0)
    end function

    @it("returns 0 for a non-numeric contractVersion (never throws on a hostile body)")
    function _()
      ' JSON bodies built via FormatJson rather than @params string literals — an embedded-quote
      ' string in a @params annotation transpiles to a broken expression.
      m.assertEqual(remoteProtocol.parseContractVersion(FormatJson({ contractVersion: "two" })), 0)
      m.assertEqual(remoteProtocol.parseContractVersion(FormatJson({ contractVersion: true })), 0)
      m.assertEqual(remoteProtocol.parseContractVersion(FormatJson({ contractVersion: {} })), 0)
    end function

    @it("returns 0 for a blank, non-JSON, or non-object body")
    @params("", 0)
    @params(invalid, 0)
    @params("not json", 0)
    @params("[1,2,3]", 0)
    function _(body, expected)
      m.assertEqual(remoteProtocol.parseContractVersion(body), expected)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("nextBackoffMs() — exponential, capped at 30s")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("doubles per attempt then caps at 30000ms")
    @params(0, 1000)
    @params(1, 2000)
    @params(2, 4000)
    @params(3, 8000)
    @params(4, 16000)
    @params(5, 30000)
    @params(10, 30000)
    function _(attempt, expectedMs)
      m.assertEqual(remoteProtocol.nextBackoffMs(attempt), expectedMs)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("keepAliveFrame()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("is a KeepAlive message the server can parse")
    function _()
      parsed = ParseJson(remoteProtocol.keepAliveFrame())
      m.assertEqual(parsed.MessageType, "KeepAlive")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("buildPairUrl() — cold-cast pairing report (#668)")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("builds the pair URL under the plugin route prefix (trimming a trailing slash)")
    @params("http://192.0.2.10:8096", "http://192.0.2.10:8096/JellyRock/RemoteControl/pair")
    @params("https://jellyfin.example.com", "https://jellyfin.example.com/JellyRock/RemoteControl/pair")
    @params("https://jellyfin.example.com/", "https://jellyfin.example.com/JellyRock/RemoteControl/pair")
    function _(serverUrl, expected)
      m.assertEqual(remoteProtocol.buildPairUrl(serverUrl), expected)
    end function

    @it("returns empty for a missing/blank server URL")
    @params("", "")
    @params(invalid, "")
    function _(serverUrl, expected)
      m.assertEqual(remoteProtocol.buildPairUrl(serverUrl), expected)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("sanitizeIps() — the reportable wake addresses")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("keeps routable addresses in order")
    function _()
      m.assertEqual(remoteProtocol.sanitizeIps(["192.168.1.5", "10.0.0.2"]), ["192.168.1.5", "10.0.0.2"])
    end function

    @it("drops blanks, loopback (127.x) and the unspecified address (0.0.0.0)")
    function _()
      m.assertEqual(remoteProtocol.sanitizeIps(["", "127.0.0.1", "0.0.0.0", "192.168.1.5"]), ["192.168.1.5"])
    end function

    @it("dedupes an address reported on more than one interface, preserving first-seen order")
    function _()
      m.assertEqual(remoteProtocol.sanitizeIps(["192.168.1.5", "192.168.1.5", "10.0.0.2"]), ["192.168.1.5", "10.0.0.2"])
    end function

    @it("trims surrounding whitespace before comparing/deduping")
    function _()
      m.assertEqual(remoteProtocol.sanitizeIps([" 192.168.1.5 ", "192.168.1.5"]), ["192.168.1.5"])
    end function

    @it("returns an empty array (never invalid) for a non-array or empty input")
    @params(invalid)
    @params("192.168.1.5")
    function _(bad)
      m.assertEqual(remoteProtocol.sanitizeIps(bad), [])
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("buildPairPayload() — the report body")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("serializes sanitized IPs + app identity; carries NO device/user id (auth header binds those)")
    function _()
      parsed = ParseJson(remoteProtocol.buildPairPayload(["192.168.1.5", "127.0.0.1"], "dev", true))
      m.assertEqual(parsed.rokuIps, ["192.168.1.5"])
      m.assertEqual(parsed.appId, "dev")
      m.assertEqual(parsed.isDev, true)
      m.assertInvalid(parsed.deviceId)
      m.assertInvalid(parsed.userId)
    end function

    @it("reports a published channel id with isDev false")
    function _()
      parsed = ParseJson(remoteProtocol.buildPairPayload(["192.168.1.5"], "781054", false))
      m.assertEqual(parsed.appId, "781054")
      m.assertEqual(parsed.isDev, false)
    end function

    @it("coerces a missing/invalid isDev to false rather than emitting null")
    function _()
      parsed = ParseJson(remoteProtocol.buildPairPayload(["192.168.1.5"], "dev", invalid))
      m.assertEqual(parsed.isDev, false)
    end function

    @it("returns empty when no usable IPs remain after sanitizing (nothing to wake)")
    @params(["127.0.0.1", "0.0.0.0", ""])
    @params([])
    @params(invalid)
    function _(ips)
      m.assertEqual(remoteProtocol.buildPairPayload(ips, "dev", true), "")
    end function

    @it("returns empty when appId is blank (can't target /launch)")
    function _()
      m.assertEqual(remoteProtocol.buildPairPayload(["192.168.1.5"], "", true), "")
      m.assertEqual(remoteProtocol.buildPairPayload(["192.168.1.5"], invalid, true), "")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("buildPairRequest() — the fire-and-forget SideEffect AA")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("composes a POST request AA (url + JSON body); carries NO auth — SideEffectTask adds it")
    function _()
      req = remoteProtocol.buildPairRequest("https://jellyfin.example.com", ["192.168.1.5"], "dev", true)
      m.assertEqual(req.method, "POST")
      m.assertEqual(req.url, "https://jellyfin.example.com/JellyRock/RemoteControl/pair")
      m.assertInvalid(req.headers)
      parsed = ParseJson(req.body)
      m.assertEqual(parsed.rokuIps, ["192.168.1.5"])
      m.assertEqual(parsed.appId, "dev")
      m.assertInvalid(parsed.deviceId)
      m.assertInvalid(parsed.userId)
    end function

    @it("returns invalid for a blank server URL (nothing to POST to)")
    @params("")
    @params(invalid)
    function _(serverUrl)
      m.assertInvalid(remoteProtocol.buildPairRequest(serverUrl, ["192.168.1.5"], "dev", true))
    end function

    @it("returns invalid when there's no reportable wake address (no usable IPs)")
    @params(["127.0.0.1", "0.0.0.0"])
    @params([])
    @params(invalid)
    function _(ips)
      m.assertInvalid(remoteProtocol.buildPairRequest("https://jellyfin.example.com", ips, "dev", true))
    end function

    @it("returns invalid when appId is blank (can't target /launch)")
    function _()
      m.assertInvalid(remoteProtocol.buildPairRequest("https://jellyfin.example.com", ["192.168.1.5"], "", true))
    end function

  end class
end namespace
