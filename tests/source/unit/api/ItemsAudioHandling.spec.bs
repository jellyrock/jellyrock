import "pkg:/source/api/items.bs"
import "pkg:/source/utils/misc.bs"

namespace tests

  @suite("Items.bs - optimizeAudioCodecListForSource()")
  class ItemsAudioHandlingTests extends tests.BaseTestSuite

    protected override function setup()
      super.setup()
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Multichannel Audio (>2ch) - Stereo Codec Removal")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("removes AAC from ts container codec list for 6ch audio")
    function _()
      deviceProfile = MockDataLoader.LoadDeviceProfile("device-profile-with-passthrough")
      channelCount = 6

      optimizeAudioCodecListForSource(deviceProfile, channelCount)

      tsProfile = invalid
      for each profile in deviceProfile.TranscodingProfiles
        if profile.Container = "ts"
          tsProfile = profile
          exit for
        end if
      end for

      m.assertNotInvalid(tsProfile, "ts profile should exist")
      m.assertFalse(tsProfile.AudioCodec.inStr("aac") >= 0, "AAC should be removed from codec list")
    end function

    @it("removes AAC from mp4 container codec list for 8ch audio")
    function _()
      deviceProfile = MockDataLoader.LoadDeviceProfile("device-profile-8ch-passthrough")
      channelCount = 8

      optimizeAudioCodecListForSource(deviceProfile, channelCount)

      mp4Profile = invalid
      for each profile in deviceProfile.TranscodingProfiles
        if profile.Container = "mp4"
          mp4Profile = profile
          exit for
        end if
      end for

      m.assertNotInvalid(mp4Profile, "mp4 profile should exist")
      m.assertFalse(mp4Profile.AudioCodec.inStr("aac") >= 0, "AAC should be removed from codec list")
    end function

    @it("preserves surround codecs (eac3, ac3, dts) for multichannel audio")
    function _()
      deviceProfile = MockDataLoader.LoadDeviceProfile("device-profile-with-passthrough")
      channelCount = 6

      optimizeAudioCodecListForSource(deviceProfile, channelCount)

      tsProfile = invalid
      for each profile in deviceProfile.TranscodingProfiles
        if profile.Container = "ts"
          tsProfile = profile
          exit for
        end if
      end for

      m.assertNotInvalid(tsProfile)
      m.assertTrue(tsProfile.AudioCodec.inStr("eac3") >= 0, "eac3 should be preserved")
      m.assertTrue(tsProfile.AudioCodec.inStr("ac3") >= 0, "ac3 should be preserved")
      m.assertTrue(tsProfile.AudioCodec.inStr("dts") >= 0, "dts should be preserved")
    end function

    @it("removes stereo-output codecs (mp3, flac, alac, pcm) for multichannel audio")
    function _()
      ' GIVEN: a multichannel source with passthrough support, the server has been observed to
      ' offer BOTH surround AND stereo variants in its HLS master playlist when stereo codecs
      ' remain in the AudioCodec list, with Roku then picking the stereo variant. Stripping
      ' stereo codecs forces the server to only emit surround variants.
      deviceProfile = MockDataLoader.LoadDeviceProfile("device-profile-with-passthrough")
      channelCount = 6

      optimizeAudioCodecListForSource(deviceProfile, channelCount)

      tsProfile = invalid
      for each profile in deviceProfile.TranscodingProfiles
        if profile.Container = "ts"
          tsProfile = profile
          exit for
        end if
      end for

      m.assertNotInvalid(tsProfile)
      m.assertFalse(tsProfile.AudioCodec.inStr("mp3") >= 0, "mp3 should be removed for multichannel")
      m.assertFalse(tsProfile.AudioCodec.inStr("flac") >= 0, "flac should be removed for multichannel")
      m.assertFalse(tsProfile.AudioCodec.inStr("alac") >= 0, "alac should be removed for multichannel")
      m.assertFalse(tsProfile.AudioCodec.inStr("pcm") >= 0, "pcm should be removed for multichannel")
    end function

    @it("strips all stereo-output codecs leaving only surround codecs for multichannel audio")
    function _()
      deviceProfile = MockDataLoader.LoadDeviceProfile("device-profile-with-passthrough")
      channelCount = 6

      optimizeAudioCodecListForSource(deviceProfile, channelCount)

      tsProfile = invalid
      for each profile in deviceProfile.TranscodingProfiles
        if profile.Container = "ts"
          tsProfile = profile
          exit for
        end if
      end for

      m.assertNotInvalid(tsProfile)
      ' Source list: aac,eac3,ac3,dts,mp3,flac,alac,pcm — after optimization should be eac3,ac3,dts
      m.assertEqual(tsProfile.AudioCodec, "eac3,ac3,dts", "only surround codecs should remain for multichannel")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Stereo Audio (≤2ch) - AAC and Surround Removal")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("removes AAC from codec list for stereo audio")
    function _()
      deviceProfile = MockDataLoader.LoadDeviceProfile("device-profile-stereo-only")
      channelCount = 2

      optimizeAudioCodecListForSource(deviceProfile, channelCount)

      tsProfile = invalid
      for each profile in deviceProfile.TranscodingProfiles
        if profile.Container = "ts"
          tsProfile = profile
          exit for
        end if
      end for

      m.assertNotInvalid(tsProfile)
      m.assertFalse(tsProfile.AudioCodec.inStr("aac") >= 0, "AAC should be removed for stereo")
    end function

    @it("removes surround codecs (eac3, ac3, dts) for stereo audio")
    function _()
      deviceProfile = MockDataLoader.LoadDeviceProfile("device-profile-stereo-only")
      channelCount = 2

      optimizeAudioCodecListForSource(deviceProfile, channelCount)

      tsProfile = invalid
      for each profile in deviceProfile.TranscodingProfiles
        if profile.Container = "ts"
          tsProfile = profile
          exit for
        end if
      end for

      m.assertNotInvalid(tsProfile)
      m.assertFalse(tsProfile.AudioCodec.inStr("eac3") >= 0, "eac3 should be removed for stereo")
      m.assertFalse(tsProfile.AudioCodec.inStr("ac3") >= 0, "ac3 should be removed for stereo")
      m.assertFalse(tsProfile.AudioCodec.inStr("dts") >= 0, "dts should be removed for stereo")
    end function

    @it("preserves stereo codecs (mp3, flac, alac, pcm) for stereo audio")
    function _()
      deviceProfile = MockDataLoader.LoadDeviceProfile("device-profile-stereo-only")
      channelCount = 2

      optimizeAudioCodecListForSource(deviceProfile, channelCount)

      tsProfile = invalid
      for each profile in deviceProfile.TranscodingProfiles
        if profile.Container = "ts"
          tsProfile = profile
          exit for
        end if
      end for

      m.assertNotInvalid(tsProfile)
      m.assertTrue(tsProfile.AudioCodec.inStr("mp3") >= 0, "mp3 should be preserved")
      m.assertTrue(tsProfile.AudioCodec.inStr("flac") >= 0, "flac should be preserved")
      m.assertTrue(tsProfile.AudioCodec.inStr("alac") >= 0, "alac should be preserved")
      m.assertTrue(tsProfile.AudioCodec.inStr("pcm") >= 0, "pcm should be preserved")
    end function

    @it("results in MP3 fallback for stereo audio (surround codecs removed)")
    function _()
      deviceProfile = MockDataLoader.LoadDeviceProfile("device-profile-stereo-only")
      channelCount = 2

      optimizeAudioCodecListForSource(deviceProfile, channelCount)

      tsProfile = invalid
      for each profile in deviceProfile.TranscodingProfiles
        if profile.Container = "ts"
          tsProfile = profile
          exit for
        end if
      end for

      m.assertNotInvalid(tsProfile)
      ' AAC removed, surround codecs removed, MP3 should be first available codec
      codecList = tsProfile.AudioCodec.Split(",")
      m.assertTrue(codecList.Count() > 0, "Codec list should not be empty")
      m.assertEqual(codecList[0], "mp3", "MP3 should be first codec for stereo")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Edge Cases")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("handles empty AudioCodec string gracefully")
    function _()
      deviceProfile = MockDataLoader.LoadDeviceProfile("device-profile-empty-codecs")
      channelCount = 6

      ' Should not crash
      optimizeAudioCodecListForSource(deviceProfile, channelCount)

      tsProfile = invalid
      for each profile in deviceProfile.TranscodingProfiles
        if profile.Container = "ts"
          tsProfile = profile
          exit for
        end if
      end for

      m.assertNotInvalid(tsProfile)
      m.assertEqual(tsProfile.AudioCodec, "", "Empty codec string should remain empty")
    end function

    @it("falls back to the preferred surround codec when AAC-only list would be emptied (issue #573)")
    function _()
      ' GIVEN: a profile with AAC-only AudioCodec on a multichannel-capable container
      ' (e.g. MaxAudioChannels=6) — this shape arises when a device's passthrough detection
      ' reports surround capability via codecs not in our surroundPriority (truehd-only,
      ' dtshd-only), so no surround codec ends up in the AudioCodec list during construction.
      '
      ' WHEN: optimizeAudioCodecListForSource runs for a 6ch source, it would normally strip
      ' "aac" as a stereo-output codec and emit an empty AudioCodec.
      '
      ' EXPECT: the multichannel branch prepends a server-encodeable surround codec (default
      ' eac3) rather than the stereo "aac". An empty AudioCodec makes the server's StreamBuilder
      ' omit the audioCodec query param, so InferAudioCodec returns the container name ("m3u8")
      ' and ffmpeg receives -codec:a:0 m3u8 → exit 8. Falling back to aac (a stereo-output codec)
      ' would have re-introduced the exact stereo variant this function exists to strip.
      deviceProfile = MockDataLoader.LoadDeviceProfile("device-profile-aac-only")
      channelCount = 6

      optimizeAudioCodecListForSource(deviceProfile, channelCount)

      tsProfile = invalid
      for each profile in deviceProfile.TranscodingProfiles
        if profile.Container = "ts"
          tsProfile = profile
          exit for
        end if
      end for

      m.assertNotInvalid(tsProfile)
      m.assertEqual(tsProfile.AudioCodec, "eac3", "emptied multichannel list should fall back to the preferred surround codec (default eac3), never the stereo 'aac'")
    end function

    @it("falls back to the preferred surround codec when all-stereo list would be emptied (issue #573)")
    function _()
      ' GIVEN: a video transcoding profile whose AudioCodec list contains only stereo-output
      ' codecs (no eac3/ac3/dts), but MaxAudioChannels advertises multichannel capability. This
      ' shape can arise when getTranscodingProfiles' getSupportedPassthruCodecs returns only
      ' codecs not in surroundPriority (e.g. truehd-only or dtshd-only passthrough).
      deviceProfile = {
        TranscodingProfiles: [
          {
            Container: "ts",
            Type: "Video",
            AudioCodec: "aac,mp3,flac,alac,pcm",
            VideoCodec: "h264",
            MaxAudioChannels: "6"
          }
        ]
      }
      channelCount = 6

      ' WHEN: optimizeAudioCodecListForSource runs for a 6ch source, EVERY codec would normally
      ' be stripped as stereo-output.
      optimizeAudioCodecListForSource(deviceProfile, channelCount)

      ' EXPECT: the multichannel branch prepends the preferred surround codec (default eac3) so
      ' the server transcodes to a real surround target instead of producing an empty AudioCodec
      ' (→ server bakes "m3u8" → ffmpeg fails, issue #573).
      m.assertEqual(deviceProfile.TranscodingProfiles[0].AudioCodec, "eac3", "all-stereo list must fall back to the preferred surround codec when filtering would empty it")
    end function

    @it("honors the user's preferred multichannel codec (ac3) as the surround fallback")
    function _()
      ' GIVEN: a truehd-only-shaped list and a user who picked ac3 as their preferred surround codec.
      deviceProfile = {
        TranscodingProfiles: [
          { Container: "ts", Type: "Video", AudioCodec: "aac,mp3", VideoCodec: "h264", MaxAudioChannels: "6" }
        ]
      }

      ' WHEN: a 6ch source is optimized with the preferred codec passed through.
      optimizeAudioCodecListForSource(deviceProfile, 6, "ac3")

      ' EXPECT: ac3 (the user's choice, a reliably-encodeable surround target) leads the list.
      m.assertEqual(deviceProfile.TranscodingProfiles[0].AudioCodec, "ac3", "preferred ac3 should be the surround fallback")
    end function

    @it("clamps an unencodeable preferred codec (dts) to eac3")
    function _()
      ' GIVEN: a user who picked dts — which the Jellyfin server emits no audio stream for as a
      ' transcode target, so it cannot be used as a fallback without re-triggering issue #573.
      deviceProfile = {
        TranscodingProfiles: [
          { Container: "ts", Type: "Video", AudioCodec: "aac,mp3", VideoCodec: "h264", MaxAudioChannels: "6" }
        ]
      }

      optimizeAudioCodecListForSource(deviceProfile, 6, "dts")

      ' EXPECT: dts is clamped to eac3 (the universal encodeable surround target).
      m.assertEqual(deviceProfile.TranscodingProfiles[0].AudioCodec, "eac3", "dts preference must clamp to eac3, never fall back to dts")
    end function

    @it("rescues an on-device-decode-only list (truehd,opus) by leading with the surround target")
    function _()
      ' GIVEN: the mp4 list a truehd-only device produces after construction + stereo stripping:
      ' truehd (un-encodeable for a non-truehd source) + opus (on-device decode only). Left as-is
      ' the server resolves this to opus, silently abandoning surround. (issue #573 audit)
      deviceProfile = {
        TranscodingProfiles: [
          { Container: "mp4", Type: "Video", AudioCodec: "truehd,opus", VideoCodec: "h264", MaxAudioChannels: "6" }
        ]
      }

      optimizeAudioCodecListForSource(deviceProfile, 6, "eac3")

      ' EXPECT: eac3 leads so the server transcodes to a real surround codec; truehd/opus are kept
      ' as trailing options but never chosen ahead of eac3.
      m.assertEqual(deviceProfile.TranscodingProfiles[0].AudioCodec, "eac3,truehd,opus", "preferred surround codec must lead so the server doesn't resolve to opus")
    end function

    @it("handles missing AudioCodec field gracefully")
    function _()
      ' Create profile without AudioCodec field
      deviceProfile = {
        TranscodingProfiles: [
          {
            Container: "ts",
            Type: "Video",
            VideoCodec: "h264",
            MaxAudioChannels: "6"
          }
        ]
      }
      channelCount = 6

      ' Should not crash when AudioCodec field is missing
      optimizeAudioCodecListForSource(deviceProfile, channelCount)

      ' Profile should remain unchanged
      m.assertFalse(deviceProfile.TranscodingProfiles[0].DoesExist("AudioCodec"), "AudioCodec field should remain non-existent")
    end function

    @it("processes all video containers including mkv")
    function _()
      ' Create profile with mkv container
      deviceProfile = {
        TranscodingProfiles: [
          {
            Container: "mkv",
            Type: "Video",
            AudioCodec: "aac,eac3,ac3,mp3",
            VideoCodec: "h264",
            MaxAudioChannels: "6"
          }
        ]
      }
      channelCount = 6

      optimizeAudioCodecListForSource(deviceProfile, channelCount)

      ' Multichannel: aac and mp3 stripped, surround codecs preserved
      m.assertEqual(deviceProfile.TranscodingProfiles[0].AudioCodec, "eac3,ac3", "mkv container should have stereo codecs stripped for multichannel")
    end function

    @it("ignores non-Video type profiles (only processes Type=Video)")
    function _()
      ' Create profile with mixed types including Audio type
      deviceProfile = {
        TranscodingProfiles: [
          {
            Container: "ts",
            Type: "Audio",
            AudioCodec: "aac,mp3,flac",
            MaxAudioChannels: "2"
          },
          {
            Container: "ts",
            Type: "Video",
            AudioCodec: "aac,eac3,ac3,mp3",
            VideoCodec: "h264",
            MaxAudioChannels: "6"
          }
        ]
      }
      channelCount = 6
      originalAudioProfileCodecs = deviceProfile.TranscodingProfiles[0].AudioCodec

      optimizeAudioCodecListForSource(deviceProfile, channelCount)

      ' Audio profile should remain unchanged
      m.assertEqual(deviceProfile.TranscodingProfiles[0].AudioCodec, originalAudioProfileCodecs, "Audio type profile should not be modified")
      ' Video profile: multichannel optimization strips aac and mp3, keeps surround codecs
      m.assertEqual(deviceProfile.TranscodingProfiles[1].AudioCodec, "eac3,ac3", "Video type profile should have stereo codecs stripped for multichannel")
    end function

    @it("processes both ts and mp4 containers in same profile")
    function _()
      deviceProfile = MockDataLoader.LoadDeviceProfile("device-profile-with-passthrough")
      channelCount = 6

      optimizeAudioCodecListForSource(deviceProfile, channelCount)

      ' Both containers should have AAC removed
      tsProfile = invalid
      mp4Profile = invalid
      for each profile in deviceProfile.TranscodingProfiles
        if profile.Container = "ts"
          tsProfile = profile
        else if profile.Container = "mp4"
          mp4Profile = profile
        end if
      end for

      m.assertNotInvalid(tsProfile, "ts profile should exist")
      m.assertNotInvalid(mp4Profile, "mp4 profile should exist")
      m.assertFalse(tsProfile.AudioCodec.inStr("aac") >= 0, "AAC should be removed from ts")
      m.assertFalse(mp4Profile.AudioCodec.inStr("aac") >= 0, "AAC should be removed from mp4")
      m.assertFalse(tsProfile.AudioCodec.inStr("mp3") >= 0, "MP3 should be removed from ts for multichannel")
      m.assertFalse(mp4Profile.AudioCodec.inStr("mp3") >= 0, "MP3 should be removed from mp4 for multichannel")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Codec List Rebuilding")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("rebuilds codec string correctly after removal")
    function _()
      deviceProfile = MockDataLoader.LoadDeviceProfile("device-profile-with-passthrough")
      channelCount = 6

      optimizeAudioCodecListForSource(deviceProfile, channelCount)

      tsProfile = invalid
      for each profile in deviceProfile.TranscodingProfiles
        if profile.Container = "ts"
          tsProfile = profile
          exit for
        end if
      end for

      m.assertNotInvalid(tsProfile)
      ' Should be comma-separated with no double commas or trailing commas
      m.assertFalse(tsProfile.AudioCodec.inStr(",,") >= 0, "Should not have double commas")
      m.assertFalse(tsProfile.AudioCodec.Left(1) = ",", "Should not start with comma")
      m.assertFalse(tsProfile.AudioCodec.Right(1) = ",", "Should not end with comma")
    end function

    @it("maintains codec order after stripping stereo codecs")
    function _()
      deviceProfile = MockDataLoader.LoadDeviceProfile("device-profile-with-passthrough")
      channelCount = 6

      optimizeAudioCodecListForSource(deviceProfile, channelCount)

      tsProfile = invalid
      for each profile in deviceProfile.TranscodingProfiles
        if profile.Container = "ts"
          tsProfile = profile
          exit for
        end if
      end for

      m.assertNotInvalid(tsProfile)
      codecList = tsProfile.AudioCodec.Split(",")

      ' Source order: aac,eac3,ac3,dts,mp3,flac,alac,pcm
      ' Multichannel optimization strips aac,mp3,flac,alac,pcm → eac3,ac3,dts (relative order preserved)
      m.assertEqual(codecList.Count(), 3, "only 3 surround codecs should remain")
      m.assertEqual(codecList[0], "eac3", "eac3 should be first")
      m.assertEqual(codecList[1], "ac3", "ac3 should be second")
      m.assertEqual(codecList[2], "dts", "dts should be third")
    end function

  end class

end namespace
