      localUser.id = ""

      result = m.apiClient.BuildGetIntrosRequest(m.testItemId)

      localUser.id = originalId

      m.assertInvalid(result)
    end function

    @it("returns invalid from BuildGetLocalTrailersRequest V1 when userId is empty")
    function _()
      localUser = m.global.user
      originalId = localUser.id
      localUser.id = ""
      m.global.server.apiVersion = 1

      result = m.apiClient.BuildGetLocalTrailersRequest(m.testItemId)

      localUser.id = originalId

      m.assertInvalid(result)
    end function

    @it("returns invalid from BuildMarkFavoriteRequest when userId is empty")
    function _()
      localUser = m.global.user
      originalId = localUser.id
      localUser.id = ""

      result = m.apiClient.BuildMarkFavoriteRequest(m.testItemId)

      localUser.id = originalId

      m.assertInvalid(result)
    end function

    @it("returns invalid from BuildUnmarkFavoriteRequest when userId is empty")
    function _()
      localUser = m.global.user
      originalId = localUser.id
      localUser.id = ""

      result = m.apiClient.BuildUnmarkFavoriteRequest(m.testItemId)

      localUser.id = originalId

      m.assertInvalid(result)
    end function

    @it("returns invalid from BuildMarkPlayedRequest when userId is empty")
    function _()
      localUser = m.global.user
      originalId = localUser.id
      localUser.id = ""

      result = m.apiClient.BuildMarkPlayedRequest(m.testItemId)

      localUser.id = originalId

      m.assertInvalid(result)
    end function

    @it("returns invalid from BuildUnmarkPlayedRequest when userId is empty")
    function _()
      localUser = m.global.user
      originalId = localUser.id
      localUser.id = ""

      result = m.apiClient.BuildUnmarkPlayedRequest(m.testItemId)

      localUser.id = originalId

      m.assertInvalid(result)
    end function

    @it("returns invalid from BuildGetItemRawRequest when userId is empty")
    function _()
      localUser = m.global.user
      originalId = localUser.id
      localUser.id = ""

      result = m.apiClient.BuildGetItemRawRequest(m.testItemId)

      localUser.id = originalId

      m.assertInvalid(result)
    end function

    @it("returns invalid from BuildGetInstantMixRequest when userId is empty")
    function _()
      localUser = m.global.user
      originalId = localUser.id
      localUser.id = ""

      result = m.apiClient.BuildGetInstantMixRequest(m.testItemId)

      localUser.id = originalId

