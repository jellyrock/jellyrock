namespace tests

  @suite("ApiClient - V1/V2 routing and parameter injection")
  class ApiClientTests extends tests.BaseTestSuite

    private apiClient
    private testUserId = "test-user-123"
    private testItemId = "test-item-456"

    protected override function setup()
      super.setup()
      m.apiClient = new ApiClient()
      m.setupTestUser()
      m.setupMockServer()
    end function

    private function setupTestUser()
      localUser = m.global.user
      localUser.id = m.testUserId
    end function

    private function setupMockServer()
      m.global.server.serverUrl = "http://jellyfin.test:8096"
    end function

    private function setApiVersion(version as integer)
      m.global.server.apiVersion = version
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("V1/V2 Routing - GetUserImageURL")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("routes GetUserImageURL to V1 path when apiVersion = 1")
    function _()
      m.setApiVersion(1)

      result = m.apiClient.GetUserImageURL(m.testUserId, "primary")

      m.assertTrue(result.inStr("/users/" + m.testUserId + "/images/") >= 0, "V1 URL should contain /users/{id}/images/ path")
      m.assertTrue(result.inStr("/primary/") >= 0, "V1 URL should contain imagetype in path")
    end function

    @it("routes GetUserImageURL to V2 path when apiVersion = 2")
    function _()
      m.setApiVersion(2)

      result = m.apiClient.GetUserImageURL(m.testUserId, "primary")

      m.assertTrue(result.inStr("/UserImage") >= 0, "V2 URL should use /UserImage path")
      m.assertFalse(result.inStr("/users/") >= 0, "V2 URL must not contain /users/ path prefix")
    end function

    @it("routes GetUserImageURL to V2 path when apiVersion > 2")
    function _()
      m.setApiVersion(3)

      result = m.apiClient.GetUserImageURL(m.testUserId, "primary")

      m.assertTrue(result.inStr("/UserImage") >= 0, "V2+ URL should use /UserImage path")
    end function

    @it("routes GetUserImageURL to V2 path when apiVersion = 0 (default/unset)")
    function _()
      ' apiVersion defaults to 0 in JellyfinServer - this tests that 0 is treated as unset
      ' and defaults to V2, matching getApiVersionFromGlobal() behavior
      m.setApiVersion(0)

      result = m.apiClient.GetUserImageURL(m.testUserId, "primary")

      m.assertTrue(result.inStr("/UserImage") >= 0, "apiVersion=0 should route to V2 URL with /UserImage path")
      m.assertFalse(result.inStr("/users/") >= 0, "apiVersion=0 must not use V1 /users/ path prefix")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Parameter Passthrough - GetUserImageURL")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("passes params to GetUserImageURL for V1")
    function _()
      m.setApiVersion(1)

      result = m.apiClient.GetUserImageURL(m.testUserId, "primary", 0, { maxHeight: 300 })

      ' BrightScript AA keys are lowercased in URLs
      m.assertTrue(result.inStr("300") >= 0, "V1 URL should include maxHeight value")
    end function

    @it("passes params to GetUserImageURL for V2")
    function _()
      m.setApiVersion(2)

      result = m.apiClient.GetUserImageURL(m.testUserId, "primary", 0, { maxHeight: 300 })

      m.assertTrue(result.inStr("300") >= 0, "V2 URL should include maxHeight value")
    end function

