    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("V1/V2 Routing - URL Path Verification")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("GetUserImageURL V1 uses correct path structure")
    function _()
      m.setApiVersion(1)

      result = m.apiClient.GetUserImageURL("user-123", "backdrop", 1)

      m.assertTrue(result.inStr("/users/user-123/images/backdrop/1") >= 0, "V1 should use /users/{id}/images/{type}/{index} path")
    end function

    @it("GetUserImageURL V2 uses correct query parameter structure")
    function _()
      m.setApiVersion(2)

      result = m.apiClient.GetUserImageURL("user-123", "backdrop", 1, { maxWidth: 500 })

      m.assertTrue(result.inStr("/UserImage") >= 0, "V2 should use /UserImage path")
      ' BrightScript lowercases AA keys in URLs, so check values are present
      m.assertTrue(result.inStr("user-123") >= 0, "V2 should have userId value in query")
      m.assertTrue(result.inStr("backdrop") >= 0, "V2 should have type value in query")
      m.assertTrue(result.inStr("500") >= 0, "V2 should have maxWidth value")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("ApiClient Instantiation")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("can create new ApiClient instance directly")
    function _()
      client = new ApiClient()
      m.assertNotInvalid(client)
    end function

    @it("GetApi returns a valid object")
    function _()
      api = GetApi()
      m.assertNotInvalid(api)
      ' Verify it has the expected methods
      m.assertTrue(api.BuildGetItemRequest <> invalid, "GetApi should return object with BuildGetItemRequest method")
    end function

  end class

end namespace
