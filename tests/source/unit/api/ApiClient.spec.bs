    @it("returns invalid from UpdateRating when userId is empty")
    function _()
      localUser = m.global.user
      originalId = localUser.id
      localUser.id = ""

      result = m.apiClient.UpdateRating(m.testItemId, { rating: 5 })

      localUser.id = originalId

      m.assertInvalid(result)
    end function

    @it("returns invalid from DeleteRating when userId is empty")
    function _()
      localUser = m.global.user
