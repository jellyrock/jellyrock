    end function

    @it("returns invalid from GetLocalTrailers when userId is empty")
    function _()
      localUser = m.global.user
      originalId = localUser.id
      localUser.id = ""

      result = m.apiClient.GetLocalTrailers(m.testItemId)

      localUser.id = originalId

      m.assertInvalid(result)
    end function

    @it("returns invalid from GetSpecialFeatures when userId is empty")
    function _()
      localUser = m.global.user
