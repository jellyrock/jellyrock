import "pkg:/source/api/items.bs"
import "pkg:/source/utils/streamSelection.bs"

namespace tests

  @suite("Items.bs - doviRemuxContainerProfile()")
  class ItemsDoviHandlingTests extends tests.BaseTestSuite

    ' Capabilities AA the function reads instead of the hardware (isMock = true)
    private function mockCaps(supportsDolbyVision as boolean) as object
      return {
        maxHeight: 2160,
        maxWidth: 3840,
        canDecode4k: true,
        supportsHdr10: true,
        supportsDolbyVision: supportsDolbyVision,
        supportsHlg: true,
        isMock: true
      }
    end function

    private function videoStream(codec as dynamic, videoRangeType as dynamic) as object
      stream = { Type: "Video" }
      if codec <> invalid then stream.Codec = codec
      if videoRangeType <> invalid then stream.VideoRangeType = videoRangeType
      return stream
    end function

    ' The profile the function returns for a stream whose VideoRangeType is the given value
    private function expectedProfile(videoRangeType as string) as object
      return {
        "Type": "Video",
        "Container": "mkv",
        "Conditions": [
          {
            "Condition": "NotEquals",
            "Property": "VideoRangeType",
            "Value": videoRangeType,
            "IsRequired": true
          }
        ]
      }
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("returns the remux profile")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("returns the whole profile for hevc DOVIWithHDR10 in mkv on tier 2 with the setting on and DoVi supported")
    function _()
      streams = [m.videoStream("hevc", "DOVIWithHDR10")]

      result = doviRemuxContainerProfile(streams, "mkv", true, false, 2, m.mockCaps(true))

      m.assertEqual(result, m.expectedProfile("DOVIWithHDR10"))
    end function

    @it("keeps the case of the stream's VideoRangeType in the condition value")
    function _()
      streams = [m.videoStream("hevc", "DoViWithSDR")]

      result = doviRemuxContainerProfile(streams, "mkv", true, false, 2, m.mockCaps(true))

      m.assertEqual(result.Conditions[0].Value, "DoViWithSDR")
    end function

    @it("matches dovi in any case within VideoRangeType")
    function _()
      for each rangeType in ["DOVI", "dovi", "DOVIWithSDR", "DOVIWithHLG", "DOVIWithHDR10"]
        streams = [m.videoStream("hevc", rangeType)]

        result = doviRemuxContainerProfile(streams, "mkv", true, false, 2, m.mockCaps(true))

        m.assertEqual(result, m.expectedProfile(rangeType), "VideoRangeType " + rangeType)
      end for
    end function

    @it("returns the profile on tier 3 and above")
    function _()
      streams = [m.videoStream("hevc", "DOVIWithHDR10")]

      result = doviRemuxContainerProfile(streams, "mkv", true, false, 3, m.mockCaps(true))

      m.assertEqual(result, m.expectedProfile("DOVIWithHDR10"))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("returns invalid before looking at the streams")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("returns invalid when bypass is true")
    function _()
      streams = [m.videoStream("hevc", "DOVIWithHDR10")]

      result = doviRemuxContainerProfile(streams, "mkv", true, true, 2, m.mockCaps(true))

      m.assertInvalid(result)
    end function

    @it("returns invalid when the setting is false")
    function _()
      streams = [m.videoStream("hevc", "DOVIWithHDR10")]

      result = doviRemuxContainerProfile(streams, "mkv", false, false, 2, m.mockCaps(true))

      m.assertInvalid(result)
    end function

    @it("returns invalid when the setting is invalid")
    function _()
      streams = [m.videoStream("hevc", "DOVIWithHDR10")]

      result = doviRemuxContainerProfile(streams, "mkv", invalid, false, 2, m.mockCaps(true))

      m.assertInvalid(result)
    end function

    @it("returns invalid when mediaStreams is invalid")
    function _()
      result = doviRemuxContainerProfile(invalid, "mkv", true, false, 2, m.mockCaps(true))

      m.assertInvalid(result)
    end function

    @it("returns invalid when the setting is false and no mock capabilities are given")
    function _()
      streams = [m.videoStream("hevc", "DOVIWithHDR10")]

      result = doviRemuxContainerProfile(streams, "mkv", false, false, 2, invalid)

      m.assertInvalid(result)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("device, server and container")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("returns invalid when the device does not support Dolby Vision")
    function _()
      streams = [m.videoStream("hevc", "DOVIWithHDR10")]

      result = doviRemuxContainerProfile(streams, "mkv", true, false, 2, m.mockCaps(false))

      m.assertInvalid(result)
    end function

    @it("returns invalid on API tier 1, which has no VideoRangeType")
    function _()
      streams = [m.videoStream("hevc", "DOVIWithHDR10")]

      result = doviRemuxContainerProfile(streams, "mkv", true, false, 1, m.mockCaps(true))

      m.assertInvalid(result)
    end function

    @it("returns invalid for an mp4 container")
    function _()
      streams = [m.videoStream("hevc", "DOVIWithHDR10")]

      result = doviRemuxContainerProfile(streams, "mp4", true, false, 2, m.mockCaps(true))

      m.assertInvalid(result)
    end function

    @it("returns invalid when the container is empty or invalid")
    function _()
      streams = [m.videoStream("hevc", "DOVIWithHDR10")]

      m.assertInvalid(doviRemuxContainerProfile(streams, "", true, false, 2, m.mockCaps(true)))
      m.assertInvalid(doviRemuxContainerProfile(streams, invalid, true, false, 2, m.mockCaps(true)))
    end function

    @it("treats MKV in any case as mkv")
    function _()
      streams = [m.videoStream("hevc", "DOVIWithHDR10")]

      for each container in ["MKV", "Mkv", "mkv"]
        result = doviRemuxContainerProfile(streams, container, true, false, 2, m.mockCaps(true))

        m.assertEqual(result, m.expectedProfile("DOVIWithHDR10"), "container " + container)
      end for
    end function

    @it("does not treat m4v or mov as mkv")
    function _()
      streams = [m.videoStream("hevc", "DOVIWithHDR10")]

      for each container in ["m4v", "mov", "M4V", "MOV"]
        result = doviRemuxContainerProfile(streams, container, true, false, 2, m.mockCaps(true))

        m.assertInvalid(result, "container " + container)
      end for
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("VideoRangeType")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("returns invalid for SDR and HDR10")
    function _()
      for each rangeType in ["SDR", "HDR10", "HLG", "HDR10Plus"]
        streams = [m.videoStream("hevc", rangeType)]

        result = doviRemuxContainerProfile(streams, "mkv", true, false, 2, m.mockCaps(true))

        m.assertInvalid(result, "VideoRangeType " + rangeType)
      end for
    end function

    @it("returns invalid for DOVIInvalid in any case, which a remux cannot turn into Dolby Vision")
    @params("DOVIInvalid")
    @params("doviinvalid")
    function _(videoRangeType as string)
      result = doviRemuxContainerProfile([m.videoStream("hevc", videoRangeType)], "mkv", true, false, 2, m.mockCaps(true))

      m.assertInvalid(result)
    end function

    @it("returns invalid for out-of-spec Dolby Vision a pre-10.11 server calls DOVIWithHDR10 (profile 8 or 10, compatibility ID 6, HDR10 tags)")
    @params(8)
    @params(10)
    function _(dvProfile as integer)
      stream = { Type: "Video", Codec: "hevc", VideoRangeType: "DOVIWithHDR10", DvProfile: dvProfile, DvBlSignalCompatibilityId: 6, ColorSpace: "bt2020nc", ColorTransfer: "smpte2084", ColorPrimaries: "bt2020" }
      result = doviRemuxContainerProfile([stream], "mkv", true, false, 2, m.mockCaps(true))

      m.assertInvalid(result)
    end function

    @it("still returns the profile for in-spec Dolby Vision, profile 7, or out-of-spec without HDR10 tags")
    function _()
      inSpec = { Type: "Video", Codec: "hevc", VideoRangeType: "DOVIWithHDR10", DvProfile: 8, DvBlSignalCompatibilityId: 1, ColorSpace: "bt2020nc", ColorTransfer: "smpte2084", ColorPrimaries: "bt2020" }
      profile7 = { Type: "Video", Codec: "hevc", VideoRangeType: "DOVIWithEL", DvProfile: 7, DvBlSignalCompatibilityId: 6, ColorSpace: "bt2020nc", ColorTransfer: "smpte2084", ColorPrimaries: "bt2020" }
      untagged = { Type: "Video", Codec: "hevc", VideoRangeType: "DOVIWithHDR10", DvProfile: 8, DvBlSignalCompatibilityId: 6, ColorSpace: "bt709", ColorTransfer: "bt709", ColorPrimaries: "bt709" }

      m.assertEqual(doviRemuxContainerProfile([inSpec], "mkv", true, false, 2, m.mockCaps(true)), m.expectedProfile("DOVIWithHDR10"), "in spec")
      m.assertEqual(doviRemuxContainerProfile([profile7], "mkv", true, false, 2, m.mockCaps(true)), m.expectedProfile("DOVIWithEL"), "profile 7")
      m.assertEqual(doviRemuxContainerProfile([untagged], "mkv", true, false, 2, m.mockCaps(true)), m.expectedProfile("DOVIWithHDR10"), "no HDR10 tags")
    end function

    @it("reads compatibility ID 0 as out of spec for profile 8 and in spec for profile 10, as Jellyfin 10.11 does")
    function _()
      profile8 = { Type: "Video", Codec: "hevc", DvProfile: 8, DvBlSignalCompatibilityId: 0, ColorSpace: "bt2020nc", ColorTransfer: "smpte2084", ColorPrimaries: "bt2020" }
      profile10 = { Type: "Video", Codec: "hevc", DvProfile: 10, DvBlSignalCompatibilityId: 0, ColorSpace: "bt2020nc", ColorTransfer: "smpte2084", ColorPrimaries: "bt2020" }
      noCompatId = { Type: "Video", Codec: "hevc", DvProfile: 8, ColorSpace: "bt2020nc", ColorTransfer: "smpte2084", ColorPrimaries: "bt2020" }

      m.assertTrue(isOutOfSpecHdr10Dovi(profile8), "profile 8")
      m.assertFalse(isOutOfSpecHdr10Dovi(profile10), "profile 10")
      m.assertFalse(isOutOfSpecHdr10Dovi(noCompatId), "no compatibility ID")
    end function

    @it("returns invalid for an empty VideoRangeType")
    function _()
      streams = [m.videoStream("hevc", "")]

      result = doviRemuxContainerProfile(streams, "mkv", true, false, 2, m.mockCaps(true))

      m.assertInvalid(result)
    end function

    @it("returns invalid when VideoRangeType is missing")
    function _()
      streams = [m.videoStream("hevc", invalid)]

      result = doviRemuxContainerProfile(streams, "mkv", true, false, 2, m.mockCaps(true))

      m.assertInvalid(result)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("which video stream counts")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("returns invalid for an av1 stream in lowercase and uppercase")
    function _()
      for each codec in ["av1", "AV1", "Av1"]
        streams = [m.videoStream(codec, "DOVIWithHDR10")]

        result = doviRemuxContainerProfile(streams, "mkv", true, false, 2, m.mockCaps(true))

        m.assertInvalid(result, "codec " + codec)
      end for
    end function

    @it("skips an av1 video stream and uses a later hevc DoVi stream")
    function _()
      streams = [m.videoStream("av1", "SDR"), m.videoStream("hevc", "DOVIWithHDR10")]

      result = doviRemuxContainerProfile(streams, "mkv", true, false, 2, m.mockCaps(true))

      m.assertEqual(result, m.expectedProfile("DOVIWithHDR10"))
    end function

    @it("skips a video stream with no Codec and uses a later DoVi stream")
    function _()
      streams = [m.videoStream(invalid, "DOVIWithHDR10"), m.videoStream("hevc", "DOVIWithSDR")]

      result = doviRemuxContainerProfile(streams, "mkv", true, false, 2, m.mockCaps(true))

      m.assertEqual(result, m.expectedProfile("DOVIWithSDR"))
    end function

    @it("skips audio streams before the video stream")
    function _()
      streams = [{ Type: "Audio", Codec: "eac3" }, m.videoStream("hevc", "DOVIWithHDR10")]

      result = doviRemuxContainerProfile(streams, "mkv", true, false, 2, m.mockCaps(true))

      m.assertEqual(result, m.expectedProfile("DOVIWithHDR10"))
    end function

    @it("returns invalid when the first eligible video stream is not DoVi, even if a later one is")
    function _()
      streams = [m.videoStream("hevc", "HDR10"), m.videoStream("hevc", "DOVIWithHDR10")]

      result = doviRemuxContainerProfile(streams, "mkv", true, false, 2, m.mockCaps(true))

      m.assertInvalid(result)
    end function

    @it("returns invalid for an empty stream list")
    function _()
      result = doviRemuxContainerProfile([], "mkv", true, false, 2, m.mockCaps(true))

      m.assertInvalid(result)
    end function

  end class

end namespace
