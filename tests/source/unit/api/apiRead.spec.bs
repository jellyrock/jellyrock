import "pkg:/source/api/apiRead.bs"

namespace tests

  ' Contract tests for the reads of a Task run that tells failed from empty (source/api/apiRead.bs).
  '
  ' The failure path is the one that matters and the one least often run: a read that did not
  ' answer must come back as invalid, mark the run failed, and log why through the logger
  ' the Task handed in. A request that could not be built fails without the network, so it
  ' drives that path here.
  @suite("apiRead - the reads of a Task run")
  class ApiReadTests extends tests.BaseTestSuite

    ' A stand-in for the Task's log.Logger that keeps what it was asked to warn. Takes extra
    ' arguments because dev builds insert the call's file location first (roku-log plugin).
    function newLogger() as object
      return {
        warnings: [],
        warn: sub(a = invalid, b = invalid, c = invalid, d = invalid, e = invalid, f = invalid)
          words = []
          for each arg in [a, b, c, d, e, f]
            if type(arg) = "String" or type(arg) = "roString" then words.push(arg)
          end for
          m.warnings.push(words.join(" "))
        end sub
      }
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Reader")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("starts with no failed read")
    function _()
      reader = new apiRead.Reader(m.newLogger(), "test")
      m.assertFalse(reader.anyFailed)
    end function

    @it("returns invalid for a read that could not be sent, and marks the run failed")
    function _()
      reader = new apiRead.Reader(m.newLogger(), "test")
      m.assertInvalid(reader.json(invalid, "qp_test"))
      m.assertTrue(reader.anyFailed)
    end function

    @it("logs which read failed and why, through the logger it was given")
    function _()
      logger = m.newLogger()
      reader = new apiRead.Reader(logger, "test")
      reader.json(invalid, "qp_test")
      m.assertEqual(logger.warnings.count(), 1)
      m.assertTrue(logger.warnings[0].instr("qp_test") >= 0, logger.warnings[0])
      m.assertTrue(logger.warnings[0].instr("not sent") >= 0, logger.warnings[0])
    end function

    @it("keeps one run's failure out of another's")
    function _()
      failed = new apiRead.Reader(m.newLogger(), "test")
      failed.json(invalid, "qp_test")
      fresh = new apiRead.Reader(m.newLogger(), "test")
      m.assertFalse(fresh.anyFailed)
    end function

    @it("names what the reads are for in the warning")
    function _()
      logger = m.newLogger()
      reader = new apiRead.Reader(logger, "search")
      reader.json(invalid, "qp_test")
      m.assertTrue(logger.warnings[0].instr("search") >= 0, logger.warnings[0])
    end function

    @it("counts the reads asked for and the ones that failed")
    function _()
      reader = new apiRead.Reader(m.newLogger(), "test")
      m.assertEqual(reader.sentCount, 0)
      m.assertEqual(reader.failedCount, 0)
      reader.json(invalid, "qp_one")
      reader.json(invalid, "qp_two")
      m.assertEqual(reader.sentCount, 2)
      m.assertEqual(reader.failedCount, 2)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Reader.answered")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("returns the body of a usable reply, counted as sent and not failed")
    function _()
      reader = new apiRead.Reader(m.newLogger(), "test")
      body = { Items: [{ Id: "one" }] }
      data = reader.answered({ ok: true, statusCode: 200, json: body }, "qp_ok")
      m.assertEqual(data.Items[0].Id, "one")
      m.assertEqual(reader.sentCount, 1)
      m.assertEqual(reader.failedCount, 0)
      m.assertFalse(reader.anyFailed)
    end function

    @it("fails a read that never answered (a pipeline hands back invalid)")
    function _()
      logger = m.newLogger()
      reader = new apiRead.Reader(logger, "test")
      m.assertInvalid(reader.answered(invalid, "qp_late"))
      m.assertEqual(reader.sentCount, 1)
      m.assertEqual(reader.failedCount, 1)
      m.assertTrue(logger.warnings[0].instr("qp_late") >= 0, logger.warnings[0])
    end function

    @it("fails a reply with an HTTP error, and logs the status")
    function _()
      logger = m.newLogger()
      reader = new apiRead.Reader(logger, "test")
      m.assertInvalid(reader.answered({ ok: false, statusCode: 500 }, "qp_500"))
      m.assertEqual(reader.failedCount, 1)
      m.assertTrue(logger.warnings[0].instr("HTTP 500") >= 0, logger.warnings[0])
    end function

  end class

end namespace
