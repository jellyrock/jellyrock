namespace tests

  @suite("sdk.bs - API version dispatcher + shim URL structure")
  class SdkVersioningTests extends tests.BaseTestSuite

    protected override function setup()
      super.setup()
      ' Ensure the server has a URL so buildURL can produce results
      m.global.server.serverUrl = "http://jellyfin.test:8096"
      m.testUserId = "user-abc123"
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("sdkV1.users.GetImageURL() - V1 path structure")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("includes /users/{id}/images/ path segment")
    function _()
      result = sdkV1.users.GetImageURL(m.testUserId, "primary", 0, {})
      m.assertTrue(result.Instr("/users/" + m.testUserId + "/images/") >= 0, "V1 URL should contain /users/{id}/images/ path")
    end function

    @it("includes imagetype in path")
    function _()
      result = sdkV1.users.GetImageURL(m.testUserId, "primary", 0, {})
      m.assertTrue(result.Instr("/primary/") >= 0, "V1 URL should contain imagetype in path")
    end function

    @it("includes imageindex in path")
    function _()
      result = sdkV1.users.GetImageURL(m.testUserId, "primary", 0, {})
      m.assertTrue(result.Instr("/0") >= 0, "V1 URL should contain imageindex in path")
    end function

    @it("appends extra params as query string")
    function _()
      result = sdkV1.users.GetImageURL(m.testUserId, "primary", 0, { maxHeight: 300 })
      ' BrightScript AA keys are lowercased; check the value not the key
      m.assertTrue(result.Instr("300") >= 0, "V1 URL should include extra params in query string")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("sdkV2.users.GetImageURL() - V2 path structure")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("uses /UserImage top-level path (not /users/)")
    function _()
      result = sdkV2.users.GetImageURL(m.testUserId, "primary", 0, {})
      m.assertTrue(result.Instr("/UserImage") >= 0, "V2 URL should use /UserImage path")
      m.assertFalse(result.Instr("/users/") >= 0, "V2 URL must not contain /users/ path prefix")
    end function

    @it("passes userId as query parameter")
    function _()
      result = sdkV2.users.GetImageURL(m.testUserId, "primary", 0, {})
      ' Key stored lowercase: "userid"
      m.assertTrue(result.Instr(m.testUserId) >= 0, "V2 URL should contain userId value as query param")
    end function

    @it("passes type as query parameter")
    function _()
      result = sdkV2.users.GetImageURL(m.testUserId, "backdrop", 0, {})
      m.assertTrue(result.Instr("backdrop") >= 0, "V2 URL should contain imagetype as query param value")
    end function

    @it("passes index as query parameter")
    function _()
      result = sdkV2.users.GetImageURL(m.testUserId, "primary", 2, {})
      m.assertTrue(result.Instr("2") >= 0, "V2 URL should contain imageindex as query param value")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("sdk.users.GetImageURL() dispatcher - routes by apiVersion")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("routes to V1 when apiVersion = 0 (default/unset)")
    function _()
      m.global.server.apiVersion = 0
      result = sdk.users.GetImageURL(m.testUserId, "primary", 0, {})
      m.assertTrue(result.Instr("/users/" + m.testUserId + "/images/") >= 0, "apiVersion=0 should use V1 /users/ path")
    end function

    @it("routes to V1 when apiVersion = 1")
    function _()
      m.global.server.apiVersion = 1
      result = sdk.users.GetImageURL(m.testUserId, "primary", 0, {})
      m.assertTrue(result.Instr("/users/" + m.testUserId + "/images/") >= 0, "apiVersion=1 should use V1 /users/ path")
    end function

    @it("routes to V2 when apiVersion = 2")
    function _()
      m.global.server.apiVersion = 2
      result = sdk.users.GetImageURL(m.testUserId, "primary", 0, {})
      m.assertTrue(result.Instr("/UserImage") >= 0, "apiVersion=2 should use V2 /UserImage path")
      m.assertFalse(result.Instr("/users/") >= 0, "apiVersion=2 must not use V1 /users/ path")
    end function

    @it("routes to V2 for future versions (apiVersion > 2, forward-compat)")
    function _()
      m.global.server.apiVersion = 3
      result = sdk.users.GetImageURL(m.testUserId, "primary", 0, {})
      m.assertTrue(result.Instr("/UserImage") >= 0, "apiVersion=3 should still use V2 paths (>= 2 check)")
    end function

  end class

end namespace
