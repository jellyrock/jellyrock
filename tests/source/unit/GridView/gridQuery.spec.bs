import "pkg:/source/GridView/GenericPresenter.bs"
import "pkg:/source/GridView/gridQuery.bs"
import "pkg:/source/GridView/MusicPresenter.bs"
import "pkg:/source/GridView/TVShowPresenter.bs"
import "pkg:/source/utils/paging.bs"

namespace tests

  @suite("gridQuery - the library grid's LoadItemsTask2 query")
  class GridQueryTests extends tests.BaseTestSuite

    protected override function setup()
      super.setup()
    end function

    ' Component state as BaseGridView passes it. A fresh AA per call, so no test can pass
    ' on a neighbour's edits.
    private function state() as object
      return {
        nameStartsWith: "B",
        searchTerm: "",
        sortField: "DateCreated",
        sortAscending: false,
        filter: "Favorites",
        filterOptions: { Genres: "Drama" }
      }
    end function

    private function musicLibrary() as object
      return { Id: "music-lib", type: "CollectionFolder", folderType: "CollectionFolder", collectionType: "music" }
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("build()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("sends the component's state and the defaults when there is no presenter")
    function _()
      query = gridQuery.build(m.state(), { Id: "lib-1" }, "Movies", invalid)

      m.assertEqual(query.nameStartsWith, "B")
      m.assertEqual(query.searchTerm, "")
      m.assertEqual(query.sortField, "DateCreated")
      m.assertEqual(query.sortAscending, false)
      m.assertEqual(query.filter, "Favorites")
      m.assertEqual(query.filterOptions, { Genres: "Drama" })
      m.assertEqual(query.itemId, "lib-1")
      m.assertEqual(query.isRecursive, true)
      m.assertEqual(query.itemType, "")
      m.assertEqual(query.view, "")
      m.assertEqual(query.studioIds, "")
      m.assertEqual(query.genreIds, "")
      m.assertFalse(query.DoesExist("startIndex"), "startIndex belongs to a page, not the query")
    end function

    @it("applies what the presenter sets for the view")
    function _()
      query = gridQuery.build(m.state(), m.musicLibrary(), "albums", new MusicPresenter())

      m.assertEqual(query.itemType, "MusicAlbum")
      m.assertEqual(query.itemId, "music-lib")
      m.assertEqual(query.view, "Artists")
      m.assertEqual(query.additionalFields, "Genres")
    end function

    @it("lets the presenter override a default")
    function _()
      query = gridQuery.build(m.state(), { Id: "folder-1" }, "", new GenericPresenter())

      m.assertEqual(query.isRecursive, false)
    end function

    @it("does not carry a field the presenter set for one view into the next")
    function _()
      presenter = new MusicPresenter()
      albums = gridQuery.build(m.state(), m.musicLibrary(), "albums", presenter)
      artists = gridQuery.build(m.state(), m.musicLibrary(), "artists", presenter)

      m.assertEqual(albums.additionalFields, "Genres")
      m.assertFalse(artists.DoesExist("additionalFields"), "the albums view's additionalFields leaked into the artists query")
      m.assertEqual(artists.itemType, "MusicArtist")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("on a LoadItemsTask2 node")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    ' The grid hands this AA to replaceTask, which sets it with one setFields call — where it
    ' used to assign each field on the node directly. A value setFields coerced differently
    ' (a boolean, an AA, the " " alpha sentinel) would change the request. CreateObject does
    ' not start the task's thread, so nothing is fetched.
    @it("sets every field with its value")
    function _()
      s = m.state()
      s.nameStartsWith = " "
      tvLibrary = { Id: "tv-lib", type: "CollectionFolder" }
      fields = paging.forPage(gridQuery.build(s, tvLibrary, "shows", new TVShowPresenter()), 100)
      task = CreateObject("roSGNode", "LoadItemsTask2")

      task.setFields(fields)

      for each key in fields
        m.assertEqual(task.getField(key), fields[key], "LoadItemsTask2." + key + " differs from the query")
      end for
      m.assertEqual(task.nameStartsWith, " ")
      m.assertEqual(task.sortAscending, false)
      m.assertEqual(task.additionalFields, "Genres")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("optionTitle() / optionValue()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("treats a plain string option as its own query value")
    ' Genres and Years: what the panel shows IS what the request carries.
    @params("Drama")
    @params("1999")
    function _(option)
      m.assertEqual(gridQuery.optionTitle(option), option)
      m.assertEqual(gridQuery.optionValue(option), option)
    end function

    @it("splits label from query value for an AA option")
    ' The 12.0 language filters: the label is a localized language name, the value is
    ' the server's own case-sensitive codes. Sending the label matches nothing.
    function _()
      option = { title: "French", value: "fra,fre" }

      m.assertEqual(gridQuery.optionTitle(option), "French")
      m.assertEqual(gridQuery.optionValue(option), "fra,fre")
    end function

    @it("answers a missing option with an empty string rather than crashing the panel")
    function _()
      m.assertEqual(gridQuery.optionTitle(invalid), "")
      m.assertEqual(gridQuery.optionValue(invalid), "")
    end function

    @it("coerces a numeric option without Str()'s leading space")
    ' Str(1999) is " 1999". An untrimmed value would never match the saved query that
    ' BaseGridView's restore pass compares it against, so the filter would apply and
    ' show no ticks.
    function _()
      m.assertEqual(gridQuery.optionTitle(1999), "1999")
      m.assertEqual(gridQuery.optionValue(1999), "1999")
    end function

    @it("trims whitespace off an option so both sides of the restore match")
    function _()
      m.assertEqual(gridQuery.optionTitle("  Drama  "), "Drama")
      m.assertEqual(gridQuery.optionValue({ title: " French ", value: " fra,fre " }), "fra,fre")
    end function

  end class

end namespace
