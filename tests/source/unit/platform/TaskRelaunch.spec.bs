namespace tests

  ' A RECORD of what Roku OS does when a Task is stopped and launched again — first run on a
  ' Streaming Stick 4K, OS 15.3.4. Every control write happens inside
  ' TaskRelaunchProbeHost through callFunc, so on the render thread, as the app's are.
  '
  ' The result the app DEPENDS on is the first @it: a launch made in the same callback that
  ' stopped a still-running Task is a RACE. It was ignored when this spec ran alone, and it
  ' started in most full-suite runs, on a Stick 4K and on a 512 MB Stick alike. So an
  ' orchestrator that can be restarted mid-run must launch a NEW node (ExtrasRowList.startRun
  ' does) and must not rely on "STOP, then RUN the same node" either way. That case therefore
  ' accepts both outcomes and fails only on a third one. The rest pin the neighbouring cases,
  ' including one more that is NOT safe: launching a still-running node with no STOP at all is
  ' ignored every time. If one goes red on a firmware change, re-examine the callers before
  ' flipping it.
  '
  ' NOT covered: OS versions below 15.3.4, and how SOON after the stopping callback a relaunch
  ' of the same node starts working — a later callback worked here, but nothing may be built
  ' on a delay.
  @suite("Platform - relaunching a stopped Task")
  class TaskRelaunchTests extends tests.BaseTestSuite

    ' Polls `node[field]` until it reaches `expected` or `timeoutMs` passes; returns the last value.
    private function waitForCount(node as object, field as string, expected as integer, timeoutMs as integer) as integer
      clock = CreateObject("roTimespan")
      value = node.getField(field)
      while value < expected and clock.totalMilliseconds() < timeoutMs
        sleep(20)
        value = node.getField(field)
      end while
      return value
    end function

    ' A host whose task function has started and is holding.
    private function runningHost() as object
      host = CreateObject("roSGNode", "TaskRelaunchProbeHost")
      host.callFunc("launch")
      m.assertEqual(m.waitForCount(host.getField("task"), "starts", 1, 2000), 1, "precondition: the task function started")
      return host
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("a task whose function is still running")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("either ignores or honors a launch made in the same callback that stopped it")
    function _()
      host = m.runningHost()
      task = host.getField("task")

      host.callFunc("stopAndRelaunch")

      m.waitForCount(task, "starts", 2, 1000)
      ' Long enough for a second, unwanted start to show up after the first one.
      sleep(300)
      starts = task.starts
      ' Printed so repeated runs show how often each outcome happens.
      print "[TaskRelaunch] same-callback relaunch: starts="; starts; " state="; task.state
      if starts = 1
        m.assertEqual(LCase(task.state), "stop", "the launch was ignored, so the task must stay stopped")
      else
        m.assertEqual(starts, 2, "the function started more than once more")
        m.assertEqual(LCase(task.state), "run", "the launch was honored, so the task must be running")
      end if
      host.callFunc("release")
    end function

    @it("makes no further progress once stopped, even when released")
    function _()
      host = m.runningHost()
      task = host.getField("task")

      host.callFunc("stopTask")
      beatsAtStop = task.beats
      sleep(300)
      m.assertEqual(task.beats, beatsAtStop, "the hold loop kept running after STOP")

      host.callFunc("release")
      m.assertEqual(m.waitForCount(task, "ends", 1, 1000), 0, "the function returned after STOP")
    end function

    ' The same property for how the app's Tasks actually block: `fetchJson` parks in ONE long
    ' wait() inside the pool rather than a poll loop. A new node per run (replaceTask) only
    ' keeps the thread count flat if the stopped run never resumes when that wait expires.
    @it("makes no further progress once stopped while parked in one long wait()")
    function _()
      host = CreateObject("roSGNode", "TaskRelaunchProbeHost")
      host.callFunc("configure", { blockMode: "waitOnce", blockMs: 400, seq: 1 })
      host.callFunc("launch")
      task = host.getField("task")
      m.assertEqual(m.waitForCount(task, "starts", 1, 2000), 1, "precondition: the task function started")

      host.callFunc("stopTask")

      ' Past the end of the wait, so a run that survived the STOP would have returned by now.
      m.assertEqual(m.waitForCount(task, "ends", 1, 900), 0, "the function returned after STOP")
      m.assertEqual(LCase(task.state), "stop")
    end function

    @it("starts a NEW node launched in the same callback that stopped the old one")
    function _()
      host = m.runningHost()

      previous = host.callFunc("stopAndLaunchFresh")
      fresh = host.getField("task")

      m.assertFalse(fresh.isSameNode(previous))
      m.assertEqual(m.waitForCount(fresh, "starts", 1, 1500), 1, "the new node's function did not start")
      m.assertEqual(LCase(fresh.state), "run")
      host.callFunc("release")
    end function

    ' What replaceTask() stakes the thread budget on: a node stopped while parked hands its
    ' thread slot back, so replacing one node per run cannot stack threads toward Roku's
    ' 100-thread `&h29` cap. A wait with NO timeout is the worst case, since nothing but the
    ' STOP can end it. 110 launches is past the cap; the rate and the live-thread control that
    ' proves this instrument can see the cap are in TaskThreadSlots.spec.bs.
    @it("frees the thread slot of a node stopped while parked in a wait() with no timeout")
    function _()
      host = CreateObject("roSGNode", "TaskRelaunchProbeHost")
      for i = 1 to 110
        launch = host.callFunc("launchHeld", { blockMode: "waitForever", blockMs: 0 })
        m.assertTrue(launch.ok, "launch " + i.toStr() + " was refused: " + (launch.message ?? ""))
        if not launch.ok then exit for
        m.assertEqual(m.waitForCount(launch.node, "starts", 1, 2000), 1, "precondition: the task function started")
        ' `starts` is written just before the block; let the thread reach it.
        sleep(50)
        host.callFunc("stopHeldLast")
      end for
      host.callFunc("dropHeld")
    end function

    @it("relaunches from a later callback")
    function _()
      host = m.runningHost()
      task = host.getField("task")

      host.callFunc("stopTask")
      sleep(300)
      host.callFunc("launch")

      m.assertEqual(m.waitForCount(task, "starts", 2, 1500), 2)
      host.callFunc("release")
    end function

    ' The everyday shape of a site that keeps one Task node for its whole life: write the input,
    ' launch, no STOP — from a later callback, while the previous run is still going. The launch
    ' is IGNORED: nothing starts now, nothing starts when the running function returns, and the
    ' running function finishes against whatever it already read. Deterministic, unlike the
    ' STOP case above — 40 of 40 trials on a Stick 4K and a 512 MB Stick (threading.md). A site
    ' that can launch again mid-run therefore loses the newer request; give it a new node.
    @it("ignores a launch with no stop, made from a later callback while it runs")
    function _()
      host = m.runningHost()
      task = host.getField("task")

      host.callFunc("writeAndLaunch", 2)
      m.assertEqual(task.seq, 2, "precondition: writeAndLaunch ran (the input write landed)")

      m.assertEqual(m.waitForCount(task, "starts", 2, 600), 1, "the launch started a second run while the first was running")
      host.callFunc("release")
      m.assertEqual(m.waitForCount(task, "ends", 1, 1500), 1, "precondition: the running function returned")
      ' Long enough for a launch queued behind the first run to start.
      sleep(600)
      m.assertEqual(task.starts, 1, "the launch was queued and started after the first run returned")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("a task whose function has returned")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    ' The everyday Refresh: the previous run finished long before the press.
    @it("relaunches from the same callback that stops it")
    function _()
      host = m.runningHost()
      task = host.getField("task")
      host.callFunc("release")
      m.assertEqual(m.waitForCount(task, "ends", 1, 1500), 1, "precondition: the function returned")
      task.release = false

      host.callFunc("stopAndRelaunch")

      m.assertEqual(m.waitForCount(task, "starts", 2, 1500), 2)
      host.callFunc("release")
    end function

  end class

end namespace
