namespace tests

  @suite("DebugFlags - Node interface and defaults")
  class DebugFlagsTests extends tests.BaseTestSuite

    private debugNode as object

    protected override function setup()
      super.setup()
      m.debugNode = CreateObject("roSGNode", "DebugFlags")
    end function

    protected override function teardown()
      m.debugNode = invalid
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Interface fields exist")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("has shouldForceFiltersFail field")
    function _()
      m.assertTrue(m.debugNode.doesExist("shouldForceFiltersFail"))
    end function

    @it("has shouldForceFavoriteFail field")
    function _()
      m.assertTrue(m.debugNode.doesExist("shouldForceFavoriteFail"))
    end function

    @it("has shouldForceWatchedFail field")
    function _()
      m.assertTrue(m.debugNode.doesExist("shouldForceWatchedFail"))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("All flags default to false")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("shouldForceFiltersFail defaults to false")
    function _()
      m.assertFalse(m.debugNode.shouldForceFiltersFail)
    end function

    @it("shouldForceFavoriteFail defaults to false")
    function _()
      m.assertFalse(m.debugNode.shouldForceFavoriteFail)
    end function

    @it("shouldForceWatchedFail defaults to false")
    function _()
      m.assertFalse(m.debugNode.shouldForceWatchedFail)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Flags can be toggled")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("shouldForceFiltersFail can be set to true and back to false")
    function _()
      m.debugNode.shouldForceFiltersFail = true
      m.assertTrue(m.debugNode.shouldForceFiltersFail)
      m.debugNode.shouldForceFiltersFail = false
      m.assertFalse(m.debugNode.shouldForceFiltersFail)
    end function

    @it("shouldForceFavoriteFail can be set to true and back to false")
    function _()
      m.debugNode.shouldForceFavoriteFail = true
      m.assertTrue(m.debugNode.shouldForceFavoriteFail)
      m.debugNode.shouldForceFavoriteFail = false
      m.assertFalse(m.debugNode.shouldForceFavoriteFail)
    end function

    @it("shouldForceWatchedFail can be set to true and back to false")
    function _()
      m.debugNode.shouldForceWatchedFail = true
      m.assertTrue(m.debugNode.shouldForceWatchedFail)
      m.debugNode.shouldForceWatchedFail = false
      m.assertFalse(m.debugNode.shouldForceWatchedFail)
    end function

  end class

end namespace
