namespace tests

  @suite("GetFiltersTask - Interface and field defaults")
  class GetFiltersTaskTests extends tests.BaseTestSuite

    private task as object

    protected override function setup()
      super.setup()
      m.task = CreateObject("roSGNode", "GetFiltersTask")
    end function

    protected override function teardown()
      if isValid(m.task)
        m.task.control = "stop"
      end if
      m.task = invalid
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Interface fields")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("has params field")
    function _()
      m.assertTrue(m.task.doesExist("params"))
    end function

    @it("has filters field")
    function _()
      m.assertTrue(m.task.doesExist("filters"))
    end function

    @it("has error field")
    function _()
      m.assertTrue(m.task.doesExist("error"))
    end function

    @it("error field defaults to empty string")
    function _()
      m.assertEqual(m.task.error, "")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Observer reliability - filters always fires")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("fires observer when filters is set to real data")
    function _()
      m.task.observeField("filters", "onFiltersChanged")
      m.task.filters = { Genres: ["Action", "Comedy"] }

      m.assertNotInvalid(m.task.filters)
      m.assertAAHasKey(m.task.filters, "Genres")
    end function

    @it("fires observer when filters is set to empty AA on failure")
    function _()
      m.task.observeField("filters", "onFiltersChanged")
      m.task.filters = {}

      m.assertNotInvalid(m.task.filters)
    end function

    @it("error field can be set with message")
    function _()
      m.task.error = "Unable to load filter options"
      m.assertEqual(m.task.error, "Unable to load filter options")
    end function

  end class

end namespace
