import "pkg:/source/utils/buttonOverflow.bs"
import "pkg:/source/utils/misc.bs"

namespace tests

  ' The spare-button padder, tested through its PURE half.
  '
  ' This suite is the reason that half exists. The behaviour it covers used to live
  ' entirely inside `#if debug`, which the device strips from every test build — so
  ' the accumulation bug below shipped, and proving the fix required hand-editing
  ' the manifest and throwing the spec away afterwards. Splitting the logic out
  ' means these assertions run in EVERY build, including the coverage ones.
  @suite("buttonOverflow - debug spare buttons")
  class DebugSpareButtonsTests extends tests.BaseTestSuite

    private group as object

    ' beforeEach, not setup: every test mutates the group (tests/CLAUDE.md).
    protected override sub beforeEach()
      super.beforeEach()
      m.group = CreateObject("roSGNode", "Group")
    end sub

    protected override sub afterEach()
      m.group = invalid
      super.afterEach()
    end sub

    private sub addRealButtons(count as integer)
      for i = 0 to count - 1
        button = CreateObject("roSGNode", "IconButton")
        button.id = "real" + stri(i).trim()
        m.group.appendChild(button)
      end for
    end sub

    private function ids() as object
      out = []
      for i = 0 to m.group.getChildCount() - 1
        out.push(m.group.getChild(i).id)
      end for
      return out
    end function

    private function spareCount() as integer
      n = 0
      for i = 0 to m.group.getChildCount() - 1
        if Left(m.group.getChild(i).id, Len(DEBUG_SPARE_ID_PREFIX)) = DEBUG_SPARE_ID_PREFIX then n++
      end for
      return n
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("removeChildrenWithIdPrefix()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    ' The reverse-iteration case: a forward loop skips the element after each
    ' removal, so ADJACENT matches are what catches that mistake.
    @it("removes every match, including adjacent ones")
    function _()
      m.addRealButtons(1)
      syncDebugSpareButtons(m.group, 3)
      m.assertEqual(m.group.getChildCount(), 4)

      removeChildrenWithIdPrefix(m.group, DEBUG_SPARE_ID_PREFIX)

      m.assertEqual(m.ids(), ["real0"], "every spare must go, and nothing else")
    end function

    @it("leaves non-matching children untouched")
    function _()
      m.addRealButtons(3)
      removeChildrenWithIdPrefix(m.group, DEBUG_SPARE_ID_PREFIX)
      m.assertEqual(m.ids(), ["real0", "real1", "real2"])
    end function

    @it("does nothing, and does not crash, on invalid input")
    function _()
      removeChildrenWithIdPrefix(invalid, DEBUG_SPARE_ID_PREFIX)
      removeChildrenWithIdPrefix(m.group, "")
      m.assertEqual(m.group.getChildCount(), 0)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("syncDebugSpareButtons() - converges, never accumulates")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("appends exactly the requested count")
    function _()
      syncDebugSpareButtons(m.group, 3)
      m.assertEqual(m.spareCount(), 3)
    end function

    ' THE REGRESSION. OSD.setButtonStates() runs again on every item change — for
    ' live TV, every program boundary — and does not clear its row first. The
    ' original append-only version grew the row by `count` each pass.
    @it("stays at the requested count across repeated calls")
    function _()
      m.addRealButtons(2)
      for each pass in [1, 2, 3]
        syncDebugSpareButtons(m.group, 2)
        m.assertEqual(m.spareCount(), 2, "pass " + stri(pass).trim() + " must not accumulate")
        m.assertEqual(m.group.getChildCount(), 4, "and must not disturb the real buttons")
      end for
    end function

    @it("converges downward when the count drops")
    function _()
      syncDebugSpareButtons(m.group, 5)
      syncDebugSpareButtons(m.group, 2)
      m.assertEqual(m.spareCount(), 2)
    end function

    ' Lowering the flag to 0 must actually clear the row — the clear runs BEFORE
    ' the zero-return, which is the only reason this passes.
    @it("clears the spares entirely at a count of 0")
    function _()
      m.addRealButtons(1)
      syncDebugSpareButtons(m.group, 4)
      syncDebugSpareButtons(m.group, 0)

      m.assertEqual(m.spareCount(), 0, "a count of 0 must remove the spares, not strand them")
      m.assertEqual(m.ids(), ["real0"])
    end function

    @it("treats a negative count as zero")
    function _()
      syncDebugSpareButtons(m.group, 3)
      syncDebugSpareButtons(m.group, -1)
      m.assertEqual(m.spareCount(), 0)
    end function

    @it("does nothing, and does not crash, on an invalid group")
    function _()
      syncDebugSpareButtons(invalid, 3)
      m.assertEqual(m.group.getChildCount(), 0)
    end function

  end class

end namespace
