import "pkg:/source/utils/rowItemText.bs"

namespace tests

  @suite("rowItemText - Row item title and subtitle helpers")
  class RowItemTextTests extends tests.BaseTestSuite

    protected override function setup()
      super.setup()
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("getRowItemTitle()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("returns chapter name for Chapter")
    function _()
      item = CreateObject("roSGNode", "JellyfinBaseItem")
      item.id = "mov1"
      item.type = "Chapter"
      item.name = "Opening Credits"
      item.subtitle = "0:00"
      m.assertEqual(getRowItemTitle(item), "Opening Credits")
    end function

    @it("returns episode code and title (subtitle field) for Episode")
    function _()
      item = CreateObject("roSGNode", "JellyfinBaseItem")
      item.id = "ep1"
      item.type = "Episode"
      item.subtitle = "S1E1 - Pilot"
      item.seriesName = "Breaking Bad"
      m.assertEqual(getRowItemTitle(item), "S1E1 - Pilot")
    end function

    @it("returns season label (name field) for Season")
    function _()
      item = CreateObject("roSGNode", "JellyfinBaseItem")
      item.id = "s1"
      item.type = "Season"
      item.name = "Season 1"
      item.subtitle = "Breaking Bad" ' transformer stores seriesName in subtitle (shown below)
      m.assertEqual(getRowItemTitle(item), "Season 1")
    end function

    @it("returns name for Movie")
    function _()
      item = CreateObject("roSGNode", "JellyfinBaseItem")
      item.id = "m1"
      item.type = "Movie"
      item.name = "The Matrix"
      m.assertEqual(getRowItemTitle(item), "The Matrix")
    end function

    @it("returns name for Series")
    function _()
      item = CreateObject("roSGNode", "JellyfinBaseItem")
      item.id = "ser1"
      item.type = "Series"
      item.name = "Game of Thrones"
      m.assertEqual(getRowItemTitle(item), "Game of Thrones")
    end function

    @it("returns name for MusicAlbum")
    function _()
      item = CreateObject("roSGNode", "JellyfinBaseItem")
      item.id = "alb1"
      item.type = "MusicAlbum"
      item.name = "Dark Side of the Moon"
      m.assertEqual(getRowItemTitle(item), "Dark Side of the Moon")
    end function

    @it("returns name for CollectionFolder")
    function _()
      item = CreateObject("roSGNode", "JellyfinBaseItem")
      item.id = "lib1"
      item.type = "CollectionFolder"
      item.name = "Movies"
      m.assertEqual(getRowItemTitle(item), "Movies")
    end function

    @it("returns name for BoxSet")
    function _()
      item = CreateObject("roSGNode", "JellyfinBaseItem")
      item.id = "bs1"
      item.type = "BoxSet"
      item.name = "Marvel Collection"
      m.assertEqual(getRowItemTitle(item), "Marvel Collection")
    end function

    @it("returns prefixed track number and name for Audio with indexNumber > 0")
    function _()
      item = CreateObject("roSGNode", "JellyfinBaseItem")
      item.id = "aud1"
      item.type = "Audio"
      item.name = "Yesterday"
      item.indexNumber = 3
      m.assertEqual(getRowItemTitle(item), "3. Yesterday")
    end function

    @it("returns name for Audio with indexNumber = 0 (no prefix)")
    function _()
      item = CreateObject("roSGNode", "JellyfinBaseItem")
      item.id = "aud2"
      item.type = "Audio"
      item.name = "Hey Jude"
      item.indexNumber = 0
      m.assertEqual(getRowItemTitle(item), "Hey Jude")
    end function

    @it("returns name for Audio with unset indexNumber (defaults to 0)")
    function _()
      item = CreateObject("roSGNode", "JellyfinBaseItem")
      item.id = "aud3"
      item.type = "Audio"
      item.name = "Let It Be"
      m.assertEqual(getRowItemTitle(item), "Let It Be")
    end function

    @it("returns empty string for invalid item")
    function _()
      m.assertEqual(getRowItemTitle(invalid), "")
    end function

    @it("returns empty string for Episode with no subtitle")
    function _()
      item = CreateObject("roSGNode", "JellyfinBaseItem")
      item.id = "ep1"
      item.type = "Episode"
      ' subtitle defaults to "" in JellyfinBaseItem
      m.assertEqual(getRowItemTitle(item), "")
    end function

    @it("returns season name for Season regardless of subtitle field")
    function _()
      item = CreateObject("roSGNode", "JellyfinBaseItem")
      item.id = "s1"
      item.type = "Season"
      item.name = "Season 1"
      ' subtitle may be empty (e.g. series name not yet populated) — title always comes from name
      m.assertEqual(getRowItemTitle(item), "Season 1")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("getRowItemSubtitle()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("returns timestamp subtitle for Chapter")
    function _()
      item = CreateObject("roSGNode", "JellyfinBaseItem")
      item.id = "mov1"
      item.type = "Chapter"
      item.name = "The Battle"
      item.subtitle = "1:23:45"
      m.assertEqual(getRowItemSubtitle(item), "1:23:45")
    end function

    @it("returns series name (subtitle field) for Season")
    function _()
      item = CreateObject("roSGNode", "JellyfinBaseItem")
      item.id = "s1"
      item.type = "Season"
      item.name = "Season 1"
      item.subtitle = "Breaking Bad" ' transformer stores seriesName in subtitle
      m.assertEqual(getRowItemSubtitle(item), "Breaking Bad")
    end function

    @it("returns series name for Episode")
    function _()
      item = CreateObject("roSGNode", "JellyfinBaseItem")
      item.id = "ep1"
      item.type = "Episode"
      item.subtitle = "S1E2 - Cat's in the Bag"
      item.seriesName = "Breaking Bad"
      m.assertEqual(getRowItemSubtitle(item), "Breaking Bad")
    end function

    @it("returns pre-computed subtitle for Movie")
    function _()
      item = CreateObject("roSGNode", "JellyfinBaseItem")
      item.id = "m1"
      item.type = "Movie"
      item.subtitle = "2024 • PG-13"
      m.assertEqual(getRowItemSubtitle(item), "2024 • PG-13")
    end function

    @it("returns pre-computed subtitle for Series")
    function _()
      item = CreateObject("roSGNode", "JellyfinBaseItem")
      item.id = "ser1"
      item.type = "Series"
      item.subtitle = "2020 - Present"
      m.assertEqual(getRowItemSubtitle(item), "2020 - Present")
    end function

    @it("returns pre-computed subtitle for MusicAlbum")
    function _()
      item = CreateObject("roSGNode", "JellyfinBaseItem")
      item.id = "alb1"
      item.type = "MusicAlbum"
      item.subtitle = "Pink Floyd"
      m.assertEqual(getRowItemSubtitle(item), "Pink Floyd")
    end function

    @it("returns empty string for invalid item")
    function _()
      m.assertEqual(getRowItemSubtitle(invalid), "")
    end function

    @it("returns empty string for item with no subtitle")
    function _()
      item = CreateObject("roSGNode", "JellyfinBaseItem")
      item.id = "m1"
      item.type = "Movie"
      ' subtitle defaults to "" in JellyfinBaseItem
      m.assertEqual(getRowItemSubtitle(item), "")
    end function

    @it("Season subtitle returns series name from subtitle field, not its own name")
    function _()
      item = CreateObject("roSGNode", "JellyfinBaseItem")
      item.id = "s2"
      item.type = "Season"
      item.name = "Season 2"
      item.subtitle = "Breaking Bad"
      ' Subtitle should return "Breaking Bad" (series name), NOT "Season 2" (name, shown as title)
      m.assertEqual(getRowItemSubtitle(item), "Breaking Bad")
    end function

  end class

end namespace
