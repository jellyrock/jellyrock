import "pkg:/source/utils/serverCapabilities.bs"

' Unit tests for server plugin capabilities.
'
' The reply shape is /Libraries/AvailableOptions' LibraryOptionsResultDto, whose
' SubtitleFetchers lists installed subtitle provider plugins. That was read from
' Jellyfin's LibraryController at 10.7.0 through 12.0, and confirmed live against the public
' demo (12.0), which returns an empty list.

namespace tests

  @suite("serverCapabilities - plugin-dependent features")
  class ServerCapabilitiesTests extends tests.BaseTestSuite

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("subtitleProviderStatusFrom()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("is available when any subtitle provider is installed")
    function _()
      res = { ok: true, json: { SubtitleFetchers: [{ Name: "Open Subtitles", DefaultEnabled: true }] } }
      m.assertEqual(serverCapabilities.subtitleProviderStatusFrom(res), serverCapabilities.STATUS_AVAILABLE)
    end function

    @it("is unavailable when the server lists none")
    function _()
      res = { ok: true, json: { SubtitleFetchers: [] } }
      m.assertEqual(serverCapabilities.subtitleProviderStatusFrom(res), serverCapabilities.STATUS_UNAVAILABLE)
    end function

    @it("is unknown when the reply does not answer the question")
    function _()
      ' Unknown is never stored, so a failed check is retried instead of hiding the
      ' feature for the rest of the session.
      m.assertEqual(serverCapabilities.subtitleProviderStatusFrom({ ok: false, json: invalid }), serverCapabilities.STATUS_UNKNOWN)
      m.assertEqual(serverCapabilities.subtitleProviderStatusFrom({ ok: true, json: invalid }), serverCapabilities.STATUS_UNKNOWN)
      m.assertEqual(serverCapabilities.subtitleProviderStatusFrom({ ok: true, json: {} }), serverCapabilities.STATUS_UNKNOWN)
      m.assertEqual(serverCapabilities.subtitleProviderStatusFrom({ ok: true, json: { SubtitleFetchers: "x" } }), serverCapabilities.STATUS_UNKNOWN)
      m.assertEqual(serverCapabilities.subtitleProviderStatusFrom(invalid), serverCapabilities.STATUS_UNKNOWN)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("shouldOfferSubtitleSearch() - this capability fails open")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("hides the feature only on a definite unavailable")
    function _()
      m.assertFalse(serverCapabilities.shouldOfferSubtitleSearch(serverCapabilities.STATUS_UNAVAILABLE))
      m.assertTrue(serverCapabilities.shouldOfferSubtitleSearch(serverCapabilities.STATUS_AVAILABLE))
    end function

    @it("offers the feature when the check failed")
    function _()
      m.assertTrue(serverCapabilities.shouldOfferSubtitleSearch(serverCapabilities.STATUS_UNKNOWN))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("serverEncodesHevcInHardware()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    private function policy(hardwareType as dynamic, enableHardware as dynamic, allowHevc as dynamic) as object
      return { HardwareAccelerationType: hardwareType, EnableHardwareEncoding: enableHardware, AllowHevcEncoding: allowHevc }
    end function

    @it("is true for NVENC with hardware encoding and HEVC encoding on")
    function _()
      m.assertTrue(serverCapabilities.serverEncodesHevcInHardware(m.policy("nvenc", true, true)))
    end function

    @it("is false when the acceleration type is none, even with both switches on")
    function _()
      m.assertFalse(serverCapabilities.serverEncodesHevcInHardware(m.policy("none", true, true)))
    end function

    @it("is false for QSV when HEVC encoding is off")
    function _()
      m.assertFalse(serverCapabilities.serverEncodesHevcInHardware(m.policy("qsv", true, false)))
    end function

    @it("is false when hardware encoding is off")
    function _()
      m.assertFalse(serverCapabilities.serverEncodesHevcInHardware(m.policy("nvenc", false, true)))
    end function

    @it("is false for an unknown policy or a field of the wrong type")
    function _()
      m.assertFalse(serverCapabilities.serverEncodesHevcInHardware(invalid))
      m.assertFalse(serverCapabilities.serverEncodesHevcInHardware({}))
      m.assertFalse(serverCapabilities.serverEncodesHevcInHardware(m.policy(invalid, true, true)))
      m.assertFalse(serverCapabilities.serverEncodesHevcInHardware(m.policy("nvenc", "true", true)))
      m.assertFalse(serverCapabilities.serverEncodesHevcInHardware(m.policy("nvenc", true, invalid)))
      m.assertFalse(serverCapabilities.serverEncodesHevcInHardware(m.policy("", true, true)))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("encodingPolicyFrom()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("keeps the three fields of a complete reply")
    function _()
      res = { ok: true, json: { HardwareAccelerationType: "nvenc", EnableHardwareEncoding: true, AllowHevcEncoding: false, EncodingThreadCount: -1 } }
      policy = serverCapabilities.encodingPolicyFrom(res)
      m.assertEqual(policy.HardwareAccelerationType, "nvenc")
      m.assertTrue(policy.EnableHardwareEncoding)
      m.assertFalse(policy.AllowHevcEncoding)
      m.assertFalse(policy.doesExist("EncodingThreadCount"))
    end function

    @it("is invalid when the reply does not answer both switches")
    function _()
      m.assertInvalid(serverCapabilities.encodingPolicyFrom({ ok: false, json: invalid }))
      m.assertInvalid(serverCapabilities.encodingPolicyFrom({ ok: true, json: {} }))
      m.assertInvalid(serverCapabilities.encodingPolicyFrom({ ok: true, json: { HardwareAccelerationType: "nvenc", EnableHardwareEncoding: true } }))
      m.assertInvalid(serverCapabilities.encodingPolicyFrom({ ok: true, json: { HardwareAccelerationType: "nvenc", AllowHevcEncoding: true } }))
      m.assertInvalid(serverCapabilities.encodingPolicyFrom(invalid))
    end function

    @it("reads a missing hardware type as none, as a server before 10.10 sends until its Transcoding page is saved")
    function _()
      ' The reply of a new 10.8.13 server after its setup wizard: no HardwareAccelerationType.
      res = { ok: true, json: { EncodingThreadCount: -1, EnableHardwareEncoding: true, AllowHevcEncoding: false } }
      policy = serverCapabilities.encodingPolicyFrom(res)

      m.assertEqual(policy.HardwareAccelerationType, "none")
      m.assertFalse(serverCapabilities.serverEncodesHevcInHardware(policy))
    end function

    @it("reads a missing hardware type as none even with both switches on, as a new 10.7.7 server sends")
    function _()
      policy = serverCapabilities.encodingPolicyFrom({ ok: true, json: { EnableHardwareEncoding: true, AllowHevcEncoding: true } })

      m.assertEqual(policy.HardwareAccelerationType, "none")
      m.assertFalse(serverCapabilities.serverEncodesHevcInHardware(policy))
    end function

    @it("keeps the dashboard's empty None, which is not hardware")
    function _()
      policy = serverCapabilities.encodingPolicyFrom({ ok: true, json: { HardwareAccelerationType: "", EnableHardwareEncoding: true, AllowHevcEncoding: true } })

      m.assertEqual(policy.HardwareAccelerationType, "")
      m.assertFalse(serverCapabilities.serverEncodesHevcInHardware(policy))
    end function

    @it("is invalid for a hardware type that is not a string")
    function _()
      m.assertInvalid(serverCapabilities.encodingPolicyFrom({ ok: true, json: { HardwareAccelerationType: 3, EnableHardwareEncoding: true, AllowHevcEncoding: true } }))
    end function

  end class

end namespace
