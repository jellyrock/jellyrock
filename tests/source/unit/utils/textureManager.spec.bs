
namespace tests

  @suite("textureManager.bs - Texture Manager Utilities")
  class TextureManagerTests extends tests.BaseTestSuite

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("calculateTextureVisibleWidth()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("calculates visible width from itemSize minus focusXOffset")
    function _()
      m.assertEqual(calculateTextureVisibleWidth([1920, 441], [96]), 1824)
    end function

    @it("uses full itemSize width when focusXOffset is empty")
    function _()
      m.assertEqual(calculateTextureVisibleWidth([1703, 441], []), 1703)
    end function

    @it("falls back to 1920 when itemSize is invalid")
    function _()
      m.assertEqual(calculateTextureVisibleWidth(invalid, [96]), 1824)
    end function

    @it("falls back to 1920 when itemSize is empty array")
    function _()
      m.assertEqual(calculateTextureVisibleWidth([], []), 1920)
    end function

    @it("handles invalid focusXOffset gracefully")
    function _()
      m.assertEqual(calculateTextureVisibleWidth([1920, 441], invalid), 1920)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("calculateTextureItemSpacing()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("extracts spacing from flat pair [x, y]")
    function _()
      m.assertEqual(calculateTextureItemSpacing([30, 0]), 30)
    end function

    @it("extracts spacing from nested pair [[x, y]]")
    function _()
      m.assertEqual(calculateTextureItemSpacing([[20, 0]]), 20)
    end function

    @it("returns 0 for empty array")
    function _()
      m.assertEqual(calculateTextureItemSpacing([]), 0)
    end function

    @it("returns 0 for invalid input")
    function _()
      m.assertEqual(calculateTextureItemSpacing(invalid), 0)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("initTextureManager()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("adds texture fields to content root")
    function _()
      root = CreateObject("roSGNode", "ContentNode")
      initTextureManager(root, [1920, 441], [96], [30, 0])
      m.assertTrue(root.hasField("loadedRowRange"))
      m.assertTrue(root.hasField("focusedColumns"))
      m.assertTrue(root.hasField("textureVisibleWidth"))
      m.assertTrue(root.hasField("textureItemSpacing"))
      m.assertTrue(root.hasField("textureManagerState"))
      m.assertEqual(root.textureManagerState, "init")
      m.assertEqual(root.textureVisibleWidth, 1824)
      m.assertEqual(root.textureItemSpacing, 30)
    end function

    @it("resets state to init on re-init")
    function _()
      root = CreateObject("roSGNode", "ContentNode")
      initTextureManager(root, [1920, 441], [96], [30, 0])
      activateTextureManager(root)
      m.assertEqual(root.textureManagerState, "active")
      initTextureManager(root, [1703, 441], [], [20, 0])
      m.assertEqual(root.textureManagerState, "init")
      m.assertEqual(root.textureVisibleWidth, 1703)
    end function

    @it("handles invalid contentRoot gracefully")
    function _()
      initTextureManager(invalid, [1920, 441], [96], [30, 0])
      ' Should not crash
      m.assertTrue(true)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("activateTextureManager()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("sets state to active")
    function _()
      root = CreateObject("roSGNode", "ContentNode")
      initTextureManager(root, [1920, 441], [96], [30, 0])
      m.assertEqual(root.textureManagerState, "init")
      activateTextureManager(root)
      m.assertEqual(root.textureManagerState, "active")
    end function

    @it("handles invalid contentRoot gracefully")
    function _()
      activateTextureManager(invalid)
      m.assertTrue(true)
    end function

    @it("handles contentRoot without textureManagerState field")
    function _()
      root = CreateObject("roSGNode", "ContentNode")
      activateTextureManager(root)
      m.assertTrue(true)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("hideTextureManager()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("sets state to hidden")
    function _()
      root = CreateObject("roSGNode", "ContentNode")
      initTextureManager(root, [1920, 441], [96], [30, 0])
      activateTextureManager(root)
      hideTextureManager(root)
      m.assertEqual(root.textureManagerState, "hidden")
    end function

    @it("handles invalid contentRoot gracefully")
    function _()
      hideTextureManager(invalid)
      m.assertTrue(true)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("destroyTextureManager()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("sets state to destroyed")
    function _()
      root = CreateObject("roSGNode", "ContentNode")
      initTextureManager(root, [1920, 441], [96], [30, 0])
      activateTextureManager(root)
      destroyTextureManager(root)
      m.assertEqual(root.textureManagerState, "destroyed")
    end function

    @it("handles invalid contentRoot gracefully")
    function _()
      destroyTextureManager(invalid)
      m.assertTrue(true)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("updateTextureBufferRange()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("sets correct range for focused row 0 with 3 visible rows")
    function _()
      root = CreateObject("roSGNode", "ContentNode")
      initTextureManager(root, [1920, 441], [96], [30, 0])
      for i = 0 to 4
        root.createChild("ContentNode")
      end for
      updateTextureBufferRange(root, 0, 0, 3)
      m.assertEqual(root.loadedRowRange, [0, 0, 2, 4])
    end function

    @it("sets correct range for focused row 2 with 3 visible rows")
    function _()
      root = CreateObject("roSGNode", "ContentNode")
      initTextureManager(root, [1920, 441], [96], [30, 0])
      for i = 0 to 6
        root.createChild("ContentNode")
      end for
      updateTextureBufferRange(root, 2, 0, 3)
      m.assertEqual(root.loadedRowRange, [0, 2, 4, 6])
    end function

    @it("clamps buffer to total row count")
    function _()
      root = CreateObject("roSGNode", "ContentNode")
      initTextureManager(root, [1920, 441], [96], [30, 0])
      for i = 0 to 2
        root.createChild("ContentNode")
      end for
      updateTextureBufferRange(root, 1, 0, 3)
      m.assertEqual(root.loadedRowRange, [0, 1, 2, 2])
    end function

    @it("handles invalid focusedRow gracefully")
    function _()
      root = CreateObject("roSGNode", "ContentNode")
      initTextureManager(root, [1920, 441], [96], [30, 0])
      for i = 0 to 4
        root.createChild("ContentNode")
      end for
      updateTextureBufferRange(root, invalid, 0, 3)
      m.assertEqual(root.loadedRowRange, [-1, -1, -1, -1])
    end function

    @it("handles invalid focusedColumn gracefully")
    function _()
      root = CreateObject("roSGNode", "ContentNode")
      initTextureManager(root, [1920, 441], [96], [30, 0])
      for i = 0 to 4
        root.createChild("ContentNode")
      end for
      updateTextureBufferRange(root, 0, invalid, 3)
      m.assertEqual(root.loadedRowRange, [-1, -1, -1, -1])
    end function

    @it("resets stale range when focusedRow becomes invalid")
    function _()
      root = CreateObject("roSGNode", "ContentNode")
      initTextureManager(root, [1920, 441], [96], [30, 0])
      for i = 0 to 4
        root.createChild("ContentNode")
      end for
      ' Set a valid range first
      updateTextureBufferRange(root, 0, 0, 3)
      m.assertNotEqual(root.loadedRowRange, [-1, -1, -1, -1])
      ' Now pass invalid focusedRow — should reset, not retain stale range
      updateTextureBufferRange(root, invalid, 0, 3)
      m.assertEqual(root.loadedRowRange, [-1, -1, -1, -1])
    end function

    @it("resets stale range when focusedColumn becomes invalid")
    function _()
      root = CreateObject("roSGNode", "ContentNode")
      initTextureManager(root, [1920, 441], [96], [30, 0])
      for i = 0 to 4
        root.createChild("ContentNode")
      end for
      ' Set a valid range first
      updateTextureBufferRange(root, 0, 0, 3)
      m.assertNotEqual(root.loadedRowRange, [-1, -1, -1, -1])
      ' Now pass invalid focusedColumn — should reset, not retain stale range
      updateTextureBufferRange(root, 0, invalid, 3)
      m.assertEqual(root.loadedRowRange, [-1, -1, -1, -1])
    end function

    @it("resets range when focusedRow is negative")
    function _()
      root = CreateObject("roSGNode", "ContentNode")
      initTextureManager(root, [1920, 441], [96], [30, 0])
      for i = 0 to 4
        root.createChild("ContentNode")
      end for
      updateTextureBufferRange(root, -1, 0, 3)
      m.assertEqual(root.loadedRowRange, [-1, -1, -1, -1])
    end function

    @it("resets range when focusedColumn is negative")
    function _()
      root = CreateObject("roSGNode", "ContentNode")
      initTextureManager(root, [1920, 441], [96], [30, 0])
      for i = 0 to 4
        root.createChild("ContentNode")
      end for
      updateTextureBufferRange(root, 0, -1, 3)
      m.assertEqual(root.loadedRowRange, [-1, -1, -1, -1])
    end function

    @it("resets range when focusedRow is out of bounds")
    function _()
      root = CreateObject("roSGNode", "ContentNode")
      initTextureManager(root, [1920, 441], [96], [30, 0])
      for i = 0 to 4
        root.createChild("ContentNode")
      end for
      updateTextureBufferRange(root, 10, 0, 3)
      m.assertEqual(root.loadedRowRange, [-1, -1, -1, -1])
    end function

    @it("tracks focused column per row")
    function _()
      root = CreateObject("roSGNode", "ContentNode")
      initTextureManager(root, [1920, 441], [96], [30, 0])
      for i = 0 to 4
        root.createChild("ContentNode")
      end for
      updateTextureBufferRange(root, 0, 3, 3)
      m.assertEqual(root.focusedColumns[0], 3)
      updateTextureBufferRange(root, 1, 5, 3)
      m.assertEqual(root.focusedColumns[1], 5)
      m.assertEqual(root.focusedColumns[0], 3)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("updateGridTextureBufferRange()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("sets correct range for focused item 0 in a 6-column 3-visible-row grid")
    function _()
      root = CreateObject("roSGNode", "ContentNode")
      initTextureManager(root, invalid, invalid, invalid)
      ' 30 items = 5 rows in a 6-column grid
      for i = 0 to 29
        root.createChild("ContentNode")
      end for
      updateGridTextureBufferRange(root, 0, 6, 3)
      ' focusedRow=0, visible=[0,2], buffer=[0,4]
      m.assertEqual(root.loadedRowRange, [0, 0, 2, 4])
    end function

    @it("sets correct range for focused item in middle of grid")
    function _()
      root = CreateObject("roSGNode", "ContentNode")
      initTextureManager(root, invalid, invalid, invalid)
      ' 60 items = 10 rows in a 6-column grid
      for i = 0 to 59
        root.createChild("ContentNode")
      end for
      ' Focus on item 24 = row 4, visible=[4,6], buffer=[2,8]
      updateGridTextureBufferRange(root, 24, 6, 3)
      m.assertEqual(root.loadedRowRange, [2, 4, 6, 8])
    end function

    @it("clamps buffer to total rows derived from flat item count")
    function _()
      root = CreateObject("roSGNode", "ContentNode")
      initTextureManager(root, invalid, invalid, invalid)
      ' 7 items = 2 rows in a 6-column grid (row 0: 6 items, row 1: 1 item)
      for i = 0 to 6
        root.createChild("ContentNode")
      end for
      ' Focus on item 0 = row 0, visible=[0,1], buffer=[0,1] (only 2 rows exist)
      updateGridTextureBufferRange(root, 0, 6, 3)
      m.assertEqual(root.loadedRowRange, [0, 0, 1, 1])
    end function

    @it("handles partial last row correctly")
    function _()
      root = CreateObject("roSGNode", "ContentNode")
      initTextureManager(root, invalid, invalid, invalid)
      ' 13 items = 3 rows in a 5-column grid (5, 5, 3)
      for i = 0 to 12
        root.createChild("ContentNode")
      end for
      ' Focus on item 5 = row 1, visible=[1,2], buffer=[0,2]
      updateGridTextureBufferRange(root, 5, 5, 2)
      m.assertEqual(root.loadedRowRange, [0, 1, 2, 2])
    end function

    @it("resets range for empty grid")
    function _()
      root = CreateObject("roSGNode", "ContentNode")
      initTextureManager(root, invalid, invalid, invalid)
      updateGridTextureBufferRange(root, 0, 6, 3)
      m.assertEqual(root.loadedRowRange, [-1, -1, -1, -1])
    end function

    @it("resets range for negative focusedIndex")
    function _()
      root = CreateObject("roSGNode", "ContentNode")
      initTextureManager(root, invalid, invalid, invalid)
      for i = 0 to 11
        root.createChild("ContentNode")
      end for
      updateGridTextureBufferRange(root, -1, 6, 3)
      m.assertEqual(root.loadedRowRange, [-1, -1, -1, -1])
    end function

    @it("resets range for out-of-bounds focusedIndex")
    function _()
      root = CreateObject("roSGNode", "ContentNode")
      initTextureManager(root, invalid, invalid, invalid)
      for i = 0 to 11
        root.createChild("ContentNode")
      end for
      updateGridTextureBufferRange(root, 100, 6, 3)
      m.assertEqual(root.loadedRowRange, [-1, -1, -1, -1])
    end function

    @it("handles invalid focusedIndex gracefully")
    function _()
      root = CreateObject("roSGNode", "ContentNode")
      initTextureManager(root, invalid, invalid, invalid)
      for i = 0 to 11
        root.createChild("ContentNode")
      end for
      updateGridTextureBufferRange(root, invalid, 6, 3)
      m.assertEqual(root.loadedRowRange, [-1, -1, -1, -1])
    end function

    @it("handles zero numColumns gracefully")
    function _()
      root = CreateObject("roSGNode", "ContentNode")
      initTextureManager(root, invalid, invalid, invalid)
      for i = 0 to 11
        root.createChild("ContentNode")
      end for
      updateGridTextureBufferRange(root, 0, 0, 3)
      ' Should return early without crashing (numColumns <= 0 guard)
      m.assertEqual(root.loadedRowRange, [-1, -1, -1, -1])
    end function

    @it("resets stale range when focusedIndex becomes invalid")
    function _()
      root = CreateObject("roSGNode", "ContentNode")
      initTextureManager(root, invalid, invalid, invalid)
      for i = 0 to 11
        root.createChild("ContentNode")
      end for
      ' Set a valid range first
      updateGridTextureBufferRange(root, 0, 6, 3)
      m.assertNotEqual(root.loadedRowRange, [-1, -1, -1, -1])
      ' Now pass invalid focusedIndex — should reset, not retain stale range
      updateGridTextureBufferRange(root, invalid, 6, 3)
      m.assertEqual(root.loadedRowRange, [-1, -1, -1, -1])
    end function

    @it("resets stale range when numColumns becomes zero")
    function _()
      root = CreateObject("roSGNode", "ContentNode")
      initTextureManager(root, invalid, invalid, invalid)
      for i = 0 to 11
        root.createChild("ContentNode")
      end for
      ' Set a valid range first
      updateGridTextureBufferRange(root, 0, 6, 3)
      m.assertNotEqual(root.loadedRowRange, [-1, -1, -1, -1])
      ' Now pass numColumns=0 — should reset, not retain stale range
      updateGridTextureBufferRange(root, 0, 0, 3)
      m.assertEqual(root.loadedRowRange, [-1, -1, -1, -1])
    end function

    @it("does not update focusedColumns (no horizontal buffer for grids)")
    function _()
      root = CreateObject("roSGNode", "ContentNode")
      initTextureManager(root, invalid, invalid, invalid)
      for i = 0 to 29
        root.createChild("ContentNode")
      end for
      updateGridTextureBufferRange(root, 15, 6, 3)
      ' focusedColumns should remain empty — grid doesn't track per-row column
      m.assertEqual(root.focusedColumns, [])
    end function

    @it("does not re-set range when values are unchanged")
    function _()
      root = CreateObject("roSGNode", "ContentNode")
      initTextureManager(root, invalid, invalid, invalid)
      for i = 0 to 29
        root.createChild("ContentNode")
      end for
      updateGridTextureBufferRange(root, 0, 6, 3)
      expectedRange = root.loadedRowRange
      ' Call again with same focus — range should be identical
      updateGridTextureBufferRange(root, 1, 6, 3)
      ' Row 0 → row 0 (item 1 is still in row 0), so range unchanged
      m.assertEqual(root.loadedRowRange, expectedRange)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("TEXTURE_BUFFER_THRESHOLD constant")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("is set to 20")
    function _()
      m.assertEqual(TEXTURE_BUFFER_THRESHOLD, 20)
    end function

  end class

end namespace
