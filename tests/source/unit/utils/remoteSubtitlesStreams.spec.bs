import "pkg:/source/utils/remoteSubtitles.bs"

' Unit tests for the remote-subtitle helpers (issue #750).
'
' The permission expectations below are not guesses — they encode a truth table
' measured against a live Jellyfin 10.11.11 server, plus the [Authorize] policy
' attributes read at the v10.7.7 / v10.8.13 / v10.9.11 / v10.10.7 / v10.11.11
' tags. If a future server release changes the gate, these are the tests that
' should fail first.

namespace tests

  @suite("remoteSubtitles - stream diffing")
  class RemoteSubtitlesStreamTests extends tests.BaseTestSuite

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("externalSubtitleStreams() - the delete safety guard")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("returns only external subtitle streams")
    function _()
      streams = [
        { Type: "Subtitle", Index: 0, IsExternal: true, Path: "/m/a.eng.srt" },
        { Type: "Subtitle", Index: 1, IsExternal: false },
        { Type: "Video", Index: 2, IsExternal: false },
        { Type: "Audio", Index: 3, IsExternal: false }
      ]
      result = remoteSubtitles.externalSubtitleStreams(streams)
      m.assertEqual(result.count(), 1)
      m.assertEqual(result[0].Index, 0)
    end function

    @it("excludes an embedded subtitle - deleting it would delete the container")
    function _()
      streams = [{ Type: "Subtitle", Index: 0, IsExternal: false, Path: "/m/movie.mkv" }]
      m.assertEqual(remoteSubtitles.externalSubtitleStreams(streams).count(), 0)
    end function

    @it("excludes a stream whose IsExternal is absent rather than assuming")
    function _()
      streams = [{ Type: "Subtitle", Index: 0, Path: "/m/a.srt" }]
      m.assertEqual(remoteSubtitles.externalSubtitleStreams(streams).count(), 0)
    end function

    @it("returns an empty array for invalid input")
    function _()
      m.assertEqual(remoteSubtitles.externalSubtitleStreams(invalid).count(), 0)
      m.assertEqual(remoteSubtitles.externalSubtitleStreams([]).count(), 0)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("newSubtitleStreams() - the download completion signal")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("detects an added subtitle even though every index shifted")
    function _()
      ' Measured on 10.11.11: an external subtitle is inserted at index 0 and
      ' pushes video/audio down. A diff keyed on Index would report nonsense.
      before = [
        { Type: "Subtitle", Index: 0, IsExternal: true, Path: "/m/a.eng.srt" },
        { Type: "Video", Index: 1 },
        { Type: "Audio", Index: 2 }
      ]
      after = [
        { Type: "Subtitle", Index: 0, IsExternal: true, Path: "/m/a.eng.srt" },
        { Type: "Subtitle", Index: 1, IsExternal: true, Path: "/m/a.fra.srt" },
        { Type: "Video", Index: 2 },
        { Type: "Audio", Index: 3 }
      ]
      added = remoteSubtitles.newSubtitleStreams(before, after)
      m.assertEqual(added.count(), 1)
      m.assertEqual(added[0].Path, "/m/a.fra.srt")
    end function

    @it("returns empty when nothing was added - the silent-failure case")
    function _()
      ' A failed download still returns 204, so 'no new stream' is how the panel
      ' learns it did not work.
      streams = [
        { Type: "Subtitle", Index: 0, IsExternal: true, Path: "/m/a.eng.srt" },
        { Type: "Video", Index: 1 }
      ]
      m.assertEqual(remoteSubtitles.newSubtitleStreams(streams, streams).count(), 0)
    end function

    @it("ignores non-subtitle streams appearing in the after set")
    function _()
      before = [{ Type: "Video", Index: 0 }]
      after = [{ Type: "Video", Index: 0 }, { Type: "Audio", Index: 1 }]
      m.assertEqual(remoteSubtitles.newSubtitleStreams(before, after).count(), 0)
    end function

    @it("treats every subtitle as new when the before set is empty")
    function _()
      after = [{ Type: "Subtitle", Index: 0, IsExternal: true, Path: "/m/a.eng.srt" }]
      m.assertEqual(remoteSubtitles.newSubtitleStreams([], after).count(), 1)
      m.assertEqual(remoteSubtitles.newSubtitleStreams(invalid, after).count(), 1)
    end function

    @it("falls back to title and language when a stream has no path")
    function _()
      before = [{ Type: "Subtitle", Index: 0, DisplayTitle: "English", Language: "eng" }]
      after = [
        { Type: "Subtitle", Index: 0, DisplayTitle: "English", Language: "eng" },
        { Type: "Subtitle", Index: 1, DisplayTitle: "French", Language: "fra" }
      ]
      added = remoteSubtitles.newSubtitleStreams(before, after)
      m.assertEqual(added.count(), 1)
      m.assertEqual(added[0].Language, "fra")
    end function

    @it("returns empty when the after set is invalid")
    function _()
      m.assertEqual(remoteSubtitles.newSubtitleStreams([], invalid).count(), 0)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("subtitleFileTail() - the only discriminator between two subtitles")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("strips the media basename so only the differing suffix is left")
    function _()
      media = "/media/Movies/Sintel (2010)/Sintel.2010.1080p.BluRay.x264-CtrlHD.mkv"
      m.assertEqual(remoteSubtitles.subtitleFileTail("/media/Movies/Sintel (2010)/Sintel.2010.1080p.BluRay.x264-CtrlHD.en.hi.srt", media), ".en.hi.srt")
      m.assertEqual(remoteSubtitles.subtitleFileTail("/media/Movies/Sintel (2010)/Sintel.2010.1080p.BluRay.x264-CtrlHD.en.sdh.srt", media), ".en.sdh.srt")
    end function

    @it("matches the basename case-insensitively - servers do not agree on case")
    function _()
      m.assertEqual(remoteSubtitles.subtitleFileTail("/m/MOVIE.NAME.en.srt", "/m/movie.name.mkv"), ".en.srt")
    end function

    @it("handles Windows server paths, which roPath cannot parse")
    function _()
      m.assertEqual(remoteSubtitles.subtitleFileTail("D:\Media\Movies\Sintel.2010.en.srt", "D:\Media\Movies\Sintel.2010.mkv"), ".en.srt")
    end function

    @it("returns the whole filename when the subtitle does not sit beside the media file")
    function _()
      ' A Subs/ folder or a hand-placed file: there is no redundant prefix to
      ' strip, and the whole name IS what tells it apart.
      m.assertEqual(remoteSubtitles.subtitleFileTail("/media/Movies/Sintel (2010)/Subs/English.srt", "/media/Movies/Sintel (2010)/Sintel.2010.mkv"), "English.srt")
    end function

    @it("returns the whole filename when the media path is missing")
    function _()
      m.assertEqual(remoteSubtitles.subtitleFileTail("/m/a.en.srt", ""), "a.en.srt")
      m.assertEqual(remoteSubtitles.subtitleFileTail("/m/a.en.srt", invalid), "a.en.srt")
    end function

    @it("returns empty when the subtitle has no path at all")
    function _()
      m.assertEqual(remoteSubtitles.subtitleFileTail("", "/m/movie.mkv"), "")
      m.assertEqual(remoteSubtitles.subtitleFileTail(invalid, "/m/movie.mkv"), "")
    end function

    @it("does not strip when the subtitle name merely starts with the same letters")
    function _()
      ' "Sintel.2010" is not a prefix of "Sintel.2011...", so nothing is stripped.
      m.assertEqual(remoteSubtitles.subtitleFileTail("/m/Sintel.2011.en.srt", "/m/Sintel.2010.mkv"), "Sintel.2011.en.srt")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("subtitleStreams() - the DISPLAY set, wider than the delete set")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("includes embedded subtitles, which externalSubtitleStreams() excludes")
    function _()
      ' The real shape that exposed this: 4 subtitle streams, only 1 external.
      ' Listing the external one alone made the panel claim the item had no
      ' subtitles while the detail screen's dropdown offered four.
      streams = [
        { Type: "Video", Index: 0 },
        { Type: "Subtitle", Index: 1, IsExternal: false, Language: "eng" },
        { Type: "Subtitle", Index: 2, IsExternal: false, Language: "eng" },
        { Type: "Subtitle", Index: 3, IsExternal: true, Language: "eng", Path: "/m/movie.en.sdh.srt" },
        { Type: "Subtitle", Index: 4, IsExternal: false, Language: "spa" }
      ]
      m.assertEqual(remoteSubtitles.subtitleStreams(streams).count(), 4)
      m.assertEqual(remoteSubtitles.externalSubtitleStreams(streams).count(), 1)
    end function

    @it("keeps server order and skips non-subtitle streams")
    function _()
      streams = [
        { Type: "Subtitle", Index: 5, IsExternal: true },
        { Type: "Audio", Index: 6 },
        { Type: "Subtitle", Index: 7, IsExternal: false }
      ]
      result = remoteSubtitles.subtitleStreams(streams)
      m.assertEqual(result.count(), 2)
      m.assertEqual(result[0].Index, 5)
      m.assertEqual(result[1].Index, 7)
    end function

    @it("returns empty for an invalid stream list")
    function _()
      m.assertEqual(remoteSubtitles.subtitleStreams(invalid).count(), 0)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("subtitleDropdownEntries() - no two entries may read alike")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("leaves already-distinct embedded entries alone")
    function _()
      ' Embedded is the default state, so tagging every row of an all-embedded
      ' item with "Embedded" says nothing and costs trigger width.
      streams = [
        { Type: "Subtitle", Index: 1, IsExternal: false, Language: "eng", Codec: "subrip" },
        { Type: "Subtitle", Index: 2, IsExternal: false, Language: "spa", Codec: "subrip" }
      ]
      entries = remoteSubtitles.subtitleDropdownEntries(streams, "/m/movie.mkv")
      m.assertEqual(entries[0].title, "English SUBRIP")
      m.assertEqual(entries[1].title, "Spanish SUBRIP")
    end function

    @it("always names an external file, even when nothing else collides")
    function _()
      ' "This is a file you added" is exactly what a user looks for right after
      ' downloading one, and no other field implies it. A purely
      ' collision-driven rule left a downloaded sidecar reading like any other
      ' entry whenever a flag happened to make it unique.
      streams = [
        { Type: "Subtitle", Index: 1, IsExternal: false, Language: "spa", Codec: "subrip" },
        { Type: "Subtitle", Index: 2, IsExternal: true, Language: "eng", Codec: "subrip", IsHearingImpaired: true, Path: "/m/movie.en.sdh.srt" }
      ]
      entries = remoteSubtitles.subtitleDropdownEntries(streams, "/m/movie.mkv")
      m.assertEqual(entries[0].title, "Spanish SUBRIP")
      m.assertEqual(entries[1].title, "English SUBRIP (Hearing impaired)  ·  .en.sdh.srt")
    end function

    @it("separates a downloaded sidecar from the embedded track it matches")
    function _()
      streams = [
        { Type: "Subtitle", Index: 1, IsExternal: false, Language: "eng", Codec: "subrip" },
        { Type: "Subtitle", Index: 2, IsExternal: true, Language: "eng", Codec: "subrip", Path: "/m/movie.en.srt" }
      ]
      entries = remoteSubtitles.subtitleDropdownEntries(streams, "/m/movie.mkv")
      m.assertEqual(entries[0].title, "English SUBRIP  ·  Embedded")
      m.assertEqual(entries[1].title, "English SUBRIP  ·  .en.srt")
    end function

    @it("numbers entries the source segment still cannot separate")
    function _()
      ' Two embedded English tracks are identical in every field the API returns,
      ' so an ordinal is all the data supports. It claims nothing beyond "these
      ' are different tracks".
      streams = [
        { Type: "Subtitle", Index: 1, IsExternal: false, Language: "eng", Codec: "subrip" },
        { Type: "Subtitle", Index: 2, IsExternal: false, Language: "eng", Codec: "subrip" }
      ]
      entries = remoteSubtitles.subtitleDropdownEntries(streams, "/m/movie.mkv")
      m.assertEqual(entries[0].title, "English SUBRIP  ·  Embedded 1")
      m.assertEqual(entries[1].title, "English SUBRIP  ·  Embedded 2")
    end function

    @it("keeps the collapsed trigger free of the disambiguator")
    function _()
      streams = [
        { Type: "Subtitle", Index: 1, IsExternal: false, Language: "eng", Codec: "subrip" },
        { Type: "Subtitle", Index: 2, IsExternal: true, Language: "eng", Codec: "subrip", Path: "/m/movie.en.srt" }
      ]
      entries = remoteSubtitles.subtitleDropdownEntries(streams, "/m/movie.mkv")
      m.assertEqual(entries[0].triggerTitle, "English SUBRIP")
      m.assertEqual(entries[1].triggerTitle, "English SUBRIP")
    end function

    @it("distinguishes embedded tracks by flags before adding a source segment")
    function _()
      streams = [
        { Type: "Subtitle", Index: 1, IsExternal: false, Language: "eng", Codec: "subrip" },
        { Type: "Subtitle", Index: 2, IsExternal: false, Language: "eng", Codec: "subrip", IsHearingImpaired: true }
      ]
      entries = remoteSubtitles.subtitleDropdownEntries(streams, "/m/movie.mkv")
      m.assertEqual(entries[0].title, "English SUBRIP")
      m.assertEqual(entries[1].title, "English SUBRIP (Hearing impaired)")
    end function

    @it("carries the server stream index through for selection")
    function _()
      streams = [{ Type: "Subtitle", Index: 7, IsExternal: false, Language: "eng", Codec: "subrip" }]
      m.assertEqual(remoteSubtitles.subtitleDropdownEntries(streams, "").count(), 1)
      m.assertEqual(remoteSubtitles.subtitleDropdownEntries(streams, "")[0].index, 7)
    end function

    @it("returns empty when the item has no subtitle streams")
    function _()
      m.assertEqual(remoteSubtitles.subtitleDropdownEntries([{ Type: "Audio", Index: 0 }], "").count(), 0)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("subtitleSourceText() - one phrase, shared by panel and dropdown")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("says Embedded for a stream with no file of its own")
    function _()
      m.assertEqual(remoteSubtitles.subtitleSourceText({ IsExternal: false, Path: "/m/movie.mkv" }, "/m/movie.mkv"), "Embedded")
    end function

    @it("gives an external file its differing tail")
    function _()
      m.assertEqual(remoteSubtitles.subtitleSourceText({ IsExternal: true, Path: "/m/movie.en.sdh.srt" }, "/m/movie.mkv"), ".en.sdh.srt")
    end function

    @it("falls back to External when an external stream has no readable path")
    function _()
      m.assertEqual(remoteSubtitles.subtitleSourceText({ IsExternal: true }, "/m/movie.mkv"), "External")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("fileNameFrom() - server paths, not Roku paths")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("takes the last segment of a posix path")
    function _()
      m.assertEqual(remoteSubtitles.fileNameFrom("/media/Movies/x/Sintel.2010.mkv"), "Sintel.2010.mkv")
    end function

    @it("takes the last segment of a windows path")
    function _()
      m.assertEqual(remoteSubtitles.fileNameFrom("D:\Media\Movies\Sintel.2010.mkv"), "Sintel.2010.mkv")
    end function

    @it("returns a bare filename unchanged")
    function _()
      m.assertEqual(remoteSubtitles.fileNameFrom("Sintel.2010.mkv"), "Sintel.2010.mkv")
    end function

    @it("returns empty for a missing or blank path")
    function _()
      m.assertEqual(remoteSubtitles.fileNameFrom(invalid), "")
      m.assertEqual(remoteSubtitles.fileNameFrom(""), "")
      m.assertEqual(remoteSubtitles.fileNameFrom("   "), "")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("fileNameWithoutExtension() - only the LAST dot is the extension")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("keeps every dot a release name carries")
    function _()
      m.assertEqual(remoteSubtitles.fileNameWithoutExtension("Sintel.2010.1080p.BluRay.mkv"), "Sintel.2010.1080p.BluRay")
    end function

    @it("returns the name unchanged when there is no extension")
    function _()
      m.assertEqual(remoteSubtitles.fileNameWithoutExtension("Sintel"), "Sintel")
      m.assertEqual(remoteSubtitles.fileNameWithoutExtension(""), "")
    end function

    @it("keeps a leading-dot name whole rather than reducing it to nothing")
    function _()
      m.assertEqual(remoteSubtitles.fileNameWithoutExtension(".srt"), ".srt")
    end function

  end class

end namespace
