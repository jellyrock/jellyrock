import "pkg:/source/constants/itemTypeOrder.bs"
import "pkg:/source/utils/searchOutcome.bs"

namespace tests

  ' Contract tests for what the search screen shows when a search ends
  ' (source/utils/searchOutcome.bs).
  '
  ' Wrong in one direction, a search that got no answer reads as "No results", so the viewer
  ' believes the server has nothing. Wrong in the other, an answered empty search offers a
  ' retry that can never find anything, or a partial one hides the results that did arrive.
  ' The announcement matters for the same reason: focus stays on the keyboard, so a failed or
  ' empty search the screen reader does not announce is silent.
  @suite("searchOutcome - failed vs partial vs empty search")
  class SearchOutcomeTests extends tests.BaseTestSuite

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("statusOf")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("is ok when every read answered")
    function _()
      m.assertEqual(searchOutcome.statusOf(4, 0), searchOutcome.STATUS_OK)
    end function

    @it("is partial when some reads failed and some answered")
    function _()
      m.assertEqual(searchOutcome.statusOf(4, 1), searchOutcome.STATUS_PARTIAL)
      m.assertEqual(searchOutcome.statusOf(4, 3), searchOutcome.STATUS_PARTIAL)
    end function

    @it("is failed when every read failed")
    function _()
      m.assertEqual(searchOutcome.statusOf(4, 4), searchOutcome.STATUS_FAILED)
      m.assertEqual(searchOutcome.statusOf(3, 3), searchOutcome.STATUS_FAILED)
    end function

    @it("is failed when no read was sent")
    function _()
      m.assertEqual(searchOutcome.statusOf(0, 0), searchOutcome.STATUS_FAILED)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("view")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("shows the results of an answered search, with no toast")
    function _()
      m.assertEqual(searchOutcome.view(searchOutcome.STATUS_OK, 5), { show: searchOutcome.SHOW_RESULTS, toastKey: "", announceKey: "" })
    end function

    @it("shows no results for an answered search that found nothing")
    function _()
      m.assertEqual(searchOutcome.view(searchOutcome.STATUS_OK, 0), { show: searchOutcome.SHOW_EMPTY, toastKey: "", announceKey: translationKeys.MessageSearchNoResults })
    end function

    @it("shows the results of a partial search, with the some-missing toast")
    function _()
      m.assertEqual(searchOutcome.view(searchOutcome.STATUS_PARTIAL, 3), { show: searchOutcome.SHOW_RESULTS, toastKey: translationKeys.MessageSearchPartial, announceKey: "" })
    end function

    @it("shows a partial search that found nothing as failed, never as empty")
    function _()
      m.assertEqual(searchOutcome.view(searchOutcome.STATUS_PARTIAL, 0), { show: searchOutcome.SHOW_FAILED, toastKey: "", announceKey: translationKeys.MessageSearchFailed })
    end function

    @it("shows a failed search as failed")
    function _()
      m.assertEqual(searchOutcome.view(searchOutcome.STATUS_FAILED, 0), { show: searchOutcome.SHOW_FAILED, toastKey: "", announceKey: translationKeys.MessageSearchFailed })
    end function

    @it("shows an unknown or missing status as failed, never as empty")
    function _()
      m.assertEqual(searchOutcome.view(invalid, 0), { show: searchOutcome.SHOW_FAILED, toastKey: "", announceKey: translationKeys.MessageSearchFailed })
      m.assertEqual(searchOutcome.view("somethingNew", 0), { show: searchOutcome.SHOW_FAILED, toastKey: "", announceKey: translationKeys.MessageSearchFailed })
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("canSearchLiveTv")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("searches Live TV for a user with Live TV access")
    function _()
      m.assertTrue(searchOutcome.canSearchLiveTv({ enableLiveTvAccess: true }))
    end function

    @it("does not search Live TV for a user without Live TV access")
    function _()
      m.assertFalse(searchOutcome.canSearchLiveTv({ enableLiveTvAccess: false }))
    end function

    @it("searches Live TV when the policy, or its field, is missing")
    function _()
      m.assertTrue(searchOutcome.canSearchLiveTv(invalid))
      m.assertTrue(searchOutcome.canSearchLiveTv({}))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("LIBRARY_TYPES")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    ' A row type with no read never shows, and one read by two sources shows twice. The row
    ' types are SearchRow's (itemTypeOrder.SEARCH). Besides the library reads, SearchTask
    ' reads people, artists and programs on their own, and a recording is found inside the
    ' Movie and Episode reads.
    @it("gives every search row type exactly one source")
    function _()
      ' The server answers a LiveTvChannel read with items of type TvChannel.
      rowTypeOf = { "LiveTvChannel": "TvChannel" }
      sources = {}
      for each itemType in searchOutcome.LIBRARY_TYPES
        rowType = rowTypeOf[itemType] ?? itemType
        m.assertFalse(sources.doesExist(rowType), "two reads for " + rowType)
        sources[rowType] = true
      end for
      for each rowType in ["Person", "MusicArtist", "Program", "Recording"]
        m.assertFalse(sources.doesExist(rowType), "a library read for " + rowType)
        sources[rowType] = true
      end for

      for each rowType in itemTypeOrder.SEARCH
        m.assertTrue(sources.doesExist(rowType), "no read for " + rowType)
        sources.delete(rowType)
      end for
      m.assertEmpty(sources, "a read for a type search does not show")
    end function

  end class

end namespace
