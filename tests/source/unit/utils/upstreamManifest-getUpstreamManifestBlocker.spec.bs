import "pkg:/source/utils/upstreamManifest.bs"

namespace tests

  ' getUpstreamManifestBlocker — play a source's own HLS or DASH manifest URL (a Live TV channel, a
  ' .strm item) whether or not the server offers direct play, once the device has checked it.
  '
  ' Jellyfin 12.0 stopped offering direct play for any manifest source (StreamBuilder
  ' .ManifestContainers; jellyfin/jellyfin#17768 for M3U channels), because the server was relaying
  ' the manifest through /Videos/{id}/, where its relative URIs 404. JellyRock never took that path:
  ' it plays the absolute upstream Path, where relative URIs resolve against the origin. What the
  ' server gives instead is a remux or a transcode.
  '
  ' The server's "no" does not say whether 12.0 is its only reason, so the override stands in for
  ' the answer it would have given before 12.0. Each case asserts WHICH blocker applies, so a case
  ' cannot pass because a different check happened to turn its source away.
  @suite("upstreamManifest - getUpstreamManifestBlocker()")
  class GetUpstreamManifestBlockerTests extends tests.BaseTestSuite

    ' A 12.x response for an M3U HLS channel on a CDN: the server declined direct play, but the
    ' upstream URL is still in Path.
    private function declined(overrides = {} as object) as object
      source = {
        SupportsDirectPlay: false,
        Protocol: "Http",
        Container: "hls",
        Path: "https://cdn.example.com/stitch/hls/channel/abc/master.m3u8?jwt=token",
        IsRemote: true,
        RequiresLooping: false
      }
      source.append(overrides)
      return source
    end function

    ' A first load, as LoadVideoContentTask builds it, where the server had no reason of its own to
    ' decline.
    private function request(overrides = {} as object) as object
      built = {
        forceTranscoding: false,
        serverUrl: "https://jellyfin.example.com",
        forceRemoteSourceTranscoding: false,
        transcodeReasons: []
      }
      built.append(overrides)
      return built
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("an upstream HLS channel the server declined to direct play")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("plays it directly")
    function _()
      m.assertEqual(getUpstreamManifestBlocker(m.declined(), m.request()), UpstreamManifestBlocker.NONE)
    end function

    @it("plays a LAN source directly, even on the Jellyfin host, when the port differs")
    ' A tuner such as tvheadend on the same box as Jellyfin: same host, different port.
    function _()
      source = m.declined({ Path: "http://192.168.1.3:8190/separate/master.m3u8", IsRemote: false })
      m.assertEqual(getUpstreamManifestBlocker(source, m.request({ serverUrl: "http://192.168.1.3:8096" })), UpstreamManifestBlocker.NONE)
    end function

    @it("reads the extension from the URL path, so a query string cannot hide it")
    function _()
      source = m.declined({ Container: "", Path: "https://cdn.example.com/live/index.m3u8?token=abc.ts" })
      m.assertEqual(getUpstreamManifestBlocker(source, m.request()), UpstreamManifestBlocker.NONE)
    end function

    @it("accepts a plain .m3u playlist path when the container is not reported")
    function _()
      source = m.declined({ Container: "", Path: "http://iptv.example.com/channel/5.m3u" })
      m.assertEqual(getUpstreamManifestBlocker(source, m.request()), UpstreamManifestBlocker.NONE)
    end function

    @it("accepts ffmpeg's older 'applehttp' name for HLS")
    function _()
      source = m.declined({ Container: "applehttp", Path: "https://cdn.example.com/live/stream" })
      m.assertEqual(getUpstreamManifestBlocker(source, m.request()), UpstreamManifestBlocker.NONE)
    end function

    @it("plays a DASH manifest directly, by container or by .mpd path")
    function _()
      byContainer = m.declined({ Container: "dash", Path: "https://cdn.example.com/live/stream" })
      m.assertEqual(getUpstreamManifestBlocker(byContainer, m.request()), UpstreamManifestBlocker.NONE)
      byPath = m.declined({ Container: "", Path: "https://cdn.example.com/live/manifest.mpd?token=abc" })
      m.assertEqual(getUpstreamManifestBlocker(byPath, m.request()), UpstreamManifestBlocker.NONE)
    end function

    @it("plays a .strm item's manifest directly, as it played before 12.0")
    ' A .strm item is not live and comes back IsRemote even for a LAN URL (measured 2026-10-11 on
    ' 10.11.11 and 12.1.0); 12.1 declines it with no transcode reason.
    function _()
      strm = m.declined({ Path: "http://192.168.1.3:8190/vod/hls/master.m3u8", IsRemote: true })
      m.assertEqual(getUpstreamManifestBlocker(strm, m.request({ serverUrl: "http://192.168.1.3:8103" })), UpstreamManifestBlocker.NONE)
    end function

    @it("ignores case in the protocol, container and URL")
    function _()
      source = m.declined({ Protocol: "HTTP", Container: "HLS", Path: "HTTPS://CDN.EXAMPLE.COM/LIVE/MASTER.M3U8" })
      m.assertEqual(getUpstreamManifestBlocker(source, m.request()), UpstreamManifestBlocker.NONE)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("what this load asked for")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("never overrides the retry that forces a transcode")
    ' The fallback after a failed direct play. Overriding it would send the device back to the
    ' stream it just failed on, and the retry would repeat forever.
    function _()
      m.assertEqual(getUpstreamManifestBlocker(m.declined(), m.request({ forceTranscoding: true })), UpstreamManifestBlocker.FORCED_TRANSCODE)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("what the server already allows, or did not answer")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("still plays a source the server allows from its URL, so the device checks that URL too")
    ' Every 10.11 server. A Roku handed a URL it cannot reach buffers rather than failing, so a
    ' "yes" is checked from the device as well; the loader asks the server when the check fails.
    function _()
      m.assertEqual(getUpstreamManifestBlocker(m.declined({ SupportsDirectPlay: true }), m.request()), UpstreamManifestBlocker.NONE)
    end function

    @it("does nothing when the server did not say either way")
    function _()
      source = m.declined()
      source.Delete("SupportsDirectPlay")
      m.assertEqual(getUpstreamManifestBlocker(source, m.request()), UpstreamManifestBlocker.NO_DIRECT_PLAY_ANSWER)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("the server's reasons that predate 12.0")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("keeps a channel whose tuner auto-loops it on the server, which does the looping")
    function _()
      m.assertEqual(getUpstreamManifestBlocker(m.declined({ RequiresLooping: true }), m.request()), UpstreamManifestBlocker.AUTO_LOOP)
    end function

    @it("honors the user's policy to force transcoding of remote sources")
    function _()
      m.assertEqual(getUpstreamManifestBlocker(m.declined(), m.request({ forceRemoteSourceTranscoding: true })), UpstreamManifestBlocker.REMOTE_SOURCE_POLICY)
    end function

    @it("applies that policy to a .strm item, which the server reports as remote")
    function _()
      strm = m.declined({ Path: "http://192.168.1.3:8190/vod/dash/manifest.mpd", Container: "dash", IsRemote: true })
      m.assertEqual(getUpstreamManifestBlocker(strm, m.request({ forceRemoteSourceTranscoding: true })), UpstreamManifestBlocker.REMOTE_SOURCE_POLICY)
    end function

    @it("applies that policy only to a remote source, as the server does")
    function _()
      source = m.declined({ Path: "http://192.168.1.3:8190/separate/master.m3u8", IsRemote: false })
      m.assertEqual(getUpstreamManifestBlocker(source, m.request({ forceRemoteSourceTranscoding: true })), UpstreamManifestBlocker.NONE)
    end function

    @it("honors the server's internet streaming bitrate limit")
    function _()
      overLimit = m.request({ transcodeReasons: ["ContainerBitrateExceedsLimit"] })
      m.assertEqual(getUpstreamManifestBlocker(m.declined(), overLimit), UpstreamManifestBlocker.BITRATE_LIMIT)
    end function

    @it("honors the bitrate limit alongside other reasons")
    function _()
      overLimit = m.request({ transcodeReasons: ["VideoCodecNotSupported", "ContainerBitrateExceedsLimit"] })
      m.assertEqual(getUpstreamManifestBlocker(m.declined(), overLimit), UpstreamManifestBlocker.BITRATE_LIMIT)
    end function

    @it("ignores codec reasons, which describe the server's own transcode rather than this device")
    ' For a manifest, 12.x skips its direct-play check and reports only whether its transcode can
    ' copy the stream: an h264 channel 10.11 direct plays carries VideoCodecNotSupported on 12.1
    ' when the transcode target is HEVC.
    function _()
      codecOnly = m.request({ transcodeReasons: ["VideoCodecNotSupported", "AudioCodecNotSupported", "ContainerNotSupported"] })
      m.assertEqual(getUpstreamManifestBlocker(m.declined(), codecOnly), UpstreamManifestBlocker.NONE)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("streams that go through Jellyfin itself")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("declines a URL on the server's own host and port")
    ' That is the relay jellyfin/jellyfin#17768 was fixing, where relative URIs really do break.
    function _()
      source = m.declined({ Path: "https://jellyfin.example.com/videos/abc/master.m3u8" })
      m.assertEqual(getUpstreamManifestBlocker(source, m.request()), UpstreamManifestBlocker.SERVER_HOST)
    end function

    @it("treats an absent port as the scheme's default when comparing with the server")
    function _()
      source = m.declined({ Path: "https://jellyfin.example.com:443/videos/abc/master.m3u8" })
      m.assertEqual(getUpstreamManifestBlocker(source, m.request()), UpstreamManifestBlocker.SERVER_HOST)
    end function

    @it("declines the LiveStreamFiles relay whatever host it names")
    ' 12.x rewrites relay paths to the request's host, which need not match the saved server URL.
    function _()
      source = m.declined({ Path: "https://other.example.com/LiveTv/LiveStreamFiles/abc/stream.m3u8" })
      m.assertEqual(getUpstreamManifestBlocker(source, m.request()), UpstreamManifestBlocker.SERVER_RELAY)
    end function

    @it("declines a loopback host")
    function _()
      m.assertEqual(getUpstreamManifestBlocker(m.declined({ Path: "http://localhost:8096/x/master.m3u8" }), m.request()), UpstreamManifestBlocker.LOOPBACK)
      m.assertEqual(getUpstreamManifestBlocker(m.declined({ Path: "http://127.0.0.1:8096/x/master.m3u8" }), m.request()), UpstreamManifestBlocker.LOOPBACK)
      m.assertEqual(getUpstreamManifestBlocker(m.declined({ Path: "http://[::1]:8096/x/master.m3u8" }), m.request()), UpstreamManifestBlocker.LOOPBACK)
    end function

    @it("declines when the server URL cannot be read, rather than guessing")
    function _()
      m.assertEqual(getUpstreamManifestBlocker(m.declined(), m.request({ serverUrl: "" })), UpstreamManifestBlocker.NO_SERVER_URL)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("sources that are not an absolute manifest URL")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("declines a relative path")
    function _()
      m.assertEqual(getUpstreamManifestBlocker(m.declined({ Path: "/LiveTv/abc/master.m3u8" }), m.request()), UpstreamManifestBlocker.NOT_HTTP_URL)
    end function

    @it("declines an empty or missing path")
    function _()
      m.assertEqual(getUpstreamManifestBlocker(m.declined({ Path: "" }), m.request()), UpstreamManifestBlocker.NOT_HTTP_URL)
      source = m.declined()
      source.Delete("Path")
      m.assertEqual(getUpstreamManifestBlocker(source, m.request()), UpstreamManifestBlocker.NOT_HTTP_URL)
    end function

    @it("declines a non-HTTP scheme")
    function _()
      m.assertEqual(getUpstreamManifestBlocker(m.declined({ Path: "rtsp://camera.example.com/live.m3u8" }), m.request()), UpstreamManifestBlocker.NOT_HTTP_URL)
    end function

    @it("declines a file source, even one whose Path looks like an upstream URL")
    ' The loader builds a Jellyfin stream URL for a File source and never plays its Path.
    function _()
      m.assertEqual(getUpstreamManifestBlocker(m.declined({ Protocol: "File" }), m.request()), UpstreamManifestBlocker.NOT_HTTP_PROTOCOL)
    end function

    @it("declines MPEG-TS")
    ' Not a manifest, so 12.x never declined it for that reason; the server's answer stands.
    function _()
      source = m.declined({ Container: "ts", Path: "http://tuner.example.com/auto/v5.1" })
      m.assertEqual(getUpstreamManifestBlocker(source, m.request()), UpstreamManifestBlocker.NOT_MANIFEST)
    end function

    @it("declines a progressive file served over HTTP")
    function _()
      source = m.declined({ Container: "mp4", Path: "https://cdn.example.com/movies/clip.mp4" })
      m.assertEqual(getUpstreamManifestBlocker(source, m.request()), UpstreamManifestBlocker.NOT_MANIFEST)
    end function

    @it("declines an invalid media source")
    function _()
      m.assertEqual(getUpstreamManifestBlocker(invalid, m.request()), UpstreamManifestBlocker.NO_SOURCE)
    end function

  end class

end namespace
