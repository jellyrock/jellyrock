import "pkg:/source/utils/deviceCapabilities.bs"
import "pkg:/source/utils/misc.bs"

namespace tests

  @suite("deviceCapabilities.bs - Codec Support Detection")
  class DeviceCapabilitiesTests extends tests.BaseTestSuite

    protected override function setup()
      super.setup()
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("getActualCodecSupport() - Surround Codecs with PassThru")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("returns true when PassThru is supported for eac3 6ch")
    function _()
      ' Mock di that supports PassThru
      mockDi = {
        CanDecodeAudio: function(params as object) as object
          if params.DoesExist("PassThru") and params.PassThru = 1
            return { Result: true }
          end if
          return { Result: false }
        end function
      }

      result = getActualCodecSupport("eac3", 6, mockDi)
      m.assertTrue(result, "Should return true when PassThru is supported")
    end function

    @it("returns true when PassThru is supported for ac3 8ch")
    function _()
      mockDi = {
        CanDecodeAudio: function(params as object) as object
          if params.DoesExist("PassThru") and params.PassThru = 1
            return { Result: true }
          end if
          return { Result: false }
        end function
      }

      result = getActualCodecSupport("ac3", 8, mockDi)
      m.assertTrue(result, "Should return true when PassThru is supported")
    end function

    @it("returns true when PassThru is supported for dts 6ch")
    function _()
      mockDi = {
        CanDecodeAudio: function(params as object) as object
          if params.DoesExist("PassThru") and params.PassThru = 1
            return { Result: true }
          end if
          return { Result: false }
        end function
      }

      result = getActualCodecSupport("dts", 6, mockDi)
      m.assertTrue(result, "Should return true when PassThru is supported")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("getActualCodecSupport() - Surround Codecs Native Decode")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("returns true for eac3 6ch native decode (no PassThru)")
    function _()
      ' Mock di: no PassThru, but native decode supported
      mockDi = {
        CanDecodeAudio: function(params as object) as object
          if params.DoesExist("PassThru") and params.PassThru = 1
            return { Result: false } ' No PassThru
          end if
          return { Result: true } ' But can decode natively
        end function
      }

      result = getActualCodecSupport("eac3", 6, mockDi)
      m.assertTrue(result, "Should return true for native decode within limits (6ch)")
    end function

    @it("returns true for ac3 6ch native decode (no PassThru)")
    function _()
      mockDi = {
        CanDecodeAudio: function(params as object) as object
          if params.DoesExist("PassThru") and params.PassThru = 1
            return { Result: false }
          end if
          return { Result: true }
        end function
      }

      result = getActualCodecSupport("ac3", 6, mockDi)
      m.assertTrue(result, "Should return true for native decode within limits (6ch)")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("getActualCodecSupport() - False Positive Detection")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("detects false positive for eac3 8ch (exceeds native decode limit)")
    function _()
      ' API says yes, but eac3 native decode max is 6ch
      mockDi = {
        CanDecodeAudio: function(params as object) as object
          if params.DoesExist("PassThru") and params.PassThru = 1
            return { Result: false } ' No PassThru
          end if
          return { Result: true } ' API says can decode (false positive)
        end function
      }

      result = getActualCodecSupport("eac3", 8, mockDi)
      m.assertFalse(result, "Should detect false positive: eac3 can't natively decode >6ch")
    end function

    @it("detects false positive for ac3 8ch (exceeds native decode limit)")
    function _()
      mockDi = {
        CanDecodeAudio: function(params as object) as object
          if params.DoesExist("PassThru") and params.PassThru = 1
            return { Result: false }
          end if
          return { Result: true } ' False positive
        end function
      }

      result = getActualCodecSupport("ac3", 8, mockDi)
      m.assertFalse(result, "Should detect false positive: ac3 can't natively decode >6ch")
    end function

    @it("detects false positive for dts without PassThru (decode-only not supported)")
    function _()
      ' DTS is passthrough-only (max channels = 0 for native decode)
      mockDi = {
        CanDecodeAudio: function(params as object) as object
          if params.DoesExist("PassThru") and params.PassThru = 1
            return { Result: false } ' No PassThru
          end if
          return { Result: true } ' API says can decode (false positive)
        end function
      }

      result = getActualCodecSupport("dts", 6, mockDi)
      m.assertFalse(result, "Should detect false positive: DTS requires PassThru (can't natively decode)")
    end function

    @it("detects false positive for aac >6ch")
    function _()
      mockDi = {
        CanDecodeAudio: function(params as object) as object
          return { Result: true } ' API says yes (false positive)
        end function
      }

      result = getActualCodecSupport("aac", 8, mockDi)
      m.assertFalse(result, "Should detect false positive: AAC max is 6ch")
    end function

    @it("detects false positive for pcm >2ch")
    function _()
      mockDi = {
        CanDecodeAudio: function(params as object) as object
          return { Result: true } ' False positive
        end function
      }

      result = getActualCodecSupport("pcm", 6, mockDi)
      m.assertFalse(result, "Should detect false positive: PCM max is 2ch")
    end function

    @it("detects false positive for lpcm >2ch")
    function _()
      mockDi = {
        CanDecodeAudio: function(params as object) as object
          return { Result: true } ' False positive
        end function
      }

      result = getActualCodecSupport("lpcm", 6, mockDi)
      m.assertFalse(result, "Should detect false positive: LPCM max is 2ch")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("getActualCodecSupport() - Stereo Codecs")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("returns true for supported stereo codec (mp3 2ch)")
    function _()
      mockDi = {
        CanDecodeAudio: function(params as object) as object
          return { Result: true }
        end function
      }

      result = getActualCodecSupport("mp3", 2, mockDi)
      m.assertTrue(result, "Should return true for supported stereo codec")
    end function

    @it("returns false when API says codec not supported")
    function _()
      mockDi = {
        CanDecodeAudio: function(params as object) as object
          return { Result: false }
        end function
      }

      result = getActualCodecSupport("mp3", 2, mockDi)
      m.assertFalse(result, "Should return false when API says not supported")
    end function

    @it("returns true for aac 2ch (within limits)")
    function _()
      mockDi = {
        CanDecodeAudio: function(params as object) as object
          return { Result: true }
        end function
      }

      result = getActualCodecSupport("aac", 2, mockDi)
      m.assertTrue(result, "Should return true for AAC 2ch (within 6ch limit)")
    end function

    @it("returns true for aac 6ch (at limit)")
    function _()
      mockDi = {
        CanDecodeAudio: function(params as object) as object
          return { Result: true }
        end function
      }

      result = getActualCodecSupport("aac", 6, mockDi)
      m.assertTrue(result, "Should return true for AAC 6ch (at limit)")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("getSupportedPassthruCodecs()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("returns all codecs when all are supported")
    function _()
      mockDi = {
        CanDecodeAudio: function(params as object) as object
          if params.DoesExist("PassThru") and params.PassThru = 1
            return { Result: true } ' All PassThru supported
          end if
          return { Result: false }
        end function
      }

      result = getSupportedPassthruCodecs(mockDi, 6)
      ' eac3, ac3, dts (Group 1 ChCnt codecs) + truehd (mat) + dtshd (Group 2 passthrough-only)
      m.assertArrayCount(result, 5, "Should return all 5 codecs")
      m.assertEqual(result[0], "eac3", "eac3 should be first")
      m.assertEqual(result[1], "ac3", "ac3 should be second")
      m.assertEqual(result[2], "dts", "dts should be third")
      m.assertEqual(result[3], "truehd", "truehd (mat) should be fourth")
      m.assertEqual(result[4], "dtshd", "dtshd should be fifth")
    end function

    @it("returns empty array when no codecs are supported")
    function _()
      mockDi = {
        CanDecodeAudio: function(params as object) as object
          return { Result: false } ' None supported
        end function
      }

      result = getSupportedPassthruCodecs(mockDi, 6)
      m.assertArrayCount(result, 0, "Should return empty array when none supported")
    end function

    @it("returns only supported codecs (eac3 and ac3, no dts)")
    function _()
      mockDi = {
        CanDecodeAudio: function(params as object) as object
          if params.DoesExist("PassThru") and params.PassThru = 1
            ' Support eac3 and ac3, but not dts
            if params.Codec = "eac3" or params.Codec = "ac3"
              return { Result: true }
            end if
          end if
          return { Result: false }
        end function
      }

      result = getSupportedPassthruCodecs(mockDi, 6)
      m.assertArrayCount(result, 2, "Should return 2 codecs")
      m.assertEqual(result[0], "eac3", "eac3 should be first")
      m.assertEqual(result[1], "ac3", "ac3 should be second")
      m.assertFalse(arrayHasValue(result, "dts"), "dts should not be in list")
    end function

    @it("respects channel count parameter for 8ch")
    function _()
      ' Mock that only supports 6ch, not 8ch
      mockDi = {
        CanDecodeAudio: function(params as object) as object
          if params.DoesExist("PassThru") and params.PassThru = 1 and params.ChCnt = 6
            return { Result: true }
          end if
          return { Result: false }
        end function
      }

      result = getSupportedPassthruCodecs(mockDi, 8)
      m.assertArrayCount(result, 0, "Should return empty for 8ch when only 6ch supported")
    end function

    @it("returns empty when device can native decode but has no passthrough")
    function _()
      ' Regression: Roku Ultra can natively decode ac3/eac3 6ch (outputs stereo PCM)
      ' but has no receiver/soundbar for passthrough. getSupportedPassthruCodecs must
      ' only detect actual passthrough, not native decode capability.
      mockDi = {
        CanDecodeAudio: function(params as object) as object
          if params.DoesExist("PassThru") and params.PassThru = 1
            return { Result: false } ' No passthrough (no receiver/soundbar)
          end if
          return { Result: true } ' Native decode supported
        end function
      }

      result = getSupportedPassthruCodecs(mockDi, 6)
      m.assertArrayCount(result, 0, "Should return empty when only native decode is available (no passthrough)")
    end function

    @it("returns truehd when mat passthrough is supported")
    function _()
      ' mat is the Roku API name for TrueHD; getSupportedPassthruCodecs maps it to "truehd"
      mockDi = {
        CanDecodeAudio: function(params as object) as object
          if params.DoesExist("PassThru") and params.PassThru = 1 and params.Codec = "mat"
            return { Result: true }
          end if
          return { Result: false }
        end function
      }

      result = getSupportedPassthruCodecs(mockDi, 6)
      m.assertArrayCount(result, 1, "Should return one codec")
      m.assertEqual(result[0], "truehd", "mat should be mapped to truehd for Jellyfin callers")
      m.assertFalse(arrayHasValue(result, "mat"), "Should not expose Roku internal codec name 'mat'")
    end function

    @it("returns dtshd when dtshd passthrough is supported at >2ch")
    function _()
      mockDi = {
        CanDecodeAudio: function(params as object) as object
          if params.DoesExist("PassThru") and params.PassThru = 1 and params.Codec = "dtshd"
            return { Result: true }
          end if
          return { Result: false }
        end function
      }

      result = getSupportedPassthruCodecs(mockDi, 6)
      m.assertArrayCount(result, 1, "Should return dtshd for 6ch")
      m.assertEqual(result[0], "dtshd", "dtshd should be included for >2ch")
    end function

    @it("does not return dtshd for 2ch (passthrough-only codec is irrelevant at stereo)")
    function _()
      mockDi = {
        CanDecodeAudio: function(params as object) as object
          if params.DoesExist("PassThru") and params.PassThru = 1 and params.Codec = "dtshd"
            return { Result: true }
          end if
          return { Result: false }
        end function
      }

      result = getSupportedPassthruCodecs(mockDi, 2)
      m.assertArrayCount(result, 0, "Should not return dtshd for 2ch")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("jellyfinToRokuCodecName() - Codec Name Translation")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("translates h264 to mpeg4 avc (Roku API codec string)")
    function _()
      m.assertEqual(jellyfinToRokuCodecName("h264"), "mpeg4 avc", "h264 must map to Roku API string 'mpeg4 avc'")
    end function

    @it("translates truehd to mat (Roku API codec string)")
    function _()
      m.assertEqual(jellyfinToRokuCodecName("truehd"), "mat", "truehd must map to Roku API string 'mat'")
    end function

    @it("translates mpeg1video to mpeg1 (Roku API codec string)")
    function _()
      m.assertEqual(jellyfinToRokuCodecName("mpeg1video"), "mpeg1", "mpeg1video must map to Roku API string 'mpeg1'")
    end function

    @it("passes through unmapped codec names unchanged")
    @params("aac")
    @params("hevc")
    @params("vp9")
    @params("eac3")
    @params("ac3")
    @params("dts")
    @params("dtshd")
    @params("flac")
    @params("mp3")
    function _(codec)
      m.assertEqual(jellyfinToRokuCodecName(codec), codec, "Unmapped codec '" + codec + "' should pass through unchanged")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("getActualCodecSupport() - Passthrough-Only Codecs")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("dtshd is passthrough-only: returns true at >2ch when PassThru is supported")
    function _()
      mockDi = {
        CanDecodeAudio: function(params as object) as object
          if params.Codec = "dtshd" and params.DoesExist("PassThru") and params.PassThru = 1
            return { Result: true }
          end if
          return { Result: false }
        end function
      }

      result = getActualCodecSupport("dtshd", 6, mockDi)
      m.assertTrue(result, "dtshd should return true at 6ch when PassThru is supported")
    end function

    @it("dtshd is passthrough-only: returns false at 2ch even with PassThru support")
    function _()
      ' Passthrough-only codecs are irrelevant at stereo — they only make sense for surround
      mockDi = {
        CanDecodeAudio: function(params as object) as object
          if params.Codec = "dtshd" and params.DoesExist("PassThru") and params.PassThru = 1
            return { Result: true }
          end if
          return { Result: false }
        end function
      }

      result = getActualCodecSupport("dtshd", 2, mockDi)
      m.assertFalse(result, "dtshd should return false at 2ch (passthrough-only, not relevant for stereo)")
    end function

    @it("dtshd is passthrough-only: returns false at >2ch when PassThru is not supported")
    function _()
      mockDi = {
        CanDecodeAudio: function(params as object) as object
          ' Device has no receiver — PassThru not supported
          return { Result: false }
        end function
      }

      result = getActualCodecSupport("dtshd", 6, mockDi)
      m.assertFalse(result, "dtshd should return false at 6ch when PassThru is not supported")
    end function

    @it("dtsx (DTS:X) passthrough-only: returns true at >2ch when PassThru is supported")
    function _()
      ' dtsx is treated identically to dtshd — passthrough-only, no ChCnt
      mockDi = {
        CanDecodeAudio: function(params as object) as object
          if params.Codec = "dtsx" and params.DoesExist("PassThru") and params.PassThru = 1
            return { Result: true }
          end if
          return { Result: false }
        end function
      }

      result = getActualCodecSupport("dtsx", 6, mockDi)
      m.assertTrue(result, "dtsx should return true at 6ch when PassThru is supported")
    end function

    @it("dtsx passthrough-only: returns false at 2ch even with PassThru support")
    function _()
      mockDi = {
        CanDecodeAudio: function(params as object) as object
          if params.Codec = "dtsx" and params.DoesExist("PassThru") and params.PassThru = 1
            return { Result: true }
          end if
          return { Result: false }
        end function
      }

      result = getActualCodecSupport("dtsx", 2, mockDi)
      m.assertFalse(result, "dtsx should return false at 2ch (passthrough-only, not relevant for stereo)")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Helper Functions")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("removeDecimals() removes all decimal points from string")
    function _()
      m.assertEqual(removeDecimals("4.1"), "41")
      m.assertEqual(removeDecimals("5.1.2"), "512")
      m.assertEqual(removeDecimals("10.5"), "105")
      m.assertEqual(removeDecimals("42"), "42") ' No decimals
    end function

    @it("convertHevcLevelToString() converts HEVC levels correctly")
    @params(5.0, "150")
    @params(5.1, "153")
    @params(4.1, "123")
    @params(4.0, "120")
    @params(3.0, "90")
    @params(3.1, "93")
    @params(6.0, "180")
    @params(6.1, "183")
    @params(6.2, "186")
    function _(level, expectedString)
      result = convertHevcLevelToString(level)
      m.assertEqual(result, expectedString, "HEVC level " + level.toStr() + " should convert to " + expectedString)
    end function

    @it("convertHevcLevelToString() handles edge cases")
    @params(0.0, "0")
    @params(1.0, "30")
    @params(2.0, "60")
    function _(level, expectedString)
      result = convertHevcLevelToString(level)
      m.assertEqual(result, expectedString, "Edge case level " + level.toStr() + " should convert to " + expectedString)
    end function

    @it("updateProfileArray() creates nested structure for codec")
    function _()
      profileArray = {}

      result = updateProfileArray(profileArray, "h264", "main", "4.1")

      m.assertTrue(result.DoesExist("h264"), "Should create h264 entry")
      m.assertTrue(result.h264.DoesExist("main"), "Should create main profile")
      m.assertTrue(result.h264.main.DoesExist("4.1"), "Should create 4.1 level")
    end function

    @it("updateProfileArray() adds multiple profiles for same codec")
    function _()
      profileArray = {}

      updateProfileArray(profileArray, "h264", "main", "4.1")
      result = updateProfileArray(profileArray, "h264", "high", "5.1")

      m.assertTrue(result.h264.DoesExist("main"), "Should have main profile")
      m.assertTrue(result.h264.DoesExist("high"), "Should have high profile")
    end function

    @it("updateProfileArray() adds multiple levels for same profile")
    function _()
      profileArray = {}

      updateProfileArray(profileArray, "h264", "main", "4.1")
      result = updateProfileArray(profileArray, "h264", "main", "5.1")

      m.assertTrue(result.h264.main.DoesExist("4.1"), "Should have 4.1 level")
      m.assertTrue(result.h264.main.DoesExist("5.1"), "Should have 5.1 level")
    end function

    @it("updateProfileArray() handles profile without level")
    function _()
      profileArray = {}

      result = updateProfileArray(profileArray, "mpeg2", "main")

      m.assertTrue(result.DoesExist("mpeg2"), "Should create mpeg2 entry")
      m.assertTrue(result.mpeg2.DoesExist("main"), "Should create main profile")
    end function

    @it("updateProfileArray() handles empty videoProfile gracefully")
    function _()
      profileArray = {}

      result = updateProfileArray(profileArray, "h264", "")

      ' Should return unchanged when videoProfile is empty
      m.assertEqual(result.Count(), 0, "Should not create entry for empty profile")
    end function

    @it("updateProfileArray() handles invalid profileArray gracefully")
    function _()
      result = updateProfileArray(invalid, "h264", "main", "4.1")

      ' Function returns empty object {} for invalid input, not invalid
      m.assertEqual(result.Count(), 0, "Should return empty object for invalid input")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("applyResolutionCapToProfile()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("adds Height and Width conditions when no cap exists")
    function _()
      codecProfile = { "Codec": "h264", "Conditions": [] }

      applyResolutionCapToProfile(codecProfile, 1080, 1920)

      m.assertArrayCount(codecProfile.Conditions, 2, "Should add 2 conditions")
      m.assertEqual(codecProfile.Conditions[0].Property, "Height", "First condition should be Height")
      m.assertEqual(codecProfile.Conditions[0].Value, "1080", "Height value should be 1080")
      m.assertEqual(codecProfile.Conditions[1].Property, "Width", "Second condition should be Width")
      m.assertEqual(codecProfile.Conditions[1].Value, "1920", "Width value should be 1920")
    end function

    @it("no-ops when a Height condition at or below maxHeight already exists")
    function _()
      codecProfile = {
        "Codec": "h264",
        "Conditions": [{ "Property": "Height", "Value": "1080", "Condition": "LessThanEqual", "IsRequired": false }]
      }

      applyResolutionCapToProfile(codecProfile, 1080, 1920)

      m.assertArrayCount(codecProfile.Conditions, 1, "Should not add duplicate conditions")
    end function

    @it("no-ops when an existing Height condition is below maxHeight")
    function _()
      codecProfile = {
        "Codec": "h264",
        "Conditions": [{ "Property": "Height", "Value": "720", "Condition": "LessThanEqual", "IsRequired": false }]
      }

      applyResolutionCapToProfile(codecProfile, 1080, 1920)

      m.assertArrayCount(codecProfile.Conditions, 1, "Should not add when a stricter cap already exists")
    end function

    @it("adds cap when existing Height condition is above maxHeight")
    function _()
      ' Device-level cap is 2160 (4K Roku), but H264 needs to be capped at 1080
      codecProfile = {
        "Codec": "h264",
        "Conditions": [{ "Property": "Height", "Value": "2160", "Condition": "LessThanEqual", "IsRequired": false }]
      }

      applyResolutionCapToProfile(codecProfile, 1080, 1920)

      m.assertArrayCount(codecProfile.Conditions, 3, "Should add Height and Width on top of existing 4K cap")
      m.assertEqual(codecProfile.Conditions[1].Property, "Height", "Added Height condition")
      m.assertEqual(codecProfile.Conditions[1].Value, "1080")
      m.assertEqual(codecProfile.Conditions[2].Property, "Width", "Added Width condition")
      m.assertEqual(codecProfile.Conditions[2].Value, "1920")
    end function

    @it("respects isRequired parameter")
    function _()
      codecProfile = { "Codec": "h264", "Conditions": [] }

      applyResolutionCapToProfile(codecProfile, 1080, 1920, true)

      m.assertTrue(codecProfile.Conditions[0].IsRequired, "Height condition should be required")
      m.assertTrue(codecProfile.Conditions[1].IsRequired, "Width condition should be required")
    end function

    @it("defaults isRequired to false")
    function _()
      codecProfile = { "Codec": "h264", "Conditions": [] }

      applyResolutionCapToProfile(codecProfile, 1080, 1920)

      m.assertFalse(codecProfile.Conditions[0].IsRequired, "Height condition should not be required by default")
      m.assertFalse(codecProfile.Conditions[1].IsRequired, "Width condition should not be required by default")
    end function

    @it("handles invalid codecProfile gracefully")
    function _()
      ' Should not throw
      applyResolutionCapToProfile(invalid, 1080, 1920)
      m.assertTrue(true, "Should handle invalid codecProfile without error")
    end function

    @it("handles missing Conditions array gracefully")
    function _()
      codecProfile = { "Codec": "h264" }

      applyResolutionCapToProfile(codecProfile, 1080, 1920)

      m.assertFalse(codecProfile.DoesExist("Conditions"), "Should not create Conditions when missing")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("getDeviceBufferSize()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("returns low memory buffer size when isLowMemoryDevice is true")
    function _()
      m.global.device.isLowMemoryDevice = true
      result = getDeviceBufferSize()
      m.assertEqual(result, 20553728&, "Should return low memory buffer size (20,553,728 bytes)")
    end function

    @it("returns normal buffer size when isLowMemoryDevice is false")
    function _()
      m.global.device.isLowMemoryDevice = false
      result = getDeviceBufferSize()
      m.assertEqual(result, 31616000&, "Should return normal buffer size (31,616,000 bytes)")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("calculateOptimalTranscodingParams() - Buffer Protection")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("uses preferred segment length (6s) for low bitrate (10 Mbps) on normal device")
    function _()
      ' 10 Mbps, 2 hour movie, normal buffer (31,616,000 bytes)
      ' segmentBudget = (31,616,000 * 0.75) / 2 = 11,856,000 bytes → 94,848,000 bits
      ' rawMaxSegDuration = floor(94,848,000 / 10,000,000) = 9 → buffer supports 6s
      ' minSegDuration = ceil(7200 / 5000) = 2
      ' rawMax(9) >= preferred(6) and min(2) <= preferred(6) → use preferred
      result = calculateOptimalTranscodingParams(10000000&, 7200, 31616000&)
      m.assertEqual(result.segmentLength, 6, "Should use preferred 6s segment length")
      m.assertEqual(result.maxBitrate, 0&, "Should not reduce bitrate")
    end function

    @it("uses max segment length for low bitrate (10 Mbps) on low memory device")
    function _()
      ' 10 Mbps, 2 hour movie, low memory buffer (20,553,728 bytes)
      ' segmentBudget = (20,553,728 * 0.75) / 2 = 7,707,648 bytes → 61,661,184 bits
      ' maxSegDuration = floor(61,661,184 / 10,000,000) = 6 → no clamping needed
      ' minSegDuration = ceil(7200 / 5000) = 2
      ' min(2) <= max(6) → no conflict
      result = calculateOptimalTranscodingParams(10000000&, 7200, 20553728&)
      m.assertEqual(result.segmentLength, 6, "Should use max segment length for low bitrate")
      m.assertEqual(result.maxBitrate, 0&, "Should not reduce bitrate")
    end function

    @it("reduces segment length and bitrate for 95 Mbps on normal device")
    function _()
      ' ~95 Mbps, ~97 min movie (5804 seconds), normal buffer (31,616,000 bytes)
      ' segmentBudget = (31,616,000 * 0.75) / 2 = 11,856,000 bytes → 94,848,000 bits
      ' maxSegDuration = floor(94,848,000 / 94,852,604) = 0 → clamped to 1
      ' minSegDuration = ceil(5804 / 5000) = 2
      ' Conflict: min(2) > max(1) → segmentLength=2, maxBitrate = (11,856,000 * 8) \ 2 = 47,424,000
      result = calculateOptimalTranscodingParams(94852604&, 5804, 31616000&)
      m.assertEqual(result.segmentLength, 2, "Should use minSegDuration of 2")
      m.assertEqual(result.maxBitrate, 47424000&, "maxBitrate should be exactly (segmentBudget * 8) \\ segmentLength")
    end function

    @it("reduces bitrate for 95 Mbps on low memory device when playlist limit reached")
    function _()
      ' ~95 Mbps, ~97 min movie (5804 seconds), low memory buffer (20,553,728 bytes)
      ' segmentBudget = (20,553,728 * 0.75) / 2 = 7,707,648 bytes → 61,661,184 bits
      ' maxSegDuration = floor(61,661,184 / 94,852,604) = 0 → clamped to 1
      ' minSegDuration = ceil(5804 / 5000) = 2
      ' Conflict: min(2) > max(1) → segmentLength=2, maxBitrate = (7,707,648 * 8) \ 2 = 30,830,592
      result = calculateOptimalTranscodingParams(94852604&, 5804, 20553728&)
      m.assertEqual(result.segmentLength, 2, "Should use minSegDuration of 2")
      m.assertEqual(result.maxBitrate, 30830592&, "maxBitrate should be exactly (segmentBudget * 8) \\ segmentLength")
    end function

    @it("reduces bitrate for extreme bitrate (200 Mbps) on low memory device")
    function _()
      ' 200 Mbps, 90 min movie, low memory buffer (20,553,728 bytes)
      ' segmentBudget = (20,553,728 * 0.75) / 2 = 7,707,648 bytes → 61,661,184 bits
      ' maxSegDuration = floor(61,661,184 / 200,000,000) = 0 → clamped to 1
      ' minSegDuration = ceil(5400 / 5000) = 2
      ' Conflict: min(2) > max(1) → segmentLength=2, maxBitrate = (7,707,648 * 8) \ 2 = 30,830,592
      result = calculateOptimalTranscodingParams(200000000&, 5400, 20553728&)
      m.assertEqual(result.segmentLength, 2, "Should use minSegDuration of 2")
      m.assertEqual(result.maxBitrate, 30830592&, "maxBitrate should be exactly (segmentBudget * 8) \\ segmentLength")
    end function

    @it("returns defaults for invalid bitrate (0)")
    function _()
      result = calculateOptimalTranscodingParams(0&, 7200, 31616000&)
      m.assertEqual(result.segmentLength, 6, "Should return default segment length")
      m.assertEqual(result.maxBitrate, 0&, "Should return default maxBitrate")
    end function

    @it("returns defaults for invalid duration (0)")
    function _()
      result = calculateOptimalTranscodingParams(20000000&, 0, 31616000&)
      m.assertEqual(result.segmentLength, 6, "Should return default segment length")
      m.assertEqual(result.maxBitrate, 0&, "Should return default maxBitrate")
    end function

    @it("returns defaults for negative bitrate")
    function _()
      result = calculateOptimalTranscodingParams(-1&, 7200, 31616000&)
      m.assertEqual(result.segmentLength, 6, "Should return default segment length")
      m.assertEqual(result.maxBitrate, 0&, "Should return default maxBitrate")
    end function

    @it("reduces bitrate for short high-bitrate video (rawMaxSegDuration=0, no playlist conflict)")
    function _()
      ' 150 Mbps, 10 min (600s), low memory buffer (20,553,728 bytes)
      ' segmentBudget = (20,553,728 * 0.75) / 2 = 7,707,648 bytes → 61,661,184 bits
      ' rawMaxSegDuration = floor(61,661,184 / 150,000,000) = 0
      ' A raw value of 0 means even a 1s segment overflows the buffer at source bitrate.
      ' Must force bitrate reduction even though playlist has no conflict (minSegDuration = 1).
      ' minSegDuration = 1 (600 < 5000)
      ' segmentLength = 1, maxBitrate = (7,707,648 * 8) \ 1 = 61,661,184
      result = calculateOptimalTranscodingParams(150000000&, 600, 20553728&)
      m.assertEqual(result.segmentLength, 1, "Should use 1-second segments")
      m.assertEqual(result.maxBitrate, 61661184&, "Should reduce bitrate to fit 1s segments in buffer budget")
    end function

    @it("reduces segment length without bitrate reduction for medium bitrate (20 Mbps) on normal device")
    function _()
      ' 20 Mbps, 2 hours, normal buffer (31,616,000 bytes)
      ' segmentBudget = (31,616,000 * 0.75) / 2 = 11,856,000 bytes → 94,848,000 bits
      ' maxSegDuration = floor(94,848,000 / 20,000,000) = 4
      ' minSegDuration = ceil(7200 / 5000) = 2
      ' min(2) <= max(4) → no conflict, segmentLength=4
      result = calculateOptimalTranscodingParams(20000000&, 7200, 31616000&)
      m.assertEqual(result.segmentLength, 4, "Should reduce segment length to 4 for medium bitrate")
      m.assertEqual(result.maxBitrate, 0&, "Should not reduce bitrate")
    end function

  end class

end namespace
