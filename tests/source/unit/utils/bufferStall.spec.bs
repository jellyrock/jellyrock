import "pkg:/source/enums/BufferCheckAction.bs"
import "pkg:/source/utils/bufferStall.bs"

namespace tests

  @suite("bufferStall.bs")
  class BufferStallTests extends tests.BaseTestSuite

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("classifyBufferCheck()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("keeps waiting while buffering gains, live or not")
    function _()
      m.assertEqual(classifyBufferCheck(33, 26, false), BufferCheckAction.PROGRESS)
      m.assertEqual(classifyBufferCheck(1, 0, true), BufferCheckAction.PROGRESS)
    end function

    @it("hands a stalled Live TV channel to the host's restart rule")
    function _()
      m.assertEqual(classifyBufferCheck(33, 33, true), BufferCheckAction.LIVE_STALLED)
    end function

    @it("treats buffering that never started as a stall")
    function _()
      m.assertEqual(classifyBufferCheck(0, 0, true), BufferCheckAction.LIVE_STALLED)
      m.assertEqual(classifyBufferCheck(0, 0, false), BufferCheckAction.STALLED)
    end function

    @it("shows the error for a stall that is not Live TV")
    function _()
      m.assertEqual(classifyBufferCheck(33, 33, false), BufferCheckAction.STALLED)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("classifyPlayingProgress()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("keeps waiting while the position advances")
    function _()
      m.assertEqual(classifyPlayingProgress(61.5, 31.5, 30000, 30000, m.playingFlags()), BufferCheckAction.PROGRESS)
    end function

    @it("calls a position that did not move for the whole window a stall")
    function _()
      m.assertEqual(classifyPlayingProgress(0.0, 0.0, 30000, 30000, m.playingFlags()), BufferCheckAction.STALLED)
      m.assertEqual(classifyPlayingProgress(120.5, 120.5, 31000, 30000, m.playingFlags()), BufferCheckAction.STALLED)
    end function

    @it("waits until a full window has passed")
    function _()
      m.assertEqual(classifyPlayingProgress(10.0, 10.0, 29000, 30000, m.playingFlags()), BufferCheckAction.PROGRESS)
    end function

    @it("does not call a pause, a seek or a scrub a stall")
    function _()
      m.assertEqual(classifyPlayingProgress(10.0, 10.0, 30000, 30000, m.playingFlags({ isPaused: true })), BufferCheckAction.PROGRESS)
      m.assertEqual(classifyPlayingProgress(10.0, 10.0, 30000, 30000, m.playingFlags({ isSeeking: true })), BufferCheckAction.PROGRESS)
      m.assertEqual(classifyPlayingProgress(10.0, 10.0, 30000, 30000, m.playingFlags({ isScrubbing: true })), BufferCheckAction.PROGRESS)
    end function

    @it("does not call a state other than playing a stall")
    function _()
      m.assertEqual(classifyPlayingProgress(10.0, 10.0, 30000, 30000, m.playingFlags({ isPlaying: false })), BufferCheckAction.PROGRESS)
    end function

    @it("counts a seek that moved the position back as progress")
    function _()
      m.assertEqual(classifyPlayingProgress(5.0, 600.0, 30000, 30000, m.playingFlags()), BufferCheckAction.PROGRESS)
    end function

    @it("lets the node hold the last frame near the end")
    function _()
      m.assertEqual(classifyPlayingProgress(5398.0, 5398.0, 30000, 30000, m.playingFlags({ duration: 5400.0 })), BufferCheckAction.PROGRESS)
      m.assertEqual(classifyPlayingProgress(5300.0, 5300.0, 30000, 30000, m.playingFlags({ duration: 5400.0 })), BufferCheckAction.STALLED)
    end function

    @it("hands a frozen Live TV channel to the host's restart rule")
    function _()
      m.assertEqual(classifyPlayingProgress(80.0, 80.0, 30000, 30000, m.playingFlags({ isLive: true })), BufferCheckAction.LIVE_STALLED)
      m.assertEqual(classifyPlayingProgress(80.0, 90.0, 30000, 30000, m.playingFlags({ isLive: true })), BufferCheckAction.PROGRESS)
    end function

    @it("ignores the end margin for Live TV, where the duration means nothing")
    function _()
      m.assertEqual(classifyPlayingProgress(80.0, 80.0, 30000, 30000, m.playingFlags({ isLive: true, duration: 81.0 })), BufferCheckAction.LIVE_STALLED)
    end function

    function playingFlags(overrides = {} as object) as object
      flags = { isPlaying: true, isPaused: false, isSeeking: false, isScrubbing: false, isLive: false, duration: 0.0 }
      flags.append(overrides)
      return flags
    end function

  end class

end namespace
