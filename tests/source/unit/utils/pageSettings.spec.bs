import "pkg:/source/home/homePageSettings.bs"
import "pkg:/source/utils/pageSettings.bs"

namespace tests

  @suite("pageSettings.bs - the settings icon's page menu")
  class PageSettingsTests extends tests.BaseTestSuite

    private function layoutEntry(selected as dynamic) as object
      return {
        id: "layout",
        title: "Layout",
        options: [{ id: "presentation", title: "Presentation" }, { id: "grid", title: "Grid" }],
        selected: selected
      }
    end function

    ' Piece 07's shape: the first option's id is the empty string.
    private function defaultTabEntry(selected as dynamic) as object
      return {
        id: "defaultTab",
        title: "Default tab",
        options: [{ id: "", title: "Use web client setting" }, { id: "genres", title: "Genres" }],
        selected: selected
      }
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("menuRows")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("lists the entries in order, each with its value, then All settings")
    function _()
      menu = pageSettings.menuRows([m.layoutEntry("grid"), m.defaultTabEntry("genres")])

      m.assertEqual(menu.ids, ["layout", "defaultTab", pageSettings.ALL_SETTINGS])
      m.assertEqual(menu.labels, ["Layout (Grid)", "Default tab (Genres)", "All settings"])
    end function

    @it("gives each row its entry's icon, an empty one where the entry has none, and All settings the gear")
    function _()
      layout = m.layoutEntry("grid")
      layout.icon = "pkg:/images/icons/layout_$$RES$$.png"
      menu = pageSettings.menuRows([layout, m.defaultTabEntry("genres")])

      m.assertEqual(menu.icons, ["pkg:/images/icons/layout_$$RES$$.png", "", pageSettings.ALL_SETTINGS_ICON])
    end function

    @it("has no icons when it has no rows")
    function _()
      m.assertEqual(pageSettings.menuRows([]).icons, [])
    end function

    @it("shows the value of an option whose id is the empty string")
    function _()
      menu = pageSettings.menuRows([m.defaultTabEntry("")])

      m.assertEqual(menu.labels[0], "Default tab (Use web client setting)")
    end function

    @it("shows an entry's valueTitle in place of the selected option's title")
    ' The Default tab entry: its first option reads "Default (Movies)", and the row names
    ' the tab alone rather than nest one bracket inside another.
    function _()
      entry = m.defaultTabEntry("")
      entry.valueTitle = "Movies"

      menu = pageSettings.menuRows([entry])

      m.assertEqual(menu.labels[0], "Default tab (Movies)")
    end function

    @it("falls back to the selected option's title when valueTitle is empty")
    @params("")
    @params(invalid)
    function _(valueTitle)
      entry = m.layoutEntry("grid")
      entry.valueTitle = valueTitle

      m.assertEqual(pageSettings.menuRows([entry]).labels[0], "Layout (Grid)")
    end function

    @it("shows the title alone when the selected id names no option")
    @params("posters")
    @params(invalid)
    function _(selected)
      menu = pageSettings.menuRows([m.layoutEntry(selected)])

      m.assertEqual(menu.labels, ["Layout", "All settings"])
    end function

    @it("has no menu, and no All settings row, when a screen offers nothing")
    @params([])
    @params(invalid)
    @params("layout")
    function _(entries)
      menu = pageSettings.menuRows(entries)

      m.assertEqual(menu.ids, [])
      m.assertEqual(menu.labels, [])
    end function

    @it("leaves out an entry it cannot show")
    function _()
      noOptions = { id: "empty", title: "Empty", options: [] }
      noId = { title: "Nameless", options: [{ id: "a", title: "A" }] }
      reserved = { id: pageSettings.ALL_SETTINGS, title: "Impostor", options: [{ id: "a", title: "A" }] }

      badOption = { id: "bad", title: "Bad", options: [{ id: "a", title: "A" }, "b"] }
      noOptionId = { id: "blank", title: "Blank", options: [{ title: "A" }] }

      menu = pageSettings.menuRows([noOptions, noId, reserved, invalid, badOption, noOptionId, m.layoutEntry("grid")])

      m.assertEqual(menu.ids, ["layout", pageSettings.ALL_SETTINGS])
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("findEntry")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("finds an entry by id and reports a missing one as invalid")
    function _()
      entries = [m.layoutEntry("grid"), m.defaultTabEntry("")]

      m.assertEqual(pageSettings.findEntry(entries, "defaultTab").title, "Default tab")
      m.assertInvalid(pageSettings.findEntry(entries, "sort"))
      m.assertInvalid(pageSettings.findEntry(entries, pageSettings.ALL_SETTINGS))
      m.assertInvalid(pageSettings.findEntry(invalid, "layout"))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("picker")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("lists the options with the selected one marked")
    function _()
      list = pageSettings.picker(m.layoutEntry("grid"))

      m.assertEqual(list.labels, ["Presentation", "Grid"])
      m.assertEqual(list.values, ["presentation", "grid"])
      m.assertEqual(list.selectedIndex, 1)
    end function

    @it("heads the list with the entry's title")
    function _()
      entry = m.layoutEntry("grid")

      m.assertEqual(pageSettings.picker(entry).title, entry.title)
    end function

    @it("heads the list with the entry's picker title when it has one")
    function _()
      entry = m.layoutEntry("grid")
      entry.pickerTitle = "Item Titles (all libraries)"

      m.assertEqual(pageSettings.picker(entry).title, "Item Titles (all libraries)")
    end function

    @it("marks an option whose id is the empty string")
    function _()
      m.assertEqual(pageSettings.picker(m.defaultTabEntry("")).selectedIndex, 0)
    end function

    @it("marks nothing when the selected id names no option")
    function _()
      m.assertEqual(pageSettings.picker(m.layoutEntry("posters")).selectedIndex, -1)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("pickOutcome")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("reports a change for a pick other than the option in force")
    function _()
      entry = m.layoutEntry("grid")
      outcome = pageSettings.pickOutcome({ cancelled: false, optionIndex: 0 }, entry, pageSettings.picker(entry).values)

      m.assertEqual(outcome.action, pageSettings.PICK_CHANGE)
      m.assertEqual(outcome.value, "presentation")
    end function

    @it("does nothing for a pick of the option already in force")
    function _()
      entry = m.layoutEntry("grid")
      outcome = pageSettings.pickOutcome({ cancelled: false, optionIndex: 1 }, entry, pageSettings.picker(entry).values)

      m.assertEqual(outcome.action, pageSettings.PICK_NONE)
    end function

    @it("reports a change for a pick of the option in force when it is provisional")
    function _()
      entry = m.layoutEntry("grid")
      entry.isSelectedProvisional = true
      outcome = pageSettings.pickOutcome({ cancelled: false, optionIndex: 1 }, entry, pageSettings.picker(entry).values)

      m.assertEqual(outcome.action, pageSettings.PICK_CHANGE)
      m.assertEqual(outcome.value, "grid")
    end function

    @it("reports a change to the option whose id is the empty string")
    function _()
      entry = m.defaultTabEntry("genres")
      outcome = pageSettings.pickOutcome({ cancelled: false, optionIndex: 0 }, entry, pageSettings.picker(entry).values)

      m.assertEqual(outcome.action, pageSettings.PICK_CHANGE)
      m.assertEqual(outcome.value, "")
    end function

    @it("reopens the menu when the viewer pressed Back")
    function _()
      entry = m.layoutEntry("grid")
      outcome = pageSettings.pickOutcome({ cancelled: true }, entry, pageSettings.picker(entry).values)

      m.assertEqual(outcome.action, pageSettings.PICK_REOPEN)
    end function

    @it("does nothing for a close that code made, even with a row index on it")
    function _()
      entry = m.layoutEntry("grid")
      result = { cancelled: true, externallyCancelled: true, optionIndex: 0 }
      outcome = pageSettings.pickOutcome(result, entry, pageSettings.picker(entry).values)

      m.assertEqual(outcome.action, pageSettings.PICK_NONE)
    end function

    @it("does nothing for a missing result or a row that is not there")
    function _()
      entry = m.layoutEntry("grid")
      values = pageSettings.picker(entry).values

      m.assertEqual(pageSettings.pickOutcome(invalid, entry, values).action, pageSettings.PICK_NONE)
      m.assertEqual(pageSettings.pickOutcome({ cancelled: false }, entry, values).action, pageSettings.PICK_NONE)
      m.assertEqual(pageSettings.pickOutcome({ cancelled: false, optionIndex: 5 }, entry, values).action, pageSettings.PICK_NONE)
      m.assertEqual(pageSettings.pickOutcome({ cancelled: false, optionIndex: -1 }, entry, values).action, pageSettings.PICK_NONE)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("settingEntry")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    private function boolSetting() as object
      return { settingName: "itemGridShowTitles", type: "bool", title: "Item Titles", default: "true" }
    end function

    private function radioSetting() as object
      return {
        settingName: "uiRowLayout",
        type: "radio",
        title: "Row Layout",
        options: [{ title: "Original", id: "original" }, { title: "Full Width", id: "fullwidth" }]
      }
    end function

    private function integerSetting() as object
      return { settingName: "uiHomeRowLimit", type: "integer", title: "Home Row Size", default: "32", min: 1, max: 100 }
    end function

    private function optionIds(entry as object) as object
      ids = []
      for each option in entry.options
        ids.push(option.id)
      end for
      return ids
    end function

    @it("offers a bool setting as Disabled then Enabled, with the value in force selected")
    function _()
      entry = pageSettings.settingEntry(m.boolSetting(), true, "pkg:/icon.png")

      m.assertEqual(entry.id, "itemGridShowTitles")
      m.assertEqual(entry.title, "Item Titles")
      m.assertEqual(entry.icon, "pkg:/icon.png")
      m.assertEqual(entry.options, [{ id: "false", title: "Disabled" }, { id: "true", title: "Enabled" }])
      m.assertEqual(entry.selected, "true")
      m.assertEqual(pageSettings.settingEntry(m.boolSetting(), false).selected, "false")
    end function

    @it("offers a radio setting's options in their order, with the value in force selected")
    function _()
      entry = pageSettings.settingEntry(m.radioSetting(), "fullwidth")

      m.assertEqual(entry.options, [{ id: "original", title: "Original" }, { id: "fullwidth", title: "Full Width" }])
      m.assertEqual(entry.selected, "fullwidth")
    end function

    @it("titles the entry and its options from their translation keys when they have them")
    function _()
      setting = m.radioSetting()
      setting.titleKey = "LabelRowLayout"
      setting.options[0].titleKey = "LabelOriginal"
      entry = pageSettings.settingEntry(setting, "original")

      m.assertEqual(entry.title, translate(translationKeys.LabelRowLayout))
      m.assertEqual(entry.options[0].title, translate(translationKeys.LabelOriginal))
    end function

    @it("offers an integer setting's steps, the value in force selected")
    function _()
      entry = pageSettings.settingEntry(m.integerSetting(), 32, "", { values: [8, 16, 32, 64] })

      m.assertEqual(m.optionIds(entry), ["8", "16", "32", "64"])
      m.assertEqual(entry.options[2].title, "32")
      m.assertEqual(entry.selected, "32")
    end function

    @it("places a value in force that is not a step among the steps, in order")
    function _()
      steps = { values: [8, 16, 32, 64] }

      m.assertEqual(m.optionIds(pageSettings.settingEntry(m.integerSetting(), 20, "", steps)), ["8", "16", "20", "32", "64"])
      m.assertEqual(m.optionIds(pageSettings.settingEntry(m.integerSetting(), 3, "", steps)), ["3", "8", "16", "32", "64"])
      m.assertEqual(m.optionIds(pageSettings.settingEntry(m.integerSetting(), 90, "", steps)), ["8", "16", "32", "64", "90"])
      m.assertEqual(pageSettings.settingEntry(m.integerSetting(), 20, "", steps).selected, "20")
    end function

    @it("selects the setting's default when the field holds no integer")
    function _()
      entry = pageSettings.settingEntry(m.integerSetting(), invalid, "", { values: [8, 16, 32, 64] })

      m.assertEqual(entry.selected, "32")
      m.assertEqual(m.optionIds(entry), ["8", "16", "32", "64"])
    end function

    @it("titles each step through the caller's label function")
    function _()
      entry = pageSettings.settingEntry(m.integerSetting(), 0, "", { values: [0, 7], labelFor: homePageSettings.maxDaysLabel })

      m.assertEqual(entry.options[0].title, translate(translationKeys.LabelNoLimit))
      m.assertEqual(entry.options[1].title, "7 days")
    end function

    @it("offers nothing for an integer setting without steps, an unknown type or no setting")
    function _()
      m.assertInvalid(pageSettings.settingEntry(m.integerSetting(), 32))
      m.assertInvalid(pageSettings.settingEntry({ settingName: "uiTheme", type: "text" }, ""))
      m.assertInvalid(pageSettings.settingEntry(invalid, true))
      m.assertInvalid(pageSettings.settingEntry({ type: "bool" }, true))
      m.assertInvalid(pageSettings.settingEntry({ settingName: "uiRowLayout", type: "radio", options: [] }, ""))
    end function

    @it("passes its entries through menuRows as any other entry")
    function _()
      menu = pageSettings.menuRows([pageSettings.settingEntry(m.radioSetting(), "fullwidth")])

      m.assertEqual(menu.ids, ["uiRowLayout", pageSettings.ALL_SETTINGS])
      m.assertEqual(menu.labels[0], "Row Layout (Full Width)")
    end function

  end class

end namespace
