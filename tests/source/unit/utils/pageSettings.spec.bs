import "pkg:/source/utils/pageSettings.bs"

namespace tests

  @suite("pageSettings.bs - the settings icon's page menu")
  class PageSettingsTests extends tests.BaseTestSuite

    private function layoutEntry(selected as dynamic) as object
      return {
        id: "layout",
        title: "Layout",
        options: [{ id: "presentation", title: "Presentation" }, { id: "comfortable", title: "Comfortable" }],
        selected: selected
      }
    end function

    ' Piece 07's shape: the first option's id is the empty string.
    private function defaultTabEntry(selected as dynamic) as object
      return {
        id: "defaultTab",
        title: "Default tab",
        options: [{ id: "", title: "Use web client setting" }, { id: "genres", title: "Genres" }],
        selected: selected
      }
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("menuRows")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("lists the entries in order, each with its value, then All settings")
    function _()
      menu = pageSettings.menuRows([m.layoutEntry("comfortable"), m.defaultTabEntry("genres")])

      m.assertEqual(menu.ids, ["layout", "defaultTab", pageSettings.ALL_SETTINGS])
      m.assertEqual(menu.labels, ["Layout (Comfortable)", "Default tab (Genres)", "All settings"])
    end function

    @it("shows the value of an option whose id is the empty string")
    function _()
      menu = pageSettings.menuRows([m.defaultTabEntry("")])

      m.assertEqual(menu.labels[0], "Default tab (Use web client setting)")
    end function

    @it("shows an entry's valueTitle in place of the selected option's title")
    ' The Default tab entry: its first option reads "Default (Movies)", and the row names
    ' the tab alone rather than nest one bracket inside another.
    function _()
      entry = m.defaultTabEntry("")
      entry.valueTitle = "Movies"

      menu = pageSettings.menuRows([entry])

      m.assertEqual(menu.labels[0], "Default tab (Movies)")
    end function

    @it("falls back to the selected option's title when valueTitle is empty")
    @params("")
    @params(invalid)
    function _(valueTitle)
      entry = m.layoutEntry("comfortable")
      entry.valueTitle = valueTitle

      m.assertEqual(pageSettings.menuRows([entry]).labels[0], "Layout (Comfortable)")
    end function

    @it("shows the title alone when the selected id names no option")
    @params("posters")
    @params(invalid)
    function _(selected)
      menu = pageSettings.menuRows([m.layoutEntry(selected)])

      m.assertEqual(menu.labels, ["Layout", "All settings"])
    end function

    @it("has no menu, and no All settings row, when a screen offers nothing")
    @params([])
    @params(invalid)
    @params("layout")
    function _(entries)
      menu = pageSettings.menuRows(entries)

      m.assertEqual(menu.ids, [])
      m.assertEqual(menu.labels, [])
    end function

    @it("leaves out an entry it cannot show")
    function _()
      noOptions = { id: "empty", title: "Empty", options: [] }
      noId = { title: "Nameless", options: [{ id: "a", title: "A" }] }
      reserved = { id: pageSettings.ALL_SETTINGS, title: "Impostor", options: [{ id: "a", title: "A" }] }

      badOption = { id: "bad", title: "Bad", options: [{ id: "a", title: "A" }, "b"] }
      noOptionId = { id: "blank", title: "Blank", options: [{ title: "A" }] }

      menu = pageSettings.menuRows([noOptions, noId, reserved, invalid, badOption, noOptionId, m.layoutEntry("comfortable")])

      m.assertEqual(menu.ids, ["layout", pageSettings.ALL_SETTINGS])
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("findEntry")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("finds an entry by id and reports a missing one as invalid")
    function _()
      entries = [m.layoutEntry("comfortable"), m.defaultTabEntry("")]

      m.assertEqual(pageSettings.findEntry(entries, "defaultTab").title, "Default tab")
      m.assertInvalid(pageSettings.findEntry(entries, "sort"))
      m.assertInvalid(pageSettings.findEntry(entries, pageSettings.ALL_SETTINGS))
      m.assertInvalid(pageSettings.findEntry(invalid, "layout"))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("picker")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("lists the options with the selected one marked")
    function _()
      list = pageSettings.picker(m.layoutEntry("comfortable"))

      m.assertEqual(list.labels, ["Presentation", "Comfortable"])
      m.assertEqual(list.values, ["presentation", "comfortable"])
      m.assertEqual(list.selectedIndex, 1)
    end function

    @it("marks an option whose id is the empty string")
    function _()
      m.assertEqual(pageSettings.picker(m.defaultTabEntry("")).selectedIndex, 0)
    end function

    @it("marks nothing when the selected id names no option")
    function _()
      m.assertEqual(pageSettings.picker(m.layoutEntry("posters")).selectedIndex, -1)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("pickOutcome")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("reports a change for a pick other than the option in force")
    function _()
      entry = m.layoutEntry("comfortable")
      outcome = pageSettings.pickOutcome({ cancelled: false, optionIndex: 0 }, entry, pageSettings.picker(entry).values)

      m.assertEqual(outcome.action, pageSettings.PICK_CHANGE)
      m.assertEqual(outcome.value, "presentation")
    end function

    @it("does nothing for a pick of the option already in force")
    function _()
      entry = m.layoutEntry("comfortable")
      outcome = pageSettings.pickOutcome({ cancelled: false, optionIndex: 1 }, entry, pageSettings.picker(entry).values)

      m.assertEqual(outcome.action, pageSettings.PICK_NONE)
    end function

    @it("reports a change to the option whose id is the empty string")
    function _()
      entry = m.defaultTabEntry("genres")
      outcome = pageSettings.pickOutcome({ cancelled: false, optionIndex: 0 }, entry, pageSettings.picker(entry).values)

      m.assertEqual(outcome.action, pageSettings.PICK_CHANGE)
      m.assertEqual(outcome.value, "")
    end function

    @it("reopens the menu when the viewer pressed Back")
    function _()
      entry = m.layoutEntry("comfortable")
      outcome = pageSettings.pickOutcome({ cancelled: true }, entry, pageSettings.picker(entry).values)

      m.assertEqual(outcome.action, pageSettings.PICK_REOPEN)
    end function

    @it("does nothing for a close that code made, even with a row index on it")
    function _()
      entry = m.layoutEntry("comfortable")
      result = { cancelled: true, externallyCancelled: true, optionIndex: 0 }
      outcome = pageSettings.pickOutcome(result, entry, pageSettings.picker(entry).values)

      m.assertEqual(outcome.action, pageSettings.PICK_NONE)
    end function

    @it("does nothing for a missing result or a row that is not there")
    function _()
      entry = m.layoutEntry("comfortable")
      values = pageSettings.picker(entry).values

      m.assertEqual(pageSettings.pickOutcome(invalid, entry, values).action, pageSettings.PICK_NONE)
      m.assertEqual(pageSettings.pickOutcome({ cancelled: false }, entry, values).action, pageSettings.PICK_NONE)
      m.assertEqual(pageSettings.pickOutcome({ cancelled: false, optionIndex: 5 }, entry, values).action, pageSettings.PICK_NONE)
      m.assertEqual(pageSettings.pickOutcome({ cancelled: false, optionIndex: -1 }, entry, values).action, pageSettings.PICK_NONE)
    end function

  end class

end namespace
