import "pkg:/source/enums/PlaybackEndReport.bs"
import "pkg:/source/utils/playbackEnd.bs"

namespace tests

  @suite("playbackEnd.bs")
  class PlaybackEndTests extends tests.BaseTestSuite

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("classifyPlaybackEnd() — a stream that played")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("reports a stop the server saves the position from")
    function _()
      m.assertEqual(classifyPlaybackEnd("stopped", true, false, false), PlaybackEndReport.STOPPED)
    end function

    @it("reports finished when it played to its end")
    function _()
      m.assertEqual(classifyPlaybackEnd("finished", true, false, false), PlaybackEndReport.FINISHED)
    end function

    @it("marks a terminal error failed even after playing")
    function _()
      m.assertEqual(classifyPlaybackEnd("error", true, false, false), PlaybackEndReport.FAILED)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("classifyPlaybackEnd() — a stream that never played (#969)")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("marks its stop failed, so the resume point survives")
    function _()
      m.assertEqual(classifyPlaybackEnd("stopped", false, false, false), PlaybackEndReport.FAILED)
    end function

    @it("marks its finished failed too")
    function _()
      m.assertEqual(classifyPlaybackEnd("finished", false, false, false), PlaybackEndReport.FAILED)
    end function

    @it("marks a terminal error failed")
    function _()
      m.assertEqual(classifyPlaybackEnd("error", false, false, false), PlaybackEndReport.FAILED)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("classifyPlaybackEnd() — one report per stream")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("reports nothing once the end was reported, whatever state follows")
    function _()
      for each playerState in ["stopped", "finished", "error"]
        m.assertEqual(classifyPlaybackEnd(playerState, false, true, false), PlaybackEndReport.NONE, playerState)
        m.assertEqual(classifyPlaybackEnd(playerState, true, true, false), PlaybackEndReport.NONE, playerState)
        m.assertEqual(classifyPlaybackEnd(playerState, true, true, true), PlaybackEndReport.NONE, playerState)
      end for
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("classifyPlaybackEnd() — a force-finish")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("leaves its stopped to the finished that follows")
    function _()
      m.assertEqual(classifyPlaybackEnd("stopped", true, false, true), PlaybackEndReport.NONE)
    end function

    @it("reports its finished")
    function _()
      m.assertEqual(classifyPlaybackEnd("finished", true, false, true), PlaybackEndReport.FINISHED)
    end function

    @it("still marks a terminal error failed")
    function _()
      m.assertEqual(classifyPlaybackEnd("error", true, false, true), PlaybackEndReport.FAILED)
    end function

    @it("reports its finished even before a start was reported")
    function _()
      m.assertEqual(classifyPlaybackEnd("finished", false, false, true), PlaybackEndReport.FINISHED)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("endClosesLiveStream() — a live stream the server never linked to this session")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("closes a live stream that ended without reporting its start")
    function _()
      for each report in [PlaybackEndReport.FAILED, PlaybackEndReport.FINISHED]
        m.assertTrue(endClosesLiveStream(report, false, "live-stream-1"), report)
      end for
    end function

    @it("never closes a live stream that reported its start, because its stop already released it")
    function _()
      for each report in [PlaybackEndReport.STOPPED, PlaybackEndReport.FINISHED, PlaybackEndReport.FAILED]
        m.assertFalse(endClosesLiveStream(report, true, "live-stream-1"), report)
      end for
    end function

    @it("closes nothing when no end is reported")
    function _()
      m.assertFalse(endClosesLiveStream(PlaybackEndReport.NONE, false, "live-stream-1"))
    end function

    @it("closes nothing for a stream with no live stream id")
    function _()
      m.assertFalse(endClosesLiveStream(PlaybackEndReport.FAILED, false, invalid))
      m.assertFalse(endClosesLiveStream(PlaybackEndReport.FAILED, false, ""))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("liveStreamLeftByFailedLoad() — a load that opened a live stream and then failed")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("names the live stream a failed load opened")
    function _()
      video = { content: invalid, transcodeParams: { LiveStreamId: "live-stream-1" } }

      m.assertEqual(liveStreamLeftByFailedLoad(video), "live-stream-1")
    end function

    @it("leaves a loaded stream to the player, which closes it")
    function _()
      video = { content: CreateObject("roSGNode", "ContentNode"), transcodeParams: { LiveStreamId: "live-stream-1" } }

      m.assertEqual(liveStreamLeftByFailedLoad(video), "")
    end function

    @it("names nothing when the failed load never opened a live stream")
    function _()
      m.assertEqual(liveStreamLeftByFailedLoad({ content: invalid }), "")
      m.assertEqual(liveStreamLeftByFailedLoad({ content: invalid, transcodeParams: { LiveStreamId: invalid } }), "")
      m.assertEqual(liveStreamLeftByFailedLoad({ content: invalid, transcodeParams: { LiveStreamId: "" } }), "")
    end function

  end class

end namespace
