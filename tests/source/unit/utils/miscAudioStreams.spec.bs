namespace tests

  @suite("misc.bs - Audio Stream Functions")
  class MiscAudioStreamsTests extends tests.BaseTestSuite

    protected override function setup()
      super.setup()
      ' Setup mock stream data with various configurations
      m.setupMockStreamData()
    end function

    ' Helper function to create mock stream data
    sub setupMockStreamData()
      ' Standard stream configuration: video at 0, audio at 1 and 2
      m.standardStreams = [
        { Type: "Video", index: 0, Codec: "h264" },
        { Type: "Audio", index: 1, Language: "eng", Codec: "aac" },
        { Type: "Audio", index: 2, Language: "jpn", Codec: "aac" }
      ]

      ' Non-contiguous indexes (e.g., video stream removed)
      m.nonContiguousStreams = [
        { Type: "Audio", index: 5, Language: "eng", Codec: "aac" },
        { Type: "Audio", index: 10, Language: "jpn", Codec: "aac" },
        { Type: "Subtitle", index: 15, Language: "eng" }
      ]

      ' Audio first configuration
      m.audioFirstStreams = [
        { Type: "Audio", index: 0, Language: "eng", Codec: "aac" },
        { Type: "Video", index: 1, Codec: "h264" },
        { Type: "Audio", index: 2, Language: "spa", Codec: "aac" }
      ]

      ' Only video streams (no audio)
      m.noAudioStreams = [
        { Type: "Video", index: 0, Codec: "h264" },
        { Type: "Subtitle", index: 1, Language: "eng" }
      ]

      ' Streams with missing index fields
      m.missingIndexStreams = [
        { Type: "Video", Codec: "h264" },
        { Type: "Audio", index: 5, Language: "eng", Codec: "aac" },
        { Type: "Audio", Language: "jpn", Codec: "aac" }
      ]

      ' Multiple languages for preference testing
      m.multiLanguageStreams = [
        { Type: "Video", index: 0, Codec: "h264" },
        { Type: "Audio", index: 1, Language: "jpn", Codec: "aac" },
        { Type: "Audio", index: 2, Language: "eng", Codec: "aac" },
        { Type: "Audio", index: 3, Language: "spa", Codec: "aac" }
      ]
    end sub

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("getFirstAudioStreamIndex()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("returns 0 when streams is invalid")
    function _()
      result = getFirstAudioStreamIndex(invalid)
      m.assertEqual(result, 0)
    end function

    @it("returns 0 when streams is empty array")
    function _()
      result = getFirstAudioStreamIndex([])
      m.assertEqual(result, 0)
    end function

    @it("returns 0 when no audio streams exist")
    function _()
      result = getFirstAudioStreamIndex(m.noAudioStreams)
      m.assertEqual(result, 0)
    end function

    @it("returns first audio stream index when audio is not at position 0")
    function _()
      result = getFirstAudioStreamIndex(m.standardStreams)
      m.assertEqual(result, 1)
    end function

    @it("returns first audio stream index when audio is at position 0")
    function _()
      result = getFirstAudioStreamIndex(m.audioFirstStreams)
      m.assertEqual(result, 0)
    end function

    @it("returns correct Jellyfin index with non-contiguous indexes")
    function _()
      result = getFirstAudioStreamIndex(m.nonContiguousStreams)
      m.assertEqual(result, 5)
    end function

    @it("skips audio streams with missing index field")
    function _()
      ' Should skip the first audio stream (no index) and return the second audio stream's index
      result = getFirstAudioStreamIndex(m.missingIndexStreams)
      m.assertEqual(result, 5)
    end function

    @it("returns 0 when all audio streams have missing index field")
    function _()
      streams = [
        { Type: "Video", index: 0, Codec: "h264" },
        { Type: "Audio", Language: "eng", Codec: "aac" },
        { Type: "Audio", Language: "jpn", Codec: "aac" }
      ]
      result = getFirstAudioStreamIndex(streams)
      m.assertEqual(result, 0)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("getRokuAudioTrackPosition() - fallback (no availableAudioTracks)")
    ' When availableAudioTracks is not provided, uses Jellyfin Index + 1
    ' as the Roku Track identifier (MKV 1-based track numbering).
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("returns Index + 1 fallback when audioStreamsArray is invalid")
    function _()
      result = getRokuAudioTrackPosition(5, invalid)
      m.assertEqual(result, "6")
    end function

    @it("returns Index + 1 fallback when audioStreamsArray is empty")
    function _()
      result = getRokuAudioTrackPosition(5, [])
      m.assertEqual(result, "6")
    end function

    @it("returns Index + 1 for standard MKV layout (video=0, audio=1, audio=2)")
    function _()
      audioStreams = [
        { index: 1, Language: "kor" },
        { index: 2, Language: "eng" }
      ]
      ' Korean at Jellyfin index 1 → Roku Track 2
      m.assertEqual(getRokuAudioTrackPosition(1, audioStreams), "2")
      ' English at Jellyfin index 2 → Roku Track 3
      m.assertEqual(getRokuAudioTrackPosition(2, audioStreams), "3")
    end function

    @it("returns Index + 1 for audio at index 0")
    function _()
      audioStreams = [
        { index: 0, Language: "eng" },
        { index: 2, Language: "spa" }
      ]
      m.assertEqual(getRokuAudioTrackPosition(0, audioStreams), "1")
    end function

    @it("returns Index + 1 for non-contiguous Jellyfin indexes")
    function _()
      audioStreams = [
        { index: 100, Language: "eng" },
        { index: 200, Language: "jpn" }
      ]
      m.assertEqual(getRokuAudioTrackPosition(200, audioStreams), "201")
    end function

    @it("returns Index + 1 for single-element array")
    function _()
      audioStreams = [
        { index: 7, Language: "tur" }
      ]
      m.assertEqual(getRokuAudioTrackPosition(7, audioStreams), "8")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("getRokuAudioTrackPosition() - with availableAudioTracks")
    ' When Roku's availableAudioTracks is provided, matches by language
    ' for accurate Track identification regardless of MKV numbering.
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("matches Track by language from availableAudioTracks")
    function _()
      audioStreams = [
        { index: 1, Language: "kor" },
        { index: 2, Language: "eng" }
      ]
      rokuTracks = [
        { Track: "2", Language: "kor", Name: "Korean" },
        { Track: "3", Language: "eng", Name: "English" }
      ]
      ' Korean at Jellyfin index 1 → matches Roku Track "2" by language
      m.assertEqual(getRokuAudioTrackPosition(1, audioStreams, rokuTracks), "2")
      ' English at Jellyfin index 2 → matches Roku Track "3" by language
      m.assertEqual(getRokuAudioTrackPosition(2, audioStreams, rokuTracks), "3")
    end function

    @it("language matching is case-insensitive")
    function _()
      audioStreams = [
        { index: 1, Language: "ENG" }
      ]
      rokuTracks = [
        { Track: "2", Language: "eng", Name: "English" }
      ]
      m.assertEqual(getRokuAudioTrackPosition(1, audioStreams, rokuTracks), "2")
    end function

    @it("falls back to Index + 1 when language not found in availableAudioTracks")
    function _()
      audioStreams = [
        { index: 1, Language: "fra" }
      ]
      rokuTracks = [
        { Track: "2", Language: "eng", Name: "English" }
      ]
      ' French not in Roku tracks → fallback to Index + 1
      m.assertEqual(getRokuAudioTrackPosition(1, audioStreams, rokuTracks), "2")
    end function

    @it("falls back to Index + 1 when Jellyfin stream has no Language")
    function _()
      audioStreams = [
        { index: 5 }
      ]
      rokuTracks = [
        { Track: "6", Language: "eng", Name: "English" }
      ]
      m.assertEqual(getRokuAudioTrackPosition(5, audioStreams, rokuTracks), "6")
    end function

    @it("falls back to Index + 1 when availableAudioTracks entries lack Track or Language")
    function _()
      audioStreams = [
        { index: 1, Language: "eng" }
      ]
      rokuTracks = [
        { Name: "English" }
      ]
      m.assertEqual(getRokuAudioTrackPosition(1, audioStreams, rokuTracks), "2")
    end function

    @it("handles Roku reordering tracks differently from Jellyfin")
    ' Roku may reorder tracks (e.g., device language first).
    ' Language matching handles this correctly.
    function _()
      audioStreams = [
        { index: 1, Language: "kor" },
        { index: 2, Language: "eng" }
      ]
      ' Roku reordered: English first, Korean second
      rokuTracks = [
        { Track: "3", Language: "eng", Name: "English" },
        { Track: "2", Language: "kor", Name: "Korean" }
      ]
      m.assertEqual(getRokuAudioTrackPosition(1, audioStreams, rokuTracks), "2")
      m.assertEqual(getRokuAudioTrackPosition(2, audioStreams, rokuTracks), "3")
    end function

  end class

end namespace
