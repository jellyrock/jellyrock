namespace tests

  @suite("misc.bs - Audio Stream Functions")
  class MiscAudioStreamsTests extends tests.BaseTestSuite

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("getRokuAudioTrackPosition() - fallback (no availableAudioTracks)")
    ' When availableAudioTracks is not provided, uses Jellyfin Index + 1
    ' as the Roku Track identifier (MKV 1-based track numbering).
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("returns Index + 1 fallback when audioStreamsArray is invalid")
    function _()
      result = getRokuAudioTrackPosition(5, invalid)
      m.assertEqual(result, "6")
    end function

    @it("returns Index + 1 fallback when audioStreamsArray is empty")
    function _()
      result = getRokuAudioTrackPosition(5, [])
      m.assertEqual(result, "6")
    end function

    @it("returns Index + 1 for standard MKV layout (video=0, audio=1, audio=2)")
    function _()
      audioStreams = [
        { index: 1, language: "kor" },
        { index: 2, language: "eng" }
      ]
      ' Korean at Jellyfin index 1 → Roku Track 2
      m.assertEqual(getRokuAudioTrackPosition(1, audioStreams), "2")
      ' English at Jellyfin index 2 → Roku Track 3
      m.assertEqual(getRokuAudioTrackPosition(2, audioStreams), "3")
    end function

    @it("returns Index + 1 for audio at index 0")
    function _()
      audioStreams = [
        { index: 0, language: "eng" },
        { index: 2, language: "spa" }
      ]
      m.assertEqual(getRokuAudioTrackPosition(0, audioStreams), "1")
    end function

    @it("returns Index + 1 for non-contiguous Jellyfin indexes")
    function _()
      audioStreams = [
        { index: 100, language: "eng" },
        { index: 200, language: "jpn" }
      ]
      m.assertEqual(getRokuAudioTrackPosition(200, audioStreams), "201")
    end function

    @it("returns Index + 1 for single-element array")
    function _()
      audioStreams = [
        { index: 7, language: "tur" }
      ]
      m.assertEqual(getRokuAudioTrackPosition(7, audioStreams), "8")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("getRokuAudioTrackPosition() - with availableAudioTracks")
    ' When Roku's availableAudioTracks is provided, matches by language
    ' for accurate Track identification regardless of MKV numbering.
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("matches Track by language from availableAudioTracks")
    function _()
      audioStreams = [
        { index: 1, language: "kor" },
        { index: 2, language: "eng" }
      ]
      rokuTracks = [
        { track: "2", language: "kor", name: "Korean" },
        { track: "3", language: "eng", name: "English" }
      ]
      ' Korean at Jellyfin index 1 → matches Roku track "2" by language
      m.assertEqual(getRokuAudioTrackPosition(1, audioStreams, rokuTracks), "2")
      ' English at Jellyfin index 2 → matches Roku track "3" by language
      m.assertEqual(getRokuAudioTrackPosition(2, audioStreams, rokuTracks), "3")
    end function

    @it("language matching is case-insensitive")
    function _()
      audioStreams = [
        { index: 1, language: "ENG" }
      ]
      rokuTracks = [
        { track: "2", language: "eng", name: "English" }
      ]
      m.assertEqual(getRokuAudioTrackPosition(1, audioStreams, rokuTracks), "2")
    end function

    @it("falls back to Index + 1 when language not found in availableAudioTracks")
    function _()
      audioStreams = [
        { index: 1, language: "fra" }
      ]
      rokuTracks = [
        { track: "2", language: "eng", name: "English" }
      ]
      ' French not in Roku tracks → fallback to Index + 1
      m.assertEqual(getRokuAudioTrackPosition(1, audioStreams, rokuTracks), "2")
    end function

    @it("falls back to Index + 1 when Jellyfin stream has no Language")
    function _()
      audioStreams = [
        { index: 5 }
      ]
      rokuTracks = [
        { track: "6", language: "eng", name: "English" }
      ]
      m.assertEqual(getRokuAudioTrackPosition(5, audioStreams, rokuTracks), "6")
    end function

    @it("falls back to Index + 1 when availableAudioTracks entries lack Track or Language")
    function _()
      audioStreams = [
        { index: 1, language: "eng" }
      ]
      rokuTracks = [
        { name: "English" }
      ]
      m.assertEqual(getRokuAudioTrackPosition(1, audioStreams, rokuTracks), "2")
    end function

    @it("handles Roku reordering tracks differently from Jellyfin")
    ' Roku may reorder tracks (e.g., device language first).
    ' Language matching handles this correctly.
    function _()
      audioStreams = [
        { index: 1, language: "kor" },
        { index: 2, language: "eng" }
      ]
      ' Roku reordered: English first, Korean second
      rokuTracks = [
        { track: "3", language: "eng", name: "English" },
        { track: "2", language: "kor", name: "Korean" }
      ]
      m.assertEqual(getRokuAudioTrackPosition(1, audioStreams, rokuTracks), "2")
      m.assertEqual(getRokuAudioTrackPosition(2, audioStreams, rokuTracks), "3")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("getRokuAudioTrackPosition() - same-language ordinal disambiguation (issue #500)")
    ' When multiple streams share a language (e.g. main + commentary), match the Nth
    ' same-language Jellyfin stream to the Nth same-language Roku track in original order.
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("picks the second English Roku track when the second English Jellyfin stream is selected")
    function _()
      ' Main English 8ch + commentary English 2ch — both eng.
      audioStreams = [
        { index: 1, language: "eng" },
        { index: 2, language: "eng" }
      ]
      rokuTracks = [
        { track: "2", language: "eng", name: "English Main" },
        { track: "3", language: "eng", name: "English Commentary" }
      ]
      ' First English Jellyfin → first English Roku track
      m.assertEqual(getRokuAudioTrackPosition(1, audioStreams, rokuTracks), "2")
      ' Second English Jellyfin → second English Roku track (was returning "2" before fix)
      m.assertEqual(getRokuAudioTrackPosition(2, audioStreams, rokuTracks), "3")
    end function

    @it("ordinal match still works with mixed languages interleaved")
    function _()
      ' eng-main, jpn, eng-commentary, spa — three different languages mixed.
      audioStreams = [
        { index: 1, language: "eng" },
        { index: 2, language: "jpn" },
        { index: 3, language: "eng" },
        { index: 4, language: "spa" }
      ]
      rokuTracks = [
        { track: "2", language: "eng", name: "English Main" },
        { track: "3", language: "jpn", name: "Japanese" },
        { track: "4", language: "eng", name: "English Commentary" },
        { track: "5", language: "spa", name: "Spanish" }
      ]
      m.assertEqual(getRokuAudioTrackPosition(1, audioStreams, rokuTracks), "2")
      m.assertEqual(getRokuAudioTrackPosition(3, audioStreams, rokuTracks), "4")
      m.assertEqual(getRokuAudioTrackPosition(2, audioStreams, rokuTracks), "3")
      m.assertEqual(getRokuAudioTrackPosition(4, audioStreams, rokuTracks), "5")
    end function

    @it("falls back to Index + 1 when fewer same-language Roku tracks than Jellyfin streams")
    function _()
      ' Two Jellyfin English streams, but Roku only sees one (e.g., transcode hid the other).
      audioStreams = [
        { index: 1, language: "eng" },
        { index: 2, language: "eng" }
      ]
      rokuTracks = [
        { track: "2", language: "eng", name: "English" }
      ]
      ' First eng → Roku track "2" by ordinal match
      m.assertEqual(getRokuAudioTrackPosition(1, audioStreams, rokuTracks), "2")
      ' Second eng has no Roku counterpart → fallback Index + 1 = "3"
      m.assertEqual(getRokuAudioTrackPosition(2, audioStreams, rokuTracks), "3")
    end function

  end class

end namespace
