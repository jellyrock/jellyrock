import "pkg:/source/utils/episodeQueue.bs"

namespace tests

  ' One copy per episode in a queue built from a list of episodes: the rules in episodeQueue.
  ' collapseCopies() / collapseQueue() are the network shell around them and are covered on
  ' device.
  @suite("episodeQueue - one copy per episode")
  class EpisodeQueueTests extends tests.BaseTestSuite

    private function caps1080() as object
      return { maxHeight: 1080, maxWidth: 1920, canDecode4k: false, supportsHdr10: false, supportsDolbyVision: false, supportsHlg: false, isMock: true }
    end function

    private function source(id as string, height as integer) as object
      return {
        Id: id,
        SupportsDirectPlay: true,
        MediaStreams: [{ Type: "Video", Height: height, Width: int(height * 16 / 9), Codec: "h264", VideoRange: "SDR", IsInterlaced: false }]
      }
    end function

    private function episode(id as string, season as dynamic, number as dynamic, seriesId = "show" as string) as object
      return { Id: id, Type: "Episode", SeriesId: seriesId, ParentIndexNumber: season, IndexNumber: number }
    end function

    private function withUserData(item as object, played as boolean, positionTicks = 0& as longinteger, lastPlayed = "" as string) as object
      item.UserData = { Played: played, PlaybackPositionTicks: positionTicks }
      if lastPlayed <> "" then item.UserData.LastPlayedDate = lastPlayed
      return item
    end function

    ' How 10.7 through 10.11 list the Version Episodes fixture: every file its own episode, and
    ' E1's 720p copy ahead of its 1080p one (queried on each 2026-09-19).
    private function listedPre12() as object
      return [
        m.episode("e1-720", 1, 1), m.episode("e1-1080", 1, 1),
        m.episode("e2-1080", 1, 2), m.episode("e2-720", 1, 2),
        m.episode("e3-1080", 1, 3), m.episode("e3-480", 1, 3),
        m.episode("e4-1080", 1, 4)
      ]
    end function

    private function ids(items as object) as string
      out = []
      for each item in items
        out.push(item.Id)
      end for
      return out.join(",")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("episodeKey()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("keys a numbered episode by series, season and number")
    function _()
      m.assertEqual(episodeQueue.episodeKey(m.episode("a", 1, 2)), "show/S1E2")
    end function

    @it("never keys an unnumbered item")
    function _()
      m.assertEqual(episodeQueue.episodeKey(m.episode("a", 1, invalid)), "")
      m.assertEqual(episodeQueue.episodeKey(m.episode("a", invalid, 2)), "")
      m.assertEqual(episodeQueue.episodeKey(invalid), "")
    end function

    @it("never keys an episode without a series")
    function _()
      m.assertEqual(episodeQueue.episodeKey(m.episode("a", 1, 2, "")), "")
    end function

    @it("never keys anything but an episode, such as a track with disc and track numbers")
    function _()
      track = { Id: "t", Type: "Audio", ParentIndexNumber: 1, IndexNumber: 2 }
      m.assertEqual(episodeQueue.episodeKey(track), "")
      movie = m.episode("m", 1, 2)
      movie.Type = "Movie"
      m.assertEqual(episodeQueue.episodeKey(movie), "")
    end function

    @it("never keys a multi-episode file, which covers more than its first number")
    function _()
      item = m.episode("a", 1, 2)
      item.IndexNumberEnd = 3
      m.assertEqual(episodeQueue.episodeKey(item), "")
    end function

    @it("keys an episode whose end number repeats its number")
    function _()
      item = m.episode("a", 1, 2)
      item.IndexNumberEnd = 2
      m.assertEqual(episodeQueue.episodeKey(item), "show/S1E2")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("groupByEpisode()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("groups a pre-12.0 server's copies of one episode, in first-seen order")
    function _()
      groups = episodeQueue.groupByEpisode(m.listedPre12())
      m.assertEqual(groups.count(), 4)
      m.assertEqual(m.ids(groups[0]), "e1-720,e1-1080")
      m.assertEqual(m.ids(groups[1]), "e2-1080,e2-720")
      m.assertEqual(m.ids(groups[2]), "e3-1080,e3-480")
      m.assertEqual(m.ids(groups[3]), "e4-1080")
    end function

    @it("leaves out every copy of the episode already playing")
    ' The server lists E1's 720p copy first, so a queue started from it would otherwise play E1
    ' again from the 1080p copy.
    function _()
      groups = episodeQueue.groupByEpisode(m.listedPre12(), "show/S1E1")
      m.assertEqual(groups.count(), 3)
      m.assertEqual(m.ids(groups[0]), "e2-1080,e2-720")
    end function

    @it("changes nothing when no episode has copies (a 12.0 queue)")
    function _()
      groups = episodeQueue.groupByEpisode([m.episode("e1", 1, 1), m.episode("e2", 1, 2)])
      m.assertEqual(groups.count(), 2)
      m.assertEqual(m.ids(groups[0]), "e1")
      m.assertEqual(m.ids(groups[1]), "e2")
    end function

    @it("keeps the same number in different seasons apart")
    function _()
      groups = episodeQueue.groupByEpisode([m.episode("s1e1", 1, 1), m.episode("s2e1", 2, 1)])
      m.assertEqual(groups.count(), 2)
    end function

    @it("keeps the same number in different shows apart")
    ' A shuffle across shows lists S1E1 of each.
    function _()
      groups = episodeQueue.groupByEpisode([m.episode("a-s1e1", 1, 1, "a"), m.episode("b-s1e1", 1, 1, "b")])
      m.assertEqual(groups.count(), 2)
    end function

    @it("keeps every unkeyed item, each on its own")
    function _()
      groups = episodeQueue.groupByEpisode([m.episode("x", 1, invalid), m.episode("y", 1, invalid)], "")
      m.assertEqual(groups.count(), 2)
    end function

    @it("returns nothing for no items")
    function _()
      m.assertEqual(episodeQueue.groupByEpisode(invalid).count(), 0)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("copyIds()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("names only items that have another copy")
    function _()
      groups = episodeQueue.groupByEpisode(m.listedPre12())
      m.assertEqual(episodeQueue.copyIds(groups).join(","), "e1-720,e1-1080,e2-1080,e2-720,e3-1080,e3-480")
    end function

    @it("names nothing for a queue without copies")
    function _()
      groups = episodeQueue.groupByEpisode([m.episode("e1", 1, 1), m.episode("e2", 1, 2)])
      m.assertEqual(episodeQueue.copyIds(groups).count(), 0)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("isGroupPlayed() / inProgressCopy()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("counts an episode watched when any copy is")
    function _()
      group = [m.withUserData(m.episode("e1-720", 1, 1), false), m.withUserData(m.episode("e1-1080", 1, 1), true)]
      m.assertTrue(episodeQueue.isGroupPlayed(group))
    end function

    @it("counts an episode unwatched when no copy is, or none says")
    function _()
      m.assertFalse(episodeQueue.isGroupPlayed([m.withUserData(m.episode("a", 1, 1), false), m.episode("b", 1, 1)]))
    end function

    @it("finds the copy the viewer is partway through")
    function _()
      group = [m.withUserData(m.episode("e1-720", 1, 1), false), m.withUserData(m.episode("e1-1080", 1, 1), false, 2000000000&)]
      m.assertEqual(episodeQueue.inProgressCopy(group).Id, "e1-1080")
    end function

    @it("takes the most recently played of two copies in progress")
    function _()
      group = [
        m.withUserData(m.episode("e1-720", 1, 1), false, 1000000000&, "2026-09-18T20:00:00.0000000Z"),
        m.withUserData(m.episode("e1-1080", 1, 1), false, 3000000000&, "2026-09-19T08:00:00.0000000Z")
      ]
      m.assertEqual(episodeQueue.inProgressCopy(group).Id, "e1-1080")
    end function

    @it("finds no copy in progress when none has a position")
    function _()
      group = [m.withUserData(m.episode("e1-720", 1, 1), false), m.episode("e1-1080", 1, 1)]
      m.assertInvalid(episodeQueue.inProgressCopy(group))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("chooseCopy()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("keeps the copy matching the explicit pick")
    function _()
      group = [m.episode("e2-1080", 1, 2), m.episode("e2-720", 1, 2)]
      sources = { "e2-1080": [m.source("e2-1080", 1080)], "e2-720": [m.source("e2-720", 720)] }
      pref = versionPick.preferenceFor(m.source("e1-720", 720))
      m.assertEqual(episodeQueue.chooseCopy(group, sources, pref, m.caps1080()).Id, "e2-720")
    end function

    @it("keeps the best copy for the device without a pick")
    function _()
      group = [m.episode("e1-720", 1, 1), m.episode("e1-1080", 1, 1)]
      sources = { "e1-720": [m.source("e1-720", 720)], "e1-1080": [m.source("e1-1080", 1080)] }
      m.assertEqual(episodeQueue.chooseCopy(group, sources, invalid, m.caps1080()).Id, "e1-1080")
    end function

    @it("keeps the server's first copy when a copy's sources are unknown")
    function _()
      group = [m.episode("e1-720", 1, 1), m.episode("e1-1080", 1, 1)]
      sources = { "e1-1080": [m.source("e1-1080", 1080)] }
      m.assertEqual(episodeQueue.chooseCopy(group, sources, invalid, m.caps1080()).Id, "e1-720")
    end function

    @it("returns a lone episode untouched")
    function _()
      group = [m.episode("e4", 1, 4)]
      m.assertEqual(episodeQueue.chooseCopy(group, {}, invalid, m.caps1080()).Id, "e4")
    end function

  end class

end namespace
