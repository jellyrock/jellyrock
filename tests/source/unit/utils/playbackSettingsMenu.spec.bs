import "pkg:/source/syncplay/syncPlayQueue.bs"
import "pkg:/source/translationKeys.bs"
import "pkg:/source/utils/playbackSettingsMenu.bs"
import "pkg:/source/utils/queueRepeat.bs"
import "pkg:/source/utils/translate.bs"

namespace tests

  @suite("playbackSettingsMenu.bs - the OSD gear menu and its Maximum Bitrate choices")
  class PlaybackSettingsMenuTests extends tests.BaseTestSuite

    ' The playbackResolutionMax entry's shape in settings.json, cut to three options.
    private function resolutionSetting() as object
      return {
        settingName: "playbackResolutionMax",
        options: [
          { title: "Off - Attempt to direct play all resolutions", id: "off", titleKey: "LabelOffAttemptToDirectPlayAll" },
          { title: "Auto - Use TV resolution", id: "auto", titleKey: "LabelAutoUseTvResolution" },
          { title: "720p", id: "720", titleKey: "Label720p" }
        ]
      }
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("rows")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("shows each cap with its value in parentheses")
    function _()
      menu = playbackSettingsMenu.rows(false, 0, "auto", m.resolutionSetting(), queueRepeat.OFF)
      m.assertEqual(menu.ids, [playbackSettingsMenu.ROW_MAX_BITRATE, playbackSettingsMenu.ROW_MAX_RESOLUTION, playbackSettingsMenu.ROW_REPEAT])
      m.assertEqual(menu.labels, ["Maximum Bitrate (No limit)", "Maximum Resolution (Auto)", "Repeat (Off)"])
      m.assertEqual(menu.icons, [playbackSettingsMenu.ICON_MAX_BITRATE, playbackSettingsMenu.ICON_MAX_RESOLUTION, playbackSettingsMenu.ICON_REPEAT], "each row wears its glyph, one per row")

      menu = playbackSettingsMenu.rows(false, 2, "720", m.resolutionSetting(), queueRepeat.ALL)
      m.assertEqual(menu.labels, ["Maximum Bitrate (2 Mbps)", "Maximum Resolution (720p)", "Repeat (All)"])
    end function

    @it("names the repeat mode that applies, and off for a mode it does not know")
    function _()
      menu = playbackSettingsMenu.rows(false, 0, "auto", m.resolutionSetting(), queueRepeat.ONE)
      m.assertEqual(menu.labels[2], "Repeat (One)")
      menu = playbackSettingsMenu.rows(false, 0, "auto", m.resolutionSetting(), "")
      m.assertEqual(menu.labels[2], "Repeat (Off)")
    end function

    @it("adds the SyncPlay rows while following a group, and leaves them out otherwise")
    function _()
      menu = playbackSettingsMenu.rows(false, 0, "auto", m.resolutionSetting(), queueRepeat.OFF, invalid)
      m.assertEqual(menu.ids.count(), 3)
      group = { shuffleMode: syncPlayQueue.SHUFFLE_ON, offsetMs: 100 }
      menu = playbackSettingsMenu.rows(false, 0, "auto", m.resolutionSetting(), queueRepeat.ALL, group)
      m.assertEqual(menu.ids, [playbackSettingsMenu.ROW_MAX_BITRATE, playbackSettingsMenu.ROW_MAX_RESOLUTION, playbackSettingsMenu.ROW_REPEAT, playbackSettingsMenu.ROW_SHUFFLE, playbackSettingsMenu.ROW_TIME_OFFSET, playbackSettingsMenu.ROW_LEAVE_GROUP])
      m.assertEqual(menu.labels[3], "Shuffle (On)")
      m.assertEqual(menu.labels[4], "SyncPlay Time Offset (100 ms)")
      m.assertEqual(menu.labels[5], "Leave Group")
      m.assertEqual(menu.icons[3], playbackSettingsMenu.ICON_SHUFFLE)
      m.assertEqual(menu.icons[4], playbackSettingsMenu.ICON_TIME_OFFSET)
      m.assertEqual(menu.icons[5], playbackSettingsMenu.ICON_LEAVE_GROUP)
      menu = playbackSettingsMenu.rows(false, 0, "auto", m.resolutionSetting(), queueRepeat.OFF, { shuffleMode: "Sorted", offsetMs: 0 })
      m.assertEqual(menu.labels[3], "Shuffle (Off)")
      m.assertEqual(menu.labels[4], "SyncPlay Time Offset (0 ms)", "no reading, no drift")
    end function

    ' The row carries the short form; the picker carries the setting's full titles.
    @it("names the off resolution briefly")
    function _()
      menu = playbackSettingsMenu.rows(false, 0, "off", m.resolutionSetting(), queueRepeat.OFF)
      m.assertEqual(menu.labels[1], "Maximum Resolution (Off)")
      m.assertEqual(menu.labels[1], "Maximum Resolution (" + translate(translationKeys.LabelResolutionOff) + ")", "the row's own off, not the subtitles' LabelOff")
    end function

    @it("leaves the resolution row out when the setting's options cannot be read")
    function _()
      menu = playbackSettingsMenu.rows(false, 0, "auto", invalid, queueRepeat.OFF)
      m.assertEqual(menu.ids, [playbackSettingsMenu.ROW_MAX_BITRATE, playbackSettingsMenu.ROW_REPEAT])
    end function

    @it("has no rows for Live TV, so the OSD drops the gear")
    function _()
      menu = playbackSettingsMenu.rows(true, 0, "auto", m.resolutionSetting(), queueRepeat.OFF)
      m.assertEqual(menu.ids.count(), 0)
      m.assertEqual(menu.labels.count(), 0)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("repeatOptions")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    ' The row carries the short form ("Repeat (All)"); the picker carries the full titles.
    @it("offers Off, Repeat all and Repeat one as the queueRepeat modes")
    function _()
      options = playbackSettingsMenu.repeatOptions(queueRepeat.OFF)
      m.assertEqual(options.values, [queueRepeat.OFF, queueRepeat.ALL, queueRepeat.ONE])
      m.assertEqual(options.labels, ["Off", "Repeat all", "Repeat one"])
      m.assertEqual(options.selectedIndex, 0)
      m.assertEqual(options.defaultIndex, 0)
    end function

    @it("checks and focuses the mode that applies")
    function _()
      options = playbackSettingsMenu.repeatOptions(queueRepeat.ONE)
      m.assertEqual(options.selectedIndex, 2)
      m.assertEqual(options.defaultIndex, 2)
      options = playbackSettingsMenu.repeatOptions("")
      m.assertEqual(options.selectedIndex, 0, "an empty mode is off")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("hasPicks")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("is false with no cap and repeat off")
    function _()
      m.assertFalse(playbackSettingsMenu.hasPicks(invalid, queueRepeat.OFF))
      m.assertFalse(playbackSettingsMenu.hasPicks({}, ""))
    end function

    @it("is true on a cap or a repeat mode")
    function _()
      m.assertTrue(playbackSettingsMenu.hasPicks({ maxBitrateMbps: 4 }, queueRepeat.OFF))
      m.assertTrue(playbackSettingsMenu.hasPicks(invalid, queueRepeat.ALL))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("resolutionOptions")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    ' One list: the gear offers the Settings entry's own options, in its order and titles.
    @it("offers the setting's own options, titled as Settings titles them")
    function _()
      options = playbackSettingsMenu.resolutionOptions("auto", m.resolutionSetting())
      m.assertEqual(options.values, ["off", "auto", "720"])
      m.assertEqual(options.labels, ["Off - Attempt to direct play all resolutions", "Auto - Use TV resolution", "720p"])
    end function

    @it("checks and focuses the cap that applies")
    function _()
      options = playbackSettingsMenu.resolutionOptions("720", m.resolutionSetting())
      m.assertEqual(options.selectedIndex, 2)
      m.assertEqual(options.defaultIndex, 2)
    end function

    @it("checks nothing when the current value is not an option")
    function _()
      options = playbackSettingsMenu.resolutionOptions("999", m.resolutionSetting())
      m.assertEqual(options.selectedIndex, -1)
      m.assertEqual(options.defaultIndex, 0)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("bitrateOptions")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("offers No limit then the whole ladder when the source bitrate is unknown")
    function _()
      options = playbackSettingsMenu.bitrateOptions(0, 0)
      m.assertEqual(options.values, [0, 120, 80, 60, 40, 20, 15, 10, 8, 6, 4, 3, 2, 1])
      m.assertEqual(options.labels[0], "No limit")
      m.assertEqual(options.labels[1], "120 Mbps")
      m.assertEqual(options.labels.count(), options.values.count())
    end function

    ' Steps at or below the source, plus the one above it: anything higher constrains
    ' nothing this source has.
    @it("trims to the source's bitrate plus one step above")
    function _()
      options = playbackSettingsMenu.bitrateOptions(0, 7000000)
      m.assertEqual(options.values, [0, 8, 6, 4, 3, 2, 1])
    end function

    @it("keeps a source exactly on a step without adding the step above it")
    function _()
      options = playbackSettingsMenu.bitrateOptions(0, 8000000)
      m.assertEqual(options.values, [0, 10, 8, 6, 4, 3, 2, 1])
    end function

    @it("still offers the smallest step for a source below it")
    function _()
      options = playbackSettingsMenu.bitrateOptions(0, 500000)
      m.assertEqual(options.values, [0, 1])
    end function

    @it("checks and focuses No limit when no cap is set")
    function _()
      options = playbackSettingsMenu.bitrateOptions(0, 7000000)
      m.assertEqual(options.selectedIndex, 0)
      m.assertEqual(options.defaultIndex, 0)
    end function

    @it("checks and focuses the saved cap")
    function _()
      options = playbackSettingsMenu.bitrateOptions(4, 7000000)
      m.assertEqual(options.values[options.selectedIndex], 4)
      m.assertEqual(options.defaultIndex, options.selectedIndex)
    end function

    ' A number typed in Settings need not be on the ladder; it must still show as current.
    @it("inserts a saved cap that is off the ladder, in order, and checks it")
    function _()
      options = playbackSettingsMenu.bitrateOptions(7, 0)
      m.assertEqual(options.values, [0, 120, 80, 60, 40, 20, 15, 10, 8, 7, 6, 4, 3, 2, 1])
      m.assertEqual(options.values[options.selectedIndex], 7)
      m.assertEqual(options.labels[options.selectedIndex], "7 Mbps")
    end function

    @it("keeps a saved cap the trim would have dropped")
    function _()
      options = playbackSettingsMenu.bitrateOptions(40, 7000000)
      m.assertEqual(options.values, [0, 40, 8, 6, 4, 3, 2, 1])
      m.assertEqual(options.values[options.selectedIndex], 40)
    end function

    @it("keeps the list in descending order when it inserts an off-ladder cap the trim dropped")
    function _()
      options = playbackSettingsMenu.bitrateOptions(5, 500000)
      m.assertEqual(options.values, [0, 5, 1])
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("the SyncPlay rows")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("the time offset row is the offset alone, with no drift reading")
    function _()
      m.assertEqual(playbackSettingsMenu.timeOffsetLabel(100), "100 ms")
      m.assertEqual(playbackSettingsMenu.timeOffsetLabel(0), "0 ms")
      m.assertEqual(playbackSettingsMenu.timeOffsetLabel(invalid), "0 ms")
      m.assertEqual(playbackSettingsMenu.timeOffsetLabel(250&), "250 ms", "a LongInteger, as the manager publishes it")
    end function

    @it("the time offset picker steps by 100 to 500 and checks the value that applies")
    function _()
      options = playbackSettingsMenu.timeOffsetOptions(0)
      m.assertEqual(options.values, [0, 100, 200, 300, 400, 500])
      m.assertEqual(options.labels[1], "100 ms")
      m.assertEqual(options.selectedIndex, 0)
      m.assertEqual(options.defaultIndex, 0)
      options = playbackSettingsMenu.timeOffsetOptions(200)
      m.assertEqual(options.selectedIndex, 2)
      m.assertEqual(options.values[2], 200)
    end function

    @it("a setting off the grid gets its own row, in order, so the checked row is always the value that applies")
    function _()
      options = playbackSettingsMenu.timeOffsetOptions(150)
      m.assertEqual(options.values, [0, 100, 150, 200, 300, 400, 500])
      m.assertEqual(options.selectedIndex, 2)
      m.assertEqual(options.labels[2], "150 ms")
      options = playbackSettingsMenu.timeOffsetOptions(700)
      m.assertEqual(options.values[6], 700)
      m.assertEqual(options.selectedIndex, 6)
    end function

    @it("the shuffle picker offers Off and On in the server's words, with the group's mode checked")
    function _()
      options = playbackSettingsMenu.shuffleOptions("Sorted")
      m.assertEqual(options.labels, ["Off", "On"])
      m.assertEqual(options.values, [syncPlayQueue.SHUFFLE_OFF, syncPlayQueue.SHUFFLE_ON])
      m.assertEqual(options.selectedIndex, 0)
      options = playbackSettingsMenu.shuffleOptions("Shuffle")
      m.assertEqual(options.selectedIndex, 1)
      m.assertEqual(options.defaultIndex, 1)
      m.assertEqual(playbackSettingsMenu.shuffleLabel(invalid), "Off")
    end function

    @it("the group's shuffle lights the gear; the time offset, a saved setting, does not")
    function _()
      m.assertTrue(playbackSettingsMenu.hasPicks({}, queueRepeat.OFF, syncPlayQueue.SHUFFLE_ON))
      m.assertFalse(playbackSettingsMenu.hasPicks({}, queueRepeat.OFF, syncPlayQueue.SHUFFLE_OFF))
      m.assertFalse(playbackSettingsMenu.hasPicks({}, queueRepeat.OFF, invalid))
      m.assertFalse(playbackSettingsMenu.hasPicks({}, queueRepeat.OFF))
    end function

  end class

end namespace
