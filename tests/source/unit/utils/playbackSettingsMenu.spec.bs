import "pkg:/source/translationKeys.bs"
import "pkg:/source/utils/playbackSettingsMenu.bs"
import "pkg:/source/utils/translate.bs"

namespace tests

  @suite("playbackSettingsMenu.bs - the OSD gear menu and its Maximum Bitrate choices")
  class PlaybackSettingsMenuTests extends tests.BaseTestSuite

    ' The playbackResolutionMax entry's shape in settings.json, cut to three options.
    private function resolutionSetting() as object
      return {
        settingName: "playbackResolutionMax",
        options: [
          { title: "Off - Attempt to direct play all resolutions", id: "off", titleKey: "LabelOffAttemptToDirectPlayAll" },
          { title: "Auto - Use TV resolution", id: "auto", titleKey: "LabelAutoUseTvResolution" },
          { title: "720p", id: "720", titleKey: "Label720p" }
        ]
      }
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("rows")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("shows each cap with its value in parentheses")
    function _()
      menu = playbackSettingsMenu.rows(false, 0, "auto", m.resolutionSetting())
      m.assertEqual(menu.ids, [playbackSettingsMenu.ROW_MAX_BITRATE, playbackSettingsMenu.ROW_MAX_RESOLUTION])
      m.assertEqual(menu.labels, ["Maximum Bitrate (No limit)", "Maximum Resolution (Auto)"])
      m.assertEqual(menu.icons, [playbackSettingsMenu.ICON_MAX_BITRATE, playbackSettingsMenu.ICON_MAX_RESOLUTION], "each row wears its glyph, one per row")

      menu = playbackSettingsMenu.rows(false, 2, "720", m.resolutionSetting())
      m.assertEqual(menu.labels, ["Maximum Bitrate (2 Mbps)", "Maximum Resolution (720p)"])
    end function

    ' The row carries the short form; the picker carries the setting's full titles.
    @it("names the off resolution briefly")
    function _()
      menu = playbackSettingsMenu.rows(false, 0, "off", m.resolutionSetting())
      m.assertEqual(menu.labels[1], "Maximum Resolution (Off)")
    end function

    @it("leaves the resolution row out when the setting's options cannot be read")
    function _()
      menu = playbackSettingsMenu.rows(false, 0, "auto", invalid)
      m.assertEqual(menu.ids, [playbackSettingsMenu.ROW_MAX_BITRATE])
    end function

    @it("has no rows for Live TV, so the OSD drops the gear")
    function _()
      menu = playbackSettingsMenu.rows(true, 0, "auto", m.resolutionSetting())
      m.assertEqual(menu.ids.count(), 0)
      m.assertEqual(menu.labels.count(), 0)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("resolutionOptions")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    ' One list: the gear offers the Settings entry's own options, in its order and titles.
    @it("offers the setting's own options, titled as Settings titles them")
    function _()
      options = playbackSettingsMenu.resolutionOptions("auto", m.resolutionSetting())
      m.assertEqual(options.values, ["off", "auto", "720"])
      m.assertEqual(options.labels, ["Off - Attempt to direct play all resolutions", "Auto - Use TV resolution", "720p"])
    end function

    @it("checks and focuses the cap that applies")
    function _()
      options = playbackSettingsMenu.resolutionOptions("720", m.resolutionSetting())
      m.assertEqual(options.selectedIndex, 2)
      m.assertEqual(options.defaultIndex, 2)
    end function

    @it("checks nothing when the current value is not an option")
    function _()
      options = playbackSettingsMenu.resolutionOptions("999", m.resolutionSetting())
      m.assertEqual(options.selectedIndex, -1)
      m.assertEqual(options.defaultIndex, 0)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("bitrateOptions")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("offers No limit then the whole ladder when the source bitrate is unknown")
    function _()
      options = playbackSettingsMenu.bitrateOptions(0, 0)
      m.assertEqual(options.values, [0, 120, 80, 60, 40, 20, 15, 10, 8, 6, 4, 3, 2, 1])
      m.assertEqual(options.labels[0], "No limit")
      m.assertEqual(options.labels[1], "120 Mbps")
      m.assertEqual(options.labels.count(), options.values.count())
    end function

    ' Steps at or below the source, plus the one above it: anything higher constrains
    ' nothing this source has.
    @it("trims to the source's bitrate plus one step above")
    function _()
      options = playbackSettingsMenu.bitrateOptions(0, 7000000)
      m.assertEqual(options.values, [0, 8, 6, 4, 3, 2, 1])
    end function

    @it("keeps a source exactly on a step without adding the step above it")
    function _()
      options = playbackSettingsMenu.bitrateOptions(0, 8000000)
      m.assertEqual(options.values, [0, 10, 8, 6, 4, 3, 2, 1])
    end function

    @it("still offers the smallest step for a source below it")
    function _()
      options = playbackSettingsMenu.bitrateOptions(0, 500000)
      m.assertEqual(options.values, [0, 1])
    end function

    @it("checks and focuses No limit when no cap is set")
    function _()
      options = playbackSettingsMenu.bitrateOptions(0, 7000000)
      m.assertEqual(options.selectedIndex, 0)
      m.assertEqual(options.defaultIndex, 0)
    end function

    @it("checks and focuses the saved cap")
    function _()
      options = playbackSettingsMenu.bitrateOptions(4, 7000000)
      m.assertEqual(options.values[options.selectedIndex], 4)
      m.assertEqual(options.defaultIndex, options.selectedIndex)
    end function

    ' A number typed in Settings need not be on the ladder; it must still show as current.
    @it("inserts a saved cap that is off the ladder, in order, and checks it")
    function _()
      options = playbackSettingsMenu.bitrateOptions(7, 0)
      m.assertEqual(options.values, [0, 120, 80, 60, 40, 20, 15, 10, 8, 7, 6, 4, 3, 2, 1])
      m.assertEqual(options.values[options.selectedIndex], 7)
      m.assertEqual(options.labels[options.selectedIndex], "7 Mbps")
    end function

    @it("keeps a saved cap the trim would have dropped")
    function _()
      options = playbackSettingsMenu.bitrateOptions(40, 7000000)
      m.assertEqual(options.values, [0, 40, 8, 6, 4, 3, 2, 1])
      m.assertEqual(options.values[options.selectedIndex], 40)
    end function

    @it("keeps the list in descending order when it inserts an off-ladder cap the trim dropped")
    function _()
      options = playbackSettingsMenu.bitrateOptions(5, 500000)
      m.assertEqual(options.values, [0, 5, 1])
    end function

  end class

end namespace
