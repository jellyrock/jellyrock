import "pkg:/source/utils/playbackInfo.bs"

namespace tests

  @suite("playbackInfo.bs - display primitives for the playback report")
  class PlaybackInfoTests extends tests.BaseTestSuite

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("getDisplayBitrate")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("renders Mbps to one decimal, matching Jellyfin's own web client")
    function _()
      m.assertEqual(getDisplayBitrate(25400000), "25.4 Mbps")
      m.assertEqual(getDisplayBitrate(4000000), "4.0 Mbps")
      m.assertEqual(getDisplayBitrate(1500000), "1.5 Mbps")
    end function

    @it("never leaks Str()'s leading space")
    function _()
      ' The untrimmed form rendered as "Bit Rate:  4 Mbps" once a row separator
      ' added its own space. Found in an RTA capture, not by any gate.
      rate = getDisplayBitrate(4000000)
      m.assertEqual(rate.left(1), "4", "must not start with a space")
    end function

    @it("drops to whole Kbps at or below a megabit")
    function _()
      m.assertEqual(getDisplayBitrate(1000000), "1000 Kbps")
      m.assertEqual(getDisplayBitrate(850500), "850 Kbps")
    end function

    @it("reads a bitrate out of a node field or a string, not just a literal")
    function _()
      m.assertEqual(getDisplayBitrate({ v: 25400000 }.v), "25.4 Mbps")
      m.assertEqual(getDisplayBitrate("25400000"), "25.4 Mbps")
    end function

    @it("returns empty rather than a bogus figure when there is nothing to show")
    function _()
      m.assertEqual(getDisplayBitrate(invalid), "")
      m.assertEqual(getDisplayBitrate(0), "")
      m.assertEqual(getDisplayBitrate(-1), "")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("getReadableSize")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("renders binary units to one decimal, as the Jellyfin web client does")
    function _()
      m.assertEqual(getReadableSize(1024), "1.0 KiB")
      m.assertEqual(getReadableSize(1048576), "1.0 MiB")
      m.assertEqual(getReadableSize(1073741824), "1.0 GiB")
    end function

    @it("handles a real movie, which is past what a 32-bit integer holds")
    function _()
      ' ~24 GiB. This is the case that rules out routing sizes through
      ' mediaNumber: 2.1 GB already overflows its return.
      m.assertEqual(getReadableSize(26000000000.0), "24.2 GiB")
    end function

    @it("reports raw bytes below a kibibyte")
    function _()
      m.assertEqual(getReadableSize(512), "512 B")
    end function

    @it("returns empty rather than a bogus figure when there is nothing to show")
    function _()
      m.assertEqual(getReadableSize(invalid), "")
      m.assertEqual(getReadableSize(0), "")
      m.assertEqual(getReadableSize(-1), "")
      m.assertEqual(getReadableSize({}), "")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("pairedValue")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("draws an arrow only when the value actually changed")
    function _()
      m.assertEqual(pairedValue("HEVC", "H264"), "HEVC" + PLAYBACK_INFO_ARROW + "H264")
    end function

    @it("omits the arrow when the stream passed through untouched")
    function _()
      ' The ABSENCE of an arrow is how the report says "this was not re-encoded",
      ' which is the question most viewers open the report to answer.
      m.assertEqual(pairedValue("HEVC", ""), "HEVC")
      m.assertEqual(pairedValue("HEVC", "HEVC"), "HEVC")
    end function

    @it("treats a case-different target as unchanged")
    function _()
      ' Source codecs come off the media stream lowercase ("hevc"); target codecs
      ' come off the session uppercase. An arrow between those would be a lie.
      m.assertEqual(pairedValue("HEVC", "hevc"), "HEVC")
      m.assertEqual(pairedValue("5.1", " 5.1 "), "5.1")
    end function

    @it("falls back to whichever side it has")
    function _()
      m.assertEqual(pairedValue("", "H264"), "H264")
      m.assertEqual(pairedValue("", ""), "")
    end function

  end class
end namespace
