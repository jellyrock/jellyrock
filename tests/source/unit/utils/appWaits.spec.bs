import "pkg:/source/utils/appWaits.bs"

namespace tests

  @suite("appWaits - waits the whole app is in, ended by their promise")
  class AppWaitsTests extends tests.BaseTestSuite

    private launcher as object
    private other as object
    private player as object

    protected override sub beforeEach()
      super.beforeEach()
      m.launcher = CreateObject("roSGNode", "JRScreen")
      m.other = CreateObject("roSGNode", "JRScreen")
      m.player = CreateObject("roSGNode", "JRScreen")
      m.player.isPlaybackScreen = true
    end sub

    protected override sub afterEach()
      m.launcher = invalid
      m.other = invalid
      m.player = invalid
      super.afterEach()
    end sub

    private function start(startedMs as dynamic, launchedFrom as dynamic) as object
      return { kind: LoadingKind.PLAYBACK_START, label: "", startedMs: startedMs, deadlineMs: startedMs + timeouts.PLAYBACK_START_LIMIT_MS, launchedFrom: launchedFrom }
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("done() / fail() — the first end wins")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("ends an open wait as done")
    function _()
      appWait = promises.create()
      m.assertTrue(appWaits.isOpen(appWait))
      appWaits.done(appWait)
      m.assertFalse(appWaits.isOpen(appWait))
      m.assertEqual(appWait.promiseState, "resolved")
    end function

    @it("ends an open wait as failed, with its reason")
    function _()
      appWait = promises.create()
      appWaits.fail(appWait, "left")
      m.assertEqual(appWait.promiseState, "rejected")
      m.assertEqual(appWait.promiseResult.message, "left")
    end function

    @it("keeps the first end: a failure after done changes nothing")
    function _()
      appWait = promises.create()
      appWaits.done(appWait)
      appWaits.fail(appWait, "player closed")
      m.assertEqual(appWait.promiseState, "resolved")
    end function

    @it("keeps the first end: done after a failure changes nothing")
    function _()
      appWait = promises.create()
      appWaits.fail(appWait, "left")
      appWaits.done(appWait)
      m.assertEqual(appWait.promiseState, "rejected")
      m.assertEqual(appWait.promiseResult.message, "left")
    end function

    @it("does nothing without a wait, so a remount nobody pressed for needs no check")
    function _()
      appWaits.done(invalid)
      appWaits.fail(invalid, "player closed")
      m.assertFalse(appWaits.isOpen(invalid))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("limitMs() / overdue() / msUntilNextDeadline() — the time limit")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("gives a playback start its limit, and a kind that is not an app wait none at all")
    function _()
      m.assertEqual(appWaits.limitMs(LoadingKind.PLAYBACK_START), timeouts.PLAYBACK_START_LIMIT_MS)
      m.assertEqual(appWaits.limitMs(LoadingKind.CONTENT), 0)
    end function

    @it("gives a sign-in step its limit")
    function _()
      m.assertEqual(appWaits.limitMs(LoadingKind.SESSION), timeouts.SESSION_WAIT_LIMIT_MS)
    end function

    @it("gives a pressed action its limit, and a player's own buffering none")
    function _()
      m.assertEqual(appWaits.limitMs(LoadingKind.ACTION), timeouts.ACTION_WAIT_LIMIT_MS)
      m.assertEqual(appWaits.limitMs(LoadingKind.BUFFERING), 0)
    end function

    @it("gives an overlay action the same limit as a pressed action")
    function _()
      m.assertEqual(appWaits.limitMs(LoadingKind.OVERLAY), appWaits.limitMs(LoadingKind.ACTION))
      m.assertEqual(appWaits.limitMs(LoadingKind.OVERLAY), timeouts.ACTION_WAIT_LIMIT_MS)
    end function

    @it("outlasts a pressed action's request")
    function _()
      m.assertTrue(timeouts.ACTION_WAIT_LIMIT_MS > timeouts.API_WAIT_MS)
    end function

    @it("outlasts the longest live open")
    function _()
      m.assertTrue(timeouts.PLAYBACK_START_LIMIT_MS > timeouts.LIVE_OPEN_MS + timeouts.API_WAIT_MS)
    end function

    @it("finds only the waits past their limit")
    function _()
      entries = { w1: m.start(0, invalid), w2: m.start(100000, invalid) }
      overdue = appWaits.overdue(entries, timeouts.PLAYBACK_START_LIMIT_MS)
      m.assertEqual(overdue.count(), 1)
      m.assertEqual(overdue[0], "w1")
    end function

    @it("counts down to the nearest limit, and has none to arm with nothing open")
    function _()
      entries = { w1: m.start(50000, invalid), w2: m.start(20000, invalid) }
      m.assertEqual(appWaits.msUntilNextDeadline(entries, 30000), timeouts.PLAYBACK_START_LIMIT_MS - 10000)
      m.assertEqual(appWaits.msUntilNextDeadline({}, 30000), -1)
    end function

    @it("fires at once for a limit already past")
    function _()
      entries = { w1: m.start(0, invalid) }
      m.assertEqual(appWaits.msUntilNextDeadline(entries, timeouts.PLAYBACK_START_LIMIT_MS + 5000), 0)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("leftBehind() — the viewer left before a player took the start")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("leaves a start alone while its own screen is active")
    function _()
      m.assertEqual(appWaits.leftBehind({ w1: m.start(0, m.launcher) }, m.launcher).count(), 0)
    end function

    @it("leaves a start alone when the viewer reaches a player")
    function _()
      m.assertEqual(appWaits.leftBehind({ w1: m.start(0, m.launcher) }, m.player).count(), 0)
    end function

    @it("fails a start when the viewer goes to another screen (Back during Play all)")
    function _()
      keys = appWaits.leftBehind({ w1: m.start(0, m.launcher) }, m.other)
      m.assertEqual(keys.count(), 1)
      m.assertEqual(keys[0], "w1")
    end function

    @it("fails a start when no screen is left at all (sign-out)")
    function _()
      m.assertEqual(appWaits.leftBehind({ w1: m.start(0, m.launcher) }, invalid).count(), 1)
    end function

    @it("fails a channel switch's start when the viewer leaves the player")
    function _()
      m.assertEqual(appWaits.leftBehind({ w1: m.start(0, m.player) }, m.other).count(), 1)
    end function

    @it("leaves a sign-in step alone when the viewer reaches the next screen: that ends it")
    function _()
      signIn = m.start(0, m.launcher)
      signIn.kind = LoadingKind.SESSION
      m.assertEqual(appWaits.leftBehind({ w1: signIn }, m.other).count(), 0)
    end function

    @it("tells a playing screen from any other")
    function _()
      m.assertTrue(appWaits.isPlaybackScreen(m.player))
      m.assertFalse(appWaits.isPlaybackScreen(m.launcher))
      m.assertFalse(appWaits.isPlaybackScreen(invalid))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("hiding() / hides() — the screens the open waits hide")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("finds only the waits that hide a screen")
    function _()
      hidingStart = m.start(0, m.launcher)
      hidingStart.hidden = m.launcher
      entries = { w1: hidingStart, w2: m.start(0, m.player) }
      entries.w2.hidden = invalid
      hiding = appWaits.hiding(entries)
      m.assertEqual(hiding.count(), 1)
      m.assertEqual(hiding[0], "w1")
      m.assertEqual(appWaits.hiding({}).count(), 0)
    end function

    @it("hides the screen a playback start, a sign-in step or a pressed action was pressed on, and nothing else")
    function _()
      m.assertTrue(appWaits.hidesLaunchingScreen(LoadingKind.PLAYBACK_START))
      m.assertTrue(appWaits.hidesLaunchingScreen(LoadingKind.SESSION))
      m.assertTrue(appWaits.hidesLaunchingScreen(LoadingKind.ACTION))
      m.assertFalse(appWaits.hidesLaunchingScreen(LoadingKind.OVERLAY))
      m.assertFalse(appWaits.hidesLaunchingScreen(LoadingKind.CONTENT))
      m.assertFalse(appWaits.hidesLaunchingScreen(LoadingKind.BUFFERING))
    end function

    @it("holds the keys of every kind that hides its screen, and of an overlay action")
    function _()
      m.assertTrue(appWaits.holdsKeys(LoadingKind.PLAYBACK_START))
      m.assertTrue(appWaits.holdsKeys(LoadingKind.SESSION))
      m.assertTrue(appWaits.holdsKeys(LoadingKind.ACTION))
      m.assertTrue(appWaits.holdsKeys(LoadingKind.OVERLAY))
      m.assertFalse(appWaits.holdsKeys(LoadingKind.CONTENT))
      m.assertFalse(appWaits.holdsKeys(LoadingKind.BUFFERING))
      m.assertFalse(appWaits.holdsKeys(LoadingKind.PLAIN))
    end function

    @it("finds the waits that hold a screen's keys, hidden or not")
    function _()
      hidingStart = m.start(0, m.launcher)
      hidingStart.hidden = m.launcher
      hidingStart.held = m.launcher
      overlay = m.start(0, m.launcher)
      overlay.held = m.launcher
      overlay.hidden = invalid
      neither = m.start(0, m.player)
      keys = appWaits.holding({ w1: hidingStart, w2: overlay, w3: neither })
      m.assertEqual(keys.count(), 2)
      m.assertEqual(keys[0], "w1")
      m.assertEqual(keys[1], "w2")
      m.assertEqual(appWaits.hiding({ w1: hidingStart, w2: overlay, w3: neither }).count(), 1)
      m.assertEqual(appWaits.holding({}).count(), 0)
    end function

    @it("tells whether a screen is still hidden by an open wait")
    function _()
      hidingStart = m.start(0, m.launcher)
      hidingStart.hidden = m.launcher
      entries = { w1: hidingStart }
      m.assertTrue(appWaits.hides(entries, m.launcher))
      m.assertFalse(appWaits.hides(entries, m.other))
      m.assertFalse(appWaits.hides({}, m.launcher))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("cancellable() — the waits Back cancels")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("finds the waits that hold a screen's keys and have not committed")
    function _()
      open = m.start(0, m.launcher)
      open.held = m.launcher
      open.hidden = m.launcher
      committed = m.start(0, m.launcher)
      committed.held = m.launcher
      committed.hidden = m.launcher
      committed.committed = true
      notHolding = m.start(0, m.player)
      notHolding.held = invalid
      notHolding.hidden = invalid
      keys = appWaits.cancellable({ w1: open, w2: committed, w3: notHolding })
      m.assertEqual(keys.count(), 1)
      m.assertEqual(keys[0], "w1")
    end function

    @it("includes an overlay action, which holds the keys without hiding its screen")
    function _()
      overlay = m.start(0, m.launcher)
      overlay.held = m.launcher
      overlay.hidden = invalid
      keys = appWaits.cancellable({ w1: overlay })
      m.assertEqual(keys.count(), 1)
      m.assertEqual(keys[0], "w1")
    end function

    @it("leaves out a wait that only hides, with no keys held")
    function _()
      hideOnly = m.start(0, m.launcher)
      hideOnly.hidden = m.launcher
      hideOnly.held = invalid
      m.assertEqual(appWaits.cancellable({ w1: hideOnly }).count(), 0)
    end function

    @it("has none with nothing open")
    function _()
      m.assertEqual(appWaits.cancellable({}).count(), 0)
    end function

  end class

end namespace
