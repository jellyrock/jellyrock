import "pkg:/source/utils/hlsMaster.bs"

namespace tests

  @suite("hlsMaster.bs - hlsMasterVariants() and needsH264ResolutionCap()")
  class HlsMasterTests extends tests.BaseTestSuite

    private function master(streamInf as string) as string
      return "#EXTM3U" + chr(10) + "#EXT-X-STREAM-INF:" + streamInf + chr(10) + "main.m3u8?x=1" + chr(10)
    end function

    private function dolbyVisionSdrDisplayMaster() as string
      q = chr(34)
      text = "#EXTM3U" + chr(10)
      text += "#EXT-X-STREAM-INF:BANDWIDTH=69802938,AVERAGE-BANDWIDTH=69802938,VIDEO-RANGE=PQ,CODECS=" + q + "hvc1.2.4.L153.B0,mp4a.40.2" + q + ",RESOLUTION=3840x2160,FRAME-RATE=23.976" + chr(10)
      text += "main.m3u8?VideoCodec=h264,hevc&AudioCodec=aac" + chr(10)
      text += "#EXT-X-STREAM-INF:BANDWIDTH=69802938,AVERAGE-BANDWIDTH=69802938,VIDEO-RANGE=SDR,CODECS=" + q + "avc1.42E02A,mp4a.40.2" + q + ",RESOLUTION=3840x2160,FRAME-RATE=23.976" + chr(10)
      text += "main.m3u8?VideoCodec=h264&AudioCodec=aac" + chr(10)
      text += "#EXT-X-IMAGE-STREAM-INF:BANDWIDTH=13729,RESOLUTION=320x180,CODECS=" + q + "jpeg" + q + ",URI=" + q + "Trickplay/320/tiles.m3u8?MediaSourceId=x" + q + chr(10)
      return text
    end function

    ' A hardware HEVC server's answer for a PQ source on an SDR range list: the PQ copy, then
    ' HEVC and H.264 re-encodes.
    private function hevcEncoderSdrDisplayMaster() as string
      q = chr(34)
      text = "#EXTM3U" + chr(10)
      text += "#EXT-X-STREAM-INF:VIDEO-RANGE=PQ,CODECS=" + q + "hvc1.2.4.L153.B0,mp4a.40.2" + q + ",RESOLUTION=3840x2160,FRAME-RATE=23.976" + chr(10) + "a.m3u8" + chr(10)
      text += "#EXT-X-STREAM-INF:VIDEO-RANGE=SDR,CODECS=" + q + "hvc1.2.4.L150.B0,mp4a.40.2" + q + ",RESOLUTION=3840x2160,FRAME-RATE=23.976" + chr(10) + "b.m3u8" + chr(10)
      text += "#EXT-X-STREAM-INF:VIDEO-RANGE=SDR,CODECS=" + q + "avc1.424029,mp4a.40.2" + q + ",RESOLUTION=3840x2160,FRAME-RATE=23.976" + chr(10) + "c.m3u8" + chr(10)
      return text
    end function

    ' The answer for a Dolby Vision 8.4 source (HLG base layer) on an SDR range list.
    private function hlgSdrDisplayMaster() as string
      q = chr(34)
      text = "#EXTM3U" + chr(10)
      text += "#EXT-X-STREAM-INF:VIDEO-RANGE=HLG,CODECS=" + q + "hvc1.2.4.L153.B0" + q + ",SUPPLEMENTAL-CODECS=" + q + "dvh1.08.09/db4h" + q + ",RESOLUTION=3840x2160,FRAME-RATE=60" + chr(10) + "a.m3u8" + chr(10)
      text += "#EXT-X-STREAM-INF:VIDEO-RANGE=SDR,CODECS=" + q + "avc1.424029" + q + ",RESOLUTION=3840x2160,FRAME-RATE=60" + chr(10) + "b.m3u8" + chr(10)
      return text
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("hlsMasterVariants - one variant")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("reads the codecs and size of an H.264 4K variant")
    function _()
      text = m.master("BANDWIDTH=94208000,AVERAGE-BANDWIDTH=94208000,CODECS=" + chr(34) + "avc1.42E02A,ec-3" + chr(34) + ",RESOLUTION=3840x2160,FRAME-RATE=23.976")
      variants = hlsMasterVariants(text)
      variant = variants[0]

      m.assertEqual(variants.count(), 1)
      m.assertEqual(variant.codecs, "avc1.42E02A,ec-3")
      m.assertEqual(variant.width, 3840)
      m.assertEqual(variant.height, 2160)
    end function

    @it("reads the first variant when the playlist lists several")
    function _()
      text = m.master("CODECS=" + chr(34) + "avc1.640028,ac-3" + chr(34) + ",RESOLUTION=1920x1080")
      text += "#EXT-X-STREAM-INF:CODECS=" + chr(34) + "hvc1.2.4.L153.B0,ec-3" + chr(34) + ",RESOLUTION=3840x2160" + chr(10) + "other.m3u8" + chr(10)

      m.assertEqual(hlsMasterVariants(text)[0].width, 1920)
    end function

    @it("reads a playlist with Windows line endings")
    function _()
      text = "#EXTM3U" + chr(13) + chr(10) + "#EXT-X-STREAM-INF:CODECS=" + chr(34) + "avc1.640028,ac-3" + chr(34) + ",RESOLUTION=1280x720" + chr(13) + chr(10) + "main.m3u8" + chr(13) + chr(10)

      m.assertEqual(hlsMasterVariants(text)[0].height, 720)
    end function

    @it("is empty for an empty string")
    function _()
      m.assertEqual(hlsMasterVariants("").count(), 0)
    end function

    @it("is empty for a variant with no CODECS")
    function _()
      m.assertEqual(hlsMasterVariants(m.master("BANDWIDTH=1000,RESOLUTION=1920x1080")).count(), 0)
    end function

    @it("is empty for a variant with no RESOLUTION")
    function _()
      m.assertEqual(hlsMasterVariants(m.master("CODECS=" + chr(34) + "avc1.640028,ac-3" + chr(34))).count(), 0)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("hlsMasterVariants")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("reads every variant in order with its range and ignores the image stream")
    function _()
      variants = hlsMasterVariants(m.dolbyVisionSdrDisplayMaster())

      m.assertEqual(variants.count(), 2)
      m.assertEqual(variants[0].range, "PQ")
      m.assertEqual(variants[0].codecs, "hvc1.2.4.L153.B0,mp4a.40.2")
      m.assertEqual(variants[1].range, "SDR")
      m.assertEqual(variants[1].codecs, "avc1.42E02A,mp4a.40.2")
      m.assertEqual(variants[1].height, 2160)
    end function

    @it("reads a variant with no VIDEO-RANGE as SDR")
    function _()
      variants = hlsMasterVariants(m.master("CODECS=" + chr(34) + "avc1.640028,ac-3" + chr(34) + ",RESOLUTION=1920x1080"))

      m.assertEqual(variants.count(), 1)
      m.assertEqual(variants[0].range, "SDR")
    end function

    @it("reads a lowercase VIDEO-RANGE uppercased")
    function _()
      variants = hlsMasterVariants(m.master("VIDEO-RANGE=hlg,CODECS=" + chr(34) + "hvc1.2.4.L153.B0,ac-3" + chr(34) + ",RESOLUTION=3840x2160"))

      m.assertEqual(variants[0].range, "HLG")
    end function

    @it("skips a variant with no CODECS or no RESOLUTION")
    function _()
      text = m.master("BANDWIDTH=1000,RESOLUTION=1920x1080")
      text += "#EXT-X-STREAM-INF:CODECS=" + chr(34) + "avc1.640028,ac-3" + chr(34) + chr(10) + "b.m3u8" + chr(10)
      text += "#EXT-X-STREAM-INF:CODECS=" + chr(34) + "avc1.640028,ac-3" + chr(34) + ",RESOLUTION=1280x720" + chr(10) + "c.m3u8" + chr(10)

      variants = hlsMasterVariants(text)
      m.assertEqual(variants.count(), 1)
      m.assertEqual(variants[0].width, 1280)
    end function

    @it("is empty for text that is not a playlist")
    function _()
      m.assertEqual(hlsMasterVariants("<html>502 Bad Gateway</html>").count(), 0)
    end function

    @it("reads CODECS, not SUPPLEMENTAL-CODECS, in either order")
    function _()
      q = chr(34)
      text = m.master("VIDEO-RANGE=HLG,SUPPLEMENTAL-CODECS=" + q + "dvh1.08.09/db4h" + q + ",CODECS=" + q + "hvc1.2.4.L153.B0" + q + ",RESOLUTION=3840x2160")
      variants = hlsMasterVariants(text)
      m.assertEqual(variants.count(), 1)
      m.assertEqual(variants[0].codecs, "hvc1.2.4.L153.B0")

      variants = hlsMasterVariants(m.hlgSdrDisplayMaster())
      m.assertEqual(variants[0].codecs, "hvc1.2.4.L153.B0")
      m.assertEqual(variants[0].range, "HLG")
    end function

    @it("reads 150 variants in order, ignoring the image stream")
    function _()
      q = chr(34)
      text = "#EXTM3U" + chr(10)
      for i = 1 to 150
        text += "#EXT-X-STREAM-INF:BANDWIDTH=1000,CODECS=" + q + "avc1.640028,ac-3" + q + ",RESOLUTION=" + str(i).trim() + "x1080" + chr(10) + "v" + str(i).trim() + ".m3u8" + chr(10)
      end for
      text += "#EXT-X-IMAGE-STREAM-INF:BANDWIDTH=13729,RESOLUTION=320x180,CODECS=" + q + "jpeg" + q + ",URI=" + q + "tiles.m3u8" + q + chr(10)

      variants = hlsMasterVariants(text)
      m.assertEqual(variants.count(), 150)
      m.assertEqual(variants[0].width, 1)
      m.assertEqual(variants[149].width, 150)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("hlsMasterAnswer")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("is unread with no variants for no answer")
    function _()
      answer = hlsMasterAnswer(invalid)
      m.assertFalse(answer.read)
      m.assertEqual(answer.variants.count(), 0)
    end function

    @it("is unread for a response that is not HTTP 200")
    function _()
      answer = hlsMasterAnswer({ code: 500, body: m.dolbyVisionSdrDisplayMaster() })
      m.assertFalse(answer.read)
      m.assertEqual(answer.variants.count(), 0)
    end function

    @it("is read with no variants for a body that is not a playlist")
    function _()
      answer = hlsMasterAnswer({ code: 200, body: invalid })
      m.assertTrue(answer.read)
      m.assertEqual(answer.variants.count(), 0)
    end function

    @it("is read with the variants of a playlist")
    function _()
      answer = hlsMasterAnswer({ code: 200, body: m.dolbyVisionSdrDisplayMaster() })
      m.assertTrue(answer.read)
      m.assertEqual(answer.variants.count(), 2)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("hlsVariantShown")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("hides PQ on a display that lists only SDR and DOVIWithSDR")
    function _()
      m.assertFalse(hlsVariantShown({ range: "PQ" }, "SDR|DOVIWithSDR"))
    end function

    @it("shows PQ when the list has HDR10, HDR10Plus or DOVI")
    function _()
      m.assertTrue(hlsVariantShown({ range: "PQ" }, "SDR|DOVIWithSDR|HDR10"))
      m.assertTrue(hlsVariantShown({ range: "PQ" }, "SDR|HDR10Plus"))
      m.assertTrue(hlsVariantShown({ range: "PQ" }, "SDR|DOVI"))
      m.assertTrue(hlsVariantShown({ range: "PQ" }, "sdr|dovi"))
    end function

    @it("does not count DOVIWithHDR10 or DOVIWithEL as a whole DOVI token")
    function _()
      m.assertFalse(hlsVariantShown({ range: "PQ" }, "SDR|DOVIWithHDR10|DOVIWithEL"))
    end function

    @it("shows HLG whatever the list holds")
    function _()
      m.assertTrue(hlsVariantShown({ range: "HLG" }, "SDR|DOVIWithSDR"))
      m.assertTrue(hlsVariantShown({ range: "HLG" }, "SDR|HDR10"))
      m.assertTrue(hlsVariantShown({ range: "HLG" }, "SDR|HLG"))
    end function

    @it("always shows SDR and a range it does not know")
    function _()
      m.assertTrue(hlsVariantShown({ range: "SDR" }, "SDR|DOVIWithSDR"))
      m.assertTrue(hlsVariantShown({ range: "SOMETHING" }, "SDR"))
    end function

    @it("shows every range when the list is unknown or empty")
    function _()
      m.assertTrue(hlsVariantShown({ range: "PQ" }, invalid))
      m.assertTrue(hlsVariantShown({ range: "PQ" }, ""))
      m.assertTrue(hlsVariantShown({ range: "HLG" }, invalid))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("hlsMasterNeedsRangeList")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("is true for a read playlist with a PQ variant")
    function _()
      m.assertTrue(hlsMasterNeedsRangeList(hlsMasterAnswer({ code: 200, body: m.dolbyVisionSdrDisplayMaster() })))
      m.assertTrue(hlsMasterNeedsRangeList(hlsMasterAnswer({ code: 200, body: m.hevcEncoderSdrDisplayMaster() })))
    end function

    @it("is false for a playlist with no PQ variant: all SDR, HLG, or no VIDEO-RANGE")
    function _()
      body = m.master("VIDEO-RANGE=SDR,CODECS=" + chr(34) + "avc1.640028,ac-3" + chr(34) + ",RESOLUTION=3840x2160")
      m.assertFalse(hlsMasterNeedsRangeList(hlsMasterAnswer({ code: 200, body: body })))
      m.assertFalse(hlsMasterNeedsRangeList(hlsMasterAnswer({ code: 200, body: m.hlgSdrDisplayMaster() })))
      body = m.master("CODECS=" + chr(34) + "avc1.640028,ac-3" + chr(34) + ",RESOLUTION=1920x1080")
      m.assertFalse(hlsMasterNeedsRangeList(hlsMasterAnswer({ code: 200, body: body })))
      m.assertFalse(hlsMasterNeedsRangeList(hlsMasterAnswer({ code: 200, body: "garbage" })))
    end function

    @it("is false when the playlist did not arrive")
    function _()
      m.assertFalse(hlsMasterNeedsRangeList(hlsMasterAnswer(invalid)))
      m.assertFalse(hlsMasterNeedsRangeList(hlsMasterAnswer({ code: 500, body: m.dolbyVisionSdrDisplayMaster() })))
      m.assertFalse(hlsMasterNeedsRangeList(hlsMasterAnswer({ code: 200, body: invalid })))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("needsH264ResolutionCap")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("is true for H.264 above 1080p")
    function _()
      m.assertTrue(needsH264ResolutionCap({ codecs: "avc1.42E02A,ec-3", width: 3840, height: 2160 }))
    end function

    @it("is true for H.264 wider than 1920 at a short height")
    function _()
      m.assertTrue(needsH264ResolutionCap({ codecs: "avc1.640033,ac-3", width: 3840, height: 1600 }))
    end function

    @it("is false for HEVC at 4K")
    function _()
      m.assertFalse(needsH264ResolutionCap({ codecs: "hvc1.2.4.L153.B0,ec-3", width: 3840, height: 2160 }))
    end function

    @it("is false for H.264 at 1080p")
    function _()
      m.assertFalse(needsH264ResolutionCap({ codecs: "avc1.640028,ec-3", width: 1920, height: 1080 }))
    end function

    @it("is false for no variant")
    function _()
      m.assertFalse(needsH264ResolutionCap(invalid))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("videoStreamAboveH264Ceiling")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("is true for a 4K HEVC stream")
    function _()
      m.assertTrue(videoStreamAboveH264Ceiling({ Codec: "hevc", Width: 3840, Height: 2160 }))
    end function

    @it("is false for a 1080p stream")
    function _()
      m.assertFalse(videoStreamAboveH264Ceiling({ Codec: "hevc", Width: 1920, Height: 1080 }))
    end function

    @it("is false for an unknown stream")
    function _()
      m.assertFalse(videoStreamAboveH264Ceiling(invalid))
      m.assertFalse(videoStreamAboveH264Ceiling({ Codec: "hevc" }))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("h264CapDecision")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("caps H.264 above 1080p")
    function _()
      body = m.master("CODECS=" + chr(34) + "avc1.640033,ac-3" + chr(34) + ",RESOLUTION=3840x2160")
      decision = h264CapDecision(hlsMasterAnswer({ code: 200, body: body }), true, true)

      m.assertTrue(decision.cap)
      m.assertEqual(decision.reason, "h264AboveCeiling")
      m.assertEqual(decision.variant.width, 3840)
    end function

    @it("keeps HEVC at 4K")
    function _()
      body = m.master("CODECS=" + chr(34) + "hvc1.2.4.L153.B0,ac-3" + chr(34) + ",RESOLUTION=3840x2160")
      decision = h264CapDecision(hlsMasterAnswer({ code: 200, body: body }), true, true)

      m.assertFalse(decision.cap)
      m.assertEqual(decision.reason, "playable")
    end function

    @it("caps the SDR H.264 variant when the display hides the PQ one")
    function _()
      fetched = { code: 200, body: m.dolbyVisionSdrDisplayMaster() }
      decision = h264CapDecision(hlsMasterAnswer(fetched), true, true, "SDR|DOVIWithSDR")

      m.assertTrue(decision.cap)
      m.assertEqual(decision.reason, "h264AboveCeiling")
      m.assertEqual(left(decision.variant.codecs, 4), "avc1")

      first = h264CapDecision(hlsMasterAnswer(fetched), true, false, "SDR|DOVIWithSDR")
      m.assertTrue(first.cap)
      m.assertEqual(first.reason, "h264AboveCeiling")
    end function

    @it("keeps the HEVC PQ variant when the display shows HDR")
    function _()
      fetched = { code: 200, body: m.dolbyVisionSdrDisplayMaster() }
      decision = h264CapDecision(hlsMasterAnswer(fetched), true, true, "SDR|DOVIWithSDR|HDR10|DOVIWithHDR10|DOVIWithEL")

      m.assertFalse(decision.cap)
      m.assertEqual(decision.reason, "playable")
      m.assertEqual(left(decision.variant.codecs, 4), "hvc1")
    end function

    @it("reads the first variant when the range list is unknown")
    function _()
      decision = h264CapDecision(hlsMasterAnswer({ code: 200, body: m.dolbyVisionSdrDisplayMaster() }), true, true, invalid)

      m.assertFalse(decision.cap)
      m.assertEqual(decision.reason, "playable")
      m.assertEqual(left(decision.variant.codecs, 4), "hvc1")
    end function

    @it("caps when no variant is one the display shows")
    function _()
      body = m.master("VIDEO-RANGE=PQ,CODECS=" + chr(34) + "hvc1.2.4.L153.B0,ac-3" + chr(34) + ",RESOLUTION=3840x2160")
      decision = h264CapDecision(hlsMasterAnswer({ code: 200, body: body }), true, false, "SDR|DOVIWithSDR")

      m.assertTrue(decision.cap)
      m.assertEqual(decision.reason, "noShownVariant")
      m.assertEqual(decision.variant.range, "PQ")

      retry = h264CapDecision(hlsMasterAnswer({ code: 200, body: body }), true, true, "SDR|DOVIWithSDR")
      m.assertTrue(retry.cap)
      m.assertEqual(retry.reason, "noShownVariant")
    end function

    @it("does not cap a retry of a source within the ceiling when no variant is shown")
    function _()
      body = m.master("VIDEO-RANGE=PQ,CODECS=" + chr(34) + "hvc1.2.4.L150.B0,ac-3" + chr(34) + ",RESOLUTION=1920x1080")
      decision = h264CapDecision(hlsMasterAnswer({ code: 200, body: body }), false, true, "SDR|DOVIWithSDR")

      m.assertFalse(decision.cap)
      m.assertEqual(decision.reason, "noShownVariant")
      m.assertEqual(decision.variant.range, "PQ")
    end function

    @it("keeps a 4K HEVC SDR variant listed after a hidden PQ one")
    function _()
      decision = h264CapDecision(hlsMasterAnswer({ code: 200, body: m.hevcEncoderSdrDisplayMaster() }), true, false, "SDR|DOVIWithSDR")

      m.assertFalse(decision.cap)
      m.assertEqual(decision.reason, "playable")
      m.assertEqual(decision.variant.codecs, "hvc1.2.4.L150.B0,mp4a.40.2")
      m.assertEqual(decision.variant.range, "SDR")
    end function

    @it("keeps the HEVC HLG variant on a display without HDR")
    function _()
      decision = h264CapDecision(hlsMasterAnswer({ code: 200, body: m.hlgSdrDisplayMaster() }), true, false, "SDR|DOVIWithSDR")
      m.assertFalse(decision.cap)
      m.assertEqual(decision.reason, "playable")
      m.assertEqual(decision.variant.range, "HLG")
      m.assertEqual(decision.variant.codecs, "hvc1.2.4.L153.B0")
    end function

    @it("reads the first variant when the server sends no range list")
    function _()
      decision = h264CapDecision(hlsMasterAnswer({ code: 200, body: m.dolbyVisionSdrDisplayMaster() }), true, false, "")

      m.assertFalse(decision.cap)
      m.assertEqual(decision.reason, "playable")
      m.assertEqual(decision.variant.range, "PQ")
    end function

    @it("caps a re-encode of a source above 1080p when the playlist did not arrive")
    function _()
      decision = h264CapDecision(hlsMasterAnswer(invalid), true, true)

      m.assertTrue(decision.cap)
      m.assertEqual(decision.reason, "playlistUnread")
    end function

    @it("caps a re-encode of a source above 1080p when the playlist answered with an error")
    function _()
      m.assertTrue(h264CapDecision(hlsMasterAnswer({ code: 500, body: "" }), true, true).cap)
    end function

    @it("caps a re-encode of a source above 1080p when the playlist cannot be read")
    function _()
      decision = h264CapDecision(hlsMasterAnswer({ code: 200, body: "<html>502 Bad Gateway</html>" }), true, true)

      m.assertTrue(decision.cap)
      m.assertEqual(decision.reason, "playlistUnparsed")
    end function

    @it("keeps the answer for a source at or below 1080p when the playlist did not arrive")
    function _()
      m.assertFalse(h264CapDecision(hlsMasterAnswer(invalid), false, true).cap)
      m.assertFalse(h264CapDecision(hlsMasterAnswer({ code: 200, body: "garbage" }), false, true).cap)
    end function

    @it("caps a first request that the playlist declares H.264 above 1080p")
    function _()
      body = m.master("CODECS=" + chr(34) + "avc1.640033,ac-3" + chr(34) + ",RESOLUTION=3840x2160")
      decision = h264CapDecision(hlsMasterAnswer({ code: 200, body: body }), true, false)

      m.assertTrue(decision.cap)
      m.assertEqual(decision.reason, "h264AboveCeiling")
    end function

    @it("keeps a first request's answer when its playlist did not arrive, since the video may be copied")
    function _()
      decision = h264CapDecision(hlsMasterAnswer(invalid), true, false)

      m.assertFalse(decision.cap)
      m.assertEqual(decision.reason, "playlistUnread")
    end function

    @it("keeps a first request's answer when its playlist cannot be read")
    function _()
      decision = h264CapDecision(hlsMasterAnswer({ code: 200, body: "<html>502 Bad Gateway</html>" }), true, false)

      m.assertFalse(decision.cap)
      m.assertEqual(decision.reason, "playlistUnparsed")
      m.assertFalse(h264CapDecision(hlsMasterAnswer({ code: 500, body: "" }), true, false).cap)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("h264OutputCheck")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("reads the playlist on the re-encode retry, whatever the source's size")
    function _()
      m.assertTrue(h264OutputCheck(true, 0, false, true).read)
      m.assertTrue(h264OutputCheck(true, 0, true, true).read)
    end function

    @it("reads the playlist on a first request for a source beyond the ceiling")
    function _()
      check = h264OutputCheck(true, 0, true, false)

      m.assertTrue(check.read)
      m.assertEqual(check.reason, "")
    end function

    @it("skips a first request for a source within the ceiling")
    function _()
      check = h264OutputCheck(true, 0, false, false)

      m.assertFalse(check.read)
      m.assertEqual(check.reason, "withinCeiling")
    end function

    @it("skips under a viewer cap at or below 1080p, and reads above it")
    function _()
      m.assertEqual(h264OutputCheck(true, 1080, true, true).reason, "viewerCap")
      m.assertEqual(h264OutputCheck(true, 720, true, false).reason, "viewerCap")
      m.assertTrue(h264OutputCheck(true, 2160, true, false).read)
    end function

    @it("skips a load that does not play the transcode, before any other reason")
    function _()
      ' The level override's direct play, or the device playing the upstream link.
      check = h264OutputCheck(false, 720, true, true)

      m.assertFalse(check.read)
      m.assertEqual(check.reason, "notPlayed")
    end function

  end class

end namespace
