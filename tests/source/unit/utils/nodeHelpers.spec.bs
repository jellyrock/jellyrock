
namespace tests

  @suite("nodeHelpers.bs - createQueueItem Utility")
  class NodeHelpersCreateQueueItemTests extends tests.BaseTestSuite

    protected override function setup()
      super.setup()
    end function

    '++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("createQueueItem(sourceNode) - input validation")
    '++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("returns invalid when sourceNode is invalid")
    function _()
      result = nodeHelpers.createQueueItem(invalid)
      m.assertInvalid(result)
    end function

    '++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("createQueueItem(sourceNode) - return type")
    '++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("returns an associative array, not an SGNode")
    function _()
      sourceNode = CreateObject("roSGNode", "ContentNode")
      sourceNode.id = "test-123"
      sourceNode.addFields({ type: "Movie" })

      queueItem = nodeHelpers.createQueueItem(sourceNode)

      m.assertNotInvalid(queueItem)
      ' Verify it's an AA by checking it has the count() method
      m.assertNotInvalid(queueItem.count())
      ' SGNodes have subtype(), AAs return invalid when accessing non-existent method
      m.assertInvalid(queueItem.subtype)
    end function

    '++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("createQueueItem(sourceNode) - required fields")
    '++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("copies id field when present")
    function _()
      sourceNode = CreateObject("roSGNode", "ContentNode")
      sourceNode.id = "movie-123"
      sourceNode.addFields({ type: "Movie" })

      queueItem = nodeHelpers.createQueueItem(sourceNode)

      m.assertEqual(queueItem.id, "movie-123")
    end function

    @it("copies type field when present")
    function _()
      sourceNode = CreateObject("roSGNode", "ContentNode")
      sourceNode.id = "test-123"
      sourceNode.addFields({ type: "Episode" })

      queueItem = nodeHelpers.createQueueItem(sourceNode)

      m.assertEqual(queueItem.type, "Episode")
    end function

    @it("handles missing id field gracefully")
    function _()
      sourceNode = CreateObject("roSGNode", "ContentNode")
      ' Don't set id — ContentNode defaults to empty string
      sourceNode.addFields({ type: "Movie" })

      queueItem = nodeHelpers.createQueueItem(sourceNode)

      m.assertNotInvalid(queueItem)
      ' id is empty string so isValidAndNotEmpty fails — should not be copied
      m.assertFalse(queueItem.DoesExist("id"))
    end function

    @it("handles missing type field gracefully")
    function _()
      sourceNode = CreateObject("roSGNode", "ContentNode")
      sourceNode.id = "test-123"
      ' type field not added

      queueItem = nodeHelpers.createQueueItem(sourceNode)

      m.assertNotInvalid(queueItem)
      ' type should not exist in the AA
      m.assertFalse(queueItem.DoesExist("type"))
    end function

    '++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("createQueueItem(sourceNode) - optional fields")
    '++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("copies title field when present")
    function _()
      sourceNode = CreateObject("roSGNode", "ContentNode")
      sourceNode.id = "test-123"
      sourceNode.addFields({ type: "Movie", title: "Movie Title" })

      queueItem = nodeHelpers.createQueueItem(sourceNode)

      m.assertEqual(queueItem.title, "Movie Title")
    end function

    @it("copies mediaSourceId field when present")
    function _()
      sourceNode = CreateObject("roSGNode", "ContentNode")
      sourceNode.id = "test-123"
      sourceNode.addFields({ type: "Movie", mediaSourceId: "source-456" })

      queueItem = nodeHelpers.createQueueItem(sourceNode)

      m.assertEqual(queueItem.mediaSourceId, "source-456")
    end function

    @it("copies runTimeTicks field when > 0")
    function _()
      sourceNode = CreateObject("roSGNode", "ContentNode")
      sourceNode.id = "test-123"
      sourceNode.addFields({ type: "Movie", runTimeTicks: 36000000000& })

      queueItem = nodeHelpers.createQueueItem(sourceNode)

      m.assertEqual(queueItem.runTimeTicks, 36000000000&)
    end function

    @it("omits title when empty (default)")
    function _()
      sourceNode = CreateObject("roSGNode", "ContentNode")
      sourceNode.id = "test-123"
      sourceNode.addFields({ type: "Movie", title: "" })

      queueItem = nodeHelpers.createQueueItem(sourceNode)

      ' title is empty string so isValidAndNotEmpty fails — should not be copied
      m.assertFalse(queueItem.DoesExist("title"))
    end function

    @it("omits mediaSourceId when not present")
    function _()
      sourceNode = CreateObject("roSGNode", "ContentNode")
      sourceNode.id = "test-123"
      sourceNode.addFields({ type: "Movie" })

      queueItem = nodeHelpers.createQueueItem(sourceNode)

      m.assertFalse(queueItem.DoesExist("mediaSourceId"))
    end function

    @it("omits runTimeTicks when = 0 (default)")
    function _()
      sourceNode = CreateObject("roSGNode", "ContentNode")
      sourceNode.id = "test-123"
      sourceNode.addFields({ type: "Movie", runTimeTicks: 0& })

      queueItem = nodeHelpers.createQueueItem(sourceNode)

      m.assertFalse(queueItem.DoesExist("runTimeTicks"))
    end function

    '++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("createQueueItem(sourceNode) - episode navigation fields")
    '++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("copies seriesId when present and non-empty")
    function _()
      sourceNode = CreateObject("roSGNode", "ContentNode")
      sourceNode.id = "ep-456"
      sourceNode.addFields({ type: "Episode", seriesId: "series-789" })

      queueItem = nodeHelpers.createQueueItem(sourceNode)

      m.assertEqual(queueItem.seriesId, "series-789")
    end function

    @it("omits seriesId when empty (default)")
    function _()
      sourceNode = CreateObject("roSGNode", "ContentNode")
      sourceNode.id = "ep-456"
      sourceNode.addFields({ type: "Episode", seriesId: "" })

      queueItem = nodeHelpers.createQueueItem(sourceNode)

      m.assertFalse(queueItem.DoesExist("seriesId"))
    end function

    @it("copies seasonId when present and non-empty")
    function _()
      sourceNode = CreateObject("roSGNode", "ContentNode")
      sourceNode.id = "ep-456"
      sourceNode.addFields({ type: "Episode", seasonId: "season-123" })

      queueItem = nodeHelpers.createQueueItem(sourceNode)

      m.assertEqual(queueItem.seasonId, "season-123")
    end function

    @it("omits seasonId when empty (default)")
    function _()
      sourceNode = CreateObject("roSGNode", "ContentNode")
      sourceNode.id = "ep-456"
      sourceNode.addFields({ type: "Episode", seasonId: "" })

      queueItem = nodeHelpers.createQueueItem(sourceNode)

      m.assertFalse(queueItem.DoesExist("seasonId"))
    end function

    @it("copies playbackPositionTicks when > 0")
    function _()
      sourceNode = CreateObject("roSGNode", "ContentNode")
      sourceNode.id = "ep-456"
      sourceNode.addFields({ type: "Episode", playbackPositionTicks: 6000000000& })

      queueItem = nodeHelpers.createQueueItem(sourceNode)

      m.assertEqual(queueItem.playbackPositionTicks, 6000000000&)
    end function

    @it("omits playbackPositionTicks when = 0 (default)")
    function _()
      sourceNode = CreateObject("roSGNode", "ContentNode")
      sourceNode.id = "ep-456"
      sourceNode.addFields({ type: "Episode", playbackPositionTicks: 0& })

      queueItem = nodeHelpers.createQueueItem(sourceNode)

      m.assertFalse(queueItem.DoesExist("playbackPositionTicks"))
    end function

    @it("json field is never copied")
    function _()
      sourceNode = CreateObject("roSGNode", "ContentNode")
      sourceNode.id = "test-123"
      sourceNode.addFields({ type: "Movie", json: { name: "Test", id: "test-123" } })

      queueItem = nodeHelpers.createQueueItem(sourceNode)

      m.assertFalse(queueItem.DoesExist("json"))
    end function

    '++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("createQueueItem(sourceNode) - all fields together")
    '++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("copies all fields when all are present on a full episode node")
    function _()
      sourceNode = CreateObject("roSGNode", "ContentNode")
      sourceNode.id = "ep-001"
      sourceNode.addFields({
        type: "Episode",
        title: "Pilot",
        mediaSourceId: "source-abc",
        runTimeTicks: 27540000000&,
        seriesId: "series-xyz",
        seasonId: "season-xyz",
        playbackPositionTicks: 9000000000&,
        backdropImageTags: ["tag-abc"],
        parentBackdropImageTags: [],
        parentBackdropItemId: ""
      })

      queueItem = nodeHelpers.createQueueItem(sourceNode)

      m.assertEqual(queueItem.id, "ep-001")
      m.assertEqual(queueItem.type, "Episode")
      m.assertEqual(queueItem.title, "Pilot")
      m.assertEqual(queueItem.mediaSourceId, "source-abc")
      m.assertEqual(queueItem.runTimeTicks, 27540000000&)
      m.assertEqual(queueItem.seriesId, "series-xyz")
      m.assertEqual(queueItem.seasonId, "season-xyz")
      m.assertEqual(queueItem.playbackPositionTicks, 9000000000&)
      m.assertEqual(queueItem.backdropImageTags, ["tag-abc"])
      m.assertEqual(queueItem.parentBackdropImageTags, [])
      m.assertEqual(queueItem.parentBackdropItemId, "")
      m.assertFalse(queueItem.DoesExist("json"))
    end function

    @it("only copies the expected fields, ignoring all others")
    function _()
      sourceNode = CreateObject("roSGNode", "ContentNode")
      sourceNode.id = "test-123"
      sourceNode.addFields({
        type: "Movie",
        title: "Test Title",
        mediaSourceId: "source-123",
        runTimeTicks: 1000&,
        seriesId: "",
        seasonId: "",
        playbackPositionTicks: 0&,
        ' Extra fields that should NOT be copied
        extraField1: "should not copy",
        extraField2: 12345,
        focusable: true,
        visible: false
      })

      queueItem = nodeHelpers.createQueueItem(sourceNode)

      ' Should have the expected fields
      m.assertEqual(queueItem.id, "test-123")
      m.assertEqual(queueItem.type, "Movie")
      m.assertEqual(queueItem.title, "Test Title")
      m.assertEqual(queueItem.mediaSourceId, "source-123")
      m.assertEqual(queueItem.runTimeTicks, 1000&)

      ' Should NOT have extra fields
      m.assertFalse(queueItem.DoesExist("extraField1"))
      m.assertFalse(queueItem.DoesExist("extraField2"))
      m.assertFalse(queueItem.DoesExist("focusable"))
      m.assertFalse(queueItem.DoesExist("visible"))
      m.assertFalse(queueItem.DoesExist("json"))
    end function

    '++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("createQueueItem(sourceNode) - independence")
    '++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("creates independent item that doesn't affect source when modified")
    function _()
      sourceNode = CreateObject("roSGNode", "ContentNode") as dynamic
      sourceNode.id = "original-id"
      sourceNode.addFields({ type: "Movie", title: "Original Title" })

      queueItem = nodeHelpers.createQueueItem(sourceNode)

      ' Modify the queue item
      queueItem.id = "modified-id"
      queueItem.type = "Episode"
      queueItem.title = "Modified Title"

      ' Source should remain unchanged
      m.assertEqual(sourceNode.id, "original-id")
      m.assertEqual(sourceNode.type, "Movie")
      m.assertEqual(sourceNode.title, "Original Title")
    end function

    @it("source modifications don't affect returned queue item")
    function _()
      sourceNode = CreateObject("roSGNode", "ContentNode") as dynamic
      sourceNode.id = "test-123"
      sourceNode.addFields({ type: "Movie", title: "Original" })

      queueItem = nodeHelpers.createQueueItem(sourceNode)

      ' Modify source after creating queue item
      sourceNode.id = "changed-456"
      sourceNode.type = "Episode"
      sourceNode.title = "Changed"

      ' Queue item should retain original values
      m.assertEqual(queueItem.id, "test-123")
      m.assertEqual(queueItem.type, "Movie")
      m.assertEqual(queueItem.title, "Original")
    end function

    '++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("createQueueItem(sourceNode) - caller mutations")
    '++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("allows startingPoint and selectedAudioStreamIndex to be set after creation")
    function _()
      sourceNode = CreateObject("roSGNode", "ContentNode") as dynamic
      sourceNode.id = "test-123"
      sourceNode.addFields({ type: "Movie" })

      queueItem = nodeHelpers.createQueueItem(sourceNode)

      ' These fields are set by quickplay / Main.bs after createQueueItem
      queueItem.selectedAudioStreamIndex = 2
      queueItem.startingPoint = 15000000000&

      m.assertEqual(queueItem.selectedAudioStreamIndex, 2)
      m.assertEqual(queueItem.startingPoint, 15000000000&)
      ' Original source should not have these fields added
      m.assertInvalid(sourceNode.selectedAudioStreamIndex)
      m.assertInvalid(sourceNode.startingPoint)
    end function

    '++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("createQueueItem(sourceNode) - backdrop fields (guaranteed contract)")
    '++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("always sets backdropImageTags even when source has none")
    function _()
      sourceNode = CreateObject("roSGNode", "ContentNode")
      sourceNode.id = "movie-123"
      sourceNode.addFields({ type: "Movie" })

      queueItem = nodeHelpers.createQueueItem(sourceNode)

      ' Field must always exist — callers rely on .Count() without isValid()
      m.assertTrue(queueItem.DoesExist("backdropImageTags"))
      m.assertEqual(queueItem.backdropImageTags.Count(), 0)
    end function

    @it("always sets parentBackdropImageTags even when source has none")
    function _()
      sourceNode = CreateObject("roSGNode", "ContentNode")
      sourceNode.id = "ep-123"
      sourceNode.addFields({ type: "Episode" })

      queueItem = nodeHelpers.createQueueItem(sourceNode)

      m.assertTrue(queueItem.DoesExist("parentBackdropImageTags"))
      m.assertEqual(queueItem.parentBackdropImageTags.Count(), 0)
    end function

    @it("always sets parentBackdropItemId even when source has none")
    function _()
      sourceNode = CreateObject("roSGNode", "ContentNode")
      sourceNode.id = "ep-123"
      sourceNode.addFields({ type: "Episode" })

      queueItem = nodeHelpers.createQueueItem(sourceNode)

      m.assertTrue(queueItem.DoesExist("parentBackdropItemId"))
      m.assertEqual(queueItem.parentBackdropItemId, "")
    end function

    @it("copies backdropImageTags from source when present")
    function _()
      sourceNode = CreateObject("roSGNode", "ContentNode")
      sourceNode.id = "movie-123"
      sourceNode.addFields({ type: "Movie", backdropImageTags: ["tag-aaa", "tag-bbb"] })

      queueItem = nodeHelpers.createQueueItem(sourceNode)

      m.assertEqual(queueItem.backdropImageTags, ["tag-aaa", "tag-bbb"])
    end function

    @it("copies parentBackdropImageTags and parentBackdropItemId from source when present")
    function _()
      sourceNode = CreateObject("roSGNode", "ContentNode")
      sourceNode.id = "ep-456"
      sourceNode.addFields({
        type: "Episode",
        parentBackdropImageTags: ["parent-tag"],
        parentBackdropItemId: "series-789"
      })

      queueItem = nodeHelpers.createQueueItem(sourceNode)

      m.assertEqual(queueItem.parentBackdropImageTags, ["parent-tag"])
      m.assertEqual(queueItem.parentBackdropItemId, "series-789")
    end function

    @it("works with a raw API associative array (PascalCase fields)")
    function _()
      ' Simulates a Jellyfin API response item — BrightScript AA lookup is case-insensitive
      ' so camelCase access finds PascalCase keys
      rawApiItem = {
        Id: "movie-abc",
        Type: "Movie",
        Name: "Test Movie",
        BackdropImageTags: ["api-tag-1"],
        ParentBackdropItemId: ""
      }

      queueItem = nodeHelpers.createQueueItem(rawApiItem)

      m.assertEqual(queueItem.id, "movie-abc")
      m.assertEqual(queueItem.type, "Movie")
      ' backdropImageTags always present
      m.assertTrue(queueItem.DoesExist("backdropImageTags"))
      m.assertEqual(queueItem.backdropImageTags, ["api-tag-1"])
    end function

    @it("raw API item with no backdrop fields produces empty arrays")
    function _()
      rawApiItem = {
        Id: "ep-xyz",
        Type: "Episode"
      }

      queueItem = nodeHelpers.createQueueItem(rawApiItem)

      m.assertEqual(queueItem.backdropImageTags.Count(), 0)
      m.assertEqual(queueItem.parentBackdropImageTags.Count(), 0)
      m.assertEqual(queueItem.parentBackdropItemId, "")
    end function

    @it("raw API item extracts playbackPositionTicks from nested UserData")
    function _()
      rawApiItem = {
        Id: "ep-xyz",
        Type: "Episode",
        UserData: {
          PlaybackPositionTicks: 12000000000&,
          Played: false
        }
      }

      queueItem = nodeHelpers.createQueueItem(rawApiItem)

      m.assertEqual(queueItem.playbackPositionTicks, 12000000000&)
    end function

    @it("raw API item with zero UserData.PlaybackPositionTicks omits field")
    function _()
      rawApiItem = {
        Id: "ep-xyz",
        Type: "Episode",
        UserData: {
          PlaybackPositionTicks: 0&,
          Played: true
        }
      }

      queueItem = nodeHelpers.createQueueItem(rawApiItem)

      m.assertFalse(queueItem.DoesExist("playbackPositionTicks"))
    end function

  end class

end namespace
