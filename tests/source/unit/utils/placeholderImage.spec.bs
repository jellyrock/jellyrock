
namespace tests

  @suite("placeholderImage.bs - Placeholder Image Utilities")
  class PlaceholderImageTests extends tests.BaseTestSuite

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("getPlaceholderImagePath(itemType)")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("returns movie placeholder for Movie and BoxSet")
    @params("Movie", "pkg:/images/placeholders/movie_$$RES$$.png")
    @params("BoxSet", "pkg:/images/placeholders/movie_$$RES$$.png")
    function _(itemType, expected)
      m.assertEqual(getPlaceholderImagePath(itemType), expected)
    end function

    @it("returns person placeholder for Person")
    function _()
      m.assertEqual(getPlaceholderImagePath("Person"), "pkg:/images/placeholders/person_$$RES$$.png")
    end function

    @it("returns playCircle placeholder for video/episode types")
    @params("Episode", "pkg:/images/placeholders/playCircle_$$RES$$.png")
    @params("Video", "pkg:/images/placeholders/playCircle_$$RES$$.png")
    @params("MusicVideo", "pkg:/images/placeholders/playCircle_$$RES$$.png")
    @params("Recording", "pkg:/images/placeholders/playCircle_$$RES$$.png")
    @params("Program", "pkg:/images/placeholders/playCircle_$$RES$$.png")
    @params("Series", "pkg:/images/placeholders/playCircle_$$RES$$.png")
    @params("Season", "pkg:/images/placeholders/playCircle_$$RES$$.png")
    @params("Chapter", "pkg:/images/placeholders/playCircle_$$RES$$.png")
    @params("Trailer", "pkg:/images/placeholders/playCircle_$$RES$$.png")
    function _(itemType, expected)
      m.assertEqual(getPlaceholderImagePath(itemType), expected)
    end function

    @it("returns book placeholder for Book and AudioBook")
    @params("Book", "pkg:/images/placeholders/book_$$RES$$.png")
    @params("AudioBook", "pkg:/images/placeholders/book_$$RES$$.png")
    function _(itemType, expected)
      m.assertEqual(getPlaceholderImagePath(itemType), expected)
    end function

    @it("returns studio placeholder for Studio")
    function _()
      m.assertEqual(getPlaceholderImagePath("Studio"), "pkg:/images/placeholders/studio_$$RES$$.png")
    end function

    @it("returns album placeholder for MusicAlbum")
    function _()
      m.assertEqual(getPlaceholderImagePath("MusicAlbum"), "pkg:/images/placeholders/album_$$RES$$.png")
    end function

    @it("returns artist placeholder for MusicArtist")
    function _()
      m.assertEqual(getPlaceholderImagePath("MusicArtist"), "pkg:/images/placeholders/artist_$$RES$$.png")
    end function

    @it("returns musicFolder placeholder for MusicGenre")
    function _()
      m.assertEqual(getPlaceholderImagePath("MusicGenre"), "pkg:/images/placeholders/musicFolder_$$RES$$.png")
    end function

    @it("returns musicNote placeholder for Audio")
    function _()
      m.assertEqual(getPlaceholderImagePath("Audio"), "pkg:/images/placeholders/musicNote_$$RES$$.png")
    end function

    @it("returns playlist placeholder for Playlist")
    function _()
      m.assertEqual(getPlaceholderImagePath("Playlist"), "pkg:/images/placeholders/playlist_$$RES$$.png")
    end function

    @it("returns photo placeholder for Photo")
    function _()
      m.assertEqual(getPlaceholderImagePath("Photo"), "pkg:/images/placeholders/photo_$$RES$$.png")
    end function

    @it("returns photoAlbum placeholder for PhotoAlbum")
    function _()
      m.assertEqual(getPlaceholderImagePath("PhotoAlbum"), "pkg:/images/placeholders/photoAlbum_$$RES$$.png")
    end function

    @it("returns livetv placeholder for TvChannel, Channel, and ChannelFolderItem")
    @params("TvChannel", "pkg:/images/placeholders/livetv_$$RES$$.png")
    @params("Channel", "pkg:/images/placeholders/livetv_$$RES$$.png")
    @params("ChannelFolderItem", "pkg:/images/placeholders/livetv_$$RES$$.png")
    function _(itemType, expected)
      m.assertEqual(getPlaceholderImagePath(itemType), expected)
    end function

    @it("returns folder fallback for unknown or unmatched types")
    @params("CollectionFolder", "pkg:/images/placeholders/folder_$$RES$$.png")
    @params("UserView", "pkg:/images/placeholders/folder_$$RES$$.png")
    @params("SomeUnknownType", "pkg:/images/placeholders/folder_$$RES$$.png")
    @params("", "pkg:/images/placeholders/folder_$$RES$$.png")
    function _(itemType, expected)
      m.assertEqual(getPlaceholderImagePath(itemType), expected)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("resolveItemPlaceholderType(item)")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("returns empty for invalid input")
    function _()
      m.assertEqual(resolveItemPlaceholderType(invalid), "")
    end function

    @it("returns empty when type is missing")
    function _()
      item = createObject("roSGNode", "JellyfinBaseItem")
      m.assertEqual(resolveItemPlaceholderType(item), "")
    end function

    @it("passes media item types through unchanged")
    @params("Movie", "Movie")
    @params("Series", "Series")
    @params("Episode", "Episode")
    @params("MusicAlbum", "MusicAlbum")
    @params("MusicArtist", "MusicArtist")
    @params("Person", "Person")
    @params("TvChannel", "TvChannel")
    @params("Book", "Book")
    @params("AudioBook", "AudioBook")
    @params("Trailer", "Trailer")
    @params("Studio", "Studio")
    @params("ChannelFolderItem", "ChannelFolderItem")
    function _(itemType, expected)
      item = createObject("roSGNode", "JellyfinBaseItem")
      item.type = itemType
      m.assertEqual(resolveItemPlaceholderType(item), expected)
    end function

    @it("routes library-tile container types via collectionType")
    @params("CollectionFolder", "movies", "Movie")
    @params("CollectionFolder", "tvshows", "Series")
    @params("CollectionFolder", "music", "Audio")
    @params("CollectionFolder", "livetv", "TvChannel")
    @params("CollectionFolder", "photos", "Photo")
    @params("CollectionFolder", "photoalbum", "Photo")
    @params("UserView", "movies", "Movie")
    @params("Folder", "music", "Audio")
    function _(itemType, collectionType, expected)
      item = createObject("roSGNode", "JellyfinBaseItem")
      item.type = itemType
      item.collectionType = collectionType
      m.assertEqual(resolveItemPlaceholderType(item), expected)
    end function

    @it("falls back to Folder for generic library-tile containers (no collectionType)")
    @params("CollectionFolder")
    @params("UserView")
    @params("Folder")
    function _(itemType)
      item = createObject("roSGNode", "JellyfinBaseItem")
      item.type = itemType
      m.assertEqual(resolveItemPlaceholderType(item), "Folder")
    end function

  end class

end namespace
