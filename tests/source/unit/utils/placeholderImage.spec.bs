
namespace tests

  @suite("placeholderImage.bs - Placeholder Image Utilities")
  class PlaceholderImageTests extends tests.BaseTestSuite

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("getPlaceholderImagePath(itemType)")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("returns movie placeholder for Movie and BoxSet")
    @params("Movie", "pkg:/images/placeholders/movie_$$RES$$.png")
    @params("BoxSet", "pkg:/images/placeholders/movie_$$RES$$.png")
    function _(itemType, expected)
      m.assertEqual(getPlaceholderImagePath(itemType), expected)
    end function

    @it("returns person placeholder for Person")
    function _()
      m.assertEqual(getPlaceholderImagePath("Person"), "pkg:/images/placeholders/person_$$RES$$.png")
    end function

    @it("returns playCircle placeholder for video/episode types")
    @params("Episode", "pkg:/images/placeholders/playCircle_$$RES$$.png")
    @params("Video", "pkg:/images/placeholders/playCircle_$$RES$$.png")
    @params("MusicVideo", "pkg:/images/placeholders/playCircle_$$RES$$.png")
    @params("Recording", "pkg:/images/placeholders/playCircle_$$RES$$.png")
    @params("Program", "pkg:/images/placeholders/playCircle_$$RES$$.png")
    @params("Series", "pkg:/images/placeholders/playCircle_$$RES$$.png")
    @params("Season", "pkg:/images/placeholders/playCircle_$$RES$$.png")
    @params("Chapter", "pkg:/images/placeholders/playCircle_$$RES$$.png")
    function _(itemType, expected)
      m.assertEqual(getPlaceholderImagePath(itemType), expected)
    end function

    @it("returns album placeholder for MusicAlbum")
    function _()
      m.assertEqual(getPlaceholderImagePath("MusicAlbum"), "pkg:/images/placeholders/album_$$RES$$.png")
    end function

    @it("returns artist placeholder for MusicArtist")
    function _()
      m.assertEqual(getPlaceholderImagePath("MusicArtist"), "pkg:/images/placeholders/artist_$$RES$$.png")
    end function

    @it("returns musicNote placeholder for Audio")
    function _()
      m.assertEqual(getPlaceholderImagePath("Audio"), "pkg:/images/placeholders/musicNote_$$RES$$.png")
    end function

    @it("returns playlist placeholder for Playlist")
    function _()
      m.assertEqual(getPlaceholderImagePath("Playlist"), "pkg:/images/placeholders/playlist_$$RES$$.png")
    end function

    @it("returns photo placeholder for Photo")
    function _()
      m.assertEqual(getPlaceholderImagePath("Photo"), "pkg:/images/placeholders/photo_$$RES$$.png")
    end function

    @it("returns photoAlbum placeholder for PhotoAlbum")
    function _()
      m.assertEqual(getPlaceholderImagePath("PhotoAlbum"), "pkg:/images/placeholders/photoAlbum_$$RES$$.png")
    end function

    @it("returns folder fallback for unknown or unmatched types")
    @params("CollectionFolder", "pkg:/images/placeholders/folder_$$RES$$.png")
    @params("UserView", "pkg:/images/placeholders/folder_$$RES$$.png")
    @params("Channel", "pkg:/images/placeholders/folder_$$RES$$.png")
    @params("TvChannel", "pkg:/images/placeholders/folder_$$RES$$.png")
    @params("SomeUnknownType", "pkg:/images/placeholders/folder_$$RES$$.png")
    @params("", "pkg:/images/placeholders/folder_$$RES$$.png")
    function _(itemType, expected)
      m.assertEqual(getPlaceholderImagePath(itemType), expected)
    end function

  end class

end namespace
