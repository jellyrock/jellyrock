import "pkg:/source/utils/dialogs.bs"

namespace tests

  @suite("dialogs.bs helpers - choice routing heuristic")
  class DialogsUtilTests extends tests.BaseTestSuite

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("choicesFitAsButtons")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("accepts 2 short choices")
    function _()
      m.assertTrue(choicesFitAsButtons(["Resume", "Start Over"]))
    end function

    @it("accepts 3 short choices")
    function _()
      m.assertTrue(choicesFitAsButtons(["Resume", "Start Over", "Cancel"]))
    end function

    @it("rejects 4+ choices regardless of width")
    function _()
      m.assertFalse(choicesFitAsButtons(["A", "B", "C", "D"]))
    end function

    @it("rejects an empty choice set")
    function _()
      m.assertFalse(choicesFitAsButtons([]))
    end function

    @it("rejects invalid input")
    function _()
      m.assertFalse(choicesFitAsButtons(invalid))
    end function

    @it("rejects 3 very wide labels (measured overflow falls back to list)")
    function _()
      wide = "This is an extremely long translated button label that cannot possibly fit"
      m.assertFalse(choicesFitAsButtons([wide, wide, wide]))
    end function


    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("isOverlayDialogOpen")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    ' This answers a question the OSD's inactivity timer asks before hiding
    ' itself. It was answered by Roku's modal channel alone, which the JRDialog
    ' family does not use — so it said "no dialog" while a dialog was on screen,
    ' and the OSD hid out from under it, taking focus with it.
    @it("is false with nothing on screen")
    function _()
      m.assertFalse(isOverlayDialogOpen())
    end function

    @it("is true while an overlay dialog is appended to the scene")
    function _()
      scene = m.top.getScene()
      m.assertNotInvalid(scene)

      dialog = CreateObject("roSGNode", "JRDialog")
      dialog.title = "Delete"
      dialog.buttons = ["Cancel", "Delete"]
      presented = presentOverlayDialog(dialog, "")

      wasOpen = isOverlayDialogOpen()
      abandonDialog(presented)
      afterAbandon = isOverlayDialogOpen()

      m.assertTrue(wasOpen)
      m.assertFalse(afterAbandon)
    end function

    @it("is true for a list dialog too — it keys off the shared overlay id")
    function _()
      dialog = CreateObject("roSGNode", "JRListDialog")
      dialog.title = "Select audio"
      dialog.items = ["English", "Spanish"]
      presented = presentOverlayDialog(dialog, "")

      wasOpen = isOverlayDialogOpen()
      abandonDialog(presented)

      m.assertTrue(wasOpen)
      m.assertFalse(isOverlayDialogOpen())
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("cancelOpenDialog vs abandonDialog")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    ' The two verbs differ in exactly one thing — whether the OWNER is told — and
    ' that difference is the whole reason both exist. abandonDialog is for an
    ' owner whose scope is being torn down (onDestroy); cancelOpenDialog is for a
    ' third party clearing the screen while the owner is alive and holding state
    ' until its dialog answers. Getting them the wrong way round strands a flow.
    @it("cancelOpenDialog closes the overlay AND delivers a cancelled result")
    function _()
      dialog = CreateObject("roSGNode", "JRDialog")
      dialog.title = "Change server"
      dialog.confirmIndex = 1
      dialog.buttons = ["Cancel", "Switch"]
      presented = presentOverlayDialog(dialog, "")

      cancelOpenDialog()

      m.assertFalse(isOverlayDialogOpen())
      m.assertNotInvalid(presented.result)
      m.assertTrue(presented.result.cancelled)
      m.assertFalse(presented.result.confirmed)
    end function

    @it("abandonDialog closes the overlay and deliberately delivers NOTHING")
    function _()
      dialog = CreateObject("roSGNode", "JRDialog")
      dialog.title = "Change server"
      dialog.buttons = ["Cancel", "Switch"]
      presented = presentOverlayDialog(dialog, "")

      abandonDialog(presented)

      m.assertFalse(isOverlayDialogOpen())
      m.assertInvalid(presented.result)
    end function

    @it("cancelOpenDialog is safe with nothing open")
    function _()
      m.assertFalse(isOverlayDialogOpen())
      cancelOpenDialog()
      m.assertFalse(isOverlayDialogOpen())
    end function

    @it("cancels a list dialog too — it reaches whatever is open by the shared id")
    function _()
      dialog = CreateObject("roSGNode", "JRListDialog")
      dialog.title = "Select audio"
      dialog.items = ["English", "Spanish"]
      presented = presentOverlayDialog(dialog, "")

      cancelOpenDialog()

      m.assertFalse(isOverlayDialogOpen())
      m.assertTrue(presented.result.cancelled)
      m.assertEqual(presented.result.optionIndex, -1)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("presentOverlayDialog supersedes the open dialog")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    ' EXACTLY ONE overlay at a time is the invariant Roku's modal channel used to
    ' enforce for free, and that the main-thread flows lost when they moved onto
    ' the overlay channel. Two stacked overlays share the id, so findNode starts
    ' resolving to the corpse and the lower dialog is visible but deaf.
    @it("detaches the incumbent, leaving only the newcomer")
    function _()
      first = CreateObject("roSGNode", "JRDialog")
      first.buttons = ["Cancel", "Switch"]
      first = presentOverlayDialog(first, "")

      second = CreateObject("roSGNode", "JRDialog")
      second.buttons = ["Cancel", "Delete"]
      second = presentOverlayDialog(second, "")

      m.assertInvalid(first.getParent())
      m.assertNotInvalid(second.getParent())

      ' Asserted by IDENTITY, not by id: both carry the shared overlay id by
      ' construction, so comparing ids would pass even if findNode resolved to
      ' the dialog that was just detached.
      open = m.top.getScene().findNode("jrDialog")
      m.assertNotInvalid(open)
      m.assertTrue(open.isSameNode(second))

      abandonDialog(second)
    end function

    ' Superseding must be indistinguishable from the user pressing Back, or an
    ' owner holding state until its dialog answers is stranded. All ten
    ' result.confirmed consumers in app code gate positively, so this is a no-op
    ' at every call site rather than a half-action.
    @it("delivers a cancelled result to the incumbent's owner")
    function _()
      first = CreateObject("roSGNode", "JRDialog")
      first.confirmIndex = 1
      first.buttons = ["Cancel", "Switch"]
      first = presentOverlayDialog(first, "")

      second = CreateObject("roSGNode", "JRDialog")
      second.buttons = ["OK"]
      second = presentOverlayDialog(second, "")

      m.assertNotInvalid(first.result)
      m.assertTrue(first.result.cancelled)
      m.assertFalse(first.result.confirmed)

      abandonDialog(second)
    end function

    ' THE ORDERING GATE. lastFocusedChild walks focusedChild down to the deepest
    ' focused node, so computing returnFocusTo while the incumbent is still
    ' mounted resolves INSIDE the incumbent — and closing the newcomer would then
    ' restore focus to a detached node. Cancel first, measure second.
    '
    ' Asserted as REACHABILITY FROM THE SCENE, not as "not the superseded dialog".
    ' That proxy was tried first and is vacuous: lastFocusedChild descends to a
    ' BUTTON inside the dialog, so isSameNode(first) is false either way and the
    ' test passed against a deliberately reverted ordering. Walking up to the
    ' scene is the property that actually distinguishes them, because a node
    ' inside the superseded dialog is detached along with it.
    @it("leaves the newcomer's returnFocusTo attached to the scene")
    function _()
      scene = m.top.getScene()

      first = CreateObject("roSGNode", "JRDialog")
      first.buttons = ["Cancel", "Switch"]
      first = presentOverlayDialog(first, "")
      first.setFocus(true)

      second = CreateObject("roSGNode", "JRDialog")
      second.buttons = ["OK"]
      second = presentOverlayDialog(second, "")

      node = second.returnFocusTo
      attached = false
      ' Bounded so a cycle or an unexpectedly deep tree fails the assert rather
      ' than hanging the suite.
      for i = 0 to 30
        if not isValid(node) then exit for
        if node.isSameNode(scene)
          attached = true
          exit for
        end if
        node = node.getParent()
      end for

      m.assertTrue(attached, "returnFocusTo points into a tree detached from the scene")

      abandonDialog(second)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("returnFocusTo — passed vs derived")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    ' A caller that KNOWS its opener passes it. Derivation walks focusedChild down
    ' from the scene, which lands on the same node only incidentally — the opener
    ' is whoever asked for the dialog, not whoever happened to hold focus.
    @it("uses an explicitly passed node instead of deriving one")
    function _()
      scene = m.top.getScene()
      opener = CreateObject("roSGNode", "Group")
      scene.appendChild(opener)

      dialog = CreateObject("roSGNode", "JRDialog")
      dialog.buttons = ["OK"]
      presented = presentOverlayDialog(dialog, "", opener)

      m.assertTrue(presented.returnFocusTo.isSameNode(opener))

      abandonDialog(presented)
      scene.removeChild(opener)
    end function

    ' The omitted case is every existing caller, so it has to keep deriving.
    @it("falls back to the derived node when none is passed")
    function _()
      dialog = CreateObject("roSGNode", "JRDialog")
      dialog.buttons = ["OK"]
      presented = presentOverlayDialog(dialog, "")

      m.assertNotInvalid(presented.returnFocusTo)

      abandonDialog(presented)
    end function

    ' FocusableOverview is the caller this exists for: it opens an OverviewDialog
    ' for its own text and knows it is the node to come back to.
    @it("showInfoDialog threads it through to the dialog")
    function _()
      scene = m.top.getScene()
      opener = CreateObject("roSGNode", "Group")
      scene.appendChild(opener)

      presented = showInfoDialog("Overview", "A description.", "", opener)

      m.assertTrue(presented.returnFocusTo.isSameNode(opener))
      ' and it went through the standard path, so it carries the shared id
      m.assertTrue(isOverlayDialogOpen())

      abandonDialog(presented)
      scene.removeChild(opener)
    end function

    ' abandonDialog() DOES NOT RESTORE FOCUS, and the next derived returnFocusTo
    ' collapses to the scene. Measured on device, not assumed.
    '
    ' That is correct for the verb: every abandonDialog() caller but one is an
    ' onDestroy, where the view is going away and there is no focus to return to
    ' — restoring it there would point at a node about to be detached. The dialog
    ' family's OTHER exit, closeDialog(), does restore focus, and the asymmetry
    ' stayed invisible while the two never met on a live screen.
    '
    ' It becomes a trap the moment a screen abandons a dialog and STAYS ON THE
    ' AIR, because presentOverlayDialog derives returnFocusTo from whatever holds
    ' focus at that instant — so the next dialog inherits the scene root and hands
    ' focus back to nothing on close. UserSelect.abandonQuickConnectDialog() is
    ' the one caller in that position and re-focuses its button row itself.
    '
    ' Pinned as CHARACTERIZATION rather than as a defect: if abandonDialog ever
    ' does start restoring focus, this fails and points at the call site whose
    ' extra line has become redundant.
    @it("does not restore focus, so the next dialog derives the scene as its returnFocusTo")
    function _()
      scene = m.top.getScene()

      ' A REAL focusable node, asserted to actually hold focus before the
      ' measurement begins. Without that precondition this would pass on a model
      ' where nothing was ever focused, measuring nothing — the vacuous-proxy
      ' failure recorded on the supersede test above.
      opener = CreateObject("roSGNode", "Button")
      opener.text = "opener"
      scene.appendChild(opener)
      opener.setFocus(true)
      m.assertTrue(lastFocusedChild(scene).isSameNode(opener), "precondition failed: the opener never took focus, so this test would measure nothing")

      dialog = CreateObject("roSGNode", "JRDialog")
      dialog.buttons = ["Cancel"]
      presented = presentOverlayDialog(dialog, "")
      abandonDialog(presented)

      ' 1. The focus the dialog held is not handed back.
      orphaned = lastFocusedChild(scene)
      m.assertTrue(orphaned.isSameNode(scene), "expected focus to fall back to the scene root; got " + orphaned.subtype())

      ' 2. The consequence a live screen actually feels: the NEXT dialog derives
      '    the scene root, so dismissing it restores focus to nothing.
      follower = CreateObject("roSGNode", "JRDialog")
      follower.buttons = ["OK"]
      follower = presentOverlayDialog(follower, "")
      m.assertTrue(follower.returnFocusTo.isSameNode(scene), "expected the derived returnFocusTo to be the scene root; got " + follower.returnFocusTo.subtype())

      abandonDialog(follower)
      scene.removeChild(opener)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("abandonDialog drops PORT observers too")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    ' abandonDialog used unobserveFieldScoped, which removes only the CALLING
    ' component's connection — so it missed a main-thread dialog observed with
    ' observeField("result", m.port). unobserveField drops every observer on the
    ' field, which is what "abandon" means. Gated by writing `result` by hand
    ' after the abandon: a surviving observer would put an event on the port.
    @it("a port observer receives nothing after the dialog is abandoned")
    function _()
      port = CreateObject("roMessagePort")
      dialog = CreateObject("roSGNode", "JRDialog")
      dialog.buttons = ["OK"]
      presented = presentOverlayDialog(dialog, "")
      presented.observeField("result", port)

      abandonDialog(presented)
      presented.result = { cancelled: true, confirmed: false }

      m.assertInvalid(wait(200, port))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("showAlertDialog — the optional secondary action")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    ' The parameter exists because its absence caused a bypass: the playback
    ' error dialog needed [Details] beside OK, could not say so through the
    ' helper, and dropped a layer down to presentOverlayDialog to hand-build the
    ' node — the one call site in the app doing that, and a shape the
    ' no-hand-rolled-dialog plugin does not catch.
    '
    ' SHAPE ONLY. These assert the button row and the focus index; they do not
    ' assert what pressing a button returns, because driving a press needs
    ' synthetic key events this suite does not do. buttonDialogResult's index ->
    ' result mapping is covered in dialogResult.spec.bs.
    @it("is a single OK button when no secondary is asked for")
    function _()
      presented = showAlertDialog("Playback Error", "Something went wrong.")

      m.assertEqual(presented.buttons.count(), 1)

      abandonDialog(presented)
    end function

    @it("puts the secondary to the RIGHT of OK and leaves OK focused")
    function _()
      presented = showAlertDialog("Playback Error", "Something went wrong.", "", "", "Details")

      m.assertEqual(presented.buttons.count(), 2)
      m.assertEqual(presented.buttons[1], "Details")
      ' OK is index 0 and stays the focused button: the secondary is an extra,
      ' never the thing a reflexive press lands on.
      m.assertEqual(presented.defaultButtonIndex, 0)

      abandonDialog(presented)
    end function

    ' The GUARD, not the default. A caller that computes the label and comes up
    ' empty (no details worth showing) passes "" rather than branching, so an
    ' empty string must produce the one-button dialog rather than a blank second
    ' button.
    @it("treats an empty secondary label as no secondary at all")
    function _()
      presented = showAlertDialog("Playback Error", "Something went wrong.", "", "", "")

      m.assertEqual(presented.buttons.count(), 1)

      abandonDialog(presented)
    end function

    ' subheading and the secondary are independent slots — the cast notice uses
    ' the first, the error dialog uses the second, and nothing should couple them.
    @it("still honours subheading alongside a secondary action")
    function _()
      presented = showAlertDialog("Cast", "Body text.", "", "From the phone", "Details")

      m.assertEqual(presented.subheading, "From the phone")
      m.assertEqual(presented.buttons.count(), 2)

      abandonDialog(presented)
    end function

  end class

end namespace
