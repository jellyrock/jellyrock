import "pkg:/source/utils/tasks.bs"

namespace tests

  ' MEASUREMENT, not a regression gate — the cost of making the task ledger
  ' PRODUCTION-resident, taken before anything is designed around it.
  '
  ' `launchTask()` today strips in a production build to a validity check plus
  ' `control = "RUN"`; `trackTaskLaunch` is inside `#if debug`. The charter's
  ' open criterion wants a build that COUNTS and REFUSES, and that means paying
  ' `recordTaskLaunch` — a read-modify-write of a node field holding an array of
  ' node references — plus an O(live) `.state` walk, on EVERY launch. A path
  ' `ExtrasRowList` hits 38 times. That cost has never been measured; the
  ' debug-only choice was made on the observer-leak argument, not on a number.
  '
  ' Two terms are separated deliberately, because they point at different designs:
  '   - WHERE the ledger lives (`m.global`, owned off this thread, vs a
  '     thread-local node) — the crossing cost.
  '   - HOW DEEP it is (the O(live) walk) — the term that grows precisely as the
  '     app approaches the cap the ceiling exists to defend.
  '
  ' Depth is built from NEVER-LAUNCHED Task nodes. A fresh node reports `state =
  ' "init"`, which `taskThreadIsLive` counts as live (pinned by tasks.spec.bs), so
  ' a 50-deep ledger costs 50 real `.state` reads while starting zero threads —
  ' measuring the ceiling without provoking the `&h29` it exists to prevent.
  @suite("tasks.bs - COST of a production-resident task ledger")
  class TaskLedgerCostTests extends tests.BaseTestSuite

    ' Enough iterations that `roTimespan`'s granularity is not the measurement.
    public iterations = 200

    protected override function setup()
      super.setup()
    end function

    ' `ServerReachableTask`'s init() only sets functionName — no thread, no server.
    protected function freshTask() as object
      return CreateObject("roSGNode", "ServerReachableTask")
    end function

    ' A ledger `depth` entries deep, parked on `store`.
    protected function seedLedger(store as object, depth as integer) as object
      seeded = []
      for i = 1 to depth
        seeded.push(m.freshTask())
      end for
      if not store.hasField("taskLedger") then store.addField("taskLedger", "array", false)
      store["taskLedger"] = seeded
      return seeded
    end function

    ' Mean microseconds per `recordTaskLaunch` call against a `depth`-deep ledger.
    protected function benchRecord(store as object, depth as integer) as float
      m.seedLedger(store, depth)
      node = m.freshTask()
      probe = CreateObject("roTimespan")
      probe.mark()
      for i = 1 to m.iterations
        recordTaskLaunch(store, node)
      end for
      return probe.totalMicroseconds() / m.iterations
    end function

    ' Mean microseconds per `countLiveTaskThreads` walk — what a REFUSING ceiling
    ' pays on top of recording, since it has to know the count before it decides.
    protected function benchCount(depth as integer) as float
      ledger = []
      for i = 1 to depth
        ledger.push(m.freshTask())
      end for
      probe = CreateObject("roTimespan")
      probe.mark()
      for i = 1 to m.iterations
        countLiveTaskThreads(ledger)
      end for
      return probe.totalMicroseconds() / m.iterations
    end function

    ' Mean microseconds for the PURE array arithmetic alone — no store, no node
    ' field read or write. `recordTaskLaunch` minus this is what the node field
    ' access costs, and the two point at different fixes: if the arithmetic
    ' dominates, stop rebuilding the array; if the field access dominates, move
    ' where the ledger lives.
    protected function benchPrune(depth as integer) as float
      ledger = []
      for i = 1 to depth
        ledger.push(m.freshTask())
      end for
      node = m.freshTask()
      probe = CreateObject("roTimespan")
      probe.mark()
      for i = 1 to m.iterations
        pruneTaskLedger(ledger, node)
      end for
      return probe.totalMicroseconds() / m.iterations
    end function

    ' The apparatus floor: the same loop doing the cheapest possible body. Whatever
    ' this reads is measurement overhead present in every cell above, and it is
    ' SUBTRACTED rather than argued to be negligible.
    protected function benchFloor() as float
      node = m.freshTask()
      total = 0
      probe = CreateObject("roTimespan")
      probe.mark()
      for i = 1 to m.iterations
        if isValid(node) then total++
      end for
      return probe.totalMicroseconds() / m.iterations
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("what a production ledger would cost per launch")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("measures record + count against ledger depth, on m.global and on a local node")
    function _()
      floor = m.benchFloor()
      local = CreateObject("roSGNode", "Node")

      print "[LEDGER-COST] iterations="; m.iterations; " floorUs="; floor
      print "[LEDGER-COST] depth | recordGlobalUs | recordLocalUs | countUs | pruneUs"

      for each depth in [0, 10, 25, 50]
        g = m.benchRecord(m.global, depth)
        l = m.benchRecord(local, depth)
        c = m.benchCount(depth)
        p = m.benchPrune(depth)
        print "[LEDGER-COST] "; depth; " | "; g - floor; " | "; l - floor; " | "; c - floor; " | "; p - floor
      end for

      ' Leave m.global as we found it — this suite writes a real field on the
      ' shared global node, and a later suite in the same run would inherit it.
      m.global["taskLedger"] = []

      m.assertTrue(floor >= 0)
    end function

    ' THE DISCRIMINATOR — is a ledger read expensive because of the THREAD, or is
    ' node field access just expensive?
    '
    ' It decides the whole question. Roku's docs say a node operation invoked by
    ' any thread other than the Render thread rendezvouses, and that "Task nodes
    ' are owned by the Render thread". If that is what the per-entry cost is, then
    ' the ledger is expensive HERE and cheap on the render thread — which is where
    ' this project already established every app-owned Task launch happens, so the
    ' production cost would be a fraction of what the table above reports. If
    ' instead a locally-owned node reads just as slowly, node field access is
    ' intrinsically expensive and the ledger is expensive everywhere.
    '
    ' Three reads, same loop, same apparatus:
    '   local  — a plain Node created here, owned by THIS thread
    '   task   — a Task node, owned by the Render thread whatever created it
    '   global — m.global, owned by the Render thread
    @it("separates thread-crossing cost from intrinsic node field cost")
    function _()
      floor = m.benchFloor()

      localNode = CreateObject("roSGNode", "Node")
      localNode.id = "bench"
      taskNode = m.freshTask()

      sink = ""
      probeL = CreateObject("roTimespan")
      probeL.mark()
      for i = 1 to m.iterations
        sink = localNode.id
      end for
      localUs = probeL.totalMicroseconds() / m.iterations - floor

      probeT = CreateObject("roTimespan")
      probeT.mark()
      for i = 1 to m.iterations
        sink = taskNode.state
      end for
      taskUs = probeT.totalMicroseconds() / m.iterations - floor

      probeG = CreateObject("roTimespan")
      probeG.mark()
      for i = 1 to m.iterations
        sink = m.global.id
      end for
      globalUs = probeG.totalMicroseconds() / m.iterations - floor

      ' `sink` is referenced so the reads cannot be optimised away or linted out.
      print "[LEDGER-COST] one field read - localNodeUs="; localUs; " taskNodeUs="; taskUs; " globalUs="; globalUs; " (sink len "; Len(sink); ")"

      ' THE GATE, and the reason this file is not merely a printout. The whole
      ' case for a production-resident ledger rests on one platform property: a
      ' field read on a node owned by the READING thread is cheap. Measured
      ' 2026-08-23 at 0.625 us (Ultra 4850X) and 1.57 us (Stick 4K) against
      ' 63-118 us for a render-owned node read from off-thread — a 75-100x gap.
      '
      ' 10 us is ~6x the slowest measured value, so this is not a tight perf
      ' assertion that will flake; it is a tripwire for the cost model being
      ' WRONG. If a future Roku OS makes even same-thread node access expensive,
      ' the ledger stops being affordable anywhere and this fails loudly instead
      ' of the conclusion silently rotting in a doc.
      m.assertTrue(localUs < 10, "a thread-local node field read cost " + localUs.toStr() + " us; the production-ledger cost model assumes this is cheap")
    end function

    ' Does a GENUINELY RUNNING task read its `.state` more expensively than a
    ' never-launched one? The depth fixture above assumes not. Unproven
    ' assumptions in a cost model are how a ceiling gets designed against the
    ' wrong number, so it is probed rather than asserted.
    @it("compares a state read on running tasks against never-launched ones")
    function _()
      fresh = []
      running = []
      for i = 1 to 8
        fresh.push(m.freshTask())
        node = m.freshTask()
        ' RFC 5737 TEST-NET-1: unroutable, so the connect hangs and the thread
        ' genuinely stays running for the length of this test.
        node.baseUrl = "http://192.0.2.1:8096"
        launchTask(node)
        running.push(node)
      end for

      probeF = CreateObject("roTimespan")
      probeF.mark()
      for i = 1 to m.iterations
        countLiveTaskThreads(fresh)
      end for
      freshUs = probeF.totalMicroseconds() / m.iterations

      probeR = CreateObject("roTimespan")
      probeR.mark()
      for i = 1 to m.iterations
        countLiveTaskThreads(running)
      end for
      runningUs = probeR.totalMicroseconds() / m.iterations

      print "[LEDGER-COST] depth=8 freshUs="; freshUs; " runningUs="; runningUs

      for each node in running
        node.control = "STOP"
      end for

      m.assertTrue(freshUs >= 0 and runningUs >= 0)
    end function

  end class
end namespace
