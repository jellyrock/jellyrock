import "pkg:/source/utils/dialogReveal.bs"
import "pkg:/source/utils/dialogs.bs"

namespace tests

  @suite("dialogReveal.bs - hiding a dialog until it has laid itself out")
  class DialogRevealTests extends tests.BaseTestSuite

    private dialog as object

    ' beforeEach, not setup: every test mutates the node (tests/CLAUDE.md).
    protected override function beforeEach()
      super.beforeEach()
      m.dialog = CreateObject("roSGNode", "OverviewDialog")
    end function

    protected override function afterEach()
      m.dialog = invalid
      super.afterEach()
    end function

    ' A body big enough that the panel has to grow for it, so "did it lay out"
    ' is a question with a visible answer rather than a default.
    private function reportSections() as object
      rows = []
      for i = 0 to 14
        rows.push({ id: "r" + i.toStr(), label: "Label " + i.toStr(), value: "A value long enough to be real " + i.toStr() })
      end for
      return [{ id: "s1", heading: "Video", wideLabels: false, rows: rows }]
    end function

    private function panelHeight(dialog as object) as integer
      return int(dialog.findNode("panelBackground").height)
    end function

    private function panelWidth(dialog as object) as integer
      return int(dialog.findNode("panelBackground").width)
    end function

    ' Yield the render thread long enough for a render pass, then come back.
    '
    ' `wait` on a port is the only way a Rooibos test can let the renderer run —
    ' the test body IS render-thread work, so without this nothing between two
    ' reads can ever have rendered. Observing the button's `isReady` makes it
    ' return as soon as the thing we care about happens, with the timeout as the
    ' floor rather than the expected cost. Same mechanism dialogs.spec.bs uses to
    ' prove a port observer was dropped.
    private sub letARenderPassHappen(dialog as object)
      row = dialog.findNode("buttonRow")
      port = CreateObject("roMessagePort")
      if isValid(row) and row.getChildCount() > 0
        row.getChild(0).observeField("isReady", port)
      end if
      wait(1500, port)
    end sub

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("measuring while hidden")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    ' THE claim the whole approach rests on, and the one that is easy to assume
    ' backwards: Roku stops `renderTracking` firing for a node whose `visible` is
    ' false, so it is tempting to conclude a hidden dialog can never lay out. It
    ' can. renderTracking is only the wake-up signal; the heights come from
    ' localBoundingRect(), which answers while hidden — the same property
    ' FontScalingTask has always relied on to measure two `visible="false"`
    ' labels in JRScene.
    @it("lays out to the SAME panel height hidden as it does visible")
    function _()
      shown = CreateObject("roSGNode", "OverviewDialog")
      shown.title = "Playback info"
      shown.sections = m.reportSections()

      hidden = CreateObject("roSGNode", "OverviewDialog")
      hideDialogUntilLaidOut(hidden)
      hidden.title = "Playback info"
      hidden.sections = m.reportSections()

      m.assertTrue(m.panelHeight(shown) > 0, "the visible dialog did not lay out; the comparison below would be vacuous")
      m.assertEqual(m.panelHeight(hidden), m.panelHeight(shown), "a hidden dialog measured differently, so hiding it costs the layout")
    end function

    ' Single-line font metrics are the easy case. This is the one the existing
    ' comments doubted: a wrapped label needing a real text layout to know it
    ' occupies two lines.
    @it("measures a WRAPPED label's multi-line height while it is hidden")
    function _()
      label = CreateObject("roSGNode", "LabelSecondaryMedium")
      label.visible = false
      label.width = 300
      label.wrap = true
      label.maxLines = 2
      label.text = "AudioCodecNotSupported"

      oneLine = CreateObject("roSGNode", "LabelSecondaryMedium")
      oneLine.visible = false
      oneLine.text = "Codec"

      m.assertTrue(int(oneLine.localBoundingRect().height) > 0, "a hidden label measured zero; the rest of this test would assert nothing")
      m.assertTrue(int(label.localBoundingRect().height) > int(oneLine.localBoundingRect().height), "a hidden wrapped label did not report its second line")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("hiding and showing")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("hides the dialog outright, backdrop included")
    function _()
      hideDialogUntilLaidOut(m.dialog)
      m.assertFalse(m.dialog.visible, "the dialog is still visible, so its unlaid-out frame still paints")
    end function

    @it("shows it again")
    function _()
      hideDialogUntilLaidOut(m.dialog)
      revealDialog(m.dialog)
      m.assertTrue(m.dialog.visible)
    end function

    ' Called from the settle path AND from the 0.15s announcement failsafe, so
    ' every call after the first has to be a no-op rather than an error.
    @it("is idempotent, and safe on a dialog that was never hidden")
    function _()
      revealDialog(m.dialog) ' never hidden
      m.assertTrue(m.dialog.visible)

      revealDialog(m.dialog)
      m.assertTrue(m.dialog.visible)
    end function

    ' presentOverlayDialog calls dialog.callFunc("settleLayout") on all FOUR
    ' dialog types. A fifth added later without the <function> line on its .xml
    ' fails silently - callFunc no-ops and the dialog stays hidden until the
    ' 0.15s onOpeningAnnouncementDue failsafe - so this covers every type
    ' presentOverlayDialog actually dispatches to, not just the one that
    ' happened to be under test when settleLayout was added.
    '
    ' settleLayout has to be reachable through the component interface or the
    ' callFunc is a silent no-op — the failure the callfunc-interface plugin
    ' exists for. Asserting the OUTCOME rather than the call: a dialog whose
    ' fields were set while detached still ends up laid out.
    @it("settles the layout and shows the dialog in one step")
    @params("JRDialog")
    @params("JRListDialog")
    @params("QuickConnectDialog")
    @params("OverviewDialog")
    function _(dialogType as string)
      ' Bracket notation throughout this test: `dialogType` is a runtime value, so
      ' bsc can only see these as roSGNodeNode, which has none of the per-dialog
      ' fields set below.
      dialog = CreateObject("roSGNode", dialogType)
      hideDialogUntilLaidOut(dialog)
      dialog["title"] = "Playback info"

      if dialogType = "JRDialog"
        dialog["message"] = "A message long enough to make the panel grow"
        dialog["buttons"] = ["Cancel", "OK"]
      else if dialogType = "JRListDialog"
        dialog["items"] = ["Option A", "Option B", "Option C"]
      else if dialogType = "QuickConnectDialog"
        dialog["instruction"] = "Enter this code on jellyfin.org/quickconnect"
        dialog["code"] = "ABCD"
      else if dialogType = "OverviewDialog"
        dialog["sections"] = m.reportSections()
      end if

      settleAndRevealDialog(dialog)

      m.assertTrue(dialog["visible"], "settleAndRevealDialog left the dialog hidden")
      m.assertTrue(m.panelHeight(dialog) > 0, "settleLayout did not reach applyLayout — check the <function> interface line")
    end function

    @it("survives being handed nothing")
    function _()
      hideDialogUntilLaidOut(invalid)
      settleAndRevealDialog(invalid)
      revealDialog(invalid)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("revealed fully formed")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    ' THE PROPERTY THE WHOLE APPROACH PROMISES: "it simply is not there, and then
    ' it is, fully formed". Everything above proves the dialog is LAID OUT while
    ' hidden; none of it proves the geometry does not move again once shown.
    '
    ' That gap is not hypothetical. TextButton sizes itself only when its own
    ' `renderTracking` reads "full" (TextButton.bs onTextChanged / onRenderComplete),
    ' and dialogReveal.bs's own premise is that Roku reports "none" for a hidden
    ' node — so across the hidden window the buttons may not have sized, and
    ' JRDialog derives the PANEL WIDTH from `naturalButtonRowWidth()`. If that
    ' measured short, the panel would be placed at the default width and then grow
    ' when `isReady` finally fires, one pass after the dialog became visible.
    '
    ' A long label is what makes the question answerable: with an English
    ' two-button row the panel never grows past PANEL_WIDTH, so a re-flow and a
    ' correct layout are indistinguishable. This label is wide enough to force the
    ' grow-or-stack path that exists for long translations.
    '
    ' Asserted as WIDTH EQUALITY across a render pass rather than by watching for
    ' a flash, because a one-frame artifact is not observable from a test — but a
    ' geometry change across the boundary is, and it is the same defect.
    '
    ' THE ANSWER, measured rather than argued: the panel is 1140 wide at reveal and
    ' 1140 after, against a 762 default. The buttons ARE measurable while hidden,
    ' because naturalButtonRowWidth() reads the TextButton group's bounding rect
    ' and that includes its `buttonText` Label — which reports font metrics with no
    ' render pass, the same property this whole file rests on. TextButton not
    ' having applied its background size yet never entered into the width. So this
    ' is a guard against a regression, not a fix for a live defect.
    @it("does not re-flow the panel after it becomes visible")
    function _()
      dialog = CreateObject("roSGNode", "JRDialog")
      dialog.title = "Delete this recording?"
      dialog.message = "A message long enough that the panel has real content to size around."
      dialog.buttons = ["Aufnahme dauerhaft entfernen", "Abbrechen und zurueckkehren"]

      presented = presentOverlayDialog(dialog, "")
      widthAtReveal = m.panelWidth(presented)
      heightAtReveal = m.panelHeight(presented)

      m.letARenderPassHappen(presented)

      widthAfterRender = m.panelWidth(presented)
      heightAfterRender = m.panelHeight(presented)
      visible = presented.visible
      abandonDialog(presented)

      m.assertTrue(visible, "the dialog was left hidden")
      ' ANTI-VACUITY GATE, and it is the whole reason this test means anything.
      ' JRDialog's PANEL_WIDTH default is 762 (file-scoped, so not referenceable
      ' from here). If the row fit inside that, the panel would sit at the default
      ' whether or not the buttons had sized, and a re-flow would be
      ' indistinguishable from a correct layout. Measured 1140 on a Stick 4K with
      ' the labels above — comfortably grown, and under PANEL_MAX_WIDTH's 1200 so
      ' it grows rather than stacking.
      m.assertTrue(widthAtReveal > 762, "the button row did not exceed the default panel width, so this test cannot tell a re-flow from a no-op")
      m.assertEqual(widthAtReveal, widthAfterRender, "the panel width changed AFTER the dialog was shown, so it was revealed before it was fully formed")
      m.assertEqual(heightAtReveal, heightAfterRender, "the panel height changed after the dialog was shown")
    end function

    ' The same question for the body shape this branch adds. A report body is
    ' built from wrapping value labels, which DO carry renderTracking observers,
    ' so this is the case most likely to settle late.
    @it("does not re-flow a structured report body after it becomes visible")
    function _()
      dialog = CreateObject("roSGNode", "OverviewDialog")
      dialog.title = "Playback info"
      dialog.sections = m.reportSections()

      presented = presentOverlayDialog(dialog, "")
      heightAtReveal = m.panelHeight(presented)

      m.letARenderPassHappen(presented)

      heightAfterRender = m.panelHeight(presented)
      visible = presented.visible
      abandonDialog(presented)

      m.assertTrue(visible, "the dialog was left hidden")
      m.assertTrue(heightAtReveal > 0, "no panel height at reveal; the comparison below would be vacuous")
      m.assertEqual(heightAtReveal, heightAfterRender, "the report panel resized after it was shown")
    end function

  end class
end namespace
