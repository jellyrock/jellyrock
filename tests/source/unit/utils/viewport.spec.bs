import "pkg:/source/utils/viewport.bs"

namespace tests

  @suite("viewport - rows near the viewport")
  class ViewportTests extends tests.BaseTestSuite

    protected override function setup()
      super.setup()
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("rowWindow()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("spans the visible rows from the focused row, plus the buffer on each side")
    function _()
      m.assertEqual(viewport.rowWindow(10, 3, 100, 2), [8, 10, 12, 14])
    end function

    @it("clamps the buffer at the top of the list")
    function _()
      m.assertEqual(viewport.rowWindow(0, 3, 100, 2), [0, 0, 2, 4])
      m.assertEqual(viewport.rowWindow(1, 3, 100, 25), [0, 1, 3, 28])
    end function

    @it("clamps the visible span and the buffer at the bottom of the list")
    function _()
      m.assertEqual(viewport.rowWindow(9, 3, 10, 2), [7, 9, 9, 9])
      m.assertEqual(viewport.rowWindow(8, 3, 10, 2), [6, 8, 9, 9])
    end function

    @it("returns no window without a focused row inside the list")
    function _()
      none = [-1, -1, -1, -1]
      m.assertEqual(viewport.rowWindow(invalid, 3, 10, 2), none)
      m.assertEqual(viewport.rowWindow(-1, 3, 10, 2), none)
      m.assertEqual(viewport.rowWindow(10, 3, 10, 2), none)
      m.assertEqual(viewport.rowWindow(0, 3, 0, 2), none)
    end function

    @it("takes the buffer as given, so a caller can widen it")
    function _()
      ' The texture window keeps 2 rows either side; the guide keeps a whole program block.
      m.assertEqual(viewport.rowWindow(50, 6, 2000, 25), [25, 50, 55, 80])
    end function

  end class

end namespace
