import "pkg:/source/utils/mediaSegments.bs"

namespace tests

  @suite("mediaSegments.bs - findActiveSegment()")
  class FindActiveSegmentTests extends tests.BaseTestSuite

    ' Helper to create a segment (ticks = seconds * 10000000)
    private function createSegment(id as string, segType as string, startSeconds as float, endSeconds as float) as object
      return {
        Id: id,
        Type: segType,
        StartTicks: startSeconds * 10000000,
        EndTicks: endSeconds * 10000000
      }
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("segment detection")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("returns segment when position is inside it")
    function _()
      segments = [m.createSegment("seg1", "Intro", 5.0, 30.0)]
      result = findActiveSegment(segments, 15.0)
      m.assertNotInvalid(result)
      m.assertEqual(result.Id, "seg1")
    end function

    @it("returns segment at start boundary (inclusive)")
    function _()
      segments = [m.createSegment("seg1", "Intro", 10.0, 40.0)]
      result = findActiveSegment(segments, 10.0)
      m.assertNotInvalid(result)
      m.assertEqual(result.Id, "seg1")
    end function

    @it("returns invalid at end boundary (exclusive)")
    function _()
      segments = [m.createSegment("seg1", "Intro", 10.0, 40.0)]
      result = findActiveSegment(segments, 40.0)
      m.assertInvalid(result)
    end function

    @it("returns invalid when position is before all segments")
    function _()
      segments = [m.createSegment("seg1", "Intro", 30.0, 60.0)]
      result = findActiveSegment(segments, 5.0)
      m.assertInvalid(result)
    end function

    @it("returns invalid when position is after all segments")
    function _()
      segments = [m.createSegment("seg1", "Intro", 10.0, 40.0)]
      result = findActiveSegment(segments, 50.0)
      m.assertInvalid(result)
    end function

    @it("returns correct segment when multiple segments exist")
    function _()
      segments = [
        m.createSegment("intro", "Intro", 5.0, 30.0),
        m.createSegment("outro", "Outro", 1200.0, 1260.0)
      ]
      result = findActiveSegment(segments, 1230.0)
      m.assertNotInvalid(result)
      m.assertEqual(result.Id, "outro")
    end function

    @it("returns invalid for empty segments array")
    function _()
      result = findActiveSegment([], 10.0)
      m.assertInvalid(result)
    end function

    @it("returns invalid when segments is invalid")
    function _()
      result = findActiveSegment(invalid, 10.0)
      m.assertInvalid(result)
    end function

    @it("returns first matching segment when position is in overlap")
    function _()
      segments = [
        m.createSegment("seg1", "Intro", 10.0, 40.0),
        m.createSegment("seg2", "Commercial", 30.0, 60.0)
      ]
      ' Position 35 is inside both segments - first one wins
      result = findActiveSegment(segments, 35.0)
      m.assertNotInvalid(result)
      m.assertEqual(result.Id, "seg1")
    end function

  end class

end namespace
