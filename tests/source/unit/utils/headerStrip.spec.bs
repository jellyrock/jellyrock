import "pkg:/source/utils/headerStrip.bs"

namespace tests

  ' headerStrip.fit: the chips at the right edge, the count and the narrowed-by text before
  ' them, and the left block in what is left. The row here is 1728 wide.
  @suite("headerStrip - how the library header strip shares its row")
  class HeaderStripTests extends tests.BaseTestSuite

    private function widths(title as integer, metadata as integer, narrowedBy as integer, count as integer, chips as object) as object
      return { title: title, metadata: metadata, narrowedBy: narrowedBy, count: count, chips: chips }
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("everything fits")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("puts the chips at the right edge, a gap apart, with the count before them")
    function _()
      placed = headerStrip.fit(m.widths(300, 210, 0, 120, [240, 150]), 1728)
      m.assertEqual(placed.chipXs, [1332, 1578], "Filter ends at 1728, Sort 6 before it")
      m.assertTrue(placed.isCountShown)
      m.assertEqual(placed.countX, 1332 - 24 - 120)
      m.assertEqual(placed.titleWidth, 300)
      m.assertEqual(placed.metadataX, 318, "the metadata follows the title by its gap")
      m.assertEqual(placed.metadataWidth, 210)
    end function

    @it("puts the narrowed-by text before the count")
    function _()
      placed = headerStrip.fit(m.widths(300, 0, 180, 120, [150]), 1728)
      m.assertEqual(placed.countX, 1578 - 24 - 120)
      m.assertEqual(placed.narrowedByX, placed.countX - 24 - 180)
      m.assertEqual(placed.narrowedByWidth, 180)
    end function

    @it("rounds a measured width up onto the 3 px grid, so every position is on it")
    function _()
      placed = headerStrip.fit(m.widths(301, 200, 100, 121, [241, 149]), 1728)
      for each x in [placed.chipXs[0], placed.chipXs[1], placed.countX, placed.narrowedByX, placed.metadataX, placed.titleWidth, placed.metadataWidth]
        m.assertEqual(x mod 3, 0, "on the grid: " + x.toStr())
      end for
    end function

    @it("places a row with no chips and no count from the right edge")
    function _()
      placed = headerStrip.fit(m.widths(300, 0, 0, 0, []), 1728)
      m.assertEqual(placed.chipXs, [])
      m.assertFalse(placed.isCountShown)
      m.assertEqual(placed.titleWidth, 300)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("room runs out")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("cuts the title first and lets the metadata keep its width")
    function _()
      ' The chips and count leave 1728 - 396 - 24 - 120 - 24 = 1164 for the left block
      placed = headerStrip.fit(m.widths(1500, 210, 0, 120, [240, 150]), 1728)
      m.assertTrue(placed.isCountShown)
      m.assertEqual(placed.metadataWidth, 210)
      m.assertEqual(placed.titleWidth, 1164 - 18 - 210)
      m.assertEqual(placed.metadataX, placed.titleWidth + 18)
    end function

    @it("holds the metadata to half the left block")
    function _()
      placed = headerStrip.fit(m.widths(1500, 900, 0, 120, [240, 150]), 1728)
      m.assertEqual(placed.metadataWidth, 582, "half of 1164")
      m.assertEqual(placed.titleWidth, 1164 - 18 - 582)
    end function

    @it("gives a short title's unused room to a long metadata line")
    function _()
      placed = headerStrip.fit(m.widths(150, 1500, 0, 120, [240, 150]), 1728)
      m.assertEqual(placed.titleWidth, 150)
      m.assertEqual(placed.metadataWidth, 1164 - 18 - 150)
    end function

    @it("hides the count when the left block would fall under its minimum")
    function _()
      ' Chips 1200 wide leave 1728 - 1206 - 24 = 498 before the count: under 480 + 24 with it
      placed = headerStrip.fit(m.widths(600, 0, 0, 120, [600, 600]), 1728)
      m.assertFalse(placed.isCountShown)
      m.assertEqual(placed.titleWidth, 498)
    end function

    @it("keeps the count on a row with nothing on the left to protect")
    function _()
      placed = headerStrip.fit(m.widths(0, 0, 0, 120, [600, 600]), 1728)
      m.assertTrue(placed.isCountShown)
    end function

    @it("cuts the narrowed-by text to what the left block's minimum leaves")
    function _()
      placed = headerStrip.fit(m.widths(600, 0, 900, 0, [240, 150]), 1728)
      ' 1728 - 396 - 24 = 1308 before the text; the left block keeps 480 + 24
      m.assertEqual(placed.narrowedByWidth, 1308 - 504)
      m.assertEqual(placed.titleWidth, 480)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("the chip walk")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("moves between the chips on show and stops at the ends")
    function _()
      shown = ["sort", "filter"]
      m.assertEqual(headerStrip.nextFocus(shown, "sort", "right"), "filter")
      m.assertEqual(headerStrip.nextFocus(shown, "filter", "left"), "sort")
      m.assertEqual(headerStrip.nextFocus(shown, "sort", "left"), "", "no wrap")
      m.assertEqual(headerStrip.nextFocus(shown, "filter", "right"), "", "no wrap")
      m.assertEqual(headerStrip.nextFocus(["filter"], "filter", "left"), "")
      m.assertEqual(headerStrip.nextFocus(shown, "elsewhere", "right"), "")
    end function

    @it("enters at the chip used last while it still shows, else the first")
    function _()
      m.assertEqual(headerStrip.entryChip(["sort", "filter"], ""), "sort")
      m.assertEqual(headerStrip.entryChip(["sort", "filter"], "filter"), "filter")
      m.assertEqual(headerStrip.entryChip(["filter"], "sort"), "filter", "the last one is hidden now")
      m.assertEqual(headerStrip.entryChip([], "sort"), "", "no chip, nothing to focus")
    end function

  end class

end namespace
