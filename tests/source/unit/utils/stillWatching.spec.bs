import "pkg:/source/utils/stillWatching.bs"

namespace tests

  @suite("stillWatching.bs")
  class StillWatchingTests extends tests.BaseTestSuite

    ' A 22-minute episode, in seconds
    private EPISODE = 22 * 60

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("stillWatchingThresholds()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("is off for disabled")
    function _()
      m.assertInvalid(stillWatchingThresholds("disabled"))
    end function

    @it("matches the web and Android TV presets")
    function _()
      m.assertEqual(stillWatchingThresholds("short"), { count: 2, seconds: 3600 })
      m.assertEqual(stillWatchingThresholds("default"), { count: 3, seconds: 5400 })
      m.assertEqual(stillWatchingThresholds("long"), { count: 5, seconds: 9000 })
      m.assertEqual(stillWatchingThresholds("veryLong"), { count: 8, seconds: 14400 })
    end function

    @it("treats an empty or unknown value as the default preset, never as off")
    function _()
      m.assertEqual(stillWatchingThresholds(""), { count: 3, seconds: 5400 })
      m.assertEqual(stillWatchingThresholds("webclient"), { count: 3, seconds: 5400 })
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("stillWatchingOnAdvance()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("asks before the fourth video when three played with no button pressed")
    function _()
      session = newStillWatchingSession(0)
      thresholds = stillWatchingThresholds("default")
      ' Play pressed at 0; nothing pressed since
      m.assertFalse(stillWatchingOnAdvance(session, thresholds, m.EPISODE, m.EPISODE))
      m.assertFalse(stillWatchingOnAdvance(session, thresholds, 2 * m.EPISODE, 2 * m.EPISODE))
      m.assertTrue(stillWatchingOnAdvance(session, thresholds, 3 * m.EPISODE, 3 * m.EPISODE))
    end function

    @it("does not count a video during which a button was pressed")
    function _()
      session = newStillWatchingSession(0)
      thresholds = stillWatchingThresholds("default")
      stillWatchingOnAdvance(session, thresholds, m.EPISODE, m.EPISODE)
      stillWatchingOnAdvance(session, thresholds, 2 * m.EPISODE, 2 * m.EPISODE)
      ' Someone pressed a button 5 minutes before the third video ended
      m.assertFalse(stillWatchingOnAdvance(session, thresholds, 300, 3 * m.EPISODE))
      m.assertEqual(session.unattendedCount, 0)
    end function

    ' TimeSinceLastKeypress is whole seconds; UpTime is not. Play pressed at 0.0, the session
    ' started at 0.3, the video ends at 1320.9: the press reads as 1320 (rounded down) or 1321
    ' (rounded up), and either way it is the press that started the video, not one during it.
    @it("counts the first video as unattended whichever way the key-press seconds round")
    function _()
      for each secondsSinceKeypress in [1320, 1321]
        session = newStillWatchingSession(0.3)
        stillWatchingOnAdvance(session, stillWatchingThresholds("default"), secondsSinceKeypress, 1320.9)
        m.assertEqual(session.unattendedCount, 1, secondsSinceKeypress.toStr())
      end for
    end function

    @it("does not ask after one long video, however long")
    function _()
      session = newStillWatchingSession(0)
      ' One 150-minute movie, nothing pressed: past the 90-minute limit, but only one video
      m.assertFalse(stillWatchingOnAdvance(session, stillWatchingThresholds("default"), 150 * 60, 150 * 60))
    end function

    @it("asks on time from the second unattended video when the videos are long")
    function _()
      session = newStillWatchingSession(0)
      thresholds = stillWatchingThresholds("default")
      ' Two 60-minute episodes, nothing pressed: 120 minutes is past the limit, before the count
      m.assertFalse(stillWatchingOnAdvance(session, thresholds, 60 * 60, 60 * 60))
      m.assertTrue(stillWatchingOnAdvance(session, thresholds, 120 * 60, 120 * 60))
    end function

    @it("never asks when off, but still keeps count")
    function _()
      session = newStillWatchingSession(0)
      for i = 1 to 10
        m.assertFalse(stillWatchingOnAdvance(session, invalid, i * m.EPISODE, i * m.EPISODE))
      end for
      m.assertEqual(session.unattendedCount, 10)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("stillWatchingOnActivity()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("starts the count again after activity")
    function _()
      session = newStillWatchingSession(0)
      thresholds = stillWatchingThresholds("default")
      for i = 1 to 3
        stillWatchingOnAdvance(session, thresholds, i * m.EPISODE, i * m.EPISODE)
      end for
      stillWatchingOnActivity(session, 3 * m.EPISODE + 10)
      m.assertEqual(session.unattendedCount, 0)
    end function

    @it("counts activity with no button press (voice, the Jellyfin app) like a press")
    function _()
      session = newStillWatchingSession(0)
      thresholds = stillWatchingThresholds("default")
      for i = 1 to 3
        stillWatchingOnAdvance(session, thresholds, i * m.EPISODE, i * m.EPISODE)
      end for
      ' A voice command 10 s into the fourth video; still no button press since 0
      stillWatchingOnActivity(session, 3 * m.EPISODE + 10)
      ' The fourth video ends: the command, not the old keypress, is the latest activity
      m.assertFalse(stillWatchingOnAdvance(session, thresholds, 4 * m.EPISODE, 4 * m.EPISODE))
      m.assertEqual(session.unattendedCount, 0)
    end function

  end class

end namespace
