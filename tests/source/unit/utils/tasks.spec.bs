import "pkg:/source/utils/tasks.bs"

namespace tests

  ' Covers the accounted launch chokepoint and the ledger arithmetic behind the
  ' derived thread count (epic #728, Phase 1).
  '
  ' `launchTask()` records into `m.global.taskLedger` in EVERY build, so the ceiling
  ' tests below drive the real thing rather than the arithmetic alone. Only the
  ' `printTaskThreads()` readout is still `#if debug`, and test builds compile against
  ' the same `manifest` (`bs_const=debug=false`), so that one is unreachable here —
  ' which is why the arithmetic lives outside the gate and takes its store as a
  ' parameter.
  '
  ' ⚠️ These tests write the SHARED global node. Every one that seeds the ledger must
  ' reset it to depth 0 before it returns, or the next test inherits the seed.
  '
  ' `ServerReachableTask` is the fixture because its `init()` only sets
  ' `functionName` — creating one starts no thread and touches no server.
  @suite("tasks.bs - launchTask() + the derived thread ledger")
  class TaskLedgerTests extends tests.BaseTestSuite

    protected override function setup()
      super.setup()
    end function

    ' Seeds `m.global`'s ledger `depth` entries deep from never-launched Task nodes,
    ' and leaves it that way — the suite shares the real global node, so every test
    ' that seeds it must also reset it (depth 0) rather than leak into the next one.
    protected function seedGlobalLedger(depth as integer) as void
      if not m.global.hasField("taskLedger") then m.global.addField("taskLedger", "array", false)
      m.global["taskLedger"] = m.ledgerOfDepth(depth)
    end function

    ' A ledger `depth` entries deep, built from never-launched Task nodes.
    protected function ledgerOfDepth(depth as integer) as object
      seeded = []
      for i = 1 to depth
        seeded.push(m.freshTask())
      end for
      return seeded
    end function

    ' A Task node that has never been launched. Its thread does not exist yet,
    ' but SceneGraph already reports a state — which is exactly what the
    ' liveness rule has to be correct about.
    protected function freshTask() as object
      return CreateObject("roSGNode", "ServerReachableTask")
    end function

    ' The apparatus floor: the same loop doing the cheapest possible body. Whatever this
    ' reads is measurement overhead present in the timed cell, and it is SUBTRACTED
    ' rather than argued to be negligible.
    protected function benchFloor(iterations as integer) as float
      node = m.freshTask()
      total = 0
      probe = CreateObject("roTimespan")
      probe.mark()
      for i = 1 to iterations
        if isValid(node) then total++
      end for
      return probe.totalMicroseconds() / iterations
    end function

    ' A Task node driven to a terminated state. Session-2 measurement on device
    ' established that `control = "STOP"` lands synchronously, so the state is
    ' readable on the very next line with no polling.
    protected function stoppedTask() as object
      node = m.freshTask()
      launchTask(node)
      node.control = "STOP"
      return node
    end function

    ' A Task driven to a NATURAL end — its function ran and returned, rather than
    ' being stopped. `isServerReachable` returns immediately on an empty baseUrl,
    ' so a short settle is enough; the poll keeps it from being a fixed-sleep race.
    protected function finishedTask() as object
      node = m.freshTask()
      node.baseUrl = ""
      launchTask(node)
      ' Poll on the RAW state, not on taskThreadIsLive() — the assertion under
      ' test is about that function, so gating the wait on it would make a broken
      ' implementation exit the loop instantly and pass trivially. A node fresh
      ' off launchTask can still read "init" for a moment, so both non-terminal
      ' states have to be waited through.
      settle = CreateObject("roTimespan")
      while settle.totalMilliseconds() < 3000
        state = LCase(node.state)
        if state <> "run" and state <> "init" then exit while
        sleep(50)
      end while
      return node
    end function

    ' A Task node whose thread genuinely stays running for the length of a test.
    '
    ' Pointed at RFC 5737 TEST-NET-1, which is unroutable, so the probe's connect
    ' hangs rather than being refused — the same trick session 3 used to force
    ' `apiPipeline`'s budget to expire on device. Without this the probe against
    ' an empty URL returns in microseconds and any assertion about a "running"
    ' task is a race the test loses as soon as it does anything else first.
    protected function runningTask() as object
      node = m.freshTask()
      node.baseUrl = "http://192.0.2.1:8096"
      launchTask(node)
      return node
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("launchTask() — the chokepoint")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    ' Callers guard on the return exactly as the raw `if isValid(x)` launch
    ' sites did, so an invalid node must be a quiet false rather than a crash.
    '
    ' The contract is a Task node or `invalid` — the same one the 99 raw launch
    ' sites had. Handing it a string or a number is a caller bug and crashes on
    ' the field read, exactly as `"".control = "RUN"` did before.
    @it("returns false and starts nothing for an invalid node")
    function _()
      m.assertFalse(launchTask(invalid))
    end function

    @it("starts the thread and reports success for a real Task node")
    function _()
      node = m.freshTask()
      node.baseUrl = "http://192.0.2.1:8096"
      m.assertTrue(launchTask(node))
      m.assertTrue(taskThreadIsLive(node))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("taskThreadIsLive() — the liveness rule")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("is false for an invalid node")
    function _()
      m.assertFalse(taskThreadIsLive(invalid))
    end function

    ' Measured ground truth, recorded here so the liveness rule is not folklore:
    ' a Task node reports "init" from the moment it is created, before anything
    ' has told it to run. That is why only nodes the ledger recorded (i.e. nodes
    ' `launchTask` was called on) are ever passed to the liveness check — a
    ' never-launched node would otherwise be counted as a thread it does not own.
    @it("reports init for a freshly created, never-launched node")
    function _()
      m.assertEqual(LCase(m.freshTask().state), "init")
    end function

    ' Roku's rule is that a terminated thread stops counting toward the cap
    ' "even if the task object itself is still valid". A stopped node is
    ' therefore not a thread, and this is what makes `control = "STOP"` need no
    ' accounting call of its own.
    @it("is false once the task has been stopped")
    function _()
      m.assertFalse(taskThreadIsLive(m.stoppedTask()))
    end function

    @it("is true for a running task")
    function _()
      m.assertTrue(taskThreadIsLive(m.runningTask()))
    end function

    ' The one way the derived count could be silently wrong: `"init"` counts as
    ' live, so if a Task that ran to completion reverted to `"init"` every
    ' finished thread would be counted forever. Device measurement says it
    ' reports `"stop"`; this pins that, because the whole count rests on it.
    @it("is false once the task function has returned on its own")
    function _()
      node = m.finishedTask()
      m.assertNotEqual(LCase(node.state), "init", "a finished task must not report init")
      m.assertFalse(taskThreadIsLive(node))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("countLiveTaskThreads() — the derived count")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("is 0 for an absent or empty ledger")
    @params(invalid)
    @params([])
    function _(ledger)
      m.assertEqual(countLiveTaskThreads(ledger), 0)
    end function

    @it("counts only the entries whose thread is still running")
    function _()
      m.assertEqual(countLiveTaskThreads([m.runningTask(), m.stoppedTask(), m.stoppedTask()]), 1)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("pruneTaskLedger() — bounding the ledger")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("records the launched node when the ledger is absent or empty")
    @params(invalid)
    @params([])
    function _(ledger)
      node = m.freshTask()
      kept = pruneTaskLedger(ledger, node)
      m.assertEqual(kept.count(), 1)
      m.assertTrue(kept[0].isSameNode(node))
    end function

    @it("drops entries whose thread has ended")
    function _()
      node = m.freshTask()
      kept = pruneTaskLedger([m.stoppedTask(), m.stoppedTask()], node)
      m.assertEqual(kept.count(), 1)
      m.assertTrue(kept[0].isSameNode(node))
    end function

    @it("keeps entries that are still running")
    function _()
      m.assertEqual(pruneTaskLedger([m.runningTask()], m.freshTask()).count(), 2)
    end function

    ' A persistent Task node is relaunched over and over — `ExtrasRowList` alone
    ' relaunches its nodes 38 times. Without de-duplication the ledger would
    ' grow one entry per relaunch and over-report the thread count.
    @it("does not record the same node twice when it is relaunched")
    function _()
      node = m.runningTask()
      kept = pruneTaskLedger([node], node)
      m.assertEqual(kept.count(), 1)
      m.assertEqual(countLiveTaskThreads(kept), 1)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("the ceiling — admitTaskLaunch() and its safety bound")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    ' THE BOUND THAT MAKES REFUSAL SAFE RATHER THAN HOPEFUL.
    '
    ' The ledger is a shared field on `m.global`, so every thread's launches land in
    ' it and the count is exact rather than a lower bound. The watermark still has to
    ' leave room under Roku's 100-thread cap for the threads the app does not start
    ' through `launchTask()` at all — the vendored `WebSocketClient` that
    ' `RemoteControlTask` owns is outside both this ledger and the `no-raw-run` rule.
    '
    ' Asserted rather than left in a comment because the failure is silent: raise the
    ' watermark to 95 and everything still passes, still counts, still refuses — and
    ' the app crashes at 100 anyway with the untracked threads on top. A comment does
    ' not fail; this does.
    @it("keeps the watermark far enough below Roku's cap for the unseen main-thread floor")
    function _()
      ROKU_THREAD_CAP = 100
      UNTRACKED_MAX = 20 ' generous bound on threads started outside launchTask()

      m.assertTrue(TASK_THREAD_WATERMARK + UNTRACKED_MAX < ROKU_THREAD_CAP, "watermark " + TASK_THREAD_WATERMARK.toStr() + " + untracked threads leaves no room under Roku's " + ROKU_THREAD_CAP.toStr() + "-thread cap")
      m.assertTrue(TASK_THREAD_WATERMARK > 11, "watermark must sit above the measured real-world peak of 11, or normal use trips it")
    end function

    ' THE FEATURE ITSELF: does it actually refuse?
    '
    ' Depth is built from NEVER-LAUNCHED Task nodes. A fresh node reports
    ' `state = "init"`, which `taskThreadIsLive` counts as live, so a 51-deep ledger
    ' exercises the ceiling while starting ZERO threads — the test cannot provoke the
    ' `&h29` it exists to prevent.
    @it("refuses a launch when the ledger is already well above the watermark")
    function _()
      m.seedGlobalLedger(TASK_THREAD_WATERMARK + 1)

      admitted = launchTask(m.freshTask())

      m.assertFalse(admitted, "a launch at the watermark must be refused")
      m.seedGlobalLedger(0)
    end function

    ' REGRESSION: the first cut of the refusal path left the rejected node IN the
    ' ledger. A never-launched node reports "init" — counted as live, never pruned —
    ' so every refusal permanently raised the count by one and the app ratcheted
    ' itself shut. The refusal is silent in production, so nothing would have
    ' surfaced it; only the count moving proves the node was taken back out.
    @it("does not grow the ledger when it refuses")
    function _()
      m.seedGlobalLedger(TASK_THREAD_WATERMARK + 1)
      before = countLiveTaskThreads(m.global["taskLedger"])

      launchTask(m.freshTask())
      launchTask(m.freshTask())
      launchTask(m.freshTask())

      m.assertEqual(countLiveTaskThreads(m.global["taskLedger"]), before, "three refusals must leave the count exactly where it was")
      m.seedGlobalLedger(0)
    end function

    ' ══ THE BOUNDARY. The one line the whole feature reduces to. ══
    '
    ' `admitTaskLaunch` admits while `candidate.count() <= TASK_THREAD_WATERMARK`, and
    ' `count` is the seeded depth PLUS the node being launched. So the only input that
    ' discriminates the correct comparison from an off-by-one is count == WATERMARK,
    ' reached by seeding WATERMARK - 1.
    '
    ' PROVEN, not assumed: with only the depth-51 test below, mutating `<=` to `<` left
    ' the entire 28-test suite green — a silent change of the effective ceiling from 50
    ' to 49. A control mutation (deleting the refusal path's `pop()`) went red in the
    ' same harness, so the survival was a real gap and not an unapplied edit. This test
    ' is the ONLY one that goes red on that mutation — including the refusal test right
    ' below it, which passes under both spellings.
    @it("admits the launch that lands exactly ON the watermark")
    function _()
      m.seedGlobalLedger(TASK_THREAD_WATERMARK - 1)
      node = m.freshTask()
      ' Unroutable (RFC 5737 TEST-NET-1): this launch is ADMITTED, so it starts a real
      ' thread. The seeded depth starts none — never-launched nodes report "init" — so
      ' the whole test costs exactly one parked thread.
      node.baseUrl = "http://192.0.2.1:8096"

      admitted = launchTask(node)

      m.assertTrue(admitted, "a launch bringing the count to exactly the watermark must be ADMITTED — refusing here means the effective ceiling is one lower than TASK_THREAD_WATERMARK says")
      m.assertEqual(countLiveTaskThreads(m.global["taskLedger"]), TASK_THREAD_WATERMARK)
      node.control = "STOP"
      m.seedGlobalLedger(0)
    end function

    ' The other side of the same line, and the boundary the header prose actually
    ' states ("REFUSES above TASK_THREAD_WATERMARK live threads"). It survives the
    ' `<=`/`<` mutation — both spellings refuse here — so it pins the documented
    ' contract rather than the comparison. Both tests are needed; they do different jobs.
    @it("refuses the launch that would carry the count past the watermark")
    function _()
      m.seedGlobalLedger(TASK_THREAD_WATERMARK)

      admitted = launchTask(m.freshTask())

      m.assertFalse(admitted, "a launch that would take the count above the watermark must be refused")
      m.assertEqual(countLiveTaskThreads(m.global["taskLedger"]), TASK_THREAD_WATERMARK, "a refusal must leave the ledger exactly at the watermark")
      m.seedGlobalLedger(0)
    end function

    @it("admits and records a launch below the watermark")
    function _()
      m.seedGlobalLedger(0)
      node = m.freshTask()
      ' Unroutable (RFC 5737 TEST-NET-1) so the thread parks on connect instead of
      ' reaching a real server.
      node.baseUrl = "http://192.0.2.1:8096"

      admitted = launchTask(node)

      m.assertTrue(admitted, "a launch well below the watermark must be admitted")
      m.assertEqual(countLiveTaskThreads(m.global["taskLedger"]), 1)
      node.control = "STOP"
      m.seedGlobalLedger(0)
    end function

    ' `m` REVERTS TO THE COMPONENT-GLOBAL AA ACROSS A PLAIN FUNCTION CALL, which is
    ' what makes the ceiling reachable from a class at all.
    '
    ' `admitTaskLaunch` resolves the ledger through `m.global`, and inside a
    ' BrighterScript class `m` is the INSTANCE — writing `m.global` in a class body is
    ' a compile error (`cannot-find-name: Cannot find name 'global'`). So a launch from
    ' `MoviePresenter.loadLogo()` looks like it should hit the bootstrap guard, be
    ' admitted WITHOUT being recorded, and silently bypass the watermark.
    '
    ' It does not. `launchTask(node)` is a plain function call rather than a method
    ' call, so `m` inside it is the component-global AA, not the caller's instance.
    ' Verified on device rather than reasoned about — the mechanism is invisible in
    ' review and the failure it would cause is silent (a correct-looking app whose
    ' ledger quietly under-reports).
    '
    ' Kept as a regression guard: this holds because of HOW the chokepoint is invoked.
    ' Making `admitTaskLaunch` a method, or resolving the store from a caller-supplied
    ' `m`, would reintroduce the hole with nothing else to catch it.
    @it("records a launch made from inside a class")
    function _()
      m.seedGlobalLedger(0)

      frame = new tests.ClassFrameLauncher()
      frame.go(m.freshTask())

      m.assertEqual(countLiveTaskThreads(m.global["taskLedger"]), 1, "a launch from a class frame must still reach the shared ledger; m.global is Invalid inside a class, so resolving it must fall back to GetGlobalAA().global")
      m.seedGlobalLedger(0)
    end function

    ' `admitTaskLaunch` reads `.count()` as the live count instead of walking again.
    ' That is only valid because pruning keeps live entries ONLY. If someone makes
    ' pruning retain a finished node, the ceiling silently starts over-counting and
    ' refuses early — with no test failing anywhere near the change.
    @it("leaves a pruned ledger whose count IS its live count")
    function _()
      ledger = [m.runningTask(), m.stoppedTask(), m.runningTask(), m.stoppedTask()]

      pruned = pruneTaskLedger(ledger, invalid)

      m.assertEqual(pruned.count(), countLiveTaskThreads(pruned), "count() must equal the live count for the ceiling's O(1) check to be correct")
      m.assertEqual(pruned.count(), 2)
    end function

    ' The refusal path pops the LAST entry to undo its own record. That is correct
    ' only while pruning appends the recorded node last.
    @it("appends the recorded node last, which is what the refusal path pops")
    function _()
      existing = m.runningTask()
      node = m.freshTask()

      kept = pruneTaskLedger([existing], node)

      m.assertEqual(kept.count(), 2)
      m.assertTrue(kept[kept.count() - 1].isSameNode(node), "the recorded node must be last")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("the platform premise the whole ledger rests on")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    ' A GATE, not a perf test — and the only survivor of what used to be
    ' `taskLedgerCost.spec.bs`. The rest of that file was a benchmark table, now
    ' superseded by the render-thread apparatus in `components/testing/TaskLedgerBench.bs`
    ' and recorded in docs/architecture/threading.md; a printout that asserts nothing does
    ' not belong in a per-PR device suite.
    '
    ' What has to stay is the premise. The entire case for a PRODUCTION-resident ledger is
    ' that a field read on a node the READING thread owns is cheap — every launch pays one,
    ' on the render thread, where `m.global` is local. Measured 2026-08-23: 1.57 us on a
    ' Stick 4K and 0.625 us on an Ultra, against 63-118 us for the same read of a
    ' render-owned node from a Task thread.
    '
    ' 10 us is ~6x the slowest measured value, so this is a tripwire for the COST MODEL
    ' BEING WRONG, not a tight assertion that will flake. If a future Roku OS makes even
    ' same-thread node access expensive, the ledger stops being affordable anywhere — and
    ' this fails loudly instead of the conclusion rotting quietly in a doc.
    @it("keeps a thread-local node field read cheap")
    function _()
      ITERATIONS = 200
      floor = m.benchFloor(ITERATIONS)

      localNode = CreateObject("roSGNode", "Node")
      localNode.id = "premise"

      sink = ""
      probe = CreateObject("roTimespan")
      probe.mark()
      for i = 1 to ITERATIONS
        sink = localNode.id
      end for
      localUs = probe.totalMicroseconds() / ITERATIONS - floor

      ' THE POSTCONDITION, asserted rather than printed. A reading at or below the
      ' apparatus floor is indistinguishable from a loop that never ran, and this branch
      ' has already been bitten twice by exactly that — `GetGlobalAA()` measuring "free"
      ' and `m.global.taskLedger.push()` measuring 58 us while doing nothing. The old
      ' version of this cell printed `(sink len 0)` because it shared one sink across
      ' three reads and the last was legitimately empty.
      m.assertTrue(Len(sink) > 0, "the timed reads did not execute, so the timing below measures nothing")
      m.assertTrue(localUs < 10, "a thread-local node field read cost " + localUs.toStr() + " us; the production-ledger cost model assumes this is cheap")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("recordTaskLaunch() — the ledger's storage")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    ' REGRESSION (#768 review): the ledger field used to be declared at the END of
    ' setGlobalNodes(), after that sub had already started five Task threads. A
    ' write to a field an roSGNode does not have is a SILENT no-op, so all five —
    ' the three ApiTasks, ApiQueueTask and SideEffectTask — vanished, and
    ' printTaskThreads() under-reported by a permanent five on every run. Device
    ' probe at the time: `hasField=false type=Invalid` after all five launches,
    ' then `live=0 tracked=0`. Creating the field on first use is what fixes it,
    ' and this is the test that keeps it fixed.
    @it("creates the ledger field on a store that does not have one yet")
    function _()
      store = CreateObject("roSGNode", "Node")
      node = m.freshTask()

      m.assertFalse(store.hasField("taskLedger"), "precondition: store starts with no ledger field")
      recordTaskLaunch(store, node)

      m.assertTrue(store.hasField("taskLedger"), "the launch must create the field, not write into the void")
      m.assertEqual(store["taskLedger"].count(), 1)
      m.assertTrue(store["taskLedger"][0].isSameNode(node))
    end function

    @it("records into an existing ledger without recreating it")
    function _()
      store = CreateObject("roSGNode", "Node")
      first = m.runningTask()
      second = m.runningTask()

      recordTaskLaunch(store, first)
      recordTaskLaunch(store, second)

      m.assertEqual(store["taskLedger"].count(), 2)
      m.assertEqual(countLiveTaskThreads(store["taskLedger"]), 2)
    end function

    ' A persistent Task node is relaunched many times; the ledger must not grow.
    @it("keeps a relaunched node to a single entry")
    function _()
      store = CreateObject("roSGNode", "Node")
      node = m.runningTask()

      recordTaskLaunch(store, node)
      recordTaskLaunch(store, node)
      recordTaskLaunch(store, node)

      m.assertEqual(store["taskLedger"].count(), 1)
    end function

    @it("drops finished entries as later launches come through")
    function _()
      store = CreateObject("roSGNode", "Node")

      recordTaskLaunch(store, m.stoppedTask())
      recordTaskLaunch(store, m.stoppedTask())
      recordTaskLaunch(store, m.runningTask())

      ' Each call prunes the dead entries recorded before it, so only the two
      ' most recent survive: the live one, plus the stopped one added last (which
      ' was still being appended when it was recorded).
      m.assertEqual(countLiveTaskThreads(store["taskLedger"]), 1)
      m.assertTrue(store["taskLedger"].count() <= 2, "dead entries must not accumulate")
    end function

    @it("is a no-op for an invalid store rather than a crash")
    function _()
      recordTaskLaunch(invalid, m.freshTask())
      m.assertTrue(true, "reaching here without a fault is the assertion")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("SceneGraph round-trip — the ledger's storage assumption")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    ' The whole derived-count design rests on this: an `array` field must hand
    ' back usable node REFERENCES, not copies or husks. If a round-trip lost
    ' identity or the live `state`, the ledger would silently report nonsense
    ' and the debug readout would be worse than having none.
    @it("preserves node identity and live state through an array field")
    function _()
      running = m.runningTask()
      stopped = m.stoppedTask()

      holder = CreateObject("roSGNode", "Node")
      holder.addField("taskLedger", "array", false)
      ' Bracket access: a dynamically-added field is invisible to the typed
      ' `roSGNodeNode` interface, so dotted access is a compile error.
      holder["taskLedger"] = [running, stopped]

      readBack = holder["taskLedger"]
      m.assertEqual(readBack.count(), 2)
      m.assertTrue(readBack[0].isSameNode(running))
      m.assertTrue(readBack[1].isSameNode(stopped))
      m.assertEqual(countLiveTaskThreads(readBack), 1)
    end function

    ' The ledger actually lives on `m.global`, which is shared across threads —
    ' a stronger case than a plain node, and the one the shell depends on.
    @it("preserves node identity and live state through an m.global array field")
    function _()
      running = m.runningTask()

      if not isValid(m.global.taskLedgerProbe)
        m.global.addField("taskLedgerProbe", "array", false)
      end if
      m.global.taskLedgerProbe = [running, m.stoppedTask()]

      readBack = m.global.taskLedgerProbe
      m.assertEqual(readBack.count(), 2)
      m.assertTrue(readBack[0].isSameNode(running))
      m.assertEqual(countLiveTaskThreads(readBack), 1)
    end function

  end class


  ' Stands in for `MoviePresenter.loadLogo()` — a launch made from inside a class, where
  ' `m` is the instance and `m.global` is therefore not the global node.
  class ClassFrameLauncher
    public function go(node as object) as boolean
      return launchTask(node)
    end function
  end class

end namespace
