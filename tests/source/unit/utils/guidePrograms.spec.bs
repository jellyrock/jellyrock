import "pkg:/source/utils/guidePrograms.bs"

namespace tests

  @suite("guidePrograms - which TV guide program blocks to hold, fetch and drop")
  class GuideProgramsTests extends tests.BaseTestSuite

    protected override function setup()
      super.setup()
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("blockOf() / blockRows()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("puts BLOCK_SIZE consecutive rows in each block")
    function _()
      m.assertEqual(guidePrograms.blockOf(0), 0)
      m.assertEqual(guidePrograms.blockOf(24), 0)
      m.assertEqual(guidePrograms.blockOf(25), 1)
      m.assertEqual(guidePrograms.blockRows(1, 393), [25, 49])
    end function

    @it("ends the last block at the last row")
    function _()
      m.assertEqual(guidePrograms.blockRows(15, 393), [375, 392])
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("wantedBlocks()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("lists the focused block first, then alternately below and above it")
    function _()
      ' Rows 24..80 are near row 49 (6 visible + 25 either side): blocks 0..3.
      m.assertEqual(guidePrograms.wantedBlocks(49, 6, 2000, true), [1, 2, 0, 3])
    end function

    @it("clamps at the top of the guide")
    function _()
      m.assertEqual(guidePrograms.wantedBlocks(0, 6, 2000, true), [0, 1])
    end function

    @it("leaves out a block whose rows have not all arrived while channels still page in")
    function _()
      ' 60 rows so far: block 2 (rows 50..74) is partial and more rows are coming.
      m.assertEqual(guidePrograms.wantedBlocks(40, 6, 60, false), [1, 0])
    end function

    @it("includes the short last block once every row has arrived")
    function _()
      m.assertEqual(guidePrograms.wantedBlocks(40, 6, 60, true), [1, 2, 0])
    end function

    @it("wants nothing when the guide has no rows or the focus is outside it")
    function _()
      m.assertEqual(guidePrograms.wantedBlocks(0, 6, 0, true), [])
      m.assertEqual(guidePrograms.wantedBlocks(100, 6, 50, true), [])
    end function

    @it("tells whether a block is among the wanted ones")
    function _()
      m.assertTrue(guidePrograms.isWanted(2, [1, 2, 0]))
      m.assertFalse(guidePrograms.isWanted(5, [1, 2, 0]))
      m.assertFalse(guidePrograms.isWanted(0, []))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("nextFetch()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("fully loads the first wanted block that holds nothing")
    function _()
      fetch = guidePrograms.nextFetch([1, 2, 0], { "1": 5000 }, 5000, {}, 0)
      m.assertEqual(fetch, { block: 2, extendFrom: 0 })
    end function

    @it("extends a block from the time it already holds programs through")
    function _()
      fetch = guidePrograms.nextFetch([1, 2], { "1": 3000, "2": 5000 }, 5000, {}, 0)
      m.assertEqual(fetch, { block: 1, extendFrom: 3000 })
    end function

    @it("fully reloads a stale block, which the load replaces")
    function _()
      fetch = guidePrograms.nextFetch([1, 2], { "1": 0, "2": 5000 }, 5000, {}, 0)
      m.assertEqual(fetch, { block: 1, extendFrom: 0 })
    end function

    @it("fetches nothing once every wanted block is current")
    function _()
      m.assertInvalid(guidePrograms.nextFetch([1, 2], { "1": 5000, "2": 9000 }, 5000, {}, 0))
      m.assertInvalid(guidePrograms.nextFetch([], {}, 5000, {}, 0))
    end function

    @it("passes over a block waiting to retry, and fetches it once its retry time comes")
    function _()
      failures = { "1": { attempts: 1, retryAt: 2000 } }
      m.assertEqual(guidePrograms.nextFetch([1, 2], {}, 5000, failures, 1999), { block: 2, extendFrom: 0 })
      m.assertInvalid(guidePrograms.nextFetch([1], {}, 5000, failures, 1999))
      m.assertEqual(guidePrograms.nextFetch([1, 2], {}, 5000, failures, 2000), { block: 1, extendFrom: 0 })
    end function

    @it("retries a failed extension as an extension")
    function _()
      failures = { "1": { attempts: 2, retryAt: 2000 } }
      m.assertEqual(guidePrograms.nextFetch([1], { "1": 3000 }, 5000, failures, 2500), { block: 1, extendFrom: 3000 })
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("nextRetryAt()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("is the earliest retry time among wanted blocks still to load")
    function _()
      failures = { "1": { attempts: 3, retryAt: 9000 }, "2": { attempts: 1, retryAt: 4000 } }
      m.assertEqual(guidePrograms.nextRetryAt([1, 2], {}, 5000, failures), 4000)
    end function

    @it("ignores a failed block that is not wanted, or has loaded since")
    function _()
      failures = { "1": { attempts: 1, retryAt: 4000 }, "7": { attempts: 1, retryAt: 1000 } }
      m.assertEqual(guidePrograms.nextRetryAt([1, 2], {}, 5000, failures), 4000)
      m.assertInvalid(guidePrograms.nextRetryAt([1, 2], { "1": 5000 }, 5000, failures))
    end function

    @it("is invalid when nothing is waiting")
    function _()
      m.assertInvalid(guidePrograms.nextRetryAt([1, 2], {}, 5000, {}))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("pruneFailures()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("keeps only the wanted blocks' failures, leaving its argument untouched")
    function _()
      failures = { "1": { attempts: 4, retryAt: 9000 }, "7": { attempts: 2, retryAt: 3000 } }
      m.assertEqual(guidePrograms.pruneFailures(failures, [1, 2]), { "1": { attempts: 4, retryAt: 9000 } })
      m.assertEqual(failures.count(), 2)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("evictions()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("drops nothing while at most CAP blocks hold programs")
    function _()
      held = {}
      for i = 0 to guidePrograms.CAP - 1
        held[i.toStr()] = 5000
      end for
      m.assertEqual(guidePrograms.evictions(held, [0], 0, guidePrograms.CAP), [])
    end function

    @it("drops the blocks farthest from the focus")
    function _()
      ' Eight blocks held, focus in block 10; blocks 9 and 11 wanted.
      held = { "2": 1, "5": 1, "8": 1, "9": 1, "10": 1, "11": 1, "14": 1, "30": 1 }
      dropped = guidePrograms.evictions(held, [10, 11, 9], 250, 6)
      m.assertEqual(dropped, [30, 2])
    end function

    @it("never drops a wanted block, even when that leaves more than the cap")
    function _()
      ' The farthest held block (12) is wanted; only the unwanted one may go.
      held = { "7": 1, "10": 1, "11": 1, "12": 1 }
      dropped = guidePrograms.evictions(held, [10, 11, 12], 250, 1)
      m.assertEqual(dropped, [7])
    end function

    @it("counts a stale block toward the cap")
    function _()
      held = { "0": 0, "1": 1, "2": 1, "3": 1, "4": 1, "5": 1, "6": 1 }
      m.assertEqual(guidePrograms.evictions(held, [6], 150, 6), [0])
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("spanState()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("is loaded only when every block of the span holds programs through the horizon")
    function _()
      held = { "0": 5000, "1": 5000, "2": 0, "3": 3000 }
      m.assertEqual(guidePrograms.spanState(10, 40, held, {}, 5000), GuideSpanState.LOADED)
      m.assertEqual(guidePrograms.spanState(40, 60, held, {}, 5000), GuideSpanState.LOADING, "block 2 is stale")
      m.assertEqual(guidePrograms.spanState(80, 90, held, {}, 5000), GuideSpanState.LOADING, "block 3 holds programs only up to an earlier horizon")
      m.assertEqual(guidePrograms.spanState(100, 110, held, {}, 5000), GuideSpanState.LOADING, "block 4 holds nothing")
    end function

    @it("is failed when a block of the span failed, even beside one still loading")
    function _()
      failures = { "3": { attempts: 1, retryAt: 9000 } }
      m.assertEqual(guidePrograms.spanState(70, 80, {}, failures, 5000), GuideSpanState.FAILED)
      m.assertEqual(guidePrograms.spanState(40, 80, { "1": 5000 }, failures, 5000), GuideSpanState.FAILED)
    end function

    @it("is loaded for a failed block that has loaded since")
    function _()
      m.assertEqual(guidePrograms.spanState(0, 10, { "0": 5000 }, { "0": { attempts: 1, retryAt: 9000 } }, 5000), GuideSpanState.LOADED)
    end function

    @it("is loaded for an empty span")
    function _()
      m.assertEqual(guidePrograms.spanState(-1, 5, {}, {}, 5000), GuideSpanState.LOADED)
      m.assertEqual(guidePrograms.spanState(6, 5, {}, {}, 5000), GuideSpanState.LOADED)
    end function

  end class

end namespace
