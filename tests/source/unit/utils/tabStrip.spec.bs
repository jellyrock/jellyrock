namespace tests

  ' tabStrip.window: the active tab first with the previous one peeking, clamped so the
  ' strip never scrolls past its last tab. Eight tabs 150 wide, 9 apart: 1263 in all,
  ' tab i starting at 159 * i.
  @suite("tabStrip.window - where a scrolling tab strip sits in its slot")
  class TabStripTests extends tests.BaseTestSuite

    private function eight() as object
      return [150, 150, 150, 150, 150, 150, 150, 150]
    end function

    private function assertWindow(win as object, offset as integer, cutLeft as integer, cutRight as integer, message as string)
      got = win.offset.toStr() + " " + win.cutLeft.toStr() + " " + win.cutRight.toStr()
      m.assertEqual(got, offset.toStr() + " " + cutLeft.toStr() + " " + cutRight.toStr(), message)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("every tab fits")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("never moves, whichever tab is active")
    function _()
      for active = 0 to 7
        m.assertWindow(tabStrip.window(m.eight(), 9, 1263, active, 48), 0, -1, -1, "active " + active.toStr())
      end for
    end function

    @it("never moves in a slot wider than the strip")
    function _()
      m.assertWindow(tabStrip.window(m.eight(), 9, 1500, 7, 48), 0, -1, -1, "last tab active")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("the strip overflows its slot")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("stays at the start for the first tab, with no peek")
    function _()
      ' The slot ends at 600, inside tab 3 (477 to 627)
      m.assertWindow(tabStrip.window(m.eight(), 9, 600, 0, 48), 0, -1, 3, "first tab active")
    end function

    @it("puts a middle tab first with the previous one peeking")
    function _()
      ' Tab 3 starts at 477: the offset is 429, inside tab 2 (318 to 468). The slot ends at
      ' 1029, inside tab 6 (954 to 1104)
      m.assertWindow(tabStrip.window(m.eight(), 9, 600, 3, 48), 429, 2, 6, "tab 3 active")
    end function

    @it("stops at the strip's end for the last tab, leaving no empty space")
    function _()
      ' 1263 - 600 = 663, inside tab 4 (636 to 786); the strip's end is the slot's end
      m.assertWindow(tabStrip.window(m.eight(), 9, 600, 7, 48), 663, 4, -1, "last tab active")
    end function

    @it("stops at the strip's end for any tab that would scroll past it")
    function _()
      m.assertEqual(tabStrip.window(m.eight(), 9, 600, 5, 48).offset, 663)
      m.assertEqual(tabStrip.window(m.eight(), 9, 600, 6, 48).offset, 663)
    end function

    @it("moves by less than a tab when the strip overflows by less than one")
    function _()
      ' 1263 in a slot of 1200: 63 is as far as it can go
      m.assertWindow(tabStrip.window(m.eight(), 9, 1200, 1, 48), 63, 0, -1, "tab 1 active")
      m.assertWindow(tabStrip.window(m.eight(), 9, 1200, 7, 48), 63, 0, -1, "last tab active")
    end function

    @it("gives one position per active tab, whichever way it is reached")
    function _()
      right = []
      walked = ""
      for active = 0 to 7
        right.push(tabStrip.window(m.eight(), 9, 600, active, 48).offset)
        walked += " " + right[active].toStr()
      end for
      for active = 7 to 0 step -1
        m.assertEqual(tabStrip.window(m.eight(), 9, 600, active, 48).offset, right[active], "active " + active.toStr())
      end for
      m.assertEqual(walked, " 0 111 270 429 588 663 663 663")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("the tabs an edge cuts")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("reports none for an edge that falls in the gap between two tabs")
    function _()
      ' The slot ends at 315, in the gap between tab 1 (ends 309) and tab 2 (starts 318)
      m.assertWindow(tabStrip.window(m.eight(), 9, 315, 0, 48), 0, -1, -1, "edge in a gap")
    end function

    @it("reports none for an edge that lands exactly on a tab's edge")
    function _()
      m.assertWindow(tabStrip.window(m.eight(), 9, 309, 0, 48), 0, -1, -1, "edge on a tab's end")
    end function

    @it("never reports the active tab, even one wider than the slot")
    function _()
      win = tabStrip.window([150, 900, 150], 9, 600, 1, 48)
      m.assertWindow(win, 111, 0, -1, "wide tab active")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("inputs it cannot place")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("returns the start for no tabs, no slot, or an index out of range")
    function _()
      m.assertWindow(tabStrip.window([], 9, 600, 0, 48), 0, -1, -1, "no tabs")
      m.assertWindow(tabStrip.window(m.eight(), 9, 0, 3, 48), 0, -1, -1, "no slot")
      m.assertEqual(tabStrip.window(m.eight(), 9, 600, -1, 48).offset, 0, "index below range")
      m.assertEqual(tabStrip.window(m.eight(), 9, 600, 8, 48).offset, 0, "index above range")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("the 3 px grid")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("keeps every offset on the grid for widths, gap, slot and peek on it")
    function _()
      widths = [201, 153, 300, 99, 246, 180, 222, 129]
      for active = 0 to 7
        offset = tabStrip.window(widths, overhangRow.TAB_SPACING, 600, active, tabStrip.PEEK_WIDTH).offset
        m.assertEqual(offset mod 3, 0, "active " + active.toStr() + " offset " + offset.toStr())
      end for
    end function

    @it("has its peek on the grid")
    function _()
      m.assertEqual(tabStrip.PEEK_WIDTH mod 3, 0)
    end function

  end class

end namespace
