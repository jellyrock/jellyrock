import "pkg:/source/utils/liveTv.bs"

namespace tests

  ' shouldDirectPlayUpstreamHls — play a Live TV channel's own HLS URL when the server declines to.
  '
  ' Jellyfin 12.0 (PR #17768) stopped offering direct play for any M3U channel whose URL is an HLS
  ' manifest, because the server was proxying the upstream master playlist through /Videos/{id}/,
  ' where its relative variant URIs 404. JellyRock never took that path: it plays the absolute
  ' upstream Path, where relative URIs resolve against the origin. What the server gives instead
  ' is a remux, which drops a separately-delivered audio rendition. These cases pin exactly when
  ' playing the upstream URL is the right call.
  @suite("liveTv - shouldDirectPlayUpstreamHls()")
  class ShouldDirectPlayUpstreamHlsTests extends tests.BaseTestSuite

    ' A 12.x response for an M3U HLS channel: the server declined direct play, but the upstream
    ' URL is still in Path.
    private function declined(overrides = {} as object) as object
      source = {
        SupportsDirectPlay: false,
        Protocol: "Http",
        Container: "hls",
        Path: "https://cdn.example.com/stitch/hls/channel/abc/master.m3u8?jwt=token"
      }
      source.append(overrides)
      return source
    end function

    private function serverUrl() as string
      return "https://jellyfin.example.com"
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("an upstream HLS channel the server declined to direct play")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("plays it directly")
    function _()
      m.assertTrue(shouldDirectPlayUpstreamHls(m.declined(), m.serverUrl()))
    end function

    @it("plays a LAN source directly, even on the Jellyfin host, when the port differs")
    ' A tuner such as tvheadend on the same box as Jellyfin: same host, different port.
    function _()
      source = m.declined({ Path: "http://192.168.1.3:8190/separate/master.m3u8" })
      m.assertTrue(shouldDirectPlayUpstreamHls(source, "http://192.168.1.3:8096"))
    end function

    @it("reads the extension from the URL path, so a query string cannot hide it")
    function _()
      source = m.declined({ Container: "", Path: "https://cdn.example.com/live/index.m3u8?token=abc.ts" })
      m.assertTrue(shouldDirectPlayUpstreamHls(source, m.serverUrl()))
    end function

    @it("accepts a plain .m3u playlist path when the container is not reported")
    function _()
      source = m.declined({ Container: "", Path: "http://iptv.example.com/channel/5.m3u" })
      m.assertTrue(shouldDirectPlayUpstreamHls(source, m.serverUrl()))
    end function

    @it("accepts ffmpeg's older 'applehttp' name for HLS")
    function _()
      source = m.declined({ Container: "applehttp", Path: "https://cdn.example.com/live/stream" })
      m.assertTrue(shouldDirectPlayUpstreamHls(source, m.serverUrl()))
    end function

    @it("ignores case in the protocol, container and URL")
    function _()
      source = m.declined({ Protocol: "HTTP", Container: "HLS", Path: "HTTPS://CDN.EXAMPLE.COM/LIVE/MASTER.M3U8" })
      m.assertTrue(shouldDirectPlayUpstreamHls(source, m.serverUrl()))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("what the server already allows, or never declined")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("leaves a channel the server will direct play alone")
    ' Every 10.11 server: nothing to override.
    function _()
      m.assertFalse(shouldDirectPlayUpstreamHls(m.declined({ SupportsDirectPlay: true }), m.serverUrl()))
    end function

    @it("does nothing when the server did not say either way")
    function _()
      source = m.declined()
      source.Delete("SupportsDirectPlay")
      m.assertFalse(shouldDirectPlayUpstreamHls(source, m.serverUrl()))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("streams that go through Jellyfin itself")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("declines a URL on the server's own host and port")
    ' That is the relay PR #17768 was fixing, where relative URIs really do break.
    function _()
      source = m.declined({ Path: "https://jellyfin.example.com/videos/abc/master.m3u8" })
      m.assertFalse(shouldDirectPlayUpstreamHls(source, m.serverUrl()))
    end function

    @it("treats an absent port as the scheme's default when comparing with the server")
    function _()
      source = m.declined({ Path: "https://jellyfin.example.com:443/videos/abc/master.m3u8" })
      m.assertFalse(shouldDirectPlayUpstreamHls(source, m.serverUrl()))
    end function

    @it("declines the LiveStreamFiles relay whatever host it names")
    ' 12.x rewrites relay paths to the request's host, which need not match the saved server URL.
    function _()
      source = m.declined({ Path: "https://other.example.com/LiveTv/LiveStreamFiles/abc/stream.m3u8" })
      m.assertFalse(shouldDirectPlayUpstreamHls(source, m.serverUrl()))
    end function

    @it("declines a loopback host")
    function _()
      m.assertFalse(shouldDirectPlayUpstreamHls(m.declined({ Path: "http://localhost:8096/x/master.m3u8" }), m.serverUrl()))
      m.assertFalse(shouldDirectPlayUpstreamHls(m.declined({ Path: "http://127.0.0.1:8096/x/master.m3u8" }), m.serverUrl()))
      m.assertFalse(shouldDirectPlayUpstreamHls(m.declined({ Path: "http://[::1]:8096/x/master.m3u8" }), m.serverUrl()))
    end function

    @it("declines when the server URL cannot be read, rather than guessing")
    function _()
      m.assertFalse(shouldDirectPlayUpstreamHls(m.declined(), ""))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("sources that are not an absolute HLS URL")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("declines a relative path")
    function _()
      m.assertFalse(shouldDirectPlayUpstreamHls(m.declined({ Path: "/LiveTv/abc/master.m3u8" }), m.serverUrl()))
    end function

    @it("declines an empty or missing path")
    function _()
      m.assertFalse(shouldDirectPlayUpstreamHls(m.declined({ Path: "" }), m.serverUrl()))
      source = m.declined()
      source.Delete("Path")
      m.assertFalse(shouldDirectPlayUpstreamHls(source, m.serverUrl()))
    end function

    @it("declines a non-HTTP scheme")
    function _()
      m.assertFalse(shouldDirectPlayUpstreamHls(m.declined({ Path: "rtsp://camera.example.com/live.m3u8" }), m.serverUrl()))
    end function

    @it("declines a file source, even one whose Path looks like an upstream URL")
    ' The loader builds a Jellyfin stream URL for a File source and never plays its Path.
    function _()
      m.assertFalse(shouldDirectPlayUpstreamHls(m.declined({ Protocol: "File" }), m.serverUrl()))
    end function

    @it("declines MPEG-TS")
    ' Not a manifest, so 12.x never declined it for that reason; the server's answer stands.
    function _()
      m.assertFalse(shouldDirectPlayUpstreamHls(m.declined({ Container: "ts", Path: "http://tuner.example.com/auto/v5.1" }), m.serverUrl()))
    end function

    @it("declines DASH")
    ' Out of scope: the live path hard-codes StreamFormat=hls and there is no DASH source to test.
    function _()
      m.assertFalse(shouldDirectPlayUpstreamHls(m.declined({ Container: "dash", Path: "https://cdn.example.com/live/manifest.mpd" }), m.serverUrl()))
    end function

    @it("declines an invalid media source")
    function _()
      m.assertFalse(shouldDirectPlayUpstreamHls(invalid, m.serverUrl()))
    end function

  end class

end namespace
