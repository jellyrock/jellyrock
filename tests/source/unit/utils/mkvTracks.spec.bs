import "pkg:/source/utils/mkvTracks.bs"

namespace tests

  @suite("mkvTracks.bs - mkvTrackEntries()")
  class MkvTracksTests extends tests.BaseTestSuite

    private function fromHex(hex as string) as object
      bytes = createObject("roByteArray")
      bytes.fromHexString(hex)
      return bytes
    end function

    private function entriesFrom(hex as string) as dynamic
      return mkvTrackEntries(m.fromHex(hex))
    end function

    @describe("mkvTrackEntries()")

    @it("three tracks numbered in file order")
    function _()
      hex = ""
      m.assertEqual(m.entriesFrom(hex), [{ number: 1, type: 1 }, { number: 2, type: 2 }, { number: 3, type: 2 }])
    end function

    @it("track numbers stored out of file order")
    function _()
      hex = ""
      m.assertEqual(m.entriesFrom(hex), [{ number: 1, type: 1 }, { number: 4, type: 2 }, { number: 2, type: 2 }, { number: 3, type: 2 }])
    end function

    @it("out-of-order numbers across six tracks")
    function _()
      hex = ""
      m.assertEqual(m.entriesFrom(hex), [{ number: 1, type: 1 }, { number: 2, type: 2 }, { number: 5, type: 2 }, { number: 3, type: 2 }, { number: 4, type: 2 }, { number: 6, type: 2 }])
    end function

    @it("out-of-order numbers across five tracks")
    function _()
      hex = ""
      m.assertEqual(m.entriesFrom(hex), [{ number: 1, type: 1 }, { number: 2, type: 2 }, { number: 5, type: 2 }, { number: 3, type: 2 }, { number: 4, type: 2 }])
    end function

    @it("a subtitle track between two audio tracks numbered out of order")
    function _()
      hex = ""
      m.assertEqual(m.entriesFrom(hex), [{ number: 1, type: 1 }, { number: 5, type: 17 }, { number: 2, type: 2 }, { number: 3, type: 17 }, { number: 4, type: 2 }])
    end function

    @it("returns the stored number for a TrackEntry that has a TrackNumber")
    function _()
      ' EBML header, Segment of unknown size, Tracks holding one TrackEntry: TrackNumber 5
      m.assertEqual(m.entriesFrom("1A45DFA38018538067FF1654AE6B85AE83D78105"), [{ number: 5, type: invalid }])
    end function

    @it("keeps a TrackType stored after the TrackNumber")
    function _()
      ' One TrackEntry: TrackNumber 5 (0xD7), then TrackType 2 (0x83)
      m.assertEqual(m.entriesFrom("1A45DFA38018538067FF1654AE6B88AE86D78105838102"), [{ number: 5, type: 2 }])
    end function

    @it("returns invalid when a TrackEntry has no TrackNumber")
    function _()
      ' The same file, but the only TrackEntry holds a TrackType (0x83) and no TrackNumber (0xD7)
      m.assertInvalid(m.entriesFrom("1A45DFA38018538067FF1654AE6B85AE83838101"))
    end function

    @it("returns invalid when the buffer ends partway through Tracks")
    function _()
      hex = ""
      cut = left(hex, len(hex) - 60)
      m.assertInvalid(m.entriesFrom(cut))
    end function

    @it("returns invalid for an empty buffer")
    function _()
      m.assertInvalid(mkvTrackEntries(createObject("roByteArray")))
    end function

    @it("returns invalid for bytes that are not EBML")
    function _()
      m.assertInvalid(m.entriesFrom("89504E470D0A1A0A0000000D49484452"))
    end function

    @describe("shouldReadMkvTracks()")

    @it("reads an MKV file source")
    function _()
      m.assertTrue(shouldReadMkvTracks({ Protocol: "File", Container: "mkv" }, false, false))
    end function

    @it("reads a source whose Container lists mkv among several names")
    function _()
      m.assertTrue(shouldReadMkvTracks({ Protocol: "file", Container: "MKV,webm" }, false, false))
    end function

    @it("does not read an mp4 source")
    function _()
      m.assertFalse(shouldReadMkvTracks({ Protocol: "File", Container: "mp4" }, false, false))
    end function

    @it("does not read a live item")
    function _()
      m.assertFalse(shouldReadMkvTracks({ Protocol: "File", Container: "mkv" }, true, false))
    end function

    @it("does not read for a forced transcode, which never direct plays")
    function _()
      m.assertFalse(shouldReadMkvTracks({ Protocol: "File", Container: "mkv" }, false, true))
    end function

    @it("does not read a source that is not a file")
    function _()
      m.assertFalse(shouldReadMkvTracks({ Protocol: "Http", Container: "mkv" }, false, false))
    end function

    @it("does not read a source with no Container")
    function _()
      m.assertFalse(shouldReadMkvTracks({ Protocol: "File" }, false, false))
    end function

    @it("does not read when there is no source")
    function _()
      m.assertFalse(shouldReadMkvTracks(invalid, false, false))
    end function

  end class
end namespace
