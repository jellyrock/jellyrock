import "pkg:/source/remotecontrol/remoteCommand.bs"
import "pkg:/source/syncplay/syncPlayOffset.bs"
import "pkg:/source/syncplay/syncPlayPlayback.bs"

namespace tests

  ' Position arithmetic against a fixed device clock and a fixed offset: the device reads
  ' 1000 ms behind the server (offset +1000), as one round of the recorded Stick 4K rounds gives.
  @suite("syncPlayPlayback - where a load starts and where the group is")
  class SyncPlayPlaybackTests extends tests.BaseTestSuite

    ' Device clock "now": 2026-10-23T20:47:30.000Z minus the 1000 ms offset.
    private deviceNow = 1792788449000&
    private serverNow = 1792788450000&

    private function estimator() as object
      est = syncPlayOffset.newEstimator()
      ' Server stamps 1000 ms ahead of the device, 10 ms round trip.
      syncPlayOffset.addRound(est, 1000&, 2005&, 2005&, 1010&)
      return est
    end function

    private function command(name as string, whenText as string, positionTicks as dynamic) as object
      data = { GroupId: "g-1", PlaylistItemId: "p-1", When: whenText, Command: name, PositionTicks: positionTicks, EmittedAt: "2026-10-23T20:47:29.000Z" }
      return remoteCommand.parseMessage({ MessageType: "SyncPlayCommand", Data: data })
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("startPositionTicks()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("takes the update's start when no newer Unpause exists")
    function _()
      update = { lastUpdateMs: 1792788449500&, startPositionTicks: 300000000& }
      m.assertEqual(syncPlayPlayback.startPositionTicks(update, invalid, m.estimator(), m.deviceNow), 300000000&)
    end function

    @it("takes the update's start when the last Unpause is older than the update")
    function _()
      update = { lastUpdateMs: 1792788449500&, startPositionTicks: 300000000& }
      older = m.command("Unpause", "2026-10-23T20:47:28.000Z", 600000000&)
      m.assertEqual(syncPlayPlayback.startPositionTicks(update, older, m.estimator(), m.deviceNow), 300000000&)
    end function

    @it("estimates forward from an Unpause newer than the update")
    function _()
      update = { lastUpdateMs: 1792788440000&, startPositionTicks: 300000000& }
      newer = m.command("Unpause", "2026-10-23T20:47:28.000Z", 600000000&)
      m.assertEqual(syncPlayPlayback.startPositionTicks(update, newer, m.estimator(), m.deviceNow), 620000000&)
    end function

    @it("takes a newer Pause or Seek at its own position: the group stands there")
    function _()
      update = { lastUpdateMs: 1792788440000&, startPositionTicks: 300000000& }
      paused = m.command("Pause", "2026-10-23T20:47:28.000Z", 600000000&)
      m.assertEqual(syncPlayPlayback.startPositionTicks(update, paused, m.estimator(), m.deviceNow), 600000000&)
      sought = m.command("Seek", "2026-10-23T20:47:28.000Z", 700000000&)
      m.assertEqual(syncPlayPlayback.startPositionTicks(update, sought, m.estimator(), m.deviceNow), 700000000&)
      ' A Stop says nothing about a position: the update's start stands.
      stopped = m.command("Stop", "2026-10-23T20:47:28.000Z", 0&)
      m.assertEqual(syncPlayPlayback.startPositionTicks(update, stopped, m.estimator(), m.deviceNow), 300000000&)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("where the group is, and where a load starts")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    ' An Unpause at 60 s whose When is 10 s before the device "now" on the server's clock.
    private function unpauseInForce() as object
      return m.command("Unpause", "2026-10-23T20:47:20.000Z", 600000000)
    end function

    @it("groupPositionTicks runs an Unpause forward on the server clock")
    function _()
      ' The Unpause put the group at 60 s ten seconds ago.
      unpause = m.unpauseInForce()
      m.assertEqual(syncPlayPlayback.groupPositionTicks(unpause, m.estimator(), m.deviceNow), 700000000&)
    end function

    @it("groupPositionTicks holds a Pause's or a Seek's position, and an Unpause's until its When")
    function _()
      pause = m.command("Pause", "2026-10-23T20:47:20.000Z", 600000000)
      m.assertEqual(syncPlayPlayback.groupPositionTicks(pause, m.estimator(), m.deviceNow), 600000000&)
      seek = m.command("Seek", "2026-10-23T20:47:20.000Z", 610000000)
      m.assertEqual(syncPlayPlayback.groupPositionTicks(seek, m.estimator(), m.deviceNow), 610000000&)
      future = m.command("Unpause", "2026-10-23T20:47:31.000Z", 600000000)
      m.assertEqual(syncPlayPlayback.groupPositionTicks(future, m.estimator(), m.deviceNow), 600000000&)
    end function

    @it("groupPositionTicks is invalid with no command, or one that names no position")
    function _()
      m.assertInvalid(syncPlayPlayback.groupPositionTicks(invalid, m.estimator(), m.deviceNow))
      m.assertInvalid(syncPlayPlayback.groupPositionTicks(m.command("Stop", "2026-10-23T20:47:20.000Z", 0), m.estimator(), m.deviceNow))
    end function

    @it("seekPastEnd is true at or past the duration, and false while it is unknown")
    function _()
      m.assertTrue(syncPlayPlayback.seekPastEnd(100000000&, 10.0))
      m.assertTrue(syncPlayPlayback.seekPastEnd(110000000&, 10.0))
      m.assertFalse(syncPlayPlayback.seekPastEnd(90000000&, 10.0))
      m.assertFalse(syncPlayPlayback.seekPastEnd(100000000&, 0))
      m.assertFalse(syncPlayPlayback.seekPastEnd(100000000&, invalid))
    end function

    @it("loadStartsAtItemStart: a load within the ready tolerance of 0 is a restart's, one partway in is not")
    function _()
      m.assertTrue(syncPlayPlayback.loadStartsAtItemStart(0&))
      m.assertTrue(syncPlayPlayback.loadStartsAtItemStart(4000000&), "400 ms: the keyframe before the start")
      m.assertFalse(syncPlayPlayback.loadStartsAtItemStart(6000000&))
      m.assertFalse(syncPlayPlayback.loadStartsAtItemStart(585000000&), "a reload in place at 58.5 s")
    end function

    @it("restartLoadFromStart: the tracker's load once mounted, the launch's before that, and an owed load from the start")
    function _()
      ' A reload in place or a late join's mount: the tracker loads from partway in.
      m.assertFalse(syncPlayPlayback.restartLoadFromStart("loading", 585000000&, true, 0&))
      m.assertTrue(syncPlayPlayback.restartLoadFromStart("loading", 0&, true, 585000000&), "the tracker's start wins once mounted")
      ' A launch between playQueue and its mount: the start the manager gave it.
      m.assertFalse(syncPlayPlayback.restartLoadFromStart("idle", 0&, true, 585000000&))
      m.assertTrue(syncPlayPlayback.restartLoadFromStart("idle", 0&, true, 4000000&), "a launch from the start")
      ' Only owed: it will start where the group is, 0 after a restart.
      m.assertTrue(syncPlayPlayback.restartLoadFromStart("idle", 0&, false, 585000000&))
      m.assertTrue(syncPlayPlayback.restartLoadFromStart("ready", 585000000&, false, 585000000&), "a player past its load is not loading")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("units")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("converts the player's float seconds to ticks and back")
    function _()
      m.assertEqual(syncPlayPlayback.secondsToTicks(124.5), 1245000000&)
      m.assertEqual(syncPlayPlayback.secondsToTicks(invalid), 0&)
      m.assertEqual(syncPlayPlayback.ticksToSeconds(1245000000&), 124.5)
    end function

  end class
end namespace
