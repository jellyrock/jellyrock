import "pkg:/source/syncplay/syncPlayConverge.bs"
import "pkg:/source/syncplay/syncPlayGroup.bs"
import "pkg:/source/syncplay/syncPlayOffset.bs"
import "pkg:/source/syncplay/syncPlayPlayback.bs"
import "pkg:/source/syncplay/syncPlayPlayer.bs"
import "pkg:/source/syncplay/syncPlayTime.bs"

namespace tests

  ' The comparison's table: one case per pairing of what the node is doing and what the group
  ' wants. The device reads 1000 ms behind the server (device 10000 is server 11000). The usual
  ' line is an Unpause at server 6000 (device 5000) from 60 s, so at device 10000 the group is
  ' at 65 s. Positions are ticks: 1 s is 10000000.
  @suite("syncPlayConverge: one action from two models")
  class SyncPlayConvergeTests extends tests.BaseTestSuite

    private at60s = 600000000&
    private at65s = 650000000&
    private at100s = 1000000000&
    private oneMs = 10000&

    private function estimator() as object
      est = syncPlayOffset.newEstimator()
      syncPlayOffset.addRound(est, 1000&, 2005&, 2005&, 1010&)
      return est
    end function

    private function ctx() as object
      return { following: true, estimator: m.estimator(), loadOwed: false, isLastItem: false, durationSeconds: 0 }
    end function

    private function cmd(name as string, whenMs as longinteger, positionTicks as longinteger) as object
      return { kind: "syncplaycommand", command: name, whenMs: whenMs, emittedAtMs: whenMs - 100, positionTicks: positionTicks, playlistItemId: "p-1", groupId: "g-1" }
    end function

    ' A group on item p-1 whose Ready the server has, with one command in force (or none).
    private function groupWith(command as dynamic) as object
      group = syncPlayGroup.newGroup()
      syncPlayGroup.itemChanged(group, "p-1", 1000&)
      syncPlayGroup.requestSent(group, "report", "ready", 2000&)
      syncPlayGroup.requestArrived(group, "report", "ready", group.report.id)
      if isValid(command) then syncPlayGroup.command(group, command)
      return group
    end function

    private function playingLine() as object
      return m.groupWith(m.cmd("Unpause", 6000&, m.at60s))
    end function

    private function pausedGroup() as object
      return m.groupWith(m.cmd("Pause", 9000&, m.at60s))
    end function

    private function seekGroup() as object
      return m.groupWith(m.cmd("Seek", 9000&, m.at100s))
    end function

    ' A node playing, with a reading of `ticks` at `atMs`.
    private function playingAt(ticks as longinteger, atMs as longinteger) as object
      player = syncPlayPlayer.newPlayer()
      syncPlayPlayer.mounted(player, invalid, 100&)
      syncPlayPlayer.nodeState(player, "playing", 900&)
      syncPlayPlayer.reading(player, ticks, atMs)
      return player
    end function

    ' A node paused by `owner`, stopped at `ticks`, landed by 9930.
    private function pausedAt(ticks as longinteger, owner as string) as object
      player = m.playingAt(ticks, 9900&)
      syncPlayPlayer.told(player, "pause", owner, invalid, 9900&)
      syncPlayPlayer.nodeState(player, "paused", 9930&)
      return player
    end function

    ' A group playing along the usual line that this member follows again: its reload was told to
    ' the server, the server stopped the group for it, and `player` has mounted for that load.
    private function waitingOnReload(player as object) as object
      group = m.playingLine()
      syncPlayGroup.followedAgain(group)
      syncPlayPlayer.told(player, "load", "group", m.at65s, 10200&)
      buffering = m.decide(player, group, 10200&)
      syncPlayConverge.applied(player, group, buffering.action, 10200&)
      syncPlayGroup.requestArrived(group, "report", "buffering", group.report.id)
      syncPlayGroup.stateChanged(group, "Playing", "Waiting", m.estimator(), 10300&)
      syncPlayPlayer.mounted(player, m.at65s, 10500&)
      return group
    end function

    ' A load from the item's start, its Buffering arrived, its first frame paused for the wait and
    ' its Ready decided and applied, so the Ready is in flight. Returns the player.
    private function readyInFlight(group as object) as object
      player = syncPlayPlayer.newPlayer()
      syncPlayGroup.itemChanged(group, "p-1", 1000&)
      syncPlayPlayer.mounted(player, 0&, 9000&)
      buffering = m.decide(player, group, 9000&)
      syncPlayConverge.applied(player, group, buffering.action, 9000&)
      syncPlayGroup.requestArrived(group, "report", "buffering", group.report.id)
      syncPlayPlayer.nodeState(player, "playing", 9800&)
      hold = m.decide(player, group, 9800&)
      syncPlayConverge.applied(player, group, hold.action, 9800&)
      syncPlayPlayer.reading(player, 840000&, 9810&)
      syncPlayPlayer.nodeState(player, "paused", 9825&)
      ready = m.decide(player, group, 9825&)
      syncPlayConverge.applied(player, group, ready.action, 9825&)
      return player
    end function

    private function decide(player as object, group as object, nowMs as longinteger) as object
      return syncPlayConverge.decide(player, group, m.ctx(), syncPlayConverge.defaultPolicy(), nowMs)
    end function

    ' The same decision with the playback path known: a direct play, or a transcode.
    private function decideOnPath(player as object, group as object, nowMs as longinteger, isTranscoded as boolean) as object
      ctx = m.ctx()
      ctx.isTranscoded = isTranscoded
      return syncPlayConverge.decide(player, group, ctx, syncPlayConverge.defaultPolicy(), nowMs)
    end function

    ' A node whose seek to 100 s landed at `landTicks`, read at 9610, and plays on.
    private function landedFromSeek(landTicks as longinteger) as object
      player = m.playingAt(m.at60s, 9000&)
      syncPlayPlayer.told(player, "seek", "group", m.at100s, 9100&)
      syncPlayPlayer.nodeState(player, "buffering", 9200&)
      syncPlayPlayer.nodeState(player, "playing", 9600&)
      syncPlayPlayer.reading(player, landTicks, 9610&)
      return player
    end function

    ' A group waiting at 100 s whose one seek there this member has written.
    private function soughtSeekGroup() as object
      group = m.seekGroup()
      group.saidBuffering = true
      first = m.decide(m.playingAt(m.at60s, 9000&), group, 9000&)
      syncPlayConverge.applied(m.playingAt(m.at60s, 9000&), group, first.action, 9000&)
      return group
    end function

    private function kindOf(result as object) as string
      if not isValid(result.action) then return ""
      return result.action.kind
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("a stopped group, a load, a member that does not follow")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("a stopped group stops a player, and asks nothing with none")
    function _()
      group = m.groupWith(m.cmd("Stop", 9000&, 0&))
      m.assertEqual(m.kindOf(m.decide(m.playingAt(m.at60s, 10000&), group, 10000&)), "stop")
      m.assertEqual(m.kindOf(m.decide(syncPlayPlayer.newPlayer(), group, 10000&)), "")
    end function

    @it("a stop is asked once: the player leaves in its own time")
    function _()
      player = m.playingAt(m.at60s, 10000&)
      group = m.groupWith(m.cmd("Stop", 9000&, 0&))
      stopAction = m.decide(player, group, 10000&)
      syncPlayConverge.applied(player, group, stopAction.action, 10000&)
      m.assertEqual(m.kindOf(m.decide(player, group, 10001&)), "")
      syncPlayPlayer.unmounted(player, 10100&)
      m.assertEqual(m.kindOf(m.decide(player, group, 10200&)), "")
    end function

    @it("a load the queue layer owes is performed, whatever the node is doing")
    function _()
      context = m.ctx()
      context.loadOwed = true
      player = m.playingAt(m.at60s, 10000&)
      syncPlayPlayer.told(player, "seek", "group", m.at100s, 10000&)
      result = syncPlayConverge.decide(player, m.pausedGroup(), context, syncPlayConverge.defaultPolicy(), 10000&)
      m.assertEqual(m.kindOf(result), "load")
    end function

    @it("a halted member is written to once: a node a hold or a wait paused is resumed")
    function _()
      context = m.ctx()
      context.following = false
      policy = syncPlayConverge.defaultPolicy()
      held = syncPlayConverge.decide(m.pausedAt(m.at65s, "hold"), m.playingLine(), context, policy, 10000&)
      m.assertEqual(m.kindOf(held), "resume")
      m.assertEqual(held.action.owner, "release")
      m.assertEqual(m.kindOf(syncPlayConverge.decide(m.pausedAt(m.at65s, "wait"), m.playingLine(), context, policy, 10000&)), "resume")
      m.assertEqual(m.kindOf(syncPlayConverge.decide(m.pausedAt(m.at65s, "viewer"), m.playingLine(), context, policy, 10000&)), "")
      m.assertEqual(m.kindOf(syncPlayConverge.decide(m.playingAt(m.at60s, 10000&), m.pausedGroup(), context, policy, 10000&)), "")
    end function

    @it("a halt that lands while a hold's pause is in flight resumes the node once the pause lands")
    function _()
      context = m.ctx()
      context.following = false
      policy = syncPlayConverge.defaultPolicy()
      player = m.playingAt(m.at65s, 9900&)
      group = m.playingLine()
      syncPlayPlayer.told(player, "pause", "hold", invalid, 9900&)
      m.assertEqual(m.kindOf(syncPlayConverge.decide(player, group, context, policy, 9910&)), "")
      syncPlayPlayer.nodeState(player, "paused", 9930&)
      release = syncPlayConverge.decide(player, group, context, policy, 9930&)
      m.assertEqual(m.kindOf(release), "resume")
      m.assertEqual(release.action.owner, "release")
      syncPlayConverge.applied(player, group, release.action, 9930&)
      m.assertEqual(m.kindOf(syncPlayConverge.decide(player, group, context, policy, 9931&)), "")
      syncPlayPlayer.nodeState(player, "playing", 9960&)
      m.assertEqual(m.kindOf(syncPlayConverge.decide(player, group, context, policy, 9960&)), "")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("a node in flight")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("a node loading, seeking, arrived, pausing or resuming is not written to, whatever the group wants")
    function _()
      loading = syncPlayPlayer.newPlayer()
      syncPlayPlayer.mounted(loading, invalid, 9900&)
      seeking = m.playingAt(m.at60s, 9900&)
      syncPlayPlayer.told(seeking, "seek", "hold", m.at100s, 9950&)
      arrived = m.playingAt(m.at60s, 9900&)
      syncPlayPlayer.told(arrived, "seek", "hold", m.at100s, 9950&)
      syncPlayPlayer.nodeState(arrived, "playing", 9990&)
      pausing = m.playingAt(m.at60s, 9900&)
      syncPlayPlayer.told(pausing, "pause", "group", invalid, 9950&)
      resuming = m.pausedAt(m.at60s, "group")
      syncPlayPlayer.told(resuming, "resume", "group", invalid, 9950&)
      for each player in [loading, seeking, arrived, pausing, resuming]
        for each group in [m.pausedGroup(), m.seekGroup(), m.playingLine(), m.groupWith(invalid)]
          ' The server has this member's Buffering, so no report stands in for a node write.
          group.saidBuffering = true
          group.bufferingForLoad = player.loadCount
          group.owesReady = false
          group.whereAskedAtMs = 9999&
          m.assertEqual(m.kindOf(m.decide(player, group, 10000&)), "", player.activity)
        end for
      end for
    end function

    @it("a node in flight still stops for a stopped group")
    function _()
      seeking = m.playingAt(m.at60s, 9900&)
      syncPlayPlayer.told(seeking, "seek", "hold", m.at100s, 9950&)
      m.assertEqual(m.kindOf(m.decide(seeking, m.groupWith(m.cmd("Stop", 9000&, 0&)), 10000&)), "stop")
    end function

    @it("the time to look again is the node's own deadline while it is in flight")
    function _()
      pausing = m.playingAt(m.at60s, 9900&)
      syncPlayPlayer.told(pausing, "pause", "group", invalid, 9950&)
      m.assertEqual(m.decide(pausing, m.pausedGroup(), 10000&).wakeAtMs, 9950& + syncPlayPlayback.PAUSE_CONFIRM_MS)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("a paused group")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("a playing node is paused for the group, with the OSD")
    function _()
      result = m.decide(m.playingAt(m.at60s, 10000&), m.pausedGroup(), 10000&)
      m.assertEqual(m.kindOf(result), "pause")
      m.assertEqual(result.action.owner, "group")
      m.assertTrue(result.action.showOsd)
    end function

    @it("the viewer's own unanswered pause pauses the node as theirs")
    function _()
      group = m.playingLine()
      syncPlayGroup.viewerAsked(group, "pause", invalid, 9990&)
      result = m.decide(m.playingAt(m.at65s, 10000&), group, 10000&)
      m.assertEqual(m.kindOf(result), "pause")
      m.assertEqual(result.action.owner, "viewer")
    end function

    @it("a node the group or the viewer already paused is left alone")
    function _()
      m.assertEqual(m.kindOf(m.decide(m.pausedAt(m.at60s, "group"), m.pausedGroup(), 10000&)), "")
      m.assertEqual(m.kindOf(m.decide(m.pausedAt(m.at60s, "viewer"), m.pausedGroup(), 10000&)), "")
    end function

    @it("a node a hold or a wait paused becomes the group's pause, with the OSD and no second write")
    function _()
      for each owner in ["hold", "wait"]
        player = m.pausedAt(m.at60s, owner)
        group = m.pausedGroup()
        result = m.decide(player, group, 10000&)
        m.assertEqual(m.kindOf(result), "pause")
        m.assertTrue(result.action.showOsd)
        syncPlayConverge.applied(player, group, result.action, 10000&)
        m.assertEqual(player.pauseOwner, "group")
        m.assertEqual(player.activity, "paused")
        m.assertEqual(m.kindOf(m.decide(player, group, 10001&)), "")
      end for
    end function

    @it("a stalling or stalled node is paused too")
    function _()
      player = m.playingAt(m.at60s, 9000&)
      syncPlayPlayer.nodeState(player, "buffering", 9500&)
      m.assertEqual(m.kindOf(m.decide(player, m.pausedGroup(), 10000&)), "pause")
      syncPlayPlayer.advance(player, 9500& + syncPlayPlayback.STALL_MS)
      m.assertEqual(player.activity, "stalled")
      m.assertEqual(m.kindOf(m.decide(player, m.pausedGroup(), 10600&)), "pause")
    end function

    @it("a node that plays on through its pause writes halts the member")
    function _()
      player = m.playingAt(m.at60s, 10000&)
      player.pauseWrites = syncPlayPlayback.PAUSE_ATTEMPTS
      m.assertEqual(m.kindOf(m.decide(player, m.pausedGroup(), 10000&)), "halt")
    end function

    ' A node that swallowed every pause write: it reads playing, with no clock, at the limit.
    private function wedgedNode() as object
      player = m.playingAt(m.at60s, 9000&)
      t& = 10000&
      for i = 1 to syncPlayPlayback.PAUSE_ATTEMPTS
        syncPlayPlayer.told(player, "pause", "group", invalid, t&)
        t& = t& + syncPlayPlayback.PAUSE_CONFIRM_MS
        syncPlayPlayer.advance(player, t&)
      end for
      return player
    end function

    @it("a node at the pause-write limit that reads playing with no clock is sent to the point once, not halted")
    function _()
      player = m.wedgedNode()
      group = m.pausedGroup()
      m.assertEqual(player.activity, "playing")
      m.assertEqual(player.clock.kind, "unknown")
      m.assertEqual(player.pauseWrites, syncPlayPlayback.PAUSE_ATTEMPTS)
      result = m.decide(player, group, 20000&)
      m.assertEqual(m.kindOf(result), "seek")
      m.assertEqual(result.action.targetTicks, m.at60s)
      m.assertEqual(result.action.owner, "group")
      m.assertTrue(result.action.recover)
      syncPlayConverge.applied(player, group, result.action, 20000&)
      m.assertEqual(group.recoverSeeks, 1)
      again = m.wedgedNode()
      m.assertEqual(m.kindOf(m.decide(again, group, 20000&)), "halt")
    end function

    @it("a node at the pause-write limit whose clock is running is halted with no seek")
    function _()
      player = m.playingAt(m.at60s, 10000&)
      player.pauseWrites = syncPlayPlayback.PAUSE_ATTEMPTS
      m.assertEqual(player.clock.kind, "running")
      m.assertEqual(m.kindOf(m.decide(player, m.pausedGroup(), 10100&)), "halt")
    end function

    @it("with the viewer's own pause not yet answered, that node is sent to where the group's line is")
    function _()
      group = m.playingLine()
      syncPlayGroup.viewerAsked(group, "pause", invalid, 9990&)
      result = m.decide(m.wedgedNode(), group, 20000&)
      m.assertEqual(m.kindOf(result), "seek")
      m.assertTrue(result.action.recover)
      m.assertEqual(result.action.targetTicks, syncPlayConverge.lineTicksAt(group, m.estimator(), 20000&))
    end function

    @it("a new group command makes the recover seek available again")
    function _()
      group = m.pausedGroup()
      first = m.decide(m.wedgedNode(), group, 20000&)
      syncPlayConverge.applied(m.wedgedNode(), group, first.action, 20000&)
      m.assertEqual(m.kindOf(m.decide(m.wedgedNode(), group, 20000&)), "halt")
      syncPlayGroup.command(group, m.cmd("Pause", 21000&, m.at60s))
      m.assertEqual(group.recoverSeeks, 0)
      m.assertEqual(m.kindOf(m.decide(m.wedgedNode(), group, 22000&)), "seek")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("a group waiting at a Seek's point")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("a node elsewhere seeks to the point, then tells the server it is buffering")
    function _()
      player = m.playingAt(m.at60s, 10000&)
      group = m.seekGroup()
      result = m.decide(player, group, 10000&)
      m.assertEqual(m.kindOf(result), "seek")
      m.assertEqual(result.action.targetTicks, m.at100s)
      m.assertEqual(result.action.owner, "group")
      syncPlayConverge.applied(player, group, result.action, 10000&)
      m.assertEqual(group.pointSoughtTicks, m.at100s)
      report = m.decide(player, group, 10001&)
      m.assertEqual(m.kindOf(report), "report")
      m.assertEqual(report.action.what, "buffering")
      m.assertEqual(report.action.heldFor, "seek")
      syncPlayConverge.applied(player, group, report.action, 10001&)
      m.assertEqual(m.kindOf(m.decide(player, group, 10002&)), "")
    end function

    @it("a node at the point is paused with no OSD, then reports Ready where it stopped")
    function _()
      player = m.playingAt(m.at100s + 100 * m.oneMs, 10000&)
      group = m.seekGroup()
      result = m.decide(player, group, 10000&)
      m.assertEqual(m.kindOf(result), "pause")
      m.assertEqual(result.action.owner, "wait")
      m.assertFalse(result.action.showOsd)
      syncPlayConverge.applied(player, group, result.action, 10000&)
      syncPlayPlayer.nodeState(player, "paused", 10030&)
      ready = m.decide(player, group, 10030&)
      m.assertEqual(m.kindOf(ready), "report")
      m.assertEqual(ready.action.what, "ready")
      m.assertFalse(ready.action.isPlaying)
      m.assertEqual(ready.action.positionTicks, m.at100s + 100 * m.oneMs)
    end function

    @it("a paused node elsewhere seeks to the point")
    function _()
      m.assertEqual(m.kindOf(m.decide(m.pausedAt(m.at60s, "group"), m.seekGroup(), 10000&)), "seek")
    end function

    @it("a node that landed off the point is not sent there a second time")
    function _()
      group = m.seekGroup()
      first = m.decide(m.playingAt(m.at60s, 10000&), group, 10000&)
      m.assertEqual(m.kindOf(first), "seek")
      syncPlayConverge.applied(m.playingAt(m.at60s, 10000&), group, first.action, 10000&)
      result = m.decide(m.pausedAt(m.at100s - 948 * m.oneMs, "wait"), group, 10000&)
      m.assertEqual(m.kindOf(result), "ask")
    end function

    @it("a direct play that landed off the point is sent there once more")
    function _()
      group = m.soughtSeekGroup()
      result = m.decideOnPath(m.landedFromSeek(m.at100s - 3000 * m.oneMs), group, 9620&, false)
      m.assertEqual(m.kindOf(result), "seek")
      m.assertEqual(result.action.targetTicks, m.at100s)
      m.assertTrue(result.action.toPoint)
    end function

    @it("a direct play still off the point after that second seek gets no third, whatever command names the point")
    function _()
      group = m.soughtSeekGroup()
      player = m.landedFromSeek(m.at100s - 3000 * m.oneMs)
      again = m.decideOnPath(player, group, 9620&, false)
      syncPlayConverge.applied(player, group, again.action, 9620&)
      m.assertEqual(m.kindOf(m.decideOnPath(m.landedFromSeek(m.at100s - 3000 * m.oneMs), group, 9620&, false)), "pause")
      syncPlayGroup.command(group, m.cmd("Seek", 9500&, m.at100s))
      group.saidBuffering = true
      m.assertEqual(m.kindOf(m.decideOnPath(m.landedFromSeek(m.at100s - 3000 * m.oneMs), group, 9620&, false)), "pause")
    end function

    @it("a transcode that landed off the point is not sent there again, nor is a path nothing has named")
    function _()
      group = m.soughtSeekGroup()
      m.assertEqual(m.kindOf(m.decideOnPath(m.landedFromSeek(m.at100s - 3000 * m.oneMs), group, 9620&, true)), "pause")
      m.assertEqual(m.kindOf(m.decide(m.landedFromSeek(m.at100s - 3000 * m.oneMs), group, 9620&)), "pause")
    end function

    @it("a direct play that landed at the point is not sent there again")
    function _()
      group = m.soughtSeekGroup()
      m.assertEqual(m.kindOf(m.decideOnPath(m.landedFromSeek(m.at100s + 20 * m.oneMs), group, 9620&, false)), "pause")
    end function

    @it("a second command naming the point a node was sent to writes no second seek")
    function _()
      group = m.seekGroup()
      first = m.decide(m.playingAt(m.at60s, 10000&), group, 10000&)
      syncPlayConverge.applied(m.playingAt(m.at60s, 10000&), group, first.action, 10000&)
      syncPlayGroup.command(group, m.cmd("Seek", 9500&, m.at100s))
      ' Short of the point still: it asks the group to come to it, and writes no second seek.
      result = m.decide(m.pausedAt(m.at100s - 948 * m.oneMs, "wait"), group, 10000&)
      m.assertEqual(m.kindOf(result), "ask")
    end function

    @it("once the group has played on, a Seek back to the same point is sought again")
    function _()
      group = m.seekGroup()
      first = m.decide(m.playingAt(m.at60s, 10000&), group, 10000&)
      syncPlayConverge.applied(m.playingAt(m.at60s, 10000&), group, first.action, 10000&)
      syncPlayGroup.command(group, m.cmd("Unpause", 9600&, m.at100s))
      syncPlayGroup.command(group, m.cmd("Seek", 9800&, m.at100s))
      m.assertEqual(m.kindOf(m.decide(m.pausedAt(m.at60s, "group"), group, 10000&)), "seek")
    end function

    @it("a node paused short of the point after its seek asks the group to come to where it stands")
    function _()
      policy = syncPlayConverge.defaultPolicy()
      stop& = m.at100s - 3000 * m.oneMs
      player = m.pausedAt(stop&, "wait")
      group = m.seekGroup()
      group.pointSoughtTicks = m.at100s
      ask = m.decide(player, group, 10000&)
      m.assertEqual(m.kindOf(ask), "ask")
      m.assertEqual(ask.action.what, "seek")
      m.assertEqual(ask.action.positionTicks, stop&)
      m.assertTrue(ask.action.landing)
      syncPlayConverge.applied(player, group, ask.action, 10000&)
      ' No Ready names a place the node is not at while the group's Seek here is on its way.
      m.assertEqual(m.kindOf(m.decide(player, group, 10010&)), "")
      syncPlayGroup.requestArrived(group, "ask", "seek", group.ask.id)
      waiting = m.decide(player, group, 10100&)
      m.assertEqual(m.kindOf(waiting), "")
      m.assertEqual(waiting.wakeAtMs, 10000& + policy.requestLimitMs)
      ' The group comes: the node is at the new point, writes no seek, and reports where it is.
      syncPlayGroup.command(group, m.cmd("Seek", 11200&, stop&))
      ready = m.decide(player, group, 10300&)
      m.assertEqual(m.kindOf(ready), "report")
      m.assertEqual(ready.action.what, "ready")
      m.assertEqual(ready.action.positionTicks, stop&)
    end function

    @it("the ask is made once per wait: a member that has used it reports the point, until the group plays again")
    function _()
      player = m.pausedAt(m.at100s - 3000 * m.oneMs, "wait")
      group = m.seekGroup()
      group.pointSoughtTicks = m.at100s
      group.landingAsked = true
      result = m.decide(player, group, 10000&)
      m.assertEqual(m.kindOf(result), "report")
      m.assertEqual(result.action.what, "ready")
      m.assertEqual(result.action.positionTicks, m.at100s)
      ' The group plays, then seeks again: the ask is whole.
      syncPlayGroup.command(group, m.cmd("Unpause", 10500&, m.at100s))
      m.assertFalse(group.landingAsked)
      syncPlayGroup.command(group, m.cmd("Seek", 12000&, m.at100s))
      group.pointSoughtTicks = m.at100s
      m.assertEqual(m.kindOf(m.decide(player, group, 11500&)), "ask")
    end function

    @it("the ask leaves the budget of the last-resort wait untouched")
    function _()
      player = m.pausedAt(m.at100s - 3000 * m.oneMs, "wait")
      group = m.seekGroup()
      group.pointSoughtTicks = m.at100s
      group.askedWait = true
      ask = m.decide(player, group, 10000&)
      m.assertEqual(m.kindOf(ask), "ask")
      group.askedWait = false
      syncPlayConverge.applied(player, group, ask.action, 10000&)
      m.assertFalse(group.askedWait)
      m.assertTrue(group.landingAsked)
    end function

    @it("an ask the group never answers, or one that fails, falls back to a Ready that names the point")
    function _()
      policy = syncPlayConverge.defaultPolicy()
      player = m.pausedAt(m.at100s - 3000 * m.oneMs, "wait")
      group = m.seekGroup()
      group.pointSoughtTicks = m.at100s
      ask = m.decide(player, group, 10000&)
      syncPlayConverge.applied(player, group, ask.action, 10000&)
      syncPlayGroup.requestArrived(group, "ask", "seek", group.ask.id)
      late = m.decide(player, group, 10000& + policy.requestLimitMs)
      m.assertEqual(m.kindOf(late), "report")
      m.assertEqual(late.action.positionTicks, m.at100s)
      ' And a failed one at once.
      failedGroup = m.seekGroup()
      failedGroup.pointSoughtTicks = m.at100s
      again = m.decide(player, failedGroup, 10000&)
      syncPlayConverge.applied(player, failedGroup, again.action, 10000&)
      syncPlayGroup.requestFailed(failedGroup, "ask", "seek", failedGroup.ask.id)
      failed = m.decide(player, failedGroup, 10050&)
      m.assertEqual(m.kindOf(failed), "report")
      m.assertEqual(failed.action.positionTicks, m.at100s)
    end function

    @it("a direct play asks only after its one retry, and a node within the tolerance never asks")
    function _()
      short& = m.at100s - 3000 * m.oneMs
      group = m.seekGroup()
      group.pointSoughtTicks = m.at100s
      ctx = m.ctx()
      ctx.isTranscoded = false
      policy = syncPlayConverge.defaultPolicy()
      ' The retry is still owed: no ask yet (the Ready is not sent either way: the node is paused
      ' and the retry seek is written first).
      before = syncPlayConverge.decide(m.pausedAt(short&, "wait"), group, ctx, policy, 10000&)
      m.assertNotEqual(m.kindOf(before), "ask")
      group.pointRetried = true
      after = syncPlayConverge.decide(m.pausedAt(short&, "wait"), group, ctx, policy, 10000&)
      m.assertEqual(m.kindOf(after), "ask")
      near = syncPlayConverge.decide(m.pausedAt(m.at100s - 300 * m.oneMs, "wait"), group, ctx, policy, 10000&)
      m.assertEqual(m.kindOf(near), "report")
    end function

    @it("a seek that landed with no reading counts as at the point")
    function _()
      player = m.playingAt(m.at60s, 9000&)
      syncPlayPlayer.told(player, "seek", "group", m.at100s, 9100&)
      syncPlayPlayer.nodeState(player, "playing", 9600&)
      syncPlayPlayer.advance(player, 9600& + syncPlayPlayer.ARRIVAL_READING_MS)
      group = m.seekGroup()
      group.pointSoughtTicks = m.at100s
      group.saidBuffering = true
      result = m.decide(player, group, 10000&)
      m.assertEqual(m.kindOf(result), "pause")
      m.assertEqual(result.action.owner, "wait")
    end function

    @it("a Ready in flight is not sent twice, and a failed one goes again")
    function _()
      player = m.pausedAt(m.at100s, "wait")
      group = m.seekGroup()
      ready = m.decide(player, group, 10000&)
      syncPlayConverge.applied(player, group, ready.action, 10000&)
      waiting = m.decide(player, group, 10100&)
      m.assertEqual(m.kindOf(waiting), "")
      m.assertEqual(waiting.wakeAtMs, 13000&)
      syncPlayGroup.requestFailed(group, "report", "ready", group.report.id)
      again = m.decide(player, group, 10200&)
      m.assertEqual(m.kindOf(again), "report")
      m.assertEqual(again.action.what, "ready")
    end function

    @it("a Ready that keeps failing is told to the viewer once")
    function _()
      player = m.pausedAt(m.at100s, "wait")
      group = m.seekGroup()
      policy = syncPlayConverge.defaultPolicy()
      for attempt = 1 to policy.requestTries
        syncPlayGroup.requestSent(group, "report", "ready", 10000&)
        syncPlayGroup.requestFailed(group, "report", "ready", group.report.id)
      end for
      told = m.decide(player, group, 10500&)
      m.assertEqual(m.kindOf(told), "notice")
      m.assertEqual(told.action.what, "unreachable")
      syncPlayConverge.applied(player, group, told.action, 10500&)
      quiet = m.decide(player, group, 10600&)
      m.assertEqual(m.kindOf(quiet), "")
      m.assertEqual(quiet.wakeAtMs, 10000& + policy.retryEveryMs)
    end function

    @it("a Ready the group waits for is never given up: after the notice it goes again at a slower pace")
    function _()
      player = m.pausedAt(m.at100s, "wait")
      group = m.seekGroup()
      policy = syncPlayConverge.defaultPolicy()
      for attempt = 1 to policy.requestTries
        syncPlayGroup.requestSent(group, "report", "ready", 10000&)
        syncPlayGroup.requestFailed(group, "report", "ready", group.report.id)
      end for
      told = m.decide(player, group, 10500&)
      syncPlayConverge.applied(player, group, told.action, 10500&)
      again = m.decide(player, group, 10000& + policy.retryEveryMs)
      m.assertEqual(m.kindOf(again), "report")
      m.assertEqual(again.action.what, "ready")
      syncPlayConverge.applied(player, group, again.action, 15000&)
      syncPlayGroup.requestFailed(group, "report", "ready", group.report.id)
      m.assertEqual(m.kindOf(m.decide(player, group, 15100&)), "")
      m.assertEqual(m.kindOf(m.decide(player, group, 15000& + policy.retryEveryMs)), "report")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("a seek that never lands")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("a seek left at a full buffer past the limit gets one recovery seek, then one reload, then nothing")
    function _()
      policy = syncPlayConverge.defaultPolicy()
      group = m.seekGroup()
      group.saidBuffering = true
      player = m.playingAt(m.at60s, 9000&)
      syncPlayPlayer.told(player, "seek", "group", m.at100s, 9100&)
      syncPlayPlayer.nodeState(player, "buffering", 9200&)
      ' While it seeks, the comparison looks again each poll, to hear of the buffer.
      early = m.decide(player, group, 9300&)
      m.assertEqual(m.kindOf(early), "")
      m.assertEqual(early.wakeAtMs, 9300& + policy.stuckPollMs)
      syncPlayPlayer.bufferFull(player, 10000&)
      m.assertEqual(m.kindOf(m.decide(player, group, 9999& + policy.stuckFullBufferMs)), "")
      stuckAt& = 10000& + policy.stuckFullBufferMs
      recover = m.decide(player, group, stuckAt&)
      m.assertEqual(m.kindOf(recover), "seek")
      m.assertEqual(recover.action.targetTicks, m.at100s)
      m.assertEqual(recover.action.owner, "group")
      m.assertTrue(recover.action.recover)
      m.assertTrue(recover.action.stuck)
      syncPlayConverge.applied(player, group, recover.action, stuckAt&)
      m.assertEqual(player.activity, "seeking")
      m.assertInvalid(player.bufferFullAtMs)
      ' The recovery seek sticks the same way: the stream is loaded again, once.
      syncPlayPlayer.nodeState(player, "buffering", stuckAt& + 100)
      syncPlayPlayer.bufferFull(player, stuckAt& + 1000)
      again& = stuckAt& + 1000 + policy.stuckFullBufferMs
      reload = m.decide(player, group, again&)
      m.assertEqual(m.kindOf(reload), "reload")
      syncPlayConverge.applied(player, group, reload.action, again&)
      m.assertEqual(m.kindOf(m.decide(player, group, again& + 5000)), "")
    end function

    @it("with the default policy, a seek at a full buffer for 7 s is left alone and one for 10 s is recovered")
    function _()
      group = m.seekGroup()
      group.saidBuffering = true
      slow = m.playingAt(m.at60s, 9000&)
      syncPlayPlayer.told(slow, "seek", "group", m.at100s, 9100&)
      syncPlayPlayer.nodeState(slow, "buffering", 9200&)
      syncPlayPlayer.bufferFull(slow, 10000&)
      m.assertEqual(m.kindOf(m.decide(slow, group, 17000&)), "")
      m.assertEqual(m.kindOf(m.decide(slow, group, 20000&)), "seek")
    end function

    @it("a seek that is slow to fill its buffer, or whose node is not buffering, is left alone")
    function _()
      policy = syncPlayConverge.defaultPolicy()
      group = m.seekGroup()
      group.saidBuffering = true
      filling = m.playingAt(m.at60s, 9000&)
      syncPlayPlayer.told(filling, "seek", "group", m.at100s, 9100&)
      syncPlayPlayer.nodeState(filling, "buffering", 9200&)
      m.assertEqual(m.kindOf(m.decide(filling, group, 9100& + 3 * policy.stuckFullBufferMs)), "")
      ' A full buffer was seen, but the node has left `buffering` since.
      paused = m.playingAt(m.at60s, 9000&)
      syncPlayPlayer.told(paused, "seek", "group", m.at100s, 9100&)
      syncPlayPlayer.nodeState(paused, "buffering", 9200&)
      syncPlayPlayer.bufferFull(paused, 10000&)
      paused.nodeState = ""
      m.assertEqual(m.kindOf(m.decide(paused, group, 10000& + 2 * policy.stuckFullBufferMs)), "")
    end function

    @it("a group command makes the stuck-seek budget whole")
    function _()
      group = m.seekGroup()
      group.recoverSeeks = 1
      group.stuckReloads = 1
      syncPlayGroup.command(group, m.cmd("Seek", 9500&, m.at100s))
      m.assertEqual(group.recoverSeeks, 0)
      m.assertEqual(group.stuckReloads, 0)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("this member's own load and stall")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("a load tells the server it is buffering once, pauses at its first frame and reports Ready")
    function _()
      player = syncPlayPlayer.newPlayer()
      group = syncPlayGroup.newGroup()
      syncPlayGroup.itemChanged(group, "p-1", 1000&)
      syncPlayPlayer.mounted(player, m.at60s, 9000&)
      buffering = m.decide(player, group, 9000&)
      m.assertEqual(m.kindOf(buffering), "report")
      m.assertEqual(buffering.action.what, "buffering")
      m.assertEqual(buffering.action.heldFor, "load")
      m.assertEqual(buffering.action.positionTicks, m.at60s)
      syncPlayConverge.applied(player, group, buffering.action, 9000&)
      syncPlayGroup.requestArrived(group, "report", "buffering", group.report.id)
      m.assertEqual(m.kindOf(m.decide(player, group, 9100&)), "")
      syncPlayPlayer.nodeState(player, "playing", 9800&)
      m.assertEqual(m.kindOf(m.decide(player, group, 9800&)), "")
      ' The first reading is far below the load's start: a node can read 0 at its first frame.
      syncPlayPlayer.reading(player, 0&, 9820&)
      pause = m.decide(player, group, 9820&)
      m.assertEqual(m.kindOf(pause), "pause")
      m.assertEqual(pause.action.owner, "wait")
      syncPlayConverge.applied(player, group, pause.action, 9820&)
      syncPlayPlayer.nodeState(player, "paused", 9850&)
      ready = m.decide(player, group, 9850&)
      m.assertEqual(ready.action.what, "ready")
      m.assertEqual(ready.action.positionTicks, m.at60s)
      m.assertFalse(ready.action.isPlaying)
    end function

    @it("each load is told to the server, whatever was said before: a member that follows again waits its turn")
    function _()
      player = m.playingAt(m.at65s, 10000&)
      group = m.playingLine()
      group.bufferingForLoad = player.loadCount
      group.saidBuffering = true
      ' Halted, then following again: the group's item loads anew.
      syncPlayGroup.followedAgain(group)
      syncPlayPlayer.unmounted(player, 10100&)
      syncPlayPlayer.told(player, "load", "group", m.at65s, 10200&)
      first = m.decide(player, group, 10200&)
      m.assertEqual(m.kindOf(first), "report")
      m.assertEqual(first.action.what, "buffering")
      m.assertEqual(first.action.heldFor, "load")
      syncPlayConverge.applied(player, group, first.action, 10200&)
      syncPlayGroup.requestArrived(group, "report", "buffering", group.report.id)
      ' The mount of that load is the same load: nothing is said twice.
      syncPlayPlayer.mounted(player, m.at65s, 10500&)
      m.assertEqual(m.kindOf(m.decide(player, group, 10500&)), "")
    end function

    @it("a load that lands short of where the group waits seeks there once, then reports where it stopped")
    function _()
      player = syncPlayPlayer.newPlayer()
      group = m.waitingOnReload(player)
      point& = syncPlayTime.asLong(group.waitPointTicks)
      syncPlayPlayer.nodeState(player, "playing", 12000&)
      syncPlayPlayer.reading(player, point& - 1000 * m.oneMs, 12010&)
      seek = m.decide(player, group, 12010&)
      m.assertEqual(m.kindOf(seek), "seek")
      m.assertEqual(seek.action.owner, "group")
      m.assertEqual(seek.action.targetTicks, point&)
      syncPlayConverge.applied(player, group, seek.action, 12010&)
      ' The server has this load's Buffering: the seek is not told to it again.
      m.assertEqual(m.kindOf(m.decide(player, group, 12020&)), "")
      syncPlayPlayer.nodeState(player, "playing", 13000&)
      syncPlayPlayer.reading(player, point& + 20 * m.oneMs, 13010&)
      pause = m.decide(player, group, 13010&)
      m.assertEqual(m.kindOf(pause), "pause")
      m.assertEqual(pause.action.owner, "wait")
      syncPlayConverge.applied(player, group, pause.action, 13010&)
      syncPlayPlayer.nodeState(player, "paused", 13040&)
      ready = m.decide(player, group, 13040&)
      m.assertEqual(ready.action.what, "ready")
      ' The landing's reading is dated at the `playing` state, 10 ms before the pause's write.
      m.assertEqual(ready.action.positionTicks, point& + 30 * m.oneMs)
    end function

    @it("a load still short after its one seek is paused, and its Ready names the point")
    function _()
      player = syncPlayPlayer.newPlayer()
      group = m.waitingOnReload(player)
      point& = syncPlayTime.asLong(group.waitPointTicks)
      syncPlayPlayer.nodeState(player, "playing", 12000&)
      syncPlayPlayer.reading(player, point& - 1000 * m.oneMs, 12010&)
      seek = m.decide(player, group, 12010&)
      m.assertEqual(m.kindOf(seek), "seek")
      syncPlayConverge.applied(player, group, seek.action, 12010&)
      syncPlayPlayer.nodeState(player, "playing", 13000&)
      syncPlayPlayer.reading(player, point& - 900 * m.oneMs, 13010&)
      pause = m.decide(player, group, 13010&)
      m.assertEqual(m.kindOf(pause), "pause")
      syncPlayConverge.applied(player, group, pause.action, 13010&)
      syncPlayPlayer.nodeState(player, "paused", 13040&)
      ready = m.decide(player, group, 13040&)
      m.assertEqual(ready.action.what, "ready")
      m.assertEqual(ready.action.positionTicks, point&)
    end function

    @it("a load that lands within the server's tolerance of the point is paused with no seek")
    function _()
      player = syncPlayPlayer.newPlayer()
      group = m.waitingOnReload(player)
      point& = syncPlayTime.asLong(group.waitPointTicks)
      syncPlayPlayer.nodeState(player, "playing", 12000&)
      syncPlayPlayer.reading(player, point& - 300 * m.oneMs, 12010&)
      pause = m.decide(player, group, 12010&)
      m.assertEqual(m.kindOf(pause), "pause")
      m.assertEqual(pause.action.owner, "wait")
    end function

    @it("nothing is reported while the group plays no item")
    function _()
      player = syncPlayPlayer.newPlayer()
      group = syncPlayGroup.newGroup()
      syncPlayPlayer.mounted(player, invalid, 9000&)
      m.assertEqual(m.kindOf(m.decide(player, group, 9000&)), "")
      syncPlayGroup.itemChanged(group, "p-1", 9100&)
      m.assertEqual(m.kindOf(m.decide(player, group, 9200&)), "report")
    end function

    @it("a load that replaces one still loading is told to the server as a load of its own")
    function _()
      player = syncPlayPlayer.newPlayer()
      group = syncPlayGroup.newGroup()
      syncPlayGroup.itemChanged(group, "p-1", 1000&)
      syncPlayPlayer.mounted(player, m.at60s, 9000&)
      first = m.decide(player, group, 9000&)
      syncPlayConverge.applied(player, group, first.action, 9000&)
      syncPlayGroup.requestArrived(group, "report", "buffering", group.report.id)
      ' The group restarts the item while that load is still loading: the queue layer loads anew.
      syncPlayGroup.itemChanged(group, "p-1", 9500&)
      syncPlayPlayer.told(player, "load", "group", 0&, 9600&)
      second = m.decide(player, group, 9600&)
      m.assertEqual(m.kindOf(second), "report")
      m.assertEqual(second.action.what, "buffering")
      m.assertEqual(second.action.heldFor, "load")
    end function

    @it("a load's first frame holds for its Ready even when nothing says where the group stands")
    function _()
      player = syncPlayPlayer.newPlayer()
      group = syncPlayGroup.newGroup()
      syncPlayGroup.itemChanged(group, "p-1", 1000&)
      syncPlayPlayer.mounted(player, 0&, 9000&)
      ' The server was told of this load, and the wait it started was reset by a restart.
      group.bufferingForLoad = player.loadCount
      syncPlayPlayer.nodeState(player, "playing", 9800&)
      syncPlayPlayer.reading(player, 3000000&, 9820&)
      hold = m.decide(player, group, 9820&)
      m.assertEqual(m.kindOf(hold), "pause")
      m.assertEqual(hold.action.owner, "wait")
      syncPlayConverge.applied(player, group, hold.action, 9820&)
      syncPlayPlayer.nodeState(player, "paused", 9850&)
      ready = m.decide(player, group, 9850&)
      m.assertEqual(ready.action.what, "ready")
      m.assertFalse(ready.action.isPlaying)
      syncPlayConverge.applied(player, group, ready.action, 9850&)
      m.assertEqual(group.readyForLoad, player.loadCount)
    end function

    @it("a playing member the server waits on, with nothing saying where the group stands, reports as it plays")
    function _()
      player = m.playingAt(m.at65s, 10000&)
      group = m.groupWith(invalid)
      group.readyForLoad = player.loadCount
      group.bufferingForLoad = player.loadCount
      syncPlayGroup.startWait(group)
      ready = m.decide(player, group, 10000&)
      m.assertEqual(m.kindOf(ready), "report")
      m.assertEqual(ready.action.what, "ready")
      m.assertTrue(ready.action.isPlaying)
    end function

    @it("a load from the item's start is paused at its first frame, before any reading, and reports Ready at the start")
    function _()
      player = syncPlayPlayer.newPlayer()
      group = syncPlayGroup.newGroup()
      syncPlayGroup.itemChanged(group, "p-1", 1000&)
      syncPlayPlayer.mounted(player, 0&, 9000&)
      buffering = m.decide(player, group, 9000&)
      syncPlayConverge.applied(player, group, buffering.action, 9000&)
      syncPlayGroup.requestArrived(group, "report", "buffering", group.report.id)
      syncPlayGroup.stateChanged(group, "Playing", "Waiting", m.estimator(), 9100&)
      syncPlayPlayer.nodeState(player, "playing", 9800&)
      ' No reading yet: a fresh stream's first one can come later than the arrival limit.
      pause = m.decide(player, group, 9800&)
      m.assertEqual(m.kindOf(pause), "pause")
      m.assertEqual(pause.action.owner, "wait")
      m.assertFalse(pause.action.showOsd)
      syncPlayConverge.applied(player, group, pause.action, 9800&)
      m.assertEqual(m.kindOf(m.decide(player, group, 9810&)), "")
      syncPlayPlayer.nodeState(player, "paused", 9830&)
      ready = m.decide(player, group, 9830&)
      m.assertEqual(ready.action.what, "ready")
      m.assertEqual(ready.action.positionTicks, 0&)
      m.assertFalse(ready.action.isPlaying)
    end function

    @it("a first frame's reading that arrives as the pause lands is where its Ready and its resume start")
    function _()
      player = syncPlayPlayer.newPlayer()
      group = syncPlayGroup.newGroup()
      syncPlayGroup.itemChanged(group, "p-1", 1000&)
      syncPlayPlayer.mounted(player, 0&, 9000&)
      buffering = m.decide(player, group, 9000&)
      syncPlayConverge.applied(player, group, buffering.action, 9000&)
      syncPlayGroup.requestArrived(group, "report", "buffering", group.report.id)
      syncPlayPlayer.nodeState(player, "playing", 9800&)
      pause = m.decide(player, group, 9800&)
      syncPlayConverge.applied(player, group, pause.action, 9800&)
      syncPlayPlayer.reading(player, 830000&, 9810&)
      syncPlayPlayer.nodeState(player, "paused", 9825&)
      ready = m.decide(player, group, 9825&)
      m.assertEqual(ready.action.what, "ready")
      m.assertEqual(ready.action.positionTicks, 830000&)
    end function

    @it("a group Seek that arrives during a load is written once, after the first frame's reading")
    function _()
      player = syncPlayPlayer.newPlayer()
      group = syncPlayGroup.newGroup()
      syncPlayGroup.itemChanged(group, "p-1", 1000&)
      syncPlayPlayer.mounted(player, m.at60s, 9000&)
      buffering = m.decide(player, group, 9000&)
      syncPlayConverge.applied(player, group, buffering.action, 9000&)
      syncPlayGroup.requestArrived(group, "report", "buffering", group.report.id)
      syncPlayGroup.command(group, m.cmd("Seek", 9300&, m.at100s))
      m.assertEqual(m.kindOf(m.decide(player, group, 9300&)), "")
      syncPlayPlayer.nodeState(player, "playing", 9800&)
      m.assertEqual(m.kindOf(m.decide(player, group, 9800&)), "")
      syncPlayPlayer.reading(player, m.at60s, 9820&)
      seek = m.decide(player, group, 9820&)
      m.assertEqual(m.kindOf(seek), "seek")
      m.assertEqual(seek.action.targetTicks, m.at100s)
      syncPlayConverge.applied(player, group, seek.action, 9820&)
      report = m.decide(player, group, 9821&)
      m.assertEqual(report.action.what, "buffering")
      m.assertEqual(report.action.heldFor, "seek")
      syncPlayConverge.applied(player, group, report.action, 9821&)
      syncPlayGroup.requestArrived(group, "report", "buffering", group.report.id)
      syncPlayPlayer.nodeState(player, "buffering", 9900&)
      m.assertEqual(m.kindOf(m.decide(player, group, 9900&)), "")
      syncPlayPlayer.nodeState(player, "playing", 10400&)
      syncPlayPlayer.reading(player, m.at100s, 10410&)
      pause = m.decide(player, group, 10410&)
      m.assertEqual(m.kindOf(pause), "pause")
      m.assertEqual(pause.action.owner, "wait")
      syncPlayConverge.applied(player, group, pause.action, 10410&)
      syncPlayPlayer.nodeState(player, "paused", 10440&)
      ready = m.decide(player, group, 10440&)
      m.assertEqual(ready.action.what, "ready")
      ' The run started at `playing`, 10 ms before its reading.
      m.assertEqual(ready.action.positionTicks, m.at100s + 10 * m.oneMs)
      syncPlayConverge.applied(player, group, ready.action, 10440&)
      m.assertEqual(m.kindOf(m.decide(player, group, 10441&)), "")
    end function

    @it("a group Pause that arrives during the first-frame hold becomes the group's pause, with the OSD")
    function _()
      player = syncPlayPlayer.newPlayer()
      group = syncPlayGroup.newGroup()
      syncPlayGroup.itemChanged(group, "p-1", 1000&)
      syncPlayPlayer.mounted(player, 0&, 9000&)
      buffering = m.decide(player, group, 9000&)
      syncPlayConverge.applied(player, group, buffering.action, 9000&)
      syncPlayGroup.requestArrived(group, "report", "buffering", group.report.id)
      syncPlayPlayer.nodeState(player, "playing", 9800&)
      hold = m.decide(player, group, 9800&)
      m.assertEqual(hold.action.owner, "wait")
      syncPlayConverge.applied(player, group, hold.action, 9800&)
      syncPlayGroup.command(group, m.cmd("Pause", 9805&, 0&))
      m.assertEqual(m.kindOf(m.decide(player, group, 9806&)), "")
      syncPlayPlayer.reading(player, 830000&, 9810&)
      syncPlayPlayer.nodeState(player, "paused", 9825&)
      shown = m.decide(player, group, 9825&)
      m.assertEqual(m.kindOf(shown), "pause")
      m.assertEqual(shown.action.owner, "group")
      m.assertTrue(shown.action.showOsd)
      syncPlayConverge.applied(player, group, shown.action, 9825&)
      ready = m.decide(player, group, 9826&)
      m.assertEqual(ready.action.what, "ready")
      m.assertEqual(ready.action.positionTicks, 830000&)
    end function


    @it("a group Pause naming a new point while this wait's Ready is in flight seeks nowhere, and is the group's pause once the Ready arrives")
    function _()
      group = syncPlayGroup.newGroup()
      player = m.readyInFlight(group)
      syncPlayGroup.command(group, m.cmd("Pause", 9900&, 25000000&))
      ' The node is already paused: the group's pause is taken over with the OSD, with no seek
      ' to the new point and no report behind it.
      shown = m.decide(player, group, 9901&)
      m.assertEqual(m.kindOf(shown), "pause")
      m.assertEqual(shown.action.owner, "group")
      m.assertTrue(shown.action.showOsd)
      syncPlayConverge.applied(player, group, shown.action, 9901&)
      m.assertEqual(m.kindOf(m.decide(player, group, 9902&)), "")
      syncPlayGroup.requestArrived(group, "report", "ready", group.report.id)
      m.assertEqual(m.kindOf(m.decide(player, group, 9950&)), "")
    end function

    @it("a group Pause naming a new point is sought when this wait's Ready fails")
    function _()
      group = syncPlayGroup.newGroup()
      player = m.readyInFlight(group)
      syncPlayGroup.command(group, m.cmd("Pause", 9900&, 25000000&))
      syncPlayGroup.requestFailed(group, "report", "ready", group.report.id)
      seek = m.decide(player, group, 9950&)
      m.assertEqual(m.kindOf(seek), "seek")
      m.assertEqual(seek.action.targetTicks, 25000000&)
    end function

    @it("a load that starts partway in waits for its first reading before any pause")
    function _()
      player = syncPlayPlayer.newPlayer()
      group = syncPlayGroup.newGroup()
      syncPlayGroup.itemChanged(group, "p-1", 1000&)
      syncPlayPlayer.mounted(player, m.at60s, 9000&)
      buffering = m.decide(player, group, 9000&)
      syncPlayConverge.applied(player, group, buffering.action, 9000&)
      syncPlayGroup.requestArrived(group, "report", "buffering", group.report.id)
      syncPlayPlayer.nodeState(player, "playing", 9800&)
      ' It can land short of its start, and only a playing node can be sent on from there.
      m.assertEqual(m.kindOf(m.decide(player, group, 9800&)), "")
    end function

    @it("a node still on the item before sends no Ready for the new item until its load is performed")
    function _()
      player = m.playingAt(m.at65s, 10000&)
      group = m.playingLine()
      group.readyForLoad = player.loadCount
      group.bufferingForLoad = player.loadCount
      ' The group steps to its next item: the queue layer owes the load and fetches the item first.
      syncPlayGroup.itemChanged(group, "p-2", 10000&)
      pending = m.ctx()
      pending.loadPending = true
      policy = syncPlayConverge.defaultPolicy()
      m.assertEqual(m.kindOf(syncPlayConverge.decide(player, group, pending, policy, 10000&)), "")
      ' Nor from a node the group had paused there.
      paused = m.pausedAt(m.at65s, "group")
      m.assertEqual(m.kindOf(syncPlayConverge.decide(paused, group, pending, policy, 10000&)), "")
      ' The load is performed: the server hears of it, and its first frame owes the Ready.
      syncPlayPlayer.told(player, "load", "group", 0&, 10400&)
      buffering = m.decide(player, group, 10400&)
      m.assertEqual(m.kindOf(buffering), "report")
      m.assertEqual(buffering.action.what, "buffering")
      m.assertEqual(buffering.action.heldFor, "load")
    end function

    @it("a restart that owes no load is answered by the node already on the item")
    function _()
      player = m.playingAt(m.at65s, 10000&)
      group = m.playingLine()
      group.readyForLoad = player.loadCount
      group.bufferingForLoad = player.loadCount
      syncPlayGroup.itemChanged(group, "p-1", 10000&)
      ready = m.decide(player, group, 10000&)
      m.assertEqual(m.kindOf(ready), "report")
      m.assertEqual(ready.action.what, "ready")
    end function

    @it("a stall past the bar tells the server once, and the node that recovers reports Ready as it plays")
    function _()
      player = m.playingAt(m.at65s, 10000&)
      group = m.playingLine()
      syncPlayPlayer.nodeState(player, "buffering", 10100&)
      m.assertEqual(m.kindOf(m.decide(player, group, 10200&)), "")
      syncPlayPlayer.advance(player, 10100& + syncPlayPlayback.STALL_MS)
      buffering = m.decide(player, group, 11100&)
      m.assertEqual(buffering.action.what, "buffering")
      m.assertEqual(buffering.action.heldFor, "stall")
      syncPlayConverge.applied(player, group, buffering.action, 11100&)
      syncPlayGroup.requestArrived(group, "report", "buffering", group.report.id)
      m.assertEqual(m.kindOf(m.decide(player, group, 11200&)), "")
      syncPlayPlayer.nodeState(player, "playing", 12000&)
      ' No position yet: the Ready waits for a reading.
      m.assertEqual(m.kindOf(m.decide(player, group, 12000&)), "")
      syncPlayPlayer.reading(player, m.at65s + 500 * m.oneMs, 12100&)
      ready = m.decide(player, group, 12100&)
      m.assertEqual(m.kindOf(ready), "report")
      m.assertEqual(ready.action.what, "ready")
      m.assertTrue(ready.action.isPlaying)
      m.assertEqual(ready.action.positionTicks, m.at65s + 500 * m.oneMs)
    end function

    @it("a catch-up seek that outlasts its budget is a stall to the group, and is still not written to")
    function _()
      player = m.playingAt(m.at65s - 500 * m.oneMs, 10000&)
      group = m.playingLine()
      seek = m.decide(player, group, 10000&)
      syncPlayConverge.applied(player, group, seek.action, 10000&)
      syncPlayPlayer.nodeState(player, "buffering", 10080&)
      syncPlayPlayer.advance(player, 10000& + syncPlayPlayback.SEEK_SETTLE_MS)
      buffering = m.decide(player, group, 13000&)
      m.assertEqual(m.kindOf(buffering), "report")
      m.assertEqual(buffering.action.what, "buffering")
      m.assertEqual(buffering.action.heldFor, "stall")
      syncPlayConverge.applied(player, group, buffering.action, 13000&)
      syncPlayGroup.requestArrived(group, "report", "buffering", group.report.id)
      ' The group pauses meanwhile: the node, still seeking, is left alone.
      syncPlayGroup.command(group, m.cmd("Pause", 14500&, m.at65s))
      m.assertEqual(m.kindOf(m.decide(player, group, 13600&)), "")
    end function

    @it("a wait this member ended with no command asks where the group is")
    function _()
      player = m.playingAt(m.at65s, 12100&)
      group = m.playingLine()
      group.heldFor = "stall"
      syncPlayGroup.requestSent(group, "report", "buffering", 11100&)
      syncPlayGroup.requestSent(group, "report", "ready", 12100&)
      syncPlayGroup.requestArrived(group, "report", "ready", group.report.id)
      syncPlayGroup.stateChanged(group, "Waiting", "Playing", m.estimator(), 12200&)
      where = m.decide(player, group, 12200&)
      m.assertEqual(m.kindOf(where), "report")
      m.assertEqual(where.action.what, "ready")
      m.assertTrue(where.action.where)
      m.assertTrue(where.action.isPlaying)
      syncPlayConverge.applied(player, group, where.action, 12200&)
      syncPlayGroup.requestArrived(group, "report", "ready", group.report.id)
      quiet = m.decide(player, group, 12300&)
      m.assertEqual(m.kindOf(quiet), "")
      m.assertEqual(quiet.wakeAtMs, 12200& + 3000&)
    end function

    @it("nothing is asked with no clock estimate")
    function _()
      context = m.ctx()
      context.estimator = syncPlayOffset.newEstimator()
      result = syncPlayConverge.decide(m.playingAt(m.at65s, 10000&), m.groupWith(invalid), context, syncPlayConverge.defaultPolicy(), 10000&)
      m.assertEqual(m.kindOf(result), "")
    end function

    @it("a hold with nothing saying where the group is resumes, so the picture is not left frozen")
    function _()
      group = m.groupWith(invalid)
      group.whereAskedAtMs = 9999&
      m.assertEqual(m.kindOf(m.decide(m.pausedAt(m.at65s, "hold"), group, 10000&)), "resume")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("a playing group and a playing node")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("a node inside the bars is left alone")
    function _()
      m.assertEqual(m.kindOf(m.decide(m.playingAt(m.at65s, 10000&), m.playingLine(), 10000&)), "")
      m.assertEqual(m.kindOf(m.decide(m.playingAt(m.at65s + 140 * m.oneMs, 10000&), m.playingLine(), 10000&)), "")
      m.assertEqual(m.kindOf(m.decide(m.playingAt(m.at65s - 390 * m.oneMs, 10000&), m.playingLine(), 10000&)), "")
    end function

    @it("a node ahead past the bar holds, with no OSD")
    function _()
      result = m.decide(m.playingAt(m.at65s + 200 * m.oneMs, 10000&), m.playingLine(), 10000&)
      m.assertEqual(m.kindOf(result), "pause")
      m.assertEqual(result.action.owner, "hold")
      m.assertFalse(result.action.showOsd)
    end function

    @it("holds that do not bring the member in are spent after a few, said once, and whole again in step")
    function _()
      group = m.playingLine()
      policy = syncPlayConverge.defaultPolicy()
      ahead = m.playingAt(m.at65s + 200 * m.oneMs, 10000&)
      for i = 1 to policy.holdLimit
        hold = m.decide(ahead, group, 10000&)
        m.assertEqual(m.kindOf(hold), "pause")
        syncPlayConverge.applied(m.playingAt(m.at65s + 200 * m.oneMs, 10000&), group, hold.action, 10000&)
      end for
      ' The budget is spent: said once, then the member plays on where it is.
      spent = m.decide(ahead, group, 10000&)
      m.assertEqual(m.kindOf(spent), "holdsSpent")
      syncPlayConverge.applied(ahead, group, spent.action, 10000&)
      m.assertEqual(m.kindOf(m.decide(ahead, group, 10000&)), "")
      ' A reading in step makes the budget whole.
      inStep = m.decide(m.playingAt(m.at65s, 10000&), group, 10000&)
      m.assertEqual(m.kindOf(inStep), "inStep")
      syncPlayConverge.applied(ahead, group, inStep.action, 10000&)
      m.assertEqual(m.kindOf(m.decide(ahead, group, 10000&)), "pause")
    end function

    @it("a group command makes the hold budget whole")
    function _()
      group = m.playingLine()
      group.holds = syncPlayConverge.defaultPolicy().holdLimit
      syncPlayGroup.command(group, m.cmd("Unpause", 6000&, m.at60s))
      m.assertEqual(group.holds, 0)
      m.assertEqual(m.kindOf(m.decide(m.playingAt(m.at65s + 200 * m.oneMs, 10000&), group, 10000&)), "pause")
    end function

    @it("a node behind past the bar catches up: one seek ahead of the group by the lead")
    function _()
      player = m.playingAt(m.at65s - 500 * m.oneMs, 10000&)
      group = m.playingLine()
      result = m.decide(player, group, 10000&)
      m.assertEqual(m.kindOf(result), "seek")
      m.assertEqual(result.action.owner, "hold")
      ' The group at device 13000 (the 3 s lead): 68 s.
      m.assertEqual(result.action.targetTicks, 680000000&)
      syncPlayConverge.applied(player, group, result.action, 10000&)
      m.assertEqual(group.catchUps, 1)
      m.assertEqual(player.activity, "seeking")
    end function

    @it("the lead covers the slowest of the stream's recent seeks")
    function _()
      player = m.playingAt(m.at65s - 500 * m.oneMs, 10000&)
      player.seekSamples = [900&, 2600&, 1200&]
      result = m.decide(player, m.playingLine(), 10000&)
      ' 2600 + 500 ms on from 65 s.
      m.assertEqual(result.action.targetTicks, m.at65s + 3100 * m.oneMs)
      m.assertEqual(result.action.budgetMs, 3100&)
      m.assertEqual(result.action.learnedLeadMs, 3100&)
    end function

    @it("a catch-up with fast seeks behind it keeps the shortest lead, and says what they would allow")
    function _()
      player = m.playingAt(m.at65s - 500 * m.oneMs, 10000&)
      player.seekSamples = [900&, 1100&]
      result = m.decide(player, m.playingLine(), 10000&)
      m.assertEqual(result.action.targetTicks, m.at65s + syncPlayPlayback.CATCH_UP_LEAD_MS * m.oneMs)
      m.assertEqual(result.action.budgetMs, syncPlayTime.asLong(syncPlayPlayback.CATCH_UP_LEAD_MS))
      m.assertEqual(result.action.learnedLeadMs, 1600&)
      m.assertEqual(result.action.seekSamples, 2)
    end function

    @it("one slow seek among fast ones lengthens the lead to its limit, and the member still seeks")
    function _()
      player = m.playingAt(m.at65s - 500 * m.oneMs, 10000&)
      player.seekSamples = [900&, 7900&, 1000&]
      result = m.decide(player, m.playingLine(), 10000&)
      m.assertEqual(m.kindOf(result), "seek")
      m.assertEqual(result.action.targetTicks, m.at65s + syncPlayPlayback.CATCH_UP_LEAD_MAX_MS * m.oneMs)
      m.assertEqual(result.action.budgetMs, syncPlayTime.asLong(syncPlayPlayback.CATCH_UP_LEAD_MAX_MS))
    end function

    @it("a single slow seek does not stop the member seeking")
    function _()
      player = m.playingAt(m.at65s - 500 * m.oneMs, 10000&)
      player.seekSamples = [7900&]
      m.assertEqual(m.kindOf(m.decide(player, m.playingLine(), 10000&)), "seek")
    end function

    @it("a member whose seeks as a rule need more than the longest lead asks the group to wait")
    function _()
      player = m.playingAt(m.at65s - 2000 * m.oneMs, 10000&)
      player.seekSamples = [7000&, 6500&]
      result = m.decide(player, m.playingLine(), 10000&)
      m.assertEqual(m.kindOf(result), "ask")
      m.assertTrue(result.action.waitOnMe)
    end function

    @it("a member whose seeks turn fast again catches up alone again")
    function _()
      player = m.playingAt(m.at65s - 2000 * m.oneMs, 10000&)
      player.seekSamples = [7000&, 6500&, 900&, 1000&, 1100&]
      m.assertEqual(m.kindOf(m.decide(player, m.playingLine(), 10000&)), "seek")
    end function

    @it("a catch-up's seek is slow only once it outlasts its lead")
    function _()
      player = m.playingAt(m.at65s - 500 * m.oneMs, 10000&)
      player.seekSamples = [4000&]
      group = m.playingLine()
      result = m.decide(player, group, 10000&)
      syncPlayConverge.applied(player, group, result.action, 10000&)
      syncPlayPlayer.nodeState(player, "buffering", 10050&)
      syncPlayPlayer.advance(player, 10000& + 4499&)
      m.assertFalse(player.seekSlow)
      syncPlayPlayer.advance(player, 10000& + 4500&)
      m.assertTrue(player.seekSlow)
    end function

    @it("a drift is judged only on a measured position")
    function _()
      player = m.pausedAt(m.at65s - 900 * m.oneMs, "group")
      syncPlayPlayer.told(player, "resume", "group", invalid, 9950&)
      syncPlayPlayer.nodeState(player, "playing", 9960&)
      m.assertFalse(player.clock.measured)
      m.assertEqual(m.kindOf(m.decide(player, m.playingLine(), 10000&)), "")
    end function

    @it("a catch-up that landed ahead holds, and resumes as the group arrives")
    function _()
      player = m.playingAt(m.at65s - 500 * m.oneMs, 10000&)
      group = m.playingLine()
      seek = m.decide(player, group, 10000&)
      syncPlayConverge.applied(player, group, seek.action, 10000&)
      syncPlayPlayer.nodeState(player, "buffering", 10080&)
      syncPlayPlayer.nodeState(player, "playing", 10600&)
      ' Landed 20 ms past the target, 2.42 s ahead of the group at 10620.
      syncPlayPlayer.reading(player, 680000000& + 20 * m.oneMs, 10620&)
      hold = m.decide(player, group, 10620&)
      m.assertEqual(m.kindOf(hold), "pause")
      m.assertEqual(hold.action.owner, "hold")
      syncPlayConverge.applied(player, group, hold.action, 10620&)
      syncPlayPlayer.nodeState(player, "paused", 10650&)
      waiting = m.decide(player, group, 10650&)
      m.assertEqual(m.kindOf(waiting), "")
      ' The reading says 68.02 s for the moment the node began playing (10600), so the pause at
      ' 10620 stopped it at 68.04 s, which the group reaches at device 13040.
      m.assertEqual(waiting.wakeAtMs, 13040&)
      m.assertEqual(m.kindOf(m.decide(player, group, 13020&)), "")
      m.assertEqual(m.kindOf(m.decide(player, group, 13040&)), "resume")
    end function

    @it("a catch-up that landed behind runs once more, then asks the group to wait, once")
    function _()
      player = m.playingAt(m.at65s - 2000 * m.oneMs, 10000&)
      group = m.playingLine()
      group.catchUps = 1
      second = m.decide(player, group, 10000&)
      m.assertEqual(m.kindOf(second), "seek")
      group.catchUps = 2
      ask = m.decide(player, group, 10000&)
      m.assertEqual(m.kindOf(ask), "ask")
      m.assertEqual(ask.action.what, "seek")
      m.assertTrue(ask.action.waitOnMe)
      m.assertEqual(ask.action.positionTicks, m.at65s - 2000 * m.oneMs)
      syncPlayConverge.applied(player, group, ask.action, 10000&)
      syncPlayGroup.requestArrived(group, "ask", "seek", group.ask.id)
      m.assertTrue(group.askedWait)
      m.assertEqual(m.kindOf(m.decide(player, group, 10001&)), "")
    end function

    @it("a catch-up seek the node did not take loads the stream again, once, in place of a second seek")
    function _()
      group = m.playingLine()
      ' Ten seconds behind; its catch-up seek to past the group came back playing from where it was.
      player = m.playingAt(m.at65s - 10000 * m.oneMs, 9000&)
      syncPlayPlayer.told(player, "seek", "hold", m.at65s + 3000 * m.oneMs, 9100&)
      syncPlayPlayer.nodeState(player, "buffering", 9200&)
      syncPlayPlayer.nodeState(player, "playing", 9400&)
      syncPlayPlayer.reading(player, m.at65s - 9900 * m.oneMs, 9410&)
      group.catchUps = 1
      reload = m.decide(player, group, 10000&)
      m.assertEqual(m.kindOf(reload), "reload")
      m.assertTrue(reload.action.fellBack)
      syncPlayConverge.applied(player, group, reload.action, 10000&)
      m.assertEqual(group.catchUpReloads, 1)
      m.assertEqual(group.stuckReloads, 0)
      ' Once: after it, the second seek and the ask are what they were.
      m.assertEqual(m.kindOf(m.decide(player, group, 10001&)), "seek")
    end function

    @it("a catch-up seek that landed short of its target, past halfway, is followed by a second seek")
    function _()
      group = m.playingLine()
      player = m.playingAt(m.at65s - 10000 * m.oneMs, 9000&)
      syncPlayPlayer.told(player, "seek", "hold", m.at65s + 3000 * m.oneMs, 9100&)
      syncPlayPlayer.nodeState(player, "buffering", 9200&)
      syncPlayPlayer.nodeState(player, "playing", 9400&)
      syncPlayPlayer.reading(player, m.at65s - 2000 * m.oneMs, 9410&)
      group.catchUps = 1
      m.assertEqual(m.kindOf(m.decide(player, group, 10000&)), "seek")
    end function

    @it("a reading in step after the group answered a wait ask allows the ask once more")
    function _()
      group = m.playingLine()
      group.askedWait = true
      inStep = m.playingAt(m.at65s, 10000&)
      refill = m.decide(inStep, group, 10000&)
      m.assertEqual(m.kindOf(refill), "inStep")
      syncPlayConverge.applied(inStep, group, refill.action, 10000&)
      m.assertFalse(group.askedWait)
      m.assertEqual(m.kindOf(m.decide(inStep, group, 10001&)), "")
      behind = m.playingAt(m.at65s - 2000 * m.oneMs, 10000&)
      group.catchUps = 2
      m.assertEqual(m.kindOf(m.decide(behind, group, 10000&)), "ask")
    end function

    @it("a wait ask that failed is asked again while the member is still behind")
    function _()
      player = m.playingAt(m.at65s - 2000 * m.oneMs, 10000&)
      group = m.playingLine()
      group.catchUps = 2
      ask = m.decide(player, group, 10000&)
      syncPlayConverge.applied(player, group, ask.action, 10000&)
      syncPlayGroup.requestFailed(group, "ask", "seek", group.ask.id)
      again = m.decide(player, group, 10100&)
      m.assertEqual(m.kindOf(again), "ask")
      m.assertEqual(again.action.what, "seek")
      m.assertTrue(again.action.waitOnMe)
    end function

    @it("a wait ask still in flight is not asked again")
    function _()
      player = m.playingAt(m.at65s - 2000 * m.oneMs, 10000&)
      group = m.playingLine()
      group.catchUps = 2
      ask = m.decide(player, group, 10000&)
      syncPlayConverge.applied(player, group, ask.action, 10000&)
      m.assertEqual(m.kindOf(m.decide(player, group, 10100&)), "")
    end function

    @it("a wait ask that was answered is not asked again")
    function _()
      player = m.playingAt(m.at65s - 2000 * m.oneMs, 10000&)
      group = m.playingLine()
      group.catchUps = 2
      ask = m.decide(player, group, 10000&)
      syncPlayConverge.applied(player, group, ask.action, 10000&)
      syncPlayGroup.requestArrived(group, "ask", "seek", group.ask.id)
      m.assertEqual(m.kindOf(m.decide(player, group, 10100&)), "")
    end function

    @it("a member that stalled after its wait ask was answered may ask the group to wait once more")
    function _()
      player = m.playingAt(m.at65s - 2000 * m.oneMs, 10000&)
      group = m.playingLine()
      group.catchUps = 2
      ask = m.decide(player, group, 10000&)
      syncPlayConverge.applied(player, group, ask.action, 10000&)
      syncPlayGroup.requestArrived(group, "ask", "seek", group.ask.id)
      m.assertTrue(group.askedWait)
      syncPlayConverge.applied(player, group, { kind: "report", what: "buffering", heldFor: "stall", positionTicks: m.at65s - 2000 * m.oneMs, isPlaying: false }, 10200&)
      syncPlayGroup.requestArrived(group, "report", "buffering", group.report.id)
      ' The node recovers and the group plays on, still ahead of it.
      syncPlayGroup.requestSent(group, "report", "ready", 10400&)
      syncPlayGroup.requestArrived(group, "report", "ready", group.report.id)
      syncPlayGroup.stateChanged(group, "Waiting", "Playing", m.estimator(), 10500&)
      syncPlayGroup.command(group, m.cmd("Unpause", 6000&, m.at60s))
      player.lastSeekGaveUp = true
      ' A fresh reading, still 2 s behind the line.
      syncPlayPlayer.reading(player, m.at65s, 12000&)
      again = m.decide(player, group, 12000&)
      m.assertEqual(m.kindOf(again), "ask")
      m.assertTrue(again.action.waitOnMe)
    end function

    @it("a wait ask out of tries goes again every retry interval, and the decision wakes then")
    function _()
      group = m.playingLine()
      group.catchUps = 2
      policy = syncPlayConverge.defaultPolicy()
      player = m.playingAt(m.at65s - 2000 * m.oneMs, 10000&)
      sentAt = 10000&
      for i = 1 to policy.requestTries
        player = m.playingAt(m.at60s + (sentAt - 8000&) * m.oneMs, sentAt)
        ask = m.decide(player, group, sentAt)
        m.assertEqual(m.kindOf(ask), "ask")
        syncPlayConverge.applied(player, group, ask.action, sentAt)
        syncPlayGroup.advance(group, syncPlayTime.asLong(policy.requestLimitMs), sentAt + policy.requestLimitMs)
        m.assertEqual(group.ask.state, "failed")
        sentAt += 4000&
      end for
      sentAt -= 4000&
      ' The viewer hears first, once.
      lookAt = sentAt + policy.requestLimitMs
      player = m.playingAt(m.at60s + (lookAt - 8000&) * m.oneMs, lookAt)
      notice = m.decide(player, group, lookAt)
      m.assertEqual(m.kindOf(notice), "notice")
      syncPlayConverge.applied(player, group, notice.action, lookAt)
      waiting = m.decide(player, group, lookAt)
      m.assertEqual(m.kindOf(waiting), "")
      m.assertEqual(waiting.wakeAtMs, sentAt + policy.retryEveryMs)
      dueAt = sentAt + policy.retryEveryMs
      player = m.playingAt(m.at60s + (dueAt - 8000&) * m.oneMs, dueAt - 1)
      m.assertEqual(m.kindOf(m.decide(player, group, dueAt - 1)), "")
      player = m.playingAt(m.at60s + (dueAt - 8000&) * m.oneMs, dueAt)
      due = m.decide(player, group, dueAt)
      m.assertEqual(m.kindOf(due), "ask")
      m.assertTrue(due.action.waitOnMe)
    end function

    @it("a node whose pause was never confirmed, left playing and not moving, is caught up at the silence limit")
    function _()
      player = m.playingAt(m.at65s, 9000&)
      group = m.playingLine()
      syncPlayPlayer.told(player, "pause", "hold", invalid, 9100&)
      syncPlayPlayer.advance(player, 10100&)
      m.assertEqual(player.activity, "playing")
      m.assertEqual(player.clock.kind, "unknown")
      limit& = 10100& + 3000&
      before = m.decide(player, group, limit& - 1)
      m.assertEqual(m.kindOf(before), "")
      m.assertEqual(before.wakeAtMs, limit&)
      atLimit = m.decide(player, group, limit&)
      m.assertEqual(m.kindOf(atLimit), "seek")
      m.assertTrue(atLimit.action.catchUp)
      m.assertTrue(atLimit.action.silent)
      m.assertEqual(atLimit.action.owner, "hold")
    end function

    @it("a playing node with a running clock whose readings stopped is caught up at the silence limit")
    function _()
      player = m.playingAt(m.at65s, 10000&)
      group = m.playingLine()
      limit& = 10000& + 3000&
      m.assertEqual(m.kindOf(m.decide(player, group, limit& - 1)), "")
      m.assertEqual(m.decide(player, group, limit& - 1).wakeAtMs, limit&)
      atLimit = m.decide(player, group, limit&)
      m.assertEqual(m.kindOf(atLimit), "seek")
      m.assertTrue(atLimit.action.catchUp)
      m.assertTrue(atLimit.action.silent)
      m.assertEqual(atLimit.action.owner, "hold")
    end function

    @it("a silent playing node whose last seek was given up is sought once more")
    function _()
      player = m.playingAt(m.at65s, 10000&)
      player.lastSeekGaveUp = true
      group = m.playingLine()
      atLimit = m.decide(player, group, 13000&)
      m.assertEqual(m.kindOf(atLimit), "seek")
      m.assertTrue(atLimit.action.catchUp)
      m.assertTrue(atLimit.action.recover)
      m.assertTrue(atLimit.action.silent)
      m.assertEqual(atLimit.action.owner, "hold")
      syncPlayConverge.applied(player, group, atLimit.action, 13000&)
      m.assertEqual(group.recoverSeeks, 1)
    end function

    @it("a silent playing node whose catch-up budget is spent is sought once more")
    function _()
      player = m.playingAt(m.at65s, 10000&)
      group = m.playingLine()
      group.catchUps = 2
      atLimit = m.decide(player, group, 13000&)
      m.assertEqual(m.kindOf(atLimit), "seek")
      m.assertTrue(atLimit.action.catchUp)
      m.assertTrue(atLimit.action.recover)
      m.assertTrue(atLimit.action.silent)
      m.assertEqual(atLimit.action.owner, "hold")
      syncPlayConverge.applied(player, group, atLimit.action, 13000&)
      m.assertEqual(group.recoverSeeks, 1)
    end function

    @it("a silent playing node is sought only once per group command")
    function _()
      player = m.playingAt(m.at65s, 10000&)
      player.lastSeekGaveUp = true
      group = m.playingLine()
      group.recoverSeeks = 1
      m.assertEqual(m.kindOf(m.decide(player, group, 13000&)), "")
    end function

    @it("a playing node whose readings keep arriving is never caught up for silence")
    function _()
      group = m.playingLine()
      player = m.playingAt(m.at60s + 5000& * m.oneMs, 10000&)
      for t = 10500 to 30000 step 500
        now& = syncPlayTime.asLong(t)
        syncPlayPlayer.reading(player, m.at60s + (now& - 5000&) * m.oneMs, now&)
        m.assertEqual(m.kindOf(m.decide(player, group, now& + 10&)), "", "an action at " + t.toStr())
      end for
    end function

    @it("a silent playing node gets nothing under the viewer's open scrub bar")
    function _()
      player = m.playingAt(m.at65s, 10000&)
      syncPlayPlayer.scrub(player, true)
      result = m.decide(player, m.playingLine(), 30000&)
      m.assertEqual(m.kindOf(result), "")
    end function

    @it("a reading in step refills the catch-up budget, so a later drift is caught up, not asked of the group")
    function _()
      group = m.playingLine()
      group.catchUps = 2
      inStep = m.playingAt(m.at65s, 10000&)
      refill = m.decide(inStep, group, 10000&)
      m.assertEqual(m.kindOf(refill), "inStep")
      syncPlayConverge.applied(inStep, group, refill.action, 10000&)
      m.assertEqual(group.catchUps, 0)
      m.assertEqual(m.kindOf(m.decide(inStep, group, 10001&)), "")
      m.assertEqual(m.kindOf(m.decide(m.playingAt(m.at65s - 2000 * m.oneMs, 10000&), group, 10000&)), "seek")
    end function

    @it("the viewer's time offset pick has a catch-up budget of its own")
    function _()
      group = m.playingLine()
      group.catchUps = 2
      syncPlayGroup.offsetPicked(group)
      result = m.decide(m.playingAt(m.at65s - 100 * m.oneMs, 10000&), group, 10000&)
      m.assertEqual(m.kindOf(result), "seek")
      m.assertTrue(result.action.byPick)
    end function

    @it("a seek the node gave up asks the group to wait in place of another seek")
    function _()
      player = m.playingAt(m.at65s - 2000 * m.oneMs, 10000&)
      player.lastSeekGaveUp = true
      m.assertEqual(m.kindOf(m.decide(player, m.playingLine(), 10000&)), "ask")
    end function

    @it("a catch-up that would run off the item is not written")
    function _()
      context = m.ctx()
      context.durationSeconds = 66
      result = syncPlayConverge.decide(m.playingAt(m.at65s - 500 * m.oneMs, 10000&), m.playingLine(), context, syncPlayConverge.defaultPolicy(), 10000&)
      m.assertEqual(m.kindOf(result), "")
    end function

    @it("after a time offset pick the bar is tighter either way, once")
    function _()
      group = m.playingLine()
      syncPlayGroup.offsetPicked(group)
      ahead = m.decide(m.playingAt(m.at65s + 80 * m.oneMs, 10000&), group, 10000&)
      m.assertEqual(m.kindOf(ahead), "pause")
      behind = m.decide(m.playingAt(m.at65s - 80 * m.oneMs, 10000&), group, 10000&)
      m.assertEqual(m.kindOf(behind), "seek")
      m.assertTrue(behind.action.byPick)
      inside = m.playingAt(m.at65s + 30 * m.oneMs, 10000&)
      settled = m.decide(inside, group, 10000&)
      m.assertEqual(m.kindOf(settled), "settled")
      syncPlayConverge.applied(inside, group, settled.action, 10000&)
      m.assertFalse(group.pickPending)
      m.assertEqual(m.kindOf(m.decide(m.playingAt(m.at65s + 80 * m.oneMs, 10000&), group, 10000&)), "")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("a playing group and a paused node")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("a node ahead waits and resumes as the group reaches it, with no seek")
    function _()
      player = m.pausedAt(m.at65s + 300 * m.oneMs, "group")
      waiting = m.decide(player, m.playingLine(), 10000&)
      m.assertEqual(m.kindOf(waiting), "")
      m.assertEqual(waiting.wakeAtMs, 10300&)
      m.assertEqual(m.kindOf(m.decide(player, m.playingLine(), 10300&)), "resume")
    end function

    @it("a resume is written earlier by the lag the player model learned")
    function _()
      player = m.pausedAt(m.at65s + 300 * m.oneMs, "group")
      player.resumeLagMs = 40&
      waiting = m.decide(player, m.playingLine(), 10000&)
      m.assertEqual(m.kindOf(waiting), "")
      m.assertEqual(waiting.wakeAtMs, 10260&)
      m.assertEqual(m.kindOf(m.decide(player, m.playingLine(), 10259&)), "")
      m.assertEqual(m.kindOf(m.decide(player, m.playingLine(), 10260&)), "resume")
    end function

    @it("a resume is written later when the node runs on past its stop")
    function _()
      player = m.pausedAt(m.at65s + 300 * m.oneMs, "group")
      player.resumeLagMs = -180&
      waiting = m.decide(player, m.playingLine(), 10000&)
      m.assertEqual(m.kindOf(waiting), "")
      m.assertEqual(waiting.wakeAtMs, 10480&)
      m.assertEqual(m.kindOf(m.decide(player, m.playingLine(), 10479&)), "")
      m.assertEqual(m.kindOf(m.decide(player, m.playingLine(), 10480&)), "resume")
    end function

    @it("a node waiting past the line for its run-on is not taken for one behind")
    function _()
      ' It runs on 450 ms past its stop, so its resume waits 450 ms after the line reaches the
      ' stop: past the behind bar by the model's stop alone, and still no catch-up.
      player = m.pausedAt(m.at65s, "hold")
      player.resumeLagMs = -450&
      waiting = m.decide(player, m.playingLine(), 10420&)
      m.assertEqual(m.kindOf(waiting), "")
      m.assertEqual(waiting.wakeAtMs, 10450&)
      m.assertEqual(m.kindOf(m.decide(player, m.playingLine(), 10450&)), "resume")
    end function

    @it("a node paused where the model does not know resumes on time, whatever lag was learned")
    function _()
      ' No stop is known, so a lag below zero (a node that runs on past its stop) says nothing:
      ' the resume is never put off by it.
      player = m.pausedAt(m.at65s, "wait")
      syncPlayPlayer.nodeState(player, "playing", 9940&)
      syncPlayPlayer.nodeState(player, "paused", 9950&)
      m.assertInvalid(syncPlayPlayer.positionAt(player, 10000&))
      player.resumeLagMs = -180&
      m.assertEqual(m.kindOf(m.decide(player, m.playingLine(), 10000&)), "resume")
      ' And for a group about to play: at the Unpause's time, not after it.
      soon = m.groupWith(m.cmd("Unpause", 11500&, m.at60s))
      waiting = m.decide(player, soon, 10000&)
      m.assertEqual(m.kindOf(waiting), "")
      m.assertEqual(waiting.wakeAtMs, 10500&)
      m.assertEqual(m.kindOf(m.decide(player, soon, 10500&)), "resume")
    end function

    @it("a node a little behind resumes now")
    function _()
      m.assertEqual(m.kindOf(m.decide(m.pausedAt(m.at65s - 200 * m.oneMs, "group"), m.playingLine(), 10000&)), "resume")
    end function

    @it("a node further behind catches up")
    function _()
      result = m.decide(m.pausedAt(m.at65s - 1000 * m.oneMs, "group"), m.playingLine(), 10000&)
      m.assertEqual(m.kindOf(result), "seek")
      m.assertTrue(result.action.catchUp)
    end function

    @it("a node too far ahead to wait for seeks back to the group")
    function _()
      result = m.decide(m.pausedAt(m.at65s + 6000 * m.oneMs, "group"), m.playingLine(), 10000&)
      m.assertEqual(m.kindOf(result), "seek")
    end function

    @it("a node stopped at no known position resumes now, and is never seeked on a guess")
    function _()
      player = m.playingAt(m.at60s, 9000&)
      syncPlayPlayer.nodeState(player, "paused", 9500&)
      m.assertEqual(m.kindOf(m.decide(player, m.playingLine(), 10000&)), "resume")
    end function

    @it("with the budget spent and the wait asked, a paused node still resumes")
    function _()
      group = m.playingLine()
      group.catchUps = 2
      group.askedWait = true
      m.assertEqual(m.kindOf(m.decide(m.pausedAt(m.at65s - 1000 * m.oneMs, "group"), group, 10000&)), "resume")
    end function

    @it("a resume that ends a pause the viewer saw closes the OSD")
    function _()
      for each owner in ["group", "viewer", ""]
        result = m.decide(m.pausedAt(m.at65s, owner), m.playingLine(), 10000&)
        m.assertEqual(m.kindOf(result), "resume")
        m.assertTrue(result.action.hideOsd = true)
      end for
    end function

    @it("a resume that ends a hold or a wait leaves the OSD as the viewer has it")
    function _()
      for each owner in ["hold", "wait"]
        result = m.decide(m.pausedAt(m.at65s, owner), m.playingLine(), 10000&)
        m.assertEqual(m.kindOf(result), "resume")
        m.assertFalse(result.action.hideOsd = true)
      end for
    end function

    @it("a paused node that resumes with the budget spent closes the OSD the same way")
    function _()
      group = m.playingLine()
      group.catchUps = 2
      group.askedWait = true
      seen = m.decide(m.pausedAt(m.at65s - 1000 * m.oneMs, "group"), group, 10000&)
      m.assertTrue(seen.action.hideOsd = true)
      held = m.decide(m.pausedAt(m.at65s - 1000 * m.oneMs, "hold"), group, 10000&)
      m.assertEqual(m.kindOf(held), "resume")
      m.assertFalse(held.action.hideOsd = true)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("the viewer's scrub")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("a node the viewer is scrubbing is not resumed, held, caught up or paused for the group")
    function _()
      behind = m.pausedAt(m.at65s - 1000 * m.oneMs, "scrub")
      syncPlayPlayer.scrub(behind, true)
      m.assertEqual(m.kindOf(m.decide(behind, m.playingLine(), 10000&)), "")
      unknown = m.playingAt(m.at60s, 9000&)
      syncPlayPlayer.scrub(unknown, true)
      syncPlayPlayer.nodeState(unknown, "paused", 9500&)
      m.assertEqual(m.kindOf(m.decide(unknown, m.playingLine(), 10000&)), "")
      ahead = m.playingAt(m.at65s + 300 * m.oneMs, 10000&)
      syncPlayPlayer.scrub(ahead, true)
      m.assertEqual(m.kindOf(m.decide(ahead, m.playingLine(), 10000&)), "")
      m.assertEqual(m.kindOf(m.decide(ahead, m.pausedGroup(), 10000&)), "")
    end function

    @it("the bar closing hands the node back: one left paused behind the group is caught up")
    function _()
      player = m.pausedAt(m.at65s - 1000 * m.oneMs, "scrub")
      syncPlayPlayer.scrub(player, true)
      syncPlayPlayer.scrub(player, false)
      m.assertEqual(m.kindOf(m.decide(player, m.playingLine(), 10000&)), "seek")
    end function

    @it("a seek to where the group stands is still written under a scrub: the group moved")
    function _()
      player = m.pausedAt(m.at60s, "scrub")
      syncPlayPlayer.scrub(player, true)
      result = m.decide(player, m.seekGroup(), 10000&)
      m.assertEqual(m.kindOf(result), "seek")
      m.assertEqual(result.action.owner, "group")
    end function

    @it("a seek written under the bar ends the scrub: the node that lands is paused with the bar still drawn")
    function _()
      player = m.pausedAt(m.at60s, "scrub")
      syncPlayPlayer.scrub(player, true)
      group = m.seekGroup()
      group.saidBuffering = true
      seek = m.decide(player, group, 10000&)
      m.assertEqual(m.kindOf(seek), "seek")
      syncPlayConverge.applied(player, group, seek.action, 10000&)
      ' Every reading says the bar is up until the node has closed it.
      syncPlayPlayer.scrub(player, true)
      syncPlayPlayer.nodeState(player, "buffering", 10100&)
      syncPlayPlayer.nodeState(player, "playing", 10800&)
      syncPlayPlayer.scrub(player, true)
      syncPlayPlayer.reading(player, m.at100s + 20 * m.oneMs, 10810&)
      result = m.decide(player, group, 10810&)
      m.assertEqual(m.kindOf(result), "pause")
      m.assertEqual(result.action.owner, "wait")
    end function

    @it("once that bar is seen down, a bar up again is the viewer's scrub")
    function _()
      player = m.pausedAt(m.at60s, "scrub")
      syncPlayPlayer.scrub(player, true)
      syncPlayPlayer.told(player, "seek", "group", m.at100s, 10000&)
      syncPlayPlayer.scrub(player, true)
      m.assertFalse(player.scrubbing)
      syncPlayPlayer.scrub(player, false)
      syncPlayPlayer.scrub(player, true)
      m.assertTrue(player.scrubbing)
    end function

    @it("a node that pauses itself while that bar is still drawn is the viewer scrubbing again")
    function _()
      player = m.pausedAt(m.at60s, "scrub")
      syncPlayPlayer.scrub(player, true)
      syncPlayPlayer.told(player, "seek", "group", m.at100s, 10000&)
      syncPlayPlayer.nodeState(player, "playing", 10800&)
      syncPlayPlayer.reading(player, m.at100s + 20 * m.oneMs, 10810&)
      syncPlayPlayer.nodeState(player, "paused", 10900&)
      m.assertTrue(player.scrubbing)
      m.assertEqual(player.pauseOwner, "scrub")
      m.assertEqual(m.kindOf(m.decide(player, m.playingLine(), 11000&)), "")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("a group about to play")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("a node stopped at the Unpause's position resumes on its time")
    function _()
      ' Server 11500 is device 10500.
      group = m.groupWith(m.cmd("Unpause", 11500&, m.at60s))
      player = m.pausedAt(m.at60s, "group")
      waiting = m.decide(player, group, 10000&)
      m.assertEqual(m.kindOf(waiting), "")
      m.assertEqual(waiting.wakeAtMs, 10500&)
      m.assertEqual(m.kindOf(m.decide(player, group, 10500&)), "resume")
    end function

    @it("a node stopped ahead resumes later by its lead, one behind earlier by its lag")
    function _()
      group = m.groupWith(m.cmd("Unpause", 11500&, m.at60s))
      m.assertEqual(m.decide(m.pausedAt(m.at60s + 100 * m.oneMs, "group"), group, 10000&).wakeAtMs, 10600&)
      m.assertEqual(m.decide(m.pausedAt(m.at60s - 100 * m.oneMs, "group"), group, 10000&).wakeAtMs, 10400&)
    end function

    @it("a node stopped at no known position resumes on the command's time")
    function _()
      group = m.groupWith(m.cmd("Unpause", 11500&, m.at60s))
      player = m.playingAt(m.at60s, 9000&)
      syncPlayPlayer.nodeState(player, "paused", 9500&)
      m.assertEqual(m.decide(player, group, 10000&).wakeAtMs, 10500&)
      m.assertEqual(m.kindOf(m.decide(player, group, 10500&)), "resume")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("the item finishing and the viewer's asks")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("a finished item asks the group for the next one, once")
    function _()
      player = m.playingAt(m.at65s, 10000&)
      group = m.playingLine()
      syncPlayPlayer.finished(player, 10100&)
      ask = m.decide(player, group, 10100&)
      m.assertEqual(m.kindOf(ask), "ask")
      m.assertEqual(ask.action.what, "next")
      syncPlayConverge.applied(player, group, ask.action, 10100&)
      m.assertEqual(m.kindOf(m.decide(player, group, 10200&)), "")
      syncPlayGroup.requestArrived(group, "ask", "next", group.ask.id)
      m.assertEqual(m.kindOf(m.decide(player, group, 10300&)), "")
    end function

    @it("the same item restarted and finished again asks the group for the next one again")
    function _()
      player = m.playingAt(m.at65s, 10000&)
      group = m.playingLine()
      syncPlayPlayer.finished(player, 10100&)
      first = m.decide(player, group, 10100&)
      m.assertEqual(first.action.what, "next")
      syncPlayConverge.applied(player, group, first.action, 10100&)
      syncPlayGroup.requestArrived(group, "ask", "next", group.ask.id)
      ' The group answers with the same item again: a new load of it, played to its end.
      syncPlayPlayer.told(player, "load", "group", 0&, 11000&)
      syncPlayPlayer.mounted(player, 0&, 11500&)
      syncPlayPlayer.nodeState(player, "playing", 11900&)
      syncPlayPlayer.reading(player, m.at65s, 12000&)
      syncPlayPlayer.finished(player, 12100&)
      second = m.decide(player, group, 12100&)
      m.assertEqual(m.kindOf(second), "ask")
      m.assertEqual(second.action.what, "next")
    end function

    @it("on the playlist's last item the member leaves the player once it has asked")
    function _()
      player = m.playingAt(m.at65s, 10000&)
      group = m.playingLine()
      syncPlayPlayer.finished(player, 10100&)
      ask = m.decide(player, group, 10100&)
      syncPlayConverge.applied(player, group, ask.action, 10100&)
      syncPlayGroup.requestArrived(group, "ask", "next", group.ask.id)
      context = m.ctx()
      context.isLastItem = true
      m.assertEqual(m.kindOf(syncPlayConverge.decide(player, group, context, syncPlayConverge.defaultPolicy(), 10300&)), "leave")
    end function

    @it("the viewer's pause that failed is asked again while it is still their ask")
    function _()
      player = m.pausedAt(m.at65s, "viewer")
      group = m.playingLine()
      syncPlayGroup.viewerAsked(group, "pause", invalid, 9900&)
      syncPlayGroup.requestSent(group, "ask", "pause", 9900&)
      syncPlayGroup.requestFailed(group, "ask", "pause", group.ask.id)
      again = m.decide(player, group, 10000&)
      m.assertEqual(m.kindOf(again), "ask")
      m.assertEqual(again.action.what, "pause")
      ' A command answered it meanwhile: nothing is repeated.
      syncPlayGroup.command(group, m.cmd("Pause", 10900&, m.at65s))
      m.assertEqual(m.kindOf(m.decide(player, group, 10100&)), "")
    end function

    @it("an ask the group answered before its slow reply is not held against the next ask")
    function _()
      player = m.playingAt(m.at65s, 10000&)
      group = m.playingLine()
      for attempt = 1 to syncPlayConverge.defaultPolicy().requestTries
        syncPlayGroup.viewerAsked(group, "seek", m.at65s, 6900&)
        syncPlayGroup.requestSent(group, "ask", "seek", 6900&)
        ' The group's command answers the ask at once; the HTTP reply has not come by the limit.
        syncPlayGroup.command(group, m.cmd("Unpause", 6000&, m.at60s))
        syncPlayGroup.advance(group, 3000&, 9900&)
      end for
      m.assertEqual(m.kindOf(m.decide(player, group, 10000&)), "")
      m.assertEqual(group.ask.tries, 0)
    end function

    @it("an ask the limit called failed and the group then answered is not held against the next ask")
    function _()
      player = m.playingAt(m.at65s, 10000&)
      group = m.playingLine()
      for attempt = 1 to syncPlayConverge.defaultPolicy().requestTries
        syncPlayGroup.viewerAsked(group, "seek", m.at65s, 6900&)
        syncPlayGroup.requestSent(group, "ask", "seek", 6900&)
        syncPlayGroup.advance(group, 3000&, 9900&)
        m.assertEqual(group.ask.state, "failed")
        syncPlayGroup.command(group, m.cmd("Unpause", 6000&, m.at60s))
      end for
      m.assertEqual(m.kindOf(m.decide(player, group, 10000&)), "")
      m.assertEqual(group.ask.tries, 0)
    end function

    @it("an ask for the next item is not settled by a command: only the queue's answer ends it")
    function _()
      group = m.playingLine()
      syncPlayGroup.requestSent(group, "ask", "next", 6900&)
      syncPlayGroup.command(group, m.cmd("Unpause", 6000&, m.at60s))
      m.assertEqual(group.ask.state, "flight")
      m.assertEqual(group.ask.tries, 1)
    end function

    @it("the viewer's ask that keeps failing is told to them once")
    function _()
      player = m.pausedAt(m.at65s, "viewer")
      group = m.playingLine()
      syncPlayGroup.viewerAsked(group, "pause", invalid, 9900&)
      for attempt = 1 to syncPlayConverge.defaultPolicy().requestTries
        syncPlayGroup.requestSent(group, "ask", "pause", 9900&)
        syncPlayGroup.requestFailed(group, "ask", "pause", group.ask.id)
      end for
      told = m.decide(player, group, 10000&)
      m.assertEqual(m.kindOf(told), "notice")
      syncPlayConverge.applied(player, group, told.action, 10000&)
      m.assertEqual(m.kindOf(m.decide(player, group, 10100&)), "")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("what the comparison is told")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("the pause the player reports from inside the manager's own write is not the viewer's")
    function _()
      own = syncPlayConverge.newComparison()
      syncPlayConverge.playerFact(own, { kind: "mounted" }, 0&, 100&)
      syncPlayConverge.playerFact(own, { kind: "state", state: "playing" }, 0&, 900&)
      syncPlayConverge.playerFact(own, { kind: "position", position: 65 }, 0&, 10000&)
      syncPlayPlayer.told(own.player, "pause", "group", invalid, 10000&)
      own.ownWrite = true
      syncPlayConverge.playerFact(own, { kind: "pauseWritten" }, 0&, 10001&)
      m.assertEqual(own.player.pauseOwner, "group")
      viewer = syncPlayConverge.newComparison()
      syncPlayConverge.playerFact(viewer, { kind: "mounted" }, 0&, 100&)
      syncPlayConverge.playerFact(viewer, { kind: "state", state: "playing" }, 0&, 900&)
      syncPlayConverge.playerFact(viewer, { kind: "position", position: 65 }, 0&, 10000&)
      syncPlayConverge.playerFact(viewer, { kind: "pauseWritten" }, 0&, 10001&)
      m.assertEqual(viewer.player.pauseOwner, "viewer")
    end function

    @it("a position event's path and length reach the player model, and a mount clears them")
    function _()
      comparison = syncPlayConverge.newComparison()
      syncPlayConverge.playerFact(comparison, { kind: "mounted" }, 0&, 100&)
      syncPlayConverge.playerFact(comparison, { kind: "position", position: 65, isTranscoded: true, duration: 5400 }, 0&, 1000&)
      m.assertTrue(comparison.player.isTranscoded)
      m.assertEqual(comparison.player.durationSeconds, 5400)
      syncPlayConverge.playerFact(comparison, { kind: "mounted" }, 0&, 2000&)
      m.assertInvalid(comparison.player.isTranscoded)
      m.assertEqual(comparison.player.durationSeconds, 0)
    end function

    @it("a join or a leave forgets the last membership's item, and keeps the group state it was told")
    function _()
      comparison = syncPlayConverge.newComparison()
      syncPlayConverge.itemChanged(comparison, "p-1", 1000&)
      m.assertEqual(comparison.group.playingItemId, "p-1")
      syncPlayConverge.membershipChanged(comparison, "Idle")
      m.assertEqual(comparison.group.playingItemId, "")
      m.assertEqual(comparison.groupState, "Idle")
    end function

  end class

end namespace
