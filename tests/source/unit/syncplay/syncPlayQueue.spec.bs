import "pkg:/source/remotecontrol/remoteCommand.bs"
import "pkg:/source/syncplay/syncPlayQueue.bs"
import "pkg:/source/syncplay/syncPlayState.bs"
import "pkg:/source/utils/nodeHelpers.bs"

namespace tests

  @suite("syncPlayQueue — a play queue update as QueueManager items")
  class SyncPlayQueueTests extends tests.BaseTestSuite

    private playlist = [{ itemId: "i-1", playlistItemId: "p-1" }, { itemId: "i-2", playlistItemId: "p-2" }, { itemId: "i-3", playlistItemId: "p-3" }]

    private function items() as object
      ' The server returns raw items in its own order.
      return [
        { Id: "i-3", Type: "Episode", Name: "Three", RunTimeTicks: 30000000& },
        { Id: "i-1", Type: "Movie", Name: "One", RunTimeTicks: 10000000& },
        { Id: "i-2", Type: "Movie", Name: "Two", RunTimeTicks: 20000000& }
      ]
    end function

    private function queueUpdate(lastUpdate as string) as object
      inner = { Reason: "NewPlaylist", LastUpdate: lastUpdate, Playlist: [{ ItemId: "i-1", PlaylistItemId: "p-1" }], PlayingItemIndex: 0, StartPositionTicks: 0 }
      return remoteCommand.parseMessage({ MessageType: "SyncPlayGroupUpdate", Data: { GroupId: "g-1", Type: "PlayQueue", Data: inner } })
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("queueItemsFor()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("builds one queue item per playlist entry, in playlist order")
    function _()
      queueItems = syncPlayQueue.queueItemsFor(m.playlist, m.items())
      m.assertEqual(queueItems.count(), 3)
      m.assertEqual(queueItems[0].id, "i-1")
      m.assertEqual(queueItems[0].type, "Movie")
      m.assertEqual(queueItems[0].syncPlayPlaylistItemId, "p-1")
      m.assertEqual(queueItems[2].id, "i-3")
      m.assertEqual(queueItems[2].syncPlayPlaylistItemId, "p-3")
    end function

    @it("matches a parsed dashed long-poll playlist to the dash-free items the REST fetch returns")
    function _()
      inner = {
        Reason: "NewPlaylist",
        LastUpdate: "2026-10-23T20:47:25.000Z",
        Playlist: [{ ItemId: "08A5F1F3-D54D-4E48-8A1B-AAAAAAAAAAAA", PlaylistItemId: "9C295A4A-760F-4B3C-9D0E-BBBBBBBBBBBB" }],
        PlayingItemIndex: 0,
        StartPositionTicks: 0
      }
      update = remoteCommand.parseMessage({ MessageType: "SyncPlayGroupUpdate", Data: { GroupId: "27067FA4-3DE4-4A1B-9C2D-0123456789AB", Type: "PlayQueue", Data: inner } })
      fetched = [{ Id: "08a5f1f3d54d4e488a1baaaaaaaaaaaa", Type: "Movie", Name: "One", RunTimeTicks: 10000000& }]
      queueItems = syncPlayQueue.queueItemsFor(update.playlist, fetched)
      m.assertEqual(queueItems.count(), 1)
      m.assertEqual(queueItems[0].id, "08a5f1f3d54d4e488a1baaaaaaaaaaaa")
      m.assertEqual(queueItems[0].syncPlayPlaylistItemId, "9c295a4a760f4b3c9d0ebbbbbbbbbbbb")
      m.assertEqual(syncPlayQueue.positionOf(queueItems, "9c295a4a760f4b3c9d0ebbbbbbbbbbbb"), 0)
    end function

    @it("drops an entry the server returned no item for")
    function _()
      queueItems = syncPlayQueue.queueItemsFor(m.playlist, [m.items()[1]])
      m.assertEqual(queueItems.count(), 1)
      m.assertEqual(queueItems[0].id, "i-1")
    end function

    @it("tolerates a missing items array and an empty playlist")
    function _()
      m.assertEqual(syncPlayQueue.queueItemsFor(m.playlist, invalid).count(), 0)
      m.assertEqual(syncPlayQueue.queueItemsFor([], m.items()).count(), 0)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("playingEntry()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("the playlist entry the group plays, found by playlist id, with its item id")
    function _()
      state = syncPlayState.newState()
      state.playlist = m.playlist
      state.playingItemId = "p-2"
      entry = syncPlayQueue.playingEntry(state)
      m.assertEqual(entry.itemId, "i-2")
      m.assertEqual(entry.playlistItemId, "p-2")
    end function

    @it("invalid while the group plays nothing, or names an entry the playlist lacks")
    function _()
      state = syncPlayState.newState()
      state.playlist = m.playlist
      m.assertInvalid(syncPlayQueue.playingEntry(state))
      state.playingItemId = "p-9"
      m.assertInvalid(syncPlayQueue.playingEntry(state))
      m.assertInvalid(syncPlayQueue.playingEntry(invalid))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("stepBounds()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("a middle item steps both ways; the ends step one way; an empty or unknown playlist steps nowhere")
    function _()
      middle = syncPlayQueue.stepBounds(1, 3)
      m.assertTrue(middle.hasPrevious)
      m.assertTrue(middle.hasNext)
      first = syncPlayQueue.stepBounds(0, 3)
      m.assertFalse(first.hasPrevious)
      m.assertTrue(first.hasNext)
      last = syncPlayQueue.stepBounds(2, 3)
      m.assertTrue(last.hasPrevious)
      m.assertFalse(last.hasNext)
      only = syncPlayQueue.stepBounds(0, 1)
      m.assertFalse(only.hasPrevious)
      m.assertFalse(only.hasNext)
      none = syncPlayQueue.stepBounds(-1, 0)
      m.assertFalse(none.hasPrevious)
      m.assertFalse(none.hasNext)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("pagedItems()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("appends every page's items, in page order")
    function _()
      responses = [
        { ok: true, json: { Items: [{ Id: "i-1" }, { Id: "i-2" }] } },
        { ok: true, json: { Items: [{ Id: "i-3" }] } }
      ]
      items = syncPlayQueue.pagedItems(responses)
      m.assertEqual(items.count(), 3)
      m.assertEqual(items[0].Id, "i-1")
      m.assertEqual(items[2].Id, "i-3")
    end function

    @it("is invalid when a page was not ok")
    function _()
      responses = [{ ok: true, json: { Items: [{ Id: "i-1" }] } }, { ok: false, json: invalid }]
      m.assertInvalid(syncPlayQueue.pagedItems(responses))
    end function

    @it("is invalid when a page has no Items array")
    function _()
      m.assertInvalid(syncPlayQueue.pagedItems([{ ok: true, json: { Items: [{ Id: "i-1" }] } }, { ok: true, json: {} }]))
      m.assertInvalid(syncPlayQueue.pagedItems([{ ok: true, json: invalid }]))
      m.assertInvalid(syncPlayQueue.pagedItems([invalid]))
    end function

    @it("is invalid when the responses are not an array")
    function _()
      m.assertInvalid(syncPlayQueue.pagedItems(invalid))
    end function

    @it("returns no items for no responses")
    function _()
      m.assertEqual(syncPlayQueue.pagedItems([]).count(), 0)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("positionOf()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("finds the playing item by playlist id, after a drop shifted the index")
    function _()
      queueItems = syncPlayQueue.queueItemsFor(m.playlist, [m.items()[0], m.items()[2]])
      m.assertEqual(syncPlayQueue.positionOf(queueItems, "p-3"), 1)
      m.assertEqual(syncPlayQueue.positionOf(queueItems, "p-1"), -1)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("isStaleQueueUpdate()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("the first update is never stale")
    function _()
      state = syncPlayState.newState()
      m.assertFalse(syncPlayQueue.isStaleQueueUpdate(state, m.queueUpdate("2026-10-23T20:47:25.000Z")))
    end function

    @it("an update no newer than the applied one is stale; a newer one is not")
    function _()
      state = syncPlayState.applyGroupUpdate(syncPlayState.newState(), m.queueUpdate("2026-10-23T20:47:25.000Z"))
      m.assertTrue(syncPlayQueue.isStaleQueueUpdate(state, m.queueUpdate("2026-10-23T20:47:25.000Z")))
      m.assertTrue(syncPlayQueue.isStaleQueueUpdate(state, m.queueUpdate("2026-10-23T20:47:24.000Z")))
      m.assertFalse(syncPlayQueue.isStaleQueueUpdate(state, m.queueUpdate("2026-10-23T20:47:26.000Z")))
    end function

    @it("only a PlayQueue update can be stale")
    function _()
      state = syncPlayState.applyGroupUpdate(syncPlayState.newState(), m.queueUpdate("2026-10-23T20:47:25.000Z"))
      stateUpdate = remoteCommand.parseMessage({ MessageType: "SyncPlayGroupUpdate", Data: { GroupId: "g-1", Type: "StateUpdate", Data: { State: "Paused", Reason: "Pause" } } })
      m.assertFalse(syncPlayQueue.isStaleQueueUpdate(state, stateUpdate))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("changesPlayingItem()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("a new playlist always moves; a current-item change only when the id changed; queue edits never")
    function _()
      m.assertTrue(syncPlayQueue.changesPlayingItem("NewPlaylist", "p-1", "p-1"))
      m.assertTrue(syncPlayQueue.changesPlayingItem("NextItem", "p-1", "p-2"))
      m.assertFalse(syncPlayQueue.changesPlayingItem("SetCurrentItem", "p-1", "p-1"))
      m.assertTrue(syncPlayQueue.changesPlayingItem("RemoveItems", "p-1", "p-2"))
      m.assertFalse(syncPlayQueue.changesPlayingItem("Queue", "p-1", "p-2"))
      m.assertFalse(syncPlayQueue.changesPlayingItem("ShuffleMode", "p-1", "p-2"))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("isLastItem()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("reads the group's playlist, not the local queue")
    function _()
      state = syncPlayState.newState()
      state.playlist = m.playlist
      state.playingItemIndex = 1
      m.assertFalse(syncPlayQueue.isLastItem(state))
      state.playingItemIndex = 2
      m.assertTrue(syncPlayQueue.isLastItem(state))
    end function

    @it("a group with no playing item has nothing to move on to")
    function _()
      state = syncPlayState.newState()
      m.assertTrue(syncPlayQueue.isLastItem(state))
      state.playlist = m.playlist
      state.playingItemIndex = -1
      m.assertTrue(syncPlayQueue.isLastItem(state))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("isGroupItem()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("only the queue item carrying the group's playing playlist id")
    function _()
      m.assertTrue(syncPlayQueue.isGroupItem({ id: "i-1", syncPlayPlaylistItemId: "p-1" }, "p-1"))
      m.assertFalse(syncPlayQueue.isGroupItem({ id: "i-2", syncPlayPlaylistItemId: "p-2" }, "p-1"))
      m.assertFalse(syncPlayQueue.isGroupItem({ id: "i-1" }, "p-1"))
    end function

    @it("nothing is the group's item while the group plays nothing")
    function _()
      m.assertFalse(syncPlayQueue.isGroupItem({ id: "i-1", syncPlayPlaylistItemId: "" }, ""))
      m.assertFalse(syncPlayQueue.isGroupItem({ id: "i-1" }, ""))
      m.assertFalse(syncPlayQueue.isGroupItem(invalid, "p-1"))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("isGroupQueueItem()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("any item a group's playlist stamped, whatever the group plays now")
    function _()
      m.assertTrue(syncPlayQueue.isGroupQueueItem({ id: "i-1", syncPlayPlaylistItemId: "p-1" }))
      m.assertTrue(syncPlayQueue.isGroupQueueItem({ id: "i-2", syncPlayPlaylistItemId: "p-2" }))
    end function

    @it("not the viewer's own item: no stamp, an empty one, or no item")
    function _()
      m.assertFalse(syncPlayQueue.isGroupQueueItem({ id: "i-1" }))
      m.assertFalse(syncPlayQueue.isGroupQueueItem({ id: "i-1", syncPlayPlaylistItemId: "" }))
      m.assertFalse(syncPlayQueue.isGroupQueueItem(invalid))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("followsItem()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("follows the types the video player plays")
    function _()
      m.assertTrue(syncPlayQueue.followsItem({ id: "i-1", type: "Movie" }))
      m.assertTrue(syncPlayQueue.followsItem({ id: "i-2", type: "Episode" }))
      m.assertTrue(syncPlayQueue.followsItem({ id: "i-3", type: "Video" }))
    end function

    @it("does not follow music, audiobooks or Live TV")
    function _()
      m.assertFalse(syncPlayQueue.followsItem({ id: "i-1", type: "Audio" }))
      m.assertFalse(syncPlayQueue.followsItem({ id: "i-2", type: "AudioBook" }))
      m.assertFalse(syncPlayQueue.followsItem({ id: "i-3", type: "TvChannel" }))
    end function

    @it("does not follow an item with no type, or no item")
    function _()
      m.assertFalse(syncPlayQueue.followsItem({ id: "i-1" }))
      m.assertFalse(syncPlayQueue.followsItem(invalid))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("owedLoadAfter()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("a new playlist owes a new-playlist load, even when the playing item's id is unchanged")
    function _()
      owed = syncPlayQueue.owedLoadAfter(invalid, "NewPlaylist", "p-1", "p-1")
      m.assertTrue(owed.newPlaylist)
    end function

    @it("a move to another item owes a load that is not a new playlist")
    function _()
      m.assertFalse(syncPlayQueue.owedLoadAfter(invalid, "NextItem", "p-1", "p-2").newPlaylist)
      m.assertFalse(syncPlayQueue.owedLoadAfter(invalid, "SetCurrentItem", "p-1", "p-3").newPlaylist)
    end function

    @it("an update that keeps the item owes nothing when nothing was owed")
    function _()
      m.assertInvalid(syncPlayQueue.owedLoadAfter(invalid, "Queue", "p-1", "p-2"))
      m.assertInvalid(syncPlayQueue.owedLoadAfter(invalid, "NextItem", "p-1", "p-1"))
    end function

    @it("an update that keeps the item leaves an owed new playlist owed (the race's shape)")
    function _()
      owed = syncPlayQueue.owedLoadAfter({ newPlaylist: true }, "Queue", "p-2", "p-2")
      m.assertTrue(owed.newPlaylist)
    end function

    @it("a move after an owed new playlist stays a new playlist")
    function _()
      owed = syncPlayQueue.owedLoadAfter({ newPlaylist: true }, "NextItem", "p-1", "p-2")
      m.assertTrue(owed.newPlaylist)
    end function

    @it("a move after an owed plain load stays owed and is not a new playlist")
    function _()
      owed = syncPlayQueue.owedLoadAfter({ newPlaylist: false }, "NextItem", "p-1", "p-2")
      m.assertFalse(owed.newPlaylist)
    end function

    @it("an update that leaves the group playing nothing owes nothing, and drops a load owed before it")
    function _()
      m.assertInvalid(syncPlayQueue.owedLoadAfter(invalid, "RemoveItems", "p-1", ""))
      m.assertInvalid(syncPlayQueue.owedLoadAfter({ newPlaylist: true }, "NewPlaylist", "", ""))
      m.assertInvalid(syncPlayQueue.owedLoadAfter({ newPlaylist: false }, "Queue", "", ""))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("loadAction()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("nothing owed loads nothing")
    function _()
      m.assertEqual(syncPlayQueue.loadAction(invalid, true), "")
      m.assertEqual(syncPlayQueue.loadAction(invalid, false), "")
    end function

    @it("an owed load reloads a mounted player in place")
    function _()
      m.assertEqual(syncPlayQueue.loadAction({ newPlaylist: false }, true), "remount")
      m.assertEqual(syncPlayQueue.loadAction({ newPlaylist: true }, true), "remount")
    end function

    @it("an owed load with no player opens the play route")
    function _()
      m.assertEqual(syncPlayQueue.loadAction({ newPlaylist: false }, false), "launch")
      m.assertEqual(syncPlayQueue.loadAction({ newPlaylist: true }, false), "launch")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("appliesFetchedQueue()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    private function memberState(lastUpdateMs as longinteger) as object
      state = syncPlayState.newState()
      state.inGroup = true
      state.lastUpdateMs = lastUpdateMs
      return state
    end function

    @it("applies for a member that is following, in the group, with no newer update")
    function _()
      state = m.memberState(5000&)
      m.assertTrue(syncPlayQueue.appliesFetchedQueue(state, 5000&))
    end function

    @it("applies nothing once the member halted while the items were in flight")
    function _()
      state = syncPlayState.halt(m.memberState(5000&))
      m.assertFalse(syncPlayQueue.appliesFetchedQueue(state, 5000&))
    end function

    @it("applies nothing outside a group")
    function _()
      state = syncPlayState.newState()
      m.assertFalse(syncPlayQueue.appliesFetchedQueue(state, 0&))
    end function

    @it("applies nothing when a newer update arrived since the fetch started")
    function _()
      state = m.memberState(6000&)
      m.assertFalse(syncPlayQueue.appliesFetchedQueue(state, 5000&))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("loadFailureAction()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("retries a first request failure")
    function _()
      m.assertEqual(syncPlayQueue.loadFailureAction(false, "request"), "retry")
    end function

    @it("halts a request failure on the retry")
    function _()
      m.assertEqual(syncPlayQueue.loadFailureAction(true, "request"), "halt")
    end function

    @it("halts a missing item whether or not it is a retry")
    function _()
      m.assertEqual(syncPlayQueue.loadFailureAction(false, "missing"), "halt")
      m.assertEqual(syncPlayQueue.loadFailureAction(true, "missing"), "halt")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("handoff()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    private function groupState() as object
      state = syncPlayState.newState()
      state.inGroup = true
      state.playlist = m.playlist
      state.playingItemId = "p-1"
      return state
    end function

    @it("a current item the group already queues is a jump to it")
    function _()
      handoff = syncPlayQueue.handoff([{ id: "i-2", type: "Movie" }], 0, m.groupState())
      m.assertEqual(handoff.action, "setPlaylistItem")
      m.assertEqual(handoff.playlistItemId, "p-2")
    end function

    @it("an item the group does not queue replaces the group's queue with this one, at its position")
    function _()
      queueItems = [{ id: "i-9", type: "Episode" }, { id: "i-8", type: "Episode" }]
      handoff = syncPlayQueue.handoff(queueItems, 1, m.groupState())
      m.assertEqual(handoff.action, "setNewQueue")
      m.assertEqual(handoff.itemIds, ["i-9", "i-8"])
      m.assertEqual(handoff.position, 1)
      m.assertEqual(handoff.startPositionTicks, 0&)
    end function

    @it("the current item's starting point is where the group starts, as a LongInteger")
    function _()
      queueItem = { id: "i-9", type: "Movie", startingPoint: 123456789012& }
      handoff = syncPlayQueue.handoff([queueItem], 0, m.groupState())
      m.assertEqual(handoff.startPositionTicks, 123456789012&)
      queueItem.startingPoint = 50000000
      m.assertEqual(syncPlayQueue.handoff([queueItem], 0, m.groupState()).startPositionTicks, 50000000&)
    end function

    @it("a queue the player could not follow plays locally: music, Live TV, or one such item among videos")
    function _()
      state = m.groupState()
      m.assertInvalid(syncPlayQueue.handoff([{ id: "a-1", type: "Audio" }], 0, state))
      m.assertInvalid(syncPlayQueue.handoff([{ id: "c-1", type: "TvChannel" }], 0, state))
      m.assertInvalid(syncPlayQueue.handoff([{ id: "i-9", type: "Movie" }, { id: "a-1", type: "Audio" }], 0, state))
    end function

    @it("an empty queue, or a position outside it, hands nothing over")
    function _()
      state = m.groupState()
      m.assertInvalid(syncPlayQueue.handoff([], 0, state))
      m.assertInvalid(syncPlayQueue.handoff([{ id: "i-9", type: "Movie" }], 1, state))
      m.assertInvalid(syncPlayQueue.handoff(invalid, 0, state))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("owedLoadForClaimedPlay()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("a frame that kept the playing item still owes the load the viewer asked for")
    function _()
      owed = syncPlayQueue.owedLoadForClaimedPlay(invalid, "SetCurrentItem", "p-1")
      m.assertNotInvalid(owed)
      m.assertFalse(owed.newPlaylist)
      m.assertTrue(syncPlayQueue.owedLoadForClaimedPlay(invalid, "NewPlaylist", "p-9").newPlaylist)
    end function

    @it("a load already owed, or a group playing nothing, is left as it is")
    function _()
      owed = { newPlaylist: true }
      m.assertEqual(syncPlayQueue.owedLoadForClaimedPlay(owed, "SetCurrentItem", "p-1"), owed)
      m.assertInvalid(syncPlayQueue.owedLoadForClaimedPlay(invalid, "RemoveItems", ""))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("noticeForQueueFrame()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("a frame that brought a halted member back is told as following again")
    function _()
      m.assertEqual(syncPlayQueue.noticeForQueueFrame(invalid, true, false), "followingAgain")
      m.assertEqual(syncPlayQueue.noticeForQueueFrame(invalid, true, true), "followingAgain")
    end function

    @it("a follow not yet told survives a newer frame before its load")
    function _()
      m.assertEqual(syncPlayQueue.noticeForQueueFrame("followingAgain", false, false), "followingAgain")
    end function

    @it("the queue that answers the viewer's own join says nothing more")
    function _()
      m.assertEqual(syncPlayQueue.noticeForQueueFrame(invalid, false, true), "")
    end function

    @it("anything else is the group starting something")
    function _()
      m.assertEqual(syncPlayQueue.noticeForQueueFrame(invalid, false, false), "groupStarted")
      m.assertEqual(syncPlayQueue.noticeForQueueFrame("", false, false), "groupStarted")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("noticeAtLoad()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("a play this viewer handed over was told at the claim")
    function _()
      m.assertEqual(syncPlayQueue.noticeAtLoad("groupStarted", "launch", true), "")
      m.assertEqual(syncPlayQueue.noticeAtLoad("followingAgain", "remount", true), "")
    end function

    @it("a launch tells what its frame decided")
    function _()
      m.assertEqual(syncPlayQueue.noticeAtLoad("groupStarted", "launch", false), "groupStarted")
      m.assertEqual(syncPlayQueue.noticeAtLoad("followingAgain", "launch", false), "followingAgain")
      m.assertEqual(syncPlayQueue.noticeAtLoad("", "launch", false), "")
    end function

    @it("a reload in place tells only a follow made again: the viewer is already watching with the group")
    function _()
      m.assertEqual(syncPlayQueue.noticeAtLoad("followingAgain", "remount", false), "followingAgain")
      m.assertEqual(syncPlayQueue.noticeAtLoad("groupStarted", "remount", false), "")
    end function

    @it("a load no frame decided is the group starting something")
    function _()
      m.assertEqual(syncPlayQueue.noticeAtLoad(invalid, "launch", false), "groupStarted")
    end function

  end class
end namespace
