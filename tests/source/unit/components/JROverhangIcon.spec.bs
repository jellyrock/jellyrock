namespace tests

  @suite("JROverhangIcon - Node interface and defaults")
  class JROverhangIconTests extends tests.BaseTestSuite

    private icon as object

    protected override function setup()
      super.setup()
      m.icon = CreateObject("roSGNode", "JROverhangIcon")
    end function

    protected override function teardown()
      m.icon = invalid
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Interface fields exist")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("has icon field")
    function _()
      m.assertTrue(m.icon.doesExist("icon"))
    end function

    @it("has actionId field")
    function _()
      m.assertTrue(m.icon.doesExist("actionId"))
    end function

    @it("has selectedAction field")
    function _()
      m.assertTrue(m.icon.doesExist("selectedAction"))
    end function

    @it("has requestFocusExit field")
    function _()
      m.assertTrue(m.icon.doesExist("requestFocusExit"))
    end function

    @it("has requestFocusReturn field")
    function _()
      m.assertTrue(m.icon.doesExist("requestFocusReturn"))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Default values")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("icon defaults to empty string")
    function _()
      m.assertEqual(m.icon.icon, "")
    end function

    @it("actionId defaults to empty string")
    function _()
      m.assertEqual(m.icon.actionId, "")
    end function

    @it("requestFocusReturn defaults to false")
    function _()
      m.assertFalse(m.icon.requestFocusReturn)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Child nodes exist")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("has buttonBackground poster")
    function _()
      m.assertNotInvalid(m.icon.findNode("buttonBackground"))
    end function

    @it("has buttonBorder poster")
    function _()
      m.assertNotInvalid(m.icon.findNode("buttonBorder"))
    end function

    @it("has buttonIcon poster")
    function _()
      m.assertNotInvalid(m.icon.findNode("buttonIcon"))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Initial visual state")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("buttonBackground is hidden by default")
    function _()
      m.assertFalse(m.icon.findNode("buttonBackground").visible)
    end function

    @it("buttonBorder is hidden by default")
    function _()
      m.assertFalse(m.icon.findNode("buttonBorder").visible)
    end function

    @it("buttonIcon is visible by default")
    function _()
      m.assertTrue(m.icon.findNode("buttonIcon").visible)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Button sizing")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("background is sized to 78x78")
    function _()
      bg = m.icon.findNode("buttonBackground")
      m.assertEqual(bg.width, 78.0)
      m.assertEqual(bg.height, 78.0)
    end function

    @it("border is sized to 78x78")
    function _()
      border = m.icon.findNode("buttonBorder")
      m.assertEqual(border.width, 78.0)
      m.assertEqual(border.height, 78.0)
    end function

    @it("icon poster is 42x42")
    function _()
      poster = m.icon.findNode("buttonIcon")
      m.assertEqual(poster.width, 42.0)
      m.assertEqual(poster.height, 42.0)
    end function

    @it("icon is centered at offset [18, 18] within the button")
    function _()
      poster = m.icon.findNode("buttonIcon")
      m.assertEqual(poster.translation, [18.0, 18.0])
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Icon URI updates")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("updates buttonIcon URI when icon field changes")
    function _()
      m.icon.icon = "pkg:/images/icons/search_$$RES$$.png"
      poster = m.icon.findNode("buttonIcon")
      m.assertEqual(poster.uri, "pkg:/images/icons/search_$$RES$$.png")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Glyph color")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    ' Each case builds its own icon: a field set here must not reach the next case.

    ' A color read back from a node is an RGBA integer; the theme constants are strings.
    ' Round-trip the expected one through a Poster so both sides read the same way.
    private function asBlend(color as dynamic) as dynamic
      p = CreateObject("roSGNode", "Poster")
      p.blendColor = color
      return p.blendColor
    end function

    @it("rests in colorTextSecondary")
    function _()
      icon = CreateObject("roSGNode", "JROverhangIcon")
      m.assertEqual(icon.findNode("buttonIcon").blendColor, m.asBlend(m.global.constants.colorTextSecondary))
    end function

    @it("takes colorTextPrimary and shows its ring when focused")
    function _()
      scene = m.top.getScene()
      icon = CreateObject("roSGNode", "JROverhangIcon")
      scene.appendChild(icon)
      icon.setFocus(true)
      color = icon.findNode("buttonIcon").blendColor
      ringShown = icon.findNode("buttonBorder").visible
      scene.removeChild(icon)
      m.assertEqual(color, m.asBlend(m.global.constants.colorTextPrimary))
      m.assertTrue(ringShown)
    end function

    @it("draws a disabled glyph in colorTextDisabled at rest")
    function _()
      icon = CreateObject("roSGNode", "JROverhangIcon")
      icon.isDisabled = true
      m.assertEqual(icon.findNode("buttonIcon").blendColor, m.asBlend(m.global.constants.colorTextDisabled))
    end function

    @it("keeps a disabled glyph in colorTextDisabled when focused, with its ring")
    function _()
      scene = m.top.getScene()
      icon = CreateObject("roSGNode", "JROverhangIcon")
      icon.isDisabled = true
      scene.appendChild(icon)
      icon.setFocus(true)
      color = icon.findNode("buttonIcon").blendColor
      ringShown = icon.findNode("buttonBorder").visible
      scene.removeChild(icon)
      m.assertEqual(color, m.asBlend(m.global.constants.colorTextDisabled))
      m.assertTrue(ringShown)
    end function

    @it("returns to colorTextSecondary when re-enabled")
    function _()
      icon = CreateObject("roSGNode", "JROverhangIcon")
      icon.isDisabled = true
      icon.isDisabled = false
      m.assertEqual(icon.findNode("buttonIcon").blendColor, m.asBlend(m.global.constants.colorTextSecondary))
    end function

  end class

end namespace
