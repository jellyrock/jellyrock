namespace tests

  ' What HomeRows asks the scene to show as the backdrop when focus moves. The scene manager
  ' is BaseTestSuite's MockSceneManager, which records each setBackgroundImage request.
  @suite("HomeRows - updateBackdropForFocusedItem()")
  class HomeRowsUpdateBackdropTests extends tests.BaseTestSuite

    protected homeRows as dynamic

    ' beforeEach, not setup: every test loads its own content (tests/CLAUDE.md).
    protected override function beforeEach()
      super.beforeEach()
      m.homeRows = CreateObject("roSGNode", "HomeRows")
      if not m.global.doesExist("activeRoutedView") then m.global.addField("activeRoutedView", "node", false)
      m.global.activeRoutedView = invalid
    end function

    protected override function afterEach()
      m.global.activeRoutedView = invalid
      m.homeRows = invalid
      super.afterEach()
    end function

    ' A row of items; each spec is { id, type, backdropTags } or a prebuilt node.
    private function makeRow(specs as object) as object
      row = CreateObject("roSGNode", "HomeRow")
      for each spec in specs
        item = CreateObject("roSGNode", "JellyfinBaseItem")
        item.setFields({ id: spec.id, type: spec.type })
        if isValid(spec.backdropTags) then item.backdropImageTags = spec.backdropTags
        row.appendChild(item)
      end for
      return row
    end function

    ' Loads rows, moves focus with jumpToRowItem (rowItemFocused is READ_ONLY on a RowList),
    ' checks focus really landed, then clears what the mock recorded on the way.
    private function focus(rows as object, indices as object)
      content = CreateObject("roSGNode", "ContentNode")
      for each row in rows
        content.appendChild(row)
      end for
      m.homeRows.content = content
      m.homeRows.jumpToRowItem = indices
      focused = m.homeRows.rowItemFocused
      m.assertEqual(focused[0], indices[0], "focus moved to the row")
      m.assertEqual(focused[1], indices[1], "focus moved to the item")
      m.global.sceneManager.setFields({ lastBackgroundImage: "<none>", backgroundImageWrites: 0 })
    end function

    private function lastWrite() as string
      return m.global.sceneManager.lastBackgroundImage
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("an item")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("shows the focused item's own backdrop")
    function _()
      m.focus([m.makeRow([{ id: "movie1", type: "Movie", backdropTags: ["tagA"] }])], [0, 0])
      m.homeRows.callFunc("updateBackdropForFocusedItem")
      m.assertEqual(m.global.sceneManager.backgroundImageWrites, 1)
      m.assertNotEqual(m.lastWrite().inStr("/Items/movie1/Images/Backdrop"), -1, m.lastWrite())
      m.assertNotEqual(m.lastWrite().inStr("tag=tagA"), -1, m.lastWrite())
    end function

    @it("follows focus to another row and item")
    function _()
      rows = [
        m.makeRow([{ id: "a", type: "Movie", backdropTags: ["tagA"] }]),
        m.makeRow([{ id: "b", type: "Movie", backdropTags: ["tagB"] }, { id: "c", type: "Movie", backdropTags: ["tagC"] }])
      ]
      m.focus(rows, [1, 1])
      m.homeRows.callFunc("updateBackdropForFocusedItem")
      m.assertNotEqual(m.lastWrite().inStr("/Items/c/Images/Backdrop"), -1, m.lastWrite())
    end function

    @it("clears the backdrop for an item with none")
    function _()
      m.focus([m.makeRow([{ id: "photo1", type: "Photo" }])], [0, 0])
      m.homeRows.callFunc("updateBackdropForFocusedItem")
      m.assertEqual(m.global.sceneManager.backgroundImageWrites, 1)
      m.assertEqual(m.lastWrite(), "")
    end function

    @it("clears the backdrop when the focused row was replaced by a shorter one")
    function _()
      m.focus([m.makeRow([{ id: "a", type: "Movie", backdropTags: ["t"] }, { id: "b", type: "Movie", backdropTags: ["t"] }])], [0, 1])
      m.homeRows.content.replaceChild(m.makeRow([{ id: "c", type: "Movie", backdropTags: ["t"] }]), 0)
      m.global.sceneManager.setFields({ lastBackgroundImage: "<none>", backgroundImageWrites: 0 })
      m.homeRows.callFunc("updateBackdropForFocusedItem")
      m.assertEqual(m.lastWrite(), "")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("a My Media tile")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("shows a library's own backdrop when it has one")
    function _()
      m.focus([m.makeRow([{ id: "lib1", type: "CollectionFolder", backdropTags: ["libTag"] }])], [0, 0])
      m.homeRows.callFunc("updateBackdropForFocusedItem")
      m.assertNotEqual(m.lastWrite().inStr("/Items/lib1/Images/Backdrop"), -1, m.lastWrite())
    end function

    @it("clears the backdrop while a library without one is looked up")
    function _()
      m.focus([m.makeRow([{ id: "lib2", type: "CollectionFolder" }])], [0, 0])
      m.homeRows.callFunc("updateBackdropForFocusedItem")
      m.assertEqual(m.global.sceneManager.backgroundImageWrites, 1)
      m.assertEqual(m.lastWrite(), "")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("another screen is in front")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("leaves the backdrop alone when Home is not the active view")
    function _()
      m.focus([m.makeRow([{ id: "movie1", type: "Movie", backdropTags: ["tagA"] }])], [0, 0])
      m.global.activeRoutedView = CreateObject("roSGNode", "ContentNode")
      m.homeRows.callFunc("updateBackdropForFocusedItem")
      m.assertEqual(m.global.sceneManager.backgroundImageWrites, 0)
    end function

  end class

end namespace
