namespace tests

  @suite("JRListDialog - interface and list construction")
  class JRListDialogTests extends tests.BaseTestSuite

    private dialog as object

    protected override function setup()
      super.setup()
      m.dialog = CreateObject("roSGNode", "JRListDialog")
    end function

    protected override function teardown()
      m.dialog = invalid
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Interface fields")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("exposes the standard dialog fields")
    function _()
      m.assertTrue(m.dialog.doesExist("items"))
      m.assertTrue(m.dialog.doesExist("title"))
      m.assertTrue(m.dialog.doesExist("defaultIndex"))
      m.assertTrue(m.dialog.doesExist("result"))
      m.assertTrue(m.dialog.doesExist("returnFocusTo"))
    end function

    @it("result starts unset")
    function _()
      m.assertInvalid(m.dialog.result)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("List construction")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("creates one content row per item")
    function _()
      m.dialog.items = ["English 5.1", "English Stereo", "Spanish"]
      content = m.dialog.findNode("content")
      m.assertEqual(content.getChildCount(), 3)
      m.assertEqual(content.getChild(0).title, "English 5.1")
      m.assertEqual(content.getChild(2).title, "Spanish")
    end function

    @it("rebuilds rows on reassignment instead of appending")
    function _()
      m.dialog.items = ["A", "B", "C", "D"]
      m.dialog.items = ["only"]
      content = m.dialog.findNode("content")
      m.assertEqual(content.getChildCount(), 1)
    end function

    @it("caps visible rows at 8 for long lists")
    function _()
      items = []
      for i = 1 to 20
        items.push("track " + i.toStr())
      end for
      m.dialog.items = items
      optionList = m.dialog.findNode("optionList")
      m.assertEqual(optionList.numRows, 8)
    end function

  end class

end namespace
