namespace tests

  @suite("JRDialog - interface, button row construction, result contract surface")
  class JRDialogTests extends tests.BaseTestSuite

    private dialog as object

    ' beforeEach, not setup: every test here MUTATES the dialog (buttons, focus,
    ' now a result), so a suite-scoped node would hand each test whatever the last
    ' one left behind. See tests/CLAUDE.md's lifecycle-hooks section.
    protected override function beforeEach()
      super.beforeEach()
      m.dialog = CreateObject("roSGNode", "JRDialog")
    end function

    protected override function afterEach()
      ' Tests that append to the scene remove it themselves; this covers the ones
      ' that fault before they get there.
      parent = m.dialog.getParent()
      if isValid(parent) then parent.removeChild(m.dialog)
      m.dialog = invalid
      super.afterEach()
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Interface fields")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("exposes the standard dialog fields")
    function _()
      m.assertTrue(m.dialog.doesExist("title"))
      m.assertTrue(m.dialog.doesExist("message"))
      m.assertTrue(m.dialog.doesExist("subheading"))
      m.assertTrue(m.dialog.doesExist("buttons"))
      m.assertTrue(m.dialog.doesExist("result"))
      m.assertTrue(m.dialog.doesExist("returnFocusTo"))
    end function

    @it("confirmIndex defaults to -1 (no confirm semantics unless a helper sets it)")
    function _()
      m.assertEqual(m.dialog.confirmIndex, -1)
    end function

    @it("defaultButtonIndex defaults to 0")
    function _()
      m.assertEqual(m.dialog.defaultButtonIndex, 0)
    end function

    @it("result starts unset")
    function _()
      m.assertInvalid(m.dialog.result)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Button row construction")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("creates one TextButton per label")
    function _()
      m.dialog.buttons = ["Cancel", "Delete"]
      row = m.dialog.findNode("buttonRow")
      m.assertEqual(row.getChildCount(), 2)
      m.assertEqual(row.getChild(0).subtype(), "TextButton")
      m.assertEqual(row.getChild(0).text, "Cancel")
      m.assertEqual(row.getChild(1).text, "Delete")
    end function

    @it("rebuilds the row on reassignment instead of appending")
    function _()
      m.dialog.buttons = ["A", "B", "C"]
      m.dialog.buttons = ["OK"]
      row = m.dialog.findNode("buttonRow")
      m.assertEqual(row.getChildCount(), 1)
      m.assertEqual(row.getChild(0).text, "OK")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Focus on open")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("a button holds focus after the present sequence")
    function _()
      ' Mirrors source/utils/dialogs.bs presentOverlayDialog. A dialog whose
      ' buttons are unfocused swallows OK, so this is the contract that makes the
      ' button row usable at all.
      scene = m.top.getScene()
      m.assertNotInvalid(scene)

      m.dialog.title = "Delete"
      m.dialog.message = "Are you sure?"
      m.dialog.buttons = ["Cancel", "Delete"]

      scene.appendChild(m.dialog)
      m.dialog.setFocus(true)

      row = m.dialog.findNode("buttonRow")
      anyFocused = row.getChild(0).hasFocus() or row.getChild(1).hasFocus()
      scene.removeChild(m.dialog)

      m.assertTrue(anyFocused)
    end function

    @it("defaultButtonIndex decides which button opens focused")
    function _()
      ' showConfirmDialog relies on this to focus the SAFE side by default
      scene = m.top.getScene()
      m.dialog.message = "Are you sure?"
      m.dialog.defaultButtonIndex = 1
      m.dialog.buttons = ["Cancel", "Delete"]

      scene.appendChild(m.dialog)
      m.dialog.setFocus(true)

      row = m.dialog.findNode("buttonRow")
      secondFocused = row.getChild(1).hasFocus()
      scene.removeChild(m.dialog)

      m.assertTrue(secondFocused)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Subheading")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("has no subheading by default")
    function _()
      m.assertEqual(m.dialog.subheading, "")
      m.assertEqual(m.dialog.findNode("subheadingText").text, "")
    end function

    ' The subheading is a lead-in to the body, not a second title: it renders
    ' BELOW the accent rule and ABOVE the message. Asserted against the rendered
    ' translations rather than the layout function, which is gated separately —
    ' this is the wiring between them.
    @it("renders above the message when set")
    function _()
      scene = m.top.getScene()
      m.dialog.title = "Message from another device"
      m.dialog.subheading = "Server maintenance"
      m.dialog.message = "The server will restart in five minutes."
      m.dialog.buttons = ["OK"]

      scene.appendChild(m.dialog)
      m.dialog.setFocus(true)

      subheadingNode = m.dialog.findNode("subheadingText")
      messageNode = m.dialog.findNode("messageText")
      subheadingY = subheadingNode.translation[1]
      messageY = messageNode.translation[1]
      renderedText = subheadingNode.text
      scene.removeChild(m.dialog)

      m.assertEqual(renderedText, "Server maintenance")
      m.assertTrue(subheadingY > 0, "subheading was never positioned")
      m.assertTrue(subheadingY < messageY, "subheading must render above the message")
    end function

    ' It is BOLD because that is the only thing separating it from the body — it
    ' shares the body's size, colour and centring. Losing the weight would leave
    ' two indistinguishable lines.
    @it("renders bold, to distinguish it from the body it leads")
    function _()
      m.assertTrue(m.dialog.findNode("subheadingText").isBold)
      m.assertFalse(m.dialog.findNode("messageText").isBold)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("cancelDialog — third-party dismissal")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    ' Cancelling from outside has to be indistinguishable from the user pressing
    ' Back, or a main-thread flow holding state until its dialog answers is
    ' stranded. See cancelOpenDialog() in source/utils/dialogs.bs.
    @it("delivers a cancelled result and closes")
    function _()
      scene = m.top.getScene()
      m.dialog.message = "Are you sure?"
      m.dialog.buttons = ["Cancel", "Delete"]
      scene.appendChild(m.dialog)

      m.dialog.callFunc("cancelDialog")

      m.assertNotInvalid(m.dialog.result)
      m.assertTrue(m.dialog.result.cancelled)
      m.assertFalse(m.dialog.result.confirmed)
      m.assertEqual(m.dialog.result.buttonIndex, -1)
      m.assertInvalid(m.dialog.getParent())
    end function

    ' Indistinguishable in what it DELIVERS, not in where it came from. A handler
    ' that ACTS on its result (VideoPlayerView's playback-error alert leaves the
    ' play route) must be able to decline a close the user did not make, or
    ' presentOverlayDialog's supersede fires that action from inside the mount of
    ' the dialog replacing it.
    ' Only the cancelDialog() path is reachable from a spec — onKeyEvent is not in
    ' the <interface>, so a callFunc to it would silently do nothing. The
    ' user-resolution side (every other route leaves the key false) is gated
    ' where it is reachable, on the pure builders in dialogResult.spec.bs.
    @it("records that the close came from code")
    function _()
      scene = m.top.getScene()
      m.dialog.buttons = ["Cancel", "Delete"]
      scene.appendChild(m.dialog)

      m.dialog.callFunc("cancelDialog")

      m.assertTrue(m.dialog.result.externallyCancelled)
    end function

    @it("is once-only, like every other route out of the dialog")
    function _()
      scene = m.top.getScene()
      m.dialog.confirmIndex = 1
      m.dialog.buttons = ["Cancel", "Delete"]
      scene.appendChild(m.dialog)

      m.dialog.callFunc("cancelDialog")
      ' A second cancel (or a resolve racing it) must not overwrite the first
      m.dialog.callFunc("cancelDialog")

      m.assertTrue(m.dialog.result.cancelled)
    end function

  end class

end namespace
