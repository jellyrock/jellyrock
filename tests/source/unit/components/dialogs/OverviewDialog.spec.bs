import "pkg:/source/utils/dialogLayout.bs"

namespace tests

  @suite("OverviewDialog - geometry against the screen")
  class OverviewDialogTests extends tests.BaseTestSuite

    private dialog as object

    ' beforeEach, not setup: the node is laid out and read per test, so a
    ' per-suite one would hand each test whatever the last left behind
    ' (tests/CLAUDE.md).
    protected override function beforeEach()
      super.beforeEach()
      m.dialog = CreateObject("roSGNode", "OverviewDialog")
    end function

    protected override function afterEach()
      m.dialog = invalid
      super.afterEach()
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("fitting on screen")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    ' This dialog's OK button used to sit OUTSIDE the panel, which meant the panel
    ' ceiling never bounded it — a panel at PANEL_MAX_HEIGHT put a 72px button
    ' 18px off the bottom of the screen and reported a fit. Flowing it inside is
    ' what removed that failure mode outright: the button is part of the panel
    ' height now, so one ceiling covers both.
    '
    ' Read from the RENDERED nodes throughout. The component's geometry constants
    ' are file-scoped and unreachable from a spec, so an assertion against a
    ' literal copy of them would pass while the rendered dialog was wrong.
    @it("flows its OK button INSIDE the panel, like the rest of the family")
    function _()
      panel = m.dialog.findNode("panelBackground")
      m.assertNotInvalid(panel)
      m.assertTrue(panel.height > 0, "panel has not been laid out; the rest of this test would assert nothing")

      okButton = m.dialog.findNode("okButton")
      m.assertNotInvalid(okButton)
      buttonHeight = int(okButton.localBoundingRect().height)
      m.assertTrue(buttonHeight > 0, "the OK button has not been laid out; the rest of this test would assert nothing")

      ' TRANSLATION, not localBoundingRect().y — the rect is in the button's own
      ' local space, so its y is 0 and comparing it against the panel's placed
      ' position says nothing. Both nodes are children of the dialog root, so
      ' their translations are directly comparable.
      panelTop = int(panel.translation[1])
      panelBottom = panelTop + int(panel.height)
      buttonTop = int(okButton.translation[1])
      buttonBottom = buttonTop + buttonHeight

      ' Read from the RENDERED nodes, not from the component's file-scoped
      ' constants, which a spec cannot reach — same reason the panel-ceiling
      ' assertion below reads panel.width/height rather than passing 1602/762.
      m.assertTrue(buttonTop >= panelTop, "OK button starts above the panel top")
      m.assertTrue(buttonBottom <= panelBottom, "OK button extends past the panel bottom; it is no longer inside the panel")
    end function

    ' The panel is CONTENT-DERIVED now, so "does it fit" is a question about the
    ' rendered panel rather than about a constant. Read the panel the component
    ' actually produced for this content and check it against the screen.
    @it("keeps its rendered panel on screen, footer included")
    function _()
      panel = m.dialog.findNode("panelBackground")
      m.assertTrue(panel.height > 0, "panel has not been laid out; the rest of this test would assert nothing")

      panelTop = int(panel.translation[1])
      m.assertTrue(panelTop >= 0, "panel starts above the top of the screen")
      m.assertTrue(panelTop + int(panel.height) <= 1080, "panel extends past the bottom of the screen")
      m.assertTrue(int(panel.height) <= PANEL_MAX_HEIGHT, "panel is over the ceiling the flow is supposed to clamp it to")
    end function

    ' The point of content-sizing: a short body must NOT produce the old fixed
    ' 762px panel. Without this, reverting to a fixed height would pass every
    ' other assertion here.
    @it("sizes the panel to its content rather than to a fixed height")
    function _()
      panel = m.dialog.findNode("panelBackground")
      m.assertTrue(panel.height > 0, "panel has not been laid out; the rest of this test would assert nothing")

      m.assertTrue(int(panel.height) < 762, "panel is not smaller than the old fixed height for a short body")
    end function

    @it("centres its panel on screen and keeps it on the 720p grid")
    function _()
      panel = m.dialog.findNode("panelBackground")

      ' translation is a float vector — int() first, so this compares integers
      ' rather than asking mod to do it.
      left = int(panel.translation[0])
      top = int(panel.translation[1])
      right = left + int(panel.width)

      m.assertEqual(left mod 3, 0, "panel left edge off the output grid at x=" + left.toStr())
      m.assertEqual(top mod 3, 0, "panel top edge off the output grid at y=" + top.toStr())
      m.assertEqual(right mod 3, 0, "panel right edge off the output grid at x=" + right.toStr())
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("chrome")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("takes its chrome from JRDialogPanel rather than its own nodes")
    function _()
      chrome = m.dialog.findNode("chrome")
      m.assertNotInvalid(chrome)
      m.assertEqual(chrome.subtype(), "JRDialogPanel")
      ' The panel owns these now; a copy here would be the divergence returning
      m.assertInvalid(m.dialog.findNode("separator"))
      m.assertInvalid(m.dialog.findNode("dialogBackground"))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("cancelDialog — third-party dismissal")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    ' This dialog is read-only and has no `result` field, so cancelling it is
    ' exactly closing it. It still needs the function: cancelOpenDialog() reaches
    ' whatever overlay is open by the shared id and cannot know which kind it is.
    @it("closes, having no result to deliver")
    function _()
      scene = m.top.getScene()
      m.dialog.title = "Overview"
      m.dialog.overview = "A description."
      scene.appendChild(m.dialog)

      m.dialog.callFunc("cancelDialog")

      m.assertInvalid(m.dialog.getParent())
    end function

  end class
end namespace
