import "pkg:/source/remotecontrol/remoteCommand.bs"
import "pkg:/source/utils/appWaits.bs"

namespace tests

  ' The coordinator node driven by frames on `frame`, as remoteDispatch writes them, and by
  ' playerEvent() as the host calls it. No player and no server: what is asserted is the state
  ' the node publishes and the gates it applies before anything reaches a player.
  @suite("SyncPlayManager - frames, published state, held commands and the halt")
  class SyncPlayManagerTests extends tests.BaseTestSuite

    private manager as object
    private previousView as object
    private previousServerUrl as string
    private previousQueue as object
    private previousSideEffectTask as object
    private isCapturingPosts as boolean

    ' beforeEach, not setup: every test moves the node's state (tests/CLAUDE.md).
    protected override function beforeEach()
      super.beforeEach()
      if not m.global.doesExist("activeRoutedView") then m.global.addField("activeRoutedView", "node", false)
      m.previousView = m.global.activeRoutedView
      m.global.activeRoutedView = invalid
      ' No server: a GroupJoined then starts no time-sync burst, so no request leaves the device.
      m.previousServerUrl = m.global.server.serverUrl
      m.global.server.serverUrl = ""
      ' The manager reads the playing queue item at a mount: a fresh queue per test.
      if not m.global.doesExist("queueManager") then m.global.addField("queueManager", "node", false)
      m.previousQueue = m.global.queueManager
      m.global.queueManager = CreateObject("roSGNode", "QueueManager")
      m.manager = CreateObject("roSGNode", "SyncPlayManager")
      m.isCapturingPosts = false
    end function

    protected override function afterEach()
      m.manager.callFunc("reset")
      m.manager = invalid
      ' Here rather than in the test, so a failed assertion cannot leave the capture in place.
      if m.isCapturingPosts then m.global.sideEffectTask = m.previousSideEffectTask
      m.previousSideEffectTask = invalid
      m.global.queueManager = m.previousQueue
      m.previousQueue = invalid
      m.global.server.serverUrl = m.previousServerUrl
      m.global.activeRoutedView = m.previousView
      m.previousView = invalid
      super.afterEach()
    end function

    private function update(updateType as string, inner as dynamic) as object
      return remoteCommand.parseMessage({ MessageType: "SyncPlayGroupUpdate", Data: { GroupId: "g1", Type: updateType, Data: inner } })
    end function

    private function command(name as string, playlistItemId = "p1" as string) as object
      data = { GroupId: "g1", PlaylistItemId: playlistItemId, When: "2026-10-23T20:47:40.000Z", Command: name, PositionTicks: 0, EmittedAt: "2026-10-23T20:47:30.000Z" }
      return remoteCommand.parseMessage({ MessageType: "SyncPlayCommand", Data: data })
    end function

    private sub joinGroup()
      m.manager.frame = m.update("GroupJoined", { GroupId: "g1", GroupName: "Movie night", State: "Idle", Participants: ["ann"], LastUpdatedAt: "2026-10-23T20:47:20.500Z" })
    end sub

    ' The group plays p-1, and the local queue's current item is p-1 (what applyQueue builds; with
    ' no server the manager's own fetch builds nothing).
    private sub playGroupItem(localPlaylistItemId = "p1" as string)
      m.manager.frame = m.update("PlayQueue", { Reason: "NewPlaylist", LastUpdate: "2026-10-23T20:47:25.000Z", Playlist: [{ ItemId: "i1", PlaylistItemId: "p1" }, { ItemId: "i2", PlaylistItemId: "p2" }], PlayingItemIndex: 0, StartPositionTicks: 0 })
      queueItem = { id: "i1", type: "Movie" }
      if localPlaylistItemId <> "" then queueItem.syncPlayPlaylistItemId = localPlaylistItemId
      m.global.queueManager.callFunc("set", [queueItem])
    end sub

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Published state")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("starts outside any group, not following")
    function _()
      m.assertFalse(m.manager.inGroup)
      m.assertFalse(m.manager.following)
      m.assertEqual(m.manager.groupId, "")
      m.assertFalse(m.manager.sync.hasEstimate)
    end function

    @it("GroupJoined publishes the group and follows")
    function _()
      m.joinGroup()
      m.assertTrue(m.manager.inGroup)
      m.assertTrue(m.manager.following)
      m.assertEqual(m.manager.groupId, "g1")
      m.assertEqual(m.manager.groupName, "Movie night")
      m.assertEqual(m.manager.groupState, "Idle")
    end function

    @it("StateUpdate publishes the group state")
    function _()
      m.joinGroup()
      m.manager.frame = m.update("StateUpdate", { State: "Playing", Reason: "Unpause" })
      m.assertEqual(m.manager.groupState, "Playing")
    end function

    @it("GroupLeft and NotInGroup return to the fresh state")
    function _()
      m.joinGroup()
      m.manager.frame = m.update("GroupLeft", invalid)
      m.assertFalse(m.manager.inGroup)
      m.assertFalse(m.manager.following)
      m.assertEqual(m.manager.groupId, "")

      m.joinGroup()
      m.manager.frame = m.update("NotInGroup", invalid)
      m.assertFalse(m.manager.inGroup)
    end function

    @it("reset() forgets the group")
    function _()
      m.joinGroup()
      m.manager.callFunc("reset")
      m.assertFalse(m.manager.inGroup)
      m.assertEqual(m.manager.groupName, "")
    end function

    @it("a frame with no kind, or no frame, changes nothing")
    function _()
      m.joinGroup()
      m.manager.frame = { raw: "x" }
      m.manager.frame = invalid
      m.assertTrue(m.manager.inGroup)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("The interface")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("newGroup refuses an empty name, and leave() outside a group does nothing")
    function _()
      m.assertFalse(m.manager.callFunc("newGroup", ""))
      m.assertFalse(m.manager.callFunc("leave"))
    end function

    @it("with no server there is no request to post, so newGroup and join return false")
    function _()
      m.assertFalse(m.manager.callFunc("newGroup", "ann"))
      m.assertFalse(m.manager.callFunc("join", "g1"))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Notices")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("GroupJoined tells the viewer the group they joined")
    function _()
      m.assertInvalid(m.manager.notice)
      m.joinGroup()
      m.assertEqual(m.manager.notice.kind, "joined")
      m.assertEqual(m.manager.notice.groupName, "Movie night")
    end function

    @it("GroupLeft names the group just left; NotInGroup outside any group says nothing")
    function _()
      m.manager.frame = m.update("NotInGroup", invalid)
      m.assertInvalid(m.manager.notice)
      m.joinGroup()
      m.manager.frame = m.update("GroupLeft", invalid)
      m.assertEqual(m.manager.notice.kind, "left")
      m.assertEqual(m.manager.notice.groupName, "Movie night")
    end function

    @it("UserJoined and UserLeft carry the member's name")
    function _()
      m.joinGroup()
      m.manager.frame = m.update("UserJoined", "bob")
      m.assertEqual(m.manager.notice.kind, "userJoined")
      m.assertEqual(m.manager.notice.userName, "bob")
      m.manager.frame = m.update("UserLeft", "bob")
      m.assertEqual(m.manager.notice.kind, "userLeft")
    end function

    @it("a refusal is passed on by its update type")
    function _()
      m.manager.frame = m.update("JoinGroupDenied", invalid)
      m.assertEqual(m.manager.notice.kind, "JoinGroupDenied")
      m.manager.frame = m.update("GroupDoesNotExist", invalid)
      m.assertEqual(m.manager.notice.kind, "GroupDoesNotExist")
    end function

    @it("a halt while following says so once; a halt while already halted says nothing more")
    function _()
      m.joinGroup()
      m.playGroupItem()
      m.manager.callFunc("playerEvent", { kind: "unmounted" })
      m.assertEqual(m.manager.notice.kind, "halted")
      m.manager.notice = invalid
      m.manager.callFunc("playerEvent", { kind: "unmounted" })
      m.assertInvalid(m.manager.notice)
    end function

    @it("the queue that answers a join to a playing group is the join's: its load says nothing more")
    function _()
      ' A 12.2 server answers a join to a playing or paused group with the queue before any
      ' command (WaitingGroupState.SessionJoined), so Joined is the one toast.
      m.joinGroup()
      m.playGroupItem()
      m.assertEqual(m.manager.notice.kind, "joined")
      m.assertEqual(m.manager.sync.loadNotice, "")
    end function

    @it("a queue after an idle group's Stop is the group starting something")
    function _()
      ' An idle group answers a join with a Stop and no queue: a later queue is another member's.
      m.joinGroup()
      m.manager.frame = m.command("Stop")
      m.playGroupItem()
      m.assertEqual(m.manager.sync.loadNotice, "groupStarted")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("The viewer's time offset")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("the SyncPlay Time Offset setting reaches the clock at each frame and each player event, and is published")
    function _()
      settings = m.global.user.settings
      before = settings.playbackSyncPlayTimeOffsetMs
      settings.playbackSyncPlayTimeOffsetMs = 250
      m.joinGroup()
      m.assertEqual(m.manager.sync.extraOffsetMs, 250&)
      settings.playbackSyncPlayTimeOffsetMs = 0
      m.manager.callFunc("playerEvent", { kind: "position", position: 1.0 })
      m.assertEqual(m.manager.sync.extraOffsetMs, 0&)
      settings.playbackSyncPlayTimeOffsetMs = before
    end function

    @it("the drift is unknown until an Unpause is in force")
    function _()
      m.joinGroup()
      m.playGroupItem()
      m.manager.callFunc("playerEvent", { kind: "mounted" })
      m.manager.callFunc("playerEvent", { kind: "state", state: "playing", position: 12.5 })
      m.manager.callFunc("playerEvent", { kind: "position", position: 13.0 })
      m.assertInvalid(m.manager.sync.playbackDiffMs)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Commands")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("a command before the clock offset is known is held, not applied")
    function _()
      m.joinGroup()
      m.manager.frame = m.update("PlayQueue", { Reason: "NewPlaylist", LastUpdate: "2026-10-23T20:47:25.000Z", Playlist: [{ ItemId: "i1", PlaylistItemId: "p1" }], PlayingItemIndex: 0, StartPositionTicks: 0 })
      m.manager.frame = m.command("Pause")
      m.assertInvalid(m.manager.sync.lastCommand)
    end function

    @it("the join sequence the 12.2 server sends (GroupJoined, a Stop, then the new queue) makes the queue's item the playing one")
    function _()
      ' Recorded over the session socket against a 12.2.0 server, 2026-10-23.
      m.manager.frame = remoteCommand.parseMessage({ MessageType: "SyncPlayGroupUpdate", Data: { GroupId: "g1", Data: { GroupId: "g1", GroupName: "capture", State: "Idle", Participants: ["jellyrock"], LastUpdatedAt: "2026-10-24T01:17:33.6881879Z" }, Type: "GroupJoined" } })
      m.manager.frame = remoteCommand.parseMessage({ MessageType: "SyncPlayCommand", Data: { GroupId: "g1", PlaylistItemId: "00000000000000000000000000000000", When: "2026-10-24T01:17:33.6085654Z", PositionTicks: 0, Command: "Stop", EmittedAt: "2026-10-24T01:17:33.6883144Z" } })
      m.manager.frame = remoteCommand.parseMessage({ MessageType: "SyncPlayGroupUpdate", Data: { GroupId: "g1", Data: { Reason: "NewPlaylist", LastUpdate: "2026-10-24T01:17:35.3172014Z", Playlist: [{ ItemId: "i1", PlaylistItemId: "p1" }], PlayingItemIndex: 0, StartPositionTicks: 0, IsPlaying: false, ShuffleMode: "Sorted", RepeatMode: "RepeatNone" }, Type: "PlayQueue" } })
      m.assertTrue(m.manager.inGroup)
      m.assertEqual(m.manager.sync.playingItemId, "p1")
    end function

    @it("a command outside any group is dropped")
    function _()
      m.manager.frame = m.command("Pause")
      m.assertInvalid(m.manager.sync.lastCommand)
      m.assertFalse(m.manager.inGroup)
    end function

    @it("a command while halted is recorded, not held for the player")
    function _()
      m.joinGroup()
      m.playGroupItem()
      m.manager.callFunc("playerEvent", { kind: "mounted" })
      m.manager.callFunc("playerEvent", { kind: "unmounted" })
      m.assertFalse(m.manager.following)
      ' Held, it would read invalid here (the first test above): recorded, it is the last command.
      m.manager.frame = m.command("Pause")
      m.assertNotInvalid(m.manager.sync.lastCommand)
      m.assertEqual(m.manager.sync.lastCommand.command, "Pause")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("playerEvent()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("answers with whether the host should defer to the group")
    function _()
      ret = m.manager.callFunc("playerEvent", { kind: "mounted" })
      m.assertFalse(ret.following)
      m.joinGroup()
      m.playGroupItem()
      ret = m.manager.callFunc("playerEvent", { kind: "mounted" })
      m.assertTrue(ret.following)
    end function

    @it("a mount of the group's item while following starts the ready tracker")
    function _()
      m.joinGroup()
      m.playGroupItem()
      m.manager.callFunc("playerEvent", { kind: "mounted" })
      m.assertEqual(m.manager.sync.trackerPhase, "loading")
      m.manager.callFunc("playerEvent", { kind: "state", state: "playing", position: 12.5 })
      m.assertEqual(m.manager.sync.trackerPhase, "ready")
    end function

    @it("a phase change that sends no report still reaches the published phase")
    function _()
      m.joinGroup()
      m.playGroupItem()
      m.manager.callFunc("playerEvent", { kind: "mounted" })
      m.manager.callFunc("playerEvent", { kind: "state", state: "playing", position: 12.5 })
      m.assertEqual(m.manager.sync.trackerPhase, "ready")
      m.manager.callFunc("playerEvent", { kind: "state", state: "buffering", position: 12.5 })
      m.assertEqual(m.manager.sync.trackerPhase, "stalling")
      m.manager.callFunc("playerEvent", { kind: "state", state: "playing", position: 12.5 })
      m.assertEqual(m.manager.sync.trackerPhase, "ready")
    end function

    @it("a mount of anything else halts: what the viewer started plays as their own")
    function _()
      m.joinGroup()
      m.playGroupItem("")
      ret = m.manager.callFunc("playerEvent", { kind: "mounted" })
      m.assertFalse(ret.following)
      m.assertTrue(m.manager.inGroup)
      m.assertEqual(m.manager.sync.trackerPhase, "idle")
    end function

    @it("a mount while the group plays nothing halts too")
    function _()
      m.joinGroup()
      m.global.queueManager.callFunc("set", [{ id: "i9", type: "Movie" }])
      m.manager.callFunc("playerEvent", { kind: "mounted" })
      m.assertFalse(m.manager.following)
    end function

    @it("an unmount nobody asked for halts: the member stays in the group but stops following")
    function _()
      m.joinGroup()
      m.playGroupItem()
      m.manager.callFunc("playerEvent", { kind: "mounted" })
      m.manager.callFunc("playerEvent", { kind: "unmounted" })
      m.assertTrue(m.manager.inGroup)
      m.assertFalse(m.manager.following)
      m.assertEqual(m.manager.sync.trackerPhase, "idle")
    end function

    @it("a finished item does not excuse the next unmount: Back while NextItem goes unanswered still halts")
    function _()
      m.joinGroup()
      m.playGroupItem()
      m.manager.callFunc("playerEvent", { kind: "mounted" })
      m.manager.callFunc("playerEvent", { kind: "finished" })
      m.manager.callFunc("playerEvent", { kind: "unmounted" })
      m.assertTrue(m.manager.inGroup)
      m.assertFalse(m.manager.following)
    end function

    @it("player events outside a group change nothing")
    function _()
      m.manager.callFunc("playerEvent", { kind: "mounted" })
      m.manager.callFunc("playerEvent", { kind: "unmounted" })
      m.assertFalse(m.manager.inGroup)
      m.assertEqual(m.manager.sync.trackerPhase, "idle")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Plays go to the group (claimPlay)")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    ' A server URL after the join and after any queue frame, so a post builds its request: the
    ' join must not start a time-sync burst, and a queue frame must not start a fetch (its
    ' promise runs where no pool answers). Nothing leaves the device: the suite has no
    ' side-effect task.
    private sub enableServer()
      m.global.server.serverUrl = "http://localhost:8096"
    end sub

    private sub joinGroupWithServer()
      m.joinGroup()
      m.enableServer()
    end sub

    ' A member that left the group's item: halted, and so ignoring the group's wait.
    private sub haltWithServer()
      m.joinGroup()
      m.playGroupItem()
      m.manager.callFunc("playerEvent", { kind: "mounted" })
      m.manager.callFunc("playerEvent", { kind: "unmounted" })
      m.enableServer()
    end sub

    ' Stands in for SideEffectTask, so the posts the manager submits can be read in the order
    ' they would be sent (the task is FIFO). afterEach puts the real one back.
    private function capturePosts() as object
      if not m.global.doesExist("sideEffectTask") then m.global.addField("sideEffectTask", "node", false)
      m.previousSideEffectTask = m.global.sideEffectTask
      m.isCapturingPosts = true
      ' A plain Node: a ContentNode counts an ApiResultNode child but getChild() returns invalid.
      posts = CreateObject("roSGNode", "Node")
      posts.addField("enqueue", "string", true)
      m.global.sideEffectTask = posts
      return posts
    end function

    private function lastPost(posts as object) as object
      return posts.getChild(posts.getChildCount() - 1).request
    end function

    ' The viewer's own queue: fresh items, no playlist stamp (every launcher clears the queue).
    private sub pressPlay(queueItems as object)
      m.global.queueManager.callFunc("set", queueItems)
      m.global.queueManager.callFunc("setPosition", 0)
    end sub

    @it("outside a group a play is the viewer's own")
    function _()
      m.pressPlay([{ id: "i9", type: "Movie" }])
      m.assertFalse(m.manager.callFunc("claimPlay"))
    end function

    @it("in a group a video play is handed over, told, and no local player starts")
    function _()
      m.joinGroupWithServer()
      m.manager.notice = invalid
      m.pressPlay([{ id: "i9", type: "Movie" }])
      m.assertTrue(m.manager.callFunc("claimPlay"))
      m.assertEqual(m.manager.notice.kind, "playedToGroup")
      m.assertEqual(m.manager.notice.groupName, "Movie night")
    end function

    @it("QueueManager.playQueue launches nothing for a play the group took")
    function _()
      if not m.global.doesExist("syncPlayManager") then m.global.addField("syncPlayManager", "node", false)
      previousManager = m.global.syncPlayManager
      m.global.syncPlayManager = m.manager
      if not m.global.doesExist("playbackLaunchRequest") then m.global.addField("playbackLaunchRequest", "assocarray", false)
      m.global.playbackLaunchRequest = invalid
      m.joinGroupWithServer()
      m.pressPlay([{ id: "i9", type: "Movie" }])
      m.global.queueManager.callFunc("playQueue")
      m.assertInvalid(m.global.playbackLaunchRequest)
      m.global.syncPlayManager = previousManager
    end function

    @it("the manager's own group load is not handed back: its current item carries the group's playing id")
    function _()
      m.joinGroup()
      m.playGroupItem()
      m.enableServer()
      m.assertFalse(m.manager.callFunc("claimPlay"))
    end function

    @it("a queue the player could not follow plays locally even in a group")
    function _()
      m.joinGroupWithServer()
      m.pressPlay([{ id: "a-1", type: "Audio" }])
      m.assertFalse(m.manager.callFunc("claimPlay"))
    end function

    @it("with no server nothing is posted, so the play is the viewer's own")
    function _()
      m.joinGroup()
      m.pressPlay([{ id: "i9", type: "Movie" }])
      m.assertFalse(m.manager.callFunc("claimPlay"))
    end function

    @it("a halted member's own play follows the group again, with one notice")
    function _()
      m.joinGroup()
      m.playGroupItem()
      m.manager.callFunc("playerEvent", { kind: "mounted" })
      m.manager.callFunc("playerEvent", { kind: "unmounted" })
      m.enableServer()
      m.assertFalse(m.manager.following)
      m.manager.notice = invalid
      m.pressPlay([{ id: "i9", type: "Movie" }])
      m.assertTrue(m.manager.callFunc("claimPlay"))
      m.assertTrue(m.manager.following)
      m.assertEqual(m.manager.notice.kind, "playedToGroup")
    end function

    @it("a halted member is waited on again before its play reaches the group")
    function _()
      ' The server marks every member buffering on a new queue, but its wait skips a member
      ' still ignoring it: SetIgnoreWait(false) has to land first. Posts leave in order
      ' (SideEffectTask is FIFO), so the order they are submitted in is the order sent.
      posts = m.capturePosts()
      m.haltWithServer()
      m.pressPlay([{ id: "i9", type: "Movie" }])
      m.manager.callFunc("claimPlay", promises.create())
      count = posts.getChildCount()
      m.assertEqual(count, 2)
      m.assertTrue(posts.getChild(0).request.url.instr("/SyncPlay/SetIgnoreWait") >= 0, "first: SetIgnoreWait")
      m.assertTrue(posts.getChild(1).request.url.instr("/SyncPlay/SetNewQueue") >= 0, "then: SetNewQueue")
    end function

    @it("the group's answer to a handed play is loaded without a group-started notice")
    function _()
      m.joinGroupWithServer()
      m.pressPlay([{ id: "i9", type: "Movie" }])
      m.manager.callFunc("claimPlay")
      m.manager.notice = invalid
      m.global.server.serverUrl = ""
      ' With no server the fetch builds nothing, so the load never runs here: what is checked is
      ' that the claim survives to the update and the update is accepted (the playing item moves).
      m.manager.frame = m.update("PlayQueue", { Reason: "NewPlaylist", LastUpdate: "2026-10-23T20:47:25.000Z", Playlist: [{ ItemId: "i9", PlaylistItemId: "p9" }], PlayingItemIndex: 0, StartPositionTicks: 0 })
      m.assertEqual(m.manager.sync.playingItemId, "p9")
      m.assertInvalid(m.manager.notice)
    end function

    @it("a refusal after a handed play ends the start the press opened")
    function _()
      m.joinGroupWithServer()
      m.pressPlay([{ id: "i9", type: "Movie" }])
      start = promises.create()
      m.assertTrue(m.manager.callFunc("claimPlay", start))
      m.assertTrue(appWaits.isOpen(start), "the start stays open across the round trip")
      m.manager.frame = m.update("LibraryAccessDenied", invalid)
      m.assertEqual(m.manager.notice.kind, "LibraryAccessDenied")
      m.assertTrue(m.manager.inGroup)
      m.assertEqual(start.promiseState, "rejected")
    end function

    @it("a halt or a leave after a handed play ends the start the press opened")
    function _()
      m.joinGroup()
      m.playGroupItem()
      m.manager.callFunc("playerEvent", { kind: "mounted" })
      m.enableServer()
      m.pressPlay([{ id: "i9", type: "Movie" }])
      halted = promises.create()
      m.manager.callFunc("claimPlay", halted)
      m.manager.callFunc("playerEvent", { kind: "unmounted" })
      m.assertFalse(m.manager.following)
      m.assertEqual(halted.promiseState, "rejected")

      m.pressPlay([{ id: "i9", type: "Movie" }])
      leaving = promises.create()
      m.manager.callFunc("claimPlay", leaving)
      m.manager.frame = m.update("GroupLeft", invalid)
      m.assertEqual(leaving.promiseState, "rejected")
    end function

    @it("a halted member's refused play halts it again, so the group stops waiting on it")
    function _()
      posts = m.capturePosts()
      m.haltWithServer()
      m.pressPlay([{ id: "i9", type: "Movie" }])
      m.manager.callFunc("claimPlay", promises.create())
      m.assertTrue(m.manager.following, "the press follows again, so the group waits on it")
      m.manager.frame = m.update("LibraryAccessDenied", invalid)
      m.assertFalse(m.manager.following)
      m.assertEqual(m.manager.notice.kind, "LibraryAccessDenied", "the refusal is what the viewer is told")
      last = m.lastPost(posts)
      m.assertTrue(last.url.instr("/SyncPlay/SetIgnoreWait") >= 0)
      m.assertEqual(last.body, FormatJson({ "IgnoreWait": true }))
    end function

    @it("a halted member's play whose start ended unanswered halts again at the next frame")
    function _()
      m.haltWithServer()
      m.pressPlay([{ id: "i9", type: "Movie" }])
      start = promises.create()
      m.manager.callFunc("claimPlay", start)
      ' Back, or the start's time limit: the manager is not told, and nothing is owed yet.
      promises.reject({ message: "cancelled" }, start)
      m.assertTrue(m.manager.following)
      ' Every wait the group starts begins with a frame to every member.
      m.manager.frame = m.update("StateUpdate", { State: "Waiting", Reason: "Seek" })
      m.assertFalse(m.manager.following)
    end function

    @it("a local play after an unanswered start halts quietly, before its mount")
    function _()
      m.haltWithServer()
      m.pressPlay([{ id: "i9", type: "Movie" }])
      start = promises.create()
      m.manager.callFunc("claimPlay", start)
      promises.reject({ message: "replaced by a newer start" }, start)
      m.manager.notice = invalid
      m.pressPlay([{ id: "a-1", type: "Audio" }])
      m.manager.callFunc("playerEvent", { kind: "mounted" })
      m.assertFalse(m.manager.following)
      m.assertInvalid(m.manager.notice, "the viewer chose what plays: no halt toast")
    end function

    @it("a newer claim still open keeps the follow its predecessor made")
    function _()
      m.haltWithServer()
      m.pressPlay([{ id: "i9", type: "Movie" }])
      first = promises.create()
      m.manager.callFunc("claimPlay", first)
      m.pressPlay([{ id: "i8", type: "Movie" }])
      second = promises.create()
      m.manager.callFunc("claimPlay", second)
      promises.reject({ message: "replaced by a newer start" }, first)
      m.manager.frame = m.update("StateUpdate", { State: "Waiting", Reason: "Seek" })
      m.assertTrue(m.manager.following, "the second play's answer is still due")
    end function

    @it("a following member's refused play leaves it following")
    function _()
      m.joinGroupWithServer()
      m.pressPlay([{ id: "i9", type: "Movie" }])
      m.manager.callFunc("claimPlay", promises.create())
      m.manager.frame = m.update("LibraryAccessDenied", invalid)
      m.assertTrue(m.manager.following)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("The viewer's controls go to the group (control)")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("the group's playlist length and playing index are published for the OSD's previous and next")
    function _()
      m.joinGroup()
      m.playGroupItem()
      m.assertEqual(m.manager.sync.playlistCount, 2)
      m.assertEqual(m.manager.sync.playingItemIndex, 0)
    end function

    @it("next and previous while following post NextItem and PreviousItem for the playing item")
    function _()
      m.joinGroup()
      m.playGroupItem()
      m.enableServer()
      posts = m.capturePosts()
      m.assertTrue(m.manager.callFunc("control", { kind: "next" }))
      last = m.lastPost(posts)
      m.assertTrue(last.url.instr("/SyncPlay/NextItem") >= 0)
      m.assertEqual(last.body, FormatJson({ "PlaylistItemId": "p1" }))
      m.assertTrue(m.manager.callFunc("control", { kind: "previous" }))
      last = m.lastPost(posts)
      m.assertTrue(last.url.instr("/SyncPlay/PreviousItem") >= 0)
      m.assertEqual(last.body, FormatJson({ "PlaylistItemId": "p1" }))
      m.assertEqual(posts.getChildCount(), 2)
    end function

    @it("pause and unpause while following post Pause and Unpause with no body")
    function _()
      m.joinGroup()
      m.playGroupItem()
      m.enableServer()
      posts = m.capturePosts()
      m.assertTrue(m.manager.callFunc("control", { kind: "pause" }))
      m.assertTrue(m.lastPost(posts).url.instr("/SyncPlay/Pause") >= 0)
      m.assertTrue(m.manager.callFunc("control", { kind: "unpause" }))
      m.assertTrue(m.lastPost(posts).url.instr("/SyncPlay/Unpause") >= 0)
      m.assertEqual(posts.getChildCount(), 2)
    end function

    @it("a seek while following posts Seek with the position in ticks, as a LongInteger")
    function _()
      m.joinGroup()
      m.playGroupItem()
      m.enableServer()
      posts = m.capturePosts()
      m.assertTrue(m.manager.callFunc("control", { kind: "seek", position: 90.5 }))
      last = m.lastPost(posts)
      m.assertTrue(last.url.instr("/SyncPlay/Seek") >= 0)
      m.assertEqual(last.body, FormatJson({ "PositionTicks": 905000000& }))
      m.assertFalse(m.manager.callFunc("control", { kind: "seek" }))
      m.assertEqual(posts.getChildCount(), 1)
    end function

    @it("nothing is posted while halted")
    function _()
      m.haltWithServer()
      posts = m.capturePosts()
      m.assertFalse(m.manager.callFunc("control", { kind: "next" }))
      m.assertFalse(m.manager.callFunc("control", { kind: "previous" }))
      m.assertFalse(m.manager.callFunc("control", { kind: "pause" }))
      m.assertFalse(m.manager.callFunc("control", { kind: "unpause" }))
      m.assertFalse(m.manager.callFunc("control", { kind: "seek", position: 10 }))
      m.assertEqual(posts.getChildCount(), 0)
    end function

    ' No reset() between the two halves: a state rebuilt through callFunc from the test thread
    ' loses its LongInteger entries on the render thread (the app resets from the render thread).
    @it("nothing is posted while the group plays nothing, or for a kind the group has no verb for")
    function _()
      m.joinGroupWithServer()
      posts = m.capturePosts()
      m.assertFalse(m.manager.callFunc("control", { kind: "next" }))
      m.playGroupItem()
      m.assertFalse(m.manager.callFunc("control", { kind: "shuffle" }))
      m.assertFalse(m.manager.callFunc("control", invalid))
      m.assertEqual(posts.getChildCount(), 0)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Following again")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    ' A member that left the group's item: halted, with no notice left over from getting there.
    private sub halt()
      m.joinGroup()
      m.playGroupItem()
      m.manager.callFunc("playerEvent", { kind: "mounted" })
      m.manager.callFunc("playerEvent", { kind: "unmounted" })
      m.manager.notice = invalid
    end sub

    @it("resumeFollowing follows again from the menu and tells the server to wait on this member once more")
    function _()
      m.halt()
      m.enableServer()
      posts = m.capturePosts()
      m.assertTrue(m.manager.callFunc("resumeFollowing"))
      m.assertTrue(m.manager.following)
      last = m.lastPost(posts)
      m.assertTrue(last.url.instr("/SyncPlay/SetIgnoreWait") >= 0)
      m.assertEqual(last.body, FormatJson({ "IgnoreWait": false }))
      ' The group's item is fetched for the load; with no answer here nothing is told yet.
      m.assertInvalid(m.manager.notice)
    end function

    @it("resumeFollowing into a group playing nothing only follows again, and says so")
    function _()
      m.joinGroup()
      m.manager.frame = m.update("PlayQueue", { Reason: "NewPlaylist", LastUpdate: "2026-10-23T20:47:25.000Z", Playlist: [{ ItemId: "i1", PlaylistItemId: "p1" }], PlayingItemIndex: 0, StartPositionTicks: 0, IsPlaying: false, ShuffleMode: "Sorted", RepeatMode: "RepeatNone" })
      m.manager.callFunc("playerEvent", { kind: "mounted" })
      m.manager.callFunc("playerEvent", { kind: "unmounted" })
      m.manager.frame = m.update("PlayQueue", { Reason: "RemoveItems", LastUpdate: "2026-10-23T20:47:26.000Z", Playlist: [], PlayingItemIndex: -1, StartPositionTicks: 0, IsPlaying: false, ShuffleMode: "Sorted", RepeatMode: "RepeatNone" })
      m.manager.notice = invalid
      m.assertFalse(m.manager.following)
      m.assertTrue(m.manager.callFunc("resumeFollowing"))
      m.assertTrue(m.manager.following)
      m.assertEqual(m.manager.notice.kind, "followingAgain")
    end function

    @it("resumeFollowing does nothing for a member already following, or outside a group")
    function _()
      m.assertFalse(m.manager.callFunc("resumeFollowing"))
      m.joinGroup()
      m.playGroupItem()
      m.assertFalse(m.manager.callFunc("resumeFollowing"))
      m.assertTrue(m.manager.following)
    end function

    @it("a new playlist brings a halted member back, and its load says so")
    function _()
      m.halt()
      m.assertFalse(m.manager.following)
      m.manager.frame = m.update("PlayQueue", { Reason: "NewPlaylist", LastUpdate: "2026-10-23T20:47:26.000Z", Playlist: [{ ItemId: "i5", PlaylistItemId: "p5" }], PlayingItemIndex: 0, StartPositionTicks: 0 })
      m.assertTrue(m.manager.following)
      m.assertEqual(m.manager.sync.playingItemId, "p5")
      ' One toast for the follow and the group's start, when the load runs.
      m.assertInvalid(m.manager.notice)
      m.assertEqual(m.manager.sync.loadNotice, "followingAgain")
    end function

    @it("a halted member brought back by a playlist with nothing to load is told at once")
    function _()
      m.halt()
      m.manager.frame = m.update("PlayQueue", { Reason: "NewPlaylist", LastUpdate: "2026-10-23T20:47:26.000Z", Playlist: [], PlayingItemIndex: -1, StartPositionTicks: 0 })
      m.assertTrue(m.manager.following)
      m.assertEqual(m.manager.notice.kind, "followingAgain")
    end function

    @it("a halt before the follow was told stays quiet: the viewer never saw it resume")
    function _()
      m.halt()
      m.manager.frame = m.update("PlayQueue", { Reason: "NewPlaylist", LastUpdate: "2026-10-23T20:47:26.000Z", Playlist: [{ ItemId: "i5", PlaylistItemId: "p5" }], PlayingItemIndex: 0, StartPositionTicks: 0 })
      m.manager.callFunc("playerEvent", { kind: "unmounted" })
      m.assertFalse(m.manager.following)
      m.assertInvalid(m.manager.notice)
      m.assertInvalid(m.manager.sync.loadNotice)
    end function

    @it("a jump, an append or a removal within the playlist leaves a halted member halted")
    function _()
      m.joinGroup()
      m.playGroupItem()
      m.manager.callFunc("playerEvent", { kind: "mounted" })
      m.manager.callFunc("playerEvent", { kind: "unmounted" })
      m.manager.notice = invalid
      for each reason in ["SetCurrentItem", "Queue", "RemoveItems"]
        m.manager.frame = m.update("PlayQueue", { Reason: reason, LastUpdate: "2026-10-23T20:47:2" + (6 + m.reasonIndex(reason)).toStr() + ".000Z", Playlist: [{ ItemId: "i1", PlaylistItemId: "p1" }, { ItemId: "i2", PlaylistItemId: "p2" }], PlayingItemIndex: 1, StartPositionTicks: 0 })
        m.assertFalse(m.manager.following, reason + " must not bring the member back")
      end for
      m.assertInvalid(m.manager.notice)
    end function

    private function reasonIndex(reason as string) as integer
      if reason = "SetCurrentItem" then return 0
      if reason = "Queue" then return 1
      return 2
    end function

  end class
end namespace
