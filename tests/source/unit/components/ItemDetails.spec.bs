namespace tests

  @suite("ItemDetails - focusButtonGroupChild()")
  class ItemDetailsFocusButtonGroupChildTests extends tests.BaseTestSuite

    private itemDetails as object
    private buttonGrp as object

    protected override sub setup()
      super.setup()

      ' Create a mock sceneManager (required by ItemDetails init)
      if not m.global.doesExist("sceneManager")
        m.global.addField("sceneManager", "node", false)
        m.global.sceneManager = CreateObject("roSGNode", "ContentNode")
      end if

      m.itemDetails = CreateObject("roSGNode", "ItemDetails")

      ' Get the button group for test setup
      m.buttonGrp = m.itemDetails.findNode("buttons")
    end sub

    protected override sub teardown()
      super.teardown()
      m.itemDetails = invalid
      m.buttonGrp = invalid
    end sub

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Valid focus scenarios")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("focuses first button when buttonFocused is 0")
    function _()
      m.buttonGrp.buttonFocused = 0

      ' Should not crash
      m.itemDetails.callFunc("focusButtonGroupChild")

      m.assertTrue(true)
    end function

    @it("focuses last button when buttonFocused is at last index")
    function _()
      lastIndex = m.buttonGrp.getChildCount() - 1
      m.buttonGrp.buttonFocused = lastIndex

      ' Should not crash
      m.itemDetails.callFunc("focusButtonGroupChild")

      m.assertTrue(true)
    end function

    @it("focuses middle button in group")
    function _()
      ' Default ItemDetails has 4 buttons (play, watched, favorite, refresh)
      m.buttonGrp.buttonFocused = 1

      m.itemDetails.callFunc("focusButtonGroupChild")

      m.assertTrue(true)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Out of range index scenarios")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("handles negative buttonFocused index gracefully")
    function _()
      m.buttonGrp.buttonFocused = -1

      ' Should not crash - guard clause should return early
      m.itemDetails.callFunc("focusButtonGroupChild")

      m.assertTrue(true)
    end function

    @it("handles buttonFocused index exceeding child count")
    function _()
      m.buttonGrp.buttonFocused = m.buttonGrp.getChildCount() + 10

      ' Should not crash - guard clause should return early
      m.itemDetails.callFunc("focusButtonGroupChild")

      m.assertTrue(true)
    end function

    @it("handles buttonFocused at exact boundary (equals child count)")
    function _()
      m.buttonGrp.buttonFocused = m.buttonGrp.getChildCount()

      ' Should not crash - guard clause should return early
      m.itemDetails.callFunc("focusButtonGroupChild")

      m.assertTrue(true)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Empty button group scenarios")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("handles empty button group with buttonFocused 0")
    function _()
      ' Remove all children to simulate empty button group
      m.buttonGrp.removeChildrenIndex(m.buttonGrp.getChildCount(), 0)
      m.buttonGrp.buttonFocused = 0

      ' Should not crash - guard clause should return early
      m.itemDetails.callFunc("focusButtonGroupChild")

      m.assertTrue(true)
    end function

  end class

end namespace
