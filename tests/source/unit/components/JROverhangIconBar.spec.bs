namespace tests

  @suite("JROverhangIconBar - builds and lays out the cluster's icons")
  class JROverhangIconBarTests extends tests.BaseTestSuite

    private bar as object

    protected override function beforeEach()
      super.beforeEach()
      m.bar = CreateObject("roSGNode", "JROverhangIconBar")
    end function

    protected override function afterEach()
      m.bar = invalid
      super.afterEach()
    end function

    private function entries() as object
      return [
        { id: "search", icon: "pkg:/images/icons/search_$$RES$$.png", action: "openSearch" },
        { id: "settings", icon: "pkg:/images/icons/settings_$$RES$$.png", action: "openSettings" }
      ]
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("building")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("creates one JROverhangIcon per entry, named <id>Icon, laid out by iconBarNav")
    function _()
      m.bar.entries = m.entries()
      search = m.bar.findNode("searchIcon")
      settings = m.bar.findNode("settingsIcon")
      m.assertNotInvalid(search)
      m.assertNotInvalid(settings)
      m.assertEqual(search.subtype(), "JROverhangIcon")
      m.assertEqual(search.icon, "pkg:/images/icons/search_$$RES$$.png")
      m.assertEqual(search.translation, [-9.0, 0.0])
      m.assertEqual(settings.translation, [57.0, 0.0])
      m.assertEqual(m.bar.barWidth, 126)
    end function

    @it("rebuilds on a new entry list and drops the old icons")
    function _()
      m.bar.entries = m.entries()
      m.bar.entries = [{ id: "syncplay", icon: "pkg:/images/icons/search_$$RES$$.png" }]
      m.assertInvalid(m.bar.findNode("searchIcon"))
      m.assertNotInvalid(m.bar.findNode("syncplayIcon"))
      m.assertEqual(m.bar.barWidth, 60)
    end function

    @it("is empty and 0 wide with no entries")
    function _()
      m.bar.entries = []
      m.assertEqual(m.bar.barWidth, 0)
      m.assertEqual(m.bar.getChildCount(), 0)
    end function

    @it("passes disabled through to the icon")
    function _()
      m.bar.entries = [{ id: "syncplay", icon: "pkg:/images/icons/search_$$RES$$.png", disabled: true }]
      m.assertTrue(m.bar.findNode("syncplayIcon").isDisabled)
    end function

    @it("getIcon returns the child for an id and invalid for a stranger")
    function _()
      m.bar.entries = m.entries()
      m.assertEqual(m.bar.callFunc("getIcon", "settings").id, "settingsIcon")
      m.assertInvalid(m.bar.callFunc("getIcon", "syncplay"))
    end function

    ' A Poster holding a color the way the glyph would, since a color field reads back in its own form.
    private function asColor(value as string) as dynamic
      probe = CreateObject("roSGNode", "Poster")
      probe.blendColor = value
      return probe.blendColor
    end function

    @it("updateEntry turns an entry active in place, keeping the children")
    function _()
      m.bar.entries = m.entries()
      before = m.bar.findNode("settingsIcon")
      m.assertTrue(m.bar.callFunc("updateEntry", "settings", { active: true }))
      after = m.bar.findNode("settingsIcon")
      m.assertTrue(before.isSameNode(after))
      m.assertTrue(after.isActive)
      m.assertEqual(m.bar.getChildCount(), 2)
      m.assertTrue(m.bar.callFunc("updateEntry", "settings", { active: false }))
      m.assertFalse(after.isActive)
    end function

    @it("updateEntry leaves the state alone for a patch without it, and refuses a stranger")
    function _()
      m.bar.entries = [{ id: "search", icon: "pkg:/images/icons/search_$$RES$$.png", active: true }]
      m.assertTrue(m.bar.findNode("searchIcon").isActive, "an entry can start active")
      m.assertTrue(m.bar.callFunc("updateEntry", "search", {}))
      m.assertTrue(m.bar.findNode("searchIcon").isActive)
      m.assertFalse(m.bar.callFunc("updateEntry", "syncplay", { active: true }))
    end function

    @it("an entry's badge is built from the entry and patched in place")
    function _()
      m.bar.entries = [{ id: "search", icon: "pkg:/images/icons/search_$$RES$$.png", badge: true }]
      icon = m.bar.findNode("searchIcon")
      m.assertTrue(icon.hasBadge, "an entry can start with a badge")
      m.assertTrue(m.bar.callFunc("updateEntry", "search", { badge: false }))
      m.assertTrue(icon.isSameNode(m.bar.findNode("searchIcon")))
      m.assertFalse(icon.hasBadge)
      m.assertTrue(m.bar.callFunc("updateEntry", "search", { active: true }))
      m.assertFalse(icon.hasBadge, "a patch without a badge leaves it alone")
    end function

    @it("an entry's disabled flag is built from the entry and patched in place")
    function _()
      m.bar.entries = [{ id: "search", icon: "pkg:/images/icons/search_$$RES$$.png", disabled: true }]
      icon = m.bar.findNode("searchIcon")
      m.assertTrue(icon.isDisabled, "an entry can start disabled")
      m.assertTrue(m.bar.callFunc("updateEntry", "search", { disabled: false }))
      m.assertTrue(icon.isSameNode(m.bar.findNode("searchIcon")))
      m.assertFalse(icon.isDisabled)
      m.assertTrue(m.bar.callFunc("updateEntry", "search", { disabled: true }))
      m.assertTrue(icon.isDisabled)
      m.assertTrue(m.bar.callFunc("updateEntry", "search", { active: true }))
      m.assertTrue(icon.isDisabled, "a patch without disabled leaves it alone")
    end function

    @it("an active glyph is colorSecondary at rest; disabled wins over it")
    function _()
      m.bar.entries = m.entries()
      glyph = m.bar.findNode("settingsIcon").findNode("buttonIcon")
      constants = m.global.constants
      m.assertEqual(glyph.blendColor, m.asColor(constants.colorTextSecondary))
      m.bar.callFunc("updateEntry", "settings", { active: true })
      m.assertEqual(glyph.blendColor, m.asColor(constants.colorSecondary))
      m.bar.findNode("settingsIcon").isDisabled = true
      m.assertEqual(glyph.blendColor, m.asColor(constants.colorTextDisabled))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("a press")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("reports the entry's action, or its id without one")
    function _()
      m.bar.entries = m.entries()
      m.bar.findNode("searchIcon").selectedAction = "search"
      m.assertEqual(m.bar.selectedAction, "openSearch")
      m.bar.entries = [{ id: "syncplay", icon: "pkg:/images/icons/search_$$RES$$.png" }]
      m.bar.findNode("syncplayIcon").selectedAction = "syncplay"
      m.assertEqual(m.bar.selectedAction, "syncplay")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("walking off an end")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("reports the entry id Down was pressed on")
    function _()
      m.bar.entries = [{ id: "search", icon: "" }, { id: "settings", icon: "" }]
      m.bar.getChild(1).requestFocusReturn = true
      m.assertEqual(m.bar.requestFocusReturn, "settings")
    end function

    @it("reports the edge a press left the bar by")
    function _()
      m.bar.entries = m.entries()
      m.bar.findNode("searchIcon").requestFocusExit = "left"
      m.assertEqual(m.bar.requestFocusExit, "left")
      m.bar.findNode("settingsIcon").requestFocusExit = "right"
      m.assertEqual(m.bar.requestFocusExit, "right")
    end function

  end class

end namespace
