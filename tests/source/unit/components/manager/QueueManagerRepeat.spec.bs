import "pkg:/source/utils/queueRepeat.bs"

namespace tests

  ' The repeat mode belongs to the queue: it survives set() (a shuffle toggle reorders through
  ' it) and dies with clear() (a new queue), the way the quality caps and the version pick do.
  @suite("QueueManager - the queue's repeat mode")
  class QueueManagerRepeatTests extends tests.BaseTestSuite

    private queueManager as object

    protected override function beforeEach()
      super.beforeEach()
      m.queueManager = CreateObject("roSGNode", "QueueManager")
    end function

    protected override function afterEach()
      m.queueManager = invalid
      super.afterEach()
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("setRepeatMode and getRepeatMode")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("starts off")
    function _()
      m.assertEqual(m.queueManager.callFunc("getRepeatMode"), queueRepeat.OFF)
    end function

    @it("keeps a mode and makes an unknown one off")
    function _()
      m.queueManager.callFunc("setRepeatMode", queueRepeat.ONE)
      m.assertEqual(m.queueManager.callFunc("getRepeatMode"), queueRepeat.ONE)
      m.queueManager.callFunc("setRepeatMode", "loop")
      m.assertEqual(m.queueManager.callFunc("getRepeatMode"), queueRepeat.OFF)
    end function

    @it("survives set and dies with clear")
    function _()
      m.queueManager.callFunc("setRepeatMode", queueRepeat.ALL)
      m.queueManager.callFunc("set", [{ id: "test-a", type: "Episode" }, { id: "test-b", type: "Episode" }])
      m.assertEqual(m.queueManager.callFunc("getRepeatMode"), queueRepeat.ALL, "a reorder keeps the viewer's pick")
      m.queueManager.callFunc("clear")
      m.assertEqual(m.queueManager.callFunc("getRepeatMode"), queueRepeat.OFF, "a new queue starts without one")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("releaseRepeatMode: who set the mode")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("turns off a mode the releasing setter set, and answers that it changed it")
    function _()
      m.queueManager.callFunc("setRepeatMode", queueRepeat.ONE, queueRepeat.BY_GROUP)
      m.assertTrue(m.queueManager.callFunc("releaseRepeatMode", queueRepeat.BY_GROUP))
      m.assertEqual(m.queueManager.callFunc("getRepeatMode"), queueRepeat.OFF)
    end function

    @it("leaves the viewer's own mode, even one picked over the group's")
    function _()
      m.queueManager.callFunc("setRepeatMode", queueRepeat.ALL)
      m.assertFalse(m.queueManager.callFunc("releaseRepeatMode", queueRepeat.BY_GROUP), "the viewer set it")
      m.assertEqual(m.queueManager.callFunc("getRepeatMode"), queueRepeat.ALL)
      m.queueManager.callFunc("setRepeatMode", queueRepeat.ONE, queueRepeat.BY_GROUP)
      m.queueManager.callFunc("setRepeatMode", queueRepeat.ALL, queueRepeat.BY_VIEWER)
      m.assertFalse(m.queueManager.callFunc("releaseRepeatMode", queueRepeat.BY_GROUP), "the viewer took it over")
      m.assertEqual(m.queueManager.callFunc("getRepeatMode"), queueRepeat.ALL)
    end function

    @it("keeps who set the mode through set, and forgets it with clear")
    function _()
      m.queueManager.callFunc("setRepeatMode", queueRepeat.ALL, queueRepeat.BY_GROUP)
      m.queueManager.callFunc("set", [{ id: "test-a", type: "Episode" }])
      m.assertTrue(m.queueManager.callFunc("releaseRepeatMode", queueRepeat.BY_GROUP), "a reorder keeps the setter")
      m.queueManager.callFunc("setRepeatMode", queueRepeat.ALL, queueRepeat.BY_GROUP)
      m.queueManager.callFunc("clear")
      m.assertFalse(m.queueManager.callFunc("releaseRepeatMode", queueRepeat.BY_GROUP), "a new queue has no setter's mode")
    end function

    @it("answers false for a release with the mode already off, and the mode is the viewer's after it")
    function _()
      m.queueManager.callFunc("setRepeatMode", queueRepeat.OFF, queueRepeat.BY_GROUP)
      m.assertFalse(m.queueManager.callFunc("releaseRepeatMode", queueRepeat.BY_GROUP))
      m.queueManager.callFunc("setRepeatMode", queueRepeat.ONE)
      m.assertFalse(m.queueManager.callFunc("releaseRepeatMode", queueRepeat.BY_GROUP))
      m.assertEqual(m.queueManager.callFunc("getRepeatMode"), queueRepeat.ONE)
    end function

  end class

end namespace
