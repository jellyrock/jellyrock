namespace tests

  @suite("captionTask - onDestroy()")
  class CaptionTaskDestroyTests extends tests.BaseTestSuite

    private captionTask as object

    protected override sub setup()
      super.setup()
      m.captionTask = CreateObject("roSGNode", "captionTask")
    end sub

    protected override sub teardown()
      super.teardown()
      m.captionTask = invalid
    end sub

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("onDestroy()")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("does not crash when called")
    function _()
      m.captionTask.callFunc("onDestroy")
      m.assertTrue(true)
    end function

    @it("does not crash when called after receiving empty caption data")
    function _()
      m.captionTask.captionData = { entries: [] }
      m.captionTask.callFunc("onDestroy")
      m.assertTrue(true)
    end function

    @it("does not crash when called after receiving caption data")
    function _()
      m.captionTask.captionData = { entries: [{ "start": 0, "end": 1000, "text": "Hello" }] }
      m.captionTask.callFunc("onDestroy")
      m.assertTrue(true)
    end function

    @it("clears currentCaption after onDestroy")
    function _()
      m.captionTask.captionData = { entries: [{ "start": 0, "end": 1000, "text": "Hello" }] }
      m.captionTask.callFunc("onDestroy")
      m.assertArrayCount(m.captionTask.currentCaption, 0)
    end function

    @it("does not crash when called twice (idempotent)")
    function _()
      m.captionTask.callFunc("onDestroy")
      m.captionTask.callFunc("onDestroy")
      m.assertTrue(true)
    end function

    @it("updateCaption does not crash after onDestroy")
    function _()
      m.captionTask.captionData = { entries: [{ "start": 0, "end": 1000, "text": "Hello" }] }
      m.captionTask.playerState = "playingOn"
      m.captionTask.currentPos = 500
      m.captionTask.callFunc("onDestroy")
      ' Simulate a late timer fire — the defensive guard in updateCaption()
      ' should return early when m.tags/m.captionList are invalid
      m.captionTask.callFunc("updateCaption")
      m.assertTrue(true)
    end function

  end class

end namespace
