namespace tests

  @suite("OSD - onItemDataChanged()")
  class OSDItemDataTests extends tests.BaseTestSuite

    private osd as object

    protected override sub setup()
      super.setup()

      ' OSD.init() calls m.global.queueManager via setButtonStates()
      ' Create a mock QueueManager so setting itemData doesn't crash
      if not m.global.doesExist("queueManager")
        m.global.addField("queueManager", "node", false)
      end if
      queueMgr = CreateObject("roSGNode", "QueueManager")
      m.global.queueManager = queueMgr

      ' SceneManager is required by JRScreen (OSD's parent)
      if not m.global.doesExist("sceneManager")
        m.global.addField("sceneManager", "node", false)
        m.global.sceneManager = CreateObject("roSGNode", "ContentNode")
      end if

      m.osd = CreateObject("roSGNode", "OSD")
    end sub

    protected override sub teardown()
      super.teardown()
      m.osd = invalid
    end sub

    ' Helper to create a JellyfinBaseItem node with specific fields
    private function createItem(fields as object) as object
      item = CreateObject("roSGNode", "JellyfinBaseItem")
      item.setFields(fields)
      return item
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("isMovie / isSeries flag detection")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("sets isMovie=true when item.isMovie is true")
    function _()
      item = m.createItem({ id: "test-1", type: "Movie", isMovie: true })
      m.osd.itemData = item

      m.assertTrue(m.osd.isMovie)
      m.assertFalse(m.osd.isSeries)
    end function

    @it("sets isSeries=true when item.isSeries is true")
    function _()
      item = m.createItem({ id: "test-2", type: "Episode", isSeries: true })
      m.osd.itemData = item

      m.assertFalse(m.osd.isMovie)
      m.assertTrue(m.osd.isSeries)
    end function

    @it("resolves conflicting flags by prioritizing isSeries")
    function _()
      item = m.createItem({ id: "test-3", type: "Movie", isMovie: true, isSeries: true })
      m.osd.itemData = item

      m.assertFalse(m.osd.isMovie)
      m.assertTrue(m.osd.isSeries)
    end function

    @it("falls back to isMovie=true for Movie type with no flags")
    function _()
      item = m.createItem({ id: "test-4", type: "Movie" })
      m.osd.itemData = item

      m.assertTrue(m.osd.isMovie)
      m.assertFalse(m.osd.isSeries)
    end function

    @it("falls back to isSeries=true for Recording type")
    function _()
      item = m.createItem({ id: "test-5", type: "Recording" })
      m.osd.itemData = item

      m.assertFalse(m.osd.isMovie)
      m.assertTrue(m.osd.isSeries)
    end function

    @it("falls back to isSeries=true when seriesName is present")
    function _()
      item = m.createItem({ id: "test-6", type: "Episode", seriesName: "Breaking Bad" })
      m.osd.itemData = item

      m.assertFalse(m.osd.isMovie)
      m.assertTrue(m.osd.isSeries)
    end function

    @it("falls back to isSeries=true when parentIndexNumber is set")
    function _()
      item = m.createItem({ id: "test-7", type: "Episode", parentIndexNumber: 3 })
      m.osd.itemData = item

      m.assertFalse(m.osd.isMovie)
      m.assertTrue(m.osd.isSeries)
    end function

    @it("falls back to isMovie=true for unknown type with no series metadata")
    function _()
      item = m.createItem({ id: "test-8", type: "Video" })
      m.osd.itemData = item

      m.assertTrue(m.osd.isMovie)
      m.assertFalse(m.osd.isSeries)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Chapter and stream count fields")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("sets hasChapters=true when chapterCount > 0")
    function _()
      item = m.createItem({ id: "test-9", type: "Movie", chapterCount: 5 })
      m.osd.itemData = item

      m.assertTrue(m.osd.hasChapters)
    end function

    @it("sets hasChapters=false when chapterCount is 0")
    function _()
      item = m.createItem({ id: "test-10", type: "Movie", chapterCount: 0 })
      m.osd.itemData = item

      m.assertFalse(m.osd.hasChapters)
    end function

    @it("sets numAudioStreams from item.audioStreamCount")
    function _()
      item = m.createItem({ id: "test-11", type: "Movie", audioStreamCount: 3 })
      m.osd.itemData = item

      m.assertEqual(m.osd.numAudioStreams, 3)
    end function

    @it("sets numAudioStreams=0 when no audio streams")
    function _()
      item = m.createItem({ id: "test-12", type: "Movie" })
      m.osd.itemData = item

      m.assertEqual(m.osd.numAudioStreams, 0)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Runtime computation")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("computes runTimeMinutes from runTimeTicks")
    function _()
      ' 90 minutes = 90 * 60 * 10000000 = 54000000000
      item = m.createItem({ id: "test-13", type: "Movie", runTimeTicks: 54000000000& })
      m.osd.itemData = item

      m.assertEqual(m.osd.runTimeMinutes, 90)
    end function

    @it("sets runTimeMinutes=0 when runTimeTicks is 0")
    function _()
      item = m.createItem({ id: "test-14", type: "Movie" })
      m.osd.itemData = item

      m.assertEqual(m.osd.runTimeMinutes, 0)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Guard clauses")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("does not crash when itemData is set to invalid")
    function _()
      m.osd.itemData = invalid

      ' Should not crash - guard clause should return early
      m.assertTrue(true)
    end function

    @it("does not crash when item has empty id")
    function _()
      item = m.createItem({ type: "Movie" })
      m.osd.itemData = item

      ' Should not crash - guard clause should return early (id = "" default)
      m.assertTrue(true)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("TvChannel currentProgram overrides")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("uses currentProgram.isMovie when TvChannel has a movie program")
    function _()
      program = CreateObject("roSGNode", "JellyfinBaseItem")
      program.setFields({ id: "prog-1", type: "Program", isMovie: true })
      item = m.createItem({ id: "ch-1", type: "TvChannel" })
      item.currentProgram = program
      m.osd.itemData = item

      m.assertTrue(m.osd.isMovie)
      m.assertFalse(m.osd.isSeries)
    end function

    @it("uses currentProgram.isSeries when TvChannel has a series program")
    function _()
      program = CreateObject("roSGNode", "JellyfinBaseItem")
      program.setFields({ id: "prog-2", type: "Program", isSeries: true })
      item = m.createItem({ id: "ch-2", type: "TvChannel" })
      item.currentProgram = program
      m.osd.itemData = item

      m.assertFalse(m.osd.isMovie)
      m.assertTrue(m.osd.isSeries)
    end function

    @it("falls back to heuristic isMovie when TvChannel has no currentProgram")
    function _()
      ' No currentProgram, no series metadata → fallback heuristic defaults to isMovie
      item = m.createItem({ id: "ch-3", type: "TvChannel" })
      m.osd.itemData = item

      m.assertTrue(m.osd.isMovie)
      m.assertFalse(m.osd.isSeries)
    end function

    @it("uses currentProgram.runTimeTicks for TvChannel runtime")
    function _()
      ' 162 minutes = 162 * 60 * 10000000 = 97200000000 ticks
      program = CreateObject("roSGNode", "JellyfinBaseItem")
      program.setFields({ id: "prog-3", type: "Program", runTimeTicks: 97200000000& })
      item = m.createItem({ id: "ch-4", type: "TvChannel" })
      item.currentProgram = program
      m.osd.itemData = item

      m.assertEqual(m.osd.runTimeMinutes, 162)
    end function

    @it("reports 0 runTimeMinutes when TvChannel has no currentProgram")
    function _()
      item = m.createItem({ id: "ch-5", type: "TvChannel" })
      m.osd.itemData = item

      m.assertEqual(m.osd.runTimeMinutes, 0)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Recording metadata handling")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("sets hasChapters=true for Recording with chapters")
    function _()
      item = m.createItem({ id: "rec-1", type: "Recording", chapterCount: 3 })
      m.osd.itemData = item

      m.assertTrue(m.osd.hasChapters)
    end function

    @it("computes runTimeMinutes from Recording runTimeTicks")
    function _()
      ' 45 minutes = 45 * 60 * 10000000 = 27000000000
      item = m.createItem({ id: "rec-2", type: "Recording", runTimeTicks: 27000000000& })
      m.osd.itemData = item

      m.assertEqual(m.osd.runTimeMinutes, 45)
    end function

    @it("sets numAudioStreams for Recording")
    function _()
      item = m.createItem({ id: "rec-3", type: "Recording", audioStreamCount: 2 })
      m.osd.itemData = item

      m.assertEqual(m.osd.numAudioStreams, 2)
    end function

    @it("falls back to isSeries=true for Recording without explicit flags")
    function _()
      ' Recording type triggers the isSeries heuristic fallback (line 101-102 in OSD.bs)
      item = m.createItem({ id: "rec-4", type: "Recording" })
      m.osd.itemData = item

      m.assertFalse(m.osd.isMovie)
      m.assertTrue(m.osd.isSeries)
    end function

    @it("uses Recording's own runTimeTicks (not from currentProgram)")
    function _()
      ' Recordings use their own metadata, not a nested currentProgram.
      ' 120 minutes = 120 * 60 * 10000000 = 72000000000
      item = m.createItem({ id: "rec-5", type: "Recording", runTimeTicks: 72000000000& })
      m.osd.itemData = item

      m.assertEqual(m.osd.runTimeMinutes, 120)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Video source count handling")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("sets numVideoSources=2 when hasMultipleVideoSources is true")
    function _()
      item = m.createItem({ id: "vs-1", type: "Movie", hasMultipleVideoSources: true })
      m.osd.itemData = item

      m.assertEqual(m.osd.numVideoSources, 2)
    end function

    @it("sets numVideoSources=1 when hasMultipleVideoSources is false")
    function _()
      ' OSD is shared across tests; reset to 0 so the production "only update if higher"
      ' guard in onItemDataChanged doesn't preserve a value from a prior test.
      m.osd.numVideoSources = 0
      item = m.createItem({ id: "vs-2", type: "Movie", hasMultipleVideoSources: false })
      m.osd.itemData = item

      m.assertEqual(m.osd.numVideoSources, 1)
    end function

  end class

end namespace
