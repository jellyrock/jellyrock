import "pkg:/source/remotecontrol/remoteCommand.bs"
import "pkg:/source/utils/queueRepeat.bs"

namespace tests

  ' The OSD's previous and next outside a group read the queue's repeat mode: RepeatAll wraps,
  ' RepeatOne replays on a press, and off, a single video has no step. The gear lights up while a
  ' gear row differs from the defaults. Both are read on each OSD open and on refreshFromQueue,
  ' which a gear pick calls.
  @suite("OSD - previous and next under the queue's repeat mode")
  class OSDRepeatStepsTests extends tests.BaseTestSuite

    private osd as object
    private previousQueue as object
    private previousManager as object
    private previousServerUrl as string

    protected override function beforeEach()
      super.beforeEach()
      if not m.global.doesExist("queueManager") then m.global.addField("queueManager", "node", false)
      m.previousQueue = m.global.queueManager
      m.global.queueManager = CreateObject("roSGNode", "QueueManager")
      ' The OSD reads the group through m.global.syncPlayManager; outside a group there is none to read.
      if not m.global.doesExist("syncPlayManager") then m.global.addField("syncPlayManager", "node", false)
      m.previousManager = m.global.syncPlayManager
      m.global.syncPlayManager = invalid
      ' No server: a GroupJoined then starts no time-sync burst.
      m.previousServerUrl = m.global.server.serverUrl
      m.global.server.serverUrl = ""
      if not m.global.doesExist("sceneManager")
        m.global.addField("sceneManager", "node", false)
        m.global.sceneManager = CreateObject("roSGNode", "ContentNode")
      end if
      m.osd = CreateObject("roSGNode", "OSD")
      m.osd.visible = false
    end function

    protected override function afterEach()
      m.osd = invalid
      if isValid(m.global.syncPlayManager) then m.global.syncPlayManager.callFunc("reset")
      m.global.syncPlayManager = m.previousManager
      m.previousManager = invalid
      m.global.server.serverUrl = m.previousServerUrl
      m.global.queueManager = m.previousQueue
      m.previousQueue = invalid
      super.afterEach()
    end function

    ' A member following a group of two items, playing the second, under `repeatMode`; the local
    ' queue holds the group's item alone with its playlist stamp, as SyncPlayManager.applyQueue
    ' builds it (with no server the manager's own fetch builds nothing).
    private sub followingGroupAt(index as integer, repeatMode as string, shuffleMode = "Sorted" as string)
      manager = CreateObject("roSGNode", "SyncPlayManager")
      m.global.syncPlayManager = manager
      manager.frame = remoteCommand.parseMessage({ MessageType: "SyncPlayGroupUpdate", Data: { GroupId: "g1", Type: "GroupJoined", Data: { GroupId: "g1", GroupName: "Movie night", State: "Idle", Participants: ["ann"], LastUpdatedAt: "2026-10-23T20:47:20.500Z" } } })
      playlist = [{ ItemId: "i1", PlaylistItemId: "p1" }, { ItemId: "i2", PlaylistItemId: "p2" }]
      m.global.queueManager.callFunc("set", [{ id: "i" + (index + 1).toStr(), type: "Movie", syncPlayPlaylistItemId: "p" + (index + 1).toStr() }])
      manager.frame = remoteCommand.parseMessage({ MessageType: "SyncPlayGroupUpdate", Data: { GroupId: "g1", Type: "PlayQueue", Data: { Reason: "NewPlaylist", LastUpdate: "2026-10-23T20:47:25.000Z", Playlist: playlist, PlayingItemIndex: index, StartPositionTicks: 0, RepeatMode: repeatMode, ShuffleMode: shuffleMode } } })
    end sub

    private sub localQueueAt(index as integer, count as integer, repeatMode as string)
      items = []
      for i = 1 to count
        items.push({ id: "test-episode-" + i.toStr(), type: "Episode" })
      end for
      m.global.queueManager.callFunc("set", items)
      m.global.queueManager.callFunc("setPosition", index)
      m.global.queueManager.callFunc("setRepeatMode", repeatMode)
    end sub

    private function item() as object
      node = CreateObject("roSGNode", "JellyfinBaseItem")
      node.setFields({ id: "test-episode", type: "Episode" })
      return node
    end function

    private function button(id as string) as object
      return m.osd.findNode(id)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("the enabled state")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("stops at the ends when repeat is off")
    function _()
      m.localQueueAt(1, 2, queueRepeat.OFF)
      m.osd.itemData = m.item()
      m.assertFalse(m.button("itemNext").isEnabled)
      m.assertTrue(m.button("itemBack").isEnabled)
    end function

    @it("wraps at both ends under RepeatAll")
    function _()
      m.localQueueAt(1, 2, queueRepeat.ALL)
      m.osd.itemData = m.item()
      m.assertTrue(m.button("itemNext").isEnabled)
      m.localQueueAt(0, 2, queueRepeat.ALL)
      m.osd.callFunc("refreshFromQueue")
      m.assertTrue(m.button("itemBack").isEnabled)
    end function

    @it("gives a single video no step when off, and a replay under All or One")
    function _()
      m.localQueueAt(0, 1, queueRepeat.OFF)
      m.osd.itemData = m.item()
      m.assertFalse(m.button("itemNext").isEnabled)
      m.assertFalse(m.button("itemBack").isEnabled)
      m.localQueueAt(0, 1, queueRepeat.ALL)
      m.osd.callFunc("refreshFromQueue")
      m.assertTrue(m.button("itemNext").isEnabled)
      m.localQueueAt(0, 1, queueRepeat.ONE)
      m.osd.callFunc("refreshFromQueue")
      m.assertTrue(m.button("itemNext").isEnabled)
      m.assertTrue(m.button("itemBack").isEnabled)
    end function

    @it("keeps both enabled at the last item under RepeatOne, since a press replays")
    function _()
      m.localQueueAt(1, 2, queueRepeat.ONE)
      m.osd.itemData = m.item()
      m.assertTrue(m.button("itemNext").isEnabled)
      m.assertTrue(m.button("itemBack").isEnabled)
    end function

    @it("reads a repeat pick again through refreshFromQueue")
    function _()
      m.localQueueAt(1, 2, queueRepeat.OFF)
      m.osd.itemData = m.item()
      m.assertFalse(m.button("itemNext").isEnabled)
      m.global.queueManager.callFunc("setRepeatMode", queueRepeat.ALL)
      m.osd.callFunc("refreshFromQueue")
      m.assertTrue(m.button("itemNext").isEnabled)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("in a SyncPlay group")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("reads the group's playlist and its repeat mode: the last item has a next under RepeatAll, none when off")
    function _()
      m.followingGroupAt(1, "RepeatNone")
      m.osd.itemData = m.item()
      m.assertFalse(m.button("itemNext").isEnabled)
      m.assertTrue(m.button("itemBack").isEnabled)
      m.followingGroupAt(1, "RepeatAll")
      m.osd.callFunc("refreshFromQueue")
      m.assertTrue(m.button("itemNext").isEnabled)
      m.assertTrue(m.button("itemBack").isEnabled)
    end function

    @it("the group's repeat mode rides on the local queue, and the gear lights for it or for the group's shuffle")
    function _()
      m.followingGroupAt(0, "RepeatOne")
      m.osd.itemData = m.item()
      m.assertEqual(m.global.queueManager.callFunc("getRepeatMode"), queueRepeat.ONE)
      m.assertTrue(m.button("showPlaybackSettings").isButtonSelected)
      m.followingGroupAt(0, "RepeatNone", "Shuffle")
      m.osd.callFunc("refreshFromQueue")
      m.assertEqual(m.global.queueManager.callFunc("getRepeatMode"), queueRepeat.OFF)
      m.assertTrue(m.button("showPlaybackSettings").isButtonSelected, "the group's shuffle")
      m.followingGroupAt(0, "RepeatNone", "Sorted")
      m.osd.callFunc("refreshFromQueue")
      m.assertFalse(m.button("showPlaybackSettings").isButtonSelected)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("the gear's tint")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("stays plain with nothing picked")
    function _()
      m.localQueueAt(0, 1, queueRepeat.OFF)
      m.osd.itemData = m.item()
      m.assertFalse(m.button("showPlaybackSettings").isButtonSelected)
    end function

    @it("lights up on a repeat mode and goes plain when it is set off again")
    function _()
      m.localQueueAt(0, 1, queueRepeat.ONE)
      m.osd.itemData = m.item()
      m.assertTrue(m.button("showPlaybackSettings").isButtonSelected)
      m.global.queueManager.callFunc("setRepeatMode", queueRepeat.OFF)
      m.osd.callFunc("refreshFromQueue")
      m.assertFalse(m.button("showPlaybackSettings").isButtonSelected)
    end function

    @it("lights up on a quality cap")
    function _()
      m.localQueueAt(0, 1, queueRepeat.OFF)
      m.osd.itemData = m.item()
      m.global.queueManager.callFunc("setPlaybackCaps", { maxBitrateMbps: 4 })
      m.osd.callFunc("refreshFromQueue")
      m.assertTrue(m.button("showPlaybackSettings").isButtonSelected)
    end function

  end class

end namespace
