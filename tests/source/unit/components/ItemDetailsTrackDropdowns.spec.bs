namespace tests

  @suite("ItemDetails - TrackDropdown integration")
  class ItemDetailsTrackDropdownsTests extends tests.BaseTestSuite

    private itemDetails as object

    protected override sub setup()
      super.setup()

      ' Mock sceneManager required by ItemDetails init
      if not m.global.doesExist("sceneManager")
        m.global.addField("sceneManager", "node", false)
        m.global.sceneManager = CreateObject("roSGNode", "ContentNode")
      end if

      m.itemDetails = CreateObject("roSGNode", "ItemDetails")
    end sub

    protected override sub teardown()
      super.teardown()
      m.itemDetails = invalid
    end sub

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Interface fields for subtitle override")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("exposes selectedSubtitleStreamIndex field")
    function _()
      m.assertTrue(m.itemDetails.doesExist("selectedSubtitleStreamIndex"))
    end function

    @it("selectedSubtitleStreamIndex defaults to -1 (Off / SubtitleSelection.NONE)")
    function _()
      m.assertEqual(m.itemDetails.selectedSubtitleStreamIndex, -1)
    end function

    @it("selectedSubtitleStreamIndex is writable by parent scene / dropdown")
    function _()
      m.itemDetails.selectedSubtitleStreamIndex = 5
      m.assertEqual(m.itemDetails.selectedSubtitleStreamIndex, 5)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Track cluster wiring (top-level sibling of itemDetails)")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("has trackCluster LayoutGroup positioned at y=738")
    function _()
      cluster = m.itemDetails.findNode("trackCluster")
      m.assertTrue(isValid(cluster))
      ' Translation is [96, 738] so the cluster top lands on description bottom.
      m.assertEqual(cluster.translation[0], 96)
      m.assertEqual(cluster.translation[1], 738)
    end function

    @it("trackCluster starts hidden until content is loaded")
    function _()
      cluster = m.itemDetails.findNode("trackCluster")
      m.assertFalse(cluster.visible)
    end function

    @it("contains trackTitles row with three category labels")
    function _()
      m.assertTrue(isValid(m.itemDetails.findNode("trackTitles")))
      m.assertTrue(isValid(m.itemDetails.findNode("videoTrackTitle")))
      m.assertTrue(isValid(m.itemDetails.findNode("audioTrackTitle")))
      m.assertTrue(isValid(m.itemDetails.findNode("subtitleTrackTitle")))
    end function

    @it("contains trackDropdowns row with three TrackDropdown slots")
    function _()
      m.assertTrue(isValid(m.itemDetails.findNode("trackDropdowns")))
      video = m.itemDetails.findNode("videoDropdown")
      audio = m.itemDetails.findNode("audioDropdown")
      subs = m.itemDetails.findNode("subtitleDropdown")
      m.assertTrue(isValid(video))
      m.assertTrue(isValid(audio))
      m.assertTrue(isValid(subs))
      m.assertEqual(video.subtype(), "TrackDropdown")
      m.assertEqual(audio.subtype(), "TrackDropdown")
      m.assertEqual(subs.subtype(), "TrackDropdown")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("itemDetails preserves main geometry (animation resting state)")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("itemDetails translation stays at [96, 775] (matches main)")
    function _()
      details = m.itemDetails.findNode("itemDetails")
      m.assertTrue(isValid(details))
      m.assertEqual(details.translation[0], 96)
      m.assertEqual(details.translation[1], 775)
    end function

    @it("itemTracks is present as a child of itemDetails (25px invisible spacer)")
    function _()
      ' Preserves description's y=738 bottom so the extras slide animation math is
      ' byte-identical to main.
      m.assertTrue(isValid(m.itemDetails.findNode("itemTracks")))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Removed legacy popup nodes")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("does not contain the old itemOptions popup node")
    function _()
      legacy = m.itemDetails.findNode("itemOptions")
      m.assertFalse(isValid(legacy))
    end function

  end class

end namespace
