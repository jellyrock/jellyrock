import "pkg:/source/enums/LoadingKind.bs"
import "pkg:/source/utils/appWaits.bs"
import "pkg:/source/utils/signInStep.bs"

namespace tests

  ' AppWaitHost against the real component, mounted in the test scene: focus only moves between
  ' nodes in the scene, and appWaits.begin finds the host there by its id.
  @suite("AppWaitHost - app waits, the screen they hide, and the remote focus")
  class AppWaitHostTests extends tests.BaseTestSuite

    private mountedIn as object
    private host as object
    private launcher as object
    private button as object
    private player as object
    private other as object
    private overhang as object
    private previousView as object

    ' beforeEach, not setup: every test moves focus and opens waits (tests/CLAUDE.md).
    protected override sub beforeEach()
      super.beforeEach()
      if not m.global.doesExist("activeRoutedView") then m.global.addField("activeRoutedView", "node", false)
      m.previousView = m.global.activeRoutedView

      m.mountedIn = m.top.getScene()
      m.host = CreateObject("roSGNode", "AppWaitHost")
      m.host.id = "appWaitHost"
      m.launcher = CreateObject("roSGNode", "JRScreen")
      m.button = m.launcher.createChild("Group")
      m.button.focusable = true
      m.player = CreateObject("roSGNode", "JRScreen")
      m.player.isPlaybackScreen = true
      m.other = CreateObject("roSGNode", "JRScreen")
      ' Stands in for JRScene's overhang, which the host finds in the scene by this id.
      m.overhang = CreateObject("roSGNode", "Group")
      m.overhang.id = "overhang"
      m.mountedIn.appendChildren([m.host, m.launcher, m.player, m.other, m.overhang])

      m.button.setFocus(true)
      m.global.activeRoutedView = m.launcher
    end sub

    protected override sub afterEach()
      m.mountedIn.removeChildren([m.host, m.launcher, m.player, m.other, m.overhang])
      m.global.activeRoutedView = m.previousView
      m.previousView = invalid
      m.host = invalid
      m.launcher = invalid
      m.button = invalid
      m.player = invalid
      m.other = invalid
      m.overhang = invalid
      m.mountedIn = invalid
      super.afterEach()
    end sub

    private function begin(label = "" as string) as object
      return m.host.callFunc("begin", LoadingKind.PLAYBACK_START, label)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("begin() — a playback start hides the screen it was pressed on")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("hides the screen and holds the remote focus, remembering where it was")
    function _()
      m.begin()
      m.assertTrue(m.launcher.opacity = 0)
      m.assertTrue(m.host.hasFocus())
      m.assertTrue(m.launcher.lastFocus.isSameNode(m.button))
    end function

    @it("publishes the wait for the spinner, with its label")
    function _()
      m.begin("Ch 5 · News")
      waits = m.host.openWaits
      m.assertEqual(waits.count(), 1)
      for each key in waits
        m.assertEqual(waits[key].kind, LoadingKind.PLAYBACK_START)
        m.assertEqual(waits[key].label, "Ch 5 · News")
      end for
    end function

    @it("leaves a player shown and its focus alone (a channel switch)")
    function _()
      m.player.setFocus(true)
      m.global.activeRoutedView = m.player
      m.begin("Ch 5")
      m.assertTrue(m.player.opacity = 1)
      m.assertTrue(m.player.hasFocus())
    end function

    @it("hides a screen that does not hold the focus, but leaves the focus where it is (a dialog has it)")
    function _()
      m.other.setFocus(true)
      m.begin()
      m.assertTrue(m.launcher.opacity = 0)
      m.assertTrue(m.other.hasFocus())
    end function

    @it("takes the focus a closing dialog would give back to the screen it hides (pressed from a dialog)")
    function _()
      ' Stands in for an overlay dialog: found by its id, closed by focusing returnFocusTo.
      dialog = CreateObject("roSGNode", "Group")
      dialog.id = "jrDialog"
      dialog.focusable = true
      dialog.addField("returnFocusTo", "node", false)
      dialog.returnFocusTo = m.button
      m.mountedIn.appendChild(dialog)
      dialog.setFocus(true)

      appWait = m.begin()
      m.assertTrue(dialog.returnFocusTo.isSameNode(m.host))
      m.assertTrue(m.launcher.lastFocus.isSameNode(m.button))

      m.mountedIn.removeChild(dialog)
      dialog.returnFocusTo.setFocus(true)
      m.assertTrue(m.host.hasFocus())
      appWaits.done(appWait)
      m.assertTrue(m.button.hasFocus())
    end function

    @it("hands a dialog opened while it held the focus the screen's focus to give back (Quick Connect's code)")
    function _()
      appWait = m.begin()
      ' A dialog opened now records the host as where focus was.
      dialog = CreateObject("roSGNode", "Group")
      dialog.id = "jrDialog"
      dialog.focusable = true
      dialog.addField("returnFocusTo", "node", false)
      dialog.returnFocusTo = m.host
      m.mountedIn.appendChild(dialog)
      dialog.setFocus(true)

      appWaits.done(appWait)
      m.assertTrue(dialog.returnFocusTo.isSameNode(m.button))
      m.assertTrue(dialog.hasFocus())
      m.mountedIn.removeChild(dialog)
    end function

    @it("leaves a dialog alone when it gives the focus back somewhere else")
    function _()
      dialog = CreateObject("roSGNode", "Group")
      dialog.id = "jrDialog"
      dialog.focusable = true
      dialog.addField("returnFocusTo", "node", false)
      dialog.returnFocusTo = m.other
      m.mountedIn.appendChild(dialog)
      dialog.setFocus(true)

      m.begin()
      m.assertTrue(dialog.returnFocusTo.isSameNode(m.other))
      m.mountedIn.removeChild(dialog)
    end function

    @it("is what appWaits.begin opens")
    function _()
      appWait = appWaits.begin(LoadingKind.PLAYBACK_START)
      m.assertTrue(appWaits.isOpen(appWait))
      m.assertEqual(m.host.openWaits.count(), 1)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("ending — the screen and its focus come back")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("shows the screen again and gives its focus back when the start is done")
    function _()
      appWait = m.begin()
      appWaits.done(appWait)
      m.assertTrue(m.launcher.opacity = 1)
      m.assertTrue(m.button.hasFocus())
      m.assertEqual(m.host.openWaits.count(), 0)
    end function

    @it("does the same when the start fails")
    function _()
      appWait = m.begin()
      appWaits.fail(appWait, "nothing to play")
      m.assertTrue(m.launcher.opacity = 1)
      m.assertTrue(m.button.hasFocus())
    end function

    @it("keeps the screen hidden and the focus held while a newer start from it is open")
    function _()
      first = m.begin()
      second = m.begin()
      appWaits.fail(first, "replaced by a newer start")
      m.assertTrue(m.launcher.opacity = 0)
      m.assertTrue(m.host.hasFocus())
      appWaits.done(second)
      m.assertTrue(m.launcher.opacity = 1)
      m.assertTrue(m.button.hasFocus())
    end function

    @it("leaves the focus with a player that took it on mount")
    function _()
      appWait = m.begin()
      m.global.activeRoutedView = m.player
      m.player.setFocus(true)
      appWaits.done(appWait)
      m.assertTrue(m.player.hasFocus())
      m.assertTrue(m.launcher.opacity = 1)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("the overhang goes and comes back with the hidden screen")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("hides the overhang in the call that hides the screen")
    function _()
      m.begin()
      m.assertTrue(m.launcher.opacity = 0)
      m.assertTrue(m.overhang.opacity = 0)
    end function

    @it("leaves the overhang alone for a channel switch")
    function _()
      m.global.activeRoutedView = m.player
      m.begin("Ch 5")
      m.assertTrue(m.overhang.opacity = 1)
    end function

    @it("shows the overhang again with the screen when the start ends")
    function _()
      appWait = m.begin()
      appWaits.done(appWait)
      m.assertTrue(m.launcher.opacity = 1)
      m.assertTrue(m.overhang.opacity = 1)
    end function

    @it("shows the overhang again with the screen when Back cancels the start")
    function _()
      m.begin()
      m.host.callFunc("cancelOnBack")
      m.assertTrue(m.launcher.opacity = 1)
      m.assertTrue(m.overhang.opacity = 1)
    end function

    @it("keeps the overhang hidden while a newer start still hides the screen")
    function _()
      first = m.begin()
      second = m.begin()
      appWaits.fail(first, "replaced by a newer start")
      m.assertTrue(m.overhang.opacity = 0)
      appWaits.done(second)
      m.assertTrue(m.overhang.opacity = 1)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("cancelOnBack() — Back while a start hides its screen")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("cancels the start, and the screen comes back with its focus")
    function _()
      appWait = m.begin()
      m.assertTrue(m.host.callFunc("cancelOnBack"))
      m.assertEqual(appWait.promiseState, "rejected")
      m.assertEqual(appWait.promiseResult.message, "cancelled with Back")
      m.assertTrue(m.launcher.opacity = 1)
      m.assertTrue(m.button.hasFocus())
    end function

    @it("has nothing to cancel when no start hides a screen")
    function _()
      m.assertFalse(m.host.callFunc("cancelOnBack"))
    end function

    @it("leaves a channel switch's start to the player")
    function _()
      m.global.activeRoutedView = m.player
      appWait = m.begin("Ch 5")
      m.assertFalse(m.host.callFunc("cancelOnBack"))
      m.assertTrue(appWaits.isOpen(appWait))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("a sign-in step (LoadingKind.SESSION) — Back cancels it until it commits")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("hides the screen it was pressed on and holds the remote focus")
    function _()
      m.host.callFunc("begin", LoadingKind.SESSION, "")
      m.assertTrue(m.launcher.opacity = 0)
      m.assertTrue(m.host.hasFocus())
      m.assertTrue(m.launcher.lastFocus.isSameNode(m.button))
    end function

    @it("is canceled by Back, and the screen comes back with its focus")
    function _()
      signIn = appWaits.begin(LoadingKind.SESSION)
      m.assertTrue(m.host.callFunc("cancelOnBack"))
      m.assertEqual(signIn.promiseState, "rejected")
      m.assertTrue(m.launcher.opacity = 1)
      m.assertTrue(m.button.hasFocus())
    end function

    @it("survives Back once committed, still hiding the screen and holding the focus")
    function _()
      signIn = appWaits.begin(LoadingKind.SESSION)
      appWaits.commit(signIn)
      ' True: Back is spent here, so the scene's arbiter does not offer to exit.
      m.assertTrue(m.host.callFunc("cancelOnBack"))
      m.assertTrue(appWaits.isOpen(signIn))
      m.assertTrue(m.launcher.opacity = 0)
      m.assertTrue(m.host.hasFocus())
    end function

    @it("gives the focus back when done, committed or not")
    function _()
      signIn = appWaits.begin(LoadingKind.SESSION)
      appWaits.commit(signIn)
      appWaits.done(signIn)
      m.assertTrue(m.launcher.opacity = 1)
      m.assertTrue(m.button.hasFocus())
    end function

    @it("ignores a commit for a wait that has ended, and says so")
    function _()
      signIn = appWaits.begin(LoadingKind.SESSION)
      appWaits.done(signIn)
      m.assertFalse(appWaits.commit(signIn))
      m.assertEqual(m.host.openWaits.count(), 0)
    end function

    @it("reports a commit that took, while the step is open")
    function _()
      signIn = appWaits.begin(LoadingKind.SESSION)
      m.assertTrue(signInStep.commit(signIn))
      m.assertTrue(appWaits.isOpen(signIn))
    end function

    @it("refuses a commit after Back canceled the step, so the step stops there")
    function _()
      signIn = appWaits.begin(LoadingKind.SESSION)
      m.host.callFunc("cancelOnBack")
      m.assertFalse(signInStep.commit(signIn))
      m.assertEqual(signIn.promiseState, "rejected")
      m.assertTrue(m.button.hasFocus())
    end function

    @it("lets a step with no wait go on: a cold start has nothing to cancel")
    function _()
      m.assertTrue(signInStep.commit(invalid))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("an overlay action (LoadingKind.OVERLAY) — holds the keys, keeps the screen in view")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    ' A focusable child of the overhang stand-in, focused: where a press on a cluster icon starts.
    private function focusOverhangIcon() as object
      icon = m.overhang.createChild("Group")
      icon.focusable = true
      icon.setFocus(true)
      return icon
    end function

    @it("leaves the screen and the overhang shown but holds the remote focus")
    function _()
      appWait = m.host.callFunc("begin", LoadingKind.OVERLAY, "")
      m.assertTrue(m.launcher.opacity = 1)
      m.assertTrue(m.overhang.opacity = 1)
      m.assertTrue(m.host.hasFocus())
      m.assertTrue(m.launcher.lastFocus.isSameNode(m.button))
      m.assertTrue(appWaits.isOpen(appWait))
    end function

    @it("is canceled by Back, which is spent here, and the focus comes back")
    function _()
      appWait = m.host.callFunc("begin", LoadingKind.OVERLAY, "")
      m.assertTrue(m.host.callFunc("cancelOnBack"))
      m.assertEqual(appWait.promiseState, "rejected")
      m.assertTrue(m.launcher.opacity = 1)
      m.assertTrue(m.overhang.opacity = 1)
      m.assertTrue(m.button.hasFocus())
    end function

    @it("gives the focus back when done")
    function _()
      appWait = m.host.callFunc("begin", LoadingKind.OVERLAY, "")
      appWaits.done(appWait)
      m.assertTrue(m.button.hasFocus())
      m.assertEqual(m.host.openWaits.count(), 0)
    end function

    @it("holds the focus from a node outside the screen (the overhang), and gives it back there")
    function _()
      icon = m.focusOverhangIcon()
      appWait = m.host.callFunc("begin", LoadingKind.OVERLAY, "")
      m.assertTrue(m.host.hasFocus())
      m.assertFalse(icon.hasFocus())
      appWaits.done(appWait)
      m.assertTrue(icon.hasFocus())
      m.assertFalse(m.host.hasFocus())
    end function

    @it("gives the focus back to the overhang's node when Back cancels")
    function _()
      icon = m.focusOverhangIcon()
      m.host.callFunc("begin", LoadingKind.OVERLAY, "")
      m.assertTrue(m.host.callFunc("cancelOnBack"))
      m.assertTrue(icon.hasFocus())
      m.assertTrue(m.overhang.opacity = 1)
    end function

    @it("remembers the deepest focused node under the overhang")
    function _()
      group = m.overhang.createChild("Group")
      icon = group.createChild("Group")
      icon.focusable = true
      icon.setFocus(true)
      appWait = m.host.callFunc("begin", LoadingKind.OVERLAY, "")
      m.assertTrue(m.host.hasFocus())
      appWaits.done(appWait)
      m.assertTrue(icon.hasFocus())
    end function

    @it("falls back to the screen's focus when the overhang's node has left the scene")
    function _()
      icon = m.focusOverhangIcon()
      appWait = m.host.callFunc("begin", LoadingKind.OVERLAY, "")
      m.assertTrue(m.host.hasFocus())
      m.overhang.removeChild(icon)
      appWaits.done(appWait)
      m.assertFalse(m.host.hasFocus())
    end function

    @it("hands a dialog opened while it held the overhang's focus that node to give back")
    function _()
      icon = m.focusOverhangIcon()
      appWait = m.host.callFunc("begin", LoadingKind.OVERLAY, "")
      dialog = CreateObject("roSGNode", "Group")
      dialog.id = "jrDialog"
      dialog.focusable = true
      dialog.addField("returnFocusTo", "node", false)
      dialog.returnFocusTo = m.host
      m.mountedIn.appendChild(dialog)
      dialog.setFocus(true)

      appWaits.done(appWait)
      m.assertTrue(dialog.returnFocusTo.isSameNode(icon))
      m.assertTrue(dialog.hasFocus())
      m.mountedIn.removeChild(dialog)
    end function

    @it("keeps the focus held while a second wait still holds the keys")
    function _()
      first = m.host.callFunc("begin", LoadingKind.OVERLAY, "")
      second = m.host.callFunc("begin", LoadingKind.OVERLAY, "")
      appWaits.fail(first, "replaced")
      m.assertTrue(m.host.hasFocus())
      appWaits.done(second)
      m.assertTrue(m.button.hasFocus())
    end function

    @it("shows the screen and overhang when the hiding wait ends, though an overlay still holds the keys")
    function _()
      overlay = m.host.callFunc("begin", LoadingKind.OVERLAY, "")
      hiding = m.begin()
      m.assertTrue(m.overhang.opacity = 0)
      appWaits.done(hiding)
      m.assertTrue(m.launcher.opacity = 1)
      m.assertTrue(m.overhang.opacity = 1)
      m.assertTrue(m.host.hasFocus())
      appWaits.done(overlay)
      m.assertTrue(m.button.hasFocus())
    end function

    @it("leaves a player shown and its focus alone (a channel switch)")
    function _()
      m.player.setFocus(true)
      m.global.activeRoutedView = m.player
      m.host.callFunc("begin", LoadingKind.OVERLAY, "")
      m.assertTrue(m.player.hasFocus())
      m.assertFalse(m.host.callFunc("cancelOnBack"))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("failLeftBehind() — the viewer left before a player took the start")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("fails the start and gives the focus to the screen the viewer reached")
    function _()
      appWait = m.begin()
      m.global.activeRoutedView = m.other
      m.host.callFunc("failLeftBehind", m.other)
      m.assertEqual(appWait.promiseState, "rejected")
      m.assertTrue(m.launcher.opacity = 1)
      m.assertTrue(m.other.hasFocus())
    end function

    @it("leaves the start alone when the viewer reaches a player")
    function _()
      appWait = m.begin()
      m.host.callFunc("failLeftBehind", m.player)
      m.assertTrue(appWaits.isOpen(appWait))
    end function

  end class

end namespace
