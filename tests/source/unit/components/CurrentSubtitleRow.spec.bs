' Unit tests for CurrentSubtitleRow — the "On this item" row in SubtitlePanel.
'
' This component had no coverage at all when it shipped, which matters more than
' the usual gap for two reasons: it is a MarkupList itemComponent, so it is
' RECYCLED on every scroll step and each write to itemContent has to leave no
' trace of the previous row; and its badge-pool machinery is duplicated almost
' line-for-line in SubtitleResultRow, so the extraction that removes that
' duplication needs a red/green gate rather than an eyeball.
'
' What is testable here and what is not is decided by one thing: this row's
' geometry is pure arithmetic over subtitleLayout and m.top.rowWidth, with no
' localBoundingRect() call, so a detached node computes real values. (TextButton
' is the counter-example — it measures its label and early-returns when there has
' been no render pass, so its geometry is unreachable from a unit test by
' construction and only RTA or a device pass can cover it.)

import "pkg:/source/constants/subtitleLayout.bs"

namespace tests

  @suite("CurrentSubtitleRow - content mapping, badges and recycling")
  class CurrentSubtitleRowTests extends tests.BaseTestSuite

    private row as object

    ' Built per TEST, not per suite: every case writes itemContent, and a shared
    ' node would let one test's badges and heights leak into the next.
    protected override function beforeEach()
      super.beforeEach()
      m.row = createObject("roSGNode", "CurrentSubtitleRow")
    end function

    protected override function afterEach()
      m.row = invalid
      super.afterEach()
    end function

    ' rowContent: a content node shaped exactly as SubtitlePanel.renderExistingList
    ' builds one, so a change to that shape breaks these tests rather than
    ' silently drifting from it.
    private function rowContent(fields as object) as object
      content = createObject("roSGNode", "ContentNode")
      base = {
        language: "English",
        codec: "SUBRIP",
        source: "",
        isExternal: false,
        canDelete: false,
        hearingImpaired: false,
        forced: false,
        streamIndex: 0,
        rowWidth: subtitleLayout.EXISTING_WIDTH,
        badgeZoneWidth: 0
      }
      for each key in fields
        base[key] = fields[key]
      end for
      content.addFields(base)
      return content
    end function

    private function badgeSlot(index as integer) as object
      return m.row.findNode("existingBadgeSlot" + index.toStr())
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("the title line")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("reads language then codec, uppercased")
    function _()
      m.row.itemContent = m.rowContent({ language: "English", codec: "subrip" })
      m.assertEqual(m.row.findNode("titleLabel").text, "English  ·  SUBRIP")
    end function

    @it("falls back to Unknown rather than rendering an empty row")
    function _()
      m.row.itemContent = m.rowContent({ language: "", codec: "" })
      m.assertNotEqual(m.row.findNode("titleLabel").text, "")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("two shapes, chosen by isExternal")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("a downloaded file shows its filename tail on a second line")
    function _()
      m.row.itemContent = m.rowContent({ isExternal: true, source: ".en.sdh.srt" })
      sourceLabel = m.row.findNode("sourceLabel")
      m.assertTrue(sourceLabel.visible, "a downloaded file has a second line")
      m.assertEqual(sourceLabel.text, ".en.sdh.srt")
    end function

    @it("a built-in track hides the second line rather than filling it")
    function _()
      ' The draft before this put the word "Embedded" here on every row, which
      ' made the least informative text on screen the most repeated.
      m.row.itemContent = m.rowContent({ isExternal: false })
      m.assertFalse(m.row.findNode("sourceLabel").visible)
    end function

    @it("hides the second line for a downloaded file the server gave no tail")
    function _()
      m.row.itemContent = m.rowContent({ isExternal: true, source: "" })
      m.assertFalse(m.row.findNode("sourceLabel").visible)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("badges - only the flags that change what the track IS")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("draws no badge slots for a plain track")
    function _()
      m.row.itemContent = m.rowContent({})
      m.assertFalse(m.badgeSlot(0).visible)
      m.assertFalse(m.badgeSlot(1).visible)
    end function

    @it("fills one slot for hearing-impaired")
    function _()
      m.row.itemContent = m.rowContent({ hearingImpaired: true, badgeZoneWidth: 200 })
      m.assertTrue(m.badgeSlot(0).visible)
      m.assertFalse(m.badgeSlot(1).visible)
    end function

    @it("fills both slots, hearing-impaired first - significance order")
    function _()
      ' Order is load-bearing: the badge zone is clipped to the row's right edge,
      ' so an overflowing badge is dropped from the least significant end.
      m.row.itemContent = m.rowContent({ hearingImpaired: true, forced: true, badgeZoneWidth: 280 })
      m.assertTrue(m.badgeSlot(0).visible)
      m.assertTrue(m.badgeSlot(1).visible)
    end function

    @it("a forced-only track uses the FIRST slot, not the second")
    function _()
      ' Slots are filled in append order, not reserved per flag — a forced-only
      ' row must not leave a hole where the CC badge would have gone.
      m.row.itemContent = m.rowContent({ forced: true, badgeZoneWidth: 120 })
      m.assertTrue(m.badgeSlot(0).visible)
      m.assertFalse(m.badgeSlot(1).visible)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("recycling - the row must forget the previous item")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("clears badges when a badged row is recycled into a plain one")
    function _()
      ' The failure this guards is invisible in a build and only shows while
      ' scrolling: a pooled slot left visible from the row before.
      m.row.itemContent = m.rowContent({ hearingImpaired: true, forced: true, badgeZoneWidth: 280 })
      m.row.itemContent = m.rowContent({})
      m.assertFalse(m.badgeSlot(0).visible)
      m.assertFalse(m.badgeSlot(1).visible)
    end function

    @it("drops the second line when a downloaded row is recycled into a built-in one")
    function _()
      m.row.itemContent = m.rowContent({ isExternal: true, source: ".en.srt" })
      m.row.itemContent = m.rowContent({ isExternal: false })
      m.assertFalse(m.row.findNode("sourceLabel").visible)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("the delete affordance")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("is hidden while the row is not focused, even when deletable")
    function _()
      m.row.itemContent = m.rowContent({ isExternal: true, source: ".en.srt", canDelete: true })
      m.assertFalse(m.row.findNode("deleteIcon").visible)
    end function

    @it("appears on focus for a deletable row")
    function _()
      m.row.itemContent = m.rowContent({ isExternal: true, source: ".en.srt", canDelete: true })
      m.row.itemHasFocus = true
      m.assertTrue(m.row.findNode("deleteIcon").visible)
    end function

    @it("never appears on a row the panel said cannot be deleted")
    function _()
      ' canDelete is resolved by the panel from BOTH the user's admin permission
      ' and the stream being external, so the row must never advertise an action
      ' the panel will refuse. The API layer guards this again independently.
      m.row.itemContent = m.rowContent({ isExternal: true, source: ".en.srt", canDelete: false })
      m.row.itemHasFocus = true
      m.assertFalse(m.row.findNode("deleteIcon").visible)
    end function

    @it("never appears on a built-in track")
    function _()
      m.row.itemContent = m.rowContent({ isExternal: false, canDelete: false })
      m.row.itemHasFocus = true
      m.assertFalse(m.row.findNode("deleteIcon").visible)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("geometry - the row and its list must agree")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("reserves the action zone by DELETABILITY, not by focus")
    function _()
      ' Focusing a row must not shift its filename sideways, so the icon's strip
      ' is held whether or not the icon is currently drawn.
      m.row.itemContent = m.rowContent({ isExternal: true, source: ".en.srt", canDelete: true })
      unfocused = m.row.findNode("sourceLabel").width
      m.row.itemHasFocus = true
      m.assertEqual(m.row.findNode("sourceLabel").width, unfocused, "the second line must not resize on focus")
    end function

    @it("gives a non-deletable row's second line the width the icon would have taken")
    function _()
      ' int() because a SceneGraph width is a float and these constants are
      ' integers — the values are exact, the types are not.
      fullTextWidth = subtitleLayout.EXISTING_WIDTH - (subtitleLayout.ROW_H_PADDING * 2)

      m.row.itemContent = m.rowContent({ isExternal: true, source: ".en.srt", canDelete: false })
      m.assertEqual(int(m.row.findNode("sourceLabel").width), fullTextWidth, "a row with no action spans the full text width")

      m.row.itemContent = m.rowContent({ isExternal: true, source: ".en.srt", canDelete: true })
      m.assertEqual(int(m.row.findNode("sourceLabel").width), fullTextWidth - subtitleLayout.actionZoneWidth(true), "a deletable row gives up exactly the action zone")
    end function

    @it("takes nothing from the FIRST line for the action icon")
    function _()
      ' Reserving on line 1 ellipsized real titles — see actionZoneWidth().
      m.row.itemContent = m.rowContent({ isExternal: true, source: ".en.srt", canDelete: false })
      wide = m.row.findNode("titleLabel").maxWidth
      m.row.itemContent = m.rowContent({ isExternal: true, source: ".en.srt", canDelete: true })
      m.assertEqual(m.row.findNode("titleLabel").maxWidth, wide, "the title must not pay for the icon")
    end function

    @it("hands the title the whole row when the section reserves no badge zone")
    function _()
      m.row.itemContent = m.rowContent({ badgeZoneWidth: 0 })
      noBadges = m.row.findNode("titleLabel").maxWidth
      m.row.itemContent = m.rowContent({ badgeZoneWidth: 280 })
      m.assertTrue(m.row.findNode("titleLabel").maxWidth < noBadges, "a badge zone must cost the title width")
    end function

  end class

end namespace
