namespace tests

  @suite("QuickConnectDialog - Node interface and waiting-phase behavior")
  class QuickConnectDialogTests extends tests.BaseTestSuite

    private dialog as object

    protected override function setup()
      super.setup()
      m.dialog = CreateObject("roSGNode", "QuickConnectDialog")
      ' Stop the polling timer immediately so it cannot fire during the test
      ' and spawn a QuickConnect Task that would reach the network.
      timer = m.dialog.findNode("quickConnectTimer")
      if isValid(timer)
        timer.control = "stop"
      end if
    end function

    protected override function teardown()
      m.dialog = invalid
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Interface fields")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("exposes quickConnectJson")
    function _()
      m.assertTrue(m.dialog.doesExist("quickConnectJson"))
    end function

    @it("exposes isAuthenticated")
    function _()
      m.assertTrue(m.dialog.doesExist("isAuthenticated"))
    end function

    @it("does not expose shouldSaveCredentials")
    ' The save-credentials decision is now made inside the dialog itself
    ' (post-auth Yes/No prompt), so callers must not pass it in.
    function _()
      m.assertFalse(m.dialog.doesExist("shouldSaveCredentials"))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Default values")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("isAuthenticated defaults to false")
    function _()
      m.assertFalse(m.dialog.isAuthenticated)
    end function

    @it("close defaults to false")
    function _()
      m.assertFalse(m.dialog.close)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Polling timer")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("has quickConnectTimer child")
    function _()
      m.assertNotInvalid(m.dialog.findNode("quickConnectTimer"))
    end function

    ' Roku XML numeric attributes are parsed as Floats.
    @it("quickConnectTimer fires every 3 seconds")
    function _()
      timer = m.dialog.findNode("quickConnectTimer")
      m.assertEqual(timer.duration, 3.0)
    end function

    @it("quickConnectTimer does not auto-repeat")
    ' The dialog re-arms the timer manually after each poll so it can stop
    ' polling on auth success or cancel without racing the next tick.
    function _()
      timer = m.dialog.findNode("quickConnectTimer")
      m.assertFalse(timer.repeat)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("Waiting-phase Cancel button")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("closes the dialog without authenticating")
    ' init() leaves the dialog in waiting phase. The only button shown then
    ' is Cancel (index 0); pressing it must close the dialog and leave
    ' isAuthenticated unset so showScenes treats it as a cancel, not a login.
    function _()
      m.dialog.buttonSelected = 0

      m.assertTrue(m.dialog.close)
      m.assertFalse(m.dialog.isAuthenticated)
    end function

  end class

end namespace
