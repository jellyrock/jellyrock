# Copy to .env (gitignored) and fill in. chmod 600 .env to lock perms.

# === For all contributors (running tests on a real Roku) ===

# Roku device IP — used by `npm run test:*` (deploys test build) and `npm run package:signed`.
ROKU_IP=192.168.1.50

# Optional: every Roku you have, comma-separated — used by `npm run measure:devices` to take
# the same measurement on each in turn. ROKU_IP stays the single-device default, so leaving
# this unset changes nothing. The RAM tier of each model is looked up from Roku's published
# hardware table (scripts/data/roku-hardware.json), so only the addresses belong here.
ROKU_DEVICES=

# Optional: the password `npm run measure:devices -- --sign-in <url> --user <name>` authenticates
# with. Leave blank for a passwordless account (the common case on a LAN test server). It lives
# here rather than on the command line so a real password stays out of shell history and `ps`.
MEASURE_SIGNIN_PASSWORD=

# Roku dev portal password (the one you set when enabling dev mode) — used by both test runner and signing script.
ROKU_PASSWORD=rokudev

# Optional: the Jellyfin server the RTA functional tests + screenshot capture drive against.
# Defaults to the public demo (https://demo.jellyfin.org/stable, user "demo", no password), which
# is shared infrastructure that resets hourly and will not be around forever. Point these at your
# own Jellyfin — or at a JellyRock demo server when one exists — without editing a tracked file.
# Note the content-dependent knobs in tests/rta/config.js (heroMovie, trickplayMovie, searchQuery)
# still describe the public demo's library, so a repointed server needs those retuned too. The demo
# is a CONTROL, not a substitute: ~3 libraries against a real server's ~10.
# The VIDEO DEMOS (`npm run demo`) deliberately ignore this and stay pinned to the public demo.
# Left COMMENTED OUT on purpose: dotenv reads a bare `RTA_SERVER_URL=` as the empty string, so an
# uncommented empty key is an override, not an absent one. tests/rta/config.js also treats empty as
# unset, so either half of that is enough — this is the belt to that braces.
# RTA_SERVER_URL=
# RTA_SERVER_USER=
# RTA_SERVER_PASS=

# === For maintainers only (signing the app for Roku channel store upload) ===
# Skip these unless you're shipping releases. The test runner doesn't need them.

# Signing password used to encrypt the .pkg — only used by `npm run package:signed` (set when you first signed your channel).
ROKU_SIGNING_PASSWORD=

# Optional: expected keyed-developer-id (40-char SHA-1 hex from signing cert, NOT the numeric vendor/account ID on dev.roku.com). Get via: curl -s "http://${ROKU_IP}:8060/query/device-info" | grep keyed-developer-id
ROKU_DEV_ID=
