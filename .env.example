# Copy to .env (gitignored) and fill in. chmod 600 .env to lock perms.
#
# Working in several checkouts? Put the values you share in ~/.config/jellyrock/env
# (same format, chmod 600) instead, and every checkout reads them. A checkout's own .env
# still wins, and an empty value here counts as unset, so blank keys copied from this
# file never hide the per-user ones. Details: docs/dev/unit-tests-tdd.md (Roku Credentials).

# === For all contributors (running tests on a real Roku) ===

# Roku device IP — used by `npm run test:*` (deploys test build) and `npm run package:signed`.
ROKU_IP=192.168.1.50

# Optional: every Roku you have, comma-separated — used by `npm run measure:devices` to take
# the same measurement on each in turn. ROKU_IP stays the single-device default, so leaving
# this unset changes nothing. The RAM tier of each model is looked up from Roku's published
# hardware table (scripts/data/roku-hardware.json), so only the addresses belong here.
ROKU_DEVICES=

# Optional: the password `npm run measure:devices -- --sign-in <url> --user <name>` authenticates
# with. It lives here rather than on the command line so a real password stays out of shell
# history and `ps`. Left COMMENTED OUT on purpose: a blank value here is a real value (a
# passwordless account), and it would override one set in ~/.config/jellyrock/env. Uncomment it
# blank only when this checkout signs in to a passwordless account.
# MEASURE_SIGNIN_PASSWORD=

# Roku dev portal password (the one you set when enabling dev mode) — used by both test runner and signing script.
ROKU_PASSWORD=rokudev

# Optional: the Jellyfin server the RTA functional tests + screenshot capture drive against.
# Defaults to the public demo (https://demo.jellyfin.org/stable, user "demo", no password), which
# is shared infrastructure that resets hourly and will not be around forever. Point these at your
# own Jellyfin — or at a JellyRock demo server when one exists — without editing a tracked file.
# The content-dependent knobs default to the public demo's library, so a repointed server needs
# them retuned too — see RTA_HERO_MOVIE below. The demo is a CONTROL, not a substitute: ~3
# libraries against a real server's ~10.
# The VIDEO DEMOS (`npm run demo`) deliberately ignore this and stay pinned to the public demo.
# Left COMMENTED OUT on purpose. A blank RTA_SERVER_URL or RTA_SERVER_USER is ignored (by the env
# loader, and again by tests/rta/config.js), but a blank RTA_SERVER_PASS is a real value: the
# demo's password is empty, so it would override a password set in ~/.config/jellyrock/env.
# RTA_SERVER_URL=
# RTA_SERVER_USER=
# RTA_SERVER_PASS=

# Optional: the CONTENT the RTA functional tests expect to find on that server. These default to
# the public demo's library ("Dracula", "The Boy in the Plastic Bubble"), so they must be retuned
# whenever RTA_SERVER_URL points somewhere else — a film the server does not have does NOT fail
# loudly on its own: findMovie answers a miss with tile 0, so the suite would drive a DIFFERENT
# film and still report a pass. The screens that seek by the hero's id now skip visibly instead,
# which tells you to set these. Seek positions are in SECONDS and must be inside the film's
# runtime. RTA_SEARCH_QUERY is typed into the search keyboard; pick a string your library answers
# richly. Left commented out for the same reason as the server keys.
# RTA_HERO_MOVIE=
# RTA_SEEK_SECONDS=
# RTA_TRICKPLAY_MOVIE=
# RTA_TRICKPLAY_SEEK_SECONDS=
# RTA_SEARCH_QUERY=

# Optional: one Jellyfin server per version you want to compare, for `npm run jellyfin:matrix`
# (sends one API request to each and prints what each version returns). Comma-separated base URLs,
# e.g. local containers of several releases. The account must exist on every server. Keep your own
# servers in ~/.config/jellyrock/env rather than here. The password is commented out for the same
# reason as RTA_SERVER_PASS: blank is a real value (a passwordless account).
# JELLYFIN_VERSION_SERVERS=
# JELLYFIN_VERSION_SERVERS_USER=
# JELLYFIN_VERSION_SERVERS_PASS=

# === For maintainers only (signing the app for Roku channel store upload) ===
# Skip these unless you're shipping releases. The test runner doesn't need them.

# Signing password used to encrypt the .pkg — only used by `npm run package:signed` (set when you first signed your channel).
ROKU_SIGNING_PASSWORD=

# Optional: expected keyed-developer-id (40-char SHA-1 hex from signing cert, NOT the numeric vendor/account ID on dev.roku.com). Get via: curl -s "http://${ROKU_IP}:8060/query/device-info" | grep keyed-developer-id
ROKU_DEV_ID=
