{
  "files": [
    "manifest",
    "source/**/*.*",
    "components/**/*.*",
    "images/**/*.*",
    "locale/**/*.*",
    "settings/**/*.*",
    {
      "src": "resources/branding/release/*.*",
      "dest": "images/branding"
    }
  ],
  "plugins": [
    "@rokucommunity/bslint",
    "./scripts/bsc-plugin-roku-log.cjs",
    "./scripts/bsc-plugin-translation-keys.cjs"
  ],
  "rokuLog": {
    "strip": true,
    "insertPkgPath": false,
    "removeComments": true
  },
  "diagnosticFilters": [
    { "files": "node_modules/**/*" },
    { "files": "**/roku_modules/**/*" }
  ],
  "sourceMap": false,
  "autoImportComponentScript": true,
  "outDir": "build"

}