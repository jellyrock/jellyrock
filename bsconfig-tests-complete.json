{
  "files": [
    "manifest",
    {
      "src": "source/**/*",
      "dest": "source"
    },
    "!source/Main.bs",
    {
      "src": "components/**/*",
      "dest": "components"
    },
    {
      "src": "locale/**/*",
      "dest": "locale"
    },
    {
      "src": "settings/**/*",
      "dest": "settings"
    },
    {
      "src": "tests/source/**/*",
      "dest": "source/tests"
    },
    "!tests/source/e2e/**/*",
    "!tests/source/**/*.md"
  ],
  "diagnosticFilters": [
    { "files": "node_modules/**/*" },
    { "files": "**/roku_modules/**/*" },
    {
      "files": "tests/**/*",
      "codes": [
        "LINT3008"
      ]
    }
  ],
  "autoImportComponentScript": true,
  "outDir": "build",

  "plugins": [
    "rooibos-roku",
    "@rokucommunity/bslint",
    "./scripts/bsc-plugin-translation-keys.cjs"
  ],
  "rooibos": {
    "isRecordingCodeCoverage": true,
    "testsFilePattern": null,
    "tags": null,
    "showOnlyFailures": true,
    "catchCrashes": true,
    "lineWidth": 70,
    "failFast": false,
    "sendHomeOnFinish": false,
    "printTestTimes": true
  },
  "sourceMap": true
}
