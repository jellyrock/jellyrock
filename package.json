{
  "name": "jellyrock",
  "type": "module",
  "version": "2.15.0",
  "description": "Roku client for Jellyfin media server",
  "dependencies": {
    "@rokucommunity/bslib": "0.1.1",
    "log": "npm:roku-log@0.11.1",
    "rr": "npm:roku-requests@1.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@rokucommunity/bslint": "1.0.0-alpha.50",
    "brighterscript": "1.0.0-alpha.50",
    "brighterscript-formatter": "1.7.24",
    "brighterscript-xml-plugin": "1.0.0-alpha.3",
    "dotenv": "17.4.2",
    "eslint": "10.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-n": "17.24.0",
    "fast-glob": "3.3.3",
    "husky": "9.1.7",
    "jshint": "2.13.6",
    "lint-staged": "^16.4.0",
    "markdownlint-cli2": "0.22.1",
    "prettier": "3.8.3",
    "rimraf": "6.1.3",
    "roku-deploy": "3.17.1",
    "rooibos-roku": "6.0.0-alpha.50",
    "ropm": "0.11.5",
    "spellchecker-cli": "7.0.3",
    "undent": "1.0.0",
    "vitest": "4.1.5",
    "xml2js": "0.6.2"
  },
  "overrides": {
    "brighterscript-xml-plugin": {
      "brighterscript": "$brighterscript"
    }
  },
  "scripts": {
    "build": "npx rimraf build/ out/ && npx bsc --project bsconfig.json",
    "build:prod": "npx rimraf build/ out/ && npx bsc --project bsconfig-prod.json",
    "build:tdd": "npx rimraf build/ out/ && npx bsc --project bsconfig-tdd.json",
    "build:tests": "npx rimraf build/ out/ && npx bsc --project bsconfig-tests.json",
    "build:tests-unit": "npx rimraf build/ out/ && npx bsc --project bsconfig-tests-unit.json",
    "build:tests-integration": "npx rimraf build/ out/ && npx bsc --project bsconfig-tests-integration.json",
    "build:tests-complete": "npx rimraf build/ out/ && npx bsc --project bsconfig-tests-complete.json",
    "changelog:sync-unreleased": "node scripts/changelog-syncer.js sync-unreleased",
    "changelog:sync-release": "node scripts/changelog-syncer.js sync-release",
    "changelog:validate": "node scripts/changelog-syncer.js validate",
    "changelog:status": "node scripts/changelog-syncer.js status",
    "check-formatting": "npm run check-formatting:bs && npm run check-formatting:js",
    "check-formatting:bs": "npx bsfmt --check",
    "check-formatting:js": "npx prettier --check .",
    "docs:dev-index": "node scripts/generate/dev-index.cjs",
    "docs:dev-index:check": "node scripts/generate/dev-index.cjs --check",
    "docs:settings": "node scripts/generate/settings-docs.cjs",
    "docs:stale": "node scripts/lint/docs-stale.cjs",
    "docs:stale:blocking": "node scripts/lint/docs-stale-blocking.cjs",
    "agent-telemetry": "node scripts/agent-telemetry-report.cjs",
    "format": "npm run format:bs && npm run format:js",
    "format:bs": "npx bsfmt --write",
    "format:js": "npx prettier --write .",
    "lint": "npm run check-formatting && npm run lint:bs && npm run validate && npm run lint:json && npm run lint:js && npm run lint:markdown && npm run lint:spelling && npm run lint:translations && npm run lint:language-coverage && npm run lint:docs && npm run docs:dev-index:check",
    "lint:bs": "bslint",
    "lint:docs": "node scripts/lint/docs-check.cjs",
    "lint:js": "eslint .",
    "lint:json": "jshint --extra-ext .json --verbose --exclude node_modules,scripts,tasks,build,out,locale,tests/scripts,eslint.config.js,vitest.config.js ./",
    "lint:language-coverage": "node scripts/lint/language-coverage.cjs",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"!CLAUDE.md\" \"!out/\" \"!build/\" \"!**/copilot-instructions.md\" \"!.claude/**/*.md\" \"!tasks/\" \"!.opencode/**/*.md\"",
    "lint:spelling": "spellchecker -d dictionary.txt -p spell indefinite-article repeated-words syntax-mentions syntax-urls frontmatter --files \"**/*.md\" \"**/.*/**/*.md\" \"!node_modules/**/*.md\" \"!docs/user/app-settings.md\" \"!CHANGELOG.md\" \"!.claude/**/*.md\" \"!.opencode/**/*.md\"",
    "lint:translations": "node scripts/lint/update-translations.cjs",
    "postinstall": "npm run ropm",
    "ropm": "ropm copy && node scripts/ropm-hook.cjs",
    "update-translations": "node scripts/lint/update-translations.cjs --fix",
    "package": "node scripts/create-package.cjs",
    "validate": "npx bsc --noEmit",
    "test:tdd": "npm run build:tdd && node scripts/run-roku-tests.js",
    "test:unit": "npm run build:tests-unit && node scripts/run-roku-tests.js",
    "test:integration": "npm run build:tests-integration && node scripts/run-roku-tests.js",
    "test:all": "npm run build:tests && node scripts/run-roku-tests.js",
    "test:complete": "npm run build:tests-complete && node scripts/run-roku-tests.js",
    "test:scripts": "vitest run",
    "test:scripts:tdd": "vitest",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jellyrock/jellyrock.git"
  },
  "keywords": [
    "jellyrock",
    "jellyfin",
    "roku",
    "roku-client",
    "brighterscript"
  ],
  "author": "Charles Ewert",
  "license": "GPL-2.0",
  "bugs": {
    "url": "https://github.com/jellyrock/jellyrock/issues"
  },
  "homepage": "https://github.com/jellyrock/jellyrock"
}
